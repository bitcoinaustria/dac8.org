---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const btcpay =
  "https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"

const bankDetails = [
  { label: "Empfänger", value: "Bitcoin Austria" },
  {
    label: "IBAN",
    value: "AT94 2011 1857 7690 6800",
    copy: "AT942011185776906800",
  },
  { label: "BIC", value: "GIBAATWWXXX" },
  { label: "Verwendungszweck", value: "DAC8" },
]

const uses = [
  {
    title: "Anwaltliche Prüfung",
    text: "Ein belastbarer Fall braucht Juristinnen und Juristen, die Sachverhalt, Verantwortlichen und Rechtsweg sauber aufbauen – bevor irgendetwas eingebracht wird.",
  },
  {
    title: "Gutachten und Recherche",
    text: "Primärquellen lesen, Gesetzestexte gegen Behauptungen prüfen, Fachmeinungen einholen. Das ist der Teil, der die Kampagne glaubwürdig hält.",
  },
  {
    title: "Werkzeuge und Infrastruktur",
    text: "Diese Website, die Generatoren für Beschwerde und Brief, der eigene BTCPay-Server – alles läuft ohne Tracker und ohne Dienstleister, die Daten mitlesen.",
  },
  {
    title: "Öffentlichkeit",
    text: "Gespräche mit Abgeordneten, Medien und anderen Organisationen, damit Finanzüberwachung auf Vorrat nicht unwidersprochen zum Standard wird.",
  },
]
---

<Layout
  sections={[
    { id: "wege", label: "Bitcoin oder Euro" },
    { id: "verwendung", label: "Wofür" },
    { id: "verein", label: "Bitcoin Austria" },
  ]}
>
  <MetaPage
    slot="head"
    title="Spenden"
    description="Unterstütze die Arbeit gegen Finanzüberwachung auf Vorrat: Spende in Bitcoin über den BTCPay-Server von Bitcoin Austria oder in Euro per Überweisung."
  />

  <article class="campaign dossier">
    <header class="hero">
      <p class="eyebrow">Spenden · Bitcoin Austria</p>
      <h1>Gegenwehr kostet. <span>Trag mit.</span></h1>
      <p class="lead">
        Recherche, anwaltliche Prüfung, Gutachten und diese Website kosten Geld.
        Deine Spende geht direkt an <strong>Bitcoin Austria</strong>, den
        gemeinnützigen Verein hinter dac8.org – in Bitcoin über unseren eigenen
        Server oder in Euro per Überweisung.
      </p>
      <nav class="hero-actions" aria-label="Spendenweg wählen">
        <a class="button primary" href={btcpay} target="_blank" rel="noopener"
          >Mit Bitcoin spenden</a
        >
        <a class="button" href="#euro">Per Überweisung</a>
      </nav>
      <dl class="stamp" aria-label="Das Wichtigste zur Spende">
        <dt>Empfänger</dt>
        <dd>Bitcoin Austria, Verein (ZVR 828542896)</dd>
        <dt>Verwendungszweck</dt>
        <dd>DAC8</dd>
        <dt>Zwischenhändler</dt>
        <dd>keine – eigener BTCPay-Server, eigenes Vereinskonto</dd>
        <dd class="stamp-note">
          Eine Spende begründet keinen Anspruch auf Beteiligung oder einen
          bestimmten Ausgang.
        </dd>
      </dl>
    </header>

    <section id="wege" aria-labelledby="wege-heading">
      <p class="eyebrow">Zwei Wege</p>
      <h2 id="wege-heading">Bitcoin oder Euro. Beides kommt direkt an.</h2>
      <div class="donate-grid">
        <article class="donate-card" id="bitcoin" data-copy-scope>
          <p class="step">Bitcoin</p>
          <h3>Über unseren BTCPay-Server</h3>
          <p>
            Lightning oder On-Chain, Betrag frei wählbar. Der Server gehört dem
            Verein. Kein Zahlungsdienstleister ist zwischengeschaltet, und wir
            erheben dabei keine personenbezogenen Daten.
          </p>
          <a class="button primary" href={btcpay} target="_blank" rel="noopener"
            >Mit Bitcoin spenden</a
          >
          <dl class="bank-details">
            <div>
              <dt>Adresse für ein anderes Gerät</dt>
              <dd>
                <span>pay.bitcoin-austria.at</span>
                <button
                  class="copy-button"
                  type="button"
                  data-copy-value={btcpay}
                  aria-label="Link zum BTCPay-Server kopieren"
                >
                  Link kopieren
                </button>
              </dd>
            </div>
          </dl>
          <p class="copy-status" data-copy-status aria-live="polite"></p>
        </article>

        <article class="donate-card" id="euro" data-copy-scope>
          <p class="step">Euro</p>
          <h3>Per Überweisung</h3>
          <p>
            Klassisch aufs Vereinskonto. Mit dem Verwendungszweck ordnen wir die
            Spende der DAC8-Arbeit zu.
          </p>
          <dl class="bank-details">
            {bankDetails.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>
                  <span>{detail.value}</span>
                  <button
                    class="copy-button"
                    type="button"
                    data-copy-value={detail.copy ?? detail.value}
                    aria-label={`${detail.label} kopieren`}
                  >
                    Kopieren
                  </button>
                </dd>
              </div>
            ))}
          </dl>
          <p class="copy-status" data-copy-status aria-live="polite"></p>
        </article>
      </div>
      <aside class="clarification">
        <strong>Größerer Beitrag?</strong>
        Wer gezielt Rechts- oder Gutachterkosten tragen will, schreibt uns
        vorher kurz an
        <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>. Dann klären wir
        Zweckbindung und Abwicklung, bevor Geld fließt.
      </aside>
    </section>

    <section id="verwendung" aria-labelledby="verwendung-heading">
      <p class="eyebrow">Wofür</p>
      <h2 id="verwendung-heading">Vier Posten, kein Overhead-Apparat.</h2>
      <p class="section-intro">
        Die Kampagne wird ehrenamtlich getragen. Geld fließt dorthin, wo
        Ehrenamt nicht reicht: in juristische Arbeit, Belege und die Technik,
        die alles zusammenhält.
      </p>
      <ol class="numbered">
        {uses.map((use) => (
          <li>
            <h3>{use.title}</h3>
            <p>{use.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="verein" class="position" aria-labelledby="verein-heading">
      <div>
        <p class="eyebrow">Wer das Geld bekommt</p>
        <h2 id="verein-heading">Bitcoin Austria. Seit 2011.</h2>
        <p class="section-intro">
          Bitcoin Austria ist Europas ältester Bitcoin-Verein, gegründet 2011 in
          Wien. Der Verein ist gemeinnützig, nicht auf Gewinn ausgerichtet und
          fördert Verständnis und Verbreitung von Bitcoin in Österreich.
          dac8.org ist seine Initiative gegen anlasslose Finanzüberwachung –
          nicht, weil es um Bitcoin geht, sondern weil der Maßstab für alle
          gilt.
        </p>
        <a class="text-link" href="https://bitcoin-austria.at"
          >Zur Vereinswebsite</a
        >
      </div>
      <aside class="legal-note" aria-labelledby="transparenz-heading">
        <p class="eyebrow">Transparenz</p>
        <h3 id="transparenz-heading">Fragen zur Verwendung? Frag.</h3>
        <p>
          Bitcoin Austria – Verein zur Förderung von Bitcoin in Österreich,
          ZVR-Zahl 828542896, Sitz in Wien. Vertretung und Postanschrift stehen
          im Impressum. Wer wissen will, wofür Spenden verwendet wurden,
          schreibt an <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>.
        </p>
        <a class="text-link" href="/impressum/">Zum Impressum</a>
      </aside>
    </section>
  </article>

  <script>
    const fallbackCopy = (text: string) => {
      const helper = document.createElement("textarea")
      helper.value = text
      helper.setAttribute("readonly", "")
      helper.style.position = "fixed"
      helper.style.opacity = "0"
      document.body.append(helper)
      helper.select()
      const copied = document.execCommand("copy")
      helper.remove()
      return copied
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-value]")
      .forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.dataset.copyValue ?? ""
          const status = button
            .closest("[data-copy-scope]")
            ?.querySelector<HTMLElement>("[data-copy-status]")
          if (!status) return
          try {
            if (!navigator.clipboard?.writeText) throw new Error()
            await navigator.clipboard.writeText(text)
            status.textContent = "Kopiert."
          } catch {
            status.textContent = fallbackCopy(text)
              ? "Kopiert."
              : "Kopieren nicht möglich. Bitte den Text markieren."
          }
        })
      })
  </script>
</Layout>
