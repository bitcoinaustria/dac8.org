---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const btcpay =
  "https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"

const bankDetails = [
  { label: "Empfänger", value: "Bitcoin Austria" },
  {
    label: "IBAN",
    value: "AT94 2011 1857 7690 6800",
    copy: "AT942011185776906800",
  },
  { label: "BIC", value: "GIBAATWWXXX" },
  { label: "Verwendungszweck", value: "DAC8" },
]

const fundingUses = [
  {
    title: "Anwaltliche Prüfung",
    text: "Sachverhalt, Anbieter und Rechtsweg sauber aufbauen, bevor etwas eingebracht wird.",
  },
  {
    title: "Gutachten und Recherche",
    text: "Behauptungen gegen Quellen prüfen und Fachmeinungen einholen.",
  },
  {
    title: "Werkzeuge",
    text: "Diese Website, die Generatoren und der eigene BTCPay-Server, alles ohne Tracker.",
  },
  {
    title: "Öffentlichkeit",
    text: "Gespräche mit Abgeordneten, Medien und anderen Organisationen.",
  },
]
---

<Layout
  sections={[
    { id: "wege", label: "Bitcoin oder Euro" },
    { id: "verwendung", label: "Wofür das Geld ist" },
    { id: "verein", label: "Wer es bekommt" },
  ]}
>
  <MetaPage
    slot="head"
    title="Spenden"
    description="Unterstütze die Arbeit gegen Finanzüberwachung auf Vorrat: Spende in Bitcoin über den BTCPay-Server von Bitcoin Austria oder in Euro per Überweisung."
  />

  <article class="campaign">
    <header class="hero">
      <h1>Gegenwehr kostet. <span>Trag mit.</span></h1>
      <p class="lead">
        Anwälte, Gutachten und Recherche kosten Geld. Deine Spende geht direkt
        an Bitcoin Austria, den Verein hinter dac8.org.
      </p>
      <nav class="hero-actions" aria-label="Spendenweg wählen">
        <a class="button primary" href={btcpay} target="_blank" rel="noopener"
          >Mit Bitcoin spenden</a
        >
        <a class="button" href="#euro">Per Überweisung</a>
      </nav>
    </header>

    <section id="wege" aria-labelledby="wege-heading">
      <h2 id="wege-heading">Bitcoin oder Euro</h2>
      <div class="cards">
        <article id="bitcoin" data-copy-scope>
          <h3>Bitcoin</h3>
          <p class="where">Lightning oder On-Chain, Betrag frei wählbar</p>
          <p>
            Der Server gehört dem Verein und fragt weder Namen noch E-Mail ab.
          </p>
          <a class="button primary" href={btcpay} target="_blank" rel="noopener"
            >Mit Bitcoin spenden</a
          >
          <dl class="bank-details">
            <div>
              <dt>Link für ein anderes Gerät</dt>
              <dd>
                <span>pay.bitcoin-austria.at</span>
                <button
                  class="copy-button"
                  type="button"
                  data-copy-value={btcpay}
                  aria-label="Link zum BTCPay-Server kopieren"
                >
                  Link kopieren
                </button>
              </dd>
            </div>
          </dl>
          <p class="copy-status" data-copy-status aria-live="polite"></p>
        </article>

        <article id="euro" data-copy-scope>
          <h3>Euro</h3>
          <p class="where">Überweisung aufs Vereinskonto</p>
          <dl class="bank-details">
            {bankDetails.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>
                  <span>{detail.value}</span>
                  <button
                    class="copy-button"
                    type="button"
                    data-copy-value={detail.copy ?? detail.value}
                    aria-label={`${detail.label} kopieren`}
                  >
                    Kopieren
                  </button>
                </dd>
              </div>
            ))}
          </dl>
          <p class="copy-status" data-copy-status aria-live="polite"></p>
        </article>
      </div>
      <p class="prose">
        <strong>Größerer Beitrag?</strong>
        Schreib uns vorher kurz an
        <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>, dann klären wir
        die Zweckbindung.
      </p>
    </section>

    <section id="verwendung" aria-labelledby="verwendung-heading">
      <h2 id="verwendung-heading">Wofür das Geld ist</h2>
      <p class="section-intro">
        Die Kampagne ist ehrenamtlich. Geld fließt nur dorthin, wo Ehrenamt
        nicht reicht.
      </p>
      <ul class="facts">
        {fundingUses.map((use) => (
          <li>
            <strong>{use.title}</strong>
            <p>{use.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="verein" aria-labelledby="verein-heading">
      <h2 id="verein-heading">Wer das Geld bekommt</h2>
      <p class="section-intro">
        Bitcoin Austria, gemeinnütziger Verein, gegründet 2011 in Wien.
        ZVR&#8209;Zahl 828542896.
      </p>
      <p class="prose">
        Eine Spende begründet keinen Anspruch auf Beteiligung oder einen
        bestimmten Ausgang. Fragen zur Verwendung beantworten wir unter
        <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>.
      </p>
      <a class="text-link" href="https://bitcoin-austria.at"
        >Zur Vereinswebsite</a
      >
    </section>
  </article>

  <script>
    const fallbackCopy = (text: string) => {
      const helper = document.createElement("textarea")
      helper.value = text
      helper.setAttribute("readonly", "")
      helper.style.position = "fixed"
      helper.style.opacity = "0"
      document.body.append(helper)
      helper.select()
      const copied = document.execCommand("copy")
      helper.remove()
      return copied
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-value]")
      .forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.dataset.copyValue ?? ""
          const status = button
            .closest("[data-copy-scope]")
            ?.querySelector<HTMLElement>("[data-copy-status]")
          if (!status) return
          try {
            if (!navigator.clipboard?.writeText) throw new Error()
            await navigator.clipboard.writeText(text)
            status.textContent = "Kopiert."
          } catch {
            status.textContent = fallbackCopy(text)
              ? "Kopiert."
              : "Kopieren nicht möglich. Bitte den Text markieren."
          }
        })
      })
  </script>
</Layout>
