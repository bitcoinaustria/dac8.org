---
import MetaPage from "@/components/MetaPage.astro"
import CopyButton from "@/components/CopyButton.astro"
import Layout from "@/layouts/Layout.astro"

const btcpay =
  "https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"

const bankDetails = [
  { label: "Empfänger", value: "Bitcoin Austria" },
  {
    label: "IBAN",
    value: "AT94 2011 1857 7690 6800",
    copy: "AT942011185776906800",
  },
  { label: "BIC", value: "GIBAATWWXXX" },
  { label: "Verwendungszweck", value: "DAC8" },
]

const fundingUses = [
  {
    title: "Anwaltliche Prüfung",
    text: "Konkrete Fälle und mögliche Rechtswege anwaltlich prüfen lassen.",
  },
  {
    title: "Gutachten und Recherche",
    text: "Primärquellen auswerten und fachliche Gutachten einholen.",
  },
  {
    title: "Werkzeuge",
    text: "Diese Website, die Generatoren und der eigene BTCPay-Server, alles ohne Tracker.",
  },
  {
    title: "Öffentlichkeit",
    text: "Gespräche mit Abgeordneten, Medien und anderen Organisationen.",
  },
]
---

<Layout
  sections={[
    { id: "wege", label: "Bitcoin oder Euro" },
    { id: "verwendung", label: "Wofür das Geld ist" },
    { id: "verein", label: "Wer es bekommt" },
  ]}
>
  <MetaPage
    slot="head"
    title="Spenden"
    description="Unterstütze die Arbeit gegen Finanzüberwachung auf Vorrat: Spende in Bitcoin über den BTCPay-Server von Bitcoin Austria oder in Euro per Überweisung."
  />

  <article class="campaign">
    <header class="hero">
      <h1>Unterstütze <span>den Rechtsweg.</span></h1>
      <p class="lead">
        Anwälte, Gutachten und Recherche kosten Geld. Deine Spende geht direkt
        an Bitcoin Austria, den Verein hinter dac8.org.
      </p>
      <nav class="hero-actions" aria-label="Spendenweg wählen">
        <a class="button primary" href={btcpay} target="_blank" rel="noopener"
          >Mit Bitcoin spenden</a
        >
        <a class="button" href="#euro">Per Überweisung</a>
      </nav>
    </header>

    <section id="wege" aria-labelledby="wege-heading">
      <h2 id="wege-heading">Bitcoin oder Euro</h2>
      <div class="donation-options">
        <article
          id="bitcoin"
          class="donation-method"
          data-copy-scope
          aria-labelledby="bitcoin-heading"
        >
          <header class="donation-heading">
            <span class="payment-symbol" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M8 4h6a4 4 0 0 1 0 8H8m0 0h7a4 4 0 0 1 0 8H8M8 4v16M5 4h3M5 20h3M11 2v2m4-2v2M11 20v2m4-2v2"
                />
              </svg>
            </span>
            <div>
              <h3 id="bitcoin-heading">Bitcoin</h3>
              <p>Direkt an Bitcoin Austria</p>
            </div>
          </header>
          <div class="bitcoin-payment">
            <ul class="payment-methods" aria-label="Zahlungsarten">
              <li>Lightning</li>
              <li>On-Chain</li>
            </ul>
            <p class="payment-description">
              Du bestimmst den Betrag. Unser eigener BTCPay-Server fragt weder
              Namen noch E-Mail ab.
            </p>
            <a
              class="button primary donation-action"
              href={btcpay}
              target="_blank"
              rel="noopener"
            >
              Mit Bitcoin spenden
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M14 4h6v6M20 4 10 14M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"
                />
              </svg>
            </a>
          </div>
          <div class="payment-link">
            <div>
              <p class="detail-label">Spendenlink teilen</p>
              <span>pay.bitcoin-austria.at</span>
            </div>
            <CopyButton value={btcpay} label="Spendenlink" />
          </div>
          <p
            class="payment-status"
            data-copy-status
            role="status"
            aria-atomic="true"
          ></p>
        </article>

        <article
          id="euro"
          class="donation-method"
          data-copy-scope
          aria-labelledby="euro-heading"
        >
          <header class="donation-heading">
            <span class="payment-symbol" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 10h12M4 14h9M19 5a7 7 0 0 0-5-2c-5 0-7 4-7 9s2 9 7 9a7 7 0 0 0 5-2"
                />
              </svg>
            </span>
            <div>
              <h3 id="euro-heading">Euro</h3>
              <p>Überweisung aufs Vereinskonto</p>
            </div>
          </header>
          <dl class="bank-details">
            {bankDetails.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>
                  <span>{detail.value}</span>
                  <CopyButton value={detail.copy ?? detail.value} label={detail.label} />
                </dd>
              </div>
            ))}
          </dl>
          <p
            class="payment-status"
            data-copy-status
            role="status"
            aria-atomic="true"
          ></p>
        </article>
      </div>
      <p class="prose">
        <strong>Größerer Beitrag?</strong>
        Schreib uns vorher kurz an
        <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>, dann klären wir
        die Zweckbindung.
      </p>
    </section>

    <section id="verwendung" aria-labelledby="verwendung-heading">
      <h2 id="verwendung-heading">Wofür das Geld ist</h2>
      <p class="section-intro">
        Wir arbeiten ehrenamtlich. Spenden helfen, die folgenden Kosten zu
        decken.
      </p>
      <ul class="facts">
        {fundingUses.map((use) => (
          <li>
            <strong>{use.title}</strong>
            <p>{use.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="verein" aria-labelledby="verein-heading">
      <h2 id="verein-heading">Wer das Geld bekommt</h2>
      <p class="section-intro">
        Bitcoin Austria, gemeinnütziger Verein, gegründet 2011 in Wien.
        ZVR&#8209;Zahl 828542896.
      </p>
      <p class="prose">
        Eine Spende begründet keinen Anspruch auf Beteiligung oder einen
        bestimmten Ausgang. Fragen zur Verwendung beantworten wir unter
        <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>.
      </p>
      <a class="text-link" href="https://bitcoin-austria.at"
        >Zur Vereinswebsite</a
      >
    </section>
  </article>

  <script>
    const fallbackCopy = (text: string) => {
      const helper = document.createElement("textarea")
      helper.value = text
      helper.setAttribute("readonly", "")
      helper.style.position = "fixed"
      helper.style.opacity = "0"
      document.body.append(helper)
      helper.select()
      try {
        return document.execCommand("copy")
      } finally {
        helper.remove()
      }
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-value]")
      .forEach((button) => {
        let resetTimer: ReturnType<typeof setTimeout>
        button.addEventListener("click", async () => {
          const text = button.dataset.copyValue ?? ""
          const label = button.dataset.copyLabel ?? "Text"
          const status = button
            .closest("[data-copy-scope]")
            ?.querySelector<HTMLElement>("[data-copy-status]")
          if (!status) return
          let copied = false
          try {
            if (!navigator.clipboard?.writeText) throw new Error()
            await navigator.clipboard.writeText(text)
            copied = true
          } catch {
            try {
              copied = fallbackCopy(text)
            } catch {
              copied = false
            } finally {
              button.focus({ preventScroll: true })
            }
          }
          clearTimeout(resetTimer)
          button.dataset.copied = String(copied)
          button.title = copied ? `${label} kopiert` : `${label} kopieren`
          status.textContent = copied
            ? `${label} kopiert.`
            : "Kopieren nicht möglich. Bitte den Text markieren."
          resetTimer = setTimeout(() => {
            delete button.dataset.copied
            button.title = `${label} kopieren`
          }, 2000)
        })
      })
  </script>
</Layout>
