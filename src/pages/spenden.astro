---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const btcpay =
  "https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"

const bankDetails = [
  { label: "Empfänger", value: "Bitcoin Austria" },
  {
    label: "IBAN",
    value: "AT94 2011 1857 7690 6800",
    copy: "AT942011185776906800",
  },
  { label: "BIC", value: "GIBAATWWXXX" },
  { label: "Verwendungszweck", value: "DAC8" },
]

const fundingUses = [
  {
    title: "Anwaltliche Prüfung",
    text: "Ein tragfähiger Fall braucht Juristinnen und Juristen, die Sachverhalt, Anbieter und Rechtsweg sauber aufbauen, bevor irgendetwas eingebracht wird.",
  },
  {
    title: "Gutachten und Recherche",
    text: "Gesetzestexte lesen, Behauptungen gegen Quellen prüfen, Fachmeinungen einholen. Das ist der Teil, der die Kampagne glaubwürdig hält.",
  },
  {
    title: "Werkzeuge und Infrastruktur",
    text: "Diese Website, die lokal arbeitenden Generatoren und unser eigener BTCPay-Server kommen ohne Werbetracker aus. Welche technischen Daten anfallen, steht in der Datenschutzerklärung.",
  },
  {
    title: "Öffentlichkeit",
    text: "Gespräche mit Abgeordneten, Medien und anderen Organisationen, damit Finanzüberwachung auf Vorrat nicht unwidersprochen zum Standard wird.",
  },
]
---

<Layout
  sections={[
    { id: "wege", label: "Bitcoin oder Euro" },
    { id: "verwendung", label: "Wofür das Geld ist" },
    { id: "verein", label: "Wer es bekommt" },
  ]}
>
  <MetaPage
    slot="head"
    title="Spenden"
    description="Unterstütze die Arbeit gegen Finanzüberwachung auf Vorrat: Spende in Bitcoin über den BTCPay-Server von Bitcoin Austria oder in Euro per Überweisung."
  />

  <article class="campaign">
    <header class="hero">
      <h1>Gegenwehr kostet. <span>Trag mit.</span></h1>
      <p class="lead">
        Recherche, anwaltliche Prüfung, Gutachten und diese Website kosten Geld.
        Deine Spende geht direkt an <strong>Bitcoin Austria</strong>, den
        gemeinnützigen Verein hinter dac8.org – in Bitcoin über unseren eigenen
        Server oder in Euro per Überweisung.
      </p>
      <nav class="hero-actions" aria-label="Spendenweg wählen">
        <a class="button primary" href={btcpay} target="_blank" rel="noopener"
          >Mit Bitcoin spenden</a
        >
        <a class="button" href="#euro">Per Überweisung</a>
      </nav>
      <dl class="glance" aria-label="Das Wichtigste zur Spende">
        <dt>Empfänger</dt>
        <dd>Bitcoin Austria, Verein (ZVR 828542896)</dd>
        <dt>Bitcoin</dt>
        <dd>eigener BTCPay-Server, Lightning oder On-Chain</dd>
        <dt>Euro</dt>
        <dd>Vereinskonto, Verwendungszweck DAC8</dd>
        <dd class="glance-note">
          Eine Spende begründet keinen Anspruch auf Beteiligung oder einen
          bestimmten Ausgang.
        </dd>
      </dl>
    </header>

    <section id="wege" aria-labelledby="wege-heading">
      <h2 id="wege-heading">Bitcoin oder Euro</h2>
      <p class="section-intro">
        Beide Wege führen direkt zum Verein, ohne Zwischenhändler.
      </p>
      <div class="cards">
        <article id="bitcoin" data-copy-scope>
          <h3>Bitcoin</h3>
          <p class="where">
            über unseren BTCPay-Server, Lightning oder On-Chain
          </p>
          <p>
            Betrag frei wählbar. Der Server gehört dem Verein und fragt weder
            Namen noch E-Mail-Adresse ab. Welche technischen Daten dabei
            anfallen, steht in der
            <a href="/datenschutz/">Datenschutzerklärung</a>.
          </p>
          <a class="button primary" href={btcpay} target="_blank" rel="noopener"
            >Mit Bitcoin spenden</a
          >
          <dl class="bank-details">
            <div>
              <dt>Link für ein anderes Gerät</dt>
              <dd>
                <span>pay.bitcoin-austria.at</span>
                <button
                  class="copy-button"
                  type="button"
                  data-copy-value={btcpay}
                  aria-label="Link zum BTCPay-Server kopieren"
                >
                  Link kopieren
                </button>
              </dd>
            </div>
          </dl>
          <p class="copy-status" data-copy-status aria-live="polite"></p>
        </article>

        <article id="euro" data-copy-scope>
          <h3>Euro</h3>
          <p class="where">per Überweisung aufs Vereinskonto</p>
          <p>
            Mit dem Verwendungszweck DAC8 ordnen wir die Spende dieser Arbeit
            zu.
          </p>
          <dl class="bank-details">
            {bankDetails.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>
                  <span>{detail.value}</span>
                  <button
                    class="copy-button"
                    type="button"
                    data-copy-value={detail.copy ?? detail.value}
                    aria-label={`${detail.label} kopieren`}
                  >
                    Kopieren
                  </button>
                </dd>
              </div>
            ))}
          </dl>
          <p class="copy-status" data-copy-status aria-live="polite"></p>
        </article>
      </div>
      <aside class="note">
        <strong>Größerer Beitrag?</strong>
        Wer gezielt Rechts- oder Gutachterkosten tragen will, schreibt uns
        vorher kurz an
        <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>. Dann klären wir
        Zweckbindung und Abwicklung, bevor Geld fließt.
      </aside>
    </section>

    <section id="verwendung" aria-labelledby="verwendung-heading">
      <h2 id="verwendung-heading">Wofür das Geld verwendet wird</h2>
      <p class="section-intro">
        Die Kampagne wird ehrenamtlich getragen. Geld fließt dorthin, wo
        Ehrenamt nicht reicht.
      </p>
      <ul class="facts">
        {fundingUses.map((use) => (
          <li>
            <strong>{use.title}</strong>
            <p>{use.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="verein" class="split" aria-labelledby="verein-heading">
      <div>
        <h2 id="verein-heading">Wer das Geld bekommt</h2>
        <p class="section-intro">
          Bitcoin Austria ist Europas ältester Bitcoin-Verein, gegründet 2011 in
          Wien. Der Verein ist gemeinnützig und nicht auf Gewinn ausgerichtet.
        </p>
        <p class="prose">
          dac8.org ist die Initiative des Vereins gegen die anlasslose Erfassung
          von Finanzdaten – nicht, weil es um Bitcoin geht, sondern weil der
          Maßstab für alle gilt.
        </p>
        <a class="text-link" href="https://bitcoin-austria.at"
          >Zur Vereinswebsite</a
        >
      </div>
      <aside class="status" aria-labelledby="transparenz-heading">
        <h3 id="transparenz-heading">Transparenz</h3>
        <dl>
          <div>
            <dt>Verein</dt>
            <dd>
              Bitcoin Austria – Verein zur Förderung von Bitcoin in Österreich
            </dd>
          </div>
          <div>
            <dt>ZVR-Zahl</dt>
            <dd>828542896, Sitz in Wien</dd>
          </div>
          <div>
            <dt>Fragen zur Verwendung</dt>
            <dd><a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a></dd>
          </div>
        </dl>
        <a class="text-link" href="/impressum/">Zum Impressum</a>
      </aside>
    </section>
  </article>

  <script>
    const fallbackCopy = (text: string) => {
      const helper = document.createElement("textarea")
      helper.value = text
      helper.setAttribute("readonly", "")
      helper.style.position = "fixed"
      helper.style.opacity = "0"
      document.body.append(helper)
      helper.select()
      const copied = document.execCommand("copy")
      helper.remove()
      return copied
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-value]")
      .forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.dataset.copyValue ?? ""
          const status = button
            .closest("[data-copy-scope]")
            ?.querySelector<HTMLElement>("[data-copy-status]")
          if (!status) return
          try {
            if (!navigator.clipboard?.writeText) throw new Error()
            await navigator.clipboard.writeText(text)
            status.textContent = "Kopiert."
          } catch {
            status.textContent = fallbackCopy(text)
              ? "Kopiert."
              : "Kopieren nicht möglich. Bitte den Text markieren."
          }
        })
      })
  </script>
</Layout>
