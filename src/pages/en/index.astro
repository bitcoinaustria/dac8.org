---
import Artwork from "@/components/Artwork.astro"
import CampaignPartners from "@/components/CampaignPartners.astro"
import CampaignStatus from "@/components/CampaignStatus.astro"
import HistoryStack from "@/components/HistoryStack.astro"
import LeakMatrix from "@/components/LeakMatrix.astro"
import LegalRoute from "@/components/LegalRoute.astro"
import MetaPage from "@/components/MetaPage.astro"
import Tale from "@/components/Tale.astro"
import Layout from "@/layouts/Layout.astro"
import { homeObjections, points } from "@/data/arguments"
import { campaignStatus } from "@/data/campaign"
---

<Layout>
  <MetaPage slot="head" />
  <article class="campaign landing">
    <header class="hero">
      <div class="hero-text">
        <CampaignStatus language="en" />
        <h1>
          DAC8 records every crypto customer.
          <span>We are fighting back.</span>
        </h1>
        <p class="lead">
          Since 2026, exchanges and brokers in Austria have had to prepare a
          yearly record for the tax authority of what you buy, sell, exchange
          and transfer, including to your own wallet. For all customers, without
          suspicion.
        </p>
        <nav class="hero-actions" aria-label="Get started">
          <a class="button primary" href="/en/get-involved/#spenden"
            >Support the case</a
          >
          <a class="button" href="/en/your-file/"
            >What DAC8 reports about you</a
          >
        </nav>
      </div>
      <Artwork
        id="collectionReview"
        language="en"
        size="hero"
        priority
        caption="Our planned complaint starts from one provider’s processing of a customer’s data. It asks whether the legal requirements are compatible with fundamental rights."
      />
    </header>
    <section class="figures" aria-label="DAC8 in Austria">
      <dl class="keyfigures">
        <div>
          <dt>
            <strong>Customers</strong>
            are covered, including those who are not ultimately reported.
          </dt>
          <dd>All</dd>
        </div>
        <div>
          <dt>
            <strong>Retention</strong>
            of each annual report by the provider.
          </dt>
          <dd>10 <small>years</small></dd>
        </div>
        <div>
          <dt>
            <strong>First report</strong>
            to the tax authority, for the year 2026.
          </dt>
          <dd><time datetime="2027-07-31">31 July 2027</time></dd>
        </div>
      </dl>
    </section>
    <section id="problem" aria-labelledby="problem-heading">
      <h2 id="problem-heading">What happens to your data</h2>
      <Tale
        language="en"
        steps={[
          {
            art: "accountToRecord",
            chapter: "What the provider collects",
            title: "Your account becomes a file.",
            text: "Your provider records your ID, your individual transactions and details of your wallet addresses under anti-money-laundering rules. For DAC8 it adds your tax identification number and tax residence and, for the report, works out your annual totals per crypto-asset: bought, sold, exchanged. Transfers to your own wallet appear too, although they trigger no tax by themselves.",
          },
          {
            art: "paragraphWatch",
            title: "Everyone recorded. Without suspicion.",
            text: "Providers prepare this reporting data for all customers, including those who will not ultimately be reported, for instance because they are tax-resident only in a country without data exchange. Austrian law requires it, going beyond the EU directive.",
          },
          {
            art: "yearsOnFile",
            title: "More about you. Every year.",
            text: "Anti-money-laundering rules currently require your provider to keep identification and transaction records for up to ten years after the customer relationship ends. Austria’s crypto reporting act (Krypto-MPfG) links this store with your tax data. On top of that comes a report every year, which the provider deletes only ten years after the reporting year.",
          },
          {
            art: "dataHack",
            chapter: "What it can lead to",
            title: "Stored. Hacked. Sold.",
            text: "The more data sits in one place, and the longer, the more a break-in pays. Exchanges, identity verification services and tax administrations have already lost such data.",
          },
          {
            art: "profileFourSources",
            title: "Every leak sharpens your profile.",
            text: "Your face from the web, your wallet from a leak, your holdings from a hacked tax service. Together they reveal who you are, where you live and what you probably own.",
          },
          {
            art: "rankedPortrait",
            title: "The more you move, the higher you rank.",
            text: "In Austria, fraudsters phish for crypto holders with fake tax-office messages. A breach at a provider would hand them the list ready-made, sorted by volume. Whether the estimate is right does not matter to criminals.",
          },
          {
            art: "targetAtHome",
            title: "Your profile. Your address. A target.",
            text: "Whoever holds their own keys can transfer without a bank’s approval, and a bitcoin transaction cannot be reversed. In the first half of 2026, the French interior ministry counted 77 kidnappings, unlawful detentions and extortion cases involving crypto-assets.",
          },
        ]}
      />
      <div class="link-row">
        <a class="text-link" href="/en/your-file/"
          >What DAC8 reports about you</a
        >
        <a class="text-link" href="/en/arguments/">Why it is a problem</a>
      </div>
    </section>

    <section id="handeln" class="peak" aria-labelledby="handeln-heading">
      <h2 id="handeln-heading">
        We are fighting back.
        <span>Join in.</span>
      </h2>
      <p class="section-intro">
        Bitcoin Austria is preparing a complaint. We want to have it clarified
        which financial data the state really needs and how long it may be kept.
        This is how you help most:
      </p>
      <ul class="peak-actions">
        <li class="peak-lead">
          <Artwork id="financeTheCase" language="en" caption={false} />
          <h3>Help fund the case</h3>
          <p>Your donation pays for the proceedings.</p>
          <a class="button primary" href="/en/get-involved/#spenden">Donate</a>
        </li>
        <li>
          <h3>Ask your provider</h3>
          <p>
            A GDPR request: what it holds on you, including for DAC8, for how
            long and for whom.
          </p>
          <a class="button" href="/en/access-request/">Request access</a>
        </li>
        <li>
          <h3>Write to your MPs</h3>
          <p>
            A letter to the National Council, drafted in your browser and sent
            by you.
          </p>
          <a class="button" href="/en/get-involved/#abgeordnete"
            >Write a letter</a
          >
        </li>
      </ul>
      <div class="link-row">
        <a class="text-link" href="/en/proceedings/">Follow the case</a>
        <a class="text-link" href="/en/get-involved/#teilen"
          >Share the campaign</a
        >
      </div>
    </section>

    <section id="faelle" aria-labelledby="faelle-heading">
      <h2 id="faelle-heading">This has already happened</h2>
      <p class="section-intro">
        Name, ID, wallet and holdings: every one of these pieces has already
        ended up in the wrong hands. These cases show concrete dangers. They do
        not show that DAC8 caused them.
      </p>
      <LeakMatrix language="en" />
      <div class="link-row">
        <a class="text-link" href="/en/attacks/"
          >Attacks on crypto holders worldwide</a
        >
        <a class="text-link" href="/en/dossier/#faelle"
          >More cases and sources</a
        >
      </div>
    </section>

    <section id="geschichte" aria-labelledby="geschichte-heading">
      <h2 id="geschichte-heading">How DAC8 came about</h2>
      <p class="section-intro">
        It began in 1977 with assistance in individual cases. Today banks,
        platforms and crypto providers report every year, more with each step.
      </p>
      <HistoryStack language="en" compact />
      <a class="text-link" href="/en/history/">The full history since 1977</a>
    </section>

    <section id="einwaende" aria-labelledby="einwaende-heading">
      <h2 id="einwaende-heading" class="statement">
        Privacy needs no justification.
        <span>State interference does.</span>
      </h2>
      <ul class="objections">
        {homeObjections.map((id) => points.en[id]).map((point) => (
          <li>
            <strong>{point.title}</strong>
            <p>{point.text}</p>
            {point.link && <a class="text-link" href={point.link.href}>{point.link.label}</a>}
          </li>
        ))}
      </ul>
      <div class="link-row">
        <a class="text-link" href="/en/arguments/"
          >All arguments and objections</a
        >
        <a class="text-link" href="/en/arguments/#forderungen">Our demands</a>
      </div>
    </section>

    <section id="weg" aria-labelledby="weg-heading">
      <h2 id="weg-heading">What we are doing</h2>
      <div class="columns">
        <p class="section-intro">
          <strong
            >We are convinced that the blanket collection of all customers’ data
            violates fundamental rights.</strong
          >
        </p>
        <p class="prose">
          {campaignStatus.en.text}
        </p>
      </div>
      <LegalRoute language="en" />
      <ul class="checklist goals" aria-label="What we aim to achieve">
        <li>Overturn disproportionate obligations</li>
        <li>Limit data collection</li>
        <li>Secure effective protection for those affected</li>
      </ul>
      <a class="text-link" href="/en/proceedings/">Where the case stands</a>
    </section>

    <section id="position" aria-labelledby="position-heading">
      <h2 id="position-heading">Who we are</h2>
      <div class="about">
        <div>
          <p class="section-intro">
            dac8.org is an initiative by Bitcoin Austria, the nonprofit Bitcoin
            association founded in Vienna in 2011. We are Bitcoiners and
            cypherpunks. We see privacy as a prerequisite for a free society.
          </p>
          <p class="prose">
            The campaign concerns everyone covered by DAC8, whatever
            crypto-assets they use. It starts in Austria, but DAC8 applies
            across the EU. If you want to challenge the law in your country, get
            in touch:
            <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>
          </p>
        </div>
        <CampaignPartners />
      </div>
    </section>
  </article>
</Layout>
