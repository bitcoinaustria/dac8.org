---
import Artwork from "@/components/Artwork.astro"
import Disclosure from "@/components/Disclosure.astro"
import Glossary from "@/components/Glossary.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { campaignStatus } from "@/data/campaign"
import { peopleAffected, roundPeople } from "@/data/leaks"
import { sourceGroups } from "@/data/sources"
import "@/styles/dossier.css"

// The English edition of src/pages/dossier.astro; keep both in step.
const researchDate = "30 September 2026"
const sourceCount = sourceGroups.reduce(
  (n, group) => n + group.sources.length,
  0,
)
const sources = sourceGroups.map((group) => ({
  title: group.titleEn,
  sources: group.sources.map((source) => ({
    href: source.href,
    label: source.labelEn,
  })),
}))

const overview = [
  {
    title: "You are affected if you use a provider.",
    text: "Providers are the exchanges, brokers and apps where you buy, sell or keep crypto-assets. Anyone who only self-custodies, holding the keys to their bitcoin themselves, and never buys or sells through a provider is not reported.",
  },
  {
    title: "The tax office receives your identity and annual totals.",
    text: "Name, postal address, date of birth, tax residence, tax identification number and, for each crypto-asset, the totals for the year. Transfers to your own wallet usually appear as a total, without wallet addresses.",
  },
  {
    title: "The details stay with the provider.",
    text: "Anti-money-laundering rules require it to keep your ID, wallet addresses and individual transactions, currently for up to ten years after the customer relationship ends.",
  },
  {
    title: "The first report is due by 31 July 2027.",
    text: "Providers with Austrian reporting obligations then report 2026 to the tax office. If you live in Germany or another EU country, Austria passes the report on to it by 30 September 2027.",
  },
  {
    title: "Our complaint has been filed.",
    text: "It is with the Austrian Data Protection Authority. Data collection continues during the proceedings.",
  },
]

const faqs = [
  {
    question: "Will my wallet address be reported?",
    answer:
      "No, wallet addresses are not in the annual report. But the value and units transferred to wallet addresses not known to belong to another provider are reported, as a total. This usually includes your own wallet. The wallet address and its link to you nevertheless remain stored with the provider under anti-money-laundering rules.",
  },
  {
    question: "Can the report reveal my wealth?",
    answer:
      "Not directly. It contains annual totals, not current balances or total wealth. Your provider does know your balance, though, and over the years the reports show how much you move. Anyone who combines them with the bank account register and blockchain analysis or, after a breach, with provider records can build a detailed picture of a person’s assets.",
  },
  {
    question: "What about purchases and sales before 2026?",
    answer:
      "They will not be reported retroactively. The first reporting period starts on 1 January 2026. A retroactive obligation would require a new law; neither DAC9 nor the current proposal to recast the directive provides for this. The provider still holds older transactions: since 2020, anti-money-laundering rules have required it to keep them, currently for up to ten years after the customer relationship ends.",
  },
  {
    question: "I live in Germany. Who receives my data?",
    answer:
      "With a provider that reports in Austria, your annual report goes to the Austrian tax office first, and Austria passes it on to Germany by 30 September, because you are tax-resident there. Providers in Germany or another EU country report there; the data also ends up with the German tax authorities. Whatever a country receives through the exchange it must keep for at least five years under the directive, which sets no fixed maximum. Your ID, wallet addresses and individual transactions stay with the provider.",
  },
  {
    question: "What does the complaint change for me?",
    answer:
      "Nothing yet: data collection continues during the proceedings. We are convinced that collecting data on every customer violates fundamental rights. The Data Protection Authority is bound by the law, so we expect it to dismiss the complaint. After that, the courts decide, including whether the case goes to the Court of Justice of the European Union. How long this will take, and how individuals can take part, we are still working out.",
  },
  {
    question: "How do I recognise phishing that uses the reporting duty?",
    answer:
      "Fake FinanzOnline messages are already circulating in Austria, asking about your holdings on the pretext of new crypto tax rules. The tax office does not ask about them by email or text message. No legitimate sender asks you to connect a wallet or enter your recovery phrase, the words that restore a wallet. Your provider reports the DAC8 data itself. Be discreet about your holdings, including with acquaintances and on social media.",
    link: {
      href: "https://www.watchlist-internet.at/news/phishing-falle-finanzonline-krypto/",
      label: "Watchlist Internet warning (German)",
    },
  },
  {
    question: "Do DAC9 and DAC10 mean more crypto surveillance?",
    answer:
      "Not automatically. DAC9 concerns minimum taxation of large corporate groups, not individual crypto users. The recast proposed in June 2026, often called DAC10, is not yet law and retains the existing crypto reporting fields.",
  },
]
---

<Layout
  sections={[
    { id: "ueberblick", label: "Overview" },
    { id: "gemeldet", label: "The report" },
    { id: "speicherdauer", label: "Retention" },
    { id: "ablauf", label: "Timeline" },
    { id: "risiko", label: "Risk" },
    { id: "faq", label: "Questions" },
    { id: "begriffe", label: "Terms" },
    { id: "quellen", label: "Sources" },
  ]}
>
  <MetaPage slot="head" />

  <article class="campaign dossier">
    <header class="hero">
      <div class="hero-text">
        <h1>What DAC8 requires. <span>And what it means for you.</span></h1>
        <p class="lead">
          Crypto-asset reporting in Austria: who is affected, what is reported
          and who keeps the data for how long.
        </p>
      </div>
    </header>

    <section
      id="ueberblick"
      class="overview"
      aria-labelledby="ueberblick-heading"
    >
      <h2 id="ueberblick-heading" class="visually-hidden">At a glance</h2>
      <ol>
        {overview.map((point) => (
          <li>
            <strong>{point.title}</strong>
            <p>{point.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="gemeldet" class="band" aria-labelledby="gemeldet-heading">
      <div class="art-split report-head">
        <div>
          <h2 id="gemeldet-heading">
            What goes to the tax office.
            <span>What stays with the provider.</span>
          </h2>
          <p class="section-intro">
            The provider reports every year, starting with 2026. It keeps the
            details, most of them already under anti-money-laundering rules.
          </p>
        </div>
        <Artwork
          id="reportAssets"
          language="en"
          zoom
          caption="Specimen of an annual report."
        />
      </div>
      <div class="compare">
        <div class="reported">
          <h3>Goes to the tax office</h3>
          <ul>
            <li>Name, postal address and date of birth</li>
            <li>Tax residence and tax identification number</li>
            <li>
              Annual totals per crypto-asset for purchases, sales, exchanges and
              transfers
            </li>
            <li>
              Transfers to wallets with no known provider, usually including
              your own:
              <strong>as a total, without wallet addresses</strong>
            </li>
            <li>
              Activities that often have no tax consequences, such as
              crypto-to-crypto exchanges
            </li>
          </ul>
        </div>
        <div class="absent">
          <h3>Stays with the provider</h3>
          <ul>
            <li>Your ID and the records of your identification</li>
            <li>Wallet addresses, including those of your own wallet</li>
            <li>
              Individual transactions with time and amount, and for transfers,
              the sender and recipient
            </li>
            <li>Your balance</li>
          </ul>
        </div>
      </div>
      <details class="legal-detail">
        <summary>What the law requires in detail</summary>
        <div>
          <p>
            Under Section 18 Krypto-MPfG, the provider reports for each
            crypto-asset and activity category the euro value, the units and,
            for most categories, the number of transactions, separated into
            purchases, sales, exchanges and transfers. Transfers to wallet
            addresses it does not know to belong to a provider or financial
            institution appear as a total, without the wallet addresses
            themselves.
          </p>
          <p>
            Providers with Austrian reporting obligations must prepare the
            reporting data for all customers, even those who are not ultimately
            reported (Section 20 Krypto-MPfG).
          </p>
          <p>
            Your ID, wallet addresses and transaction records must already be
            kept under Austria’s Financial Markets Anti-Money Laundering Act
            (Section 21 FM-GwG). The EU transfer of funds regulation requires
            details of the sender and recipient of every crypto transfer, even
            when you transfer to your own wallet. For DAC8, the provider adds
            your tax identification number and tax residence to these records.
          </p>
        </div>
      </details>
    </section>

    <section id="speicherdauer" aria-labelledby="speicherdauer-heading">
      <h2 id="speicherdauer-heading">Who keeps your data, and for how long</h2>
      <p class="section-intro">
        Every year adds another report, and the longest period only starts when
        you close your account.
      </p>
      <div class="art-split">
        <table class="retention">
          <thead>
            <tr>
              <th scope="col">Who</th>
              <th scope="col">What</th>
              <th scope="col">How long</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Your provider</th>
              <td data-label="What">
                Your ID, wallet addresses and individual transactions
              </td>
              <td data-label="How long">
                currently up to
                <strong>ten years after the customer relationship ends</strong>
              </td>
            </tr>
            <tr>
              <th scope="row">Your provider</th>
              <td data-label="What">Each annual report</td>
              <td data-label="How long">
                <strong>ten years</strong>
                after the reporting year, then it is deleted
              </td>
            </tr>
            <tr>
              <th scope="row">
                Tax authority of another EU country, such as Germany
              </th>
              <td data-label="What">
                The annual report, if you are tax-resident there
              </td>
              <td data-label="How long">
                <strong>at least five years</strong>; the directive sets no
                maximum
              </td>
            </tr>
          </tbody>
        </table>
        <Artwork
          id="yearsOnFile"
          language="en"
          caption="If you remain a customer, from 2036 ten annual reports will always be on file."
        />
      </div>
    </section>

    <section id="ablauf" class="band" aria-labelledby="ablauf-heading">
      <h2 id="ablauf-heading">How the reporting works</h2>
      <p class="section-intro">
        DAC8 is an EU directive extending the automatic exchange of tax
        information between EU countries to crypto-assets. Austria implements it
        through the Crypto-Asset Reporting Obligations Act (Krypto-MPfG), which
        has applied since 1 January 2026.
      </p>
      <ol class="flow" aria-label="How the first report travels">
        <li>
          <strong>2026</strong>
          <span>
            Your provider records the first reporting year and prepares the
            reporting data for all customers.
          </span>
        </li>
        <li>
          <strong>By 31 July 2027</strong>
          <span>It reports 2026 to the Austrian tax office.</span>
        </li>
        <li>
          <strong>By 30 September 2027</strong>
          <span>
            If you live in Germany or another EU country, Austria passes the
            report on to it.
          </span>
        </li>
        <li>
          <strong>Every year</strong>
          <span>The same happens again for each following year.</span>
        </li>
      </ol>
      <a class="text-link" href="/en/history/">How we got to DAC8</a>
    </section>

    <div class="pair">
      <section id="risiko" aria-labelledby="risiko-heading">
        <h2 id="risiko-heading">Why this data is a risk</h2>
        <p class="prose">
          Bitcoin works like cash: whoever holds the keys can move it. So nobody
          should know who holds how much. Yet providers, tax services and
          authorities have already lost such data, in the documented cases
          affecting
          <strong>about {roundPeople(peopleAffected, "en")} people</strong>
          in total. Stolen data shows criminals where there is something to
          take. The cases do not show that DAC8 caused them.
        </p>
        <a class="text-link" href="/en/data-leaks/"
          >The documented data leaks</a
        >
      </section>

      <section id="rechtsweg" aria-labelledby="rechtsweg-heading">
        <h2 id="rechtsweg-heading">What we are doing about it</h2>
        <p class="prose">{campaignStatus.en.text}</p>
        <a class="text-link" href="/en/proceedings/">Where the case stands</a>
      </section>
    </div>

    <div class="reference">
      <section id="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Questions and answers</h2>
        <div class="disclosure-list">
          {faqs.map((faq) => (
            <Disclosure name="faq">
              <Fragment slot="summary">{faq.question}</Fragment>
              <p>
                {faq.answer}
                {faq.link && <a href={faq.link.href}>{faq.link.label}</a>}
              </p>
            </Disclosure>
          ))}
        </div>
      </section>

      <Glossary language="en" />

      <section id="quellen" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sources</h2>
        <div class="sources">
          <p class="sources-intro">
            The dossier rests on legislation, EU law, court rulings and reports.
            Research last updated: {researchDate}. Sources on the development
            from 1977 to the recast are in the
            <a href="/en/history/">history of the DAC</a>.
          </p>
          <details class="bibliography">
            <summary>
              <span class="show">Show all {sourceCount} sources</span>
              <span class="hide">Hide sources</span>
            </summary>
            <div class="bibliography-groups">
              {sources.map((group) => (
                <div>
                  <h3>{group.title}</h3>
                  <ul>
                    {group.sources.map((source) => (
                      <li>
                        <a href={source.href}>{source.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </div>
      </section>
    </div>
  </article>
</Layout>

<script is:inline>
  // Forward links to sections that moved: see src/pages/dossier.astro.
  ;(() => {
    const moved = {
      "#problem": "/en/arguments/#sicherheit",
      "#verknuepfung": "/en/arguments/#verknuepfung",
      "#zahlungsprofile": "/en/arguments/#zahlungsprofile",
      "#ausblick": "/en/arguments/#ausbau",
      "#forderungen": "/en/arguments/#forderungen",
      "#faelle": "/en/data-leaks/",
      "#angriffe": "/en/data-leaks/#angriffe",
      "#was-ist-dac8": "#ablauf",
    }
    const forward = () => {
      const target = moved[location.hash]
      if (target) location.replace(target)
    }
    forward()
    addEventListener("hashchange", forward)
  })()
</script>
