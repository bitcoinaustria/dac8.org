---
import AffectedCheck from "@/components/AffectedCheck.astro"
import AttackSummary from "@/components/AttackSummary.astro"
import Artwork from "@/components/Artwork.astro"
import Layout from "@/layouts/Layout.astro"
import LegalRoute from "@/components/LegalRoute.astro"
import MetaPage from "@/components/MetaPage.astro"
import { campaignStatus } from "@/data/campaign"
import { sourceGroups } from "@/data/sources"
const researchDate = "30 September 2026"
const sources = sourceGroups.map((group) => ({
  title: group.titleEn,
  sources: group.sources.map((source) => ({
    href: source.href,
    label: source.labelEn,
  })),
}))
const concerns = [
  {
    title: "All customers, no suspicion.",
    text: "Providers must prepare reporting data for all customers before it is clear who will be reported at all. We reject this stockpiling of data.",
  },
  {
    title: "A file with no end date.",
    text: "Every year adds another report, and the provider keeps each one for ten years, corresponding bank-account data only five. If you remain a customer, from 2036 ten annual reports will always be on file, next to the anti-money-laundering records from your entire customer relationship.",
  },
  {
    title: "Sortable by wealth.",
    text: "Total value and number of purchases give a rough estimate of how much money someone moves in crypto. Anyone who gets hold of the data can use it to single out people who appear wealthy, even when the estimate is wrong.",
  },
  {
    title: "The provider becomes a honeypot.",
    text: "The more data sits in one place, and the longer it stays there, the more an attack pays off. Under anti-money-laundering rules the provider already holds your ID, wallet addresses and transactions, and DAC8 adds your tax number and annual totals. A provider breach ties your name to your wallet addresses. Whoever has that link keeps it and can use it to trace further payments.",
  },
  {
    title: "The purpose keeps expanding.",
    text: "Under the directive, the data may also be used for customs, against money laundering and for EU sanctions. Once collected, data finds new purposes. We call for a clear limit on each one.",
  },
  {
    title: "Errors travel too.",
    text: "An incorrect tax residence, valuation or reading of a transfer can be passed to other countries. The more bodies involved, the harder the correction.",
  },
]
// Documented cases in which lost or misused data made the harm possible.
// Cases without that link do not belong here.
const leaks = [
  {
    title: "Ledger, 2020: the addresses of 272,000 wallet buyers.",
    text: "Names, postal addresses and phone numbers leaked from the hardware wallet maker’s online shop. Phishing emails, text messages and letters to home addresses followed, asking for the recovery phrase. In a University of Innsbruck survey, 93 of 104 affected customers reported scam attempts and 33 reported extortion threats.",
    sources: [
      {
        label: "Ledger",
        href: "https://www.ledger.com/message-ledgers-ceo-data-leak",
      },
      {
        label: "Abramova and Böhme",
        href: "https://www.usenix.org/system/files/usenixsecurity23-abramova.pdf",
      },
    ],
  },
  {
