---
import MetaPage from "@/components/MetaPage.astro"
import CopyButton from "@/components/CopyButton.astro"
import Layout from "@/layouts/Layout.astro"

const btcpay =
  "https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"

const bankDetails = [
  { label: "Recipient", value: "Bitcoin Austria" },
  {
    label: "IBAN",
    value: "AT94 2011 1857 7690 6800",
    copy: "AT942011185776906800",
  },
  { label: "BIC", value: "GIBAATWWXXX" },
  { label: "Payment reference", value: "DAC8" },
]
---

<Layout
  sections={[
    { id: "wege", label: "Bitcoin or euros" },
    { id: "verwendung", label: "Use of donations" },
  ]}
>
  <MetaPage
    slot="head"
    title="Donate"
    description="Support the legal challenge to indiscriminate financial surveillance. Donate in bitcoin through Bitcoin Austria’s BTCPay server or in euros by bank transfer."
  />

  <article class="campaign">
    <header class="hero">
      <h1>Support <span>the legal challenge.</span></h1>
      <p class="lead">
        Legal proceedings cost money. Your donation goes directly to Bitcoin
        Austria, the association behind dac8.org.
      </p>
      <nav class="hero-actions" aria-label="Choose how to donate">
        <a class="button primary" href={btcpay} target="_blank" rel="noopener"
          >Donate bitcoin</a
        >
        <a class="button" href="#euro">Bank transfer</a>
      </nav>
    </header>

    <section id="wege" aria-labelledby="wege-heading">
      <h2 id="wege-heading">Bitcoin or euros</h2>
      <div class="donation-options">
        <article
          id="bitcoin"
          class="donation-method"
          data-copy-scope
          aria-labelledby="bitcoin-heading"
        >
          <header class="donation-heading">
            <h3 id="bitcoin-heading">Bitcoin</h3>
            <p>Lightning or on-chain</p>
          </header>
          <div class="bitcoin-payment">
            <p class="payment-description">Choose any amount.</p>
            <a
              class="button primary donation-action"
              href={btcpay}
              target="_blank"
              rel="noopener"
            >
              Donate bitcoin
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M14 4h6v6M20 4 10 14M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"
                />
              </svg>
            </a>
            <p class="payment-note">No name or email address required.</p>
          </div>
          <div class="payment-link">
            <div>
              <p class="detail-label">Donation link</p>
              <span>pay.bitcoin-austria.at</span>
            </div>
            <CopyButton value={btcpay} label="donation link" />
          </div>
          <p
            class="payment-status"
            data-copy-status
            role="status"
            aria-atomic="true"
          ></p>
        </article>

        <article
          id="euro"
          class="donation-method"
          data-copy-scope
          aria-labelledby="euro-heading"
        >
          <header class="donation-heading">
            <h3 id="euro-heading">Bank transfer</h3>
            <p>In euros</p>
          </header>
          <dl class="bank-details">
            {bankDetails.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>
                  <span>{detail.value}</span>
                  <CopyButton value={detail.copy ?? detail.value} label={detail.label} />
                </dd>
              </div>
            ))}
          </dl>
          <p
            class="payment-status"
            data-copy-status
            role="status"
            aria-atomic="true"
          ></p>
        </article>
      </div>
    </section>

    <section id="verwendung" aria-labelledby="verwendung-heading">
      <h2 id="verwendung-heading">Funding the case</h2>
      <p class="section-intro">
        Your donation primarily funds the case against indiscriminate collection
        of our financial data.
      </p>
      <p class="prose">
        Questions:
        <a href="mailto:kontakt@dac8.org">kontakt@dac8.org</a>.
      </p>
    </section>
  </article>
</Layout>
