---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const facts = [
  {
    number: "01",
    title: "Erfasst wird vorsorglich",
    text: "Meldende Anbieter müssen die meldepflichtigen Informationen für alle Kund:innen, alle Transaktionen und alle Kryptowerte ermitteln, erfassen, speichern und verarbeiten. Ob eine Person am Ende überhaupt meldepflichtig ist, spielt dafür keine Rolle. Es genügt, Kundin oder Kunde eines Anbieters mit Österreich-Bezug zu sein.",
  },
  {
    number: "02",
    title: "Gemeldet wird systematisch",
    text: "Für meldepflichtige Personen werden Identität, Steueransässigkeit sowie je Kryptowert aggregierte Transaktionskategorien, Beträge, Einheiten, Transaktionszahlen und Übertragungen jährlich an das Finanzamt gemeldet und automatisiert mit den zuständigen Behörden teilnehmender Staaten ausgetauscht.",
  },
  {
    number: "03",
    title: "Die Blockchain macht die Folgen dauerhaft",
    text: "Ein Steuerdatensatz veraltet. Eine Blockchain nicht. Wer eine Adresse einmal einem Namen zuordnet, kann alles nachlesen, was davor und danach über diese Adresse gelaufen ist, auch in zwanzig Jahren.",
  },
]

const actions = [
  {
    title: "Beschwerde bei der Datenschutzbehörde",
    text: "Ein Generator erstellt dir eine fertige Beschwerde gegen die Verarbeitung deiner Daten. Läuft im Browser, deine Angaben bleiben auf deinem Gerät.",
    label: "In Arbeit",
    href: null,
  },
  {
    title: "Deine Abgeordneten anschreiben",
    text: "Ein zweiter Generator schreibt dir einen Brief an deine Vertretung im Nationalrat und im Europäischen Parlament. Auch das passiert lokal bei dir.",
    label: "In Arbeit",
    href: null,
  },
  {
    title: "Das Verfahren finanzieren",
    text: "Anwaltspflicht, Eingabengebühr und Gutachten zahlt jemand. Spenden an Bitcoin Austria tragen die Initiative, ohne dass du dich irgendwo eintragen musst.",
    label: "Spenden",
    href: "https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos",
  },
]
---

<Layout>
  <MetaPage
    slot="head"
    title="DAC8: Krypto-Meldepflicht vor den VfGH bringen"
    description="Bitcoin Austria bereitet einen Individualantrag gegen das österreichische Krypto-Meldepflichtgesetz vor. Mitmachen ohne Anmeldung und ohne Daten."
  />

  <article class="campaign">
    <header class="hero">
      <p class="eyebrow">Eine Initiative von Bitcoin Austria</p>
      <h1>
        Wir wollen die <span>Krypto-Massenüberwachung</span> vor den VfGH
        bringen.
      </h1>
      <p class="intro">
        Das österreichische
        <a
          href="https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=20013064"
          >Krypto-Meldepflichtgesetz</a
        >
        macht aus legitimen Transaktionen einen grenzüberschreitenden
        Datenbestand. Wir halten diese anlasslose Erfassung für
        unverhältnismäßig und bereiten einen Individualantrag beim
        Verfassungsgerichtshof vor. Sind die entscheidenden Fragen europäisch,
        gehören sie vor den EuGH.
      </p>
      <p class="position">
        Der Staat darf Steuern einheben und durchsetzen. Er muss dafür nicht das
        Vermögen aller sichtbar machen.
      </p>
      <nav class="button-row" aria-label="Initiative unterstützen">
        <a class="button primary" href="/mitmachen/">So kannst du mitmachen</a>
        <a
          class="button"
          href="https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"
          >Jetzt spenden</a
        >
        <a class="text-link" href="/unternehmen/">Als Unternehmen helfen →</a>
      </nav>
    </header>

    <section aria-labelledby="kurz-heading">
      <p class="eyebrow">DAC8 in einer Minute</p>
      <h2 id="kurz-heading">
        Erst alle erfassen. Dann sehen, wen man braucht.
      </h2>
      <p class="section-intro">
        Österreich hat DAC8 mit dem Krypto-Meldepflichtgesetz umgesetzt. Seit 1.
        Jänner 2026 werden meldende Anbieter zu Erfassungs-, Sorgfalts- und
        Meldepflichten verpflichtet. Die erste Meldung für 2026 folgt 2027.
      </p>
      <ol class="numbered-grid">
        {facts.map((fact) => (
          <li>
            <span>{fact.number}</span>
            <h3>{fact.title}</h3>
            <p>{fact.text}</p>
          </li>
        ))}
      </ol>
      <a class="arrow-link" href="/argumente/">Die Argumente im Detail →</a>
    </section>

    <section class="split-section" aria-labelledby="antrag-heading">
      <div>
        <p class="eyebrow">Der österreichische Rechtsweg</p>
        <h2 id="antrag-heading">Den Antrag bringen wir ein.</h2>
      </div>
      <div class="stack">
        <p>
          Wir bereiten einen Individualantrag gegen Bestimmungen des
          österreichischen Krypto-Meldepflichtgesetzes vor. Im Zentrum stehen
          Grundrechte, Verhältnismäßigkeit und die Frage, ob gezielte
          Ermittlungsinstrumente mildere Mittel wären.
        </p>
        <p>
          Ein Individualantrag ist keine offene Sammelklage. Jede
          antragstellende Person muss unmittelbar und aktuell betroffen sein und
          darf keinen anderen zumutbaren Rechtsweg haben. Diesen Teil übernehmen
          wir samt anwaltlicher Vertretung und Kosten.
        </p>
        <p>
          Wir schöpfen dabei jedes rechtsstaatliche Mittel aus, das offensteht,
          bis hinauf zum Europäischen Gerichtshof. Von dir brauchen wir dafür
          nichts: keine Anmeldung, keine Unterschrift, keine Daten.
        </p>
        <a class="button primary" href="/individualantrag/"
          >Wie weit wir gehen</a
        >
      </div>
    </section>

    <section class="split-section" aria-labelledby="vorbild-heading">
      <div>
        <p class="eyebrow">Aus 2012 gelernt</p>
        <h2 id="vorbild-heading">
          Ein Überwachungsgesetz ist schon einmal gefallen.
        </h2>
      </div>
      <div class="stack">
        <p>
          2012 gingen 11.130 Menschen gemeinsam gegen die
          Vorratsdatenspeicherung vor, organisiert vom AKVorrat, dem heutigen
          <a href="https://epicenter.works">epicenter.works</a>. 2014 hob der
          Verfassungsgerichtshof die Vorratsdatenspeicherung auf.
        </p>
        <p>
          Getragen hat das Verfahren am Ende aber nicht die Zahl. Den Antrag der
          11.129 Mitantragsteller:innen wies der VfGH am 10. Juni 2014 zurück,
          inhaltlich entschieden hat er über die Anträge von zwei
          Einzelpersonen. Wir ziehen daraus einen Schluss: Unterschriften
          gewinnen kein Verfahren, und dafür Daten einzusammeln lohnt sich
          nicht.
        </p>
        <a
          class="arrow-link"
          href="https://www.ris.bka.gv.at/Dokumente/Vfgh/JFT_20140627_12G00047_00/JFT_20140627_12G00047_00.html"
          >VfGH 27.6.2014, G 47/2012 ua nachlesen →</a
        >
      </div>
    </section>

    <section class="split-section" aria-labelledby="credit-heading">
      <div>
        <p class="eyebrow">Credit, wo Credit gebührt</p>
        <h2 id="credit-heading">
          Bull Bitcoin hat den Stein ins Rollen gebracht.
        </h2>
      </div>
      <div class="stack">
        <p>
          Mit DAC8.com und ihrem Verfahren in Frankreich hat Bull Bitcoin den
          Widerstand gegen die anlasslose Krypto-Datenerfassung öffentlich und
          juristisch angestoßen. Dafür gebührt ihnen klarer Credit.
        </p>
        <p>
          Bitcoin Austria trägt diesen Impuls nach Österreich. Die Rechtswege
          sind national, dieselbe Klage ist nicht überall möglich. Aber je mehr
          Mitgliedstaaten dieselbe Frage stellen, desto schwerer lässt sie sich
          aussitzen. Wir teilen dafür Quellen und Argumentation mit
          Organisationen, die in ihrem Land aktiv werden wollen.
        </p>
        <a
          class="arrow-link"
          href="https://www.bullbitcoin.com/fr/blog/bull-bitcoin-saisit-le-conseil-detat-pour-faire-annuler-dac8-la-surveillance-de-masse-des-crypto-actifs"
          >Bull Bitcoins Initiative und Verfahren →</a
        >
        <a
          class="arrow-link"
          href="mailto:kontakt@dac8.org?subject=Internationale%20Kooperation%20gegen%20DAC8"
          >Als Partnerorganisation melden →</a
        >
      </div>
    </section>

    <section aria-labelledby="mitmachen-heading">
      <p class="eyebrow">Mitmachen</p>
      <h2 id="mitmachen-heading">
        Der Antrag ist ungewiss. <span>Deine Beteiligung nicht.</span>
      </h2>
      <p class="section-intro">
        Ob der VfGH unseren Antrag zulässt, entscheidet der VfGH. Was du dagegen
        tun kannst, hängt davon nicht ab und braucht keine Anmeldung bei uns.
      </p>
      <div class="action-grid">
        {actions.map((action) => (
          <article>
            <h3>{action.title}</h3>
            <p>{action.text}</p>
            {action.href ? (
              <a href={action.href}>{action.label} →</a>
            ) : (
              <p class="pending">{action.label}</p>
            )}
          </article>
        ))}
      </div>
      <a class="arrow-link" href="/mitmachen/">Alle Beteiligungswege →</a>
    </section>

    <aside class="company-callout">
      <p class="eyebrow">An das Ökosystem</p>
      <h2>Wer an Krypto verdient, sollte seine Nutzer nicht allein lassen.</h2>
      <p>
        Wir suchen keine gekauften Logos. Wir suchen Mitverantwortung:
        Finanzierung, juristische oder technische Expertise, Reichweite und eine
        klare öffentliche Position.
      </p>
      <a class="button light" href="/unternehmen/"
        >Als Unternehmen unterstützen</a
      >
    </aside>

    <section class="source-strip" aria-labelledby="sources-heading">
      <p class="eyebrow">Primärquellen</p>
      <h2 id="sources-heading">Prüf unsere Aussagen selbst.</h2>
      <ul class="link-list">
        <li>
          <a
            href="https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=20013064"
            >Österreichisches Krypto-Meldepflichtgesetz</a
          >
        </li>
        <li>
          <a
            href="https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32023L2226"
            >Richtlinie (EU) 2023/2226 – DAC8</a
          >
        </li>
        <li>
          <a
            href="https://www.vfgh.gv.at/downloads/Formular-Individualantrag-Empfehlungen_final.pdf"
            >VfGH-Empfehlungen zum Individualantrag</a
          >
        </li>
      </ul>
    </section>

    <aside class="closing">
      <p class="eyebrow">Jetzt zählt Beteiligung</p>
      <h2>Grundrechte verteidigen sich nicht von selbst.</h2>
      <div class="button-row">
        <a class="button light" href="/mitmachen/">Mitmachen</a>
        <a
          class="button outline-light"
          href="https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"
          >Spenden</a
        >
      </div>
    </aside>
  </article>
</Layout>
