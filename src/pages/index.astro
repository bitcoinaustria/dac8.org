---
import ArgumentPoints from "@/components/ArgumentPoints.astro"
import Artwork from "@/components/Artwork.astro"
import CampaignPartners from "@/components/CampaignPartners.astro"
import CampaignStatus from "@/components/CampaignStatus.astro"
import LeakMatrix from "@/components/LeakMatrix.astro"
import LegalRoute from "@/components/LegalRoute.astro"
import MetaPage from "@/components/MetaPage.astro"
import Tale from "@/components/Tale.astro"
import Layout from "@/layouts/Layout.astro"
import { homeObjections, points } from "@/data/arguments"
import { campaignStatus } from "@/data/campaign"

const objections = homeObjections.map((id) => points.de[id])
---

<Layout>
  <MetaPage slot="head" />

  <article class="campaign landing">
    <header class="hero">
      <div class="hero-text">
        <CampaignStatus language="de" />
        <h1>
          DAC8 erfasst jeden Krypto-Kunden.
          <span>Wir gehen dagegen vor.</span>
        </h1>
        <p class="lead">
          Seit 2026 bereiten Börsen und Broker in Österreich jedes Jahr für das
          Finanzamt auf, was du kaufst, verkaufst, tauschst und überträgst, auch
          auf deine eigene Wallet. Für alle Kunden, ohne Verdacht.
        </p>
        <nav class="hero-actions" aria-label="Direkteinstieg">
          <a class="button primary" href="/mitmachen/#spenden"
            >Prozess unterstützen</a
          >
          <a class="button" href="/deine-akte/">Was DAC8 über dich meldet</a>
        </nav>
      </div>
      <Artwork
        id="collectionReview"
        language="de"
        size="hero"
        priority
        caption="Unsere geplante Beschwerde setzt an der Verarbeitung bei einem Anbieter an. Sie soll klären, ob die gesetzlichen Vorgaben mit den Grundrechten vereinbar sind."
      />
    </header>

    <section class="figures" aria-label="DAC8 in Österreich">
      <dl class="keyfigures">
        <div>
          <dt>
            <strong>Kunden</strong>
            werden erfasst, auch jene, die am Ende nicht gemeldet werden.
          </dt>
          <dd>Alle</dd>
        </div>
        <div>
          <dt>
            <strong>Aufbewahrung</strong>
            jeder Jahresmeldung beim Anbieter.
          </dt>
          <dd>10 <small>Jahre</small></dd>
        </div>
        <div>
          <dt>
            <strong>Erste Meldung</strong>
            ans Finanzamt, für das Jahr 2026.
          </dt>
          <dd><time datetime="2027-07-31">31. Juli 2027</time></dd>
        </div>
      </dl>
    </section>

    <section id="problem" aria-labelledby="problem-heading">
      <h2 id="problem-heading">Was mit deinen Daten passiert</h2>
      <Tale
        language="de"
        steps={[
          {
            art: "accountToRecord",
            chapter: "Was der Anbieter sammelt",
            title: "Dein Konto wird zur Akte.",
            text: "Ausweis, Transaktionen und Angaben zu deinen Wallet-Adressen hält dein Anbieter nach den Geldwäschevorschriften fest. Für DAC8 kommen Steuernummer, Steuerwohnsitz und deine Jahreswerte dazu, bei allen Kunden und ohne Verdacht.",
          },
          {
            art: "yearsOnFile",
            title: "Jedes Jahr mehr über dich.",
            text: "Nach den Geldwäschevorschriften bewahrt dein Anbieter diese Unterlagen derzeit bis zehn Jahre nach Ende der Kundenbeziehung auf. Jede Jahresmeldung für DAC8 löscht er erst zehn Jahre nach dem Meldejahr.",
          },
          {
            art: "dataHack",
            chapter: "Was daraus werden kann",
            title: "Gespeichert. Gehackt. Verkauft.",
            text: "Je mehr an einer Stelle liegt und je länger, desto lohnender der Einbruch. Börsen, Identifizierungsdienste und Finanzverwaltungen haben solche Daten schon verloren.",
          },
          {
            art: "rankedPortrait",
            title: "Wer viel bewegt, steht oben auf der Liste.",
            text: "Betrüger fischen in Österreich mit gefälschten FinanzOnline-Nachrichten nach Krypto-Besitzern. Ein Leck beim Anbieter würde ihnen die Liste fertig liefern, sortiert nach Volumen.",
          },
          {
            art: "targetAtHome",
            title: "Dein Profil. Deine Wohnadresse. Ein Angriffsziel.",
            text: "Bitcoin funktioniert wie Bargeld: Wer die Schlüssel hat, kann ihn übertragen. Darum ist ein Leck gefährlich, wenn es Namen, Wohnadressen und mutmaßliche Bestände verbindet. In Frankreich zählte das Innenministerium 77 Entführungen, Freiheitsberaubungen und Erpressungen rund um Kryptowerte im ersten Halbjahr 2026.",
          },
        ]}
      />
      <a class="text-link" href="/deine-akte/">Was DAC8 über dich meldet</a>
    </section>

    <section id="handeln" class="peak" aria-labelledby="handeln-heading">
      <h2 id="handeln-heading">
        Wir gehen dagegen vor.
        <span>Mach mit.</span>
      </h2>
      <p class="section-intro">
        Bitcoin Austria bereitet eine Beschwerde vor. Wir wollen klären lassen,
        welche Finanzdaten der Staat wirklich braucht und wie lange sie
        gespeichert werden dürfen. So hilfst du am meisten:
      </p>
      <ul class="peak-actions">
        <li class="peak-lead">
          <Artwork id="financeTheCase" language="de" caption={false} />
          <h3>Den Prozess mittragen</h3>
          <p>Mit deiner Spende bezahlen wir das Verfahren.</p>
          <a class="button primary" href="/mitmachen/#spenden">Spenden</a>
        </li>
        <li>
          <h3>Schreib deinen Abgeordneten</h3>
          <p>
            Ein Brief an den Nationalrat, vorbereitet in deinem Browser, von dir
            abgeschickt.
          </p>
          <a class="button" href="/mitmachen/#abgeordnete">Brief schreiben</a>
        </li>
        <li>
          <h3>Teile die Kampagne</h3>
          <p>Grafiken für Beiträge und Stories, fertig zum Teilen.</p>
          <a class="button" href="/mitmachen/#teilen">Grafiken ansehen</a>
        </li>
      </ul>
    </section>

    <section id="faelle" aria-labelledby="faelle-heading">
      <h2 id="faelle-heading">Das ist schon passiert</h2>
      <p class="section-intro">
        Name, Ausweis, Wallet und Bestände: Jedes dieser Stücke ist schon in
        fremde Hände gelangt. Diese Fälle zeigen konkrete Gefahren. Sie belegen
        nicht, dass DAC8 sie verursacht hat.
      </p>
      <LeakMatrix language="de" />
      <a class="text-link" href="/dossier/#faelle">Weitere Fälle und Quellen</a>
    </section>

    <section id="einwaende" aria-labelledby="einwaende-heading">
      <h2 id="einwaende-heading" class="statement">
        Privatsphäre braucht keine Rechtfertigung.
        <span>Staatliche Eingriffe schon.</span>
      </h2>
      <ArgumentPoints points={objections} variant="objections" />
      <a class="text-link" href="/argumente/">Alle Argumente und Einwände</a>
    </section>

    <section id="weg" aria-labelledby="weg-heading">
      <h2 id="weg-heading">Was wir tun</h2>
      <div class="columns">
        <p class="section-intro">
          <strong
            >Wir sind überzeugt, dass die anlasslose Erfassung aller Kunden
            gegen Grundrechte verstößt.</strong
          >
        </p>
        <p class="prose">
          {campaignStatus.de.text}
        </p>
      </div>
      <LegalRoute language="de" />
      <a class="text-link" href="/verfahren/">Zum Stand des Verfahrens</a>
    </section>

    <section id="position" aria-labelledby="position-heading">
      <h2 id="position-heading">Wer dahintersteht</h2>
      <div class="about">
        <div>
          <p class="section-intro">
            dac8.org ist eine Initiative von Bitcoin Austria, dem gemeinnützigen
            Bitcoin-Verein aus Wien, gegründet 2011. Wir sind Bitcoiner und
            Cypherpunks. Für uns ist Privatsphäre eine Voraussetzung für eine
            freie Gesellschaft.
          </p>
          <p class="prose">
            Die Kampagne gilt allen, die DAC8 erfasst, egal welche Kryptowerte
            sie nutzen. Sie beginnt in Österreich, DAC8 gilt aber in der ganzen
            EU. Wer das Gesetz im eigenen Land angehen will, meldet sich bei
            uns:
            <a href="mailto:kontakt@dac8.org?subject=Zusammenarbeit%20zu%20DAC8"
              >kontakt@dac8.org</a
            >
          </p>
          <p class="prose">
            Bull Bitcoin ist vorangegangen: Im Februar 2026 hat das Unternehmen
            das französische DAC8-Dekret vor den Conseil d’État gebracht. Seine
            Kampagne auf <a href="https://dac8.com/de/">dac8.com</a> hat unsere
            angestoßen.
          </p>
        </div>
        <CampaignPartners />
      </div>
    </section>
  </article>
</Layout>
