---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const facts = [
  {
    number: "01",
    title: "Erfasst wird vorsorglich",
    text: "Meldende Anbieter müssen die meldepflichtigen Informationen für alle Kund:innen, alle Transaktionen und alle Kryptowerte ermitteln, erfassen, speichern und verarbeiten – unabhängig davon, ob jemand am Ende meldepflichtig ist.",
  },
  {
    number: "02",
    title: "Gemeldet wird systematisch",
    text: "Für meldepflichtige Personen werden Identität, Steueransässigkeit sowie je Kryptowert aggregierte Transaktionskategorien, Beträge, Einheiten, Transaktionszahlen und Übertragungen jährlich an das Finanzamt gemeldet und automatisiert mit den zuständigen Behörden teilnehmender Staaten ausgetauscht.",
  },
  {
    number: "03",
    title: "Bitcoin macht die Folgen dauerhaft",
    text: "Wer Identität und Vermögenssignale mit einer öffentlichen Blockchain verknüpft, schafft keinen gewöhnlichen Steuerdatensatz. Er schafft einen Einstieg in einen permanenten Finanzgraphen.",
  },
]

const actions = [
  {
    title: "Direkt betroffen?",
    text: "Wir suchen natürliche und juristische Personen, deren unmittelbare Betroffenheit anwaltlich geprüft werden kann.",
    label: "Eignung prüfen lassen",
    href: "/mitmachen/#betroffene",
  },
  {
    title: "Bitcoin Austria stärken",
    text: "Spenden stärken den Verein, der diese Initiative trägt. Für zweckgebundene größere Beiträge sprich bitte direkt mit uns.",
    label: "Jetzt spenden",
    href: "https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos",
  },
  {
    title: "Als Unternehmen helfen",
    text: "Das Ökosystem braucht Unternehmen, die Rechtskosten mittragen, Expertise beitragen und öffentlich Position beziehen.",
    label: "Verantwortung übernehmen",
    href: "/unternehmen/",
  },
]
---

<Layout>
  <MetaPage
    slot="head"
    title="Gemeinsam gegen die anlasslose Krypto-Datenerfassung"
    description="Bitcoin Austria bereitet einen Individualantrag gegen Bestimmungen des österreichischen Krypto-Meldepflichtgesetzes vor. Mitmachen, spenden und als Unternehmen unterstützen."
  />

  <article class="campaign">
    <header class="hero">
      <p class="eyebrow">Eine Initiative von Bitcoin Austria</p>
      <h1>Wir wollen die Krypto-Massenüberwachung vor den VfGH bringen.</h1>
      <p class="intro">
        Das österreichische Krypto-Meldepflichtgesetz macht aus legitimen
        Transaktionen einen grenzüberschreitenden Datenbestand. Wir halten diese
        anlasslose Erfassung für unverhältnismäßig und bereiten einen
        Individualantrag beim Verfassungsgerichtshof vor.
      </p>
      <p class="position">
        Bitcoin ist kein Freibrief für Steuerhinterziehung. Steuerpolitik ist
        aber auch kein Freibrief für flächendeckende Vermögensüberwachung.
      </p>
      <nav class="button-row" aria-label="Initiative unterstützen">
        <a class="button primary" href="/individualantrag/"
          >Individualantrag unterstützen</a
        >
        <a
          class="button"
          href="https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"
          >Jetzt spenden</a
        >
        <a class="text-link" href="/unternehmen/">Als Unternehmen helfen →</a>
      </nav>
    </header>

    <section aria-labelledby="kurz-heading">
      <p class="eyebrow">DAC8 in einer Minute</p>
      <h2 id="kurz-heading">
        Erst alle erfassen. Dann sehen, wen man braucht.
      </h2>
      <p class="section-intro">
        Österreich hat DAC8 mit dem Krypto-Meldepflichtgesetz umgesetzt. Seit 1.
        Jänner 2026 werden meldende Anbieter zu Erfassungs-, Sorgfalts- und
        Meldepflichten verpflichtet. Die erste Meldung für 2026 folgt 2027.
      </p>
      <ol class="numbered-grid">
        {facts.map((fact) => (
          <li>
            <span>{fact.number}</span>
            <h3>{fact.title}</h3>
            <p>{fact.text}</p>
          </li>
        ))}
      </ol>
      <a class="arrow-link" href="/argumente/">Die Argumente im Detail →</a>
    </section>

    <section class="split-section" aria-labelledby="antrag-heading">
      <div>
        <p class="eyebrow">Der österreichische Rechtsweg</p>
        <h2 id="antrag-heading">Kein Hashtag. Ein Verfahren.</h2>
      </div>
      <div class="stack">
        <p>
          Wir bereiten einen Individualantrag gegen Bestimmungen des
          österreichischen Krypto-Meldepflichtgesetzes vor. Im Zentrum stehen
          Grundrechte, Verhältnismäßigkeit und die Frage, ob gezielte
          Ermittlungsinstrumente mildere Mittel wären.
        </p>
        <p>
          Ein Individualantrag ist keine offene Sammelklage. Formelle
          Antragsteller:innen müssen unmittelbar und aktuell betroffen sein und
          dürfen keinen anderen zumutbaren Rechtsweg haben.
        </p>
        <a class="button primary" href="/individualantrag/"
          >So funktioniert der Antrag</a
        >
      </div>
    </section>

    <section class="split-section" aria-labelledby="credit-heading">
      <div>
        <p class="eyebrow">Credit, wo Credit gebührt</p>
        <h2 id="credit-heading">
          Bull Bitcoin hat den Stein ins Rollen gebracht.
        </h2>
      </div>
      <div class="stack">
        <p>
          Mit DAC8.com und ihrem Verfahren in Frankreich hat Bull Bitcoin den
          Widerstand gegen die anlasslose Krypto-Datenerfassung öffentlich und
          juristisch angestoßen. Dafür gebührt ihnen klarer Credit.
        </p>
        <p>
          Bitcoin Austria trägt diesen Impuls nach Österreich. Wenn aus einem
          Verfahren viele werden, dreht sich der Wind. Freedom.
        </p>
        <a
          class="arrow-link"
          href="https://www.bullbitcoin.com/fr/blog/bull-bitcoin-saisit-le-conseil-detat-pour-faire-annuler-dac8-la-surveillance-de-masse-des-crypto-actifs"
          >Bull Bitcoins Initiative und Verfahren →</a
        >
      </div>
    </section>

    <section aria-labelledby="mitmachen-heading">
      <p class="eyebrow">Mitmachen</p>
      <h2 id="mitmachen-heading">Offene Initiative. Präziser Rechtsweg.</h2>
      <p class="section-intro">
        Jede und jeder kann helfen. Antragsteller:in kann nur werden, wer die
        rechtlichen Voraussetzungen erfüllt.
      </p>
      <div class="action-grid">
        {actions.map((action) => (
          <article>
            <h3>{action.title}</h3>
            <p>{action.text}</p>
            <a href={action.href}>{action.label} →</a>
          </article>
        ))}
      </div>
    </section>

    <aside class="company-callout">
      <p class="eyebrow">An das Ökosystem</p>
      <h2>Wer an Bitcoin verdient, sollte seine Nutzer nicht allein lassen.</h2>
      <p>
        Wir suchen keine gekauften Logos. Wir suchen Mitverantwortung:
        Finanzierung, juristische oder technische Expertise, Reichweite und eine
        klare öffentliche Position.
      </p>
      <a class="button light" href="/unternehmen/"
        >Als Unternehmen unterstützen</a
      >
    </aside>

    <section class="split-section" aria-labelledby="international-heading">
      <div>
        <p class="eyebrow">International</p>
        <h2 id="international-heading">Die Grundprobleme sind europäisch.</h2>
      </div>
      <div class="stack">
        <p>
          Die Rechtswege sind national. Wir teilen Argumentation, Quellen und
          Erfahrungen mit Organisationen, die in ihrem Land aktiv werden wollen
          – ohne so zu tun, als wäre dieselbe Klage überall möglich.
        </p>
        <a
          class="arrow-link"
          href="mailto:kontakt@dac8.org?subject=Internationale%20Kooperation%20gegen%20DAC8"
          >Als Partnerorganisation melden →</a
        >
      </div>
    </section>

    <section class="source-strip" aria-labelledby="sources-heading">
      <p class="eyebrow">Primärquellen</p>
      <h2 id="sources-heading">Prüf unsere Aussagen selbst.</h2>
      <ul class="link-list">
        <li>
          <a
            href="https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=20013064"
            >Österreichisches Krypto-Meldepflichtgesetz</a
          >
        </li>
        <li>
          <a
            href="https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32023L2226"
            >Richtlinie (EU) 2023/2226 – DAC8</a
          >
        </li>
        <li>
          <a
            href="https://www.vfgh.gv.at/downloads/Formular-Individualantrag-Empfehlungen_final.pdf"
            >VfGH-Empfehlungen zum Individualantrag</a
          >
        </li>
      </ul>
    </section>

    <aside class="closing">
      <p class="eyebrow">Jetzt zählt Beteiligung</p>
      <h2>Grundrechte verteidigen sich nicht von selbst.</h2>
      <div class="button-row">
        <a class="button light" href="/mitmachen/">Mitmachen</a>
        <a
          class="button outline-light"
          href="https://pay.bitcoin-austria.at/apps/Nbue7dfjRGGcNXcaQ3AqDy1FARY/pos"
          >Spenden</a
        >
      </div>
    </aside>
  </article>
</Layout>
