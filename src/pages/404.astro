---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <MetaPage slot="head" title="Seite nicht gefunden" noindex />
  <article class="campaign">
    <header class="hero">
      <h1>Diese Seite <span>gibt es nicht.</span></h1>
      <p class="lead">
        Vielleicht ist der Link veraltet. Die wichtigsten Inhalte sind von hier
        aus einen Klick entfernt.
      </p>
      <nav class="hero-actions" aria-label="Weiter">
        <a class="button primary" href="/">Zur Startseite</a>
        <a class="button" href="/dossier/">Das Dossier zu DAC8</a>
        <a class="button" href="/mitmachen/">Mitmachen</a>
      </nav>
    </header>
  </article>
</Layout>
