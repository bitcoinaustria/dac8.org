---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const researchDate = "16. September 2026"

const concerns = [
  {
    title: "Alle, nicht nur Verdächtige.",
    text: "Der Anbieter muss die Meldedaten für alle Kundinnen und Kunden aufbereiten, bevor überhaupt feststeht, wer gemeldet wird. Ein Anlass oder Verdacht ist nicht nötig. Genau diese Vorratslogik lehnen wir ab.",
  },
  {
    title: "Ein Profil über Jahre.",
    text: "Anders als bei Bankkonten werden je Kryptowert auch Stückzahlen und die Zahl der Vorgänge gemeldet. Jahr für Jahr ergibt das ein Bild, wie aktiv jemand ist, auch wenn der aktuelle Bestand nicht dabei ist.",
  },
  {
    title: "Ein Datenleck ist nicht rückgängig zu machen.",
    text: "Die Meldung enthält keine Wallet-Adressen. Gelangen Identität und Jahreswerte aber in falsche Hände, lassen sie sich mit der öffentlichen Blockchain verknüpfen. Was dort einmal zugeordnet ist, bleibt zugeordnet.",
  },
  {
    title: "Der Zweck wächst mit.",
    text: "Ausgetauschte Daten dürfen laut Richtlinie nicht nur für Steuern, sondern auch für Zoll, Geldwäschebekämpfung und unter Bedingungen für Sanktionen genutzt werden. Jeder neue Zweck braucht eine eigene, klare Grenze.",
  },
  {
    title: "Fehler reisen mit.",
    text: "Ein falscher Steuerwohnsitz, eine falsche Bewertung oder ein missverstandener Transfer kann an andere Staaten weitergegeben werden. Je mehr Stellen beteiligt sind, desto schwerer wird die Korrektur.",
  },
  {
    title: "Zehn Jahre ohne Begründung.",
    text: "Bei Bankkonten löscht Österreich die gemeldeten Daten nach fünf Jahren; die Materialien nannten das damals datenschutzrechtlich angemessen. Für Krypto sind es zehn Jahre. Warum, steht in den Gesetzesmaterialien nicht.",
  },
]

const faqs = [
  {
    question: "Bin ich betroffen, wenn ich Bitcoin besitze?",
    answer:
      "Nur, wenn ein Krypto-Anbieter beteiligt ist, der in Österreich meldepflichtig ist, etwa eine Börse oder ein Broker mit Sitz in Österreich. Wer Bitcoin ausschließlich selbst verwahrt und keinen solchen Anbieter nutzt, wird durch DAC8 nicht gemeldet.",
  },
  {
    question: "Wird meine eigene Wallet-Adresse gemeldet?",
    answer:
      "Nein, Adressen sind nicht Teil der Meldung. Gemeldet wird aber die Summe aller Übertragungen an Adressen, die dem Anbieter nicht als Adresse eines anderen Anbieters bekannt sind. Darunter fällt in der Regel auch der Transfer auf deine eigene Wallet.",
  },
  {
    question:
      "Ich tausche Bitcoin gegen einen anderen Kryptowert. Wird das gemeldet?",
    answer:
      "Ja. Der Tausch wird mit Wert, Stückzahl und Anzahl auf beiden Seiten gemeldet, obwohl er in Österreich für Privatpersonen steuerlich meist kein Verkauf ist. Das ist einer der Punkte, an denen wir die Notwendigkeit einzelner Meldefelder prüfen lassen wollen.",
  },
  {
    question: "Ist DAC8 ein Vermögensregister?",
    answer:
      "Nein. Gemeldet werden Jahreswerte der Aktivität, kein aktueller Bestand und kein Gesamtvermögen. Die Sorge ist eine andere: Zusammen mit Kontenregister, Anbieteraufzeichnungen und Blockchain-Analyse kann daraus Schicht für Schicht eine sehr genaue Vermögenskarte werden.",
  },
  {
    question: "Werden Transaktionen vor 2026 nachgemeldet?",
    answer:
      "Nein. Der erste Meldezeitraum beginnt am 1. Jänner 2026. Eine rückwirkende Meldepflicht bräuchte ein neues Gesetz. Weder DAC9 noch der aktuelle Vorschlag für eine Neufassung der Richtlinie sehen das vor.",
  },
  {
    question: "Müssen Anbieter jede Transaktion zehn Jahre speichern?",
    answer:
      "Nicht wegen DAC8. Das Gesetz verlangt zehn Jahre für die gemeldeten Jahreswerte und für die Dokumentation der Melde- und Prüfschritte. Einzelne Transaktionsdaten heben Anbieter aus anderen Gründen auf, etwa nach Geldwäsche- oder MiCA-Regeln. Wir vermischen diese Pflichten bewusst nicht.",
  },
  {
    question: "Bedeuten DAC9 und DAC10 noch mehr Krypto-Überwachung?",
    answer:
      "Nicht automatisch. DAC9 betrifft die Mindestbesteuerung großer Unternehmensgruppen, nicht einzelne Krypto-Nutzer. Die im Juni 2026 vorgeschlagene Neufassung der Richtlinie, oft DAC10 genannt, ist noch kein geltendes Recht und führt die bisherigen Krypto-Felder fort. Wir schauen uns jeden Schritt einzeln an, statt auf die Nummer zu zeigen.",
  },
  {
    question: "Seid ihr gegen Steuern oder gegen Geldwäschebekämpfung?",
    answer:
      "Nein. Steuerpflichten gelten, und Finanzdaten können bei Ermittlungen helfen. Wir verlangen, dass Erfassung, Zugriff, Speicherdauer und Weiterverwendung nachweislich notwendig sind und dass Betroffene Fehler korrigieren können.",
  },
  {
    question: "Ist DAC8 rechtswidrig?",
    answer:
      "Das wissen wir nicht, und das behaupten wir auch nicht. Es gibt Rechtsprechung, die dem automatischen Austausch von Steuerdaten grundsätzlich zustimmt. Wir halten die österreichische Erfassung aller Kundinnen und Kunden trotzdem für ein ernstes Grundrechtsproblem und wollen es von Gerichten prüfen lassen.",
  },
  {
    question: "Was passiert mit meinen Daten auf dieser Website?",
    answer:
      "Die Generatoren laufen vollständig in deinem Browser. Eingaben werden weder an Bitcoin Austria übertragen noch gespeichert. Welche technischen Daten beim Hosting anfallen, steht in der Datenschutzerklärung.",
  },
]

const sourceGroups = [
  {
    title: "Österreichisches Gesetz",
    sources: [
      {
        label: "Krypto-Meldepflichtgesetz, BGBl. I Nr. 96/2025",
        href: "https://www.ris.bka.gv.at/Dokumente/BgblAuth/BGBLA_2025_I_96/BGBLA_2025_I_96.pdf",
      },
      {
        label: "§ 18 Krypto-MPfG – welche Daten gemeldet werden",
        href: "https://www.ris.bka.gv.at/NormDokument.wxe?Abfrage=Bundesnormen&Gesetzesnummer=20013064&Paragraf=18",
      },
      {
        label: "§ 20 Krypto-MPfG – Verarbeitung für alle Kunden, Löschung",
        href: "https://www.ris.bka.gv.at/Dokumente/Bundesnormen/NOR40273819/NOR40273819.pdf",
      },
      {
        label: "§ 39 Krypto-MPfG – Aufbewahrung der Dokumentation",
        href: "https://www.ris.bka.gv.at/NormDokument.wxe?Abfrage=Bundesnormen&Gesetzesnummer=20013064&Paragraf=39",
      },
      {
        label: "§ 5 GMSG – fünf Jahre bei Bankkonten",
        href: "https://www.ris.bka.gv.at/NormDokument.wxe?Abfrage=Bundesnormen&Gesetzesnummer=20009250&Paragraf=5",
      },
      {
        label: "§ 24 DSG – Beschwerde und Fristen",
        href: "https://www.ris.bka.gv.at/NormDokument.wxe?Abfrage=Bundesnormen&Anlage=&Artikel=2&Gesetzesnummer=10001597&Paragraf=24",
      },
    ],
  },
  {
    title: "EU-Recht",
    sources: [
      {
        label: "Richtlinie (EU) 2023/2226 (DAC8)",
        href: "https://eur-lex.europa.eu/legal-content/DE/ALL/?uri=CELEX:32023L2226",
      },
      {
        label: "Folgenabschätzung der EU-Kommission zu DAC8, SWD(2022) 401",
        href: "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=SWD:2022:401:FIN",
      },
      {
        label: "Richtlinie (EU) 2025/872 (DAC9)",
        href: "https://eur-lex.europa.eu/eli/dir/2025/872/oj/deu",
      },
      {
        label: "Kommissionsvorschlag COM(2026) 308 – Neufassung der Richtlinie",
        href: "https://eur-lex.europa.eu/legal-content/DE/ALL/?uri=CELEX:52026PC0308",
      },
      {
        label: "EU-Kommission – Überblick zum DAC-System",
        href: "https://taxation-customs.ec.europa.eu/taxation/tax-transparency-cooperation/administrative-co-operation-and-mutual-assistance/directive-administrative-cooperation-dac_en",
      },
      {
        label: "EU-Machbarkeitsstudie zu einem europäischen Vermögensregister",
        href: "https://op.europa.eu/en/publication-detail/-/publication/050b047e-3ff5-11ef-865a-01aa75ed71a1",
      },
    ],
  },
  {
    title: "Gerichte",
    sources: [
      {
        label:
          "VfGH G 178/2024 – warum der Weg über die Datenschutzbehörde führt",
        href: "https://www.ris.bka.gv.at/Dokumente/Vfgh/JFT_20260428_24G00178_00/JFT_20260428_24G00178_00.pdf",
      },
      {
        label: "VfGH G 47/2012 ua – Aufhebung der Vorratsdatenspeicherung",
        href: "https://www.ris.bka.gv.at/Dokumente/Vfgh/JFT_20140627_12G00047_00/JFT_20140627_12G00047_00.pdf",
      },
      {
        label: "EuGH C-293/12 und C-594/12 – Vorratsdatenspeicherung",
        href: "https://eur-lex.europa.eu/legal-content/DE/ALL/?uri=CELEX:62012CJ0293",
      },
    ],
  },
  {
    title: "Behörden und Zivilgesellschaft",
    sources: [
      {
        label: "Datenschutzbehörde – Informationen zur Beschwerde",
        href: "https://dsb.gv.at/eingabe-an-die-dsb/beschwerde",
      },
      {
        label: "epicenter.works – Geschichte der österreichischen Kampagne",
        href: "https://epicenter.works/thema/vorratsdatenspeicherung",
      },
    ],
  },
]
---

<Layout
  sections={[
    { id: "was-ist-dac8", label: "Was ist DAC8?" },
    { id: "gemeldet", label: "Was gemeldet wird" },
    { id: "problem", label: "Was daran problematisch ist" },
    { id: "ausblick", label: "Was noch kommen könnte" },
    { id: "forderungen", label: "Was wir fordern" },
    { id: "rechtsweg", label: "Wie wir vorgehen" },
    { id: "faq", label: "Häufige Fragen" },
    { id: "quellen", label: "Quellen" },
  ]}
>
  <MetaPage
    slot="head"
    title="Hintergrund zu DAC8"
    description="Was DAC8 und das österreichische Krypto-Meldepflichtgesetz verlangen, was gemeldet wird, was daran problematisch ist und wie wir dagegen vorgehen. Mit Primärquellen."
  />

  <article class="campaign dossier">
    <header class="hero">
      <h1>Was DAC8 verlangt. <span>Und was nicht.</span></h1>
      <p class="lead">
        Was das Gesetz vorschreibt, was in der Meldung steht, wo die Grenzen
        liegen und wie wir dagegen vorgehen. Ohne Übertreibung, mit Quellen zum
        Nachlesen.
      </p>
      <nav class="hero-actions" aria-label="Direkteinstieg">
        <a class="button primary" href="#gemeldet">Was gemeldet wird</a>
        <a class="button" href="#rechtsweg">Wie wir vorgehen</a>
      </nav>
      <dl class="glance" aria-label="Aktueller Stand">
        <dt>Gesetz in Kraft</dt>
        <dd>seit 1. Jänner 2026</dd>
        <dt>Erste Meldung</dt>
        <dd>für das Jahr 2026, spätestens am 31. Juli 2027</dd>
        <dt>Stand der Recherche</dt>
        <dd>{researchDate}</dd>
      </dl>
    </header>

    <section id="was-ist-dac8" aria-labelledby="was-heading">
      <h2 id="was-heading">Was ist DAC8?</h2>
      <p class="section-intro">
        DAC8 ist eine EU-Richtlinie. Sie erweitert den automatischen Austausch
        von Steuerdaten zwischen den EU-Staaten auf Kryptowerte. Österreich hat
        sie mit dem Krypto-Meldepflichtgesetz umgesetzt, das seit 1. Jänner 2026
        gilt.
      </p>
      <ol class="flow horizontal" aria-label="Der Weg der Daten">
        <li>
          <strong>Du</strong>
          <span
            >nutzt eine Börse oder einen Broker mit Meldepflicht in Österreich</span
          >
        </li>
        <li class="accent">
          <strong>Der Anbieter</strong>
          <span
            >bereitet Identität und Jahreswerte für alle Kundinnen und Kunden
            auf und meldet einmal im Jahr</span
          >
        </li>
        <li>
          <strong>Das Finanzamt</strong>
          <span>empfängt die Meldung, wertet sie aus, speichert sie</span>
        </li>
        <li>
          <strong>Andere EU-Staaten</strong>
          <span>erhalten die Daten, wenn du dort steuerlich ansässig bist</span>
        </li>
      </ol>
      <p class="callout">
        <strong>Der österreichische Zusatz:</strong>
        Bevor feststeht, wer überhaupt gemeldet wird, muss der Anbieter die
        Meldedaten für alle Kundinnen und Kunden, alle Transaktionen und alle
        Kryptowerte aufbereiten. Die Richtlinie verlangt das nicht.
        <small>§ 20 Abs. 1 Krypto-MPfG. Hier setzt unsere Kritik an.</small>
      </p>
    </section>

    <section id="gemeldet" aria-labelledby="gemeldet-heading">
      <h2 id="gemeldet-heading">Was gemeldet wird, und was nicht</h2>
      <p class="section-intro">
        Die Meldung ist kein Kontoauszug. Sie enthält Jahreswerte, keine
        einzelnen Transaktionen. Beides ist wichtig, um das Gesetz richtig
        einzuschätzen.
      </p>
      <div class="compare">
        <div>
          <h3>Das steht in der Meldung</h3>
          <ul>
            <li>Name, Anschrift, Steuerwohnsitz, Steuernummer, Geburtsdatum</li>
            <li>
              je Kryptowert und Vorgangsart drei Zahlen: Wert in Euro,
              Stückzahl, Anzahl der Vorgänge – getrennt nach Kauf, Verkauf,
              Tausch und Übertragung
            </li>
            <li>
              Wert und Stückzahl aller Übertragungen an Adressen, die keinem
              bekannten Anbieter gehören. Dazu zählt in der Regel deine eigene
              Wallet.
            </li>
            <li>
              auch Vorgänge, die steuerlich meist keine Rolle spielen, etwa der
              Tausch von Krypto gegen Krypto
            </li>
          </ul>
        </div>
        <div class="absent">
          <h3>Das steht nicht in der Meldung</h3>
          <ul>
            <li>Wallet-Adressen und Transaktionskennungen</li>
            <li>einzelne Transaktionen, Zeitpunkte oder Gegenparteien</li>
            <li>der aktuelle Bestand oder dein Gesamtvermögen</li>
            <li>Vorgänge vor dem 1. Jänner 2026</li>
          </ul>
        </div>
      </div>
      <ul class="facts">
        <li>
          <strong>Mehr als bei Bankkonten</strong>
          <p>
            Bei Bankkonten meldet der Staat Salden und Erträge. Bei Krypto
            kommen Stückzahlen und die Zahl der Vorgänge dazu. Jahr für Jahr
            ergibt das ein Bild davon, wie aktiv jemand ist.
          </p>
        </li>
        <li>
          <strong>Zehn Jahre statt fünf</strong>
          <p>
            Der Anbieter darf die gemeldeten Daten erst zehn Jahre nach dem
            Meldejahr löschen, für 2026 also Ende 2036. Für Bankkonten hat
            Österreich 2018 fünf Jahre festgelegt und das damals als
            datenschutzrechtlich angemessen bezeichnet. Den Unterschied
            begründen die Gesetzesmaterialien nicht.
          </p>
        </li>
        <li>
          <strong>Wann was passiert</strong>
          <p>
            Der erste Meldezeitraum ist das Jahr 2026. Der Anbieter meldet es
            bis 31. Juli 2027 ans Finanzamt, Österreich tauscht die Daten bis
            30. September 2027 mit anderen EU-Staaten aus.
          </p>
        </li>
        <li>
          <strong>Was der Anbieter zusätzlich hat</strong>
          <p>
            Aus Geldwäsche- und Kryptomarkt-Regeln führen Anbieter deutlich
            detailliertere Aufzeichnungen, darunter Adressen und Zeitstempel.
            Sie sind nicht Teil der Meldung, liegen aber beim selben Anbieter.
          </p>
        </li>
      </ul>
    </section>

    <section id="problem" aria-labelledby="problem-heading">
      <h2 id="problem-heading">Was daran problematisch ist</h2>
      <p class="section-intro">
        Ein einzelner Jahreswert ist noch kein Überwachungsstaat. Problematisch
        wird es durch die Kombination: alle Kundinnen und Kunden, viele Jahre,
        viele Empfänger, lange Speicherung.
      </p>
      <ul class="facts">
        {concerns.map((concern) => (
          <li>
            <strong>{concern.title}</strong>
            <p>{concern.text}</p>
          </li>
        ))}
      </ul>
      <p class="prose">
        Wir sind Bitcoiner und haben früh gelernt, was passiert, wenn
        Identitäten und Finanzdaten an einem Ort zusammenlaufen. Unser Maßstab
        gilt aber für alle: Der Staat soll die Daten bekommen, die er für einen
        klaren Zweck nachweislich braucht. Und Betroffene sollen Fehler
        korrigieren und unzulässige Nutzung stoppen können.
      </p>
    </section>

    <section id="ausblick" aria-labelledby="ausblick-heading">
      <h2 id="ausblick-heading">Was noch kommen könnte</h2>
      <p class="section-intro">
        Das DAC-System wird regelmäßig erweitert. Eine höhere Nummer heißt aber
        nicht automatisch mehr Krypto-Daten. Wir unterscheiden geltendes Recht,
        Vorschläge und politische Möglichkeiten.
      </p>
      <ul class="facts">
        <li>
          <span class="tag live">Gilt heute</span>
          <strong>DAC8</strong>
          <p>
            Gemeldet werden Identität und Jahreswerte ab 2026. Keine
            Wallet-Adressen, keine einzelnen Transaktionen.
          </p>
        </li>
        <li>
          <span class="tag">Gilt, betrifft Krypto nicht</span>
          <strong>DAC9</strong>
          <p>
            Die Richtlinie regelt die Mindestbesteuerung großer
            Unternehmensgruppen, nicht private Nutzerinnen und Nutzer.
          </p>
        </li>
        <li>
          <span class="tag">Vorschlag seit Juni 2026</span>
          <strong>„DAC10“</strong>
          <p>
            Die vorgeschlagene Neufassung führt die bisherigen Krypto-Felder
            fort. Sie verlangt weder Wallet-Adressen noch eine Nachmeldung von
            Vorgängen vor 2026.
          </p>
        </li>
        <li>
          <span class="tag">Bräuchte ein neues Gesetz</span>
          <strong>Adressen, Einzeltransaktionen, Rückwirkung</strong>
          <p>
            Nichts davon ist beschlossen. Ist die Infrastruktur einmal da, wird
            jede Erweiterung aber technisch leichter, und öffentliche Kontrolle
            wichtiger.
          </p>
        </li>
      </ul>
    </section>

    <section id="forderungen" aria-labelledby="forderungen-heading">
      <h2 id="forderungen-heading">Was wir fordern</h2>
      <p class="section-intro">
        Wer umfassende Finanzdaten verlangt, muss begründen, warum. Wir wollen
        keine Sonderregel für Bitcoin, sondern Mindeststandards für jede
        staatliche Sammlung von Finanzdaten.
      </p>
      <ul class="checklist">
        <li>
          <strong
            >Erst prüfen, wer meldepflichtig ist, dann Daten aufbereiten.</strong
          >
          Nicht umgekehrt.
        </li>
        <li>
          <strong>Jedes Meldefeld muss seinen Nutzen belegen.</strong>
          Stückzahlen, Anzahl der Vorgänge und Transferfelder gehen über das
          hinaus, was bei Bankkonten gemeldet wird. Welchen steuerlichen
          Mehrwert sie bringen, ist offen.
        </li>
        <li>
          <strong>Die eigene Wallet ist keine Zahlung an Dritte.</strong>
          Übertragungen auf selbst verwahrte Adressen sollen erkennbar getrennt
          behandelt werden.
        </li>
        <li>
          <strong>Speicherfristen begründen.</strong>
          Zehn Jahre statt der fünf bei Bankkonten brauchen eine Erklärung oder
          eine Korrektur.
        </li>
        <li>
          <strong>Zweck, Zugriff und Weitergabe eng begrenzen</strong>
          und lückenlos protokollieren.
        </li>
        <li>
          <strong>Auskunft, Korrektur und Löschung</strong>
          müssen über alle Empfänger hinweg praktisch funktionieren.
        </li>
        <li>
          <strong>Nutzen und Grundrechtsfolgen unabhängig evaluieren,</strong>
          regelmäßig und öffentlich.
        </li>
      </ul>
      <p class="prose">
        <strong>Gegenwehr wirkt.</strong>
        Die von AKVorrat, heute epicenter.works, organisierte Beschwerde gegen
        die Vorratsdatenspeicherung führte über den Verfassungsgerichtshof zum
        Europäischen Gerichtshof. 2014 fielen die EU-Richtlinie und die
        österreichischen Regeln. DAC8 ist ein anderer Fall mit offenem Ausgang.
        Aber er zeigt: Grundrechte zu verteidigen ist kein symbolischer Akt.
      </p>
    </section>

    <section id="rechtsweg" aria-labelledby="rechtsweg-heading">
      <h2 id="rechtsweg-heading">Wie wir vorgehen</h2>
      <p class="section-intro">
        Ein guter Fall beginnt nicht mit der lautesten Behauptung, sondern mit
        der richtigen Person, dem richtigen Anbieter und einem sauber belegten
        Sachverhalt. Der Weg führt über die Datenschutzbehörde.
      </p>
      <ol class="flow horizontal" aria-label="Der Rechtsweg">
        <li>
          <strong>Anbieter</strong>
          <span>verarbeitet deine Daten für DAC8; du holst Auskunft ein</span>
        </li>
        <li class="accent">
          <strong>Datenschutzbehörde</strong>
          <span>prüft deine Beschwerde gegen den Anbieter</span>
        </li>
        <li>
          <strong>Bundesverwaltungsgericht</strong>
          <span
            >entscheidet über die Beschwerde und kann Fragen an den EuGH richten</span
          >
        </li>
        <li>
          <strong>VfGH / EuGH</strong>
          <span>prüfen das österreichische Gesetz bzw. die EU-Richtlinie</span>
        </li>
      </ol>
      <div class="tracks">
        <section>
          <h3>Warum nicht direkt zum Verfassungsgerichtshof?</h3>
          <p>
            Der Verfassungsgerichtshof hat 2026 entschieden, dass Betroffene
            zuerst den zumutbaren Weg über die Datenschutzbehörde nehmen müssen.
            Ein direkter Antrag einer einzelnen Nutzerin oder eines Nutzers
            würde mit hoher Wahrscheinlichkeit daran scheitern. Der längere Weg
            ist deshalb der tragfähige.
          </p>
        </section>
        <section>
          <h3>Was ein Anbieter zusätzlich tun kann</h3>
          <p>
            Ein Anbieter mit Sitz in Österreich ist von den zusätzlichen
            österreichischen Pflichten direkt betroffen und kann unter anderen
            Voraussetzungen selbst zum Verfassungsgerichtshof gehen. Dafür
            müssen die österreichischen Zusatzpflichten sauber vom
            EU-Mindeststandard getrennt werden.
          </p>
        </section>
      </div>
      <ul class="facts">
        <li>
          <strong>Was eine Beschwerde braucht</strong>
          <p>
            Einen konkreten Anbieter, eine Verarbeitung, die jetzt schon
            stattfindet, etwa Selbstauskunft, Einstufung oder Speicherung, und
            Belege dafür. Dass 2027 eine Meldung kommen wird, reicht allein
            nicht.
          </p>
        </li>
        <li>
          <strong>Was eine Beschwerde nicht bewirkt</strong>
          <p>
            Sie stoppt die Verarbeitung nicht automatisch. Ob vor der ersten
            Meldung im Juli 2027 eine Entscheidung vorliegt, ist nicht
            gesichert. Und ob der EuGH befragt wird, entscheidet allein das
            Gericht.
          </p>
        </li>
      </ul>
      <aside class="note">
        <h3>Wo wir stehen</h3>
        Wir bereiten die anwaltliche Prüfung vor. Solange kein Mandat bestätigt
        ist, nennen wir keine Kanzlei und behaupten keinen Verfahrensstand.
        Diese Seite wird aktualisiert, sobald sich etwas ändert.
      </aside>
    </section>

    <section id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Häufige Fragen</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="quellen" class="sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Quellen</h2>
      <p class="section-intro">
        Alles, was hier steht, beruht auf Gesetzestexten, Gerichtsentscheidungen
        und offiziellen Dokumenten. Wo wir bewerten statt belegen, sagen wir
        das.
      </p>
      <div class="source-groups">
        {sourceGroups.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <ul>
              {group.sources.map((source) => (
                <li>
                  <a href={source.href}>{source.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="research-note">
        Stand der Recherche: {researchDate}. Keine Rechtsberatung. Fristen,
        Verfahrensstand und deine konkrete Betroffenheit musst du vor jedem
        Schritt selbst prüfen oder prüfen lassen.
      </p>
    </section>

    <aside class="closing">
      <h2>Grundrechte verteidigen sich nicht von selbst.</h2>
      <p>
        Bereite eine Beschwerde vor, schreib deinen Abgeordneten oder trag den
        Rechtsweg finanziell mit. Jede dieser Handlungen macht sichtbar, dass
        die Erfassung aller nicht einfach hingenommen wird.
      </p>
      <div class="closing-actions">
        <a class="button" href="/handeln/">Was du tun kannst</a>
        <a class="button" href="/spenden/">Spenden</a>
        <button class="button" type="button" data-share>Seite teilen</button>
      </div>
    </aside>
  </article>

  <script>
    import { initializeShareButtons } from "@/lib/share"

    initializeShareButtons()
  </script>
</Layout>
