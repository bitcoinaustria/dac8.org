---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const facts = [
  {
    title: "Alle Kunden werden vorsorglich erfasst",
    text: "Österreich verpflichtet meldepflichtige Krypto-Dienstleister, die relevanten Daten für alle Kunden, Transaktionen und Kryptowerte zu verarbeiten – unabhängig davon, ob eine Person am Ende tatsächlich meldepflichtig ist.",
  },
  {
    title: "Was jährlich gemeldet wird",
    text: "Für meldepflichtige Nutzer: Name, Anschrift, Steuerwohnsitz, Steuer-ID sowie Geburtsdatum und gegebenenfalls Geburtsort. Dazu kommen je Kryptowert und Kategorie aggregierte Werte, Einheiten und Transaktionszahlen.",
  },
  {
    title: "Was DAC8 nicht meldet",
    text: "Der Bericht enthält keine Wallet- oder DLT-Adressen, Transaktions-IDs, einzelnen Transaktionszeitpunkte, Gegenparteien oder rohe Transaktionshistorie. Bei Transfers an unbekannte externe Adressen werden Summen gemeldet, nicht die Adresse selbst. DAC8 meldet auch keinen aktuellen Kontostand und kein vollständiges Vermögen.",
  },
  {
    title: "Keine Meldung von Transaktionen vor 2026",
    text: "Der erste Meldezeitraum beginnt am 1. Jänner 2026. Vorherige Krypto-Transaktionen werden nach geltendem Recht nicht rückwirkend unter DAC8 gemeldet. Die erste Meldung für 2026 ist bis 31. Juli 2027 fällig; bestehende Kunden müssen aber für die Sorgfaltspflichten eingestuft werden.",
  },
  {
    title: "Was die zehn Jahre wirklich bedeuten",
    text: "Übermittelte Informationen zum Meldejahr 2026 sind nach § 20 Ende 2036 zu löschen; Dokumente über Melde- und Sorgfaltsschritte sind nach § 39 zehn Jahre aufzubewahren. Eine pauschale Pflicht, jede rohe Transaktion allein wegen DAC8 zehn Jahre zu speichern, steht so nicht im Gesetz. Andere Regeln zu Geldwäsche, MiCA oder Geldtransfers können daneben eigene Pflichten auslösen.",
  },
]

const concerns = [
  {
    title: "Generalverdacht statt Anlass",
    text: "Österreich lässt die relevanten Informationen zunächst für alle Kunden und Transaktionen verarbeiten. Es braucht keinen konkreten Verdacht. Genau diese vorsorgliche Massenerfassung lehnen wir ab.",
  },
  {
    title: "Die Verknüpfung macht den Unterschied",
    text: "DAC8 selbst übermittelt keinen Wallet-Graphen. Werden seine Identitätsdaten aber mit Anbieteraufzeichnungen oder öffentlichen Blockchain-Daten verbunden, können wesentlich tiefere Rückschlüsse entstehen.",
  },
  {
    title: "Gespeicherte Daten wecken neue Begehrlichkeiten",
    text: "Das DAC-System wurde wiederholt um neue Datenarten erweitert. Seit 2026 können ausgetauschte Informationen unter gesetzlichen Bedingungen auch für Geldwäschebekämpfung und Sanktionen verwendet werden. Darum sind enge Zweckgrenzen keine Nebensache.",
  },
  {
    title: "Fehler reisen mit",
    text: "Falscher Steuerwohnsitz, doppelte Werte oder missverstandene Transfers können grenzüberschreitend weitergegeben werden. Je mehr Stellen beteiligt sind, desto wichtiger werden Auskunft, Korrektur und nachvollziehbare Löschung.",
  },
  {
    title: "Nutzen ist kein Blankoscheck",
    text: "Finanzdaten können Ermittlungen unterstützen. Daraus folgt nicht automatisch, dass jedes Feld, jede Person und zehn Jahre Speicherung erforderlich sind. Wirksamkeit und Grundrechtseingriff müssen gemeinsam geprüft werden.",
  },
  {
    title: "Infrastruktur macht Ausbau leichter",
    text: "Neue Felder, Empfänger oder rückwirkende Meldezeiträume würden eine neue Rechtsgrundlage brauchen. Wenn Standards und Schnittstellen einmal stehen, wird der nächste Ausbau technisch leichter – und politische Kontrolle umso wichtiger.",
  },
]

const faqs = [
  {
    question: "Wer steht hinter dac8.org?",
    answer:
      "Eine Initiative des Vereins Bitcoin Austria, unterstützt unter anderem von Coinfinity.",
  },
  {
    question: "Bin ich automatisch betroffen, wenn ich Bitcoin halte?",
    answer:
      "Nein. Entscheidend sind der konkrete Dienstleister, dessen Meldezuständigkeit und deine steuerliche Ansässigkeit. Reine Selbstverwahrung ohne beteiligten meldepflichtigen Dienstleister wird nicht automatisch durch DAC8 meldepflichtig.",
  },
  {
    question: "Wird meine externe Wallet-Adresse gemeldet?",
    answer:
      "Die Richtlinie verlangt für Transfers an externe Adressen aggregierte Werte und Einheiten. Die Adresse selbst gehört nicht zu den dort aufgezählten Meldedaten.",
  },
  {
    question: "Ist DAC8 bereits ein vollständiges Vermögensregister?",
    answer:
      "Nein. DAC8 meldet jährliche Aktivitätsaggregate, keinen vollständigen Nettowert. Die Sorge ist präziser: Das Profil kann zusammen mit Kontenregistern, Anbieteraufzeichnungen und Blockchain-Analysen Teil einer immer aussagekräftigeren Vermögenskarte werden.",
  },
  {
    question: "Werden Transaktionen vor 2026 rückwirkend gemeldet?",
    answer:
      "Nein, nicht nach geltendem Recht. Der erste DAC8-Meldezeitraum beginnt am 1. Jänner 2026. Eine spätere rückwirkende Meldepflicht wäre politisch und technisch denkbar, bräuchte aber eine neue Rechtsgrundlage. Weder DAC9 noch der derzeitige DAC-Recast-Vorschlag enthalten eine solche Pflicht für Krypto-Transaktionen vor 2026.",
  },
  {
    question: "Müssen Anbieter jede Rohtransaktion zehn Jahre speichern?",
    answer:
      "Nicht allein aufgrund von DAC8. § 20 Krypto-MPfG sieht zehn Jahre für die übermittelten Informationen vor; § 39 verlangt zehn Jahre für Dokumente über die Melde- und Sorgfaltsschritte. Andere Gesetze – etwa Geldwäsche-, MiCA- oder Geldtransferregeln – können daneben granularere Aufzeichnungen verlangen. Die pauschale Aussage ‚jede Rohtransaktion zehn Jahre wegen DAC8‘ ist vom Gesetzeswortlaut nicht gedeckt.",
  },
  {
    question: "Bedeuten DAC9 und DAC10 automatisch mehr Krypto-Überwachung?",
    answer:
      "Nein. DAC9 betrifft die Mindestbesteuerung großer Unternehmensgruppen, nicht zusätzliche Daten einzelner Krypto-Nutzer. Der im Juni 2026 vorgeschlagene DAC-Recast, oft DAC10 genannt, ist noch kein geltendes Recht und führt die bisherigen DAC8-Kryptofelder samt Startdatum fort. Er verlangt derzeit weder Wallet-Adressen noch die Nachmeldung von Transaktionen vor 2026. Das DAC-System wächst trotzdem weiter – deshalb prüfen wir jeden neuen Schritt statt nur auf seine Nummer zu zeigen.",
  },
  {
    question: "Geht es hier gegen Steuern oder Geldwäschebekämpfung?",
    answer:
      "Nein. Steuerpflichten sind einzuhalten, und Finanzinformationen können bei Ermittlungen nützlich sein. Wir verlangen, dass Erfassung, Zugriff, Speicherdauer und Weiterverwendung nachweislich notwendig, wirksam und kontrollierbar sind.",
  },
  {
    question: "Ist DAC8 sicher rechtswidrig?",
    answer:
      "Wir halten die anlasslose österreichische Alle-Kunden-Verarbeitung für ein ernstes Grundrechtsproblem und wollen sie prüfen lassen. Ob Gerichte sie tatsächlich aufheben, ist offen. Eine klare politische Haltung braucht kein erfundenes Siegesversprechen.",
  },
  {
    question: "Wie funktioniert der Beschwerdegenerator?",
    answer:
      "Der Generator läuft ausschließlich in deinem Browser und ordnet deine Angaben zu einem Entwurf. Du musst den konkreten Verantwortlichen, die tatsächliche Verarbeitung und persönliche Belege selbst angeben, den Text prüfen und die Beschwerde anschließend eigenständig einbringen.",
  },
  {
    question: "Was passiert mit Daten auf dieser Website?",
    answer:
      "Die Generatoren laufen lokal in deinem Browser; Formulareingaben werden nicht an Bitcoin Austria übertragen oder gespeichert. Welche Verbindungsdaten beim Hoster technisch anfallen und wie wir Seitenaufrufe zählen, steht in der Datenschutzerklärung unter dac8.org/datenschutz.",
  },
]
---

<Layout
  sections={[
    { id: "was-ist-dac8", label: "Was ist DAC8?" },
    { id: "warum", label: "Warum das alle angeht" },
    { id: "ausblick", label: "Ausblick" },
    { id: "forderungen", label: "Forderungen" },
    { id: "handeln", label: "Handeln" },
    { id: "rechtsweg", label: "Rechtsweg" },
    { id: "partner", label: "Zusammenarbeiten" },
    { id: "faq", label: "Fragen & Transparenz" },
    { id: "quellen", label: "Primärquellen" },
  ]}
>
  <MetaPage
    slot="head"
    title="Hintergrund zu DAC8"
    description="Fakten, Risiken, Forderungen, Rechtsweg und Primärquellen zu DAC8 und dem österreichischen Krypto-Meldepflichtgesetz."
  />

  <article class="campaign dossier">
    <header class="hero">
      <p class="eyebrow">Fakten · Risiken · Gegenwehr</p>
      <h1>DAC8: Finanzüberwachung <span>auf Vorrat.</span></h1>
      <p class="intro">
        Österreich verpflichtet Anbieter, Krypto-Aktivität ohne konkreten
        Verdacht massenhaft zu erfassen. Wir sind dagegen. Hier steht präzise,
        was tatsächlich gemeldet wird, wo die Grenzen liegen und wie Gegenwehr
        aussehen kann.
      </p>
      <nav class="hero-actions" aria-label="Direkteinstieg">
        <a class="button primary" href="/handeln/">Was du tun kannst</a>
        <a class="button" href="#was-ist-dac8">Mit den Fakten beginnen</a>
      </nav>
      <dl class="stamp" aria-label="Aktueller Stand">
        <dt>Gesetz in Kraft</dt>
        <dd>seit 1. Jänner 2026</dd>
        <dt>Erste Meldung für 2026</dt>
        <dd>spätestens 31. Juli 2027</dd>
        <dt>Recherche geprüft</dt>
        <dd>2. September 2026</dd>
        <dd class="stamp-note">
          Beschlossen heißt nicht unangreifbar. Gegenwehr beginnt mit Klarheit.
        </dd>
      </dl>
    </header>

    <section id="was-ist-dac8" aria-labelledby="was-heading">
      <p class="eyebrow">Was das Gesetz tatsächlich macht</p>
      <h2 id="was-heading">Nicht weniger behaupten. Nicht mehr.</h2>
      <p class="section-intro">
        DAC8 erweitert den automatischen Informationsaustausch der EU auf
        Kryptowerte. Österreich setzt die Richtlinie mit dem
        Krypto-Meldepflichtgesetz um. Der entscheidende österreichische Punkt:
        Dienstleister müssen die späteren Meldedaten zunächst für alle Kunden,
        Transaktionen und Kryptowerte verarbeiten – auch wenn nicht jede Person
        am Ende gemeldet wird.
      </p>
      <ol class="numbered">
        {facts.map((fact) => (
          <li>
            <h3>{fact.title}</h3>
            <p>{fact.text}</p>
          </li>
        ))}
      </ol>
      <div class="flow" aria-label="Vereinfachter Datenweg">
        <p>
          <span>01</span><strong>Kunde</strong>
          beim meldepflichtigen Anbieter
        </p>
        <p>
          <span>02</span><strong>Dienstleister</strong>
          verarbeitet und meldet
        </p>
        <p>
          <span>03</span><strong>Finanzverwaltung</strong>
          empfängt und prüft
        </p>
        <p>
          <span>04</span><strong>Zuständige Staaten</strong>
          tauschen Daten aus
        </p>
      </div>
      <aside class="clarification">
        <strong>Wichtig:</strong>
        DAC8 übermittelt nicht jede Rohtransaktion. Österreich ordnet trotzdem
        die vorsorgliche Verarbeitung für alle Kunden und Transaktionen an.
        Genau diese Logik nennen wir Finanzüberwachung auf Vorrat.
      </aside>
    </section>

    <section id="warum" aria-labelledby="warum-heading">
      <p class="eyebrow">Warum das alle angeht</p>
      <h2 id="warum-heading">Die Gefahr liegt in der Verknüpfung.</h2>
      <p class="section-intro">
        Ein einzelnes Jahresaggregat ist noch kein Vermögensregister. Doch
        Identität, Wohnadresse, Aktivitätswerte, Anbieteraufzeichnungen und ein
        öffentliches Ledger können gemeinsam ein sehr genaues Bild ergeben. Je
        leichter solche Schichten verbunden werden, desto wichtiger werden
        strenge Zweckgrenzen, kurze Speicherfristen und wirksame Kontrolle.
      </p>
      <div class="arguments">
        {concerns.map((concern) => (
          <section>
            <h3>{concern.title}</h3>
            <p>{concern.text}</p>
          </section>
        ))}
      </div>
      <blockquote>
        <p>
          Wir sind Bitcoiner. Wir haben früh gelernt: Wo Schlüssel, Identitäten
          und Finanzdaten zusammengeführt werden, entstehen Macht und
          Angriffsfläche. Diese Erfahrung bringen wir ein. Unser Maßstab gilt
          aber für alle – auch für Menschen, die nie Bitcoin besessen haben.
        </p>
        <cite>Bitcoin Austria</cite>
      </blockquote>
      <p class="public-case">
        Das ist kein Kampf gegen Steuerpflichten. Gezielte Steuerdurchsetzung
        und Grundrechte sind vereinbar. Die Frage ist, ob der Staat nur jene
        Daten erhält, die für einen klaren Zweck nachweislich notwendig sind –
        und ob Betroffene Fehler korrigieren und rechtswidrige Nutzung stoppen
        können.
      </p>
    </section>

    <section id="ausblick" aria-labelledby="ausblick-heading">
      <p class="eyebrow">Heute beschlossen · morgen offen</p>
      <h2 id="ausblick-heading">
        Ausbau ist möglich. Rückwirkung gilt noch nicht.
      </h2>
      <p class="section-intro">
        Das DAC-System wird regelmäßig verändert. Aber eine höhere Nummer ist
        noch kein Beweis für mehr Krypto-Daten. Wir unterscheiden geltendes
        Recht, aktuelle Vorschläge und das, was erst politisch verhindert werden
        muss.
      </p>
      <div class="arguments">
        <section>
          <h3>DAC8 gilt heute</h3>
          <p>
            Gemeldet werden Identität und Jahresaggregate ab 1. Jänner 2026 –
            keine Wallet-Adressen und keine einzelnen Transaktionsdatensätze.
          </p>
        </section>
        <section>
          <h3>DAC9 ist kein Krypto-Ausbau</h3>
          <p>
            DAC9 betrifft Steuerinformationen großer Unternehmensgruppen. Die
            Richtlinie erweitert nicht die Meldedaten privater Krypto-Nutzer.
          </p>
        </section>
        <section>
          <h3>DAC10 ist noch ein Vorschlag</h3>
          <p>
            Der DAC-Recast vom Juni 2026 führt die bisherigen Krypto-Felder und
            das Startdatum fort. Er ordnet keine rückwirkende Meldung vor 2026
            an.
          </p>
        </section>
        <section>
          <h3>Der nächste Schritt bleibt politisch</h3>
          <p>
            Wallet-Adressen, Einzeltransaktionen oder rückwirkende Zeiträume
            könnten nur durch neue Regeln hinzukommen. Wir wehren uns, bevor aus
            einer Möglichkeit der nächste Standard wird.
          </p>
        </section>
      </div>
    </section>

    <section id="forderungen" aria-labelledby="forderungen-heading">
      <p class="eyebrow">Wofür wir eintreten</p>
      <h2 id="forderungen-heading">
        Eine bessere digitale Zukunft ist möglich.
      </h2>
      <p class="section-intro">
        Wer umfassende Finanzdaten verlangt, trägt die Begründungslast. Wir
        fordern keine Sonderzone für Bitcoin, sondern rechtsstaatliche
        Mindeststandards für jede staatliche Finanzdaten-Infrastruktur.
      </p>
      <ul class="demands">
        <li>
          Transaktionsprofile erst erstellen, wenn eine Person tatsächlich
          meldepflichtig ist.
        </li>
        <li>
          Speicherfristen für jedes Datenfeld begründen und nie gemeldete Daten
          zuverlässig löschen.
        </li>
        <li>
          Empfänger, Zugriffe und Weiterverwendung eng begrenzen und lückenlos
          protokollieren.
        </li>
        <li>
          Auskunft, Korrektur und Löschung über alle Empfänger hinweg praktisch
          durchsetzbar machen.
        </li>
        <li>
          Zielgerichtete Anfragen nutzen, wo sie das gleiche Ergebnis mit
          weniger Eingriff erreichen.
        </li>
        <li>
          Nutzen, Kosten und Grundrechtsfolgen unabhängig und regelmäßig
          evaluieren.
        </li>
      </ul>
      <p class="public-case">
        <strong>Gegenwehr wirkt:</strong>
        Die von AKVorrat, heute epicenter.works, organisierte österreichische
        Beschwerde führte über den VfGH zum EuGH. 2014 wurden die EU-Richtlinie
        und die zentralen österreichischen Regeln zur Vorratsdatenspeicherung
        aufgehoben. DAC8 ist ein anderer Fall und der Ausgang offen. Der Erfolg
        zeigt trotzdem: Grundrechte verteidigen ist kein symbolischer Akt.
      </p>
    </section>

    <section id="handeln" aria-labelledby="handeln-heading">
      <p class="eyebrow">Handeln</p>
      <h2 id="handeln-heading">Beschwer dich. Schreib deinen Abgeordneten.</h2>
      <p class="section-intro">
        DAC8 ist beschlossen. Wie weit Finanzdaten erfasst werden dürfen, bleibt
        eine rechtliche und politische Frage. Dafür stehen dir eigene
        demokratische und rechtliche Mittel offen.
      </p>
      <ol class="action-grid three">
        <li>
          <p class="step">01 · Datenschutz</p>
          <h3>Eigene Beschwerde einbringen</h3>
          <p>
            Wenn ein konkreter Anbieter deine Daten verarbeitet und du darin
            eine Rechtsverletzung siehst, kannst du selbst eine Beschwerde bei
            der Datenschutzbehörde einbringen. Benenne den Verantwortlichen, das
            betroffene Recht und den tatsächlichen Sachverhalt.
          </p>
          <a class="button" href="/handeln/#beschwerde"
            >Beschwerde vorbereiten</a
          >
        </li>
        <li>
          <p class="step">02 · Demokratie</p>
          <h3>Abgeordnete anschreiben</h3>
          <p>
            Schreib deinen gewählten Vertreterinnen und Vertretern mit eigenen
            Worten. Sag ihnen, warum du gezielte Steuerdurchsetzung unterstützt,
            aber klare Grenzen für Erfassung, Speicherung und Weiterverwendung
            erwartest.
          </p>
          <a class="button" href="/handeln/#abgeordnete">Brief vorbereiten</a>
        </li>
        <li>
          <p class="step">03 · Öffentlichkeit</p>
          <h3>Fakten weitergeben</h3>
          <p>
            Teile diese Seite mit einem Bitcoiner – und mit einer Person, die
            glaubt, DAC8 betreffe sie nicht. Finanzielle Privatsphäre ist kein
            Spezialinteresse einer Szene.
          </p>
          <button class="button" type="button" data-share>Seite teilen</button>
        </li>
      </ol>
      <a class="text-link" href="/spenden/">Die Arbeit finanzieren</a>
      <aside class="clarification">
        <strong>Wichtig:</strong>
        Eine DSB-Beschwerde ist ein persönlicher, förmlicher Rechtsbehelf. Der
        Generator erleichtert den Entwurf, ersetzt aber weder deine
        tatsächlichen Angaben noch die Prüfung vor dem Absenden.
      </aside>
      <p class="share-status" data-share-status aria-live="polite"></p>
    </section>

    <section id="rechtsweg" aria-labelledby="rechtsweg-heading">
      <p class="eyebrow">Rechtsweg</p>
      <h2 id="rechtsweg-heading">Wir versprechen keinen schnellen Sieg.</h2>
      <p class="section-intro">
        Ein starker Fall beginnt nicht mit der größten Behauptung, sondern mit
        der richtigen betroffenen Person, dem richtigen Verantwortlichen und der
        vollständigen Gegenjudikatur. Für gewöhnliche Nutzer ist ein direkter
        Individualantrag nach der aktuellen VfGH-Rechtsprechung besonders
        riskant.
      </p>
      <div class="legal-tracks">
        <section>
          <p class="step">Spur A · Nutzer</p>
          <h3>Konkrete Verarbeitung angreifen</h3>
          <p>
            Daten beim konkreten Anbieter erheben, eine präzise Beschwerde bei
            der Datenschutzbehörde führen und die Sache zum
            Bundesverwaltungsgericht bringen. Dort können österreichische
            Normprüfung und eine Vorlage an den EuGH aus einem echten Fall
            heraus beantragt werden.
          </p>
        </section>
        <section>
          <p class="step">Spur B · Anbieter</p>
          <h3>Österreichische Mehrpflichten prüfen</h3>
          <p>
            Ein in Österreich direkt verpflichteter Anbieter kann andere
            Voraussetzungen für einen Individualantrag erfüllen. Dafür müssen
            die zusätzlichen österreichischen Pflichten und Kosten sauber vom
            EU-Mindeststandard, MiCA, TFR und Geldwäschepflichten getrennt
            werden.
          </p>
        </section>
      </div>
      <div class="route" aria-label="Möglicher Nutzer-Rechtsweg">
        <span>Anbieter</span><b>→</b><span>DSB</span><b>→</b><span>BVwG</span
        ><b>→</b><span>VfGH / EuGH</span>
      </div>
      <aside class="counsel">
        <p class="eyebrow">Anwaltliche Begleitung</p>
        <h3>Noch nicht öffentlich benannt.</h3>
        <p>
          Wir bereiten die anwaltliche Prüfung vor. Solange Mandat und Nennung
          nicht bestätigt sind, behauptet diese Seite weder eine Einbringung
          noch einen sicheren Verfahrensweg. Auch eine Vorlage an den EuGH kann
          nur das Gericht beschließen, nicht die Beschwerdeführerin.
        </p>
      </aside>
      <aside class="clarification">
        <strong>Was der Generator bewusst nicht macht:</strong>
        Er bestimmt weder automatisch den richtigen Verantwortlichen noch
        behauptet er einen Sachverhalt für dich. Diese Angaben und deine Belege
        müssen aus deinem konkreten Fall kommen.
      </aside>
    </section>

    <section id="partner" aria-labelledby="partner-heading">
      <p class="eyebrow">Europäische Zusammenarbeit</p>
      <h2 id="partner-heading">Österreich ist der Anfang, nicht die Grenze.</h2>
      <p class="section-intro">
        Wir teilen Argumente, Primärquellen und praktische Erfahrung mit
        Organisationen, Unternehmen sowie rechtlichen und technischen
        Fachleuten, die DAC8 in ihrem Land belastbar prüfen wollen. Nationale
        Verfahren brauchen eigene Tatsachen und eigene Rechtswege – sie lassen
        sich nicht einfach aus Österreich kopieren.
      </p>
      <a
        class="button"
        href="mailto:kontakt@dac8.org?subject=Zusammenarbeit%20zu%20DAC8"
        >Zusammenarbeit anfragen</a
      >
    </section>

    <section id="faq" aria-labelledby="faq-heading">
      <p class="eyebrow">Fragen & Transparenz</p>
      <h2 id="faq-heading">FAQ</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="quellen" class="sources" aria-labelledby="sources-heading">
      <p class="eyebrow">Belege statt Behauptungen</p>
      <h2 id="sources-heading">Selbst prüfen.</h2>
      <p class="section-intro">
        Unsere Aussagen beruhen auf geltendem Recht, offizieller Rechtsprechung
        und institutionellen Unterlagen. Wo nur ein Risiko oder eine politische
        Bewertung vorliegt, nennen wir es auch so.
