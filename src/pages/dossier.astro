---
import Artwork from "@/components/Artwork.astro"
import Disclosure from "@/components/Disclosure.astro"
import Glossary from "@/components/Glossary.astro"
import MetaPage from "@/components/MetaPage.astro"
import Term from "@/components/Term.astro"
import Layout from "@/layouts/Layout.astro"
import { law, sourceGroups } from "@/data/sources"
import "@/styles/dossier.css"

// The legal reference: what DAC8 and the Austrian act require, each fact
// once, with its legal basis beside it as a quiet link to the primary text
// (src/data/sources.ts). No story and no campaign here: the home page tells
// the story, and the arguments, leak, proceedings and history pages each own
// theirs. Terms explain themselves where they first appear (Term.astro) and
// stand A to Z in the register. The English page mirrors this one.
const researchDate = "30. September 2026"
const sourceCount = sourceGroups.reduce(
  (n, group) => n + group.sources.length,
  0,
)

const faqs = [
  {
    question: "Wird meine Wallet-Adresse gemeldet?",
    answer:
      "Nein, Wallet-Adressen stehen nicht in der Jahresmeldung. Gemeldet werden aber Wert und Stückzahl von Übertragungen an Wallet-Adressen, von denen der Anbieter nicht weiß, dass sie zu einem anderen Anbieter gehören, als Summe. Darunter fällt in der Regel auch deine eigene Wallet. Die Wallet-Adresse und ihr Bezug zu dir bleiben nach den Geldwäschevorschriften trotzdem beim Anbieter gespeichert.",
  },
  {
    question: "Lässt sich aus der Meldung mein Vermögen ablesen?",
    answer:
      "Nicht direkt. Gemeldet werden Jahressummen, kein aktueller Bestand und kein Gesamtvermögen. Deinen Kontostand kennt der Anbieter aber, und über die Jahre zeigen die Meldungen, wie viel du bewegst. Wer sie mit dem Kontenregister und Blockchain-Analyse oder, nach einem Datenleck, mit Anbieteraufzeichnungen zusammenführt, kann ein detailliertes Bild der Vermögensverhältnisse gewinnen.",
  },
  {
    question: "Was ist mit Käufen und Verkäufen vor 2026?",
    answer:
      "Sie werden nicht nachgemeldet. Der erste Meldezeitraum beginnt am 1. Jänner 2026. Eine rückwirkende Meldepflicht bräuchte ein neues Gesetz; weder DAC9 noch der aktuelle Vorschlag für eine Neufassung der Richtlinie sehen das vor. Beim Anbieter liegen ältere Transaktionen trotzdem: Seit 2020 verlangen die Geldwäschevorschriften, sie derzeit bis zehn Jahre nach Ende der Kundenbeziehung aufzubewahren.",
  },
  {
    question: "Ich wohne in Deutschland. Wer bekommt meine Daten?",
    answer:
      "Bei einem Anbieter mit Meldepflicht in Österreich geht deine Jahresmeldung zuerst ans österreichische Finanzamt, und Österreich gibt sie bis 30. September an Deutschland weiter, weil du dort steuerlich ansässig bist. Anbieter in Deutschland oder einem anderen EU-Staat melden dort; die Daten landen ebenfalls bei der deutschen Steuerverwaltung. Was ein Staat aus dem Austausch erhält, muss er laut Richtlinie mindestens fünf Jahre aufbewahren; eine feste Höchstfrist nennt sie nicht. Ausweis, Wallet-Adressen und einzelne Transaktionen bleiben beim Anbieter.",
  },
  {
    question: "Was ändert die Beschwerde für mich?",
    answer:
      "Vorerst nichts: Die Datenerfassung läuft während des Verfahrens weiter. Wir sind überzeugt, dass die Erfassung aller Kunden gegen Grundrechte verstößt. Die Datenschutzbehörde ist an die Gesetze gebunden, wir rechnen deshalb damit, dass sie die Beschwerde abweist. Danach entscheiden die Gerichte, auch darüber, ob der Fall zum Europäischen Gerichtshof kommt. Wie lange das dauert und wie sich Privatpersonen beteiligen können, klären wir noch.",
  },
  {
    question: "Wie erkenne ich Phishing mit der Meldepflicht?",
    answer:
      "In Österreich kursieren schon gefälschte FinanzOnline-Nachrichten, die unter Verweis auf neue Krypto-Steuerregeln nach deinen Beständen fragen. Das Finanzamt fragt nicht per E-Mail oder SMS danach. Niemand, der seriös ist, verlangt, dass du eine Wallet verbindest oder deine Wiederherstellungsphrase eingibst, also die Wörter, mit denen sich eine Wallet wiederherstellen lässt. Die Daten für DAC8 meldet dein Anbieter selbst. Sprich zurückhaltend über deine Bestände, auch im Bekanntenkreis und in sozialen Medien.",
    link: {
      href: "https://www.watchlist-internet.at/news/phishing-falle-finanzonline-krypto/",
      label: "Warnung der Watchlist Internet",
    },
  },
  {
    question: "Bedeuten DAC9 und DAC10 noch mehr Krypto-Überwachung?",
    answer:
      "Nicht automatisch. DAC9 betrifft die Mindestbesteuerung großer Unternehmensgruppen, nicht einzelne Krypto-Nutzer. Die im Juni 2026 vorgeschlagene Neufassung der Richtlinie, oft DAC10 genannt, ist noch kein geltendes Recht und führt die bisherigen Krypto-Felder fort.",
  },
]
---

<Layout
  sections={[
    { id: "gemeldet", label: "Meldung" },
    { id: "speicherdauer", label: "Speicherdauer" },
    { id: "ablauf", label: "Ablauf" },
    { id: "faq", label: "Fragen" },
    { id: "begriffe", label: "Begriffe" },
    { id: "quellen", label: "Quellen" },
  ]}
>
  <MetaPage slot="head" />

  <article class="campaign dossier">
    <header class="hero">
      <div class="hero-text">
        <h1>Was DAC8 verlangt. <span>Und was das für dich heißt.</span></h1>
        <p class="lead">
          Betroffen bist du, wenn du Kryptowerte über einen
          <Term id="anbieter">Anbieter</Term>
          wie eine Börse, einen Broker oder eine App kaufst, verkaufst oder
          verwahren lässt. Wer nur
          <Term id="selbstverwahrung">selbst verwahrt</Term>
          und nie über einen Anbieter kauft oder verkauft, wird nicht gemeldet.
        </p>
      </div>
    </header>

    <section id="gemeldet" class="band" aria-labelledby="gemeldet-heading">
      <div class="art-split report-head">
        <div>
          <h2 id="gemeldet-heading">
            Was ans Finanzamt geht. <span>Was beim Anbieter bleibt.</span>
          </h2>
          <p class="section-intro">
            Nach dem
            <Term id="krypto-mpfg">Krypto-Meldepflichtgesetz</Term>
            meldet der Anbieter jedes Jahr ans Finanzamt, beginnend mit 2026.
            Die Einzelheiten behält er, die meisten schon wegen der
            <Term id="fm-gwg">Geldwäschevorschriften</Term>.
          </p>
        </div>
        <Artwork
          id="reportAssets"
          language="de"
          zoom
          caption="Musterblatt einer Jahresmeldung."
        />
      </div>
      <div class="compare">
        <div class="reported">
          <h3>Geht ans Finanzamt</h3>
          <p class="basis"><a href={law.section18}>§ 18 Krypto-MPfG</a></p>
          <ul>
            <li>Name, Anschrift und Geburtsdatum</li>
            <li>Steuerwohnsitz und Steuernummer</li>
            <li>
              je Kryptowert die Jahressummen für Kauf, Verkauf, Tausch und
              Übertragung: Wert in Euro, Stückzahl und meist die Anzahl der
              Vorgänge
            </li>
            <li>
              Übertragungen auf <Term id="wallet">Wallets</Term> ohne bekannten
              Anbieter, in der Regel auch deine eigene:
              <strong
                >als Summe, ohne
                <Term id="wallet-adresse">Wallet-Adressen</Term></strong
              >
            </li>
            <li>
              auch Vorgänge, die steuerlich meist keine Rolle spielen, etwa der
              Tausch von Krypto gegen Krypto
            </li>
          </ul>
          <p class="note">
            Aufbereiten muss der Anbieter diese Meldedaten für alle Kunden, auch
            für jene, die am Ende nicht gemeldet werden.
            <a class="basis" href={law.section20}>§ 20 Abs. 1 Krypto-MPfG</a>
          </p>
        </div>
        <div class="absent">
          <h3>Bleibt beim Anbieter</h3>
          <p class="basis">
            <a href={law.fmGwG}>§ 21 FM-GwG</a>,
            <a href={law.transferRegulation}>Verordnung (EU) 2023/1113</a>
          </p>
          <ul>
            <li>
              dein Ausweis und die Unterlagen aus der
              <Term id="kyc">Identifizierung</Term>
            </li>
            <li>Wallet-Adressen, auch die deiner eigenen Wallet</li>
            <li>
              einzelne Transaktionen mit Zeitpunkt und Betrag, bei Übertragungen
              auch <Term id="travel-rule">Absender und Empfänger</Term>
            </li>
            <li>dein Kontostand</li>
          </ul>
          <p class="note">
            Für DAC8 nimmt der Anbieter Steuernummer und Steuerwohnsitz zu
            diesen Unterlagen dazu.
          </p>
        </div>
      </div>
    </section>

    <section id="speicherdauer" aria-labelledby="speicherdauer-heading">
      <h2 id="speicherdauer-heading">Wer deine Daten wie lange speichert</h2>
      <p class="section-intro">
        Jedes Jahr kommt eine Meldung dazu, und die längste Frist beginnt erst,
        wenn du dein Konto schließt.
      </p>
      <div class="art-split">
        <table class="retention">
          <thead>
            <tr>
              <th scope="col">Wer</th>
              <th scope="col">Was</th>
              <th scope="col">Wie lange</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Dein Anbieter</th>
              <td data-label="Was">
                Ausweis, Wallet-Adressen und einzelne Transaktionen
              </td>
              <td data-label="Wie lange">
                derzeit bis
                <strong>zehn Jahre nach Ende der Kundenbeziehung</strong>
                <a class="basis" href={law.fmGwG}>§ 21 FM-GwG</a>
              </td>
            </tr>
            <tr>
              <th scope="row">Dein Anbieter</th>
              <td data-label="Was">
                jede <Term id="jahresmeldung">Jahresmeldung</Term>
              </td>
              <td data-label="Wie lange">
                <strong>zehn Jahre</strong>
                nach dem Meldejahr, dann wird sie gelöscht
                <a class="basis" href={law.section20}
                  >§ 20 Abs. 4 Krypto-MPfG</a
                >
              </td>
            </tr>
            <tr>
              <th scope="row">
                Steuerbehörde eines anderen EU-Staats, etwa Deutschland
              </th>
              <td data-label="Was">
                die Jahresmeldung, wenn du dort steuerlich ansässig bist
              </td>
              <td data-label="Wie lange">
                <strong>mindestens fünf Jahre</strong>, eine Höchstfrist nennt
                die Richtlinie nicht
                <a class="basis" href={law.dac8}>Art. 22 Abs. 3 DAC</a>
              </td>
            </tr>
          </tbody>
        </table>
        <Artwork
          id="yearsOnFile"
          language="de"
          caption="Bleibst du Kunde, liegen ab 2036 laufend zehn Jahresmeldungen beim Anbieter."
        />
      </div>
    </section>

    <section id="ablauf" class="band" aria-labelledby="ablauf-heading">
      <h2 id="ablauf-heading">So läuft die Meldung</h2>
      <p class="section-intro">
        DAC8 ist eine EU-Richtlinie: Sie weitet den automatischen Austausch von
        Steuerdaten zwischen den EU-Staaten auf Kryptowerte aus. Österreich
        setzt sie mit dem Krypto-Meldepflichtgesetz um, das seit 1. Jänner 2026
        gilt.
      </p>
      <p class="basis">
        <a href={law.dac8}>Richtlinie (EU) 2023/2226</a>,
        <a href={law.kryptoMPfG}>BGBl. I Nr. 96/2025</a>
      </p>
      <ol class="flow" aria-label="Der Weg der ersten Meldung">
        <li>
          <strong>2026</strong>
          <span>
            Dein Anbieter zeichnet das erste Meldejahr auf und bereitet die
            Meldedaten für alle Kunden auf.
            <a class="basis" href={law.section20}>§ 20 Abs. 1 Krypto-MPfG</a>
          </span>
        </li>
        <li>
          <strong>bis 31. Juli 2027</strong>
          <span>
            Er meldet das Jahr 2026 ans Finanzamt in Österreich.
            <a class="basis" href={law.kryptoMPfG}>§ 19 Abs. 2 Krypto-MPfG</a>
          </span>
        </li>
        <li>
          <strong>bis 30. September 2027</strong>
          <span>
            Wohnst du in Deutschland oder einem anderen EU-Staat, gibt
            Österreich die Meldung dorthin weiter.
            <a class="basis" href={law.kryptoMPfG}>§ 21 Krypto-MPfG</a>
          </span>
        </li>
        <li>
          <strong>jedes Jahr</strong>
          <span>Danach wiederholt sich das für jedes Jahr aufs Neue.</span>
        </li>
      </ol>
      <a class="text-link" href="/geschichte/">Wie es zu DAC8 kam</a>
    </section>

    <div class="reference">
      <section id="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Häufige Fragen</h2>
        <div class="disclosure-list">
          {faqs.map((faq) => (
            <Disclosure name="faq">
              <Fragment slot="summary">{faq.question}</Fragment>
              <p>
                {faq.answer}
                {faq.link && <a href={faq.link.href}>{faq.link.label}</a>}
              </p>
            </Disclosure>
          ))}
        </div>
      </section>

      <Glossary language="de" />

      <section id="quellen" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Quellen</h2>
        <div class="sources">
          <p class="sources-intro">
            Das Dossier stützt sich auf Gesetze, EU-Recht, Urteile und Berichte.
            Stand der Recherche: {researchDate}. Quellen zur Entwicklung von
            1977 bis zur Neufassung stehen in der
            <a href="/geschichte/">Geschichte der DAC</a>.
          </p>
          <details class="bibliography">
            <summary>
              <span class="show">Alle {sourceCount} Quellen anzeigen</span>
              <span class="hide">Quellen ausblenden</span>
            </summary>
            <div class="bibliography-groups">
              {sourceGroups.map((group) => (
                <div>
                  <h3>{group.title}</h3>
                  <ul>
                    {group.sources.map((source) => (
                      <li>
                        <a href={source.href}>{source.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </div>
      </section>
    </div>
  </article>
</Layout>

<script is:inline>
  // Forward links to sections that moved. The critique, outlook and demands
  // went to the arguments page, the cases and attacks to the leak page, both
  // in October 2026; "Was ist DAC8" became the reporting timeline. Later that
  // month the overview went into the lead ("#top" is the top of the page),
  // and risk and complaint were left to their own pages.
  ;(() => {
    const moved = {
      "#problem": "/argumente/#sicherheit",
      "#verknuepfung": "/argumente/#verknuepfung",
      "#zahlungsprofile": "/argumente/#zahlungsprofile",
      "#ausblick": "/argumente/#ausbau",
      "#forderungen": "/argumente/#forderungen",
      "#faelle": "/datenlecks/",
      "#angriffe": "/datenlecks/#angriffe",
      "#was-ist-dac8": "#ablauf",
      "#ueberblick": "#top",
      "#risiko": "/datenlecks/",
      "#rechtsweg": "/verfahren/",
    }
    const forward = () => {
      const target = moved[location.hash]
      if (target) location.replace(target)
    }
    forward()
    addEventListener("hashchange", forward)
  })()
</script>
