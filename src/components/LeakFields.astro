---
import { fields, leaks } from "@/data/leaks"
import type { Language } from "@/lib/i18n"

// Die vier Stücke, die bei einem Anbieter für DAC8 zusammenliegen, und wie
// oft jedes schon verloren ging. Die Zahl zählt alle belegten Fälle und
// wächst mit der Sammlung; darunter steht ein Fall mit dem, was danach
// geschah. Welcher Fall das ist, steht in src/data/leaks.ts bei den Feldern.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"

const pieces = fields.map((field) => {
  const example = leaks.find((leak) => leak.id === field.example)
  return {
    label: field.label[language],
    count: leaks.filter((leak) => leak.lost.includes(field.id)).length,
    dateline: example
      ? [example.name[language], example.year].filter(Boolean).join(" · ")
      : undefined,
    then: example?.then?.[language],
  }
})
---

<ul class="leak-fields">
  {pieces.map((piece) => (
    <li>
      <p class="count">
        {piece.count}
        <small>{piece.count === 1 ? (en ? "case" : "Fall") : en ? "cases" : "Fälle"}</small>
      </p>
      <h3>{piece.label}</h3>
      {piece.then && (
        <p class="example">
          <span>{piece.dateline}</span>
          {piece.then}.
        </p>
      )}
    </li>
  ))}
</ul>

<style>
  /* Wie die Kennzahlen oben auf der Startseite: Metallkante, große Zahl,
     darunter das Stück und ein Fall. */
  .leak-fields {
    display: grid;
    gap: var(--space-l);
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding-block-start: var(--space-s);
    background: var(--metal-rule) top / 100% 2px no-repeat;
  }

  .count {
    font-size: clamp(1.75rem, 3cqi, 2.25rem);
    font-weight: 600;
    font-stretch: 94%;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .count small {
    margin-inline-start: 0.2em;
    font-size: 0.45em;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
  }

  .example {
    margin-block-start: var(--space-2xs);
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .example span {
    display: block;
    color: var(--ink-3);
  }

  @container campaign (width >= 30rem) {
    .leak-fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container campaign (width >= 60rem) {
    .leak-fields {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
