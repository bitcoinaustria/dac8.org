---
import Artwork from "@/components/Artwork.astro"
import { artwork, type ArtworkId, imageFor } from "@/data/artwork"
import type { Language } from "@/lib/i18n"

interface Props {
  art: ArtworkId
  language: Language
  title: string
  // Says what the picture shows where that differs from the annual report,
  // e.g. linked or leaked records. It stands under the text instead of a
  // caption, so all words of a scene sit in one column.
  note?: string
  // "wide" gives the illustration the larger column, for the report specimen
  // that needs its width to stay legible.
  wide?: boolean
  zoom?: boolean
}

const { art, language, title, note, wide = false, zoom = false } = Astro.props
const full = zoom ? imageFor(artwork[art], language).src : undefined
---

<div class:list={["scene", { "scene-wide": wide }]}>
  <div class="scene-text">
    <h3>{title}</h3>
    <slot />
    {(note || full) && (
      <p class="scene-note">
        {note}
        {full && (
          <a class="artwork-zoom-link" href={full}>
            {language === "en" ? "Full size" : "In voller Größe"}
          </a>
        )}
      </p>
    )}
  </div>
  <Artwork id={art} language={language} size="scene" caption={false} />
</div>
