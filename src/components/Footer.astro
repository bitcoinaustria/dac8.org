---
import BitcoinAustriaLogo from "@/assets/bitcoin-austria-horizontal.svg"

import { campaign, feedFor, languageFor, pathFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const background = pathFor("background", language)
const sections = [
  {
    title: en ? "Background" : "Hintergrund",
    links: [
      {
        label: en ? "What is DAC8?" : "Was ist DAC8?",
        href: `${background}#was-ist-dac8`,
      },
      {
        label: en ? "What gets reported" : "Was gemeldet wird",
        href: `${background}#gemeldet`,
      },
      {
        label: en ? "Our demands" : "Was wir fordern",
        href: `${background}#forderungen`,
      },
      {
        label: en ? "Our legal strategy" : "Wie wir vorgehen",
        href: `${background}#rechtsweg`,
      },
      { label: en ? "Sources" : "Quellen", href: `${background}#quellen` },
    ],
  },
  {
    title: en ? "Support" : "Unterstützen",
    links: [
      { label: en ? "Donate" : "Spenden", href: pathFor("donate", language) },
      {
        label: en ? "Get involved" : "Mitmachen",
        href: pathFor("support", language),
      },
      {
        label: en ? "Campaign updates" : "Aktuelles zum Verfahren",
        href: pathFor("updates", language),
      },
      { label: en ? "RSS feed" : "RSS-Feed", href: feedFor(language) },
      {
        label: en
          ? "Bitcoin Austria newsletter (DE)"
          : "Bitcoin-Austria-Newsletter",
        href: campaign.newsletter,
      },
    ],
  },
  {
    title: en ? "More" : "Mehr",
    links: [
      {
        label: en ? "Who we are" : "Wer dahintersteht",
        href: `${pathFor("home", language)}#position`,
      },
      { label: en ? "Contact" : "Kontakt", href: "mailto:kontakt@dac8.org" },
      {
        label: en ? "Source code on GitHub" : "Quellcode auf GitHub",
        href: "https://github.com/bitcoinaustria/dac8.org",
      },
      { label: "Bitcoin Austria", href: "https://bitcoin-austria.at" },
    ],
  },
]
---

<footer>
  <div class="footer-main">
    <div class="footer-lead">
      <a class="footer-brand" href={pathFor("home", language)}
        >dac8<span>.org</span></a
      >
      <p>
        {en ? "Against indiscriminate crypto-asset financial data collection. An initiative by Bitcoin Austria." : "Gegen die anlasslose Erfassung von Krypto-Finanzdaten. Eine Initiative des Vereins Bitcoin Austria."}
      </p>
      <a
        class="social-link"
        href="https://x.com/bitcoin_at"
        aria-label={en ? "Bitcoin Austria on X" : "Bitcoin Austria auf X"}
      >
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l7.4-8.5L.8 2h6.5l4.5 6.8L18.9 2Zm-1.1 18h1.7L6.4 3.9H4.6L17.8 20Z"
          />
        </svg>
      </a>
    </div>

    <nav aria-label={en ? "Further navigation" : "Weitere Navigation"}>
      {sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <ul>
            {section.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  </div>

  <div class="footer-base">
    <a
      class="association-brand"
      href="https://bitcoin-austria.at"
      aria-label="Bitcoin Austria"
    >
      <BitcoinAustriaLogo />
    </a>
    <div class="footer-meta">
      <ul
        class="legal-links"
        aria-label={en ? "Legal information" : "Rechtliches"}
      >
        <li>
          <a href={pathFor("legal", language)}
            >{en ? "Legal notice" : "Impressum"}</a
          >
        </li>
        <li>
          <a href={pathFor("privacy", language)}
            >{en ? "Privacy" : "Datenschutz"}</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: var(--space-xl) 0 var(--space-l);
    border-block-start: 2px solid var(--foreground);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) minmax(0, 2fr);
    gap: var(--space-l) var(--space-xl);
    align-items: start;

    @media (width < 72rem) {
      grid-template-columns: 1fr;
    }
  }

  .footer-lead p {
    max-inline-size: 40ch;
    margin-block-start: var(--space-s);
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    margin-inline-start: -0.75rem;
    min-block-size: 2.75rem;
    margin-block-start: var(--space-xs);
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .social-link:hover {
    color: var(--foreground);
  }

  .social-link svg {
    inline-size: 1em;
    block-size: 1em;
    flex-shrink: 0;
  }

  .footer-brand {
    inline-size: fit-content;
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.04em;
    text-decoration: none;

    span {
      color: var(--accent);
    }
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .association-brand {
    inline-size: min(100%, 8rem);
    color: var(--muted-foreground);

    &:hover {
      color: var(--foreground);
    }

    svg {
      inline-size: 100%;
      block-size: auto;
    }
  }

  nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-l);
    align-content: start;

    ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  h2 {
    margin-block-end: var(--space-xs);
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  nav a {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-block: 0.35em;
    line-height: 1.4;
    color: var(--foreground);
    text-decoration: none;

    &:hover {
      color: var(--accent);
    }
  }

  .footer-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--step--1);

    @media (width < 40rem) {
      flex-wrap: wrap;
    }
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-m);

    a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      color: inherit;
      text-underline-offset: 0.2em;

      &:hover {
        color: var(--foreground);
      }
    }
  }
</style>
