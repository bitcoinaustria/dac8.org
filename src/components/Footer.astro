---
import BitcoinAustriaLogo from "@/assets/bitcoin-austria-horizontal.svg"

const sections = [
  {
    title: "Hintergrund",
    links: [
      { label: "Was ist DAC8?", href: "/hintergrund/#was-ist-dac8" },
      { label: "Warum das alle angeht", href: "/hintergrund/#warum" },
      { label: "Rechtsweg", href: "/hintergrund/#rechtsweg" },
      { label: "Fragen & Transparenz", href: "/hintergrund/#faq" },
      { label: "Primärquellen", href: "/hintergrund/#quellen" },
    ],
  },
  {
    title: "Handeln",
    links: [
      { label: "Beschwerde vorbereiten", href: "/handeln/#beschwerde" },
      { label: "Abgeordnete anschreiben", href: "/handeln/#abgeordnete" },
      { label: "Spenden", href: "/spenden/" },
    ],
  },
  {
    title: "Mehr",
    links: [
      {
        label: "Partner & Unternehmen",
        href: "/hintergrund/#partner",
      },
      { label: "Kontakt", href: "mailto:kontakt@dac8.org" },
      {
        label: "Quellcode auf GitHub",
        href: "https://github.com/bitcoinaustria/dac8.org",
      },
      { label: "Bitcoin Austria", href: "https://bitcoin-austria.at" },
    ],
  },
]
---

<footer>
  <div class="footer-main">
    <div class="footer-lead">
      <a class="footer-brand" href="/">dac8<span>.org</span></a>
      <p>
        Klare Grenzen für DAC8 und staatliche Finanzdaten. Eine Initiative des
        Vereins Bitcoin Austria.
      </p>
    </div>

    <nav aria-label="Footer">
      {sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <ul>
            {section.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  </div>

  <div class="footer-base">
    <a
      class="association-brand"
      href="https://bitcoin-austria.at"
      aria-label="Bitcoin Austria"
    >
      <BitcoinAustriaLogo />
    </a>
    <div class="footer-meta">
      <p>
        Code und Texte:
        <a href="https://github.com/bitcoinaustria/dac8.org/blob/main/LICENSE"
          >MIT-Lizenz</a
        >
      </p>
      <ul class="legal-links" aria-label="Rechtliches">
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: var(--space-xl) 0 var(--space-l);
    border-block-start: 2px solid var(--foreground);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) minmax(0, 2fr);
    gap: var(--space-xl) var(--space-3xl);
    align-items: start;

    @media (width < 64rem) {
      grid-template-columns: 1fr;
    }
  }

  .footer-lead p {
    max-inline-size: 40ch;
    margin-block-start: var(--space-s);
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .footer-brand {
    inline-size: fit-content;
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.04em;
    text-decoration: none;

    span {
      color: var(--accent);
    }
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .association-brand {
    inline-size: min(100%, 8rem);
    color: var(--muted-foreground);

    &:hover {
      color: var(--foreground);
    }

    svg {
      inline-size: 100%;
      block-size: auto;
    }
  }

  nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
    align-content: start;

    @media (width < 40rem) {
      grid-template-columns: 1fr;
    }

    ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  h2 {
    margin-block-end: var(--space-xs);
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  nav li + li {
    margin-block-start: var(--space-2xs);
  }

  nav a {
    color: var(--foreground);
    text-decoration: none;

    &:hover {
      color: var(--accent);
    }
  }

  .footer-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--step--1);

    @media (width < 40rem) {
      flex-wrap: wrap;
    }
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-m);

    p {
      margin: 0;
    }

    a {
      color: inherit;
      text-underline-offset: 0.2em;

      &:hover {
        color: var(--foreground);
      }
    }
  }
</style>
