---
import BitcoinAustriaLogo from "@/assets/bitcoin-austria-horizontal.svg"
import CheckIcon from "@/assets/icons/check.svg"
import ShareIcon from "@/assets/icons/share.svg"
import {
  campaign,
  donateFor,
  feedFor,
  languageFor,
  pathFor,
  shareKitFor,
} from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const background = pathFor("dossier", language)
// Only what the top bar does not already offer: the main pages are one click
// away there, so the footer keeps reference pages, ways to help and ways to
// follow the campaign. The October 2026 feedback found 19 links here too many.
const sections = [
  {
    title: en ? "Background" : "Hintergrund",
    links: [
      { label: en ? "Questions" : "Häufige Fragen", href: `${background}#faq` },
      { label: en ? "Terms" : "Begriffe", href: `${background}#begriffe` },
      { label: en ? "Sources" : "Quellen", href: `${background}#quellen` },
      {
        label: en ? "Data leaks" : "Datenlecks",
        href: pathFor("leaks", language),
      },
      {
        label: en ? "History of the DAC" : "Geschichte der DAC",
        href: pathFor("history", language),
      },
    ],
  },
  {
    title: en ? "Get involved" : "Mitmachen",
    links: [
      { label: en ? "Donate" : "Spenden", href: donateFor(language) },
      {
        label: en ? "Write to MPs" : "Brief an Abgeordnete",
        href: `${pathFor("participate", language)}#abgeordnete`,
      },
      {
        label: en ? "Share graphics" : "Grafiken zum Teilen",
        href: shareKitFor(language),
      },
      {
        label: en ? "For organisations" : "Für Organisationen",
        href: `${pathFor("participate", language)}#organisationen`,
      },
    ],
  },
  {
    title: en ? "Stay informed" : "Dranbleiben",
    links: [
      { label: en ? "Contact" : "Kontakt", href: "mailto:kontakt@dac8.org" },
      { label: en ? "RSS feed" : "RSS-Feed", href: feedFor(language) },
      {
        label: en
          ? "Bitcoin Austria newsletter (DE)"
          : "Bitcoin-Austria-Newsletter",
        href: campaign.newsletter,
      },
      {
        label: en ? "Source code on GitHub" : "Quellcode auf GitHub",
        href: "https://github.com/bitcoinaustria/dac8.org",
      },
    ],
  },
]
---

<footer>
  <div class="sign-off" data-share-scope>
    <p class="sign-off-title">
      {en ? "Financial privacy is a fundamental right." : "Finanzielle Privatsphäre ist ein Grundrecht."}
      <span>{en ? "Let’s defend it." : "Verteidigen wir sie."}</span>
    </p>
    <div class="sign-off-body">
      <p>
        {en ? "Bitcoin Austria is preparing a complaint. Your donation pays for the proceedings." : "Bitcoin Austria bereitet eine Beschwerde vor. Mit deiner Spende bezahlen wir das Verfahren."}
      </p>
      <div class="sign-off-actions">
        <a class="button primary" href={donateFor(language)}
          >{en ? "Support the case" : "Prozess unterstützen"}</a
        >
        <button class="button" type="button" data-share>
          <ShareIcon class="share-icon" /><CheckIcon class="share-done" />
          {en ? "Share" : "Teilen"}
        </button>
      </div>
      <p class="share-status" data-share-status aria-live="polite"></p>
    </div>
  </div>

  <div class="footer-main">
    <div class="footer-lead">
      <a class="footer-brand" href={pathFor("home", language)}
        >dac8<span>.org</span></a
      >
      <p>
        {en ? "An initiative by Bitcoin Austria against financial mass surveillance. Supported by " : "Eine Initiative des Vereins Bitcoin Austria gegen finanzielle Massenüberwachung. Unterstützt von "}
        <a href={en ? "https://coinfinity.co/en" : "https://coinfinity.co/"}
          >Coinfinity</a
        >.
      </p>
      <a
        class="social-link"
        href="https://x.com/bitcoin_at"
        aria-label={en ? "Bitcoin Austria on X" : "Bitcoin Austria auf X"}
      >
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l7.4-8.5L.8 2h6.5l4.5 6.8L18.9 2Zm-1.1 18h1.7L6.4 3.9H4.6L17.8 20Z"
          />
        </svg>
      </a>
    </div>

    <nav aria-label={en ? "Further navigation" : "Weitere Navigation"}>
      {sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <ul>
            {section.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  </div>

  <div class="footer-base">
    <a
      class="association-brand"
      href="https://bitcoin-austria.at"
      aria-label="Bitcoin Austria"
    >
      <BitcoinAustriaLogo />
    </a>
    <div class="footer-meta">
      <ul
        class="legal-links"
        aria-label={en ? "Legal information" : "Rechtliches"}
      >
        <li>
          <a href={pathFor("legal", language)}
            >{en ? "Legal notice" : "Impressum"}</a
          >
        </li>
        <li>
          <a href={pathFor("privacy", language)}
            >{en ? "Privacy" : "Datenschutz"}</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Der Footer ist der Schluss der Seite: ein Satz, wofür die Spende
     gebraucht wird, Spenden und Teilen auf einer ruhigen Fläche wie die
     Bänder der Seiten. Darunter die kompakte Linkliste. */
  footer {
    max-inline-size: var(--page-max);
    margin-inline: auto;
    padding: var(--space-l) var(--grid-gutter) var(--space-l);
  }

  .sign-off {
    display: grid;
    gap: var(--space-m-l);
    padding: var(--space-l-xl) var(--space-m-l);
    border-radius: var(--radius-xl);
    background: light-dark(#f3f3f2, #1c1c1c);
  }

  .sign-off-title {
    max-inline-size: 18ch;
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.625rem);
    font-weight: 600;
    font-stretch: 94%;
    line-height: 1.04;
    letter-spacing: -0.026em;
    text-wrap: balance;

    span {
      display: block;
      color: var(--accent);
    }
  }

  .sign-off-body {
    display: grid;
    gap: var(--space-m);
    justify-items: start;

    p {
      max-inline-size: 40ch;
      margin: 0;
      color: var(--muted-foreground);
      font-size: var(--step-1);
      line-height: 1.45;
      text-wrap: pretty;
    }
  }

  .sign-off-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  /* Breit: die Aussage links, rechts auf ihrer Grundlinie der Satz und die
     beiden Knöpfe. */
  @media (width >= 64rem) {
    .sign-off {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
      column-gap: var(--space-2xl);
      padding: var(--space-xl) var(--space-l-xl);
    }
  }

  .sign-off .share-status {
    color: var(--accent);
    font-size: var(--step--1);
  }

  .sign-off .share-status:empty {
    display: none;
  }

  .footer-main {
    padding-block-start: var(--space-2xl);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) minmax(0, 2fr);
    gap: var(--space-l) var(--space-xl);
    align-items: start;

    @media (width < 72rem) {
      grid-template-columns: 1fr;
    }
  }

  .footer-lead p a {
    color: inherit;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;

    &:hover {
      color: var(--foreground);
    }
  }

  .footer-lead p {
    max-inline-size: 40ch;
    margin-block-start: var(--space-s);
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    margin-inline-start: -0.75rem;
    min-block-size: 2.75rem;
    margin-block-start: var(--space-xs);
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .social-link:hover {
    color: var(--foreground);
  }

  .social-link svg {
    inline-size: 1em;
    block-size: 1em;
    flex-shrink: 0;
  }

  .footer-brand {
    inline-size: fit-content;
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.04em;
    text-decoration: none;

    span {
      color: var(--accent);
    }
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .association-brand {
    inline-size: min(100%, 8rem);
    color: var(--muted-foreground);

    &:hover {
      color: var(--foreground);
    }

    svg {
      inline-size: 100%;
      block-size: auto;
    }
  }

  nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-l);
    align-content: start;

    ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  h2 {
    margin-block-end: var(--space-xs);
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  nav a {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-block: 0.35em;
    line-height: 1.4;
    color: var(--foreground);
    text-decoration: none;

    &:hover {
      color: var(--accent);
    }
  }

  .footer-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--step--1);

    @media (width < 40rem) {
      flex-wrap: wrap;
    }
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-m);

    a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      color: inherit;
      text-underline-offset: 0.2em;

      &:hover {
        color: var(--foreground);
      }
    }
  }
</style>
