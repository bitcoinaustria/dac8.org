---
import SourceRefs from "@/components/SourceRefs.astro"
import { ruleChronicle } from "@/data/aml-history"
import { historyAsOf, isAhead } from "@/data/history"
import { historySources } from "@/data/history-sources"
import {
  chapters,
  inTodaysMoney,
  pile,
  reportField,
  type Scene,
  steps,
  thresholds,
} from "@/data/overregulation"
import type { Language } from "@/lib/i18n"

// The story of over-regulation as a scroll film, built like the home
// page's data story: the stage stands while the steps scroll past. Each
// step is a headline of a few words and turns one picture into a contrast
// you see before you read it: the amount from which you must show ID
// falling to nothing, the rules adding up as a curve that never falls,
// six pages beside 488, a sea of reports beside a few convictions, and
// 100 coins of which one is red. Grey is what is collected, red what
// comes of it or what is new. Each step cites its sources by number from
// the list at the end of the page (src/data/history-sources.ts). Without
// the script the headlines stand as text one below the other.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const locale = en ? "en-GB" : "de-DE"
const n = (value: number) => new Intl.NumberFormat(locale).format(value)
const { cite } = historySources(language)

const index = new Map(steps.map((step, i) => [step.id, i]))
const at = (id: string) => {
  const i = index.get(id)
  if (i === undefined) throw new Error(`Film: no step "${id}"`)
  return i
}
const sceneOf = new Map(chapters.map((chapter) => [chapter.id, chapter.scene]))
const items = steps.map((step, i) => ({
  ...step,
  i,
  scene: sceneOf.get(step.chapter) as Scene,
}))
const thisYear = new Date(historyAsOf).getUTCFullYear()

// ---------- Ausweis ---------------------------------------------------------
const real = (t: (typeof thresholds)[number]) => inTodaysMoney(t.amount, t.year)
const highest = Math.max(...thresholds.map(real))
// Each bar carries its value in today's money and, small, the amount of
// its time; the last one has no bar left, only the red label.
const bars = thresholds.map((t) => ({
  year: t.year,
  at: at(t.step),
  zero: t.amount === 0,
  value:
    t.amount === 0
      ? en
        ? "From the first cent"
        : "Ab dem ersten Cent"
      : en
        ? `€${n(real(t))}`
        : `${n(real(t))} €`,
  then:
    t.amount === 0
      ? undefined
      : `${en ? "then" : "damals"} ${n(t.amount)} ${t.unit === "ECU" ? "ECU" : "€"}`,
  style: `--w: ${((real(t) / highest) * 100).toFixed(2)}%`,
}))

// ---------- Regeln ----------------------------------------------------------
const statusOf = new Map(ruleChronicle.entries.map((e) => [e.id, e.status]))
const cards = ruleChronicle.stack.flatMap((group) =>
  group.rows.map((row) => {
    const status = statusOf.get(row.id) ?? "past"
    return {
      domain: group.domain?.id ?? "steuern",
      what: row.what[language],
      from: row.from,
      until: row.until,
      status,
      ahead: isAhead(status),
    }
  }),
)
// The curve: how many rules apply in each year, drawn as steps, the year
// running with the scroll. From 2015, when a new rule came about every
// year, it turns red; after today the adopted and proposed ones follow as
// a dashed line.
const startYear = 1977
const steepYear = 2015
const endYear = 2029
const inForce = (year: number) =>
  cards.filter(
    (card) =>
      !card.ahead &&
      card.from <= year &&
      year <= (card.until ?? Number.POSITIVE_INFINITY),
  ).length
const withAhead = (year: number) =>
  inForce(year) + cards.filter((card) => card.ahead && card.from <= year).length
const maxCount = Math.max(withAhead(endYear) + 1, 22)
const X = (year: number) =>
  ((year - startYear) / (endYear + 1 - startYear)) * 1000
const Y = (count: number) => 500 - (count / maxCount) * 500
const stepPath = (
  count: (year: number) => number,
  from: number,
  to: number,
) => {
  // Start at the level of the year before, so joined pieces meet.
  const before = from > startYear ? count(from - 1) : count(from)
  let d = `M${X(from).toFixed(1)} ${Y(before).toFixed(1)}`
  for (let year = from; year <= to; year++) {
    d += ` V${Y(count(year)).toFixed(1)} H${X(year + 1).toFixed(1)}`
  }
  return d
}
const curveEarly = stepPath(inForce, startYear, steepYear - 1)
const curveSteep = stepPath(inForce, steepYear, thisYear)
const curveEarlyArea = `${curveEarly} V500 H${X(startYear)} Z`
const curveSteepArea = `${curveSteep} V500 H${X(steepYear)} Z`
const curveAhead = stepPath(withAhead, thisYear + 1, endYear)
const gridCounts = [5, 10, 15, 20]
const curveMarks = [startYear, 1994, steepYear, thisYear].map((year) => ({
  year,
  style: `--at: ${(X(year) / 10).toFixed(2)}%`,
}))
// For the script: each rule's year and name, to show the newest.
const curveRules = JSON.stringify(
  cards
    .map((card) => ({
      from: card.from,
      until: card.until,
      what: card.what,
      ahead: card.ahead,
    }))
    .sort((a, b) => a.from - b.from),
)
const curveScale = JSON.stringify({ startYear, endYear, maxCount })

// ---------- Papier ----------------------------------------------------------
const totalPages = pile.reduce((sum, block) => sum + block.pages, 0)
const firstPages = pile[0].pages
const pages = Array.from({ length: totalPages }, (_, k) => k)

// ---------- Ergebnis --------------------------------------------------------
// One grain per report on a canvas (src/lib/film-sand.ts): which state
// belongs to which step.
const { first, latest, convictions } = reportField
const sandStates = JSON.stringify({
  [at("ergebnis-2005")]: "first",
  [at("ergebnis-2025")]: "all",
  [at("ergebnis-urteile")]: "heap",
})
const fieldSteps = ["ergebnis-2005", "ergebnis-2025", "ergebnis-urteile"]
  .map(at)
  .join(",")
// 100 one-euro coins fall past a line: 99 stack up below in five towers,
// the last one coin short; one stays on the line and turns red. Positions
// in percent of the square, coins seen from the side.
const coinSteps = String(at("ergebnis-euro"))
const seeded = (seed: number) => () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296
  return seed / 4294967296
}
const jitter = seeded(2016)
const towerX = (k: number) => 18 + k * 16
const stacked = Array.from({ length: 5 }, (_, k) => k).flatMap((tower) =>
  Array.from({ length: tower === 4 ? 19 : 20 }, (_, level) => ({
    x: towerX(tower),
    y: 95 - level * 1.62,
    // Level by level, the towers in shuffled order, so they grow evenly.
    delay: level * 0.085 + jitter() * 0.12,
  })),
)
const coins = [
  ...stacked.map((coin) => ({ ...coin, caught: false })),
  { x: 50, y: 38, delay: 0.8, caught: true },
].map((coin) => ({
  caught: coin.caught,
  style: `--x: ${coin.x.toFixed(2)}; --y: ${coin.y.toFixed(2)}; --d: ${coin.delay.toFixed(2)}s`,
}))
---

<section
  class="film"
  aria-labelledby="film-title"
  data-film
  data-today={thisYear}
  data-scenes={JSON.stringify(items.map((item) => item.scene))}
  data-ids={JSON.stringify(items.map((item) => item.id))}
  data-years={JSON.stringify(items.map((item) => item.years ?? null))}
>
  <h2 id="film-title" class="visually-hidden">
    {en ? "The story of over-regulation" : "Die Geschichte der Überregulierung"}
  </h2>

  <div class="track" aria-hidden="true">
    {items.map((item) => (
      <div class="spacer" id={`film-${item.id}`} data-spacer={item.i} />
    ))}
  </div>

  <div class="stage">
    <div class="view" data-view data-scene={items[0].scene}>
      <div class="says">
        {items.map((item) => (
          <div
            class="say"
            data-say={item.i}
            data-current={item.i === 0 ? "" : undefined}
          >
            <h3>{item.title[language]}</h3>
            <p class="say-text">
              {item.text?.[language]}
              <SourceRefs sources={cite(item.sources)} language={language} />
            </p>
          </div>
        ))}
      </div>

      <div class="scenes" aria-hidden="true">
        <!-- Ausweis -->
        <div class="scene" data-scene-id="threshold">
          <ul class="steps">
            {bars.map((bar) => (
              <li class:list={{ zero: bar.zero }} data-at={bar.at} style={bar.style}>
                <span class="steps-year">{bar.year}</span>
                <span class="steps-track"><span class="steps-bar" /></span>
                <span class="steps-value">
                  <b>{bar.value}</b>
                  {bar.then && <span>{bar.then}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Regeln -->
        <div class="scene" data-scene-id="rules">
          <div class="curve" data-curve={curveScale} data-rules={curveRules}>
            <div class="curve-plot">
              {gridCounts.map((count) => (
                <span
                  class="curve-grid"
                  style={`--y: ${((count / maxCount) * 100).toFixed(2)}%`}
                >
                  <span>{count}</span>
                </span>
              ))}
              <span class="curve-unit">{en ? "rules" : "Regeln"}</span>
              <div class="curve-reveal">
                <svg viewBox="0 0 1000 500" preserveAspectRatio="none">
                  <path class="curve-area" d={curveEarlyArea} />
                  <path class="curve-area steep" d={curveSteepArea} />
                  <path class="curve-line" d={curveEarly} />
                  <path class="curve-line steep" d={curveSteep} />
                  <path class="curve-ahead" d={curveAhead} />
                </svg>
              </div>
              <span class="curve-head" data-curve-head>
                <span class="curve-new" data-curve-new />
              </span>
            </div>
            <div class="curve-axis">
              {curveMarks.map((mark) => (
                <span style={mark.style}>{mark.year}</span>
              ))}
              <strong class="curve-now" data-year
                >{steps[at("regeln-1977")].years?.[0]}</strong
              >
            </div>
          </div>
        </div>

        <!-- Papier: one tile per page, the first six red -->
        <div class="scene" data-scene-id="tower">
          <div class="wall-wrap" data-wall>
            <div class="wall" data-at={at("papier-heute")}>
              {pages.map((k) => (
                <span class:list={["page", { first: k < firstPages }]} style={`--k: ${k}`} />
              ))}
            </div>
          </div>
          <p class="scene-caption">
            {en
              ? "One square per page in the EU Official Journal; red, the first directive of 1991."
              : "Ein Kästchen je Seite im Amtsblatt der EU, rot die erste Richtlinie von 1991."}
          </p>
        </div>

        <!-- Ergebnis -->
        <div class="scene" data-scene-id="result">
          <div class="result">
            <div
              class="sand"
              data-sand={sandStates}
              data-sand-counts={JSON.stringify({ first, latest, convictions })}
              data-only={fieldSteps}
            >
              <canvas />
              <i data-sand-grey />
              <i data-sand-red />
              <span class="sand-label" data-sand-label="reports">
                <b>{n(latest)}</b>
                {en ? "reports" : "Meldungen"}
              </span>
              <span class="sand-label red" data-sand-label="convictions">
                <b>{n(convictions)}</b>
                {en ? "convictions" : "Verurteilungen"}
              </span>
            </div>
            <div class="net" data-only={coinSteps}>
              <svg
                class="net-line"
                viewBox="0 0 100 10"
                preserveAspectRatio="none"
              >
                <path d="M0 2 Q50 7 100 2" />
              </svg>
              {coins.map((coin) => (
                <span class:list={["coin", { caught: coin.caught }]} style={coin.style} />
              ))}
              <span class="net-label caught">
                <b>{en ? "€1" : "1 €"}</b>
                {en ? "confiscated" : "eingezogen"}
              </span>
              <span class="net-label gone">
                <b>{en ? "€99" : "99 €"}</b>
                {en ? "not confiscated" : "nicht eingezogen"}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createSand, type SandState } from "@/lib/film-sand"

  // The step whose spacer has crossed the middle of the window is current:
  // it picks the scene and the headline and switches on what has appeared
  // so far ([data-at]) or only now ([data-only]). In the rules chapter the
  // year runs with the scroll and the curve is drawn up to it.
  for (const film of document.querySelectorAll<HTMLElement>("[data-film]")) {
    const view = film.querySelector<HTMLElement>("[data-view]")
    if (!view) continue
    const all = (selector: string) => [
      ...film.querySelectorAll<HTMLElement>(selector),
    ]
    const spacers = all("[data-spacer]")
    const says = all("[data-say]")
    const ats = [...film.querySelectorAll<Element>("[data-at]")]
    const onlys = all("[data-only]")
    const curve = film.querySelector<HTMLElement>("[data-curve]")
    const head = film.querySelector<HTMLElement>("[data-curve-head]")
    const newest = film.querySelector<HTMLElement>("[data-curve-new]")
    const scale = JSON.parse(curve?.dataset.curve ?? "{}")
    const rules: {
      from: number
      until?: number
      what: string
      ahead: boolean
    }[] = JSON.parse(curve?.dataset.rules ?? "[]")
    const yearEl = film.querySelector<HTMLElement>("[data-year]")
    const parse = (key: string) => JSON.parse(film.dataset[key] ?? "[]")
    const stepScenes: string[] = parse("scenes")
    const stepIds: string[] = parse("ids")
    const stepYears: ([number, number] | null)[] = parse("years")
    const today = Number(film.dataset.today)
    // The rules chapter: the year runs with the scroll, the curve is drawn
    // up to it, and the newest rule so far stands at its head.
    let shownYear = 0
    const scrub = (year: number) => {
      if (year === shownYear) return
      shownYear = year
      if (yearEl) {
        yearEl.textContent = String(year)
        yearEl.classList.toggle("future", year > today)
      }
      const live = rules.filter((rule) => rule.from <= year)
      const count = live.filter(
        (rule) =>
          !rule.ahead && year <= (rule.until ?? Number.POSITIVE_INFINITY),
      ).length
      const ahead = live.filter((rule) => rule.ahead).length
      if (curve && head) {
        const span = scale.endYear + 1 - scale.startYear
        const p = (year + 1 - scale.startYear) / span
        curve.style.setProperty("--p", String(p))
        const c = (count + ahead) / scale.maxCount
        head.style.setProperty("--c", String(c))
        head.classList.toggle("right", p > 0.6)
        head.classList.toggle("high", c > 0.6)
      }
      const last = live.at(-1)
      if (newest) {
        newest.textContent = last ? `${last.from} · ${last.what}` : ""
        newest.classList.toggle("ahead", Boolean(last?.ahead))
      }
    }

    // The result chapter's grains, one per report.
    const sandRoot = film.querySelector<HTMLElement>("[data-sand]")
    const sandStates: Record<string, SandState> = JSON.parse(
      sandRoot?.dataset.sand ?? "{}",
    )
    const sand = sandRoot
      ? createSand(sandRoot, JSON.parse(sandRoot.dataset.sandCounts ?? "{}"))
      : null

    let current = -1
    const show = (i: number) => {
      const previous = current
      current = i
      const sandState = sandStates[i]
      if (sandState) sand?.go(sandState, previous in sandStates)
      else sand?.hide()
      view.dataset.scene = stepScenes[i]
      view.dataset.stepId = stepIds[i]
      for (const say of says)
        say.toggleAttribute("data-current", Number(say.dataset.say) === i)
      for (const el of ats)
        el.classList.toggle(
          "on",
          Number(
            (el as HTMLElement).dataset?.at ?? el.getAttribute("data-at"),
          ) <= i,
        )
      for (const el of onlys)
        el.classList.toggle(
          "on",
          (el.dataset.only ?? "").split(",").map(Number).includes(i),
        )
    }

    // The wall of pages: the column count at which all tiles are largest.
    const wallWrap = film.querySelector<HTMLElement>("[data-wall]")
    const wall = wallWrap?.firstElementChild as HTMLElement | null
    const fit = () => {
      if (!wallWrap || !wall) return
      const count = wall.children.length
      const { width, height } = wallWrap.getBoundingClientRect()
      if (!width || !height) return
      const gap = 2
      let best = { cols: 1, tile: 0 }
      for (let cols = 6; cols <= 60; cols++) {
        const rows = Math.ceil(count / cols)
        const tile = Math.min(
          (width - gap * (cols - 1)) / cols,
          ((height - gap * (rows - 1)) / rows) * (5 / 6),
        )
        if (tile > best.tile) best = { cols, tile }
      }
      wall.style.setProperty("--cols", String(best.cols))
      wall.style.setProperty("--tile", `${Math.floor(best.tile * 10) / 10}px`)
    }

    let queued = false
    const render = () => {
      queued = false
      const middle = window.innerHeight * 0.55
      let i = 0
      spacers.forEach((spacer, k) => {
        if (spacer.getBoundingClientRect().top <= middle) i = k
      })
      if (i !== current) show(i)
      const span = stepYears[i]
      if (span) {
        const box = spacers[i].getBoundingClientRect()
        // The span is run through by four fifths of the step.
        const p = Math.min(
          1,
          Math.max(0, (middle - box.top) / (box.height * 0.8)),
        )
        scrub(Math.round(span[0] + (span[1] - span[0]) * p))
      } else {
        const last = stepYears.slice(0, i).filter(Boolean).at(-1)
        if (last) scrub(last[1])
      }
      const box = film.getBoundingClientRect()
      document.documentElement.toggleAttribute(
        "data-immersive",
        box.top <= window.innerHeight * 0.2 && box.bottom >= window.innerHeight,
      )
    }
    const queue = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(render)
    }
    window.addEventListener("scroll", queue, { passive: true })
    window.addEventListener("resize", () => {
      fit()
      queue()
    })
    if (wallWrap) new ResizeObserver(fit).observe(wallWrap)
    film.toggleAttribute("data-ready", true)
    render()
  }
</script>

<style>
  /* Wie die Datengeschichte der Startseite: die Bühne füllt das Fenster und
     steht, während die Schritte vorbeiziehen. */
  .film {
    --pace: min(1svh, 0.76rem);
    --bar: light-dark(#3b4147, #a7afb6);
    --red: var(--primary);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .track,
  .stage {
    grid-area: 1 / 1;
  }

  .track {
    padding-block: calc(50svh - var(--header-height) / 2 - 40 * var(--pace))
      calc(20 * var(--pace));
  }

  .spacer {
    block-size: calc(80 * var(--pace));
    scroll-margin-block-start: calc(var(--header-height) - 30 * var(--pace));
  }

  .stage {
    position: sticky;
    inset-block-start: var(--header-height);
    align-self: start;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    block-size: calc(100dvh - var(--header-height));
    padding-block: var(--space-xs) var(--space-s);
  }

  /* Ohne Skript stehen die Schlagzeilen untereinander. */
  .film:not([data-ready]) :is(.track, .scenes) {
    display: none;
  }

  .film:not([data-ready]) .stage {
    position: static;
    block-size: auto;
  }

  .film:not([data-ready]) .says {
    gap: var(--space-l);
  }

  .film:not([data-ready]) .say {
    grid-area: auto;
  }

  /* ---------- Bühne ----------------------------------------------------- */

  /* Schmal: das Bild oben, die Schlagzeile in einer Leiste darunter.
     Breit: links die Schlagzeile, rechts das Bild. */
  .view {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    min-block-size: 0;
    border-radius: var(--radius-xl);
    background: var(--panel);
    overflow: clip;
  }

  .scenes {
    position: relative;
    grid-row: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    min-block-size: 0;
    container-type: size;
  }

  .says {
    grid-row: 2;
    display: grid;
    align-content: start;
    min-block-size: clamp(7.5rem, 22svh, 9.5rem);
    padding: var(--space-s) var(--space-m) var(--space-m);
    border-block-start: 1px solid var(--line);
    background: var(--paper);
  }

  @container campaign (width >= 60rem) {
    .view {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: minmax(0, 1fr);
    }

    .scenes {
      grid-column: 2;
      grid-row: 1;
    }

    .says {
      grid-column: 1;
      grid-row: 1;
      align-content: center;
      min-block-size: 0;
      padding: var(--space-xl);
      border: 0;
      background: none;
    }
  }

  .say {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    transition:
      opacity 0.35s ease,
      translate 0.35s ease;
  }

  .film[data-ready] .say:not([data-current]) {
    visibility: hidden;
    opacity: 0;
    translate: 0 0.75rem;
  }

  /* Die Aussage: groß, aber so, dass lange Wörter wie
     „Verdachtsmeldungen“ in die Spalte passen oder an der Silbe trennen
     statt mitten im Wort zu brechen. */
  .say h3 {
    max-inline-size: 18ch;
    color: var(--foreground);
    font-size: clamp(1.5rem, 0.9rem + 1.7vw, 2.5rem);
    font-stretch: 94%;
    font-weight: var(--weight-heading);
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
    overflow-wrap: normal;
    hyphens: auto;
  }

  .say-text {
    max-inline-size: 40ch;
    color: var(--ink-2);
    font-size: var(--type-lead);
    line-height: 1.35;
    text-wrap: pretty;
    overflow-wrap: normal;
  }

  /* ---------- Szenen ---------------------------------------------------- */

  .scene {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-s);
    min-block-size: 0;
    padding: var(--space-m);
    opacity: 0;
    visibility: hidden;
    scale: 0.97;
    transition:
      opacity 0.5s ease,
      scale 0.5s ease,
      visibility 0.5s;
  }

  .view[data-scene="threshold"] [data-scene-id="threshold"],
  .view[data-scene="rules"] [data-scene-id="rules"],
  .view[data-scene="tower"] [data-scene-id="tower"],
  .view[data-scene="result"] [data-scene-id="result"] {
    opacity: 1;
    visibility: visible;
    scale: 1;
  }

  /* Die Szenen zeigen ihre Zahl im Bild, nicht als zweite Überschrift:
     links steht die Aussage, rechts der Beleg. */
  .scene-caption {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  /* ---------- Ausweis --------------------------------------------------- */

  .steps {
    display: grid;
