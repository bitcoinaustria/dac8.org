---
import SourceRefs from "@/components/SourceRefs.astro"
import { ruleChronicle } from "@/data/aml-history"
import { historyAsOf } from "@/data/history"
import { recovery } from "@/data/history-gap"
import { statusLabel } from "@/data/history-next"
import { historySources } from "@/data/history-sources"
import { firstVoice, lawVoices } from "@/data/law-voices"
import {
  chapters,
  goldShown,
  inGold,
  inTodaysMoney,
  leakCount,
  pallets,
  pile,
  reportField,
  type Shot,
  sourcesOf,
  steps,
  thresholds,
} from "@/data/overregulation"
import panopticon from "@/assets/history/panopticon.json"
import panBase from "@/assets/history/panopticon-base.webp"
import panBaseLate from "@/assets/history/panopticon-base-late.webp"
import panProposal from "@/assets/history/panopticon-proposal.webp"
import wideLinks from "@/assets/history/world-wide-links.webp"
import wideTags from "@/assets/history/world-wide-tags.webp"
import type { Language } from "@/lib/i18n"

// The story of over-regulation as a scroll film in one rendered world, a
// panopticon at night (scripts/artwork/render-panopticon.py): the stage
// stands while the steps scroll past. Each step is a headline of a few
// words and one still. It starts at a table in one cell, with the amount
// from which cash needs ID in notes and in gold, and a cent for crypto;
// rises over the ring, where the year runs with the scroll and a
// searchlight comes on for every way money takes once a rule applies, and
// a window in the watchtower for every authority let into the account
// register; goes back into the cell, whose walls fill with one sheet per
// page of law, and over the yard, where one slip per suspicion report
// rains down; then to what is decided next, the EU's 27 registers, the
// view from the cell, a breach in the tower, a notice on the table,
// pallets of notes in the yard and the loudspeakers on the tower. Where a
// step has a clip (public/film/), the camera's way to its still plays
// once when the step comes up by scrolling forward; otherwise, and for
// readers who prefer reduced motion or save data, the stills fade into
// each other. Each step cites its sources by number from the list at the
// end of the page (src/data/history-sources.ts). Without the script the
// headlines stand as text one below the other.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const locale = en ? "en-GB" : "de-DE"
const n = (value: number) => new Intl.NumberFormat(locale).format(value)
const euro = (value: number) => (en ? `€${n(value)}` : `${n(value)} €`)
const { cite } = historySources(language)

const index = new Map(steps.map((step, i) => [step.id, i]))
const at = (id: string) => {
  const i = index.get(id)
  if (i === undefined) throw new Error(`Film: no step "${id}"`)
  return i
}
const chapterOf = new Map(chapters.map((chapter) => [chapter.id, chapter]))
const items = steps.map((step, i) => ({
  ...step,
  i,
  chapterLabel: chapterOf.get(step.chapter)?.label[language] ?? "",
}))
const thisYear = new Date(historyAsOf).getUTCFullYear()

// ---------- Regeln ----------------------------------------------------------
// The ways money can take, and the rules set on them year by year: checks
// at the bank or provider (ID, monitoring, a cap) and automatic reports to
// the tax office. Each is a row of the chronicle; the rules about companies
// and advisers stay out, they are in the list to check. The year runs with
// the scroll; a way is lit once a rule on it applies.
const rowsById = new Map(
  ruleChronicle.stack.flatMap((group) =>
    group.rows.map((row) => [row.id, { row }]),
  ),
)
const panLights = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/history/panopticon-light-*.webp",
  { eager: true },
)
const wayList: {
  id: string
  label: { de: string; en: string }
  rows: string[]
}[] = [
  {
    id: "konto",
    label: { de: "Konto", en: "Bank account" },
    rows: [
      "ausweis",
      "verdacht",
      "sorgfalt",
      "kontenregister",
      "dac5",
      "register-eu",
    ],
  },
  {
    id: "depot",
    label: { de: "Wertpapiere", en: "Securities" },
    rows: ["depot"],
  },
  {
    id: "sparbuch",
    label: { de: "Sparbuch", en: "Savings book" },
    rows: ["sparbuch"],
  },
  {
    id: "ausland",
    label: { de: "Konto im Ausland", en: "Account abroad" },
    rows: ["zinsrichtlinie", "dac2"],
  },
  {
    id: "einkommen",
    label: { de: "Einkommen im Ausland", en: "Income abroad" },
    rows: ["dac1", "neufassung"],
  },
  {
    id: "plattform",
    label: { de: "Online-Plattformen", en: "Online platforms" },
    rows: ["dac7"],
  },
  {
    id: "krypto",
    label: { de: "Krypto", en: "Crypto" },
    rows: ["krypto-anbieter", "uebertragung", "dac8", "anonym-2027"],
  },
  {
    id: "bargeld",
    label: { de: "Bargeld", en: "Cash" },
    rows: ["bargeld-2027"],
  },
]
// The panopticon rendered in Blender (scripts/artwork/render-panopticon.py):
// a base picture at night and, per cell, a light pass with the searchlight
// from the tower, added by screen blending once a rule on that way
// applies. The render also gives, in percent of the picture, where each
// cell's label stands.
const ways = wayList.map((way, k) => {
  const cell = panopticon.cells[k]
  const light = panLights[`../assets/history/panopticon-light-${k}.webp`]
  if (!cell || !light) throw new Error(`Film: no render for cell ${k}`)
  const rules = way.rows.map((id) => {
    const found = rowsById.get(id)
    if (!found) throw new Error(`Film: no rule "${id}"`)
    return found.row
  })
  // Behind the tower the label stands above its point, in front below.
  const behind = cell.label[1] < panopticon.centre[1]
  return {
    ...way,
    label: way.label[language],
    light: light.default.src,
    // The crypto cell's light once more, with the pages on its walls.
    lateLight:
      panLights[`../assets/history/panopticon-light-${k}-late.webp`]?.default
        .src,
    rules,
    style: [
      `--x: ${cell.label[0]}%`,
      `--y: ${cell.label[1]}%`,
      `--dy: ${behind ? "-100%" : "0%"}`,
    ].join("; "),
  }
})
// For the script: every rule with its way, to light the ways by year.
const wayRules = JSON.stringify(
  ways.flatMap((way) =>
    way.rules.map((row) => ({ way: way.id, from: row.from, until: row.until })),
  ),
)

// ---------- Zugriff ---------------------------------------------------------
// Who may look into the account register: the same panopticon and the same
// running year, and in its watchtower one lit window per kind of authority
// (render-panopticon.py, "watch" passes), switched on from the year it was
// admitted. The names stay here, in the order of the windows.
const watchLights = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/history/panopticon-watch-*.webp",
  { eager: true },
)
const watchers: {
  from: number
  who: { de: string; en: string }
}[] = [
  {
    from: 2016,
    who: { de: "Staatsanwaltschaften", en: "prosecutors" },
  },
  { from: 2016, who: { de: "Strafgerichte", en: "criminal courts" } },
  { from: 2016, who: { de: "Abgabenbehörden", en: "tax authorities" } },
  {
    from: 2021,
    who: { de: "Geldwäschemeldestelle", en: "financial intelligence unit" },
  },
  { from: 2021, who: { de: "Staatsschutz", en: "state security" } },
  {
    from: 2021,
    who: { de: "Finanzmarktaufsicht", en: "financial market authority" },
  },
  {
    from: 2021,
    who: { de: "Bundeskriminalamt", en: "federal criminal police" },
  },
  {
    from: 2021,
    who: { de: "Sanktionsbehörden", en: "sanctions authorities" },
  },
  {
    from: 2026,
    who: { de: "Amt für Betrugsbekämpfung", en: "anti-fraud office" },
  },
]
const watch = watchers.map((watcher, k) => ({
  from: watcher.from,
  who: watcher.who[language],
  light:
    watchLights[`../assets/history/panopticon-watch-${k}.webp`]?.default.src,
}))

// ---------- Papier ----------------------------------------------------------
// Read aloud on request (src/data/law-voices.ts): the 1991 passage alone,
// then today's passages one after another until they overlap.
const voices = JSON.stringify(
  lawVoices.map((voice) => ({
    id: voice.id,
    first: voice.id === firstVoice,
    ref: voice.ref[language],
    text: voice.text[language],
    src: `/audio/law/${voice.id}-${language}.mp3`,
  })),
)

// ---------- Die Standbilder --------------------------------------------------
// Every step outside the overview shows a still.
const stillFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/history/world-*.webp",
  { eager: true },
)
const stillOf = (shot: Shot) => {
  const localised = shot === "letter" ? `letter-${language}` : shot
  const file = stillFiles[`../assets/history/world-${localised}.webp`]
  if (!file) throw new Error(`Film: no still "${localised}"`)
  return file.default.src
}
const shots = [...new Set(items.flatMap((item) => item.shot ?? []))].map(
  (shot) => ({ id: shot, src: stillOf(shot) }),
)
const clips = [...new Set(items.flatMap((item) => item.clip ?? []))]

// The pictures show fixed numbers of notes, coins, pages, slips, sheets
// and pallets; once the data move away from them, they need rendering
// again with the counts at the top of the render script.
const [then, now] = thresholds.filter((t) => t.amount > 0)
const { latest, kept: keptReports, convictions } = reportField
const totalPages = pile.reduce((sum, block) => sum + block.pages, 0)
const kept = recovery.latest.percent
const shown = {
  notes: [inTodaysMoney(then.amount, then.year) / 100, now.amount / 100],
  ounces: [inGold(then.amount, then.year), inGold(now.amount, now.year)],
  pages: [pile[0].pages, totalPages],
  reports: [latest, keptReports, convictions],
  state: kept,
  leaks: [leakCount.all, leakCount.authority],
  pallets: [pallets.cost, pallets.measured, pallets.modelled],
}
const baked = {
  notes: [339, 100],
  ounces: [goldShown[then.year], goldShown[now.year]],
  pages: [6, 488],
  reports: [13989, 9665, 139],
  state: 2,
  leaks: [38, 20],
  pallets: [12.5, 12, 56],
}
// The coins are drawn for a fixed weight; a tenth of drift in the gold
// price is allowed before they need rendering again.
const drift = shown.ounces.some(
  (value, k) => Math.abs(value / baked.ounces[k] - 1) > 0.1,
)
if (
  drift ||
  JSON.stringify({ ...shown, ounces: 0 }) !==
    JSON.stringify({ ...baked, ounces: 0 })
) {
  throw new Error(
    `Film: the pictures show ${JSON.stringify(baked)}, the data give ${JSON.stringify(shown)}; set the counts in render-panopticon.py and render again`,
  )
}

// Under the picture, a legend says what its parts are: a figure, what it
// counts, and the colour it has in the picture. Nothing is written on the
// picture itself; the two years stand on cards on the table.
type Key = {
  step: number
  id: string
  label?: string
  value?: string
  text?: string
}
const cashKeys = (step: string, gold: boolean): Key[] =>
  [then, now].map((t, k) => ({
    step: at(step),
    id: k === 0 ? "then" : "now",
    label: String(t.year),
    value: gold
      ? `${n(inGold(t.amount, t.year))} ${en ? "oz" : "Unzen"}`
      : euro(inTodaysMoney(t.amount, t.year)),
    text: gold
      ? undefined
      : t.year >= thisYear
        ? en
          ? "in cash from €3,000"
          : "bar schon ab 3.000 €"
        : `${en ? "then" : "damals"} ${n(t.amount)} ${t.unit === "ECU" ? "ECU" : "€"}`,
  }))
const keys: Key[] = [
  ...cashKeys("ausweis-bar", false),
  ...cashKeys("ausweis-gold", true),
  {
    step: at("ergebnis-liegen"),
    id: "kept",
    value: n(keptReports),
    text: en ? "not passed on, kept" : "nicht weitergegeben, gespeichert",
  },
  {
    step: at("ergebnis-liegen"),
    id: "passed",
    value: n(latest - keptReports),
    text: en ? "passed on" : "weitergegeben",
  },
  {
    step: at("ergebnis-urteile"),
    id: "all",
    value: n(latest),
    text: en ? "reports" : "Meldungen",
  },
  {
    step: at("ergebnis-urteile"),
    id: "convictions",
    value: n(convictions),
    text: en ? "convictions" : "Verurteilungen",
  },
  {
    step: at("ergebnis-euro"),
    id: "state",
    value: euro(kept),
    text: en ? "taken by the state" : "zieht der Staat ein",
  },
  {
    step: at("ergebnis-euro"),
    id: "rest",
    value: euro(100 - kept),
    text: en ? "stay with criminals" : "bleiben bei Kriminellen",
  },
  ...items.flatMap((item) =>
    (item.marks ?? []).map((mark) => ({
      step: item.i,
      id: mark.id,
      // What was promised and what is on record say which is which.
      label:
        mark.id === "promise"
          ? en
            ? "Promised"
            : "Versprochen"
          : mark.id === "record"
            ? en
              ? "Measured"
              : "Gemessen"
            : undefined,
      text: mark.text[language],
    })),
  ),
]
const legends = items.flatMap((item) => {
  const own = keys.filter((key) => key.step === item.i)
  return own.length || item.caption
    ? [{ step: item.i, keys: own, note: item.caption?.[language] }]
    : []
})
const stepsOf = (shot: Shot) =>
  items
    .filter((item) => item.shot === shot)
    .map((item) => item.i)
    .join(",")
const tagStep = String(at("weiter-zahlungen"))
---

<section
  class="film"
  aria-labelledby="film-title"
  data-film
  data-today={thisYear}
  data-ids={JSON.stringify(items.map((item) => item.id))}
  data-years={JSON.stringify(items.map((item) => item.years ?? null))}
  data-chapters={JSON.stringify(items.map((item) => item.chapter))}
  data-chapter-labels={JSON.stringify(items.map((item) => item.chapterLabel))}
  data-shots={JSON.stringify(items.map((item) => item.shot ?? null))}
  data-clips={JSON.stringify(items.map((item) => item.clip ?? null))}
  data-late={JSON.stringify(items.map((item) => Boolean(item.late)))}
  data-voices={voices}
>
  <h2 id="film-title" class="visually-hidden">
    {en ? "The story of over-regulation" : "Die Geschichte der Überregulierung"}
  </h2>

  <div class="track" aria-hidden="true">
    {items.map((item) => (
      <div class="spacer" id={`film-${item.id}`} data-spacer={item.i} />
    ))}
  </div>

  <div class="stage">
    <div class="view" data-view>
      <div class="says">
        {items.map((item) => (
          <div
            class="say"
            data-say={item.i}
            data-current={item.i === 0 ? "" : undefined}
          >
            {item.when && item.status && (
              <p class="say-when">
                <b>{item.when[language]}</b>
                <span class:list={["say-status", item.status]}>
                  {statusLabel[item.status][language]}
                </span>
              </p>
            )}
            <h3>{item.title[language]}</h3>
            <p class="say-text">
              {item.text?.[language]}
              <SourceRefs sources={cite(sourcesOf(item, language))} language={language} />
            </p>
          </div>
        ))}
        <!-- Back and forth by click as well as by scroll. -->
        <nav
          class="film-nav"
          aria-label={en ? "Steps of the story" : "Schritte der Geschichte"}
        >
          <button
            type="button"
            data-film-prev
            aria-label={en ? "Previous step" : "Vorheriger Schritt"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <span class="film-count" aria-live="polite">
            <span class="film-chapter" data-film-chapter
              >{items[0].chapterLabel}</span
            >
            <b data-film-at>1</b>
            / {items.length}
          </span>
          <button
            type="button"
            data-film-next
            aria-label={en ? "Next step" : "Nächster Schritt"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </nav>
      </div>

      <!-- One loudspeaker, shown in the paper chapter: the law read aloud. -->
      <button
        type="button"
        class="film-voice"
        data-film-voice
        aria-pressed="false"
        aria-label={en ? "Read the law aloud" : "Gesetz vorlesen lassen"}
        title={en ? "Read the law aloud" : "Gesetz vorlesen lassen"}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9h4l5-4v14l-5-4H4z" />
          <path
            class="wave"
            d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"
          />
        </svg>
      </button>

      <div class="picture" aria-hidden="true">
        <div class="picture-box">
        <div class="ways" data-ways={wayRules}>
          <!-- Everything rendered, its edges fading into the night around it. -->
          <div class="frame">
            <img
              class="ways-base"
              src={panBase.src}
              width={panBase.width}
              height={panBase.height}
              alt=""
              decoding="async"
            >
            <img
              class="ways-base late"
              data-src={panBaseLate.src}
              alt=""
              decoding="async"
            >
            {ways.map((way) => (
              <>
                <img class:list={["way-light", { early: way.lateLight }]} data-way={way.id} src={way.light} alt="" decoding="async" />
                {way.lateLight && (
                  <img class="way-light late" data-way={way.id} data-src={way.lateLight} alt="" decoding="async" />
                )}
              </>
            ))}
            {watch.map((post) =>
              post.light ? (
                <img class="watch-light" data-from={post.from} src={post.light} alt="" decoding="async" />
              ) : null,
            )}
            <img
              class="watch-light proposed"
              data-from="2028"
              data-src={panProposal.src}
              alt=""
              decoding="async"
            >
            {shots.map((shot, k) => (
              <img
                class:list={["shot", { on: k === 0 && items[0].shot === shot.id }]}
                data-shot={shot.id}
                src={k === 0 ? shot.src : undefined}
                data-src={shot.src}
                alt=""
                decoding="async"
              />
            ))}
            <img
              class="shot-pass"
              data-only={stepsOf("wide")}
              data-src={wideLinks.src}
              alt=""
              decoding="async"
            >
            <img
              class="shot-pass"
              data-only={tagStep}
              data-src={wideTags.src}
              alt=""
              decoding="async"
            >
            {clips.map((clip) => (
              <video class="clip" data-clip={clip} data-src={`/film/${clip}.mp4`} muted playsinline preload="none" />
            ))}
          </div>
          {ways.map((way) => (
            <span class="way-label" data-way-label={way.id} style={way.style}>
              {way.label}
            </span>
          ))}
          <p class="ways-centre">
            <strong data-year>{steps[at("regeln")].years?.[0]}</strong>
          </p>
          <p class="wall-voice" data-voice-caption>
            <small data-voice-ref />
            <span data-voice-text />
          </p>
        </div>
        </div>
        <div class="legends">
          {legends.map((legend) => (
            <p class="legend" data-only={String(legend.step)}>
              {legend.keys.map((key) => (
                <span class:list={["key", `key-${key.id}`]}>
                  <i />
                  {key.label && <small>{key.label}</small>}
                  {key.value && <b>{key.value}</b>}
                  {key.text && <span>{key.text}</span>}
                </span>
              ))}
              {legend.note && <span class="legend-note">{legend.note}</span>}
            </p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The step whose spacer has crossed the middle of the window is current:
  // it picks the headline and the still and switches on what belongs to it
  // ([data-only]). Where the step has a clip and was reached by scrolling
  // forward, the clip plays once and ends in the still. In the overview
  // the year runs with the scroll and lights the ways its rules reach.
  for (const film of document.querySelectorAll<HTMLElement>("[data-film]")) {
    const view = film.querySelector<HTMLElement>("[data-view]")
    const box = film.querySelector<HTMLElement>(".ways")
    if (!view || !box) continue
    const all = <T extends HTMLElement = HTMLElement>(selector: string) => [
      ...film.querySelectorAll<T>(selector),
    ]
    const spacers = all("[data-spacer]")
    const prev = film.querySelector<HTMLButtonElement>("[data-film-prev]")
    const next = film.querySelector<HTMLButtonElement>("[data-film-next]")
    const stepAt = film.querySelector<HTMLElement>("[data-film-at]")
    const says = all("[data-say]")
    const onlys = all("[data-only]")
    const rules: { way: string; from: number; until?: number }[] = JSON.parse(
      box.dataset.ways ?? "[]",
    )
    const wayEls = all("[data-way]")
    const wayLabels = all("[data-way-label]")
    const yearEl = film.querySelector<HTMLElement>("[data-year]")
    const watchEls = all("[data-from]")
    const parse = (key: string) => JSON.parse(film.dataset[key] ?? "[]")
    const stepIds: string[] = parse("ids")
    const stepYears: ([number, number] | null)[] = parse("years")
    const stepChapters: string[] = parse("chapters")
    const chapterLabels: string[] = parse("chapterLabels")
    const stepShots: (string | null)[] = parse("shots")
    const stepClips: (string | null)[] = parse("clips")
    const stepLate: boolean[] = parse("late")
    const chapterAt = film.querySelector<HTMLElement>("[data-film-chapter]")
    const today = Number(film.dataset.today)
    const reduce = matchMedia("(prefers-reduced-motion: reduce)")
    const saving = () =>
      (navigator as Navigator & { connection?: { saveData?: boolean } })
        .connection?.saveData
    const stills = all<HTMLImageElement>("[data-shot]")
    const videos = new Map(
      all<HTMLVideoElement>("[data-clip]").map((video) => [
        video.dataset.clip ?? "",
        video,
      ]),
    )

    // Pictures and clips load a few steps ahead of where the reader is.
    const fetched = new Set<Element>()
    const fetch = (el: HTMLImageElement | HTMLVideoElement | undefined) => {
      if (!el || fetched.has(el) || !el.dataset.src) return
      fetched.add(el)
      el.src = el.dataset.src
      if (el instanceof HTMLVideoElement) {
        el.preload = "auto"
        el.load()
      }
    }
    const near = (i: number) => {
      const ahead = [i - 1, i, i + 1, i + 2]
      for (const j of ahead) {
        const shot = stepShots[j]
        fetch(stills.find((still) => still.dataset.shot === shot))
        if (stepLate[j] || (j >= 0 && j < stepIds.length && !shot))
          for (const image of all<HTMLImageElement>(".frame > img[data-src]"))
            if (!image.dataset.shot && !image.dataset.only) fetch(image)
        for (const pass of all<HTMLImageElement>(".shot-pass"))
          if ((pass.dataset.only ?? "").split(",").map(Number).includes(j))
            fetch(pass)
      }
      // No clips for readers who prefer reduced motion or save data.
      if (reduce.matches || saving()) return
      for (const j of [i, i + 1, i + 2]) fetch(videos.get(stepClips[j] ?? ""))
    }

    // The step's still over the overview; the one before stays under it
    // until the new one has faded in.
    let under = 0
    const layers = (i: number) => {
      const shot = stepShots[i]
      window.clearTimeout(under)
      for (const still of stills) {
        const on = still.dataset.shot === shot
        still.classList.toggle(
          "under",
          Boolean(shot) && !on && still.classList.contains("on"),
        )
        still.classList.toggle("on", on)
      }
      under = window.setTimeout(() => {
        for (const still of stills) still.classList.remove("under")
      }, 700)
      box.toggleAttribute("data-shot", Boolean(shot))
      box.toggleAttribute("data-late", stepLate[i])
      box.toggleAttribute("data-years", Boolean(stepYears[i]))
    }
    // A clip covers the picture while it plays; under it the layers
    // change to the step's, and when it ends it fades away over them.
    let playing: HTMLVideoElement | null = null
    const stop = () => {
      if (!playing) return
      playing.pause()
      playing.classList.remove("on")
      playing = null
      box.removeAttribute("data-playing")
    }
    const play = (i: number) => {
      const video = videos.get(stepClips[i] ?? "")
      if (!video || video.readyState < 3 || reduce.matches) return false
      stop()
      playing = video
      video.currentTime = 0
      box.setAttribute("data-playing", "")
      video.classList.add("on")
      const done = () => {
        if (playing !== video) return
        playing = null
        video.classList.remove("on")
        box.removeAttribute("data-playing")
      }
      video.onended = done
      video
        .play()
        .then(() =>
          window.setTimeout(() => {
            if (playing === video || current === i) layers(i)
          }, 300),
        )
        .catch(() => {
          layers(i)
          done()
        })
      return true
    }

    // The overview: the year runs with the scroll, and each way with a
    // rule that applies by then is lit.
    let shownYear = 0
    let wantedYear = 0
    let ticking = 0
    // The year the scroll asks for is reached a year at a time, and only
    // once a clip has ended, so the lights come on in view.
    const scrub = (year: number) => {
      wantedYear = year
      if (ticking || year === shownYear) return
      const tick = () => {
        ticking = 0
        if (!playing && wantedYear !== shownYear) {
          const jump = !shownYear || reduce.matches
          light(
            jump ? wantedYear : shownYear + Math.sign(wantedYear - shownYear),
          )
        }
        if (playing || wantedYear !== shownYear)
          ticking = window.setTimeout(tick, 70)
      }
      tick()
    }
    const light = (year: number) => {
      shownYear = year
      if (yearEl) {
        yearEl.textContent = String(year)
        yearEl.classList.toggle("future", year > today)
      }
      const covered = new Set(
        rules
          .filter(
            (rule) =>
              rule.from <= year &&
              year <= (rule.until ?? Number.POSITIVE_INFINITY),
          )
          .map((rule) => rule.way),
      )
      for (const el of [...wayEls, ...wayLabels]) {
        const id = el.dataset.way ?? el.dataset.wayLabel ?? ""
        el.classList.toggle("covered", covered.has(id))
      }
      // From 2016 the watchtower fills: one window per authority admitted.
      for (const el of watchEls)
        el.classList.toggle("on", Number(el.dataset.from) <= year)
    }

    // The law read aloud, only when asked for: the loudspeaker shown in the
    // paper chapter turns it on and off. In 1991 one voice reads; today up
    // to three talk over each other, taking turns through all passages.
    // The newest passage stands as a caption.
    type Voice = {
      id: string
      first: boolean
      ref: string
      text: string
      src: string
    }
    const voiceList: Voice[] = parse("voices")
    const voiceButtons = all<HTMLButtonElement>("[data-film-voice]")
    const caption = film.querySelector<HTMLElement>("[data-voice-caption]")
    const captionText = film.querySelector<HTMLElement>("[data-voice-text]")
    const captionRef = film.querySelector<HTMLElement>("[data-voice-ref]")
    const players = new Map<string, HTMLAudioElement>()
    const timers: number[] = []
    let voiceOn = false
    let voiceStep = ""
    const player = (voice: Voice) => {
      let audio = players.get(voice.id)
      if (!audio) {
        audio = new Audio(voice.src)
        audio.preload = "auto"
        players.set(voice.id, audio)
      }
      return audio
    }
    const fade = (audio: HTMLAudioElement, to: number, ms: number) => {
      const from = audio.volume
      const start = performance.now()
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms)
        audio.volume = from + (to - from) * t
        if (t < 1) requestAnimationFrame(step)
        else if (to === 0) audio.pause()
      }
      requestAnimationFrame(step)
    }
    const silence = () => {
      for (const id of timers.splice(0)) clearTimeout(id)
      for (const audio of players.values()) {
        audio.onended = null
        if (!audio.paused) fade(audio, 0, 500)
      }
      caption?.classList.remove("on")
    }
    const speak = (voice: Voice, then?: () => void) => {
      const audio = player(voice)
      audio.currentTime = 0
      audio.volume = 0
      audio.play().catch(() => {})
      fade(audio, voice.first ? 0.9 : 0.6, 300)
      if (captionText) captionText.textContent = voice.text
      if (captionRef) captionRef.textContent = voice.ref
      caption?.classList.add("on")
      audio.onended = () => then?.()
    }
    // Today: at most three voices at once. When one ends, the next passage
    // in line follows after a short pause, so all of them come round.
    const together = 3
    let nextVoice = 0
    const chorus = () => {
      const list = voiceList.filter((voice) => !voice.first)
      if (!list.length) return
      const voice = list[nextVoice % list.length]
      nextVoice++
      speak(voice, () =>
        timers.push(window.setTimeout(chorus, 600 + Math.random() * 1400)),
      )
    }
    const voiceFor = (stepId: string) => {
      if (stepId === voiceStep) return
      voiceStep = stepId
      silence()
      if (!voiceOn) return
      if (stepId === "papier-1991") {
        const first = voiceList.find((voice) => voice.first)
        if (first) speak(first)
      } else if (stepId === "papier-heute") {
        nextVoice = 0
        for (let k = 0; k < together; k++)
          timers.push(window.setTimeout(chorus, 400 + k * 2600))
      }
    }
    const setVoice = (on: boolean) => {
      voiceOn = on
      for (const button of voiceButtons)
        button.setAttribute("aria-pressed", String(on))
      voiceStep = ""
      voiceFor(stepIds[current] ?? "")
    }
    for (const button of voiceButtons)
      button.addEventListener("click", () => setVoice(!voiceOn))
    // Leaving the page or the tab stops the voices.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) silence()
      else {
        voiceStep = ""
        voiceFor(stepIds[current] ?? "")
      }
    })

    let current = -1
    const show = (i: number) => {
      const previous = current
      current = i
      view.dataset.stepId = stepIds[i]
      view.dataset.chapter = stepChapters[i]
      if (chapterAt) chapterAt.textContent = chapterLabels[i]
      near(i)
      if (!(previous === i - 1 && play(i))) {
        stop()
        layers(i)
      }
      voiceFor(stepIds[i])
      if (stepAt) stepAt.textContent = String(i + 1)
      if (prev) prev.disabled = i === 0
      for (const say of says)
        say.toggleAttribute("data-current", Number(say.dataset.say) === i)
      for (const el of onlys)
        el.classList.toggle(
          "on",
          (el.dataset.only ?? "").split(",").map(Number).includes(i),
        )
    }

    let queued = false
    const render = () => {
      queued = false
      // Every position is read before anything changes, so the page need
      // not be laid out again within the frame.
      const middle = window.innerHeight * 0.55
      const boxes = spacers.map((spacer) => spacer.getBoundingClientRect())
      const filmBox = film.getBoundingClientRect()
      let i = 0
      boxes.forEach((spacer, k) => {
        if (spacer.top <= middle) i = k
      })
      if (i !== current) show(i)
      const span = stepYears[i]
      // A year's span is run through by four fifths of the step, after
      // the clip that leads to the overview has had its time.
      const hold = stepClips[i] ? 0.3 : 0
      const p = Math.min(
        1,
        Math.max(
          0,
          ((middle - boxes[i].top) / boxes[i].height - hold) / (0.8 - hold),
        ),
      )
      if (span) {
        scrub(Math.round(span[0] + (span[1] - span[0]) * p))
      } else {
        const last = stepYears.slice(0, i).filter(Boolean).at(-1)
        scrub(last ? last[1] : (stepYears.find(Boolean)?.[0] ?? today))
      }
      document.documentElement.toggleAttribute(
        "data-immersive",
        filmBox.top <= window.innerHeight * 0.2 &&
          filmBox.bottom >= window.innerHeight,
      )
    }
    const queue = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(render)
    }
    window.addEventListener("scroll", queue, { passive: true })
    window.addEventListener("resize", queue)
    // The buttons scroll to the step before or after: a little way into
    // it, or, where the year runs, to its end, so it runs through.
    const goTo = (j: number) => {
      const behavior = reduce.matches ? "auto" : "smooth"
      if (j >= spacers.length) {
        const after = film.getBoundingClientRect().bottom + window.scrollY
        window.scrollTo({ top: after - 80, behavior })
        return
      }
      const k = Math.max(0, j)
      const spacer = spacers[k].getBoundingClientRect()
      const into = stepYears[k] ? 0.86 : 0.3
      window.scrollTo({
        top:
          window.scrollY +
          spacer.top -
          window.innerHeight * 0.55 +
          spacer.height * into,
        behavior,
      })
    }
    prev?.addEventListener("click", () => goTo(current - 1))
    next?.addEventListener("click", () => goTo(current + 1))
    film.toggleAttribute("data-ready", true)
    render()
  }
</script>

<style>
  /* Wie die Datengeschichte der Startseite: die Bühne füllt das Fenster und
     steht, während die Schritte vorbeiziehen. Der Film spielt bei Nacht:
     die Bühne ist in beiden Farbschemata dunkel. */
  .film {
    --pace: min(1svh, 0.76rem);
    --night: #0b0e17;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .track,
  .stage {
    grid-area: 1 / 1;
  }

  .track {
    padding-block: calc(50svh - var(--header-height) / 2 - 40 * var(--pace))
      calc(20 * var(--pace));
  }

  .spacer {
    block-size: calc(80 * var(--pace));
    scroll-margin-block-start: calc(var(--header-height) - 30 * var(--pace));
  }

  .stage {
    position: sticky;
    inset-block-start: var(--header-height);
    align-self: start;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    /* Die kleinste Fensterhöhe, nicht die wechselnde: Auf dem Handy fährt
       die Adressleiste beim Scrollen ein und aus, und mit ihr würde die
       ganze Bühne mitten im Film neu gesetzt. */
    block-size: calc(100svh - var(--header-height));
    padding-block: var(--space-xs) var(--space-s);
  }

  /* Ohne Skript stehen die Schlagzeilen untereinander. */
  .film:not([data-ready]) :is(.track, .picture) {
    display: none;
  }

  .film:not([data-ready]) .stage {
    position: static;
    block-size: auto;
  }

  .film:not([data-ready]) .says {
    gap: var(--space-l);
    padding: var(--space-l);
  }

  .film:not([data-ready]) .say {
    grid-area: auto;
  }

  /* ---------- Bühne ----------------------------------------------------- */

  /* Schmal: das Bild oben, die Schlagzeile in einer Leiste darunter.
     Breit: links die Schlagzeile, rechts das Bild. */
  .view {
    color-scheme: dark;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    min-block-size: 0;
    border-radius: var(--radius-xl);
    background: var(--night);
    color: var(--foreground);
    overflow: clip;
  }

  .picture {
    position: relative;
    grid-row: 1;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-block-size: 0;
  }

  .picture-box {
    display: grid;
    place-items: center;
    min-block-size: 0;
    container-type: size;
  }

  .says {
    grid-row: 2;
    display: grid;
    align-content: start;
    min-block-size: clamp(8.5rem, 26svh, 11rem);
    padding: var(--space-xs) var(--space-m) var(--space-m);
  }

  @container campaign (width >= 60rem) {
    .view {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: minmax(0, 1fr);
    }

    .picture {
      grid-column: 2;
      grid-row: 1;
    }

    .says {
      grid-column: 1;
      grid-row: 1;
      align-content: center;
      min-block-size: 0;
      padding: var(--space-xl);
    }
  }

  /* Auf hohen Desktop-Fenstern, etwa einer Seite im A4-Format, steht die
     Schlagzeile über dem Bild statt daneben: Das Bild bekommt die ganze
     Breite, und die Bühne füllt das Fenster ohne leere Fläche. */
  @media (max-aspect-ratio: 10 / 9) {
    @container campaign (width >= 60rem) {
      .view {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto minmax(0, 1fr);
      }

      .picture {
        grid-column: 1;
        grid-row: 2;
      }

      .says {
        grid-column: 1;
        grid-row: 1;
        align-content: start;
        padding: var(--space-xl) var(--space-xl) 0;
      }

      .view .say h3 {
        max-inline-size: 24ch;
      }

      .view .say-text {
        max-inline-size: 60ch;
      }
    }
  }

  .say {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    transition:
      opacity 0.35s ease,
      translate 0.35s ease;
  }

  .film[data-ready] .say:not([data-current]) {
    visibility: hidden;
    opacity: 0;
    translate: 0 0.75rem;
  }

  /* Die Aussage: groß, aber so, dass lange Wörter wie
     „Verdachtsmeldungen“ in die Spalte passen oder an der Silbe trennen
     statt mitten im Wort zu brechen. */
  .say h3 {
    max-inline-size: 18ch;
    color: var(--foreground);
    font-size: clamp(1.5rem, 0.9rem + 1.7vw, 2.5rem);
    font-stretch: 94%;
    font-weight: var(--weight-heading);
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
    overflow-wrap: normal;
    hyphens: auto;
  }

  .say-text {
    max-inline-size: 40ch;
    color: var(--ink-2);
    font-size: var(--type-lead);
    line-height: 1.35;
    text-wrap: pretty;
    overflow-wrap: normal;
  }

  /* Über der Aussage: wann ein Schritt kommt und wie weit er ist. Was
     Gesetz ist, steht rot, was erst vorgeschlagen ist, grau. */
  .say-when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6em;
    color: var(--ink-2);
    font-size: var(--type-meta);
  }

  .say-when b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .say-status {
    padding: 0.05em 0.55em;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    font-size: 0.85em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .say-status.decided {
    border-color: var(--accent);
    color: var(--accent);
  }

  .film-chapter {
    margin-inline-end: 0.5em;
    color: var(--ink-2);
    font-weight: 600;
  }

  /* Zurück und vor: schmal rechts unter der Aussage, breit unten rechts
     im Bild. */
  .film-nav {
    grid-area: 2 / 1;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: var(--space-s);
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-variant-numeric: tabular-nums;
  }

  @container campaign (width >= 60rem) {
    .film-nav {
      position: absolute;
      inset-block-end: var(--space-m);
      inset-inline-end: var(--space-m);
      z-index: 4;
      margin: 0;
    }
  }

  .film:not([data-ready]) .film-nav {
    display: none;
  }

  .film-nav button {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgb(11 14 23 / 0.7);
    color: var(--foreground);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  .film-nav button:hover {
    border-color: var(--ink-3);
  }

  .film-nav button:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .film-nav button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .film-nav svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .film-count b {
    color: var(--foreground);
    font-weight: 700;
  }

  /* ---------- Das Bild -------------------------------------------------- */

  /* Eine Welt, ein Bildformat: das Panoptikum bei Nacht. Was gerendert
     ist, liegt im Rahmen übereinander und läuft an den Rändern in die
     Nacht der Bühne aus; darüber stehen nur die Namen der Zellen und das Jahr. */
  .ways {
    position: relative;
    container-type: inline-size;
    inline-size: min(100cqi, 100cqb * 1.111);
    aspect-ratio: 1600 / 1440;
  }

  .frame {
    position: absolute;
    inset: 0;
    isolation: isolate;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
    mask-composite: intersect;
  }

  .frame > * {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
  }

  /* Über dem Grundbild je Zelle ihr Licht: ein roter Scheinwerfer vom Turm
     durch das Gitter, aufgehellt durch Bildschirm-Mischung, sobald eine
     Regel auf diesem Weg gilt; und je Behörde, die ins Kontenregister
     schauen darf, ein Fenster im Turm. */
  .way-light,
  .watch-light {
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 0.9s ease;
  }

  .way-light.covered,
  .watch-light.on {
    opacity: 1;
  }

  /* Ab dem Kapitel Papier hängen die Seiten in der Zelle: ein zweites
     Grundbild und ein zweites Licht für diese Zelle. */
  .ways-base.late {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .ways[data-late] .ways-base.late {
    opacity: 1;
  }

  .ways[data-late] .way-light.early,
  .ways:not([data-late]) .way-light.late {
    opacity: 0;
  }

  /* Ein Zugriff, der erst vorgeschlagen ist: Fenster, die noch nicht
     offen sind, glimmen auf und ab. */
  .watch-light.proposed.on {
    animation: proposed 2.4s ease-in-out infinite alternate;
  }

  @keyframes proposed {
    from {
      opacity: 0.25;
    }
    to {
      opacity: 1;
    }
  }

  /* Das Standbild eines Schritts liegt über dem Überblick; das vorige
     bleibt darunter stehen, bis das neue eingeblendet ist. */
  .shot {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .shot.on {
    z-index: 2;
    opacity: 1;
  }

  .shot.under {
    z-index: 1;
    opacity: 1;
    transition: none;
  }

  .shot-pass {
    z-index: 3;
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 0.9s ease;
  }

  .ways:not([data-playing]) .shot-pass.on {
    opacity: 1;
  }

  /* Der Clip deckt das Bild, solange er läuft, und blendet danach über
     dem Standbild aus. */
  .clip {
    z-index: 4;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .clip.on {
    opacity: 1;
    transition-duration: 0.2s;
  }

  /* ---------- Zellennamen und Jahr --------------------------------------------- */

  .way-label {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    max-inline-size: 7.5em;
    translate: -50% var(--dy);
    color: #d9dde3;
    font-size: clamp(0.7rem, 0.5rem + 1.6cqi, 0.95rem);
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: normal;
    transition:
      color 0.5s ease,
      opacity 0.4s ease;
  }

  .way-label.covered {
    color: #ff5a55;
  }

  /* Die Namen der Zellen gelten nur im Überblick. */
  .ways:is([data-shot], [data-playing]) .way-label {
    opacity: 0;
  }

  /* Das Jahr groß in der Ecke des Bildes, solange es läuft. */
  .ways-centre {
    position: absolute;
    inset-block-start: 4%;
    inset-inline-start: 4.5%;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .ways[data-years]:not([data-playing]) .ways-centre {
    opacity: 1;
  }

  .ways-centre strong {
    color: #fff;
    font-size: clamp(1.15rem, 0.2rem + 6cqi, 3.2rem);
    font-weight: var(--weight-heading);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .ways-centre strong.future {
    color: #aab0b8;
  }

  /* ---------- Legende --------------------------------------------------- */

  /* Unter dem Bild, nicht darauf: was seine Teile sind, je mit der Farbe,
     die sie im Bild haben. Die Zeile hat immer dieselbe Höhe, damit das
     Bild beim Wechsel nicht springt. */
  .legends {
    display: grid;
    min-block-size: 3.4em;
    padding: 0 var(--space-m) var(--space-xs);
    font-size: clamp(0.72rem, 0.62rem + 0.4vw, 0.86rem);
    line-height: 1.25;
  }

  .legend {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
