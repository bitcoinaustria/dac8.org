---
import SourceRefs from "@/components/SourceRefs.astro"
import { ruleChronicle } from "@/data/aml-history"
import { historyAsOf } from "@/data/history"
import { recovery } from "@/data/history-gap"
import { historySources } from "@/data/history-sources"
import { firstVoice, lawVoices } from "@/data/law-voices"
import {
  chapters,
  goldPrice,
  goldShown,
  inGold,
  inTodaysMoney,
  pile,
  reportField,
  type Scene,
  steps,
  thresholds,
} from "@/data/overregulation"
import cashBrick from "@/assets/history/cash-brick-bare.webp"
import cashBrickGold from "@/assets/history/cash-brick-gold.webp"
import cashCent from "@/assets/history/cash-cent.webp"
import cashBundle from "@/assets/history/cash-bundle-bare.webp"
import cashBundleGold from "@/assets/history/cash-bundle-gold.webp"
import seized from "@/assets/history/seized.json"
import seizedCoin from "@/assets/history/seized-coin.webp"
import seizedLanded from "@/assets/history/seized-landed.webp"
import seizedShadow from "@/assets/history/seized-shadow.webp"
import seizedTray from "@/assets/history/seized-tray.webp"
import panopticon from "@/assets/history/panopticon.json"
import panBase from "@/assets/history/panopticon-base.webp"
import type { Language } from "@/lib/i18n"

// The story of over-regulation as a scroll film, built like the home
// page's data story: the stage stands while the steps scroll past. Each
// step is a headline of a few words and turns one picture into a contrast
// you see before you read it, in eleven steps: the amount from which cash
// needs ID, and nothing at all for crypto; rules set on every way money can
// take, then ever more authorities in the watchtower; six pages beside 488;
// a sea of reports, most of them kept on file, beside a few convictions;
// and 100 euros in a stack of coins, of which the state takes one. Grey is what
// is collected, red what comes of it or what is new. Each step cites its sources by number from
// the list at the end of the page (src/data/history-sources.ts). Without
// the script the headlines stand as text one below the other.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const locale = en ? "en-GB" : "de-DE"
const n = (value: number) => new Intl.NumberFormat(locale).format(value)
const { cite } = historySources(language)

const index = new Map(steps.map((step, i) => [step.id, i]))
const at = (id: string) => {
  const i = index.get(id)
  if (i === undefined) throw new Error(`Film: no step "${id}"`)
  return i
}
const sceneOf = new Map(chapters.map((chapter) => [chapter.id, chapter.scene]))
const items = steps.map((step, i) => ({
  ...step,
  i,
  scene: sceneOf.get(step.chapter) as Scene,
}))
const thisYear = new Date(historyAsOf).getUTCFullYear()

// ---------- Ausweis ---------------------------------------------------------
const real = (t: (typeof thresholds)[number]) => inTodaysMoney(t.amount, t.year)
// What one transaction without an account may move without showing ID,
// 1991 in today's money, rendered at true scale in Blender from the same
// camera (scripts/artwork/render-cash.py): 339 notes of 100 euros, then a
// banded bundle of 100 notes from 2027, and for crypto a single cent. In
// the gold step the same amounts in gold coins of an ounce and less, at
// their price then and now, lie down in front of the notes: a second
// picture of each pile, cropped alike, fades in over the first
// (scripts/artwork/composite-gold.mjs). All three stay in view, so the
// amounts compare. Each step shows one measure, so the rows stay short.
const piles = [
  { notes: cashBrick, gold: cashBrickGold },
  { notes: cashBundle, gold: cashBundleGold },
]
const widest = Math.max(
  cashCent.width,
  ...piles.flatMap((pile) => [pile.notes.width, pile.gold.width]),
)
const barStep = at("ausweis-bar")
const goldStep = at("ausweis-gold")
const cryptoStep = at("ausweis-krypto")
const cashRows = thresholds.map((t, k) => {
  const pile = piles[k]
  const image = pile?.notes ?? cashCent
  const amount = real(t)
  // The coins are drawn for a fixed amount; once the gold price moves the
  // figure a tenth away from it, they need rendering again.
  const shown = goldShown[t.year]
  if (shown && Math.abs(inGold(t.amount, t.year) / shown - 1) > 0.1) {
    throw new Error(
      `Film: the picture shows ${shown} oz of gold for ${t.year}, the price now gives ${inGold(t.amount, t.year)}; render the coins again`,
    )
  }
  return {
    at: at(t.step),
    year: t.amount === 0 ? (en ? "Crypto" : "Krypto") : t.year,
    zero: t.amount === 0,
    image,
    gold: pile?.gold,
    style: `--w: ${((image.width / widest) * 100).toFixed(2)}%`,
    value:
      t.amount === 0
        ? en
          ? "From the first cent"
          : "Ab dem ersten Cent"
        : en
          ? `€${n(amount)}`
          : `${n(amount)} €`,
    detail:
      t.amount === 0
        ? en
          ? "your name on every transfer through a provider"
          : "dein Name bei jeder Übertragung über einen Anbieter"
        : t.year >= thisYear
          ? en
            ? "in cash from €3,000"
            : "bar schon ab 3.000 €"
          : `${en ? "then" : "damals"} ${n(t.amount)} ${t.unit === "ECU" ? "ECU" : "€"}`,
    ounces:
      t.amount === 0
        ? undefined
        : en
          ? `${n(inGold(t.amount, t.year))} oz`
          : `${n(inGold(t.amount, t.year))} Unzen`,
    goldDetail:
      t.year >= thisYear
        ? en
          ? "of gold at today’s price"
          : "Gold zum heutigen Preis"
        : en
          ? `of gold at the price of ${t.year}`
          : `Gold zum Preis von ${t.year}`,
  }
})

// ---------- Regeln ----------------------------------------------------------
// The ways money can take, and the rules set on them year by year: checks
// at the bank or provider (ID, monitoring, a cap) and automatic reports to
// the tax office. Each is a row of the chronicle; the rules about companies
// and advisers stay out, they are in the list to check. The year runs with
// the scroll; a way is lit once a rule on it applies.
const rowsById = new Map(
  ruleChronicle.stack.flatMap((group) =>
    group.rows.map((row) => [row.id, { row }]),
  ),
)
const panLights = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/history/panopticon-light-*.webp",
  { eager: true },
)
const wayList: {
  id: string
  label: { de: string; en: string }
  rows: string[]
}[] = [
  {
    id: "konto",
    label: { de: "Konto", en: "Bank account" },
    rows: [
      "ausweis",
      "verdacht",
      "sorgfalt",
      "kontenregister",
      "dac5",
      "register-eu",
    ],
  },
  {
    id: "depot",
    label: { de: "Wertpapiere", en: "Securities" },
    rows: ["depot"],
  },
  {
    id: "sparbuch",
    label: { de: "Sparbuch", en: "Savings book" },
    rows: ["sparbuch"],
  },
  {
    id: "ausland",
    label: { de: "Konto im Ausland", en: "Account abroad" },
    rows: ["zinsrichtlinie", "dac2"],
  },
  {
    id: "einkommen",
    label: { de: "Einkommen im Ausland", en: "Income abroad" },
    rows: ["dac1", "neufassung"],
  },
  {
    id: "plattform",
    label: { de: "Online-Plattformen", en: "Online platforms" },
    rows: ["dac7"],
  },
  {
    id: "krypto",
    label: { de: "Krypto", en: "Crypto" },
    rows: ["krypto-anbieter", "uebertragung", "dac8", "anonym-2027"],
  },
  {
    id: "bargeld",
    label: { de: "Bargeld", en: "Cash" },
    rows: ["bargeld-2027"],
  },
]
// The panopticon rendered in Blender (scripts/artwork/render-panopticon.py):
// a base picture at night and, per cell, a light pass with the searchlight
// from the tower, added by screen blending once a rule on that way
// applies. The render also gives, in percent of the picture, where each
// cell's label stands.
const ways = wayList.map((way, k) => {
  const cell = panopticon.cells[k]
  const light = panLights[`../assets/history/panopticon-light-${k}.webp`]
  if (!cell || !light) throw new Error(`Film: no render for cell ${k}`)
  const rules = way.rows.map((id) => {
    const found = rowsById.get(id)
    if (!found) throw new Error(`Film: no rule "${id}"`)
    return found.row
  })
  // Behind the tower the label stands above its point, in front below.
  const behind = cell.label[1] < panopticon.centre[1]
  return {
    ...way,
    label: way.label[language],
    light: light.default.src,
    rules,
    style: [
      `--x: ${cell.label[0]}%`,
      `--y: ${cell.label[1]}%`,
      `--dy: ${behind ? "-100%" : "0%"}`,
    ].join("; "),
  }
})
// For the script: every rule with its way, to light the ways by year.
const wayRules = JSON.stringify(
  ways.flatMap((way) =>
    way.rules.map((row) => ({ way: way.id, from: row.from, until: row.until })),
  ),
)

// ---------- Zugriff ---------------------------------------------------------
// Who may look into the account register: the same panopticon and the same
// running year, and in its watchtower one lit window per kind of authority
// (render-panopticon.py, "watch" passes), switched on from the year it was
// admitted. The names stay here, in the order of the windows.
const watchLights = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/history/panopticon-watch-*.webp",
  { eager: true },
)
const watchers: {
  from: number
  who: { de: string; en: string }
}[] = [
  {
    from: 2016,
    who: { de: "Staatsanwaltschaften", en: "prosecutors" },
  },
  { from: 2016, who: { de: "Strafgerichte", en: "criminal courts" } },
  { from: 2016, who: { de: "Abgabenbehörden", en: "tax authorities" } },
  {
    from: 2021,
    who: { de: "Geldwäschemeldestelle", en: "financial intelligence unit" },
  },
  { from: 2021, who: { de: "Staatsschutz", en: "state security" } },
  {
    from: 2021,
    who: { de: "Finanzmarktaufsicht", en: "financial market authority" },
  },
  {
    from: 2021,
    who: { de: "Bundeskriminalamt", en: "federal criminal police" },
  },
  {
    from: 2021,
    who: { de: "Sanktionsbehörden", en: "sanctions authorities" },
  },
  {
    from: 2026,
    who: { de: "Amt für Betrugsbekämpfung", en: "anti-fraud office" },
  },
]
const watch = watchers.map((watcher, k) => ({
  from: watcher.from,
  who: watcher.who[language],
  light:
    watchLights[`../assets/history/panopticon-watch-${k}.webp`]?.default.src,
}))

// ---------- Papier ----------------------------------------------------------
// Read aloud on request (src/data/law-voices.ts): the 1991 passage alone,
// then today's passages one after another until they overlap.
const voices = JSON.stringify(
  lawVoices.map((voice) => ({
    id: voice.id,
    first: voice.id === firstVoice,
    ref: voice.ref[language],
    text: voice.text[language],
    src: `/audio/law/${voice.id}-${language}.mp3`,
  })),
)
const totalPages = pile.reduce((sum, block) => sum + block.pages, 0)
const firstPages = pile[0].pages
const pages = Array.from({ length: totalPages }, (_, k) => k)

// ---------- Ergebnis --------------------------------------------------------
// One dot per report on a canvas (src/lib/film-sand.ts): which state
// belongs to which step.
const { firstYear, first, latest, kept: keptReports, convictions } = reportField
const sandStates = JSON.stringify({
  [at("ergebnis-2025")]: "all",
  [at("ergebnis-liegen")]: "kept",
  [at("ergebnis-urteile")]: "convictions",
})
const fieldSteps = ["ergebnis-2025", "ergebnis-liegen", "ergebnis-urteile"]
  .map(at)
  .join(",")
// 100 euros as a stack of fifty two-euro coins, of which the state takes
// the share Europol last estimated: the stack builds up coin by coin, then
// the top coin rises and moves over into a red tray. Rendered from one
// camera (render-seized.py; composite-seized.mjs): one coin, which the film
// stacks fifty times, the stack's shadow, and the tray with and without the
// coin. CSS moves the coin and draws its shadow, which runs along the table
// with it and sharpens as it comes down.
const seizedStep = at("ergebnis-euro")
const kept = recovery.latest.percent
const { coin, foot, step, drift, tray, way, shadows } = seized
const stackEuros = drift.length * seized.value
const takenEuros = seized.taken * seized.value
if (stackEuros !== 100 || takenEuros !== kept)
  throw new Error(
    `Film: the coins show ${takenEuros} of ${stackEuros} euros taken, Europol's share is now ${kept}; render them again`,
  )
const euros = (value: number) => (en ? `€${n(value)}` : `${n(value)} €`)
// Where each coin sits, from the bottom up.
const sits = drift.map(([dx, dy], k) => [
  foot[0] + dx + k * step[0],
  foot[1] + dy + k * step[1],
])
const top = sits[sits.length - 1]
// The picture takes in the stack with the coin raised above it, the tray,
// the shadow's far end and, right of the tray, room for its label.
const view = {
  x: Math.min(...sits.map(([x]) => x - coin.x)),
  y: top[1] + way[1][1] - coin.y,
  right: Math.max(seized.shadow.x + seized.shadow.w, tray.x + tray.w + coin.w),
  bottom: Math.max(foot[1] - coin.y + coin.h, tray.y + tray.h),
}
const viewW = view.right - view.x
const viewH = view.bottom - view.y
const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(3)}%`
const spot = (x: number, y: number) =>
  `left: ${pct(x - view.x, viewW)}; top: ${pct(y - view.y, viewH)}`
const place = (r: { x: number; y: number; w: number }) =>
  `${spot(r.x, r.y)}; width: ${pct(r.w, viewW)}`
// Lengths CSS cannot give in percent, such as shadows, in hundredths of
// the picture's width.
const cqi = (value: number) => `${((value / viewW) * 100).toFixed(3)}cqi`
// The stack from the bottom up, so that each coin covers the one below;
// --k orders their fall.
const seizedStack = sits.map(
  ([x, y], k) => `${spot(x - coin.x, y - coin.y)}; --k: ${k}`,
)
// The top coin's way in percent of its own size, as CSS translates it, and
// its shadow at each point: along the table, softer and fainter the higher
// it is. At first there is none, as the stack's shadow already has it.
const move = ([x, y]: number[]) => `${pct(x, coin.w)} ${pct(y, coin.h)}`
const face = coin.w - 24
const fallen = ([x, y, soft]: number[], k: number) => {
  const dark = k === 0 ? 0 : 0.32 * (face / (face + soft)) ** 3
  return `drop-shadow(${cqi(x)} ${cqi(y)} ${cqi(soft / 2 + 4)} rgb(0 0 0 / ${dark.toFixed(3)}))`
}
const seizedStyle = [
  `aspect-ratio: ${viewW} / ${viewH}`,
  `--ratio: ${(viewW / viewH).toFixed(4)}`,
  `--coin: ${pct(coin.w, viewW)}`,
  ...way.map((p, k) => `--way-${k}: ${move(p)}`),
  ...shadows.map((p, k) => `--shadow-${k}: ${fallen(p, k)}`),
].join("; ")
const seizedLayers = {
  shadow: place(seized.shadow),
  tray: place(tray),
  // The labels, their figures level with what they name: what stays
  // beside the top of the stack, what the state takes beside the tray.
  rest: spot(top[0] - coin.x + coin.w, top[1] + step[1]),
  kept: spot(tray.x + tray.w, tray.y + tray.h / 2),
}
---

<section
  class="film"
  aria-labelledby="film-title"
  data-film
  data-today={thisYear}
  data-scenes={JSON.stringify(items.map((item) => item.scene))}
  data-ids={JSON.stringify(items.map((item) => item.id))}
  data-years={JSON.stringify(items.map((item) => item.years ?? null))}
  data-voices={voices}
>
  <h2 id="film-title" class="visually-hidden">
    {en ? "The story of over-regulation" : "Die Geschichte der Überregulierung"}
  </h2>

  <div class="track" aria-hidden="true">
    {items.map((item) => (
      <div class="spacer" id={`film-${item.id}`} data-spacer={item.i} />
    ))}
  </div>

  <div class="stage">
    <div class="view" data-view data-scene={items[0].scene}>
      <div class="says">
        {items.map((item) => (
          <div
            class="say"
            data-say={item.i}
            data-current={item.i === 0 ? "" : undefined}
          >
            <h3>{item.title[language]}</h3>
            <p class="say-text">
              {item.text?.[language]}
              <SourceRefs sources={cite(item.sources)} language={language} />
            </p>
          </div>
        ))}
        <!-- Back and forth by click as well as by scroll. -->
        <nav
          class="film-nav"
          aria-label={en ? "Steps of the story" : "Schritte der Geschichte"}
        >
          <button
            type="button"
            data-film-prev
            aria-label={en ? "Previous step" : "Vorheriger Schritt"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <span class="film-count" aria-live="polite">
            <b data-film-at>1</b>
            / {items.length}
          </span>
          <button
            type="button"
            data-film-next
            aria-label={en ? "Next step" : "Nächster Schritt"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </nav>
      </div>

      <!-- One loudspeaker, shown in the paper chapter: the law read aloud. -->
      <button
        type="button"
        class="film-voice"
        data-film-voice
        aria-pressed="false"
        aria-label={en ? "Read the law aloud" : "Gesetz vorlesen lassen"}
        title={en ? "Read the law aloud" : "Gesetz vorlesen lassen"}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9h4l5-4v14l-5-4H4z" />
          <path
            class="wave"
            d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"
          />
        </svg>
      </button>

      <div class="scenes" aria-hidden="true">
        <!-- Ausweis -->
        <div class="scene" data-scene-id="threshold">
          <ol class="cash">
            {cashRows.map((row) => (
              <li class:list={["cash-row", { zero: row.zero }]} data-at={row.at} style={row.style}>
                <span class="cash-pile">
                  <img src={row.image.src} width={row.image.width} height={row.image.height} alt="" decoding="async" />
                  {row.gold && (
                    <img class="cash-coins" src={row.gold.src} width={row.gold.width} height={row.gold.height} alt="" decoding="async" data-at={goldStep} />
                  )}
                </span>
                <p class="cash-label">
                  <span class="cash-year">{row.year}</span>
                  {row.zero ? (
                    <span class="cash-measure">
                      <b>{row.value}</b>
                      <span class="cash-detail">{row.detail}</span>
                    </span>
                  ) : (
                    <span class="cash-measures">
                      <span class="cash-measure" data-only={`${barStep},${cryptoStep}`}>
                        <b>{row.value}</b>
                        <span class="cash-detail" data-only={String(barStep)}>{row.detail}</span>
                      </span>
                      <span class="cash-measure" data-only={String(goldStep)}>
                        <b>{row.ounces}</b>
                        <span class="cash-detail">{row.goldDetail}</span>
                      </span>
                    </span>
                  )}
                </p>
              </li>
            ))}
          </ol>
          <p class="scene-caption cash-captions">
            <span data-only={`${barStep},${cryptoStep}`}>
              {en ? "At true scale, 1991 in today’s money." : "Maßstabsgetreu, 1991 in heutigem Geld."}
            </span>
            <span data-only={String(goldStep)}>
              {en
                ? `At true scale, gold at the price of 1991 and of ${goldPrice.asOf.en}.`
                : `Maßstabsgetreu, Gold zum Preis von 1991 und von ${goldPrice.asOf.de}.`}
            </span>
          </p>
        </div>

        <!-- Regeln -->
        <div class="scene" data-scene-id="rules">
          <div class="ways-wrap" data-ways={wayRules}>
            <div class="ways">
              <img
                class="ways-base"
                src={panBase.src}
                width={panBase.width}
                height={panBase.height}
                alt=""
                decoding="async"
              >
              {ways.map((way) => (
                <img class="way-light" data-way={way.id} src={way.light} alt="" decoding="async" />
              ))}
              {watch.map((post) =>
                post.light ? (
                  <img class="watch-light" data-from={post.from} src={post.light} alt="" decoding="async" />
                ) : null,
              )}
              {ways.map((way) => (
                <span class="way-label" data-way-label={way.id} style={way.style}>
                  {way.label}
                </span>
              ))}
              <p class="ways-centre">
                <strong data-year>{steps[at("regeln")].years?.[0]}</strong>
              </p>
            </div>
          </div>
        </div>

        <!-- Papier: one tile per page, the first six red -->
        <div class="scene" data-scene-id="tower">
          <div class="wall-wrap" data-wall>
            <div class="wall" data-at={at("papier-heute")}>
              {pages.map((k) => (
                <span class:list={["page", { first: k < firstPages }]} style={`--k: ${k}`} />
              ))}
            </div>
            <p class="wall-voice" data-voice-caption>
              <small data-voice-ref />
              <span data-voice-text />
            </p>
          </div>
          <p class="scene-caption">
            {en
              ? "One square per page in the EU Official Journal; red, the first directive of 1991."
              : "Ein Kästchen je Seite im Amtsblatt der EU, rot die erste Richtlinie von 1991."}
          </p>
        </div>

        <!-- Ergebnis -->
        <div class="scene" data-scene-id="result">
          <div class="result">
            <div
              class="sand"
              data-sand={sandStates}
              data-sand-counts={JSON.stringify({
                firstYear,
                first,
                latest,
                kept: keptReports,
                convictions,
              })}
              data-sand-locale={locale}
              data-sand-words={JSON.stringify({
                reports: en ? "reports" : "Meldungen",
                convictions: en ? "convictions" : "Verurteilungen",
              })}
              data-only={fieldSteps}
            >
              <canvas />
              <i data-sand-grey />
              <i data-sand-red />
              <i data-sand-text />
              <i data-sand-muted />
              <i data-sand-panel />
              <span class="sand-label" data-sand-label="kept">
                <b>{n(keptReports)}</b>
                {en ? "not passed on, kept" : "nicht weitergegeben, gespeichert"}
              </span>
              <span class="sand-label" data-sand-label="passed">
                <b>{n(latest - keptReports)}</b>
                {en ? "passed on" : "weitergegeben"}
              </span>
            </div>
            <div
              class="seized"
              data-only={String(seizedStep)}
              style={seizedStyle}
            >
              <img
                class="seized-shadow"
                src={seizedShadow.src}
                style={seizedLayers.shadow}
                alt=""
                decoding="async"
              >
              <img
                class="seized-tray"
                src={seizedTray.src}
                style={seizedLayers.tray}
                alt=""
                decoding="async"
              >
              <img
                class="seized-landed"
                src={seizedLanded.src}
                style={seizedLayers.tray}
                alt=""
                decoding="async"
              >
              {seizedStack.map((style, k) => (
                  <img
                    class:list={[
                      "seized-coin",
                      { "seized-top": k === seizedStack.length - 1 },
                    ]}
                    src={seizedCoin.src}
                    style={style}
                    alt=""
                    decoding="async"
                  />
                ))}
              <span
                class="seized-label was"
                style={seizedLayers.rest}
                aria-hidden="true"
              >
                <b>{euros(stackEuros)}</b>
              </span>
              <span class="seized-label rest" style={seizedLayers.rest}>
                <b>{euros(stackEuros - takenEuros)}</b>
                {en ? "stay with criminals" : "bleiben bei Kriminellen"}
              </span>
              <span class="seized-label kept" style={seizedLayers.kept}>
                <b>{euros(takenEuros)}</b>
                {en ? "taken by the state" : "zieht der Staat ein"}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createSand, type SandState } from "@/lib/film-sand"

  // The step whose spacer has crossed the middle of the window is current:
  // it picks the scene and the headline and switches on what has appeared
  // so far ([data-at]) or only now ([data-only]). In the rules chapter the
  // year runs with the scroll and lights the ways its rules reach.
  for (const film of document.querySelectorAll<HTMLElement>("[data-film]")) {
    const view = film.querySelector<HTMLElement>("[data-view]")
    if (!view) continue
    const all = (selector: string) => [
      ...film.querySelectorAll<HTMLElement>(selector),
    ]
    const spacers = all("[data-spacer]")
    const prev = film.querySelector<HTMLButtonElement>("[data-film-prev]")
    const next = film.querySelector<HTMLButtonElement>("[data-film-next]")
    const stepAt = film.querySelector<HTMLElement>("[data-film-at]")
    const says = all("[data-say]")
    const ats = [...film.querySelectorAll<Element>("[data-at]")]
    const onlys = all("[data-only]")
    const waysRoot = film.querySelector<HTMLElement>("[data-ways]")
    const rules: { way: string; from: number; until?: number }[] = JSON.parse(
      waysRoot?.dataset.ways ?? "[]",
    )
    const wayEls = [
      ...(waysRoot?.querySelectorAll<SVGElement>("[data-way]") ?? []),
    ]
    const wayLabels = [
      ...(waysRoot?.querySelectorAll<HTMLElement>("[data-way-label]") ?? []),
    ]
    const yearEl = film.querySelector<HTMLElement>("[data-year]")
    const watchEls = all("[data-from]")
    const parse = (key: string) => JSON.parse(film.dataset[key] ?? "[]")
    const stepScenes: string[] = parse("scenes")
    const stepIds: string[] = parse("ids")
    const stepYears: ([number, number] | null)[] = parse("years")
    const today = Number(film.dataset.today)
    // The rules chapter: the year runs with the scroll, and each way with a
    // rule that applies by then is lit.
    let shownYear = 0
    const scrub = (year: number) => {
      if (year === shownYear) return
      shownYear = year
      if (yearEl) {
        yearEl.textContent = String(year)
        yearEl.classList.toggle("future", year > today)
      }
      const covered = new Set(
        rules
          .filter(
            (rule) =>
              rule.from <= year &&
              year <= (rule.until ?? Number.POSITIVE_INFINITY),
          )
          .map((rule) => rule.way),
      )
      for (const el of [...wayEls, ...wayLabels]) {
        const id = el.dataset.way ?? el.dataset.wayLabel ?? ""
        el.classList.toggle("covered", covered.has(id))
      }
      // From 2016 the watchtower fills: one window per authority admitted.
      for (const el of watchEls)
        el.classList.toggle("on", Number(el.dataset.from) <= year)
    }

    // The result chapter's dots, one per report.
    const sandRoot = film.querySelector<HTMLElement>("[data-sand]")
    const sandStates: Record<string, SandState> = JSON.parse(
      sandRoot?.dataset.sand ?? "{}",
    )
    const sand = sandRoot
      ? createSand(sandRoot, JSON.parse(sandRoot.dataset.sandCounts ?? "{}"))
      : null

    // The law read aloud, only when asked for: the loudspeaker shown in the
    // paper chapter turns it on and off. In 1991 one voice reads; today up
    // to three talk over each other, taking turns through all passages.
    // Each speaking page lights up; the newest passage stands as a caption.
    type Voice = {
      id: string
      first: boolean
      ref: string
      text: string
      src: string
    }
    const voiceList: Voice[] = parse("voices")
    const voiceButtons = all("[data-film-voice]") as HTMLButtonElement[]
    const caption = film.querySelector<HTMLElement>("[data-voice-caption]")
    const captionText = film.querySelector<HTMLElement>("[data-voice-text]")
    const captionRef = film.querySelector<HTMLElement>("[data-voice-ref]")
    const pagesEls = all(".page")
    const players = new Map<string, HTMLAudioElement>()
    const timers: number[] = []
    let voiceOn = false
    let voiceStep = ""
    const player = (voice: Voice) => {
      let audio = players.get(voice.id)
      if (!audio) {
        audio = new Audio(voice.src)
        audio.preload = "auto"
        players.set(voice.id, audio)
      }
      return audio
    }
    const fade = (audio: HTMLAudioElement, to: number, ms: number) => {
      const from = audio.volume
      const start = performance.now()
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms)
        audio.volume = from + (to - from) * t
        if (t < 1) requestAnimationFrame(step)
        else if (to === 0) audio.pause()
      }
      requestAnimationFrame(step)
    }
    const silence = () => {
      for (const id of timers.splice(0)) clearTimeout(id)
      for (const audio of players.values()) {
        audio.onended = null
        if (!audio.paused) fade(audio, 0, 500)
      }
      for (const page of pagesEls) page.classList.remove("speaking")
      caption?.classList.remove("on")
    }
    const speak = (voice: Voice, pages: HTMLElement[], then?: () => void) => {
      const audio = player(voice)
      audio.currentTime = 0
      audio.volume = 0
      audio.play().catch(() => {})
      fade(audio, voice.first ? 0.9 : 0.6, 300)
      for (const page of pages) page.classList.add("speaking")
      if (captionText) captionText.textContent = voice.text
      if (captionRef) captionRef.textContent = voice.ref
      caption?.classList.add("on")
      audio.onended = () => {
        for (const page of pages) page.classList.remove("speaking")
        then?.()
      }
    }
    // Today: at most three voices at once. When one ends, the next passage
    // in line follows after a short pause, so all of them come round.
    const together = 3
    let nextVoice = 0
    const chorus = () => {
      const today = voiceList.filter((voice) => !voice.first)
      if (!today.length) return
      const voice = today[nextVoice % today.length]
      nextVoice++
      speak(voice, [randomPage()], () =>
        timers.push(window.setTimeout(chorus, 600 + Math.random() * 1400)),
      )
    }
    const randomPage = () =>
      pagesEls[6 + Math.floor(Math.random() * Math.max(1, pagesEls.length - 6))]
    const voiceFor = (stepId: string) => {
      if (stepId === voiceStep) return
      voiceStep = stepId
      silence()
      if (!voiceOn) return
      if (stepId === "papier-1991") {
        const first = voiceList.find((voice) => voice.first)
        if (first) speak(first, pagesEls.slice(0, 6))
      } else if (stepId === "papier-heute") {
        nextVoice = 0
        for (let k = 0; k < together; k++)
          timers.push(window.setTimeout(chorus, 400 + k * 2600))
      }
    }
    const setVoice = (on: boolean) => {
      voiceOn = on
      for (const button of voiceButtons)
        button.setAttribute("aria-pressed", String(on))
      voiceStep = ""
      voiceFor(stepIds[current] ?? "")
    }
    for (const button of voiceButtons)
      button.addEventListener("click", () => setVoice(!voiceOn))
    // Leaving the page or the tab stops the voices.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) silence()
      else {
        voiceStep = ""
        voiceFor(stepIds[current] ?? "")
      }
    })

    let current = -1
    const show = (i: number) => {
      const previous = current
      current = i
      // The dots move from step to step, and fill in when the chapter
      // begins; a jump, or a way back from the last step, shows the end at
      // once.
      const sandState = sandStates[i]
      if (sandState)
        sand?.go(sandState, previous in sandStates || previous === i - 1)
      else sand?.hide()
      view.dataset.scene = stepScenes[i]
      view.dataset.stepId = stepIds[i]
      voiceFor(stepIds[i])
      if (stepAt) stepAt.textContent = String(i + 1)
      if (prev) prev.disabled = i === 0
      for (const say of says)
        say.toggleAttribute("data-current", Number(say.dataset.say) === i)
      for (const el of ats)
        el.classList.toggle(
          "on",
          Number(
            (el as HTMLElement).dataset?.at ?? el.getAttribute("data-at"),
          ) <= i,
        )
      for (const el of onlys)
        el.classList.toggle(
          "on",
          (el.dataset.only ?? "").split(",").map(Number).includes(i),
        )
    }

    // The wall of pages: the column count at which all tiles are largest.
    const wallWrap = film.querySelector<HTMLElement>("[data-wall]")
    const wall = wallWrap?.firstElementChild as HTMLElement | null
    const fit = () => {
      if (!wallWrap || !wall) return
      const count = wall.children.length
      const { width, height } = wallWrap.getBoundingClientRect()
      if (!width || !height) return
      const gap = 2
      let best = { cols: 1, tile: 0 }
      for (let cols = 6; cols <= 60; cols++) {
        const rows = Math.ceil(count / cols)
        const tile = Math.min(
          (width - gap * (cols - 1)) / cols,
          ((height - gap * (rows - 1)) / rows) * (5 / 6),
        )
        if (tile > best.tile) best = { cols, tile }
      }
      wall.style.setProperty("--cols", String(best.cols))
      wall.style.setProperty("--tile", `${Math.floor(best.tile * 10) / 10}px`)
    }

    let queued = false
    const render = () => {
      queued = false
      const middle = window.innerHeight * 0.55
      let i = 0
      spacers.forEach((spacer, k) => {
        if (spacer.getBoundingClientRect().top <= middle) i = k
      })
      if (i !== current) show(i)
      const span = stepYears[i]
      if (span) {
        const box = spacers[i].getBoundingClientRect()
        // The span is run through by four fifths of the step.
        const p = Math.min(
          1,
          Math.max(0, (middle - box.top) / (box.height * 0.8)),
        )
        scrub(Math.round(span[0] + (span[1] - span[0]) * p))
      } else {
        const last = stepYears.slice(0, i).filter(Boolean).at(-1)
        if (last) scrub(last[1])
      }
      const box = film.getBoundingClientRect()
      document.documentElement.toggleAttribute(
        "data-immersive",
        box.top <= window.innerHeight * 0.2 && box.bottom >= window.innerHeight,
      )
    }
    const queue = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(render)
    }
    window.addEventListener("scroll", queue, { passive: true })
    window.addEventListener("resize", () => {
      fit()
      queue()
    })
    if (wallWrap) new ResizeObserver(fit).observe(wallWrap)
    // The buttons scroll to the step before or after: a little way into
    // it, or, where the year runs, to its end, so the year runs through.
    const reduce = matchMedia("(prefers-reduced-motion: reduce)")
    const goTo = (j: number) => {
      const behavior = reduce.matches ? "auto" : "smooth"
      if (j >= spacers.length) {
        const after = film.getBoundingClientRect().bottom + window.scrollY
        window.scrollTo({ top: after - 80, behavior })
        return
      }
      const box = spacers[Math.max(0, j)].getBoundingClientRect()
      const into = stepYears[Math.max(0, j)] ? 0.86 : 0.3
      window.scrollTo({
        top:
          window.scrollY +
          box.top -
          window.innerHeight * 0.55 +
          box.height * into,
        behavior,
      })
    }
    prev?.addEventListener("click", () => goTo(current - 1))
    next?.addEventListener("click", () => goTo(current + 1))
    film.toggleAttribute("data-ready", true)
    render()
  }
</script>

<style>
  /* Wie die Datengeschichte der Startseite: die Bühne füllt das Fenster und
     steht, während die Schritte vorbeiziehen. */
  .film {
    --pace: min(1svh, 0.76rem);
    --bar: light-dark(#3b4147, #a7afb6);
    --red: var(--primary);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .track,
  .stage {
    grid-area: 1 / 1;
  }

  .track {
    padding-block: calc(50svh - var(--header-height) / 2 - 40 * var(--pace))
      calc(20 * var(--pace));
  }

  .spacer {
    block-size: calc(70 * var(--pace));
    scroll-margin-block-start: calc(var(--header-height) - 30 * var(--pace));
  }

  .stage {
    position: sticky;
    inset-block-start: var(--header-height);
    align-self: start;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    block-size: calc(100dvh - var(--header-height));
    padding-block: var(--space-xs) var(--space-s);
  }

  /* Ohne Skript stehen die Schlagzeilen untereinander. */
  .film:not([data-ready]) :is(.track, .scenes) {
    display: none;
  }

  .film:not([data-ready]) .stage {
    position: static;
    block-size: auto;
  }

  .film:not([data-ready]) .says {
    gap: var(--space-l);
  }

  .film:not([data-ready]) .say {
    grid-area: auto;
  }

  /* ---------- Bühne ----------------------------------------------------- */

  /* Schmal: das Bild oben, die Schlagzeile in einer Leiste darunter.
     Breit: links die Schlagzeile, rechts das Bild. */
  .view {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    min-block-size: 0;
    border-radius: var(--radius-xl);
    background: var(--panel);
    overflow: clip;
  }

  .scenes {
    position: relative;
    grid-row: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    min-block-size: 0;
    container-type: size;
  }

  .says {
    grid-row: 2;
    display: grid;
    align-content: start;
    min-block-size: clamp(7.5rem, 22svh, 9.5rem);
    padding: var(--space-s) var(--space-m) var(--space-m);
    border-block-start: 1px solid var(--line);
    background: var(--paper);
  }

  @container campaign (width >= 60rem) {
    .view {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: minmax(0, 1fr);
    }

    .scenes {
      grid-column: 2;
      grid-row: 1;
    }

    .says {
      grid-column: 1;
      grid-row: 1;
      align-content: center;
      min-block-size: 0;
      padding: var(--space-xl);
      border: 0;
      background: none;
    }
  }

  /* Auf hohen Desktop-Fenstern, etwa einer Seite im A4-Format, steht die
     Schlagzeile über dem Bild statt daneben: Das Bild bekommt die ganze
     Breite, und die Bühne füllt das Fenster ohne leere Fläche. */
  @media (max-aspect-ratio: 10 / 9) {
    @container campaign (width >= 60rem) {
      .view {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto minmax(0, 1fr);
      }

      .scenes {
        grid-column: 1;
        grid-row: 2;
      }

      .says {
        grid-column: 1;
        grid-row: 1;
        align-content: start;
        padding: var(--space-xl) var(--space-xl) 0;
      }

      .view .say h3 {
        max-inline-size: 24ch;
      }

      .view .say-text {
        max-inline-size: 60ch;
      }

      .view .cash {
        justify-content: center;
      }
    }
  }

  .say {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    transition:
      opacity 0.35s ease,
      translate 0.35s ease;
  }

  .film[data-ready] .say:not([data-current]) {
    visibility: hidden;
    opacity: 0;
    translate: 0 0.75rem;
  }

  /* Die Aussage: groß, aber so, dass lange Wörter wie
     „Verdachtsmeldungen“ in die Spalte passen oder an der Silbe trennen
     statt mitten im Wort zu brechen. */
  .say h3 {
    max-inline-size: 18ch;
    color: var(--foreground);
    font-size: clamp(1.5rem, 0.9rem + 1.7vw, 2.5rem);
    font-stretch: 94%;
    font-weight: var(--weight-heading);
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
    overflow-wrap: normal;
    hyphens: auto;
  }

  .say-text {
    max-inline-size: 40ch;
    color: var(--ink-2);
    font-size: var(--type-lead);
    line-height: 1.35;
    text-wrap: pretty;
    overflow-wrap: normal;
  }

  /* Zurück und vor: schmal rechts unter der Aussage, breit unten rechts
     im Bild. */
  .film-nav {
    grid-area: 2 / 1;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: var(--space-s);
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-variant-numeric: tabular-nums;
  }

  @container campaign (width >= 60rem) {
    .film-nav {
      position: absolute;
      inset-block-end: var(--space-m);
      inset-inline-end: var(--space-m);
      z-index: 2;
      margin: 0;
    }

    .view .scene {
      padding-block-end: calc(var(--space-m) + 3.25rem);
    }

    .view .ways {
      inline-size: min(100%, (100cqh - 7rem) * 1.111);
    }
  }

  .film:not([data-ready]) .film-nav {
    display: none;
  }

  .film-nav button {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--panel);
    color: var(--foreground);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  .film-nav button:hover {
    border-color: var(--ink-3);
    background: var(--paper);
  }

  .film-nav button:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .film-nav button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .film-nav svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .film-count b {
    color: var(--foreground);
    font-weight: 700;
  }

  /* ---------- Szenen ---------------------------------------------------- */

  .scene {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-s);
    min-block-size: 0;
    padding: var(--space-m);
    opacity: 0;
    visibility: hidden;
    scale: 0.97;
    transition:
      opacity 0.5s ease,
      scale 0.5s ease,
      visibility 0.5s;
  }

  .view[data-scene="threshold"] [data-scene-id="threshold"],
  .view[data-scene="rules"] [data-scene-id="rules"],
  .view[data-scene="watch"] [data-scene-id="rules"],
  .view[data-scene="tower"] [data-scene-id="tower"],
  .view[data-scene="result"] [data-scene-id="result"] {
    opacity: 1;
    visibility: visible;
    scale: 1;
  }

  /* Die Szenen zeigen ihre Zahl im Bild, nicht als zweite Überschrift:
     links steht die Aussage, rechts der Beleg. */
  .scene-caption {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  /* ---------- Ausweis --------------------------------------------------- */

  /* Drei Haufen untereinander, im selben Maßstab: der Ziegel von 1991, der
     dünne Stapel von 2017, heute ein Cent. Jeder bleibt stehen, wenn der
     nächste kommt; der aktuelle ist hell, die früheren treten zurück. */
  .cash {
    --pile: min(58cqi, (100cqh - 9rem) * 0.86, 30rem);
    display: grid;
    align-content: center;
    gap: clamp(0.4rem, 2.5cqh, 1.4rem);
    min-block-size: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cash-row {
    display: grid;
    grid-template-columns: var(--pile) minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.8rem, 3cqi, 2rem);
    opacity: 0;
    translate: 0 -1.2rem;
    transition:
      opacity 0.6s ease,
      translate 0.7s cubic-bezier(0.3, 1.4, 0.5, 1),
      filter 0.6s ease;
  }

  .cash-row.on {
    opacity: 1;
    translate: 0 0;
  }

  /* Mit dem Cent treten die Stapel zurück, bleiben aber lesbar. */
  .view[data-step-id="ausweis-krypto"] .cash-row:not(.zero) {
    opacity: 0.5;
    filter: saturate(0.4);
  }

  /* Je Stapel zwei gleich zugeschnittene Bilder übereinander: die Scheine
     allein und mit dem Gold davor, das im Gold-Schritt einblendet. */
  .cash-pile {
    display: grid;
    justify-items: center;
  }

  .cash-pile img {
    grid-area: 1 / 1;
    display: block;
    inline-size: var(--w);
    block-size: auto;
  }

  .cash-coins {
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .cash-coins.on {
    opacity: 1;
  }

  /* Je Schritt eine Messgröße, Euro oder Gold; beide liegen übereinander,
     damit die Zeile beim Wechsel nicht springt. */
  .cash-measures,
  .cash-captions {
    display: grid;
  }

  .cash-measures > *,
  .cash-captions > * {
    grid-area: 1 / 1;
  }

  .cash-measure {
    display: grid;
    align-content: start;
    gap: 0.1rem;
  }

  .cash-label [data-only],
  .cash-captions [data-only] {
    transition:
      opacity 0.4s ease,
      visibility 0.4s;
  }

  .cash-label [data-only]:not(.on),
  .cash-captions [data-only]:not(.on) {
    opacity: 0;
    visibility: hidden;
  }

  .cash-label {
    display: grid;
    gap: 0.1rem;
    color: var(--ink-3);
    font-size: var(--type-meta);
    line-height: 1.3;
  }

  .cash-year {
    font-weight: 600;
  }

  .cash-label b {
    color: var(--foreground);
    font-size: clamp(1.4rem, 0.9rem + 2.6cqi, 2.6rem);
    font-weight: var(--weight-heading);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .cash-row.zero b,
