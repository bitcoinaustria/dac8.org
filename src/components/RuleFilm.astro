  /* ---------- Ausweis --------------------------------------------------- */

  /* Ein Turm aus Hundertern. Die Höhe folgt dem Schritt: --n ist die Zahl
     der Scheine, die Umrisse halten die früheren Höhen fest. */
  .cash {
