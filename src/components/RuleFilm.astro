---
import { ruleChronicle } from "@/data/aml-history"
import { historyAsOf, isAhead } from "@/data/history"
import {
  chapters,
  inTodaysMoney,
  lookers,
  pile,
  reportField,
  type Scene,
  steps,
  thresholds,
} from "@/data/overregulation"
import type { Language } from "@/lib/i18n"

// The story of over-regulation as a scroll film, built like the home
// page's data story: the stage stands while the steps scroll past. Each
// step is a headline of a few words and turns one picture into a contrast
// you see before you read it: the amount from which you must show ID
// falling to zero, the rules piling up, six pages beside 488, the ring of
// authorities around your account, a sea of reports beside a few
// convictions, and 100 coins of which one is red. Grey is what is
// collected, red what comes of it or what is new. Without the script the
// headlines stand as text one below the other.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const locale = en ? "en-GB" : "de-DE"
const n = (value: number) => new Intl.NumberFormat(locale).format(value)

const index = new Map(steps.map((step, i) => [step.id, i]))
const at = (id: string) => {
  const i = index.get(id)
  if (i === undefined) throw new Error(`Film: no step "${id}"`)
  return i
}
const sceneOf = new Map(chapters.map((chapter) => [chapter.id, chapter.scene]))
const items = steps.map((step, i) => ({
  ...step,
  i,
  scene: sceneOf.get(step.chapter) as Scene,
}))
const firstOf = (chapterId: string) =>
  items.find((item) => item.chapter === chapterId)?.i ?? 0
// A value per step for the big figure, carried forward to later steps.
const counts = (values: Record<string, number>) =>
  JSON.stringify(
    Object.fromEntries(Object.entries(values).map(([id, v]) => [at(id), v])),
  )
const thisYear = new Date(historyAsOf).getUTCFullYear()

// ---------- Ausweis ---------------------------------------------------------
const real = (t: (typeof thresholds)[number]) => inTodaysMoney(t.amount, t.year)
const highest = Math.max(...thresholds.map(real))
const bars = thresholds.map((t) => ({
  year: t.year,
  at: at(t.step),
  zero: t.amount === 0,
  then:
    t.amount === 0
      ? en
        ? "any amount"
        : "jeder Betrag"
      : `${en ? "then" : "damals"} ${n(t.amount)} ${t.unit === "ECU" ? "ECU" : "€"}`,
  style: `--w: ${((real(t) / highest) * 100).toFixed(2)}%`,
}))
const idCounts = counts(
  Object.fromEntries(thresholds.map((t) => [t.step, real(t)])),
)

// ---------- Regeln ----------------------------------------------------------
const statusOf = new Map(ruleChronicle.entries.map((e) => [e.id, e.status]))
const cards = ruleChronicle.stack.flatMap((group) =>
  group.rows.map((row) => {
    const status = statusOf.get(row.id) ?? "past"
    return {
      domain: group.domain?.id ?? "steuern",
      what: row.what[language],
      from: row.from,
      until: row.until,
      status,
      ahead: isAhead(status),
    }
  }),
)
const rulePiles = [
  { id: "steuern", label: en ? "Tax" : "Steuern" },
  { id: "geldwaesche", label: en ? "Money laundering" : "Geldwäsche" },
].map((p) => ({
  ...p,
  cards: cards
    .filter((card) => card.domain === p.id)
    .sort((a, b) => a.from - b.from),
}))

// ---------- Papier ----------------------------------------------------------
const totalPages = pile.reduce((sum, block) => sum + block.pages, 0)
let below = 0
const blocks = pile.map((block, k) => {
  const style = `--from: ${(below / totalPages).toFixed(4)}; --pages: ${(block.pages / totalPages).toFixed(4)}; --k: ${k}`
  below += block.pages
  return { ...block, style }
})
const firstPages = pile[0].pages
const firstShare = (firstPages / totalPages).toFixed(4)
const pageCounts = counts({
  "papier-1991": firstPages,
  "papier-heute": totalPages,
})

// ---------- Zugriff ---------------------------------------------------------
const ring = lookers.map((looker, k) => {
  const angle = (k / lookers.length) * 2 * Math.PI - Math.PI / 2
  const x = 50 + 37 * Math.cos(angle)
  const y = 50 + 37 * Math.sin(angle)
  return {
    at: at(looker.step),
    label: looker.label[language],
    x,
    y,
    style: `--x: ${x.toFixed(2)}%; --y: ${y.toFixed(2)}%`,
  }
})
const europe = Array.from({ length: 26 }, (_, k) => {
  const angle = (k / 26) * 2 * Math.PI - Math.PI / 2
  return `--x: ${(50 + 48 * Math.cos(angle)).toFixed(2)}%; --y: ${(50 + 48 * Math.sin(angle)).toFixed(2)}%; --k: ${k}`
})
const lookerCounts = counts({
  "zugriff-2016": lookers.filter((l) => l.step === "zugriff-2016").length,
  "zugriff-2026": lookers.length,
})

// ---------- Ergebnis --------------------------------------------------------
const { first, latest, convictions } = reportField
const side = (count: number) => Math.sqrt(count / latest)
const fieldStyle = [
  `--per-row: ${Math.ceil(Math.sqrt(latest))}`,
  `--first: ${side(first).toFixed(4)}`,
  `--red-side: ${side(convictions).toFixed(4)}`,
].join("; ")
const reportCounts = counts({
  "ergebnis-2005": first,
  "ergebnis-2025": latest,
  "ergebnis-urteile": convictions,
})
const fieldSteps = ["ergebnis-2005", "ergebnis-2025", "ergebnis-urteile"]
  .map(at)
  .join(",")
const coinSteps = ["ergebnis-euro", "ergebnis-krypto"].map(at).join(",")
const coins = Array.from({ length: 100 }, (_, k) => k)
---

<section
  class="film"
  aria-labelledby="film-title"
  data-film
  data-locale={locale}
  data-today={thisYear}
  data-scenes={JSON.stringify(items.map((item) => item.scene))}
  data-chapters={JSON.stringify(items.map((item) => item.chapter))}
  data-ids={JSON.stringify(items.map((item) => item.id))}
  data-years={JSON.stringify(items.map((item) => item.years ?? null))}
>
  <h2 id="film-title" class="visually-hidden">
    {en ? "The story of over-regulation" : "Die Geschichte der Überregulierung"}
  </h2>

  <div class="track" aria-hidden="true">
    {items.map((item) => (
      <div class="spacer" id={`film-${item.id}`} data-spacer={item.i} />
    ))}
  </div>

  <div class="stage">
    <nav class="rail" aria-label={en ? "Chapters" : "Kapitel"}>
      <ol>
        {chapters.map((chapter, k) => (
          <li>
            <a
              href={`#film-${steps[firstOf(chapter.id)].id}`}
              data-chapter={chapter.id}
            >
              <span>{k + 1}</span> {chapter.label[language]}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="view" data-view data-scene={items[0].scene}>
      <div class="says">
        {items.map((item) => (
          <div
            class="say"
            data-say={item.i}
            data-current={item.i === 0 ? "" : undefined}
          >
            <h3>{item.title[language]}</h3>
            {item.text && <p class="say-text">{item.text[language]}</p>}
            <ul class="say-sources">
              {item.sources.map((source) => (
                <li>
                  <a href={source.href}>{source.label[language]}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="scenes" aria-hidden="true">
        <!-- Ausweis -->
        <div class="scene" data-scene-id="threshold">
          <p class="big">
            <strong data-counts={idCounts}>{n(real(thresholds[0]))}</strong>
            <span
              >{en ? "euros, today’s money" : "Euro, in heutigem Geld"}</span
            >
          </p>
          <ul class="steps">
            {bars.map((bar) => (
              <li class:list={{ zero: bar.zero }} data-at={bar.at} style={bar.style}>
                <span class="steps-year">{bar.year}</span>
                <span class="steps-track"><span class="steps-bar" /></span>
                {bar.then && <span class="steps-then">{bar.then}</span>}
              </li>
            ))}
          </ul>
        </div>

        <!-- Regeln -->
        <div class="scene" data-scene-id="rules">
          <p class="big">
            <strong data-year class="year"
              >{steps[at("regeln-1977")].years?.[0]}</strong
            >
            <span class="tally"
              ><b data-rule-count>0</b> {en ? "rules" : "Regeln"}
              <span data-rule-ahead-wrap hidden
                >, <b data-rule-ahead>0</b> {en ? "coming" : "kommen"}</span
              ></span
            >
          </p>
          <div class="rule-piles">
            {rulePiles.map((p) => (
              <div class="rule-pile">
                <ol>
                  {p.cards.map((card) => (
                    <li
                      class:list={["rule-card", card.status]}
                      data-from={card.from}
                      data-until={card.until}
                      data-ahead={card.ahead ? "" : undefined}
                    >
                      <span class="rule-year">{card.from}</span>
                      <span class="rule-what">{card.what}</span>
                    </li>
                  ))}
                </ol>
                <p class="pile-name">{p.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Papier: the first directive beside everything since -->
        <div class="scene" data-scene-id="tower">
          <p class="big">
            <strong data-counts={pageCounts}>{n(firstPages)}</strong>
            <span>{en ? "pages" : "Seiten"}</span>
          </p>
          <div class="piles">
            <div class="paper">
              <div class="stack">
                <span
                  class="sheet first"
                  style={`--from: 0; --pages: ${firstShare}; --k: 0`}
                />
                <span class="stack-tag" style={`--top: ${firstShare}`}>
                  {n(firstPages)}
                </span>
              </div>
              <p class="pile-name">1991</p>
            </div>
            <div class="paper" data-at={at("papier-heute")}>
              <div class="stack">
                {blocks.map((block) => (
                  <span class="sheet" style={block.style} />
                ))}
                <span class="stack-tag" style="--top: 1">{n(totalPages)}</span>
              </div>
              <p class="pile-name">{en ? "Today" : "Heute"}</p>
            </div>
          </div>
        </div>

        <!-- Zugriff -->
        <div class="scene" data-scene-id="register">
          <p class="big">
            <strong data-counts={lookerCounts}>3</strong>
            <span>{en ? "groups of authorities" : "Behördengruppen"}</span>
          </p>
          <div class="ring-wrap">
            <div class="ring">
              <svg viewBox="0 0 100 100" class="ring-lines">
                <circle
                  class="ring-europe"
                  cx="50"
                  cy="50"
                  r="48"
                  data-at={at("zugriff-2029")}
                />
                {ring.map((looker) => (
                  <line
                    x1="50"
                    y1="50"
                    x2={looker.x}
                    y2={looker.y}
                    data-at={looker.at}
                  />
                ))}
              </svg>
              {europe.map((style) => (
                <span
                  class="ring-state"
                  style={style}
                  data-at={at("zugriff-2029")}
                />
              ))}
              <span class="ring-you">{en ? "Your account" : "Dein Konto"}</span>
              {ring.map((looker) => (
                <span class="ring-chip" style={looker.style} data-at={looker.at}>
                  {looker.label}
                </span>
              ))}
              <span class="ring-eu" data-at={at("zugriff-2029")}>
                {en ? "+ 26 EU countries" : "+ 26 EU-Staaten"}
              </span>
            </div>
          </div>
        </div>

        <!-- Ergebnis -->
        <div class="scene" data-scene-id="result">
          <p class="big">
            <strong data-counts={reportCounts} data-only={fieldSteps}>
              {n(first)}
            </strong>
            <span data-only={`${at("ergebnis-2005")},${at("ergebnis-2025")}`}>
              {en ? "reports" : "Meldungen"}
            </span>
            <span class="red" data-only={at("ergebnis-urteile")}>
              {en ? "convictions" : "Verurteilungen"}
            </span>
            <strong class="red" data-only={coinSteps}>
              {en ? "1 euro" : "1 Euro"}
            </strong>
            <span data-only={at("ergebnis-euro")}>
              {en ? "of 100 from crime" : "von 100 aus Straftaten"}
            </span>
            <span data-only={at("ergebnis-krypto")}>
              {en ? "of 100 in crypto" : "von 100 in Krypto"}
            </span>
          </p>
          <div class="result">
            <div class="field-wrap" data-only={fieldSteps}>
              <div class="field" style={fieldStyle}>
                <span class="field-all" data-at={at("ergebnis-2025")} />
                <span class="field-first" />
                <span class="field-red" data-at={at("ergebnis-urteile")} />
                <span class="field-callout" data-at={at("ergebnis-urteile")}>
                  {n(convictions)}
                </span>
              </div>
            </div>
            <div class="coins" data-only={coinSteps}>
              {coins.map((k) => <span class:list={["coin", { red: k === 99 }]} />)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The step whose spacer has crossed the middle of the window is current:
  // it picks the scene, the headline and the chapter, switches on what has
  // appeared so far ([data-at]) or only now ([data-only]), and counts the
  // big figure towards its value. In the rules chapter the year runs with
  // the scroll and the cards drop onto their piles in their year.
  for (const film of document.querySelectorAll<HTMLElement>("[data-film]")) {
    const view = film.querySelector<HTMLElement>("[data-view]")
    if (!view) continue
    const all = (selector: string) => [
      ...film.querySelectorAll<HTMLElement>(selector),
    ]
    const spacers = all("[data-spacer]")
    const says = all("[data-say]")
    const ats = [...film.querySelectorAll<Element>("[data-at]")]
    const onlys = all("[data-only]")
    const links = all("[data-chapter]")
    const counters = all("[data-counts]")
    const cards = all("[data-from]")
    const yearEl = film.querySelector<HTMLElement>("[data-year]")
    const countEl = film.querySelector<HTMLElement>("[data-rule-count]")
    const aheadEl = film.querySelector<HTMLElement>("[data-rule-ahead]")
    const aheadWrap = film.querySelector<HTMLElement>("[data-rule-ahead-wrap]")
    const parse = (key: string) => JSON.parse(film.dataset[key] ?? "[]")
    const stepScenes: string[] = parse("scenes")
    const stepChapters: string[] = parse("chapters")
    const stepIds: string[] = parse("ids")
    const stepYears: ([number, number] | null)[] = parse("years")
    const today = Number(film.dataset.today)
    const motion = matchMedia("(prefers-reduced-motion: reduce)")
    const format = (value: number) =>
      new Intl.NumberFormat(film.dataset.locale).format(Math.round(value))

    const valueAt = (map: Record<string, number>, i: number) => {
      let value: number | undefined
      for (let k = 0; k <= i; k++) if (k in map) value = map[k]
      return value
    }

    const tween = (el: HTMLElement, to: number) => {
      const from = Number(el.dataset.value ?? to)
      el.dataset.value = String(to)
      el.classList.toggle("zero", to === 0)
      if (motion.matches || from === to) {
        el.textContent = format(to)
        return
      }
      const start = performance.now()
      const run = (now: number) => {
        const t = Math.min(1, (now - start) / 800)
        el.textContent = format(from + (to - from) * (1 - (1 - t) ** 3))
        if (t < 1 && el.dataset.value === String(to)) requestAnimationFrame(run)
      }
      requestAnimationFrame(run)
    }

    let shownYear = 0
    const scrub = (year: number) => {
      if (year === shownYear) return
      shownYear = year
      if (yearEl) {
        yearEl.textContent = String(year)
        yearEl.classList.toggle("future", year > today)
      }
      let count = 0
      let ahead = 0
      for (const card of cards) {
        const from = Number(card.dataset.from)
        const until = card.dataset.until
          ? Number(card.dataset.until)
          : Number.POSITIVE_INFINITY
        const on = from <= year
        card.classList.toggle("on", on)
        card.classList.toggle("gone", on && year > until)
        if (!on) continue
        if (card.hasAttribute("data-ahead")) ahead++
        else if (year <= until) count++
      }
      if (countEl) countEl.textContent = String(count)
      if (aheadEl) aheadEl.textContent = String(ahead)
      if (aheadWrap) aheadWrap.hidden = ahead === 0
    }

    let current = -1
    const show = (i: number) => {
      current = i
      view.dataset.scene = stepScenes[i]
      view.dataset.stepId = stepIds[i]
      for (const say of says)
        say.toggleAttribute("data-current", Number(say.dataset.say) === i)
      for (const el of ats)
        el.classList.toggle(
          "on",
          Number(
            (el as HTMLElement).dataset?.at ?? el.getAttribute("data-at"),
          ) <= i,
        )
      for (const el of onlys)
        el.classList.toggle(
          "on",
          (el.dataset.only ?? "").split(",").map(Number).includes(i),
        )
      for (const link of links) {
        const here = link.dataset.chapter === stepChapters[i]
        if (here && !link.hasAttribute("aria-current")) {
          const list = link.closest("ol")
          list?.scrollTo({
            left: link.offsetLeft - (list.clientWidth - link.offsetWidth) / 2,
            behavior: motion.matches ? "auto" : "smooth",
          })
        }
        if (here) link.setAttribute("aria-current", "step")
        else link.removeAttribute("aria-current")
      }
      for (const el of counters) {
        const value = valueAt(JSON.parse(el.dataset.counts ?? "{}"), i)
        if (value !== undefined) tween(el, value)
      }
    }

    let queued = false
    const render = () => {
      queued = false
      const middle = window.innerHeight * 0.55
      let i = 0
      spacers.forEach((spacer, k) => {
        if (spacer.getBoundingClientRect().top <= middle) i = k
      })
      if (i !== current) show(i)
      const span = stepYears[i]
      if (span) {
        const box = spacers[i].getBoundingClientRect()
        // The span is run through by four fifths of the step.
        const p = Math.min(
          1,
          Math.max(0, (middle - box.top) / (box.height * 0.8)),
        )
        scrub(Math.round(span[0] + (span[1] - span[0]) * p))
      } else {
        const last = stepYears.slice(0, i).filter(Boolean).at(-1)
        if (last) scrub(last[1])
      }
      const box = film.getBoundingClientRect()
      document.documentElement.toggleAttribute(
        "data-immersive",
        box.top <= window.innerHeight * 0.2 && box.bottom >= window.innerHeight,
      )
    }
    const queue = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(render)
    }
    for (const el of counters)
      el.dataset.value = el.textContent?.replace(/\D/g, "") || "0"
    window.addEventListener("scroll", queue, { passive: true })
    window.addEventListener("resize", queue)
    film.toggleAttribute("data-ready", true)
    render()
  }
</script>

<style>
  /* Wie die Datengeschichte der Startseite: die Bühne füllt das Fenster und
     steht, während die Schritte vorbeiziehen. */
  .film {
    --pace: min(1svh, 0.76rem);
    --bar: light-dark(#3b4147, #a7afb6);
    --red: var(--primary);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .track,
  .stage {
    grid-area: 1 / 1;
  }

  .track {
    padding-block: calc(50svh - var(--header-height) / 2 - 40 * var(--pace))
      calc(20 * var(--pace));
  }

  .spacer {
    block-size: calc(80 * var(--pace));
    scroll-margin-block-start: calc(var(--header-height) - 30 * var(--pace));
  }

  .stage {
    position: sticky;
    inset-block-start: var(--header-height);
    align-self: start;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--space-xs);
    block-size: calc(100dvh - var(--header-height));
    padding-block: var(--space-xs) var(--space-s);
  }

  /* Ohne Skript stehen die Schlagzeilen untereinander. */
  .film:not([data-ready]) :is(.track, .scenes, .rail) {
    display: none;
  }

  .film:not([data-ready]) .stage {
    position: static;
    block-size: auto;
  }

  .film:not([data-ready]) .says {
    gap: var(--space-l);
  }

  .film:not([data-ready]) .say {
    grid-area: auto;
  }

  /* ---------- Kapitel-Leiste -------------------------------------------- */

  .rail {
    border-block-end: 1px solid var(--line);
  }

  .rail ol {
    display: flex;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .rail a {
    display: block;
    padding: 0.55rem 0.5rem 0.6rem;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    white-space: nowrap;
    text-decoration: none;
    box-shadow: inset 0 -2px transparent;
    transition:
      color 0.2s,
      box-shadow 0.2s;
  }

  .rail a span {
    font-weight: var(--weight-heading);
  }

  .rail a:hover,
  .rail a[aria-current] {
    color: var(--foreground);
  }

  .rail a[aria-current] {
    box-shadow: inset 0 -2px var(--accent);
  }

  /* ---------- Bühne ----------------------------------------------------- */

  /* Schmal: das Bild oben, die Schlagzeile in einer Leiste darunter.
     Breit: links die Schlagzeile, rechts das Bild. */
  .view {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    min-block-size: 0;
    border-radius: var(--radius-xl);
    background: var(--panel);
    overflow: clip;
  }

  .scenes {
    position: relative;
    grid-row: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    min-block-size: 0;
    container-type: size;
  }

  .says {
    grid-row: 2;
    display: grid;
    align-content: start;
    min-block-size: clamp(7.5rem, 22svh, 9.5rem);
    padding: var(--space-s) var(--space-m) var(--space-m);
    border-block-start: 1px solid var(--line);
    background: var(--paper);
  }

  @container campaign (width >= 60rem) {
    .view {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: minmax(0, 1fr);
    }

    .scenes {
      grid-column: 2;
      grid-row: 1;
    }

    .says {
      grid-column: 1;
      grid-row: 1;
      align-content: center;
      min-block-size: 0;
      padding: var(--space-xl);
      border: 0;
      background: none;
    }
  }

  .say {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    transition:
      opacity 0.35s ease,
      translate 0.35s ease;
  }

  .film[data-ready] .say:not([data-current]) {
