---
import SourceRefs from "@/components/SourceRefs.astro"
import { ruleChronicle } from "@/data/aml-history"
import { historyAsOf, isAhead } from "@/data/history"
import {
  germanConvictionsByYear,
  germanReportsByYear,
  recovery,
} from "@/data/history-gap"
import { historySources } from "@/data/history-sources"
import {
  chapters,
  inTodaysMoney,
  pile,
  reportField,
  type Scene,
  steps,
  thresholds,
} from "@/data/overregulation"
import cashBrick from "@/assets/history/cash-brick.webp"
import cashCent from "@/assets/history/cash-cent.webp"
import cashSlim from "@/assets/history/cash-slim.webp"
import noteCrime from "@/assets/history/note-crime.webp"
import type { Language } from "@/lib/i18n"

// The story of over-regulation as a scroll film, built like the home
// page's data story: the stage stands while the steps scroll past. Each
// step is a headline of a few words and turns one picture into a contrast
// you see before you read it: the amount from which you must show ID
// falling to nothing, checks and reports set on every way money can take,
// six pages beside 488, a sea of reports beside a few convictions, and
// a 100-euro note that crumbles to a red sliver. Grey is what is collected, red what
// comes of it or what is new. Each step cites its sources by number from
// the list at the end of the page (src/data/history-sources.ts). Without
// the script the headlines stand as text one below the other.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const locale = en ? "en-GB" : "de-DE"
const n = (value: number) => new Intl.NumberFormat(locale).format(value)
const { cite } = historySources(language)

const index = new Map(steps.map((step, i) => [step.id, i]))
const at = (id: string) => {
  const i = index.get(id)
  if (i === undefined) throw new Error(`Film: no step "${id}"`)
  return i
}
const sceneOf = new Map(chapters.map((chapter) => [chapter.id, chapter.scene]))
const items = steps.map((step, i) => ({
  ...step,
  i,
  scene: sceneOf.get(step.chapter) as Scene,
}))
const thisYear = new Date(historyAsOf).getUTCFullYear()

// ---------- Ausweis ---------------------------------------------------------
const real = (t: (typeof thresholds)[number]) => inTodaysMoney(t.amount, t.year)
// What one transaction without an account could move without showing ID,
// in today's money, rendered at true scale in Blender from the same
// camera (scripts/artwork/render-cash.py): 339 notes of 100 euros, then 13
// of 100 and one of 50, today a single cent. All three stay in view, so
// the amounts compare.
const piles = [cashBrick, cashSlim, cashCent]
const widest = Math.max(...piles.map((image) => image.width))
const cashRows = thresholds.map((t, k) => {
  const image = piles[k] ?? cashCent
  const amount = real(t)
  return {
    at: at(t.step),
    year: t.year,
    zero: t.amount === 0,
    image,
    style: `--w: ${((image.width / widest) * 100).toFixed(2)}%`,
    value:
      t.amount === 0
        ? en
          ? "From the first cent"
          : "Ab dem ersten Cent"
        : en
          ? `€${n(amount)}`
          : `${n(amount)} €`,
    detail:
      t.amount === 0
        ? en
          ? "ID for every crypto transfer through a provider"
          : "Ausweis bei jeder Krypto-Übertragung über einen Anbieter"
        : `${en ? "then" : "damals"} ${n(t.amount)} ${t.unit === "ECU" ? "ECU" : "€"}`,
  }
})

// ---------- Regeln ----------------------------------------------------------
// The ways money can take, and the checks set on them year by year: a check
// at the bank or provider (ID, monitoring, a cap) or an automatic report to
// the tax office. Each mark is a row of the chronicle; the rules about
// companies and advisers stay out, they are in the list to check. The year
// runs with the scroll; a way counts as covered once a mark on it applies.
const rowsById = new Map(
  ruleChronicle.stack.flatMap((group) =>
    group.rows.map((row) => [
      row.id,
      { row, tax: (group.domain?.id ?? "steuern") === "steuern" },
    ]),
  ),
)
const statusOf = new Map(ruleChronicle.entries.map((e) => [e.id, e.status]))
const wayList: {
  id: string
  label: { de: string; en: string }
  rows: string[]
}[] = [
  {
    id: "konto",
    label: { de: "Konto", en: "Bank account" },
    rows: [
      "ausweis",
      "verdacht",
      "sorgfalt",
      "kontenregister",
      "dac5",
      "register-eu",
    ],
  },
  {
    id: "depot",
    label: { de: "Wertpapiere", en: "Securities" },
    rows: ["depot"],
  },
  {
    id: "sparbuch",
    label: { de: "Sparbuch", en: "Savings book" },
    rows: ["sparbuch"],
  },
  {
    id: "ausland",
    label: { de: "Konto im Ausland", en: "Account abroad" },
    rows: ["zinsrichtlinie", "dac2"],
  },
  {
    id: "einkommen",
    label: { de: "Einkommen im Ausland", en: "Income abroad" },
    rows: ["dac1", "neufassung"],
  },
  {
    id: "plattform",
    label: { de: "Online-Plattformen", en: "Online platforms" },
    rows: ["dac7"],
  },
  {
    id: "krypto",
    label: { de: "Krypto", en: "Crypto" },
    rows: ["krypto-anbieter", "uebertragung", "dac8", "anonym-2027"],
  },
  {
    id: "bargeld",
    label: { de: "Bargeld", en: "Cash" },
    rows: ["bargeld-2027"],
  },
]
// Geometry in a square of 1000 units around its centre: spokes start at
// the centre's rim and end at a node; the marks sit along them in the
// order they came.
const C = 500
const polar = (angle: number, r: number) => ({
  x: C + Math.cos(angle) * r,
  y: C + Math.sin(angle) * r,
})
const spoke = { from: 112, to: 330, node: 360, first: 142, gap: 33 }
const ways = wayList.map((way, k) => {
  const angle = -Math.PI / 2 + (k / wayList.length) * Math.PI * 2
  const start = polar(angle, spoke.from)
  const end = polar(angle, spoke.to)
  const node = polar(angle, spoke.node)
  const marks = way.rows
    .map((id) => {
      const found = rowsById.get(id)
      if (!found) throw new Error(`Film: no rule "${id}"`)
      return found
    })
    .sort((a, b) => a.row.from - b.row.from)
    .map(({ row, tax }, m) => {
      const at = polar(angle, spoke.first + m * spoke.gap)
      // A check is a bar across the way; a report a dot on it.
      const across = { x: -Math.sin(angle) * 22, y: Math.cos(angle) * 22 }
      return {
        tax,
        from: row.from,
        until: row.until,
        ahead: isAhead(statusOf.get(row.id) ?? "past"),
        what: row.what[language],
        x: at.x,
        y: at.y,
        bar: `M${(at.x - across.x).toFixed(1)} ${(at.y - across.y).toFixed(1)} L${(at.x + across.x).toFixed(1)} ${(at.y + across.y).toFixed(1)}`,
      }
    })
  const below = Math.sin(angle) > -0.2
  return {
    ...way,
    label: way.label[language],
    line: `M${start.x.toFixed(1)} ${start.y.toFixed(1)} L${end.x.toFixed(1)} ${end.y.toFixed(1)}`,
    node,
    marks,
    style: `--x: ${(node.x / 10).toFixed(2)}%; --y: ${(node.y / 10).toFixed(2)}%`,
    below,
  }
})
// For the script: every mark with its way, to switch them by year and to
// name the newest.
const wayRules = JSON.stringify(
  ways
    .flatMap((way) =>
      way.marks.map((mark) => ({
        way: way.id,
        from: mark.from,
        until: mark.until,
        what: mark.what,
        ahead: mark.ahead,
      })),
    )
    .sort((a, b) => a.from - b.from),
)

// ---------- Papier ----------------------------------------------------------
const totalPages = pile.reduce((sum, block) => sum + block.pages, 0)
const firstPages = pile[0].pages
const pages = Array.from({ length: totalPages }, (_, k) => k)

// ---------- Ergebnis --------------------------------------------------------
// One grain per report on a canvas (src/lib/film-sand.ts): which state
// belongs to which step.
const { first, latest, convictions } = reportField
const sandStates = JSON.stringify({
  [at("ergebnis-2005")]: "first",
  [at("ergebnis-2025")]: "all",
  [at("ergebnis-urteile")]: "heap",
})
const fieldSteps = ["ergebnis-2005", "ergebnis-2025", "ergebnis-urteile"]
  .map(at)
  .join(",")
// Germany as a race from the same start (src/lib/film-race.ts): from the
// first year with both counts, each year's count as a multiple of it.
const raceStep = at("ergebnis-de")
const reportsBy = new Map(
  germanReportsByYear.map((row) => [row.year, row.reports]),
)
const convictionsBy = new Map(
  germanConvictionsByYear.map((row) => [row.year, row.convictions]),
)
const raceFirst = Math.max(
  germanReportsByYear[0].year,
  germanConvictionsByYear[0].year,
)
const raceLast = germanReportsByYear[germanReportsByYear.length - 1].year
const raceYears = Array.from(
  { length: raceLast - raceFirst + 1 },
  (_, k) => raceFirst + k,
)
const series = (by: Map<number, number>) => {
  const start = by.get(raceFirst) ?? 1
  const values = raceYears.map((year) => by.get(year) ?? null)
  return {
    values,
    times: values.map((value) => (value === null ? null : value / start)),
  }
}
const raceReports = series(reportsBy)
const raceConvictions = series(convictionsBy)
const race = JSON.stringify({
  years: raceYears,
  reports: raceReports.times,
  convictions: raceConvictions.times,
  values: {
    reports: raceReports.values,
    convictions: raceConvictions.values,
  },
  locale,
})
// A 100-euro note crumbles into dust on a canvas (src/lib/film-note.ts)
// until the share confiscated remains, as Europol last estimated it.
const noteStep = at("ergebnis-euro")
const kept = recovery.latest.percent
const euro = (value: number) => (en ? `€${n(value)}` : `${n(value)} €`)
const noteKeep = String(kept / 100)
---

<section
  class="film"
  aria-labelledby="film-title"
  data-film
  data-today={thisYear}
  data-scenes={JSON.stringify(items.map((item) => item.scene))}
  data-ids={JSON.stringify(items.map((item) => item.id))}
  data-years={JSON.stringify(items.map((item) => item.years ?? null))}
>
  <h2 id="film-title" class="visually-hidden">
    {en ? "The story of over-regulation" : "Die Geschichte der Überregulierung"}
  </h2>

  <div class="track" aria-hidden="true">
    {items.map((item) => (
      <div class="spacer" id={`film-${item.id}`} data-spacer={item.i} />
    ))}
  </div>

  <div class="stage">
    <div class="view" data-view data-scene={items[0].scene}>
      <div class="says">
        {items.map((item) => (
          <div
            class="say"
            data-say={item.i}
            data-current={item.i === 0 ? "" : undefined}
          >
            <h3>{item.title[language]}</h3>
            <p class="say-text">
              {item.text?.[language]}
              <SourceRefs sources={cite(item.sources)} language={language} />
            </p>
          </div>
        ))}
        <!-- Back and forth by click as well as by scroll. -->
        <nav
          class="film-nav"
          aria-label={en ? "Steps of the story" : "Schritte der Geschichte"}
        >
          <button
            type="button"
            data-film-prev
            aria-label={en ? "Previous step" : "Vorheriger Schritt"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <span class="film-count" aria-live="polite">
            <b data-film-at>1</b>
            / {items.length}
          </span>
          <button
            type="button"
            data-film-next
            aria-label={en ? "Next step" : "Nächster Schritt"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </nav>
      </div>

      <div class="scenes" aria-hidden="true">
        <!-- Ausweis -->
        <div class="scene" data-scene-id="threshold">
          <ol class="cash">
            {cashRows.map((row) => (
              <li class:list={["cash-row", { zero: row.zero }]} data-at={row.at} style={row.style}>
                <span class="cash-pile">
                  <img src={row.image.src} width={row.image.width} height={row.image.height} alt="" decoding="async" />
                </span>
                <p class="cash-label">
                  <span class="cash-year">{row.year}</span>
                  <b>{row.value}</b>
                  <span>{row.detail}</span>
                </p>
              </li>
            ))}
          </ol>
          <p class="scene-caption">
            {en
              ? "At true scale, in today’s money: as much as a single transaction without an account could move without ID."
              : "Maßstabsgetreu, in heutigem Geld: so viel durfte ein einzelnes Geschäft ohne Konto bewegen, ohne Ausweis."}
          </p>
        </div>

        <!-- Regeln -->
        <div class="scene" data-scene-id="rules">
          <div class="ways-wrap" data-ways={wayRules}>
            <p class="ways-new" data-ways-new />
            <div class="ways">
              <svg viewBox="0 0 1000 1000">
                {[195, 278, 360].map((r) => (
                  <circle class="ways-ring" cx="500" cy="500" r={r} />
                ))}
                {ways.map((way) => (
                  <g class="way" data-way={way.id}>
                    <path class="way-line" d={way.line} />
                    <circle class="way-node" cx={way.node.x} cy={way.node.y} r="26" />
                    {way.marks.map((mark) =>
                      mark.tax ? (
                        <circle
                          class:list={["way-mark", "report", { ahead: mark.ahead }]}
                          cx={mark.x}
                          cy={mark.y}
                          r="15"
                          data-from={mark.from}
                          data-until={mark.until}
                        />
                      ) : (
                        <path
                          class:list={["way-mark", "check", { ahead: mark.ahead }]}
                          d={mark.bar}
                          data-from={mark.from}
                          data-until={mark.until}
                        />
                      ),
                    )}
                  </g>
                ))}
                <circle class="ways-core" cx="500" cy="500" r="104" />
              </svg>
              {ways.map((way) => (
                <span class:list={["way-label", { below: way.below }]} data-way-label={way.id} style={way.style}>
                  {way.label}
                </span>
              ))}
              <p class="ways-centre">
                <strong data-year>{steps[at("regeln-1977")].years?.[0]}</strong>
                <span>{en ? "your money" : "dein Geld"}</span>
              </p>
            </div>
            <p class="ways-count">
              <b data-ways-count>0</b>
              {en ? `of ${ways.length} ways covered` : `von ${ways.length} Wegen erfasst`}
            </p>
            <p class="ways-key">
              <span class="key-check">
                {en ? "Check at the bank or provider: ID, monitoring, a cap" : "Kontrolle bei Bank oder Anbieter: Ausweis, Überwachung, Obergrenze"}
              </span>
              <span class="key-report">
                {en ? "Automatic report to the tax office" : "Automatische Meldung ans Finanzamt"}
              </span>
            </p>
          </div>
        </div>

        <!-- Papier: one tile per page, the first six red -->
        <div class="scene" data-scene-id="tower">
          <div class="wall-wrap" data-wall>
            <div class="wall" data-at={at("papier-heute")}>
              {pages.map((k) => (
                <span class:list={["page", { first: k < firstPages }]} style={`--k: ${k}`} />
              ))}
            </div>
          </div>
          <p class="scene-caption">
            {en
              ? "One square per page in the EU Official Journal; red, the first directive of 1991."
              : "Ein Kästchen je Seite im Amtsblatt der EU, rot die erste Richtlinie von 1991."}
          </p>
        </div>

        <!-- Ergebnis -->
        <div class="scene" data-scene-id="result">
          <div class="result">
            <div
              class="sand"
              data-sand={sandStates}
              data-sand-counts={JSON.stringify({ first, latest, convictions })}
              data-only={fieldSteps}
            >
              <canvas />
              <i data-sand-grey />
              <i data-sand-red />
              <span class="sand-label" data-sand-label="reports">
                <b>{n(latest)}</b>
                {en ? "reports" : "Meldungen"}
              </span>
              <span class="sand-label red" data-sand-label="convictions">
                <b>{n(convictions)}</b>
                {en ? "convictions" : "Verurteilungen"}
              </span>
            </div>
            <div class="race" data-race={race} data-only={String(raceStep)}>
              <p class="race-year">
                <b data-race-year>{raceFirst}</b>
              </p>
              <div class="race-plot">
                <div class="race-inner">
                  <span class="race-base" data-race-base>
                    <span>{raceFirst} = ×1</span>
                  </span>
                  <div class="race-col reports" data-race-col="reports">
                    <span class="race-times" data-race-times>×1</span>
                    <span class="race-bar" />
                  </div>
                  <div class="race-col convictions" data-race-col="convictions">
                    <span class="race-times" data-race-times>×1</span>
                    <span class="race-bar" />
                  </div>
                </div>
              </div>
              <div class="race-labels">
                <p class="reports">
                  <b>{en ? "Suspicion reports" : "Verdachtsmeldungen"}</b>
                  <span
                    >{n(raceReports.values[0] ?? 0)}
                    → {n(reportsBy.get(raceLast) ?? 0)}</span
                  >
                </p>
                <p class="convictions">
                  <b
                    >{en ? "Convicted of money laundering" : "Verurteilte wegen Geldwäsche"}</b
                  >
                  <span
                    >{n(raceConvictions.values[0] ?? 0)}
                    →
                    {n(germanConvictionsByYear[germanConvictionsByYear.length - 1].convictions)}
                    ({germanConvictionsByYear[germanConvictionsByYear.length - 1].year})</span
                  >
                </p>
              </div>
            </div>
            <div
              class="note"
              data-note={noteKeep}
              data-note-image={noteCrime.src}
              data-note-step={noteStep}
              data-only={String(noteStep)}
            >
              <canvas />
              <i data-note-paper />
              <i data-note-edge />
              <i data-note-line />
              <i data-note-red />
              <span class="note-label kept" data-note-label="kept">
                <b>{euro(kept)}</b>
                {en ? "confiscated" : "eingezogen"}
              </span>
              <span class="note-label gone" data-note-label="gone">
                <b>{euro(100 - kept)}</b>
                {en ? "not confiscated" : "nicht eingezogen"}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createNote } from "@/lib/film-note"
  import { createRace } from "@/lib/film-race"
  import { createSand, type SandState } from "@/lib/film-sand"

  // The step whose spacer has crossed the middle of the window is current:
  // it picks the scene and the headline and switches on what has appeared
  // so far ([data-at]) or only now ([data-only]). In the rules chapter the
  // year runs with the scroll and the marks of each year appear.
  for (const film of document.querySelectorAll<HTMLElement>("[data-film]")) {
    const view = film.querySelector<HTMLElement>("[data-view]")
    if (!view) continue
    const all = (selector: string) => [
      ...film.querySelectorAll<HTMLElement>(selector),
    ]
    const spacers = all("[data-spacer]")
    const prev = film.querySelector<HTMLButtonElement>("[data-film-prev]")
    const next = film.querySelector<HTMLButtonElement>("[data-film-next]")
    const stepAt = film.querySelector<HTMLElement>("[data-film-at]")
    const says = all("[data-say]")
    const ats = [...film.querySelectorAll<Element>("[data-at]")]
    const onlys = all("[data-only]")
    const waysRoot = film.querySelector<HTMLElement>("[data-ways]")
    const newest = film.querySelector<HTMLElement>("[data-ways-new]")
    const counter = film.querySelector<HTMLElement>("[data-ways-count]")
    const rules: {
      way: string
      from: number
      until?: number
      what: string
      ahead: boolean
    }[] = JSON.parse(waysRoot?.dataset.ways ?? "[]")
    const marks = [
      ...(waysRoot?.querySelectorAll<SVGElement>(".way-mark") ?? []),
    ]
    const wayEls = [
      ...(waysRoot?.querySelectorAll<SVGElement>("[data-way]") ?? []),
    ]
    const wayLabels = [
      ...(waysRoot?.querySelectorAll<HTMLElement>("[data-way-label]") ?? []),
    ]
    const yearEl = film.querySelector<HTMLElement>("[data-year]")
    const parse = (key: string) => JSON.parse(film.dataset[key] ?? "[]")
    const stepScenes: string[] = parse("scenes")
    const stepIds: string[] = parse("ids")
    const stepYears: ([number, number] | null)[] = parse("years")
    const today = Number(film.dataset.today)
    // The rules chapter: the year runs with the scroll, the marks that apply
    // by then are set on their ways, and the newest one is named.
    let shownYear = 0
    const scrub = (year: number) => {
      if (year === shownYear) return
      shownYear = year
      if (yearEl) {
        yearEl.textContent = String(year)
        yearEl.classList.toggle("future", year > today)
      }
      const live = rules.filter((rule) => rule.from <= year)
      const applies = (from: number, until?: number) =>
        from <= year && year <= (until ?? Number.POSITIVE_INFINITY)
      for (const mark of marks) {
        const from = Number(mark.dataset.from)
        const until = mark.dataset.until
          ? Number(mark.dataset.until)
          : undefined
        mark.classList.toggle("on", from <= year)
        mark.classList.toggle("ended", until !== undefined && year > until)
      }
      const covered = new Set(
        live
          .filter((rule) => applies(rule.from, rule.until))
          .map((rule) => rule.way),
      )
      for (const el of [...wayEls, ...wayLabels]) {
        const id = el.dataset.way ?? el.dataset.wayLabel ?? ""
        el.classList.toggle("covered", covered.has(id))
      }
      if (counter) counter.textContent = String(covered.size)
      const last = live.at(-1)
      if (newest) {
        newest.textContent = last ? `${last.from} · ${last.what}` : ""
        newest.classList.toggle("ahead", Boolean(last?.ahead))
      }
    }

    // The result chapter's grains, one per report.
    const sandRoot = film.querySelector<HTMLElement>("[data-sand]")
    const sandStates: Record<string, SandState> = JSON.parse(
      sandRoot?.dataset.sand ?? "{}",
    )
    const sand = sandRoot
      ? createSand(sandRoot, JSON.parse(sandRoot.dataset.sandCounts ?? "{}"))
      : null
    // The last step's note, which crumbles each time the step comes up.
    const noteRoot = film.querySelector<HTMLElement>("[data-note]")
    const note = noteRoot
      ? createNote(noteRoot, Number(noteRoot.dataset.note))
      : null
    const noteStep = Number(noteRoot?.dataset.noteStep ?? -1)
    // Germany's race, run each time its step comes up.
    const raceRoot = film.querySelector<HTMLElement>("[data-race]")
    const race = raceRoot ? createRace(raceRoot) : null
    const raceStep = Number(raceRoot?.dataset.only ?? -1)

    let current = -1
    const show = (i: number) => {
      const previous = current
      current = i
      const sandState = sandStates[i]
      if (sandState) sand?.go(sandState, previous in sandStates)
      else sand?.hide()
      if (i === noteStep) note?.go(previous !== -1)
      else note?.hide()
      if (i === raceStep) race?.go()
      else race?.hide()
      view.dataset.scene = stepScenes[i]
      view.dataset.stepId = stepIds[i]
      if (stepAt) stepAt.textContent = String(i + 1)
      if (prev) prev.disabled = i === 0
      for (const say of says)
        say.toggleAttribute("data-current", Number(say.dataset.say) === i)
      for (const el of ats)
        el.classList.toggle(
          "on",
          Number(
            (el as HTMLElement).dataset?.at ?? el.getAttribute("data-at"),
          ) <= i,
        )
      for (const el of onlys)
        el.classList.toggle(
          "on",
          (el.dataset.only ?? "").split(",").map(Number).includes(i),
        )
    }

    // The wall of pages: the column count at which all tiles are largest.
    const wallWrap = film.querySelector<HTMLElement>("[data-wall]")
    const wall = wallWrap?.firstElementChild as HTMLElement | null
    const fit = () => {
      if (!wallWrap || !wall) return
      const count = wall.children.length
      const { width, height } = wallWrap.getBoundingClientRect()
      if (!width || !height) return
      const gap = 2
      let best = { cols: 1, tile: 0 }
      for (let cols = 6; cols <= 60; cols++) {
        const rows = Math.ceil(count / cols)
        const tile = Math.min(
          (width - gap * (cols - 1)) / cols,
          ((height - gap * (rows - 1)) / rows) * (5 / 6),
        )
        if (tile > best.tile) best = { cols, tile }
      }
      wall.style.setProperty("--cols", String(best.cols))
      wall.style.setProperty("--tile", `${Math.floor(best.tile * 10) / 10}px`)
    }

    let queued = false
    const render = () => {
      queued = false
      const middle = window.innerHeight * 0.55
      let i = 0
      spacers.forEach((spacer, k) => {
        if (spacer.getBoundingClientRect().top <= middle) i = k
      })
      if (i !== current) show(i)
      const span = stepYears[i]
      if (span) {
        const box = spacers[i].getBoundingClientRect()
        // The span is run through by four fifths of the step.
        const p = Math.min(
          1,
          Math.max(0, (middle - box.top) / (box.height * 0.8)),
        )
        scrub(Math.round(span[0] + (span[1] - span[0]) * p))
      } else {
        const last = stepYears.slice(0, i).filter(Boolean).at(-1)
        if (last) scrub(last[1])
      }
      const box = film.getBoundingClientRect()
      document.documentElement.toggleAttribute(
        "data-immersive",
        box.top <= window.innerHeight * 0.2 && box.bottom >= window.innerHeight,
      )
    }
    const queue = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(render)
    }
    window.addEventListener("scroll", queue, { passive: true })
    window.addEventListener("resize", () => {
      fit()
      queue()
    })
    if (wallWrap) new ResizeObserver(fit).observe(wallWrap)
    // The buttons scroll to the step before or after: a little way into
    // it, or, where the year runs, to its end, so the year runs through.
    const reduce = matchMedia("(prefers-reduced-motion: reduce)")
    const goTo = (j: number) => {
      const behavior = reduce.matches ? "auto" : "smooth"
      if (j >= spacers.length) {
        const after = film.getBoundingClientRect().bottom + window.scrollY
        window.scrollTo({ top: after - 80, behavior })
        return
      }
      const box = spacers[Math.max(0, j)].getBoundingClientRect()
      const into = stepYears[Math.max(0, j)] ? 0.86 : 0.3
      window.scrollTo({
        top:
          window.scrollY +
          box.top -
          window.innerHeight * 0.55 +
          box.height * into,
        behavior,
      })
    }
    prev?.addEventListener("click", () => goTo(current - 1))
    next?.addEventListener("click", () => goTo(current + 1))
    film.toggleAttribute("data-ready", true)
    render()
  }
</script>

<style>
  /* Wie die Datengeschichte der Startseite: die Bühne füllt das Fenster und
     steht, während die Schritte vorbeiziehen. */
  .film {
    --pace: min(1svh, 0.76rem);
    --bar: light-dark(#3b4147, #a7afb6);
    --red: var(--primary);
    /* Die Hunderter am Anfang und am Ende des Films. */
