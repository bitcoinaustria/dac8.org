  }

  .film-nav button:hover {
    border-color: var(--ink-3);
    background: var(--paper);
  }

  .film-nav button:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .film-nav button:disabled {
