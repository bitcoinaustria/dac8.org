    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .film-count b {
    color: var(--foreground);
    font-weight: 700;
  }

  /* ---------- Szenen ---------------------------------------------------- */

  .scene {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-s);
    min-block-size: 0;
    padding: var(--space-m);
    opacity: 0;
    visibility: hidden;
    scale: 0.97;
    transition:
      opacity 0.5s ease,
      scale 0.5s ease,
      visibility 0.5s;
  }

  .view[data-scene="threshold"] [data-scene-id="threshold"],
  .view[data-scene="rules"] [data-scene-id="rules"],
  .view[data-scene="tower"] [data-scene-id="tower"],
  .view[data-scene="result"] [data-scene-id="result"] {
    opacity: 1;
    visibility: visible;
    scale: 1;
  }

  /* Die Szenen zeigen ihre Zahl im Bild, nicht als zweite Überschrift:
     links steht die Aussage, rechts der Beleg. */
  .scene-caption {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  /* ---------- Ausweis --------------------------------------------------- */

  /* Drei Haufen untereinander, im selben Maßstab: der Ziegel von 1991, der
     dünne Stapel von 2017, heute ein Cent. Jeder bleibt stehen, wenn der
     nächste kommt; der aktuelle ist hell, die früheren treten zurück. */
  .cash {
    --pile: min(58cqi, (100cqh - 9rem) * 0.86, 30rem);
    display: grid;
    align-content: center;
    gap: clamp(0.4rem, 2.5cqh, 1.4rem);
    min-block-size: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cash-row {
    display: grid;
    grid-template-columns: var(--pile) minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.8rem, 3cqi, 2rem);
    opacity: 0;
    translate: 0 -1.2rem;
    transition:
      opacity 0.6s ease,
      translate 0.7s cubic-bezier(0.3, 1.4, 0.5, 1),
      filter 0.6s ease;
  }

  .cash-row.on {
    opacity: 1;
    translate: 0 0;
  }

  /* Was vorher galt, tritt zurück, bleibt aber lesbar. */
  .view[data-step-id="ausweis-2017"] .cash-row:not(.zero):first-child,
  .view[data-step-id="ausweis-heute"] .cash-row:not(.zero) {
    opacity: 0.5;
    filter: saturate(0.4);
  }

  .cash-pile {
    display: grid;
    justify-items: center;
  }

  .cash-pile img {
    display: block;
    inline-size: var(--w);
    block-size: auto;
  }

  .cash-label {
    display: grid;
    gap: 0.1rem;
    color: var(--ink-3);
    font-size: var(--type-meta);
    line-height: 1.3;
  }

  .cash-year {
    font-weight: 600;
  }

  .cash-label b {
    color: var(--foreground);
    font-size: clamp(1.4rem, 0.9rem + 2.6cqi, 2.6rem);
    font-weight: var(--weight-heading);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .cash-row.zero b,
  .cash-row.zero .cash-year {
    color: var(--accent);
  }

  /* ---------- Regeln ---------------------------------------------------- */

  /* Dein Geld in der Mitte, acht Wege hinaus. Mit jedem Jahr kommen rote
     Marken dazu: ein Balken quer über den Weg für eine Kontrolle bei Bank
     oder Anbieter, ein Punkt für eine Meldung ans Finanzamt. Erfasste Wege
     färben sich rot. */
  .ways-wrap {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    justify-items: center;
    gap: var(--space-2xs);
    min-block-size: 0;
  }

  .ways-new {
    min-block-size: 1.3em;
    color: var(--accent);
    font-size: var(--type-meta);
    font-weight: 600;
    text-align: center;
    text-wrap: balance;
  }

  .ways-new.ahead {
    color: var(--ink-3);
  }

  .ways {
    position: relative;
    container-type: inline-size;
    align-self: center;
    inline-size: min(100%, 100cqh - 7.5rem);
    aspect-ratio: 1;
  }

  /* Ringe wie auf einem Radarschirm. */
  .ways-ring {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 3 9;
  }

  .ways svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .way-line {
    stroke: var(--ink-3);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.6;
    transition:
      stroke 0.5s ease,
      stroke-width 0.5s ease,
      opacity 0.5s ease;
  }

  .way.covered .way-line {
    stroke: var(--red);
    stroke-width: 7;
    opacity: 0.55;
  }

  .way-node {
    fill: var(--panel);
    stroke: var(--ink-3);
    stroke-width: 3;
    transition:
      fill 0.5s ease,
      stroke 0.5s ease;
  }

  .way.covered .way-node {
    fill: var(--red);
    stroke: var(--red);
    filter: drop-shadow(
      0 0 10px color-mix(in oklab, var(--red) 70%, transparent)
    );
  }

  .way-mark {
    opacity: 0;
    scale: 0.2;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.35s ease,
      scale 0.45s cubic-bezier(0.3, 1.8, 0.5, 1),
      fill 0.4s ease,
      stroke 0.4s ease;
  }

  .way-mark.on {
    opacity: 1;
    scale: 1;
  }

  .way-mark.check {
    fill: none;
    stroke: var(--red);
    stroke-width: 12;
    stroke-linecap: round;
  }

  .way-mark.on:not(.ahead, .ended) {
    filter: drop-shadow(
      0 0 6px color-mix(in oklab, var(--red) 60%, transparent)
    );
  }

  .way-mark.report {
    fill: var(--red);
    stroke: var(--panel);
    stroke-width: 4;
  }

  /* Beschlossen oder vorgeschlagen, aber noch nicht in Kraft. */
  .way-mark.check.ahead {
    stroke-dasharray: 6 6;
    stroke-width: 7;
  }

  .way-mark.report.ahead {
    fill: var(--panel);
    stroke: var(--red);
    stroke-dasharray: 5 4;
  }

  /* Die Zinsrichtlinie fiel 2015 weg, für den umfassenderen Kontenaustausch. */
  .way-mark.ended {
    opacity: 0.35;
    fill: var(--ink-3);
    stroke: var(--ink-3);
  }

  .ways-core {
    fill: var(--paper);
    stroke: var(--line);
    stroke-width: 2;
  }

  .way-label {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    max-inline-size: 8.5em;
    translate: -50% calc(-100% - 3.4cqi);
    color: var(--ink-2);
    font-size: clamp(0.72rem, 0.55rem + 1.6cqi, 0.95rem);
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: normal;
    transition: color 0.5s ease;
  }

  .way-label.below {
    translate: -50% 3.4cqi;
  }

  .way-label.covered {
    color: var(--accent);
  }

  .ways-centre {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
