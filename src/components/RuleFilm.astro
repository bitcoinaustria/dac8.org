  }

  .ways-centre strong {
    color: var(--foreground);
    font-size: clamp(1.3rem, 0.6rem + 5.5cqi, 2.6rem);
    font-weight: var(--weight-heading);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .ways-centre strong.future {
    color: var(--ink-3);
  }

  .ways-centre span {
    color: var(--ink-3);
    font-size: clamp(0.65rem, 0.5rem + 1.3cqi, 0.85rem);
  }

  .ways-count {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--ink-2);
    font-size: var(--type-meta);
  }

  .ways-count b {
    color: var(--accent);
    font-size: clamp(1.6rem, 1rem + 2.5cqi, 2.4rem);
    font-weight: var(--weight-heading);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .ways-key {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem 1.1rem;
    color: var(--ink-3);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .ways-key span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .key-check::before {
    content: "";
    inline-size: 0.25rem;
    block-size: 0.8rem;
    border-radius: 2px;
    background: var(--red);
  }

  .key-report::before {
    content: "";
    inline-size: 0.6rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
  }

  /* ---------- Papier ---------------------------------------------------- */

  /* Eine Kachel je Seite im Amtsblatt. Das Skript wählt die Spaltenzahl,
     bei der alle 488 am größten in den Platz passen. */
  .wall-wrap {
    display: grid;
    place-items: center;
    min-block-size: 0;
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(var(--cols, 24), var(--tile, 1rem));
    gap: 2px;
  }

  .page {
    aspect-ratio: 5 / 6;
    border: 1px solid var(--material-edge);
    border-radius: 1px;
    background:
      linear-gradient(var(--line), var(--line)) 20% 30% / 60% 1px no-repeat,
      linear-gradient(var(--line), var(--line)) 20% 50% / 60% 1px no-repeat,
      linear-gradient(var(--line), var(--line)) 20% 70% / 40% 1px no-repeat,
      var(--paper);
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.3s ease calc(var(--k) * 2ms),
      scale 0.3s ease calc(var(--k) * 2ms);
  }

  .view[data-scene="tower"] .page.first,
  .wall.on .page {
    opacity: 1;
    scale: 1;
  }

  /* Die sechs Seiten von 1991, rot. */
  .page.first {
    border-color: var(--accent);
    background: var(--red);
  }

  /* ---------- Ergebnis -------------------------------------------------- */

  .result {
    display: grid;
    place-items: center;
    min-block-size: 0;
  }

  .sand,
  .note {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0.5s;
  }

  .sand.on,
  .note.on {
    opacity: 1;
    visibility: visible;
  }

  /* Ein Korn je Meldung, auf einer Leinwand (src/lib/film-sand.ts). Die
     beiden Farbproben liest das Skript, damit Hell und Dunkel stimmen. */
  .sand {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
  }

  .sand canvas {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .sand [data-sand-grey] {
    display: none;
    color: var(--bar);
  }

  .sand [data-sand-red] {
    display: none;
    color: var(--red);
  }

  /* Über den Haufen, sobald sie liegen. */
  .sand-label {
    position: absolute;
    display: grid;
    justify-items: center;
    translate: -50% -100%;
    color: var(--ink-2);
    font-size: var(--type-meta);
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .sand-label b {
    color: var(--foreground);
    font-size: var(--step-2);
    font-weight: var(--weight-heading);
    letter-spacing: -0.02em;
  }

  .sand-label.red {
    justify-items: end;
    translate: -100% -100%;
    color: var(--accent);
  }

  .sand-label.red b {
    color: var(--accent);
  }

  .sand-label.red.below {
    translate: -100% 0;
  }

  .sand[data-state="heap"]
    :is([data-sand-label="reports"], [data-sand-label="convictions"]) {
    opacity: 1;
    transition-delay: 2.5s;
  }

  .sand[data-state="heap"] [data-sand-label="convictions"] {
    transition-delay: 3.6s;
  }

  /* Deutschland als Rennen: beide Säulen beginnen 2008 bei ×1, dann laufen
     die Jahre, und der Maßstab zieht mit den Meldungen davon. */
  .result > .race {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0.5s;
  }

  .result > .race.on {
    opacity: 1;
