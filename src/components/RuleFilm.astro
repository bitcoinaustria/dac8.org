    .view .ways {
      inline-size: min(100%, (100cqh - 7rem) * 1.111);
    }
  }

  .film:not([data-ready]) .film-nav {
    display: none;
  }

  .film-nav button {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--panel);
    color: var(--foreground);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  .film-nav button:hover {
    border-color: var(--ink-3);
    background: var(--paper);
  }

  .film-nav button:focus-visible {
