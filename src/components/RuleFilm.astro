    cursor: default;
  }

  .film-nav svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .film-count b {
    color: var(--foreground);
    font-weight: 700;
  }

  /* ---------- Szenen ---------------------------------------------------- */

  .scene {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-s);
    min-block-size: 0;
    padding: var(--space-m);
    opacity: 0;
    visibility: hidden;
    scale: 0.97;
    transition:
      opacity 0.5s ease,
      scale 0.5s ease,
      visibility 0.5s;
  }

  .view[data-scene="threshold"] [data-scene-id="threshold"],
  .view[data-scene="rules"] [data-scene-id="rules"],
  .view[data-scene="watch"] [data-scene-id="rules"],
  .view[data-scene="tower"] [data-scene-id="tower"],
  .view[data-scene="result"] [data-scene-id="result"] {
    opacity: 1;
    visibility: visible;
    scale: 1;
  }

  /* Die Szenen zeigen ihre Zahl im Bild, nicht als zweite Überschrift:
     links steht die Aussage, rechts der Beleg. */
  .scene-caption {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  /* ---------- Ausweis --------------------------------------------------- */

  /* Drei Haufen untereinander, im selben Maßstab: der Ziegel von 1991, der
     dünne Stapel von 2017, heute ein Cent. Jeder bleibt stehen, wenn der
     nächste kommt; der aktuelle ist hell, die früheren treten zurück. */
  .cash {
    --pile: min(58cqi, (100cqh - 9rem) * 0.86, 30rem);
    display: grid;
    align-content: center;
    gap: clamp(0.4rem, 2.5cqh, 1.4rem);
    min-block-size: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cash-row {
    display: grid;
    grid-template-columns: var(--pile) minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.8rem, 3cqi, 2rem);
    opacity: 0;
    translate: 0 -1.2rem;
    transition:
      opacity 0.6s ease,
      translate 0.7s cubic-bezier(0.3, 1.4, 0.5, 1),
      filter 0.6s ease;
  }

  .cash-row.on {
    opacity: 1;
    translate: 0 0;
  }

  /* Was vorher galt, tritt zurück, bleibt aber lesbar. */
  .view[data-step-id="ausweis-2017"] .cash-row:not(.zero):first-child,
  .view[data-step-id="ausweis-heute"] .cash-row:not(.zero) {
    opacity: 0.5;
    filter: saturate(0.4);
  }

  .cash-pile {
    display: grid;
    justify-items: center;
  }

  .cash-pile img {
    display: block;
    inline-size: var(--w);
    block-size: auto;
  }

  .cash-label {
    display: grid;
    gap: 0.1rem;
    color: var(--ink-3);
    font-size: var(--type-meta);
    line-height: 1.3;
  }

  .cash-year {
    font-weight: 600;
  }

  .cash-label b {
    color: var(--foreground);
    font-size: clamp(1.4rem, 0.9rem + 2.6cqi, 2.6rem);
    font-weight: var(--weight-heading);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .cash-row.zero b,
  .cash-row.zero .cash-year {
    color: var(--accent);
  }

  /* ---------- Regeln ---------------------------------------------------- */

  /* Dein Geld in der Mitte, acht Wege hinaus. Mit jedem Jahr kommen rote
     Marken dazu: ein Balken quer über den Weg für eine Kontrolle bei Bank
     oder Anbieter, ein Punkt für eine Meldung ans Finanzamt. Erfasste Wege
     färben sich rot. */
  .ways-wrap {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    gap: var(--space-2xs);
    min-block-size: 0;
  }

  .ways {
    position: relative;
    container-type: inline-size;
    isolation: isolate;
    align-self: center;
    inline-size: min(100%, (100cqh - 3rem) * 1.111);
    aspect-ratio: 1600 / 1440;
  }

  /* Das Panoptikum bei Nacht, darüber je Zelle ihr Licht: ein roter
     Scheinwerfer vom Turm durch das Gitter, aufgehellt durch Bildschirm-
     Mischung, sobald eine Regel auf diesem Weg gilt. */
  .ways-base,
  .way-light {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border-radius: var(--radius);
  }

  .way-light {
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 0.9s ease;
  }

  .way-light.covered {
    opacity: 1;
  }

  /* Im Kapitel Zugriff bleiben die Zellen hell, aber gedämpft; im Turm
     geht je Behörde ein Fenster an. */
  .view[data-scene="watch"] .way-light.covered {
    opacity: 0.45;
  }

  .watch-light {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border-radius: var(--radius);
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 0.9s ease;
  }

  .view[data-scene="watch"] .watch-light.on {
    opacity: 1;
  }

  .view[data-scene="watch"] .ways-centre {
    opacity: 0;
  }

  /* Wer hineinschaut, unter dem Bild, eine Behörde nach der anderen. */
  .watchers {
    display: none;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15em 0.9em;
    max-inline-size: 36rem;
    margin: 0;
    padding: 0;
    color: var(--ink-3);
    font-size: var(--type-meta);
    list-style: none;
  }

  .view[data-scene="watch"] .watchers {
