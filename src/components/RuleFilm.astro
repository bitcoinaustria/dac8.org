    font-weight: var(--weight-heading);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .ways-centre strong.future {
    color: #aab0b8;
  }

  /* ---------- Papier ---------------------------------------------------- */

  /* Eine Kachel je Seite im Amtsblatt. Das Skript wählt die Spaltenzahl,
     bei der alle 488 am größten in den Platz passen. */
  .wall-wrap {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: 0;
  }

  /* Eine Seite, die gerade vorliest. */
  .page.speaking {
    border-color: var(--accent);
    background: color-mix(in oklab, var(--red) 55%, var(--paper));
    box-shadow: 0 0 0.8rem color-mix(in oklab, var(--red) 60%, transparent);
    animation: page-speak 0.9s ease-in-out infinite alternate;
  }

  @keyframes page-speak {
    to {
      scale: 1.35;
    }
  }

  /* Was gerade gelesen wird, wörtlich, mit Fundstelle. */
  .wall-voice {
    position: absolute;
    inset-inline: 4%;
    inset-block-end: 3%;
    display: grid;
    gap: 0.35rem;
    padding: 0.7rem 1rem;
    border-inline-start: 4px solid var(--red);
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    box-shadow: 0 0.6rem 2rem rgb(0 0 0 / 0.35);
    color: var(--foreground);
    font-size: clamp(0.8rem, 0.7rem + 0.4vw, 1rem);
    line-height: 1.4;
    opacity: 0;
    translate: 0 0.6rem;
    transition:
      opacity 0.4s ease,
      translate 0.4s ease;
    pointer-events: none;
  }

  .wall-voice.on {
    opacity: 1;
    translate: 0 0;
  }

  .wall-voice small {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  /* Lange Passagen enden nach wenigen Zeilen mit Auslassung. */
  .wall-voice span {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }

  @container campaign (width < 60rem) {
    .wall-voice {
      font-size: 0.8rem;
      line-height: 1.35;
    }

    .wall-voice small {
      font-size: 0.72rem;
    }

    .wall-voice span {
      -webkit-line-clamp: 4;
      line-clamp: 4;
    }
  }

  /* Der Lautsprecher: oben rechts im Bild, nur im Kapitel Papier. */
  .film-voice {
    position: absolute;
    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
    z-index: 3;
    display: grid;
    place-items: center;
    inline-size: 3rem;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--panel);
    color: var(--foreground);
    box-shadow: 0 0.4rem 1.2rem rgb(0 0 0 / 0.25);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    scale: 0.8;
    transition:
      opacity 0.35s ease,
      visibility 0.35s,
      scale 0.35s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .view[data-scene="tower"] .film-voice {
    opacity: 1;
    visibility: visible;
    scale: 1;
  }

  .film:not([data-ready]) .film-voice {
    display: none;
  }

  .film-voice:hover {
    border-color: var(--ink-3);
  }

  .film-voice:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .film-voice svg {
    inline-size: 1.4rem;
    block-size: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

