    text-shadow: 0 1px 6px rgb(0 0 0 / 0.9);
    /* Auf dem nächtlichen Bild hell, in beiden Farbschemata. */
    color: #d9dde3;
    font-size: clamp(0.7rem, 0.5rem + 1.6cqi, 0.95rem);
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: normal;
    transition: color 0.5s ease;
  }

  .way-label.covered {
    color: #ff5a55;
  }

  /* Das Jahr groß in der Ecke des Bildes. */
  .ways-centre {
    position: absolute;
    inset-block-start: 3%;
    inset-inline-start: 3.5%;
    pointer-events: none;
  }

  .ways-centre strong {
    color: #fff;
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.8);
