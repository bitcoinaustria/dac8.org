  }

  /* Platz für die Liste unter dem Bild. */
  .view[data-scene="watch"] .ways {
    inline-size: min(100%, (100cqh - 14rem) * 1.111);
  }

  .watchers li {
    opacity: 0.25;
    transition:
      opacity 0.5s ease,
      color 0.5s ease;
  }

  .watchers li.on {
