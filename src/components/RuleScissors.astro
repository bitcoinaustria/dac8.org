---
import SourceRefs from "@/components/SourceRefs.astro"
import { ruleChronicle } from "@/data/aml-history"
import { historyAsOf, isAhead } from "@/data/history"
import {
  formatNumber,
  reportsByYear,
  reportsByYearSources,
} from "@/data/history-evidence"
import {
  germanReportsByYear,
  germanReportsSources,
  recovery,
} from "@/data/history-gap"
import { unmeasured } from "@/data/history-promises"
import { historySources } from "@/data/history-sources"
import { steps } from "@/data/overregulation"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

// The scissors, run with the scroll: the panel stands while the years run
// from 2005 to today. Grey rises what the apparatus grows by, each line on
// its own scale from zero to its highest value: the rules in force and the
// suspicion reports in Austria and Germany. Red lies what is confiscated
// of 100 euros from crime, on a scale of 100 euros. The gap between them
// opens, and in it, year by year, an institution says that what a rule
// brings is not or cannot be measured (src/data/history-promises.ts,
// unmeasured). Without the script the chart stands complete with the
// statements listed beneath it.
const { language } = Astro.props
const en = language === "en"
const n = (value: number) => formatNumber(value, language)
const { cite } = historySources(language)

const first = 2005
const last = new Date(historyAsOf).getUTCFullYear()
// Horizontal position in percent; heights in the plot as a share of its
// height, with a little room at the top for the line heads.
const X = (year: number) => ((year - first) / (last - first)) * 100
const room = 0.05
const Y = (share: number) => (room + (1 - share) * (1 - room)) * 100

// Rules in force each year, as on the film's curve.
const statusOf = new Map(ruleChronicle.entries.map((e) => [e.id, e.status]))
const rows = ruleChronicle.stack.flatMap((group) => group.rows)
const inForce = (year: number) =>
  rows.filter(
    (row) =>
      !isAhead(statusOf.get(row.id) ?? "past") &&
      row.from <= year &&
      year <= (row.until ?? Number.POSITIVE_INFINITY),
  ).length

type Point = { year: number; value: number }
const yearsTo = (to: number) =>
  Array.from({ length: to - first + 1 }, (_, k) => first + k)
const grey = [
  {
    id: "rules",
    label: en ? "Rules in force" : "Geltende Regeln",
    step: true,
    points: yearsTo(last).map((year) => ({ year, value: inForce(year) })),
  },
  {
    id: "at",
    label: en ? "Suspicion reports, Austria" : "Verdachtsmeldungen Österreich",
    step: false,
    points: reportsByYear.map((row) => ({
      year: row.year,
      value: row.reports,
    })),
  },
  {
    id: "de",
    label: en ? "Suspicion reports, Germany" : "Verdachtsmeldungen Deutschland",
    step: false,
    points: germanReportsByYear.map((row) => ({
      year: row.year,
      value: row.reports,
    })),
  },
].map((series) => {
  const top = Math.max(...series.points.map((p) => p.value))
  const share = (p: Point) => p.value / top
  const at = (p: Point) =>
    `${(X(p.year) * 10).toFixed(1)} ${(Y(share(p)) * 10).toFixed(1)}`
  const path = series.step
    ? series.points
        .map((p, k) =>
          k
            ? `H${(X(p.year) * 10).toFixed(1)} V${(Y(share(p)) * 10).toFixed(1)}`
            : `M${at(p)}`,
        )
        .join(" ")
    : series.points.map((p, k) => `${k ? "L" : "M"}${at(p)}`).join(" ")
  const end = series.points[series.points.length - 1]
  return {
    ...series,
    path,
    end,
    // For the script: year, share of the top and the value itself.
    data: series.points.map((p) => [p.year, share(p), p.value]),
  }
})

// Red: confiscated of 100 euros, measured for 2010 to 2014, estimated
// again for 2025, nothing between.
const { measured, latest } = recovery
const redAt = (year: number, percent: number) =>
  `${(X(year) * 10).toFixed(1)} ${(Y(percent / 100) * 10).toFixed(1)}`
const red = {
  measured: `M${redAt(measured.from, measured.percent)} L${redAt(measured.to, measured.percent)}`,
  unknown: `M${redAt(measured.to, measured.percent)} L${redAt(latest.year, latest.percent)}`,
}
const redShare = (year: number) => {
  if (year < measured.from) return 0
  if (year <= measured.to) return measured.percent / 100
  const k = Math.min(1, (year - measured.to) / (latest.year - measured.to))
  return (measured.percent + (latest.percent - measured.percent) * k) / 100
}

// The gap: from the lowest grey line down to the red one (or the floor
// before the first estimate), year by year, as a clip path in percent.
const greyShare = (year: number) => {
  const shares = grey.flatMap((series) => {
    const top = Math.max(...series.points.map((p) => p.value))
    const point = series.points.find((p) => p.year === year)
    return point ? [point.value / top] : []
  })
  return shares.length ? Math.min(...shares) : 1
}
const gapYears = yearsTo(Math.max(...grey.map((series) => series.end.year)))
const gapEnd = gapYears[gapYears.length - 1]
const gap = `polygon(${[
  ...gapYears.map(
    (year) => `${X(year).toFixed(2)}% ${Y(greyShare(year)).toFixed(2)}%`,
  ),
  ...[...gapYears]
    .reverse()
    .map((year) => `${X(year).toFixed(2)}% ${Y(redShare(year)).toFixed(2)}%`),
].join(", ")})`

// The statements, each marked in the gap at its year, halfway between
// the lowest grey line and the red one.
const said = unmeasured.map((item, k) => {
  const year = item.said.year
  const upper = greyShare(Math.min(year, gapEnd))
  return {
    ...item,
    k,
    year,
    style: `--x: ${X(year).toFixed(2)}%; --y: ${Y((upper + redShare(year)) / 2).toFixed(2)}%`,
  }
})

// The scroll runs in beats: the first from the start to the year before
// the first statement, then one beat to each statement's year.
const years = said.map((item) => item.year)
const beats = [
  [first, years[0] - 1],
  ...years.map((year, k) => [k ? years[k - 1] : years[0] - 1, year]),
]
const ticks = [2005, 2010, 2015, 2020, 2025].map((year) => ({
  year,
  style: `--at: ${X(year).toFixed(2)}%`,
}))

const euros = (value: number) => (en ? `€${n(value)}` : `${n(value)} €`)
const redLabels = {
  none: en ? "not yet estimated" : "noch nicht geschätzt",
  measured: {
    value: euros(measured.percent),
    note: en
      ? `estimate for ${measured.from}–${measured.to}`
      : `Schätzung für ${measured.from}–${measured.to}`,
  },
  latest: {
    value: en
      ? `about ${euros(latest.percent)}`
      : `rund ${euros(latest.percent)}`,
    note: en ? `estimate ${latest.year}` : `Schätzung ${latest.year}`,
  },
}
const script = JSON.stringify({
  first,
  last,
  beats,
  grey: grey.map((series) => ({
    id: series.id,
    step: series.step,
    data: series.data,
  })),
  red: { measured, latest, labels: redLabels },
  room,
  locale: en ? "en-GB" : "de-DE",
  from: en ? "figure for" : "Wert von",
})
const sources = [
  ...(steps.find((step) => step.id === "regeln-heute")?.sources ?? []),
  ...reportsByYearSources,
  ...germanReportsSources,
  ...recovery.sources,
]
const count = said.length
---

<div class="sx" data-scissors={script} style={`--beats: ${beats.length}`}>
  <div class="sx-stage">
    <div class="sx-panel">
      <p class="sx-year" aria-hidden="true">
        <span data-sx-year>{last}</span>
      </p>

      <ul class="sx-board">
        {grey.map((series) => (
          <li class:list={["sx-cell", series.id]} data-cell={series.id}>
            <b data-value>{n(series.end.value)}</b>
            <span class="sx-what">{series.label}</span>
            <span class="sx-when" data-when>
              {series.end.year < last && `${en ? "figure for" : "Wert von"} ${series.end.year}`}
            </span>
          </li>
        ))}
        <li class="sx-cell red" data-cell="red">
          <b data-value>{redLabels.latest.value}</b>
          <span class="sx-what"
            >{en ? "Of €100 from crime, confiscated" : "Von 100 € aus Straftaten eingezogen"}</span
          >
          <span class="sx-when" data-when>{redLabels.latest.note}</span>
        </li>
      </ul>

      <div class="sx-ticker">
        <p class="sx-say intro" data-say="-1">
          {en
            ? "Grey, what grows: rules and suspicion reports. Red, what is confiscated of 100 euros from crime. Scroll, and the years run."
            : "Grau, was wächst: Regeln und Verdachtsmeldungen. Rot, was von 100 € aus Straftaten eingezogen wird. Scrolle, und die Jahre laufen."}
        </p>
        {said.map((item) => (
          <figure class="sx-say" data-say={item.k}>
            <figcaption>
              <b>{item.year}</b>
              {item.who[language]}
            </figcaption>
            <blockquote>
              <p>
                {item.words[language]}
                <SourceRefs sources={cite([item.said.source])} language={language} />
              </p>
            </blockquote>
          </figure>
        ))}
      </div>

      <div class="sx-plot" aria-hidden="true">
        <span class="sx-top" />
        <span class="sx-hundred">100 €</span>
        <div class="sx-reveal">
          <div class="sx-gap" style={`clip-path: ${gap}`} />
          <svg viewBox="0 0 1000 1000" preserveAspectRatio="none">
            <line class="sx-floor" x1="0" x2="1000" y1="1000" y2="1000" />
            {grey.map((series) => (
              <path class:list={["sx-line", series.id]} d={series.path} />
            ))}
            <path class="sx-red unknown" d={red.unknown} />
            <path class="sx-red" d={red.measured} />
          </svg>
        </div>
        {said.map((item) => (
          <span class="sx-mark" data-mark={item.k} style={item.style}>
            <span>{item.year}</span>
          </span>
        ))}
        {grey.map((series) => (
          <span class:list={["sx-head", series.id]} data-head={series.id} />
        ))}
        <span class="sx-head red" data-head="red" />
      </div>

      <div class="sx-axis" aria-hidden="true">
        {ticks.map((tick) => <span style={tick.style}>{tick.year}</span>)}
      </div>
    </div>
  </div>
</div>

<p class="sx-note">
  {en
    ? `Grey, each line on its own scale from zero to its highest value; red on a scale of 100 euros. Dashed: not estimated in between. Austria changed how it counts suspicion reports in 2012, 2024 and 2025, Germany in 2017. The ${count} statements each come from one of the pairs below, where they stand in context.`
    : `Grau je Linie auf eigenem Maßstab, von null bis zum höchsten Wert; rot auf einem Maßstab von 100 €. Gestrichelt: dazwischen nicht geschätzt. Österreich zählt die Verdachtsmeldungen seit 2012, 2024 und 2025 anders, Deutschland seit 2017. Die ${count} Aussagen stammen je aus einem der Paare weiter unten, wo sie im Zusammenhang stehen.`}
  <SourceRefs sources={cite(sources)} language={language} />
</p>

<script>
  // The year follows the scroll through the track: each beat runs to the
  // year of the next statement, then holds it while the statement stands.
  type Series = { id: string; step: boolean; data: [number, number, number][] }
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-scissors]",
  )) {
    const config = JSON.parse(root.dataset.scissors ?? "{}")
    const stage = root.querySelector<HTMLElement>(".sx-stage")
    const yearEl = root.querySelector<HTMLElement>("[data-sx-year]")
    if (!stage || !yearEl) continue
    const beats: [number, number][] = config.beats
    const grey: Series[] = config.grey
    const format = new Intl.NumberFormat(config.locale)
    const says = [...root.querySelectorAll<HTMLElement>("[data-say]")]
    const marks = [...root.querySelectorAll<HTMLElement>("[data-mark]")]
    const heads = new Map(
      [...root.querySelectorAll<HTMLElement>("[data-head]")].map((el) => [
        el.dataset.head,
        el,
      ]),
    )
    const cells = new Map(
      [...root.querySelectorAll<HTMLElement>("[data-cell]")].map((el) => [
        el.dataset.cell,
        {
          value: el.querySelector<HTMLElement>("[data-value]"),
          when: el.querySelector<HTMLElement>("[data-when]"),
        },
      ]),
    )
    const statementYears = beats.slice(1).map((beat) => beat[1])
    const span = config.last - config.first
    const x = (year: number) => ((year - config.first) / span) * 100
    const y = (share: number) =>
      (config.room + (1 - share) * (1 - config.room)) * 100
    const ease = (t: number) =>
      t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2
    const clamp = (t: number) => Math.min(1, Math.max(0, t))

    // A series at a moment: the share drawn and the latest whole year's
    // figure, which is what the board shows.
    const sample = (series: Series, year: number) => {
      const data = series.data
      if (year < data[0][0]) return null
      let k = data.findIndex((point) => point[0] > year)
      if (k === -1) k = data.length
      const before = data[k - 1]
      const after = data[k]
      const share =
        series.step || !after
          ? before[1]
          : before[1] +
            ((after[1] - before[1]) * (year - before[0])) /
              (after[0] - before[0])
      return { share, value: before[2], year: before[0] }
    }
    const redShare = (year: number) => {
      const { measured, latest } = config.red
      if (year < measured.from) return null
      if (year <= measured.to) return measured.percent / 100
      const k = clamp((year - measured.to) / (latest.year - measured.to))
      return (measured.percent + (latest.percent - measured.percent) * k) / 100
    }

    let shown = -1
    const draw = (year: number) => {
      root.style.setProperty("--p", String(x(year) / 100))
      const whole = Math.floor(year + 1e-6)
      if (whole !== shown) {
        shown = whole
        yearEl.textContent = String(whole)
        for (const series of grey) {
          const cell = cells.get(series.id)
          const now = sample(series, whole)
          if (cell?.value)
            cell.value.textContent = now ? format.format(now.value) : "–"
          if (cell?.when)
            cell.when.textContent =
              now && now.year < whole ? `${config.from} ${now.year}` : ""
        }
        const cell = cells.get("red")
        const { measured, latest, labels } = config.red
        const label =
          whole >= latest.year
            ? labels.latest
            : whole >= measured.from
              ? labels.measured
              : { value: "–", note: labels.none }
        if (cell?.value) cell.value.textContent = label.value
        if (cell?.when) cell.when.textContent = label.note
        // The latest statement up to this year stands; the earlier ones
        // stay marked in the gap.
        const current = statementYears.filter((at) => at <= whole).length - 1
        for (const say of says)
          say.toggleAttribute(
            "data-current",
            Number(say.dataset.say) === current,
          )
        for (const mark of marks) {
          const k = Number(mark.dataset.mark)
          mark.classList.toggle("on", k <= current)
          mark.classList.toggle("now", k === current)
        }
      }
      for (const series of grey) {
        const head = heads.get(series.id)
        const now = sample(series, year)
        if (!head) continue
        head.classList.toggle("on", Boolean(now))
        if (now) {
          // A line that ends before today keeps its head at its end.
          const end = series.data[series.data.length - 1][0]
          head.style.setProperty("--x", `${x(Math.min(year, end))}%`)
          head.style.setProperty("--y", `${y(now.share)}%`)
        }
      }
      const head = heads.get("red")
      const share = redShare(year)
      if (head) {
        head.classList.toggle("on", share !== null)
        head.style.setProperty(
          "--x",
          `${x(Math.min(year, config.red.latest.year))}%`,
        )
        head.style.setProperty("--y", `${y(share ?? 0)}%`)
      }
    }

    let queued = false
    const render = () => {
      queued = false
      const box = root.getBoundingClientRect()
      const top = parseFloat(getComputedStyle(stage).top) || 0
      const travel = box.height - stage.offsetHeight
      const p = travel > 0 ? clamp((top - box.top) / travel) : 1
      const b = Math.min(beats.length - 1, Math.floor(p * beats.length))
      const local = p * beats.length - b
      // A little hold before each run, a longer one after it.
      const run = ease(clamp((local - 0.1) / 0.55))
      const [from, to] = beats[b]
      draw(from + (to - from) * run)
      document.documentElement.toggleAttribute(
        "data-scissors-pinned",
        box.top <= top + 1 && box.bottom >= window.innerHeight,
      )
    }
    const queue = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(render)
    }
    window.addEventListener("scroll", queue, { passive: true })
    window.addEventListener("resize", queue)
    root.toggleAttribute("data-ready", true)
    render()
  }
</script>

<style>
  .sx {
    --beat: min(36svh, 22rem);
    --red: var(--primary);
    --bar: light-dark(#3b4147, #a7afb6);
    --p: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .sx[data-ready] {
    block-size: calc(
      100dvh -
      var(--header-height) +
      var(--beats) *
      var(--beat)
    );
  }

  .sx-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .sx[data-ready] .sx-stage {
    position: sticky;
    inset-block-start: var(--header-height);
    align-self: start;
    block-size: calc(100dvh - var(--header-height));
    padding-block: var(--space-xs) var(--space-s);
  }

  /* Schmal: Jahr, Aussage, Bild, Achse, Tafel untereinander. Breit: oben
     Jahr und Tafel, die Aussage im leeren Feld links oben im Bild. */
  .sx-panel {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto minmax(14rem, 1fr) auto auto;
    grid-template-areas:
      "year"
      "ticker"
      "plot"
      "axis"
      "board";
    gap: var(--space-xs);
    min-block-size: 0;
    padding: var(--space-m);
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  .sx[data-ready] .sx-panel {
    grid-template-rows: auto auto minmax(0, 1fr) auto auto;
  }

  @container campaign (width >= 60rem) {
    .sx-panel {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto minmax(24rem, 1fr) auto auto;
      grid-template-areas:
        "year board"
        "plot plot"
        "axis axis"
        "ticker ticker";
      column-gap: var(--space-xl);
      row-gap: var(--space-s);
      padding: var(--space-l) var(--space-xl) var(--space-m);
    }

    .sx[data-ready] .sx-panel {
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "year board"
        "plot plot"
        "axis axis";
    }

    .sx[data-ready] .sx-ticker {
      grid-area: plot;
      align-self: start;
      justify-self: start;
      z-index: 1;
      max-inline-size: min(30rem, 46%);
      margin-block-start: var(--space-l);
    }
  }

  /* ---------- Jahr und Tafel ------------------------------------------- */

  .sx-year {
    grid-area: year;
    color: var(--foreground);
    font-size: clamp(2.6rem, 1.6rem + 4vw, 5.5rem);
    font-weight: var(--weight-heading);
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .sx-board {
    grid-area: board;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs) var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container campaign (width >= 60rem) {
    .sx-board {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-self: end;
    }
  }

  .sx-cell {
    display: grid;
    align-content: start;
    padding-inline-start: 0.6rem;
    border-inline-start: 3px solid var(--swatch);
    color: var(--ink-3);
    font-size: var(--type-meta);
    line-height: 1.25;
  }

  .sx-cell b {
    color: var(--foreground);
    font-size: clamp(1.15rem, 0.9rem + 1vw, 1.75rem);
    font-weight: var(--weight-heading);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .sx-what {
    color: var(--ink-2);
  }

  .sx-when:empty {
    display: none;
  }

  .sx-cell.red b,
  .sx-cell.red .sx-what {
    color: var(--accent);
  }

  /* Die drei grauen Linien unterscheiden sich in der Helligkeit. */
  .rules {
    --swatch: var(--foreground);
  }

  .at {
    --swatch: light-dark(#6f777e, #a7afb6);
  }

  .de {
    --swatch: light-dark(#aab1b7, #687077);
  }

  .red {
    --swatch: var(--red);
  }

  /* ---------- Aussage --------------------------------------------------- */

  .sx-ticker {
    grid-area: ticker;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .sx[data-ready] .sx-say {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 0.35s ease,
      translate 0.35s ease,
      visibility 0.35s;
  }

  .sx[data-ready] .sx-say[data-current] {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
  }

  .sx:not([data-ready]) .sx-ticker {
    gap: var(--space-s);
  }

  .sx-say {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }

  .sx-say.intro {
    max-inline-size: 34ch;
    color: var(--ink-2);
    font-size: var(--type-lead);
    line-height: 1.35;
  }

  .sx:not([data-ready]) .sx-say.intro {
    display: none;
  }

  .sx-say figcaption {
    color: var(--ink-3);
    font-size: var(--type-meta);
    line-height: 1.3;
  }

  .sx-say figcaption b {
    margin-inline-end: 0.4rem;
    color: var(--accent);
    font-weight: 700;
  }

  .sx-say blockquote {
    margin: 0;
    padding-inline-start: var(--space-s);
    border-inline-start: 4px solid var(--red);
  }

  .sx-say blockquote p {
    color: var(--foreground);
    font-size: clamp(1.15rem, 0.95rem + 1vw, 1.75rem);
    font-weight: var(--weight-heading);
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: pretty;
    overflow-wrap: normal;
    /* Quoted words stay whole. */
    hyphens: manual;
  }

  /* ---------- Bild ------------------------------------------------------ */

  .sx-plot {
    position: relative;
