      white-space: normal;
    }

    .stamp {
      inset-block-end: 2.6rem;
      inset-inline: 0.6rem auto;
      font-size: 1.125rem;
    }

    .sheet {
      gap: 0.4rem;
      padding: 0.75rem 0.9rem;
      font-size: 0.75rem;
    }

    .stack-label {
