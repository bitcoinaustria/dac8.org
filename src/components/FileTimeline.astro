---
import {
  breaches,
  end,
  intro,
  match,
  type Piece,
  reports,
  rows,
} from "@/data/file-timeline"
import { leaks } from "@/data/leaks"
import { type Language, pathFor } from "@/lib/i18n"

// "How scattered leaks become a file", told as a full-screen scroll film.
// The cards scroll past a pinned stage and the scroll position drives it:
// a crowd of dots at true scale, one per thousand people in a leak, the
// copied data scrolling past until Max's line, the file it lands in, a
// search that picks him out, and the reports DAC8 then files every year.
// The cards are the readable version, so the stage stays hidden from
// screen readers. The page renders the stage in its final state; the
// script below rewinds it and plays it along with the scroll.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"

const leakFor = (id: string) => {
  const leak = leaks.find((candidate) => candidate.id === id)
  if (!leak) throw new Error(`Unknown leak: ${id}`)
  return leak
}
const label = (piece: Piece) =>
  rows.find((row) => row.id === piece)?.label[language] ?? piece
// Inside a sentence, English labels go lower case, except abbreviations
// such as "ID".
const inline = (text: string) =>
  en && !/^[A-Z]{2}/.test(text) ? text[0].toLowerCase() + text.slice(1) : text
const list = (pieces: Piece[]) =>
  new Intl.ListFormat(language, { type: "conjunction" }).format(
    pieces.map((piece) => inline(label(piece))),
  )

// Each piece lands once, with the first case that had it; later cases only
// match it.
const seen = new Set<Piece>()
const cases = breaches.map((breach, index) => {
  const leak = leakFor(breach.leak)
  const fields = breach.fields.map((field) => ({
    ...field,
    matched: seen.has(field.piece),
  }))
  for (const field of fields) seen.add(field.piece)
  return {
    ...breach,
    index,
    leak,
    fields,
    // The lines that scroll past before Max's, and a few after it.
    before: [...breach.others, ...breach.others].slice(0, 8),
    after: breach.others.slice(0, 2),
    added: fields.filter((field) => !field.matched).map((field) => field.piece),
    matched: fields
      .filter((field) => field.matched)
      .map((field) => field.piece),
  }
})
const origin = new Map<Piece, number>(
  cases.flatMap((item) =>
    item.added.map((piece) => [piece, item.index] as const),
  ),
)
const tag = (index: number) =>
  `${cases[index].leak.name[language]} ’${String(cases[index].leak.year).slice(2)}`
const people = en ? "people" : "Menschen"

const ending = leakFor(end.leak)
const today = en ? "Today" : "Heute"
const sheets = Array.from(
  { length: reports.count },
  (_, index) => reports.first + index,
)
const last = reports.first + reports.count
// A slightly different tilt for every report on a pile.
const tilt = [-2.2, 1.4, -0.6, 2, -1.6, 0.8, -2.6, 1.8, -1, 0.4]

// The scenes after the intro, for the timeline and its anchors.
const scenes = [
  ...cases.map((item) => ({
    id: item.leak.id,
    year: String(item.leak.year),
    name: item.leak.name[language],
  })),
  { id: "abgleich", year: today, name: match.short[language] },
  {
    id: "dac8",
    year: String(reports.first + 1),
    name: reports.short[language],
  },
  { id: "ende", year: String(last), name: end.short[language] },
]
const source = en ? "Source" : "Quelle"
---

<section
  id="zeitreise"
  class="journey"
  aria-labelledby="journey-heading"
  data-journey
  data-first={reports.first}
  data-locale={en ? "en" : "de-DE"}
  data-report-label={en
    ? `Annual report {n} of ${reports.count}`
    : `Jahresmeldung {n} von ${reports.count}`}
  data-end-people={ending.people}
  data-end-label={`${people} · ${ending.kind[language]} ${ending.name[language]} ${ending.year}`}
>
  <div class="steps">
    <div class="step" id="akte-start" data-step data-year="" style="--len: 160">
      <div class="card intro" tabindex="-1">
        <h2 id="journey-heading">{intro.heading[language]}</h2>
        <p>{intro.text[language]}</p>
        <span class="cue" aria-hidden="true"></span>
      </div>
    </div>

    {cases.map((item) => (
        <div
          class="step"
          id={`akte-${item.leak.id}`}
          data-step
          data-year={item.leak.year}
          style="--len: 170"
        >
          <div class="card" tabindex="-1">
            <p class="kicker">
              <span>{item.leak.year}</span> {item.leak.name[language]}
            </p>
            <h3>{item.leak.headline[language]}</h3>
            <p>{item.text[language]}</p>
            <dl class="delta">
              <div>
                <dt>{en ? "New in the file" : "Neu in der Akte"}</dt>
                <dd>{list(item.added)}</dd>
              </div>
              {item.matched.length > 0 && (
                <div>
                  <dt>{en ? "Matched on" : "Abgeglichen über"}</dt>
                  <dd>{list(item.matched)}</dd>
                </div>
              )}
            </dl>
            <p class="source">
              {source}: {item.leak.sources[0].label[language]}
            </p>
          </div>
        </div>
      ))}

    <div
      class="step"
      id="akte-abgleich"
      data-step
      data-year={today}
      style="--len: 200"
    >
      <div class="card" tabindex="-1">
        <p class="kicker"><span>{today}</span> {match.short[language]}</p>
        <h3>{match.heading[language]}</h3>
        <p>{match.text[language]}</p>
      </div>
    </div>

    <div class="step" id="akte-dac8" data-step style="--len: 190">
      <div class="card" tabindex="-1">
        <p class="kicker">
          <span>{reports.first + 1}</span>
          {reports.short[language]}
        </p>
        <h3>{reports.heading[language]}</h3>
        <p>{reports.text[language]}</p>
      </div>
    </div>

    <div class="step" id="akte-ende" data-step style="--len: 230">
      <div class="card" tabindex="-1">
        <p class="kicker"><span>{last}</span> {end.short[language]}</p>
        <h3>{end.heading[language]}</h3>
        <p>{end.text[language]}</p>
        <p class="closing">{end.closing[language]}</p>
        <p class="source">{source}: {ending.sources[0].label[language]}</p>
        <a class="more" href={pathFor("leaks", language)}
          >{en ? "More cases with sources" : "Mehr Fälle mit Quellen"}</a
        >
      </div>
    </div>
  </div>

  <div class="pin">
    <canvas class="crowd" aria-hidden="true"></canvas>
    <div class="frame">
      <nav
        class="rail"
        aria-label={en ? "Timeline" : "Zeitleiste"}
        style={`--ticks: ${scenes.length}`}
      >
        <ol>
          {scenes.map((scene) => (
              <li>
                <a href={`#akte-${scene.id}`} data-goto>
                  <span class="tick-year">{scene.year}</span>
                  <span class="tick-name">{scene.name}</span>
                </a>
              </li>
            ))}
        </ol>
      </nav>

      <p class="count" aria-hidden="true" data-count-box>
        <b data-count></b>
        <span class="count-label" data-count-label></span>
        <span class="scale">
          {en ? "1 dot = 1,000 people" : "1 Punkt = 1.000 Menschen"}
        </span>
      </p>

      <div class="desk" aria-hidden="true">
        <div class="records">
          {cases.map((item) => (
              <div
                class="record"
                data-record
                data-people={item.leak.people ?? 0}
                data-prefix={item.atLeast ? "≥ " : ""}
                data-label={`${item.unit[language]} · ${item.leak.name[language]} ${item.leak.year}`}
              >
                <p class="record-head">
                  <b>
                    {item.leak.name[language]} {item.leak.year}
                  </b>
                  <span>{item.where[language]}</span>
                </p>
                <div class="feed">
                  <div class="reel">
                    {item.before.map((line) => (
                      <p class="other">{line}</p>
                    ))}
                    <p class="line" data-max>
                      {item.fields.map((field) => (
                        <span
                          class="chip"
                          data-piece={field.piece}
                          data-matched={field.matched ? "" : undefined}
                        >
                          {field.raw[language]}
                        </span>
                      ))}
                    </p>
                    {item.after.map((line) => (
                      <p class="other">{line}</p>
                    ))}
                  </div>
                </div>
              </div>
            ))}

          <div class="query" data-query data-label={match.found[language]}>
            <p class="query-head">
              <span class="spark">✦</span>
              {match.prompt[language]}
            </p>
            <p class="query-text">
              <span data-typed data-text={match.query[language]}
                >{match.query[language]}</span
              ><i class="caret"></i>
            </p>
            <p class="query-result">{match.result[language]}</p>
          </div>
        </div>

        <div class="file-wrap">
          <article
            class="file"
            style={`--hit-label: "${en ? "match" : "Treffer"}"`}
          >
            <header class="file-head">
              <b>{en ? "File" : "Akte"}</b>
              <span class="as-of">
                {en ? "As of" : "Stand"} <span data-year-label>{last}</span>
              </span>
            </header>
            <div class="file-body">
              <div class="portrait">
                <svg viewBox="0 0 64 80">
                  <circle cx="32" cy="29" r="14"></circle>
                  <path d="M6 80c0-17 11.6-28 26-28s26 11 26 28z"></path>
                </svg>
              </div>
              <dl>
                {rows.map((row) => (
                    <div
                      class="row"
                      data-piece={row.id}
                      data-from={origin.get(row.id)}
                    >
                      <dt>{row.label[language]}</dt>
                      <dd>
                        <span class="slot">
                          <span class="value">{row.value[language]}</span>
                          <span class="bar" />
                        </span>
                        {origin.has(row.id) && (
                          <span class="from">
                            {tag(origin.get(row.id) ?? 0)}
                          </span>
                        )}
                      </dd>
                    </div>
                  ))}
              </dl>
            </div>
            <p class="stamp">{en ? "Matched" : "Abgeglichen"}</p>
            <p class="file-foot">
              <b data-known>{rows.length}</b>
              {en
                  ? ` of ${rows.length} details in other hands`
                  : ` von ${rows.length} Angaben in fremden Händen`}
            </p>
          </article>
        </div>

        <div class="stacks">
          {(["provider", "authority"] as const).map((place) => (
              <div class="stack" data-stack={place}>
                <div class="pile">
                  {sheets.map((year, index) => (
                    <div
                      class="sheet"
                      style={`--i: ${index}; --r: ${tilt[index % tilt.length]}deg`}
                    >
                      <p class="sheet-head">
                        <b>DAC8 · {year}</b>
                      </p>
                      <ul>
                        {reports.sheet[language].map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <p class="stack-label">
                  <b data-filed>{reports.count}</b>
                  {reports.places[place][language]}
                </p>
              </div>
            ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Die Akte als Film im Vollbild: Eine dunkle Bühne bleibt stehen, die
     Karten mit dem Text ziehen darüber. Hinten die Menge, ein Punkt je
     tausend Menschen in einem Leck; davor die kopierten Daten, die bis zur
     Zeile von Max durchlaufen, und die Akte, in die seine neuen Angaben
     fliegen. Dann sucht eine KI ihn heraus, und DAC8 legt jedes Jahr eine
     Meldung auf zwei Stapel. Das Skript setzt die Variablen pro Bild; ohne
     Skript steht der Endstand da. */
  .journey {
    --stage: #050608;
    --hi: #ff3b45;
    --text: #f3f2ee;
    --text-2: rgb(243 242 238 / 0.74);
    --text-3: rgb(243 242 238 / 0.5);
    --glass: rgb(14 15 18 / 0.74);
    --edge: rgb(255 255 255 / 0.1);
    --paper-ink: #1d1d1b;
    --paper-ink-3: #736f66;
    --paper-red: #c9000d;
    --mono:
      ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    --desk: 1;
    display: grid;
    color-scheme: dark;
    color: var(--text);
  }

  .steps,
  .pin {
    grid-area: 1 / 1;
  }

  /* ---------- Bühne ---------------------------------------------------- */

  /* Die Bühne füllt den ganzen Bildschirm; die Kopfleiste weicht, solange
     sie steht. Die Fläche reicht per border-image bis an den Rand, ohne die
     Seite breiter zu machen. */
  .pin {
    position: sticky;
    inset-block-start: 0;
    align-self: start;
    block-size: 100svh;
    overflow-y: clip;
    border-image: linear-gradient(var(--stage) 0 0) fill 0 / / 0 100vw;
  }

  .crowd {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: calc(var(--grid-gutter) * -1);
    inline-size: calc(100% + var(--grid-gutter) * 2);
    block-size: 100%;
  }

  .frame {
    position: relative;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: var(--space-2xs);
    block-size: 100%;
    padding-block: var(--space-2xs) var(--space-xs);
  }

  /* ---------- Zähler ---------------------------------------------------- */

  .count {
    --on: 1;
    --scale: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
    min-block-size: 1.9rem;
    margin: 0;
    opacity: var(--on);
    font-variant-numeric: tabular-nums;
  }

  .count b {
    background: linear-gradient(180deg, #fff 40%, rgb(255 255 255 / 0.45));
    background-clip: text;
    color: transparent;
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .count-label {
    color: var(--text-2);
    font-size: 0.75rem;
  }

  .scale {
    color: var(--text-3);
    font-size: 0.6875rem;
    opacity: var(--scale);
  }

  /* ---------- Tisch ----------------------------------------------------- */

  /* Der Tisch kippt beim Einstieg aus der Tiefe nach vorn. */
  .desk {
    position: relative;
    display: grid;
    align-self: start;
    align-content: start;
    gap: var(--space-xs);
    inline-size: min(100%, 34rem);
    margin-inline: auto;
    opacity: var(--desk);
    transform: perspective(1400px) rotateX(calc((1 - var(--desk)) * 28deg))
      translateY(calc((1 - var(--desk)) * 12svh));
    transform-origin: 50% 100%;
  }

  .journey[data-measuring] .desk,
  .journey[data-measuring] .record {
    transform: none;
    translate: none;
  }

  /* Datensätze und Suche liegen übereinander in einer Zelle über der
     Akte; die Flugbahn der Angaben misst das Skript. */
  .records {
    position: relative;
    z-index: 2;
    display: grid;
  }

  .records > * {
    grid-area: 1 / 1;
  }

  .record {
    --show: 0;
    --scan: 1;
    --speed: 0;
    --found: 0;
    --hit: 0;
    --fly: 0;
    --land: 0;
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem 0.55rem;
    border: 1px solid var(--edge);
    border-radius: var(--radius-lg);
    background: rgb(10 11 14 / 0.9);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.9);
    font-family: var(--mono);
    font-size: 0.625rem;
    line-height: 1.4;
    opacity: var(--show);
    translate: 0 calc((1 - var(--show)) * 0.75rem);
    visibility: hidden;
  }

  [data-ready] .record,
  [data-ready] .query {
    visibility: visible;
  }

  .record-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    color: var(--text-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .record-head b {
    color: var(--hi);
    font-weight: 600;
  }

  /* Das Fenster zeigt drei, vier Zeilen. Es schneidet nicht ab, damit die
     Angaben hinausfliegen können; was außerhalb liegt, blendet das Skript
     aus. */
  .feed {
    block-size: 4.6rem;
  }

  .reel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    translate: 0 calc(var(--scan) * var(--reel, 0px));
    filter: blur(calc(var(--speed) * 1.6px));
  }

  .other {
    overflow: hidden;
    padding-inline: 0.3rem;
    color: var(--text-3);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Die Zeile von Max: Der Suchlauf hält auf ihr an und rahmt sie. */
  .line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.4rem;
    padding: 0.15rem 0.3rem;
    border-radius: var(--radius-sm);
    background: rgb(255 59 69 / calc(var(--found) * 0.1));
    box-shadow: inset 0 0 0 1px rgb(255 59 69 / calc(var(--found) * 0.7));
    color: var(--text);
  }

  .chip {
    padding: 0.05rem 0.3rem;
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.08);
    white-space: nowrap;
  }

  /* Neue Angaben fliegen in ihre Zeile und glühen dabei auf. */
  .chip:not([data-matched]) {
    position: relative;
    z-index: 1;
    background: color-mix(
      in oklab,
      rgb(255 255 255 / 0.08),
      var(--hi) calc(var(--fly) * 100%)
    );
    box-shadow: 0 0 calc(var(--fly) * 1.4rem) rgb(255 59 69 / 0.7);
    opacity: calc(1 - var(--land));
    translate: calc(var(--dx, 0px) * var(--fly))
      calc(var(--dy, 0px) * var(--fly));
    scale: calc(1 + var(--fly) * 0.15);
  }

  .chip[data-matched] {
    outline: 1px solid rgb(255 59 69 / var(--hit));
    background: rgb(255 59 69 / calc(var(--hit) * 0.25));
  }

  /* ---------- Suche ----------------------------------------------------- */

  .query {
    --q: 1;
    --res: 1;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 0.65rem 0.85rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-xl);
    background: linear-gradient(rgb(30 31 36 / 0.94), rgb(14 15 18 / 0.94));
    box-shadow:
      0 0 0 1px rgb(255 59 69 / calc(var(--res) * 0.55)),
      0 0 70px -12px rgb(255 59 69 / calc(var(--res) * 0.45)),
      0 24px 60px -24px rgb(0 0 0 / 0.9);
    opacity: var(--q);
    translate: 0 calc((1 - var(--q)) * 1rem);
    scale: calc(0.96 + var(--q) * 0.04);
    visibility: hidden;
  }

  .query-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-3);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .spark {
    color: var(--hi);
    font-size: 0.75rem;
  }

  .query-text {
    min-block-size: 2.7em;
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .caret {
    display: inline-block;
    inline-size: 2px;
    block-size: 1.05em;
    margin-inline-start: 2px;
    background: var(--hi);
    vertical-align: -0.15em;
    animation: blink 1.1s steps(1) infinite;
  }

  .query[data-typing] .caret {
    animation: none;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .query-result {
    padding-block-start: 0.4rem;
    border-block-start: 1px solid var(--edge);
    color: var(--hi);
    font-family: var(--mono);
    font-size: 0.625rem;
    line-height: 1.4;
    opacity: var(--res);
  }

  /* ---------- Akte ------------------------------------------------------ */

  .file-wrap {
    position: relative;
  }

  /* Papier bleibt in beiden Farbmodi hell. Beim Abgleich hebt es sich
     rot glühend ab, unter den Stapeln tritt es zurück. */
  .file {
    --blur: 0;
    --dim: 0;
    --lift: 0;
    --stamp: 1;
    position: relative;
    display: grid;
    gap: 0.45rem;
    padding: 0.65rem 0.8rem 0.55rem;
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgb(255 255 255 / 0.5), transparent 30%), #f2efe7;
    color: var(--paper-ink);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 0 0 calc(var(--lift) * 2px) rgb(255 59 69 / 0.85),
      0 0 calc(var(--lift) * 80px) rgb(255 59 69 / 0.4),
      0 30px 60px -20px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(0 0 0 / 0.4);
    overflow: clip;
    color-scheme: light;
    opacity: calc(1 - var(--dim) * 0.6);
    filter: blur(calc(var(--dim) * 1.5px));
    scale: calc(1 + var(--lift) * 0.025 - var(--dim) * 0.05);
  }

  .journey[data-measuring] .file {
    scale: none;
  }

  .file-head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.35rem;
    border-block-end: 2px solid var(--paper-ink);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .file-head b {
    font-weight: 650;
    letter-spacing: 0.3em;
  }

  .as-of:has(> :empty) {
    visibility: hidden;
  }

  .file-body {
    display: grid;
    gap: 0.75rem;
  }

  .portrait {
    display: none;
  }

  .file dl {
    display: grid;
  }

  .row {
    --fill: 1;
    --hit: 0;
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.08rem 0.3rem;
    border-block-end: 1px solid rgb(0 0 0 / 0.08);
    border-radius: var(--radius-xs);
    background: rgb(201 0 13 / calc(var(--hit) * 0.12));
    box-shadow: inset 0 0 0 1px rgb(201 0 13 / var(--hit));
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .row::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0.3rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-xs);
    background: var(--paper-red);
    color: #fff;
    content: var(--hit-label);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: var(--hit);
    translate: 0 -50%;
  }

  .row dt {
    overflow: hidden;
    color: var(--paper-ink-3);
    font-size: 0.5625rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .row dd {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-inline-size: 0;
    margin: 0;
  }

  /* Der Balken deckt genau den Wert ab und gibt ihn von links frei. */
  .slot {
    display: inline-grid;
    min-inline-size: 0;
  }

  .slot > * {
    grid-area: 1 / 1;
  }

  .value {
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: var(--fill);
  }

  .bar {
    align-self: center;
    block-size: 0.85em;
    border-radius: 1px;
    background: var(--paper-ink);
    transform-origin: right;
    scale: calc(1 - var(--fill)) 1;
  }

  .from {
    margin-inline-start: auto;
    color: var(--paper-red);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: calc(var(--fill) * (1 - var(--hit)));
  }

  /* Der Stempel sitzt unten neben der Fußzeile, auf breiteren Schirmen
     unter dem Bild; so verdeckt er keinen Wert. */
  .stamp {
    position: absolute;
    inset-block-end: 0.3rem;
    inset-inline-end: 0.7rem;
    padding: 0.1rem 0.45rem;
    border: 3px solid var(--paper-red);
    border-radius: var(--radius-sm);
    color: var(--paper-red);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    mix-blend-mode: multiply;
    opacity: calc(var(--stamp) * 0.85);
    rotate: -9deg;
    scale: calc(1.8 - var(--stamp) * 0.8);
    pointer-events: none;
  }

  .file-foot {
    color: var(--paper-ink-3);
    font-size: 0.6875rem;
  }

  .file-foot b {
    color: var(--paper-ink);
  }

  /* ---------- Zwei Stapel ----------------------------------------------- */

  /* Jedes Jahr fällt eine Meldung auf den Stapel des Anbieters, und eine
     Kopie wandert hinüber zum Finanzamt. Die Stapel stehen mitten über
     dem ganzen Tisch. */
  .stacks {
    --stacks: 1;
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: var(--space-s);
    padding-inline: var(--space-2xs);
    opacity: var(--stacks);
    pointer-events: none;
  }

  .stack {
    --alarm: 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }

  .pile {
    display: grid;
    inline-size: min(100%, 15rem);
    filter: drop-shadow(
      0 0 calc(var(--alarm) * 22px) rgb(255 59 69 / calc(var(--alarm) * 0.9))
    );
  }

  .sheet {
    --in: 1;
    grid-area: 1 / 1;
    display: grid;
    gap: 0.3rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    background: #fbfaf6;
    color: var(--paper-ink);
    box-shadow:
      0 14px 30px -14px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(0 0 0 / 0.25);
    font-size: 0.5625rem;
    line-height: 1.35;
    opacity: min(1, calc(var(--in) * 3));
    translate: calc(var(--i) * 0.15rem)
      calc(var(--i) * -0.3rem + (1 - var(--in)) * -60svh);
    rotate: calc(var(--r) * var(--in));
  }

  [data-stack="authority"] .sheet {
    translate: calc(var(--i) * 0.15rem + (1 - var(--in)) * var(--back, 0px))
      calc(var(--i) * -0.3rem);
  }

  .sheet-head {
    padding-block-end: 0.25rem;
    border-block-end: 1px solid rgb(0 0 0 / 0.15);
    font-weight: 650;
  }

  .sheet ul {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sheet li:last-child {
    color: var(--paper-red);
    font-weight: 600;
  }

  .stack-label {
    color: var(--text-2);
    font-size: 0.75rem;
    text-align: center;
  }

  .stack-label b {
    display: block;
    color: color-mix(
      in oklab,
      var(--text),
      var(--hi) calc(var(--alarm) * 100%)
    );
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Zeitleiste ------------------------------------------------ */

  /* Jede Marke ist ein Link zu ihrem Abschnitt; ziehen muss man nichts. */
  .rail {
    --rail: 1;
    user-select: none;
    -webkit-user-select: none;
  }

  .rail ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--ticks), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Die Linie läuft von der ersten zur letzten Marke. */
  .rail ol::before,
  .rail ol::after {
    position: absolute;
    inset-block-start: 0.45rem;
    inset-inline: calc(50% / var(--ticks));
    block-size: 2px;
    border-radius: 1px;
    background: rgb(255 255 255 / 0.16);
    content: "";
  }

  .rail ol::after {
    background: var(--hi);
    transform-origin: left;
    scale: var(--rail) 1;
  }

  .rail a {
    position: relative;
    display: grid;
    justify-items: center;
    padding-block: 1.15rem 0;
    color: var(--text-3);
    font-size: 0.625rem;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .rail a::before {
    position: absolute;
    inset-block-start: 0.15rem;
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border: 2px solid rgb(255 255 255 / 0.32);
    border-radius: 50%;
    background: var(--stage);
    content: "";
    transition:
      scale 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }

  .rail a:hover,
  .rail a[aria-current] {
    color: var(--text);
  }

  .rail a[data-passed]::before {
    border-color: var(--hi);
    background: var(--hi);
  }

  .rail a[aria-current]::before {
    border-color: var(--hi);
    background: var(--hi);
    box-shadow: 0 0 0 4px rgb(255 59 69 / 0.25);
    scale: 1.3;
  }

  .tick-name {
    max-inline-size: 100%;
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- Karten ---------------------------------------------------- */

  /* Die Karten liegen über der Bühne, lassen aber Klicks auf die Zeitleiste
     durch, und blenden sich beim Kommen und Gehen ein und aus. Auf dem
     Telefon bleiben sie unten stehen, solange ihr Abschnitt läuft. */
  .steps {
    position: relative;
    z-index: 1;
    display: grid;
    pointer-events: none;
  }

  .step {
    min-block-size: calc(var(--len) * 0.85svh);
  }

  /* Auf dem Telefon ist unter der Akte ein Fenster für den Text: Das Skript
     setzt --top an seinen oberen Rand, und was darüber hinausscrollt,
     schneidet --cut ab. So verdeckt keine Karte die Akte. */
  .card {
    position: sticky;
    inset-block-start: var(--top, auto);
    clip-path: inset(var(--cut, 0px) 0 0 0 round var(--radius-xl));
    display: grid;
    gap: 0.35rem;
    max-inline-size: 30rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--edge);
    border-radius: var(--radius-xl);
    background: var(--glass);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.8);
    backdrop-filter: blur(18px) saturate(1.3);
    font-size: 0.875rem;
    line-height: 1.45;
    opacity: var(--o, 1);
    pointer-events: auto;
  }

  .card:focus {
    outline: none;
  }

  .card h3 {
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  .card p {
    color: var(--text-2);
    text-wrap: pretty;
  }

  .card .kicker {
    display: flex;
    gap: 0.5rem;
    color: var(--hi);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .kicker span {
    color: var(--text);
  }

  /* Der Einstieg: groß, mittig, ohne Glas, über der noch dunklen Menge. */
  .card.intro {
    justify-items: center;
    gap: var(--space-s);
    max-inline-size: 48rem;
    margin: 24svh auto 0;
    padding-inline: 0;
    border: 0;
    background: none;
    box-shadow: none;
    backdrop-filter: none;
    text-align: center;
  }

  .card.intro h2 {
    background: linear-gradient(180deg, #fff 35%, rgb(255 255 255 / 0.55));
    background-clip: text;
    color: transparent;
    font-size: clamp(2.1rem, 1.3rem + 4.2vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .card.intro p {
    max-inline-size: 36ch;
    color: var(--text-2);
    font-size: var(--step-1);
  }

  /* Ein Pfeil, der zum Scrollen einlädt. */
  .cue {
    inline-size: 1.4rem;
    block-size: 2.2rem;
    border: 2px solid rgb(255 255 255 / 0.35);
    border-radius: 1rem;
    background:
      radial-gradient(circle, var(--hi) 0 2.5px, transparent 3px) 50% 0.4rem /
      100% 0.8rem no-repeat;
    animation: cue 1.8s ease-in-out infinite;
  }

  @keyframes cue {
    50% {
      background-position-y: 1.1rem;
    }
  }

  .delta {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    font-size: 0.8125rem;
  }

  .delta div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4rem;
  }

  .delta dt {
    color: var(--text-3);
  }

  .delta dt::after {
    content: ":";
  }

  .delta dd {
    margin: 0;
    color: var(--text);
    font-weight: 550;
  }

  .card .closing {
    color: var(--text);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  .card .source {
    color: var(--text-3);
    font-size: 0.75rem;
  }

  .more {
    justify-self: start;
    color: var(--text);
    font-weight: 600;
    text-decoration-color: var(--hi);
    text-underline-offset: 0.2em;
  }

  /* Solange die Geschichte den Bildschirm füllt, weichen die Kopfleiste
     und die mobile Leiste mit Spenden und Teilen; wer mit der Tastatur in
     die Kopfleiste springt, holt sie zurück. */
  :global(.site-header) {
    transition: translate 0.35s ease;
  }

  :global(html[data-immersive]:not([data-menu-open]) .site-header) {
    translate: 0 -100%;
  }

  :global(
    html[data-immersive]:not([data-menu-open]) .site-header:focus-within
  ) {
    translate: none;
  }

  :global(html[data-immersive] [data-action-bar]) {
    translate: 0 110%;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.site-header) {
      transition: none;
    }

    .caret,
    .cue {
      animation: none;
    }
  }

  /* ---------- Breitere Bildschirme ------------------------------------- */

  @container campaign (width >= 30rem) {
    .file-body {
      grid-template-columns: 4rem minmax(0, 1fr);
      align-items: start;
    }

    .portrait {
      display: block;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: var(--radius-xs);
      background: #d9d4c8;
    }

    .portrait svg {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      fill: #8c877c;
      filter: blur(calc(var(--blur) * 1px));
    }
  }

  /* Text links unter dem großen Zähler, der Tisch rechts. */
  @container campaign (width >= 56rem) {
    .frame {
      grid-template-columns: minmax(19rem, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: var(--space-s) var(--space-xl);
      padding-block: var(--space-s) var(--space-m);
    }

    .rail {
      grid-column: 1 / -1;
    }

    .rail a {
      font-size: 0.75rem;
    }

    .count {
      display: grid;
      align-content: start;
      gap: 0.35rem;
      padding-block-start: 3svh;
    }

    .count b {
      font-size: clamp(3rem, 1.25rem + 3.6vw, 5.5rem);
      font-weight: 250;
      line-height: 0.95;
      letter-spacing: -0.045em;
    }

    .count-label {
      font-size: var(--step-0);
    }

    .scale {
      font-size: 0.8125rem;
    }

    .desk {
      align-self: center;
      gap: var(--space-m);
      inline-size: min(100%, 36rem);
    }

    .record {
      font-size: 0.75rem;
    }

    .feed {
      block-size: 5.6rem;
    }

    .query {
      gap: 0.6rem;
      padding: 0.9rem 1.1rem 1rem;
    }

    .query-head {
      font-size: 0.6875rem;
    }

    .query-text {
      font-size: 1.125rem;
    }

    .query-result {
      font-size: 0.75rem;
    }

    .file {
      gap: 0.6rem;
      padding: 1rem 1.25rem 0.9rem;
    }

    .file-head {
      font-size: 0.75rem;
    }

    .file-body {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    .row {
      grid-template-columns: 8rem minmax(0, 1fr);
      padding-block: 0.28rem;
      font-size: 0.875rem;
    }

    .row dt {
