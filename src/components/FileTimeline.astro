  }
</style>

<script>
  // Turns the scroll position into one progress value p: 0 is the intro,
  // then one unit per card, each with its fraction. Every frame derives the
  // whole stage from p, so scrolling back rewinds it. With reduced motion,
  // nothing flies, scans or zooms and every change snaps.
  const root = document.querySelector<HTMLElement>("[data-journey]")
  if (root) start(root)

  interface Dot {
    x: number
    y: number
    // One bit per list the person is in: the leaks in order, then the
    // tax authority's leak at the end.
    lists: number
    // When the dot lights up within its wave, from 0 to 1.
    delay: number
    pop: number
    far: number
  }

  interface Feed {
    height: number
    end: number
    rows: { element: HTMLElement; middle: number }[]
  }

  function start(root: HTMLElement) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)")
    const all = (selector: string) => [
      ...root.querySelectorAll<HTMLElement>(selector),
    ]
    const one = (selector: string) => root.querySelector<HTMLElement>(selector)
    const steps = all("[data-step]")
    const cards = all(".card")
    const records = all("[data-record]")
    const rows = all(".row")
    const providerSheets = all('[data-stack="provider"] .sheet')
    const authoritySheets = all('[data-stack="authority"] .sheet')
    const filedLabels = all("[data-filed]")
    const yearLabels = all("[data-year-label]")
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-goto]")]
    const pin = one(".pin")
    const frame = one(".frame")
    const desk = one(".desk")
    const recordBox = one(".records")
    const canvas = root.querySelector<HTMLCanvasElement>(".crowd")
    const context = canvas?.getContext("2d")
    const file = one(".file")
    const query = one("[data-query]")
    const typed = one("[data-typed]")
    const countBox = one("[data-count-box]")
    const count = one("[data-count]")
    const countLabel = one("[data-count-label]")
    const stacks = one(".stacks")
    const provider = one('[data-stack="provider"]')
    const authority = one('[data-stack="authority"]')
    const known = one("[data-known]")
    const rail = one(".rail")
    if (
      !pin ||
      !frame ||
      !desk ||
      !recordBox ||
      !canvas ||
      !context ||
      !file ||
      !query ||
      !typed ||
      !countBox ||
      !count ||
      !countLabel ||
      !stacks ||
      !provider ||
      !authority ||
      !known ||
      !rail
    )
      return

    const matchScene = records.length + 1
    const reportScene = records.length + 2
    const endScene = records.length + 3
    const firstReport = Number(root.dataset.first)
    const format = new Intl.NumberFormat(root.dataset.locale)
    const people = records.map((record) => Number(record.dataset.people))
    const endPeople = Number(root.dataset.endPeople)
    const endBit = 1 << records.length
    const text = typed.dataset.text ?? ""
    // Where a click on the timeline lands within each scene: the record
    // already in the file, the match stamped, a few reports filed, the end.
    const landing = [...records.map(() => 0.8), 0.72, 0.55, 0.6]

    // The records that only match a piece, so its row lights up meanwhile.
    const matches = new Map<string, number[]>()
    records.forEach((record, index) => {
      for (const chip of record.querySelectorAll<HTMLElement>(
        "[data-matched]",
      )) {
        const piece = chip.dataset.piece ?? ""
        matches.set(piece, [...(matches.get(piece) ?? []), index])
      }
    })

    const clamp = (value: number) => Math.min(1, Math.max(0, value))
    const ramp = (value: number, from: number, to: number) =>
      clamp((value - from) / (to - from))
    const ease = (value: number) =>
      value < 0.5 ? 4 * value ** 3 : 1 - (-2 * value + 2) ** 3 / 2
    const out = (value: number) => 1 - (1 - value) ** 3
    const snap = (value: number) =>
      motion.matches ? (value >= 0.5 ? 1 : 0) : value
    // A record's own clock: in, the people counted, the copy scanned down
    // to Max's line, matched pieces lit, new pieces flying, landed, out.
    const phases = (t: number) => {
      const scan = ramp(t, 0.06, 0.34)
      return {
        show: snap(ramp(t, 0, 0.08) * (1 - ramp(t, 0.88, 1))),
        roll: motion.matches ? 1 : out(ramp(t, 0.02, 0.4)),
        scan: motion.matches ? 1 : out(scan),
        speed: motion.matches || scan >= 1 ? 0 : (1 - scan) ** 2,
        found: snap(ramp(t, 0.3, 0.36)),
        ping: ramp(t, 0.32, 0.52),
        hit: snap(ramp(t, 0.36, 0.44) * (1 - ramp(t, 0.66, 0.76))),
        fly: motion.matches ? 0 : ease(ramp(t, 0.44, 0.7)),
        land: snap(ramp(t, 0.66, 0.74)),
      }
    }

    let tops: number[] = []
    let heights: number[] = []
    let feeds: Feed[] = []
    let dots: Dot[] = []
    let max = { x: 0, y: 0 }
    let anchor = { x: 0, y: 0 }
    // On phones the crowd keeps clear of the timeline and the counter, and
    // stays dimmer behind the closely set text.
    let clear = 0
    // How far below the top of the window the scenes are read: the middle
    // on wide screens, the top of the text window on phones.
    let reading = 0
    let wide = true
    let ratio = 1
    let queued = false
    let visible = false

    // Deterministic noise, so the crowd looks the same on every visit.
    const noise = (seed: number) => {
      const value = Math.sin(seed * 127.1 + 311.7) * 43758.5453
      return value - Math.floor(value)
    }
    const set = (element: HTMLElement, name: string, value: number) =>
      element.style.setProperty(name, String(value))
    const write = (element: HTMLElement, value: string) => {
      if (element.textContent !== value) element.textContent = value
    }

    // Measures everything in the final pose: desk upright, each copy
    // scanned to Max's line, nothing in flight.
    const measure = () => {
      root.toggleAttribute("data-measuring", true)
      const scroll = window.scrollY
      tops = steps.map((step) => step.getBoundingClientRect().top + scroll)
      heights = steps.map((step) => step.offsetHeight)
      wide = getComputedStyle(frame).gridTemplateColumns.split(" ").length > 1

      // On phones the cards stop just below the file, or higher where a
      // card would not fit on the screen; the intro stands higher up.
      const pinBox = pin.getBoundingClientRect()
      const below = desk.getBoundingClientRect().bottom - pinBox.top + 8
      reading = wide ? window.innerHeight * 0.5 : below
      cards.forEach((card, index) => {
        card.style.removeProperty("--cut")
        if (wide) card.style.removeProperty("--top")
        else
          card.style.setProperty(
            "--top",
            `${index === 0 ? window.innerHeight * 0.28 : Math.min(below, window.innerHeight - card.offsetHeight - 8)}px`,
          )
      })

      // Each copy scrolls until Max's line stands in the middle of its
      // window; then the new pieces fly from there into the file.
      feeds = records.map((record) => {
        const feed = record.querySelector<HTMLElement>(".feed")
        const reel = record.querySelector<HTMLElement>(".reel")
        const line = record.querySelector<HTMLElement>("[data-max]")
        if (!feed || !reel || !line) return { height: 0, end: 0, rows: [] }
        const height = feed.clientHeight
        const end = -(line.offsetTop + line.offsetHeight / 2 - height / 2)
        reel.style.setProperty("--reel", `${end}px`)
        set(record, "--scan", 1)
        set(record, "--fly", 0)
        return {
          height,
          end,
          rows: [...reel.children].map((element) => ({
            element: element as HTMLElement,
            middle:
              (element as HTMLElement).offsetTop +
              (element as HTMLElement).offsetHeight / 2,
          })),
        }
      })
      for (const record of records)
        for (const chip of record.querySelectorAll<HTMLElement>(
          ".chip:not([data-matched])",
        )) {
          const target = root
            .querySelector(`.row[data-piece="${chip.dataset.piece}"] .slot`)
            ?.getBoundingClientRect()
          if (!target) continue
          const from = chip.getBoundingClientRect()
          chip.style.setProperty("--dx", `${target.left - from.left}px`)
          chip.style.setProperty(
            "--dy",
            `${target.top + target.height / 2 - (from.top + from.height / 2)}px`,
          )
        }

      // The copies for the tax authority start on the provider's pile.
      const providerPile = provider.querySelector(".pile")
      const authorityPile = authority.querySelector(".pile")
      if (providerPile && authorityPile)
        authority.style.setProperty(
          "--back",
          `${providerPile.getBoundingClientRect().left - authorityPile.getBoundingClientRect().left}px`,
        )

      // The crowd: about six thousand places on the canvas. Each leak takes
      // as many as it held people, one per thousand, at random; Max stands
      // beside the copy on wide screens and at the end of the counter on
      // phones, and is the only one in all three leaks.
      const box = canvas.getBoundingClientRect()
      const fileBox = file.getBoundingClientRect()
      const spot = recordBox.getBoundingClientRect()
      const counter = countBox.getBoundingClientRect()
      const stack = authority.getBoundingClientRect()
      ratio = Math.min(2, window.devicePixelRatio || 1)
      canvas.width = Math.round(box.width * ratio)
      canvas.height = Math.round(box.height * ratio)
      max = wide
        ? {
            x: spot.left - box.left - 26,
            y: spot.top + spot.height / 2 - box.top,
          }
        : {
            x: box.width - 22,
            y: counter.top + counter.height / 2 - box.top,
          }
      anchor = wide
        ? { x: fileBox.left - box.left, y: fileBox.top - box.top + 22 }
        : { x: fileBox.right - box.left - 18, y: fileBox.top - box.top }
      clear = wide ? 0 : counter.bottom - box.top + 4
      const source = {
        x: stack.left + stack.width / 2 - box.left,
        y: stack.top + stack.height / 2 - box.top,
      }

      const places = Math.max(endPeople, ...people) / 1000
      const gap = Math.sqrt((box.width * box.height) / places)
      let seed = 1
      dots = []
      for (let y = gap / 2; y < box.height; y += gap)
        for (let x = gap / 2; x < box.width; x += gap) {
          seed += 1
          dots.push({
            x: x + (noise(seed) - 0.5) * gap * 0.8,
            y: y + (noise(seed + 0.5) - 0.5) * gap * 0.8,
            lists: endBit,
            delay: 0,
            pop: noise(seed + 0.375),
            far: 0,
          })
        }
      let nearest = dots[0]
      dots.forEach((dot, index) => {
        people.forEach((size, list) => {
          if (
            noise(index * 7.3 + list * 1.9 + 0.11) <
            size / 1000 / dots.length
          )
            dot.lists |= 1 << list
        })
        const distance = Math.hypot(dot.x - max.x, dot.y - max.y)
        if (distance < Math.hypot(nearest.x - max.x, nearest.y - max.y))
          nearest = dot
      })
      const every = (1 << records.length) - 1
      for (const dot of dots)
        if ((dot.lists & every) === every)
          dot.lists &= ~(1 << (records.length - 1))
      nearest.lists = every | endBit
      const reach = Math.max(
        ...dots.map((dot) => Math.hypot(dot.x - max.x, dot.y - max.y)),
      )
      const reachEnd = Math.max(
        ...dots.map((dot) => Math.hypot(dot.x - source.x, dot.y - source.y)),
      )
      for (const dot of dots) {
        dot.delay = Math.hypot(dot.x - max.x, dot.y - max.y) / reach
        dot.far = Math.hypot(dot.x - source.x, dot.y - source.y) / reachEnd
      }
      dots = dots.filter((dot) => dot !== nearest)

      root.toggleAttribute("data-measuring", false)
    }

    const progress = () => {
      const line = window.scrollY + reading
      let value = 0
      steps.forEach((_, index) => {
        if (line >= tops[index])
          value = index + clamp((line - tops[index]) / heights[index])
      })
      return value
    }

    // The crowd: a faint hint in the intro, then each leak lights its
    // people, the first in a wave from Max, the others here and there.
    // Who is in two lists turns red. The search clears everyone but Max
    // and the view closes in on him. With the reports the crowd dims; at
    // the end the tax authority's leak lights up from its pile.
    const draw = (p: number) => {
      const width = canvas.width / ratio
      const height = canvas.height / ratio
      const scene = Math.floor(p)
      const active = scene >= 1 && scene <= records.length ? scene - 1 : -1
      const lit = records.map((_, index) =>
        motion.matches
          ? Number(p >= index + 1.2)
          : ramp(p, index + 1.02, index + 1.42),
      )
      const hint = ramp(p, 0, 0.6)
      const single = snap(ramp(p, matchScene + 0.2, matchScene + 0.36))
      const only = snap(ramp(p, matchScene + 0.36, matchScene + 0.52))
      const zoom = motion.matches
        ? 1
        : 1 + ease(ramp(p, matchScene + 0.42, matchScene + 0.8)) * 1.3
      const ring =
        snap(ramp(p, matchScene + 0.5, matchScene + 0.62)) *
        (1 - snap(ramp(p, reportScene - 0.1, reportScene + 0.15)))
      const away = snap(ramp(p, reportScene - 0.05, reportScene + 0.3))
      const flood = motion.matches
        ? Number(p >= endScene + 0.4)
        : ramp(p, endScene + 0.24, endScene + 0.58)

      context.setTransform(ratio, 0, 0, ratio, 0, 0)
      context.clearRect(0, 0, width, height)
      context.setTransform(
        ratio * zoom,
        0,
        0,
        ratio * zoom,
        ratio * max.x * (1 - zoom),
        ratio * max.y * (1 - zoom),
      )

      // Bucket the dots by colour and brightness, so the canvas changes
      // its fill only a few dozen times per frame.
      const buckets = new Map<number, Dot[]>()
      for (const dot of dots) {
        let lists = 0
        let fresh = 0
        lit.forEach((value, index) => {
          if (!(dot.lists & (1 << index))) return
          const delay = index === 0 ? dot.delay : dot.pop
          const shown = clamp((value * 1.3 - delay) * 6)
          if (shown <= 0) return
          lists += 1
          if (index === active) fresh = shown
        })
        let alpha = 0.06 * hint
        let red = false
        if (lists > 0) {
          alpha = active >= 0 ? (fresh > 0 ? 0.25 + fresh * 0.6 : 0.16) : 0.34
          if (lists > 1) {
            red = true
            alpha = Math.max(alpha, 0.75)
          }
        }
        alpha *= lists > 1 ? 1 - only * 0.88 : 1 - single * 0.85
        alpha *= 1 - away * 0.9
        if (flood > 0 && dot.lists & endBit) {
          const wave = clamp((flood * 1.3 - dot.far) * 6) * 0.45
          if (wave > alpha) {
            alpha = wave
            red = false
          }
        }
        if (!wide) alpha *= 0.7 * clamp((dot.y - clear) / 24)
        const key = (red ? 100 : 0) + Math.round(alpha * 20)
        if (key % 100 === 0) continue
        const bucket = buckets.get(key)
        if (bucket) bucket.push(dot)
        else buckets.set(key, [dot])
      }
      for (const [key, bucket] of buckets) {
        const red = key >= 100
        const alpha = (key % 100) / 20
        context.fillStyle = red
          ? `rgb(255 59 69 / ${alpha})`
          : `rgb(255 244 230 / ${alpha})`
        const size = red ? 2.4 : alpha > 0.5 ? 2.2 : 1.7
        for (const dot of bucket)
          context.fillRect(dot.x - size / 2, dot.y - size / 2, size, size)
      }

      // Max: lit with the first leak, red once he is in two, and pinged
      // each time a copy is scanned down to his line.
      const shown = 1 - away
      const red = lit[1] > 0.3
      context.fillStyle = red
        ? `rgb(255 59 69 / ${shown})`
        : `rgb(255 244 230 / ${lit[0] > 0 ? 0.95 * shown : 0.08 * hint})`
      context.beginPath()
      context.arc(
        max.x,
        max.y,
        (1.6 + (red ? 1 : 0) + ring * 1.4) / Math.sqrt(zoom),
        0,
        Math.PI * 2,
      )
      context.fill()
      if (active >= 0 && !motion.matches) {
        const ping = phases(clamp(p - active - 1)).ping
        if (ping > 0 && ping < 1) {
          context.strokeStyle = `rgb(255 59 69 / ${(1 - ping) * 0.9})`
          context.lineWidth = 1.5
          context.beginPath()
          context.arc(max.x, max.y, 4 + ping * 34, 0, Math.PI * 2)
          context.stroke()
        }
      }

      // Found: a ring, his name, and a line to the file.
      context.setTransform(ratio, 0, 0, ratio, 0, 0)
      if (ring > 0) {
        context.strokeStyle = `rgb(255 59 69 / ${ring * 0.9})`
        context.lineWidth = 1.5
        context.beginPath()
        context.arc(max.x, max.y, 12 + (1 - ring) * 40, 0, Math.PI * 2)
        context.stroke()
        context.setLineDash([3, 4])
        context.strokeStyle = `rgb(255 59 69 / ${ring * 0.55})`
        context.beginPath()
        const angle = Math.atan2(anchor.y - max.y, anchor.x - max.x)
        context.moveTo(
          max.x + Math.cos(angle) * 14,
          max.y + Math.sin(angle) * 14,
        )
        context.lineTo(anchor.x, anchor.y)
        context.stroke()
        context.setLineDash([])
        context.fillStyle = `rgb(243 242 238 / ${ring})`
        context.font = `600 13px "IBM Plex Sans", sans-serif`
        // Above the ring on wide screens, to its left on phones, where the
        // timeline sits above.
        context.textAlign = wide ? "center" : "right"
        context.fillText(
          "Max",
          wide ? max.x : max.x - 18,
          wide ? max.y - 20 : max.y + 4,
        )
      }
    }

    const render = () => {
      queued = false
      const p = progress()
      const at = (scene: number) => clamp(p - scene)
      const scene = Math.min(Math.floor(p), steps.length - 1)

      // The cards fade in as they arrive and out as they leave.
      cards.forEach((card, index) => {
        const t = p - index
        const into = index === 0 ? 1 : ramp(t, -0.2, 0.04)
        // The intro gives way to the desk; the end stays.
        const leave =
          index === 0
            ? ramp(t, 0.5, 0.7)
            : index === cards.length - 1
              ? 0
              : ramp(t, 0.9, 1)
        set(card, "--o", motion.matches ? 1 : into * (1 - leave))
      })
      root.style.setProperty(
        "--desk",
        String(motion.matches ? Number(p >= 0.6) : ease(ramp(p, 0.55, 1))),
      )

      // Each copy: shown, scanned down to Max's line, its rows fading at
      // the edges of the window, its new pieces flying into the file.
      records.forEach((record, index) => {
        const phase = phases(at(index + 1))
        set(record, "--show", phase.show)
        set(record, "--scan", phase.scan)
        set(record, "--speed", phase.speed)
        set(record, "--found", phase.found)
        set(record, "--hit", phase.hit)
        set(record, "--fly", phase.fly)
        set(record, "--land", phase.land)
        const feed = feeds[index]
        if (!feed || phase.show === 0) return
        const shift = phase.scan * feed.end
        for (const row of feed.rows) {
          const distance = Math.abs(row.middle + shift - feed.height / 2)
          row.element.style.opacity = String(
            clamp(1.3 - distance / (feed.height * 0.5)),
          )
        }
      })

      let filled = 0
      let identified = false
      for (const row of rows) {
        const fill = phases(at(Number(row.dataset.from) + 1)).land
        const hit = Math.max(
          0,
          ...(matches.get(row.dataset.piece ?? "") ?? []).map(
            (index) => phases(at(index + 1)).hit,
          ),
        )
        set(row, "--fill", fill)
        set(row, "--hit", hit)
        if (fill < 0.5) continue
        filled += 1
        if (row.dataset.piece === "document") identified = true
      }
      write(known, String(filled))

      // The portrait sharpens with every piece and is clear once an ID
      // image is out.
      set(file, "--blur", identified ? 0 : Math.max(2, 12 - filled * 1.6))
      const search = at(matchScene)
      set(file, "--stamp", snap(ramp(search, 0.58, 0.72)))
      set(
        file,
        "--lift",
        snap(ramp(search, 0.5, 0.64)) *
          (1 - snap(ramp(p, reportScene - 0.1, reportScene + 0.15))),
      )
      set(file, "--dim", snap(ramp(p, reportScene, reportScene + 0.25)))

      // The search: typed along with the scroll, then its one match.
      set(
        query,
        "--q",
        snap(
          ramp(search, 0, 0.07) *
            (1 - ramp(p, reportScene - 0.1, reportScene + 0.02)),
        ),
      )
      const typing = motion.matches ? 1 : ramp(search, 0.06, 0.34)
      write(typed, text.slice(0, Math.round(text.length * typing)))
      query.toggleAttribute("data-typing", typing > 0 && typing < 1)
      set(query, "--res", snap(ramp(search, 0.48, 0.58)))

      // One report a year over the last two scenes: first on the
      // provider's pile, then a copy over to the tax authority.
      set(
        stacks,
        "--stacks",
        snap(ramp(p, reportScene - 0.02, reportScene + 0.12)),
      )
      const stack =
        ramp(p, reportScene + 0.12, endScene + 0.2) * providerSheets.length
      let filed = 0
      let sent = 0
      providerSheets.forEach((sheet, index) => {
        const into = motion.matches
          ? Number(stack >= index + 1)
          : clamp((stack - index) * 2)
        set(sheet, "--in", into)
        if (into >= 0.5) filed += 1
      })
      authoritySheets.forEach((sheet, index) => {
        const into = motion.matches
          ? Number(stack >= index + 1)
          : clamp((stack - index) * 2 - 1)
        set(sheet, "--in", into)
        if (into >= 0.5) sent += 1
      })
      write(filedLabels[0], String(filed))
      write(filedLabels[1], String(sent))
      set(authority, "--alarm", snap(ramp(p, endScene + 0.24, endScene + 0.4)))

      // The counter: the people in each leak, the search narrowing them
      // down to one, the report years, and the tax authority's leak.
      let value = ""
      let caption = ""
      let scale = 0
      let found = 1
      if (p >= endScene + 0.24) {
        const flood = motion.matches
          ? 1
          : out(ramp(p, endScene + 0.24, endScene + 0.58))
        value = `> ${format.format(Math.round(endPeople * flood))}`
        caption = root.dataset.endLabel ?? ""
        scale = 1
      } else if (p >= reportScene) {
        const year = Math.max(1, filed)
        value = String(firstReport + year)
        caption = (root.dataset.reportLabel ?? "").replace("{n}", String(year))
      } else if (p >= matchScene) {
        // No made-up numbers on the way: the count shows once the search
        // has found its one match.
        value = "1"
        caption = query.dataset.label ?? ""
        found = snap(ramp(search, 0.48, 0.58))
      } else if (p >= 1) {
        const record = records[scene - 1]
        value = `${record.dataset.prefix ?? ""}${format.format(Math.round(people[scene - 1] * phases(at(scene)).roll))}`
        caption = record.dataset.label ?? ""
        scale = 1
      }
      write(count, value)
      write(countLabel, caption)
      set(countBox, "--on", snap(ramp(p, 0.92, 1.04)) * found)
      set(countBox, "--scale", scale)

      // The year on the file.
      const year =
        p >= reportScene
          ? String(firstReport + Math.max(1, filed))
          : (steps[scene].dataset.year ?? "")
      for (const label of yearLabels) write(label, year)

      // The timeline: a line up to the current scene, and its mark.
      set(rail, "--rail", clamp((p - 1.5) / (links.length - 1)))
      links.forEach((link, index) => {
        link.toggleAttribute("data-passed", scene - 1 > index)
        if (scene - 1 === index) link.setAttribute("aria-current", "step")
        else link.removeAttribute("aria-current")
      })

      if (!wide)
        for (const card of cards) {
          const top = Number.parseFloat(card.style.getPropertyValue("--top"))
          const cut = Math.max(0, top - card.getBoundingClientRect().top)
          card.style.setProperty("--cut", `${cut}px`)
        }

      const box = root.getBoundingClientRect()
      document.documentElement.toggleAttribute(
        "data-immersive",
        box.top <= 1 && box.bottom >= window.innerHeight,
      )

      draw(p)
    }

    const queue = () => {
      if (queued || !visible) return
      queued = true
      requestAnimationFrame(render)
    }

    const refresh = () => {
      measure()
      render()
    }

    links.forEach((link, index) => {
      link.addEventListener("click", (event) => {
        const scene = index + 1
        if (tops[scene] === undefined) return
        event.preventDefault()
        window.scrollTo({
          top: tops[scene] + heights[scene] * landing[index] - reading,
          behavior: motion.matches ? "auto" : "smooth",
        })
        steps[scene]
          .querySelector<HTMLElement>(".card")
          ?.focus({ preventScroll: true })
      })
    })

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      if (!visible) document.documentElement.removeAttribute("data-immersive")
      queue()
    }).observe(root)
    // The page above can grow, for example when the file is answered.
    new ResizeObserver(refresh).observe(document.body)
    window.addEventListener("resize", refresh)
    window.addEventListener("scroll", queue, { passive: true })
    motion.addEventListener("change", render)
    document.fonts.ready.then(refresh)

    root.toggleAttribute("data-ready", true)
    refresh()
  }
</script>
