---
import {
  breaches,
  end,
  intro,
  match,
  type Piece,
  reports,
  rows,
} from "@/data/file-timeline"
import { leaks } from "@/data/leaks"
import { type Language, pathFor } from "@/lib/i18n"

// "How scattered leaks become a file", told as a scroll story: the cards
// scroll past a pinned stage, and the scroll position drives the stage. The
// cards are the readable version, so the stage stays hidden from screen
// readers. The page renders the stage in its final state; the script below
// rewinds it and plays it along with the scroll.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"

const leakFor = (id: string) => {
  const leak = leaks.find((candidate) => candidate.id === id)
  if (!leak) throw new Error(`Unknown leak: ${id}`)
  return leak
}
const label = (piece: Piece) =>
  rows.find((row) => row.id === piece)?.label[language] ?? piece
// Inside a sentence, English labels go lower case, except abbreviations
// such as "ID".
const inline = (text: string) =>
  en && !/^[A-Z]{2}/.test(text) ? text[0].toLowerCase() + text.slice(1) : text
const list = (pieces: Piece[]) =>
  new Intl.ListFormat(language, { type: "conjunction" }).format(
    pieces.map((piece) => inline(label(piece))),
  )

// Each piece lands once, with the first case that had it; later cases only
// match it.
const seen = new Set<Piece>()
const cases = breaches.map((breach, index) => {
  const leak = leakFor(breach.leak)
  const fields = breach.fields.map((field) => ({
    ...field,
    matched: seen.has(field.piece),
  }))
  for (const field of fields) seen.add(field.piece)
  return {
    ...breach,
    index,
    leak,
    fields,
    added: fields.filter((field) => !field.matched).map((field) => field.piece),
    matched: fields
      .filter((field) => field.matched)
      .map((field) => field.piece),
  }
})
const origin = new Map<Piece, number>(
  cases.flatMap((item) =>
    item.added.map((piece) => [piece, item.index] as const),
  ),
)
const tag = (index: number) =>
  `${cases[index].leak.name[language]} ’${String(cases[index].leak.year).slice(2)}`

const ending = leakFor(end.leak)
const today = en ? "Today" : "Heute"
const sheets = Array.from(
  { length: reports.count },
  (_, index) => reports.first + index,
)
const last = reports.first + reports.count
// A slightly different tilt for every report on the pile.
const tilt = [-2.2, 1.4, -0.6, 2, -1.6, 0.8, -2.6, 1.8, -1, 0.4]

// The scenes after the intro, for the timeline and its anchors.
const scenes = [
  ...cases.map((item) => ({
    id: item.leak.id,
    year: String(item.leak.year),
    name: item.leak.name[language],
  })),
  { id: "abgleich", year: today, name: match.short[language] },
  {
    id: "dac8",
    year: String(reports.first + 1),
    name: reports.short[language],
  },
  { id: "ende", year: String(last), name: end.short[language] },
]
const source = en ? "Source" : "Quelle"
---

<section
  id="zeitreise"
  class="journey"
  aria-labelledby="journey-heading"
  data-journey
  data-first={reports.first}
>
  <div class="steps">
    <div class="step" id="akte-start" data-step data-year="" style="--len: 100">
      <div class="card intro" tabindex="-1">
        <h2 id="journey-heading">{intro.heading[language]}</h2>
        <p>{intro.text[language]}</p>
      </div>
    </div>

    {cases.map((item) => (
        <div
          class="step"
          id={`akte-${item.leak.id}`}
          data-step
          data-year={item.leak.year}
          style="--len: 150"
        >
          <div class="card" tabindex="-1">
            <p class="kicker">
              <span>{item.leak.year}</span> {item.leak.name[language]}
            </p>
            <h3>{item.leak.headline[language]}</h3>
            <p>{item.text[language]}</p>
            <dl class="delta">
              <div>
                <dt>{en ? "New in the file" : "Neu in der Akte"}</dt>
                <dd>{list(item.added)}</dd>
              </div>
              {item.matched.length > 0 && (
                <div>
                  <dt>{en ? "Matched on" : "Abgeglichen über"}</dt>
                  <dd>{list(item.matched)}</dd>
                </div>
              )}
            </dl>
            <p class="source">
              {source}: {item.leak.sources[0].label[language]}
            </p>
          </div>
        </div>
      ))}

    <div
      class="step"
      id="akte-abgleich"
      data-step
      data-year={today}
      style="--len: 130"
    >
      <div class="card" tabindex="-1">
        <p class="kicker"><span>{today}</span> {match.short[language]}</p>
        <h3>{match.heading[language]}</h3>
        <p>{match.text[language]}</p>
      </div>
    </div>

    <div class="step" id="akte-dac8" data-step style="--len: 170">
      <div class="card" tabindex="-1">
        <p class="kicker">
          <span>{reports.first + 1}</span>
          {reports.short[language]}
        </p>
        <h3>{reports.heading[language]}</h3>
        <p>{reports.text[language]}</p>
      </div>
    </div>

    <div class="step" id="akte-ende" data-step style="--len: 120">
      <div class="card" tabindex="-1">
        <p class="kicker"><span>{last}</span> {end.short[language]}</p>
        <h3>{end.heading[language]}</h3>
        <p>{end.text[language]}</p>
        <p class="source">{source}: {ending.sources[0].label[language]}</p>
        <a class="more" href={pathFor("leaks", language)}
          >{en ? "More cases with sources" : "Mehr Fälle mit Quellen"}</a
        >
      </div>
    </div>
  </div>

  <div class="pin">
    <canvas class="crowd" aria-hidden="true"></canvas>
    <div class="frame">
      <p class="year" aria-hidden="true" data-year-label>{last}</p>

      <div class="desk" aria-hidden="true">
        <div class="records">
          {cases.map((item) => (
              <div class="record" data-record>
                <p class="record-head">
                  <b>{item.leak.name[language]}</b>
                  <span>{item.where[language]}</span>
                  <span>{item.size[language]}</span>
                </p>
                <span class="noise" style="--w: 86%" />
                <p class="line">
                  {item.fields.map((field) => (
                    <span
                      class="chip"
                      data-piece={field.piece}
                      data-matched={field.matched ? "" : undefined}
                    >
                      {field.raw[language]}
                    </span>
                  ))}
                </p>
                <span class="noise" style="--w: 71%" />
                <span class="noise" style="--w: 79%" />
              </div>
            ))}
          <p class="pile-count">
            <b data-reports>{reports.count}</b>
            {en
                ? `of ${reports.count} annual reports, with the provider and the tax authority`
                : `von ${reports.count} Jahresmeldungen, beim Anbieter und beim Finanzamt`}
          </p>
        </div>

        <div class="file-wrap">
          <article
            class="file"
            style={`--hit-label: "${en ? "match" : "Treffer"}"`}
          >
            <header class="file-head">
              <b>{en ? "File" : "Akte"}</b>
              <span class="as-of">
                {en ? "As of" : "Stand"} <span data-year-label>{last}</span>
              </span>
            </header>
            <div class="file-body">
              <div class="portrait">
                <svg viewBox="0 0 64 80">
                  <circle cx="32" cy="29" r="14"></circle>
                  <path d="M6 80c0-17 11.6-28 26-28s26 11 26 28z"></path>
                </svg>
              </div>
              <dl>
                {rows.map((row) => (
                    <div
                      class="row"
                      data-piece={row.id}
                      data-from={origin.get(row.id)}
                    >
                      <dt>{row.label[language]}</dt>
                      <dd>
                        <span class="slot">
                          <span class="value">{row.value[language]}</span>
                          <span class="bar" />
                        </span>
                        {origin.has(row.id) && (
                          <span class="from">
                            {tag(origin.get(row.id) ?? 0)}
                          </span>
                        )}
                      </dd>
                    </div>
                  ))}
              </dl>
            </div>
            <p class="stamp">{en ? "Matched" : "Abgeglichen"}</p>
            <p class="file-foot">
              <b data-known>{rows.length}</b>
              {en
                  ? ` of ${rows.length} details in other hands`
                  : ` von ${rows.length} Angaben in fremden Händen`}
            </p>
          </article>

          <div class="pile">
            {sheets.map((year, index) => (
                <div
                  class="sheet"
                  style={`--i: ${index}; --r: ${tilt[index % tilt.length]}deg`}
                >
                  <p class="sheet-head">
                    <b>{en ? `DAC8 report ${year}` : `DAC8-Meldung ${year}`}</b>
                    <span>{en ? "to the tax authority" : "ans Finanzamt"}</span>
                  </p>
                  <ul>
                    {reports.sheet[language].map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </div>
              ))}
          </div>
        </div>
      </div>

      <nav
        class="rail"
        aria-label={en ? "Timeline" : "Zeitleiste"}
        style={`--ticks: ${scenes.length}`}
      >
        <ol>
          {scenes.map((scene) => (
              <li>
                <a href={`#akte-${scene.id}`} data-goto>
                  <span class="tick-year">{scene.year}</span>
                  <span class="tick-name">{scene.name}</span>
                </a>
              </li>
            ))}
        </ol>
      </nav>
    </div>
  </div>
</section>

<style>
  /* Die Akte als Scroll-Geschichte: Ein dunkler Raum bleibt stehen, die
     Karten mit dem Text ziehen darüber. Hinten eine Menge aus Punkten, die
     Menschen in den Datenbeständen; davor der Datensatz aus dem jeweiligen
     Leck und die Akte, in die seine neuen Angaben fliegen. Was die Akte schon
     kennt, wird nur abgeglichen. Danach legt DAC8 jedes Jahr eine Meldung
     obenauf. Das Skript setzt die Variablen pro Bild; ohne Skript steht der
     Endstand da. */
  .journey {
    --stage: #060709;
    --hi: #ff3b45;
    --text: #f3f2ee;
    --text-2: rgb(243 242 238 / 0.74);
    --text-3: rgb(243 242 238 / 0.52);
    --glass: rgb(16 17 20 / 0.76);
    --edge: rgb(255 255 255 / 0.1);
    --paper-ink: #1d1d1b;
    --paper-ink-3: #736f66;
    --paper-red: #c9000d;
    --mono:
      ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    --pin-top: var(--header-height);
    --pin-height: calc(100svh - var(--pin-top));
    --ring: var(--hi);
    display: grid;
    color-scheme: dark;
    color: var(--text);
  }

  .steps,
  .pin {
    grid-area: 1 / 1;
  }

  /* ---------- Bühne ---------------------------------------------------- */

  /* Die Fläche reicht per border-image bis an den Rand, ohne die Seite
     breiter zu machen. */
  .pin {
    position: sticky;
    inset-block-start: var(--pin-top);
    align-self: start;
    block-size: var(--pin-height);
    overflow-y: clip;
    border-image: linear-gradient(var(--stage) 0 0) fill 0 / / 0 100vw;
  }

  .crowd {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: calc(var(--grid-gutter) * -1);
    inline-size: calc(100% + var(--grid-gutter) * 2);
    block-size: 100%;
    mask-image: radial-gradient(
      ellipse 80% 90% at 60% 50%,
      #000 50%,
      transparent 100%
    );
  }

  .frame {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--space-xs);
    block-size: 100%;
    padding-block: var(--space-xs);
  }

  .year {
    display: none;
  }

  .desk {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    inline-size: min(100%, 34rem);
    margin-inline: auto;
  }

  /* Die Datensätze liegen übereinander in einer Zelle über der Akte; die
     Flugbahn der Angaben misst das Skript. */
  .records {
    position: relative;
    z-index: 2;
    display: grid;
    min-block-size: 5rem;
  }

  .records > * {
    grid-area: 1 / 1;
  }

  .record {
    --show: 0;
    --hit: 0;
    --fly: 0;
    --land: 0;
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--edge);
    border-radius: var(--radius-lg);
    background: rgb(12 13 16 / 0.88);
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    opacity: var(--show);
    visibility: hidden;
  }

  [data-ready] .record {
    visibility: visible;
  }

  .record-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    color: var(--text-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .record-head b {
    color: var(--hi);
    font-weight: 600;
  }

  .noise {
    display: block;
    inline-size: var(--w);
    block-size: 0.4rem;
    border-radius: 2px;
    background: repeating-linear-gradient(
      90deg,
      rgb(255 255 255 / 0.13) 0 2.6rem,
      transparent 2.6rem 3rem
    );
  }

  /* Auf dem Telefon reicht eine Zeile Rauschen unter Max. */
  .noise:last-child {
    display: none;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.4rem;
    color: var(--text);
  }

  .chip {
    padding: 0.05rem 0.3rem;
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.08);
    white-space: nowrap;
  }

  /* Neue Angaben fliegen in ihre Zeile und glühen dabei auf. */
  .chip:not([data-matched]) {
    background: color-mix(
      in oklab,
      rgb(255 255 255 / 0.08),
      var(--hi) calc(var(--fly) * 100%)
    );
    box-shadow: 0 0 calc(var(--fly) * 1.2rem) rgb(255 59 69 / 0.6);
    opacity: calc(1 - var(--land));
    translate: calc(var(--dx, 0px) * var(--fly))
      calc(var(--dy, 0px) * var(--fly));
    scale: calc(1 + var(--fly) * 0.15);
  }

  .chip[data-matched] {
    outline: 1px solid rgb(255 59 69 / var(--hit));
    background: rgb(255 59 69 / calc(var(--hit) * 0.25));
  }

  .pile-count {
    --pile: 0;
    align-self: center;
    max-inline-size: 32ch;
    color: var(--text-2);
    font-size: 0.8125rem;
    line-height: 1.35;
    opacity: var(--pile);
  }

  .pile-count b {
    display: block;
    color: var(--text);
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* ---------- Akte ------------------------------------------------------ */

  .file-wrap {
    position: relative;
  }

  /* Papier bleibt in beiden Farbmodi hell. */
  .file {
    --blur: 0;
    --dim: 0;
    --stamp: 1;
    position: relative;
    display: grid;
    gap: 0.45rem;
    padding: 0.7rem 0.8rem 0.6rem;
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgb(255 255 255 / 0.5), transparent 30%), #f2efe7;
    color: var(--paper-ink);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 30px 60px -20px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(0 0 0 / 0.4);
    overflow: clip;
    color-scheme: light;
    opacity: calc(1 - var(--dim) * 0.5);
  }

  .file-head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.35rem;
    border-block-end: 2px solid var(--paper-ink);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .file-head b {
    font-weight: 650;
    letter-spacing: 0.3em;
  }

  .as-of:has(> :empty) {
    visibility: hidden;
  }

  .file-body {
    display: grid;
    gap: 0.75rem;
  }

  .portrait {
    display: none;
  }

  .file dl {
    display: grid;
  }

  .row {
    --fill: 1;
    --hit: 0;
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.1rem 0.3rem;
    border-block-end: 1px solid rgb(0 0 0 / 0.08);
    border-radius: var(--radius-xs);
    background: rgb(201 0 13 / calc(var(--hit) * 0.12));
    box-shadow: inset 0 0 0 1px rgb(201 0 13 / var(--hit));
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .row::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0.3rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-xs);
    background: var(--paper-red);
    color: #fff;
    content: var(--hit-label);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: var(--hit);
    translate: 0 -50%;
  }

  .row dt {
    overflow: hidden;
    color: var(--paper-ink-3);
    font-size: 0.5625rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .row dd {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-inline-size: 0;
    margin: 0;
  }

  /* Der Balken deckt genau den Wert ab und gibt ihn von links frei. */
  .slot {
    display: inline-grid;
    min-inline-size: 0;
  }

  .slot > * {
    grid-area: 1 / 1;
  }

  .value {
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: var(--fill);
  }

  .bar {
    align-self: center;
    block-size: 0.85em;
    border-radius: 1px;
    background: var(--paper-ink);
    transform-origin: right;
    scale: calc(1 - var(--fill)) 1;
  }

  .from {
    margin-inline-start: auto;
    color: var(--paper-red);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: calc(var(--fill) * (1 - var(--hit)));
  }

  .stamp {
    position: absolute;
    inset-block-end: 1.6rem;
    inset-inline-end: 0.9rem;
    padding: 0.1rem 0.45rem;
    border: 3px solid var(--paper-red);
    border-radius: var(--radius-sm);
    color: var(--paper-red);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    mix-blend-mode: multiply;
    opacity: calc(var(--stamp) * 0.85);
    rotate: -9deg;
    scale: calc(1.8 - var(--stamp) * 0.8);
    pointer-events: none;
  }

  .file-foot {
    color: var(--paper-ink-3);
    font-size: 0.6875rem;
  }

  .file-foot b {
    color: var(--paper-ink);
  }

  /* Die Jahresmeldungen kommen von unten und landen versetzt auf der Akte. */
  .pile {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sheet {
    --in: 1;
    position: absolute;
    inset-block-start: 16%;
    inset-inline: 7%;
    display: grid;
    gap: 0.45rem;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    background: #fbfaf6;
    color: var(--paper-ink);
    box-shadow:
      0 18px 40px -16px rgb(0 0 0 / 0.7),
      0 0 0 1px rgb(0 0 0 / 0.25);
    font-size: 0.75rem;
    line-height: 1.4;
    opacity: min(1, calc(var(--in) * 3));
    translate: calc(var(--i) * 0.3rem)
      calc((1 - var(--in)) * 80svh + var(--i) * -0.25rem);
    rotate: calc(var(--r) * var(--in));
  }

  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.75rem;
    padding-block-end: 0.35rem;
    border-block-end: 1px solid rgb(0 0 0 / 0.15);
  }

  .sheet-head b {
    font-weight: 650;
  }

  .sheet-head span {
    color: var(--paper-ink-3);
  }

  .sheet ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sheet li:last-child {
    color: var(--paper-red);
    font-weight: 600;
  }

  /* ---------- Zeitleiste ------------------------------------------------ */

  /* Jede Marke ist ein Link zu ihrem Abschnitt; ziehen muss man nichts. */
  .rail {
    --rail: 1;
    grid-row: 1;
    user-select: none;
    -webkit-user-select: none;
  }

  .rail ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--ticks), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Die Linie läuft von der ersten zur letzten Marke. */
  .rail ol::before,
  .rail ol::after {
    position: absolute;
    inset-block-start: 0.45rem;
    inset-inline: calc(50% / var(--ticks));
    block-size: 2px;
    border-radius: 1px;
    background: rgb(255 255 255 / 0.16);
    content: "";
  }

  .rail ol::after {
    background: var(--hi);
    transform-origin: left;
    scale: var(--rail) 1;
  }

  .rail a {
    position: relative;
    display: grid;
    justify-items: center;
    padding-block: 1.15rem 0;
    color: var(--text-3);
    font-size: 0.625rem;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .rail a::before {
    position: absolute;
    inset-block-start: 0.15rem;
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border: 2px solid rgb(255 255 255 / 0.32);
    border-radius: 50%;
    background: var(--stage);
    content: "";
    transition:
      scale 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }

  .rail a:hover,
  .rail a[aria-current] {
    color: var(--text);
  }

  .rail a[data-passed]::before {
    border-color: var(--hi);
    background: var(--hi);
  }

  .rail a[aria-current]::before {
    border-color: var(--hi);
    background: var(--hi);
    box-shadow: 0 0 0 4px rgb(255 59 69 / 0.25);
    scale: 1.3;
  }

  .tick-name {
    max-inline-size: 100%;
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- Karten ---------------------------------------------------- */

  /* Die Karten liegen über der Bühne, lassen aber Klicks auf die Zeitleiste
     durch. Auf dem Telefon bleiben sie unten stehen, solange ihr Abschnitt
     läuft. */
  .steps {
    position: relative;
    z-index: 1;
    display: grid;
    pointer-events: none;
  }

  .step {
    min-block-size: calc(var(--len) * 0.85svh);
  }

  /* Auf dem Telefon ist unter der Akte ein Fenster für den Text: Das Skript
     setzt --top an seinen oberen Rand, und was darüber hinausscrollt,
     schneidet --cut ab. So verdeckt keine Karte die Akte. */
  .card {
    position: sticky;
    inset-block-start: var(--top, auto);
    clip-path: inset(var(--cut, 0px) 0 0 0 round var(--radius-xl));
    display: grid;
    gap: 0.35rem;
    max-inline-size: 30rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--edge);
    border-radius: var(--radius-xl);
    background: var(--glass);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.8);
    backdrop-filter: blur(18px) saturate(1.3);
    font-size: 0.875rem;
    line-height: 1.45;
    pointer-events: auto;
  }

  .card:focus {
    outline: none;
  }

  .card h2 {
    color: var(--text);
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.75rem);
  }

  .card h3 {
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  .card p {
    color: var(--text-2);
    text-wrap: pretty;
  }

  .card.intro p {
    color: var(--text);
    font-size: var(--step-1);
  }

  .card .kicker {
    display: flex;
    gap: 0.5rem;
    color: var(--hi);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .kicker span {
    color: var(--text);
  }

  .delta {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    font-size: 0.8125rem;
  }

  .delta div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4rem;
  }

  .delta dt {
    color: var(--text-3);
  }

  .delta dt::after {
    content: ":";
  }

  .delta dd {
    margin: 0;
    color: var(--text);
    font-weight: 550;
  }

  .card .source {
    color: var(--text-3);
    font-size: 0.75rem;
  }

  .more {
    justify-self: start;
    color: var(--text);
    font-weight: 600;
    text-decoration-color: var(--hi);
    text-underline-offset: 0.2em;
  }

  /* Solange die Geschichte den Bildschirm füllt, weicht die mobile Leiste
     mit Spenden und Teilen. */
  :global(html[data-immersive] [data-action-bar]) {
    translate: 0 110%;
  }

  /* ---------- Breitere Bildschirme ------------------------------------- */

  @container campaign (width >= 30rem) {
    .file-body {
      grid-template-columns: 4rem minmax(0, 1fr);
      align-items: start;
    }

    .portrait {
      display: block;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: var(--radius-xs);
      background: #d9d4c8;
    }

    .portrait svg {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      fill: #8c877c;
      filter: blur(calc(var(--blur) * 1px));
    }
  }

  /* Text links, Bühne rechts, die Jahreszahl groß über der Karte. */
  @container campaign (width >= 56rem) {
    .frame {
      grid-template-columns: minmax(19rem, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: minmax(0, 1fr) auto;
      gap: var(--space-s) var(--space-xl);
      padding-block: var(--space-m);
    }

    .year {
      display: block;
      grid-area: 1 / 1;
      align-self: start;
      background: linear-gradient(180deg, #fff, rgb(255 255 255 / 0.2));
      background-clip: text;
      color: transparent;
      font-size: clamp(3.5rem, 2rem + 4.5vw, 6.5rem);
      font-weight: 250;
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .desk {
      grid-area: 1 / 2;
      align-self: center;
      gap: var(--space-m);
      inline-size: min(100%, 36rem);
    }

    .records {
      min-block-size: 6.75rem;
    }

    .record {
      font-size: 0.75rem;
    }

    .noise:last-child {
      display: block;
    }

    .file {
      gap: 0.6rem;
      padding: 1rem 1.25rem 0.9rem;
    }

    .file-head {
      font-size: 0.75rem;
    }

    .file-body {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    .row {
      grid-template-columns: 8rem minmax(0, 1fr);
      padding-block: 0.3rem;
      font-size: 0.875rem;
    }

    .row dt {
      font-size: 0.6875rem;
      white-space: normal;
    }

    .stamp {
      inset-block-end: 2.2rem;
      font-size: 1.125rem;
    }

    .sheet {
      padding: 1rem 1.25rem;
      font-size: 0.875rem;
    }

    .rail {
      grid-area: 2 / 2;
    }

    .rail a {
      font-size: 0.75rem;
    }

    .step {
      display: grid;
      grid-template-columns: minmax(19rem, 0.8fr) minmax(0, 1.2fr);
      align-content: start;
      column-gap: var(--space-xl);
    }

    .step:last-child {
      padding-block-end: var(--space-xl);
    }

    .card {
      inset-block: calc(var(--pin-top) + 24svh) auto;
      padding: var(--space-m);
      font-size: var(--step-0);
    }

    .card.intro {
      inset-block-start: calc(var(--pin-top) + 20svh);
      margin-block-start: 20svh;
    }

    .card h3 {
      font-size: var(--step-1);
    }

    .delta {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // Turns the scroll position into one progress value p: 0 is the intro,
  // then one unit per card, each with its fraction. Every frame derives the
  // whole stage from p, so scrolling back rewinds it. With reduced motion,
  // nothing flies or zooms and every change snaps.
  const root = document.querySelector<HTMLElement>("[data-journey]")
  if (root) start(root)

  interface Dot {
    x: number
    y: number
    distance: number
    // 0: in no list, 1: in the first, 2: also the second, 3: also the
    // third, 4: Max.
    depth: number
  }

  function start(root: HTMLElement) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)")
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")]
    const pin = root.querySelector<HTMLElement>(".pin")
    const canvas = root.querySelector<HTMLCanvasElement>(".crowd")
    const context = canvas?.getContext("2d")
    const recordBox = root.querySelector<HTMLElement>(".records")
    const frame = root.querySelector<HTMLElement>(".frame")
    const desk = root.querySelector<HTMLElement>(".desk")
    const cards = [...root.querySelectorAll<HTMLElement>(".card")]
    const file = root.querySelector<HTMLElement>(".file")
    const records = [...root.querySelectorAll<HTMLElement>("[data-record]")]
    const rows = [...root.querySelectorAll<HTMLElement>(".row")]
    const sheets = [...root.querySelectorAll<HTMLElement>(".sheet")]
    const yearLabels = [
      ...root.querySelectorAll<HTMLElement>("[data-year-label]"),
    ]
    const known = root.querySelector<HTMLElement>("[data-known]")
    const filedCount = root.querySelector<HTMLElement>("[data-reports]")
    const pileCount = root.querySelector<HTMLElement>(".pile-count")
    const rail = root.querySelector<HTMLElement>(".rail")
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-goto]")]
    if (
      !pin ||
      !canvas ||
      !context ||
      !recordBox ||
      !file ||
      !known ||
      !filedCount ||
      !pileCount ||
      !rail
    )
      return

    const matchScene = records.length + 1
    const reportScene = records.length + 2
    const firstReport = Number(root.dataset.first)
    // Where a click on the timeline lands within each scene: the record
    // already in the file, the match stamped, a few reports filed, the end.
    const landing = [...records.map(() => 0.8), 0.55, 0.45, 0.9]

    // The records that only match a piece, so its row lights up meanwhile.
    const matches = new Map<string, number[]>()
    records.forEach((record, index) => {
      for (const chip of record.querySelectorAll<HTMLElement>(
        "[data-matched]",
      )) {
        const piece = chip.dataset.piece ?? ""
        matches.set(piece, [...(matches.get(piece) ?? []), index])
      }
    })

    const clamp = (value: number) => Math.min(1, Math.max(0, value))
    const ramp = (value: number, from: number, to: number) =>
      clamp((value - from) / (to - from))
    const ease = (value: number) =>
      value < 0.5 ? 4 * value ** 3 : 1 - (-2 * value + 2) ** 3 / 2
    const snap = (value: number) =>
      motion.matches ? (value >= 0.5 ? 1 : 0) : value
    // A record's own clock: in, matched pieces lit, new pieces flying,
    // landed, out.
    const phases = (t: number) => ({
      show: snap(ramp(t, 0, 0.14) * (1 - ramp(t, 0.86, 1))),
      hit: snap(ramp(t, 0.12, 0.28) * (1 - ramp(t, 0.6, 0.74))),
      fly: motion.matches ? 0 : ease(ramp(t, 0.3, 0.66)),
      land: snap(ramp(t, 0.62, 0.72)),
    })

    let tops: number[] = []
    let heights: number[] = []
    let dots: Dot[] = []
    let center = { x: 0, y: 0 }
    let reach = 1
    let pinTop = 0
    // How far below the top of the window the scenes are read: the middle
    // on wide screens, the top of the text window on phones.
    let reading = 0
    let wide = true
    let ratio = 1
    let queued = false
    let visible = false

    // Deterministic noise, so the crowd looks the same on every visit.
    const noise = (seed: number) => {
      const value = Math.sin(seed * 127.1 + 311.7) * 43758.5453
      return value - Math.floor(value)
    }

    function measure() {
      const scroll = window.scrollY
      tops = steps.map((step) => step.getBoundingClientRect().top + scroll)
      heights = steps.map((step) => step.offsetHeight)
      if (pin) pinTop = Number.parseFloat(getComputedStyle(pin).top) || 0

      // On phones the cards stop just below the file, or higher where a
      // card would not fit on the screen.
      wide = frame
        ? getComputedStyle(frame).gridTemplateColumns.split(" ").length > 1
        : true
      const below =
        (desk?.getBoundingClientRect().bottom ?? 0) -
        (pin?.getBoundingClientRect().top ?? 0) +
        pinTop +
        8
      reading = wide ? window.innerHeight * 0.5 : below
      for (const card of cards) {
        card.style.removeProperty("--cut")
        if (wide) card.style.removeProperty("--top")
        else
          card.style.setProperty(
            "--top",
            `${Math.min(below, window.innerHeight - card.offsetHeight - 8)}px`,
          )
      }

      // Where the new pieces of each record fly to.
      for (const record of records) {
        record.style.setProperty("--fly", "0")
        for (const chip of record.querySelectorAll<HTMLElement>(
          ".chip:not([data-matched])",
        )) {
          const target = root
            .querySelector(`.row[data-piece="${chip.dataset.piece}"] .slot`)
            ?.getBoundingClientRect()
          if (!target) continue
          const from = chip.getBoundingClientRect()
          chip.style.setProperty("--dx", `${target.left - from.left}px`)
          chip.style.setProperty(
            "--dy",
            `${target.top + target.height / 2 - (from.top + from.height / 2)}px`,
          )
        }
      }

      // The crowd fills the canvas; Max stands where the records appear.
      if (!canvas || !recordBox) return
      const box = canvas.getBoundingClientRect()
      const spot = recordBox.getBoundingClientRect()
      ratio = Math.min(2, window.devicePixelRatio || 1)
      canvas.width = Math.round(box.width * ratio)
      canvas.height = Math.round(box.height * ratio)
      center = {
        x: spot.left + spot.width / 2 - box.left,
        y: spot.top + spot.height / 2 - box.top,
      }
      const gap = box.width < 640 ? 11 : 13
      let seed = 1
      let nearest: Dot | undefined
      dots = []
      for (let y = gap / 2; y < box.height; y += gap)
        for (let x = gap / 2; x < box.width; x += gap) {
          seed += 1
          const dot: Dot = {
            x: x + (noise(seed) - 0.5) * gap * 0.7,
            y: y + (noise(seed + 0.5) - 0.5) * gap * 0.7,
            distance: 0,
            depth: 0,
          }
          if (noise(seed + 0.25) < 0.72) dot.depth = 1
          if (dot.depth && noise(seed + 0.75) < 0.05) dot.depth = 2
          if (dot.depth === 2 && noise(seed + 0.125) < 0.25) dot.depth = 3
          dot.distance = Math.hypot(dot.x - center.x, dot.y - center.y)
          if (!nearest || dot.distance < nearest.distance) nearest = dot
          dots.push(dot)
        }
      if (nearest) nearest.depth = 4
      reach = dots.reduce((most, dot) => Math.max(most, dot.distance), 1)
    }

    function progress() {
      const line = window.scrollY + reading
      let value = 0
      steps.forEach((_, index) => {
        if (line >= tops[index])
          value = index + clamp((line - tops[index]) / heights[index])
      })
      return value
    }

    // The crowd: everyone dim, then the first list lights up in a wave
    // from Max, and each further list leaves fewer people lit, until only
    // Max remains and the view closes in on him.
    function draw(p: number) {
      if (!context || !canvas) return
      const width = canvas.width / ratio
      const height = canvas.height / ratio
      const wave = snap(ramp(p, 1, 1.7))
      const second = snap(ramp(p, 2.1, 2.6))
      const third = snap(ramp(p, 3.1, 3.6))
      const alone = snap(ramp(p, matchScene, matchScene + 0.45))
      // With the reports, the crowd dims and Max leaves the picture.
      const away = snap(ramp(p, reportScene - 0.1, reportScene + 0.4))
      const fade = 1 - away * 0.85
      const zoom = motion.matches ? 1 : 1 + ease(alone) * 0.9

      context.setTransform(ratio, 0, 0, ratio, 0, 0)
      context.clearRect(0, 0, width, height)
      context.setTransform(
        ratio * zoom,
        0,
        0,
        ratio * zoom,
        ratio * center.x * (1 - zoom),
        ratio * center.y * (1 - zoom),
      )

      // Bucket the dots by colour and brightness, so the canvas changes
      // its fill only a few dozen times per frame.
      const buckets = new Map<number, Dot[]>()
      for (const dot of dots) {
        if (dot.depth === 4) continue
        const lit =
          dot.depth > 0 ? clamp((wave * reach * 1.15 - dot.distance) / 80) : 0
        let alpha = 0.13 + lit * 0.4
        if (dot.depth < 2) alpha *= 1 - second * 0.75
        if (dot.depth === 2) alpha *= 1 - third * 0.7
        if (dot.depth === 3) alpha += third * 0.3
        alpha *= (1 - alone * 0.92) * fade
        const red = dot.depth >= 2 && second > 0.5 ? 100 : 0
        const key = red + Math.round(alpha * 20)
        const bucket = buckets.get(key)
        if (bucket) bucket.push(dot)
        else buckets.set(key, [dot])
      }
      for (const [key, bucket] of buckets) {
        const red = key >= 100
        const alpha = (key % 100) / 20
        if (alpha === 0) continue
        context.fillStyle = red
          ? `rgb(255 59 69 / ${alpha})`
          : `rgb(255 244 230 / ${alpha})`
        const size = red ? 2.4 : 1.8
        for (const dot of bucket)
          context.fillRect(dot.x - size / 2, dot.y - size / 2, size, size)
      }

      // Max: lit with the first list, red once he is on the second,
      // ringed and named at the match.
      context.fillStyle =
        second > 0.5
          ? `rgb(255 59 69 / ${1 - away})`
          : `rgb(255 244 230 / ${wave > 0 ? 0.6 : 0.2})`
      context.beginPath()
      context.arc(
        center.x,
        center.y,
        (1.4 + second * 1.2 + alone * 1.4) / Math.sqrt(zoom),
        0,
        Math.PI * 2,
      )
      context.fill()
      if (alone > 0) {
        const strength = alone * (1 - away)
        context.strokeStyle = `rgb(255 59 69 / ${strength * 0.8})`
        context.lineWidth = 1.5 / zoom
        context.beginPath()
        context.arc(
          center.x,
          center.y,
          (12 + (1 - alone) * 40) / zoom,
          0,
          Math.PI * 2,
        )
        context.stroke()
        context.fillStyle = `rgb(243 242 238 / ${strength})`
        context.font = `600 ${13 / zoom}px "IBM Plex Sans", sans-serif`
        context.textAlign = "center"
        context.fillText("Max", center.x, center.y - 22 / zoom)
      }
    }

    const render = () => {
      queued = false
      const p = progress()
      const at = (scene: number) => clamp(p - scene)

      records.forEach((record, index) => {
        const phase = phases(at(index + 1))
        record.style.setProperty("--show", String(phase.show))
        record.style.setProperty("--hit", String(phase.hit))
        record.style.setProperty("--fly", String(phase.fly))
        record.style.setProperty("--land", String(phase.land))
      })

      let count = 0
      let identified = false
      for (const row of rows) {
        const fill = phases(at(Number(row.dataset.from) + 1)).land
        const hit = Math.max(
          0,
          ...(matches.get(row.dataset.piece ?? "") ?? []).map(
            (index) => phases(at(index + 1)).hit,
          ),
        )
        row.style.setProperty("--fill", String(fill))
        row.style.setProperty("--hit", String(hit))
        if (fill < 0.5) continue
        count += 1
        if (row.dataset.piece === "document") identified = true
      }
      known.textContent = String(count)

      // The portrait sharpens with every piece and is clear once an ID
      // image is out.
      file.style.setProperty(
        "--blur",
        String(identified ? 0 : Math.max(2, 12 - count * 1.6)),
      )
      file.style.setProperty(
        "--stamp",
        String(snap(ramp(at(matchScene), 0.15, 0.4))),
      )
      file.style.setProperty(
        "--dim",
        String(snap(ramp(p, reportScene, reportScene + 0.3))),
      )

      // One report a year over the last two scenes.
      const stack =
        ramp(p, reportScene + 0.08, reportScene + 1.35) * sheets.length
      let filed = 0
      sheets.forEach((sheet, index) => {
        const into = motion.matches
          ? Number(stack >= index + 1)
          : clamp(stack - index)
        sheet.style.setProperty("--in", String(into))
        if (into >= 0.5) filed += 1
      })
      filedCount.textContent = String(filed)
      pileCount.style.setProperty(
        "--pile",
        String(snap(ramp(p, reportScene, reportScene + 0.15))),
      )

      // The year, big beside the card and small on the file.
      const scene = Math.min(Math.floor(p), steps.length - 1)
      const year =
        p >= reportScene
          ? String(firstReport + Math.max(1, filed))
          : (steps[scene].dataset.year ?? "")
      for (const label of yearLabels)
        if (label.textContent !== year) label.textContent = year

      // The timeline: a line up to the current scene, and its mark.
      rail.style.setProperty(
        "--rail",
        String(clamp((p - 1.5) / (links.length - 1))),
      )
      links.forEach((link, index) => {
        link.toggleAttribute("data-passed", scene - 1 > index)
        if (scene - 1 === index) link.setAttribute("aria-current", "step")
        else link.removeAttribute("aria-current")
      })

      if (!wide)
        for (const card of cards) {
          const top = Number.parseFloat(card.style.getPropertyValue("--top"))
          const cut = Math.max(0, top - card.getBoundingClientRect().top)
          card.style.setProperty("--cut", `${cut}px`)
        }

      const box = root.getBoundingClientRect()
      document.documentElement.toggleAttribute(
        "data-immersive",
        box.top <= pinTop + 1 && box.bottom >= window.innerHeight,
      )

      draw(p)
    }

    function queue() {
      if (queued || !visible) return
      queued = true
      requestAnimationFrame(render)
    }

    function refresh() {
      measure()
      render()
    }

    links.forEach((link, index) => {
      link.addEventListener("click", (event) => {
        const scene = index + 1
        if (tops[scene] === undefined) return
        event.preventDefault()
        window.scrollTo({
          top: tops[scene] + heights[scene] * landing[index] - reading,
          behavior: motion.matches ? "auto" : "smooth",
        })
        steps[scene]
          .querySelector<HTMLElement>(".card")
          ?.focus({ preventScroll: true })
      })
    })

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      if (!visible) document.documentElement.removeAttribute("data-immersive")
      queue()
    }).observe(root)
    // The page above can grow, for example when the file is answered.
    new ResizeObserver(refresh).observe(document.body)
    window.addEventListener("scroll", queue, { passive: true })
    motion.addEventListener("change", render)
    document.fonts.ready.then(refresh)

    root.toggleAttribute("data-ready", true)
    refresh()
  }
</script>
