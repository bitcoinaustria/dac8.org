    }

    .step {
      display: grid;
      grid-template-columns: minmax(19rem, 0.8fr) minmax(0, 1.2fr);
      align-content: start;
      column-gap: var(--space-xl);
    }

    .step:first-child {
      grid-template-columns: minmax(0, 1fr);
    }

    .step:last-child {
      padding-block-end: var(--space-xl);
    }

    .card {
      inset-block: 31svh auto;
      padding: var(--space-m);
      font-size: var(--step-0);
    }

    .card.intro {
      inset-block-start: 26svh;
      margin-block-start: 20svh;
    }

    .card h3 {
      font-size: var(--step-1);
    }

    .delta {
      font-size: 0.875rem;
    }

    .card .closing {
      font-size: var(--step-2);
