---
import {
  breaches,
  end,
  intro,
  match,
  type Piece,
  reports,
  rows,
} from "@/data/file-timeline"
import { leaks } from "@/data/leaks"
import { type Language, pathFor } from "@/lib/i18n"

// "How scattered leaks become a file", told the way a product page tells a
// story: big type, one figure per chapter, and a file beside the text that
// fills in as the reader scrolls. Each leak adds its new pieces with the
// case and year; pieces the file already holds are only matched. A typed
// search then picks Max out, and DAC8 files a report every year in two
// places. Everything is readable without script; the script only plays
// the file, the search and the reports along with the scroll.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"

const leakFor = (id: string) => {
  const leak = leaks.find((candidate) => candidate.id === id)
  if (!leak) throw new Error(`Unknown leak: ${id}`)
  return leak
}
const label = (piece: Piece) =>
  rows.find((row) => row.id === piece)?.label[language] ?? piece
// Inside a sentence, English labels go lower case, except abbreviations
// such as "ID".
const inline = (text: string) =>
  en && !/^[A-Z]{2}/.test(text) ? text[0].toLowerCase() + text.slice(1) : text
const list = (pieces: Piece[]) =>
  new Intl.ListFormat(language, { type: "conjunction" }).format(
    pieces.map((piece) => inline(label(piece))),
  )
// Plain text with one **key phrase**: odd parts are set in bold.
const rich = (text: string) => text.split(/\*\*(.+?)\*\*/)

// Each piece lands once, with the first case that had it; later cases only
// match it.
const seen = new Set<Piece>()
const cases = breaches.map((breach, index) => {
  const leak = leakFor(breach.leak)
  const fields = breach.fields.map((field) => ({
    ...field,
    matched: seen.has(field.piece),
  }))
  for (const field of fields) seen.add(field.piece)
  return {
    ...breach,
    index,
    leak,
    fields,
    added: fields.filter((field) => !field.matched).map((field) => field.piece),
    matched: fields
      .filter((field) => field.matched)
      .map((field) => field.piece),
  }
})
// The case that brought each piece, and its place among that case's new
// pieces, so they land one after another.
const origin = new Map<Piece, { from: number; order: number }>(
  cases.flatMap((item) =>
    item.added.map(
      (piece, order) => [piece, { from: item.index, order }] as const,
    ),
  ),
)
const tag = (piece: Piece) => {
  const item = cases[origin.get(piece)?.from ?? 0]
  return `${item.leak.name[language]} ’${String(item.leak.year).slice(2)}`
}

const ending = leakFor(end.leak)
const millions = (ending.people ?? 0) / 1_000_000
const today = en ? "Today" : "Heute"
const sheets = Array.from(
  { length: reports.count },
  (_, index) => reports.first + index,
)
const last = reports.first + reports.count
const places = ["provider", "authority"] as const

// The chapters, for the timeline and its anchors.
const scenes = [
  ...cases.map((item) => ({
    id: item.leak.id,
    year: String(item.leak.year),
    name: item.leak.name[language],
  })),
  { id: "abgleich", year: today, name: match.short[language] },
  {
    id: "dac8",
    year: String(reports.first + 1),
    name: reports.short[language],
  },
  { id: "ende", year: String(last), name: end.short[language] },
]
const source = en ? "Source" : "Quelle"
const reportLabel = en
  ? `Annual report {n} of ${reports.count}`
  : `Jahresmeldung {n} von ${reports.count}`
---

<section
  id="zeitreise"
  class="journey"
  aria-labelledby="journey-heading"
  data-journey
  data-first={reports.first}
  data-report-label={reportLabel}
>
  <nav class="rail" aria-label={en ? "Timeline" : "Zeitleiste"}>
    <ol>
      {scenes.map((scene) => (
          <li>
            <a href={`#akte-${scene.id}`} data-goto>
              <span class="tick-year">{scene.year}</span>
              <span class="tick-name">{scene.name}</span>
            </a>
          </li>
        ))}
    </ol>
  </nav>

  <header class="intro">
    <p class="eyebrow" data-reveal>
      {en ? "Max Mustermann, 2020 to 2036" : "Max Mustermann, 2020 bis 2036"}
    </p>
    <h2 id="journey-heading" data-reveal>{intro.heading[language]}</h2>
    <p class="lede" data-reveal>
      {rich(intro.text[language]).map((part, index) =>
          index % 2 ? <strong>{part}</strong> : part,
        )}
    </p>
  </header>

  <div class="story">
    <div class="dossier" aria-hidden="true">
      <article
        class="file"
        style={`--hit-label: "${en ? "match" : "Treffer"}"`}
      >
        <header class="file-head">
          <b>{en ? "File" : "Akte"}</b>
          <span class="as-of">
            {en ? "As of" : "Stand"} <span data-year-label>{today}</span>
          </span>
        </header>
        <div class="file-body">
          <div class="portrait">
            <svg viewBox="0 0 64 80">
              <circle cx="32" cy="29" r="14"></circle>
              <path d="M6 80c0-17 11.6-28 26-28s26 11 26 28z"></path>
            </svg>
          </div>
          <dl>
            {rows.map((row) => (
                <div
                  class="row"
                  data-piece={row.id}
                  data-from={origin.get(row.id)?.from}
                  data-order={origin.get(row.id)?.order}
                >
                  <dt>{row.label[language]}</dt>
                  <dd>
                    <span class="slot">
                      <span class="value">{row.value[language]}</span>
                      <span class="bar" />
                    </span>
                    <span class="from">{tag(row.id)}</span>
                  </dd>
                </div>
              ))}
          </dl>
        </div>
        <p class="stamp">{en ? "Matched" : "Abgeglichen"}</p>
        <p class="file-foot">
          <b data-known>{rows.length}</b>
          {en
              ? ` of ${rows.length} details in other hands`
              : ` von ${rows.length} Angaben in fremden Händen`}
        </p>
      </article>
    </div>

    <div class="strip" aria-hidden="true">
      <p class="strip-head">
        <b>{en ? "File" : "Akte"}</b>
        <span>
          <b data-known>{rows.length}</b>
          {en ? ` of ${rows.length} details` : ` von ${rows.length} Angaben`}
        </span>
        <span class="strip-stamp">{en ? "Matched" : "Abgeglichen"}</span>
      </p>
      <ul>
        {rows.map((row) => (
            <li
              class="row"
              data-piece={row.id}
              data-from={origin.get(row.id)?.from}
              data-order={origin.get(row.id)?.order}
            >
              {row.label[language]}
            </li>
          ))}
      </ul>
    </div>

    <ol class="chapters">
      {cases.map((item) => (
          <li
            class="chapter"
            id={`akte-${item.leak.id}`}
            data-chapter
            data-year={item.leak.year}
          >
            <p class="eyebrow" data-reveal>
              <span>{item.leak.year}</span> {item.leak.name[language]}
            </p>
            <h3 data-reveal>{item.leak.headline[language]}</h3>
            <p class="figure" data-reveal>
              {item.atLeast && <small>{en ? "at least" : "mindestens"}</small>}
              <b>{item.figure[language]}</b>
              <small>{item.unit[language]}</small>
            </p>
            <p class="body" data-reveal>
              {item.text[language]}
            </p>
            <div class="raw" data-reveal aria-hidden="true">
              <p class="raw-label">
                {en
                  ? `Max’s line in the copy, ${item.where[language].toLowerCase()}`
                  : `Seine Zeile in der Kopie, ${item.where[language]}`}
              </p>
              <p class="raw-line">
                {item.fields.map((field) => (
                  <span
                    data-piece={field.piece}
                    data-matched={field.matched ? "" : undefined}
                  >
                    {field.raw[language]}
                  </span>
                ))}
              </p>
            </div>
            <dl class="delta" data-reveal>
              <div>
                <dt>{en ? "New in the file" : "Neu in der Akte"}</dt>
                <dd>{list(item.added)}</dd>
              </div>
              {item.matched.length > 0 && (
                <div>
                  <dt>{en ? "Matched on" : "Abgeglichen über"}</dt>
                  <dd>{list(item.matched)}</dd>
                </div>
              )}
            </dl>
            <p class="source">
              {source}: {item.leak.sources[0].label[language]}
            </p>
          </li>
        ))}

      <li class="chapter" id="akte-abgleich" data-chapter data-year={today}>
        <p class="eyebrow" data-reveal>
          <span>{today}</span>
          {match.short[language]}
        </p>
        <h3 data-reveal>{match.heading[language]}</h3>
        <div class="prompt" data-reveal aria-hidden="true">
          <p class="prompt-head">
            <span class="spark">✦</span>
            {match.prompt[language]}
          </p>
          <p class="prompt-text">
            <span data-typed data-text={match.query[language]}
              >{match.query[language]}</span
            ><i class="caret"></i>
          </p>
          <p class="prompt-result">{match.result[language]}</p>
        </div>
        <p class="body" data-reveal>
          {rich(match.text[language]).map((part, index) =>
              index % 2 ? <strong>{part}</strong> : part,
            )}
        </p>
      </li>
    </ol>
  </div>

  <div class="years" id="akte-dac8">
    <header class="years-head">
      <p class="eyebrow" data-reveal>
        <span>{reports.first + 1}</span>
        {reports.short[language]}
      </p>
      <h3 data-reveal>{reports.heading[language]}</h3>
      <p class="lede" data-reveal>
        {rich(reports.text[language]).map((part, index) =>
            index % 2 ? <strong>{part}</strong> : part,
          )}
      </p>
    </header>

    <div class="years-track">
      <div class="years-stage" aria-hidden="true">
        <p class="figure year">
          <b data-report-year>{last}</b>
          <small data-year-caption
            >{reportLabel.replace("{n}", String(reports.count))}</small
          >
        </p>
        <div class="shelves">
          {places.map((place) => (
              <div class="shelf" data-shelf={place}>
                <p class="shelf-label">
                  <b data-filed>{reports.count}</b>
                  {reports.places[place][language]}
                </p>
                <ol>
                  {sheets.map((year, index) => (
                    <li class="tile" style={`--i: ${index}`}>
                      <span>{year}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
        </div>
        <ul class="spec">
          {reports.sheet[language].map((line) => (
              <li>{line}</li>
            ))}
        </ul>
      </div>
    </div>
  </div>

  <footer class="finale" id="akte-ende">
    <p class="eyebrow" data-reveal>
      <span>{last}</span>
      {end.short[language]}
    </p>
    <h3 data-reveal>{end.heading[language]}</h3>
    <p class="lede" data-reveal>{end.text[language]}</p>
    <p class="figure" data-reveal>
      <small>{en ? "more than" : "mehr als"}</small>
      <b>{en ? `${millions} million` : `${millions} Mio.`}</b>
      <small>
        {en
            ? `people, tax data from ${ending.name.en} ${ending.year}`
            : `Menschen, Steuerdaten aus ${ending.name.de} ${ending.year}`}
      </small>
    </p>
    <p class="closing" data-closing>
      {end.closing[language].split(" ").map((word, index) => (
          <span class="word" style={`--w: ${index}`}>{word} </span>
        ))}
    </p>
    <p class="source">{source}: {ending.sources[0].label[language]}</p>
    <a class="more" href={pathFor("leaks", language)}
      >{en ? "More cases with sources" : "Mehr Fälle mit Quellen"}</a
    >
  </footer>
</section>

<style>
  /* Erzählt wie eine Produktseite: große Schrift, eine Zahl pro Kapitel,
     keine Kästen. Daneben steht die Akte und füllt sich beim Scrollen. Das
     Skript setzt die Variablen; ohne Skript steht alles im Endstand da. */
  .journey {
    --rail-h: 3.25rem;
    --sticky: calc(var(--header-height) + var(--rail-h) + 1.25rem);
    --mono:
      ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    --paper-ink: #1d1d1b;
    --paper-ink-3: #736f66;
    --paper-red: #c9000d;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .journey [data-reveal] {
    opacity: var(--in, 1);
    translate: 0 calc((1 - var(--in, 1)) * 1.75rem);
  }

  /* ---------- Zeitleiste ------------------------------------------------ */

  /* Eine schwebende Leiste wie bei einer Produktseite; jede Marke ist ein
     Link zu ihrem Kapitel, ziehen muss man nichts. */
  .rail {
    position: sticky;
    z-index: 3;
    inset-block-start: var(--header-height);
    display: flex;
    justify-content: center;
    box-sizing: content-box;
    block-size: var(--rail-h);
    padding-block-start: 0.5rem;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .rail ol {
    position: relative;
    display: flex;
    gap: 0.15rem;
    max-inline-size: 100%;
    margin: 0;
    padding: 0.25rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--background) 80%, transparent);
    box-shadow: 0 8px 28px -16px rgb(0 0 0 / 0.35);
    backdrop-filter: blur(16px) saturate(1.4);
    list-style: none;
    pointer-events: auto;
    scrollbar-width: none;
  }

  .rail a {
    display: grid;
    justify-items: center;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.15;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.25s,
      color 0.25s;
    -webkit-tap-highlight-color: transparent;
  }

  .rail a:hover {
    color: var(--foreground);
  }

  .rail a[aria-current] {
    background: var(--foreground);
    color: var(--background);
  }

  .tick-year {
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
  }

  .tick-name {
    font-weight: 600;
  }

  /* ---------- Schrift --------------------------------------------------- */

  .eyebrow {
    color: var(--accent);
    font-size: var(--step-0);
    font-weight: 600;
  }

  .eyebrow span {
    color: var(--foreground);
  }

  .journey h2,
  .journey h3 {
    color: var(--foreground);
    font-weight: 650;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .journey h2 {
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, 5.5rem);
    line-height: 1.02;
  }

  .journey h3 {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem);
    line-height: 1.06;
  }

  .lede,
  .body {
    color: var(--muted-foreground);
    font-size: var(--step-1);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .lede strong,
  .body strong {
    color: var(--foreground);
    font-weight: 550;
  }

  /* Eine Zahl wie auf einer Produktseite: klein, groß, klein. */
  .figure {
    display: grid;
    justify-items: start;
    gap: 0.15rem;
    color: var(--foreground);
  }

  .figure b {
    font-size: clamp(2.75rem, 1.8rem + 3.6vw, 4.75rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }

  .figure small {
    font-size: var(--step-0);
    line-height: 1.3;
  }

  .source {
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  /* ---------- Einstieg -------------------------------------------------- */

  .intro {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    padding-block: var(--space-xl) var(--space-2xl);
    text-align: center;
  }

  .intro .lede {
    max-inline-size: 38ch;
  }

  /* ---------- Kapitel und Akte ------------------------------------------ */

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .chapters {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Das Kapitel, das gerade gelesen wird, steht voll da; die anderen
     treten zurück. */
  .chapter {
    display: grid;
    align-content: center;
    gap: var(--space-s);
    min-block-size: 80svh;
    padding-block: var(--space-xl);
    opacity: calc(0.25 + var(--focus, 1) * 0.75);
    scroll-margin-block-start: var(--sticky);
    transition: opacity 0.35s;
  }

  .chapter .figure {
    margin-block: var(--space-2xs);
  }

  .raw {
    display: grid;
    gap: 0.35rem;
  }

  .raw-label {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .raw-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  /* Neue Angaben in Rot, abgeglichene nur umrandet. */
  .raw-line span {
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--accent);
  }

  .raw-line [data-matched] {
    background: none;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted-foreground);
  }

  .delta {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    font-size: var(--step-0);
  }

  .delta div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4rem;
  }

  .delta dt {
    color: var(--muted-foreground);
  }

  .delta dt::after {
    content: ":";
  }

  .delta dd {
    margin: 0;
    color: var(--foreground);
    font-weight: 550;
  }

  /* Die Suche: ein Satz, der sich beim Scrollen selbst tippt. */
  .prompt {
    --res: 1;
    display: grid;
    gap: 0.6rem;
    padding: 1rem 1.15rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: var(--paper);
    box-shadow:
      0 0 0 calc(var(--res) * 2px)
      color-mix(in oklab, var(--accent) 60%, transparent),
      0 18px 50px -24px rgb(0 0 0 / 0.35);
  }

  .prompt-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .spark {
    color: var(--accent);
    font-size: 0.875rem;
  }

  .prompt-text {
    min-block-size: 2.7em;
    color: var(--foreground);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .caret {
    display: inline-block;
    inline-size: 2px;
    block-size: 1.05em;
    margin-inline-start: 2px;
    background: var(--accent);
    vertical-align: -0.15em;
    animation: blink 1.1s steps(1) infinite;
  }

  .prompt[data-typing] .caret {
    animation: none;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .prompt-result {
    padding-block-start: 0.55rem;
    border-block-start: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.45;
    opacity: var(--res);
  }

  /* Die Akte: helles Papier in beiden Farbmodi. */
  .dossier {
    display: none;
  }

  .file {
    --blur: 0;
    --stamp: 1;
    --lift: 0;
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 1.1rem 1.3rem 0.9rem;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgb(255 255 255 / 0.55), transparent 30%), #f4f1ea;
    color: var(--paper-ink);
    box-shadow:
      0 0 0 calc(var(--lift) * 2px) rgb(201 0 13 / 0.8),
      0 0 0 1px rgb(0 0 0 / 0.1),
      0 2px 4px rgb(0 0 0 / 0.05),
      0 28px 56px -28px rgb(0 0 0 / 0.35);
    overflow: clip;
    color-scheme: light;
  }

  .file-head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.4rem;
    border-block-end: 2px solid var(--paper-ink);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .file-head b {
    font-weight: 650;
    letter-spacing: 0.3em;
  }

  .as-of:has(> :empty) {
    visibility: hidden;
  }

  .file-body {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }

  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: #d9d4c8;
  }

  .portrait svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    fill: #8c877c;
    filter: blur(calc(var(--blur) * 1px));
  }

  .file dl {
    display: grid;
    margin: 0;
  }

  .file .row {
    --fill: 1;
    --hit: 0;
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.28rem 0.3rem;
    border-block-end: 1px solid rgb(0 0 0 / 0.08);
    border-radius: var(--radius-xs);
    background: rgb(201 0 13 / calc(var(--hit) * 0.12));
    box-shadow: inset 0 0 0 1px rgb(201 0 13 / var(--hit));
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .file .row::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0.3rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-xs);
    background: var(--paper-red);
    color: #fff;
    content: var(--hit-label);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: var(--hit);
    translate: 0 -50%;
  }

  .file dt {
    color: var(--paper-ink-3);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .file dd {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-inline-size: 0;
    margin: 0;
  }

  /* Der Balken deckt genau den Wert ab und gibt ihn von links frei. */
  .slot {
    display: inline-grid;
    min-inline-size: 0;
  }

  .slot > * {
    grid-area: 1 / 1;
  }

  .value {
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: var(--fill);
  }

  .bar {
    align-self: center;
    block-size: 0.85em;
    border-radius: 1px;
    background: var(--paper-ink);
    transform-origin: right;
    scale: calc(1 - var(--fill)) 1;
  }

  .from {
    margin-inline-start: auto;
    color: var(--paper-red);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: calc(var(--fill) * (1 - var(--hit)));
  }

  /* Der Stempel sitzt unten unter dem Bild, wo er keinen Wert verdeckt. */
  .stamp {
    position: absolute;
    inset-block-end: 3.4rem;
    inset-inline-start: 0.9rem;
    padding: 0.1rem 0.4rem;
    border: 3px solid var(--paper-red);
    border-radius: var(--radius-sm);
    color: var(--paper-red);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    mix-blend-mode: multiply;
    opacity: calc(var(--stamp) * 0.85);
    rotate: -9deg;
    scale: calc(1.8 - var(--stamp) * 0.8);
    pointer-events: none;
  }

  .file-foot {
    color: var(--paper-ink-3);
    font-size: 0.75rem;
  }

  .file-foot b {
    color: var(--paper-ink);
  }

  /* Auf dem Telefon steht statt der Akte eine Leiste mit ihren Angaben
     oben; jede füllt sich, sobald ein Leck sie liefert. */
  .strip {
    --stamp: 1;
    position: sticky;
    z-index: 2;
    inset-block-start: calc(var(--header-height) + var(--rail-h) + 0.5rem);
    display: grid;
    gap: 0.4rem;
    padding-block: 0.5rem 0.9rem;
    border-image:
      linear-gradient(
        var(--background) 80%,
        color-mix(in oklab, var(--background) 0%, transparent)
      )
      fill 0 / / 0 100vw;
  }

  .strip-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .strip-head > b {
    color: var(--foreground);
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .strip-head span b {
    color: var(--foreground);
  }

  .strip-stamp {
    margin-inline-start: auto;
    padding: 0 0.35rem;
    border: 2px solid var(--accent);
    border-radius: var(--radius-xs);
    color: var(--accent);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: var(--stamp);
    rotate: -4deg;
  }

  .strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .strip .row {
    --fill: 1;
    --hit: 0;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: color-mix(
      in oklab,
      var(--panel-strong),
      var(--foreground) calc(var(--fill) * 100%)
    );
    box-shadow: 0 0 0 calc(var(--hit) * 2px) var(--accent);
    color: color-mix(
      in oklab,
      var(--muted-foreground),
      var(--background) calc(var(--fill) * 100%)
    );
    font-size: 0.75rem;
    font-weight: 550;
    line-height: 1.3;
  }

  /* ---------- Jahresmeldungen ------------------------------------------- */

  /* Ein heller Streifen über die ganze Breite; darin füllen sich beim
     Scrollen zwei Reihen mit je zehn Meldungen. */
  .years {
    padding-block: var(--band-gap) 0;
    border-image: linear-gradient(var(--panel) 0 0) fill 0 / / 0 100vw;
    scroll-margin-block-start: var(--sticky);
  }

  .years-head {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    text-align: center;
  }

  .years-head .lede {
    max-inline-size: 46ch;
  }

  .years-track {
    block-size: 230svh;
  }

  .years-stage {
    position: sticky;
    inset-block-start: var(--sticky);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-l);
    min-block-size: calc(100svh - var(--sticky));
    padding-block: var(--space-m);
  }

  .figure.year {
    justify-items: center;
    text-align: center;
  }

  .figure.year b {
    font-size: clamp(3.5rem, 2rem + 6vw, 7.5rem);
  }

  .shelves {
    display: grid;
    gap: var(--space-m);
    inline-size: min(100%, 56rem);
  }

  .shelf {
    display: grid;
    gap: 0.5rem;
  }

  .shelf-label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--muted-foreground);
    font-size: var(--step-0);
  }

  .shelf-label b {
    min-inline-size: 1.5ch;
    color: var(--foreground);
    font-size: var(--step-2);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .shelf ol {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: clamp(0.25rem, 1vw, 0.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Jede Meldung ein Blatt Papier, das von oben in seinen Platz fällt; die
     Kopie für das Finanzamt kommt kurz danach. */
  .tile {
    --in: 1;
    display: grid;
    align-content: end;
    aspect-ratio: 3 / 4;
    padding: 0.2rem;
    border-radius: 0.35rem;
    background:
      linear-gradient(#d4d0c6 0 0) 18% 24% / 64% 6% no-repeat,
      linear-gradient(#d4d0c6 0 0) 18% 38% / 50% 6% no-repeat,
      linear-gradient(#d4d0c6 0 0) 18% 52% / 58% 6% no-repeat,
      #fbfaf6;
    box-shadow:
      0 10px 20px -12px rgb(0 0 0 / 0.5),
      0 0 0 1px rgb(0 0 0 / 0.1);
    color: var(--paper-ink);
    font-size: clamp(0.5rem, 0.35rem + 0.5vw, 0.75rem);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    text-align: center;
    opacity: min(1, calc(var(--in) * 2));
    translate: 0 calc((1 - var(--in)) * -2.5rem);
    scale: calc(0.85 + var(--in) * 0.15);
  }

  .spec {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .spec li {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.8125rem;
  }

  .spec li:last-child {
    color: var(--accent);
    font-weight: 600;
  }

  /* ---------- Schluss --------------------------------------------------- */

  .finale {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    padding-block: var(--band-gap);
    text-align: center;
    scroll-margin-block-start: var(--sticky);
  }

  .finale .lede {
    max-inline-size: 46ch;
  }

  .finale .figure {
    justify-items: center;
    margin-block: var(--space-s);
  }

  /* Der letzte Satz leuchtet Wort für Wort auf. */
  .closing {
    max-inline-size: 18ch;
    margin-block: var(--space-m) var(--space-s);
    color: var(--foreground);
    font-size: clamp(2.25rem, 1.3rem + 3.8vw, 4.5rem);
    font-weight: 650;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .word {
    opacity: clamp(0.15, calc(var(--seen, 99) - var(--w)), 1);
    transition: opacity 0.2s;
  }

  .more {
    color: var(--foreground);
    font-weight: 600;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }

    .chapter,
    .word {
      transition: none;
    }
  }

  /* ---------- Breitere Bildschirme ------------------------------------- */

  /* Auf dem Telefon liegt die Leiste mit der Akte auf einem Band, damit
     kein Text dahinter durchscheint. */
  @container campaign (width < 56rem) {
    .rail {
      border-image: linear-gradient(var(--background) 0 0) fill 0 / / 0 100vw;
    }
  }

  @container campaign (width >= 40rem) {
    .rail a {
      padding-inline: 0.9rem;
    }
  }

  /* Text links, die Akte rechts daneben, solange die Kapitel laufen. */
  @container campaign (width >= 56rem) {
    .story {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      column-gap: var(--space-2xl);
    }

    .chapters {
      grid-area: 1 / 1;
    }

    .chapter {
      min-block-size: 95svh;
    }

    .strip {
      display: none;
    }

    .dossier {
      position: sticky;
      grid-area: 1 / 2;
      align-self: start;
      inset-block-start: calc(var(--sticky) + 6svh);
      display: block;
      perspective: 1600px;
    }

    .file {
      transform: rotateX(calc((1 - var(--enter, 1)) * 18deg))
        scale(calc(0.92 + var(--enter, 1) * 0.08));
      transform-origin: 50% 100%;
    }

    .shelf {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: center;
      gap: var(--space-m);
    }

    .shelf-label {
      display: grid;
      gap: 0;
    }
  }
</style>

<script>
  // Plays the story along with the scroll. Everything is derived from where
  // things stand on screen in each frame, so scrolling back rewinds it.
  // With reduced motion, text does not slide and every change snaps.
  const root = document.querySelector<HTMLElement>("[data-journey]")
  if (root) start(root)

  function start(root: HTMLElement) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)")
    const all = (selector: string) => [
      ...root.querySelectorAll<HTMLElement>(selector),
    ]
    const one = (selector: string) => root.querySelector<HTMLElement>(selector)
    const reveals = all("[data-reveal]")
    const chapters = all("[data-chapter]")
    const rows = all("[data-from]")
    const fileRows = all(".file [data-from]")
    const knowns = all("[data-known]")
    const yearLabels = all("[data-year-label]")
    const providerTiles = all('[data-shelf="provider"] .tile')
    const authorityTiles = all('[data-shelf="authority"] .tile')
    const filedLabels = all("[data-filed]")
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-goto]")]
    const targets = links.map((link) =>
      document.getElementById(link.hash.slice(1)),
    )
    const dossier = one(".dossier")
    const file = one(".file")
    const strip = one(".strip")
    const prompt = one(".prompt")
    const typed = one("[data-typed]")
    const track = one(".years-track")
    const stage = one(".years-stage")
    const year = one("[data-report-year]")
    const caption = one("[data-year-caption]")
    const closing = one("[data-closing]")
    const railList = one(".rail ol")
    if (
      !dossier ||
      !file ||
      !strip ||
      !prompt ||
      !typed ||
      !track ||
      !stage ||
      !year ||
      !caption ||
      !closing ||
      !railList
    )
      return

    const firstReport = Number(root.dataset.first)
    const reportLabel = root.dataset.reportLabel ?? ""
    const text = typed.dataset.text ?? ""
    const words = closing.querySelectorAll(".word").length
    const matchChapter = chapters.length - 1

    // The chapters that only match a piece, so its row lights up meanwhile.
    const matches = new Map<string, number[]>()
    chapters.forEach((chapter, index) => {
      for (const field of chapter.querySelectorAll<HTMLElement>(
        "[data-matched]",
      )) {
        const piece = field.dataset.piece ?? ""
        matches.set(piece, [...(matches.get(piece) ?? []), index])
      }
    })

    const clamp = (value: number) => Math.min(1, Math.max(0, value))
    const ramp = (value: number, from: number, to: number) =>
      clamp((value - from) / (to - from))
    const ease = (value: number) => 1 - (1 - value) ** 3
    const snap = (value: number) =>
      motion.matches ? (value >= 0.5 ? 1 : 0) : value
    const set = (element: HTMLElement, name: string, value: number) =>
      element.style.setProperty(name, String(value))
    const write = (element: HTMLElement, value: string) => {
      if (element.textContent !== value) element.textContent = value
    }

    let queued = false
    let current = -1

    const render = () => {
      queued = false
      const height = window.innerHeight
      const wide = getComputedStyle(dossier).display !== "none"

      // Text rises and fades in as it comes up from the bottom.
      for (const element of reveals) {
        const top = element.getBoundingClientRect().top
        set(
          element,
          "--in",
          motion.matches
            ? 1
            : ease(ramp(height * 0.95 - top, 0, height * 0.22)),
        )
      }

      // Where the reader is among the chapters: p counts the chapters
      // passed, with the fraction of the current one. The chapter on the
      // reading line stands in full, the others step back.
      const line = height * (wide ? 0.5 : 0.62)
      let p = -1
      chapters.forEach((chapter, index) => {
        const box = chapter.getBoundingClientRect()
        const t = (line - box.top) / box.height
        if (t >= 0) p = index + clamp(t)
        set(chapter, "--focus", 1 - clamp(Math.max(-t, t - 1) * 5))
      })
      const at = (index: number) => clamp(p - index)

      // The file: each new piece lands with its chapter, one after another;
      // pieces a chapter only matches light up meanwhile.
      for (const row of rows) {
        const order = Number(row.dataset.order) * 0.07
        const fill = snap(
          ramp(at(Number(row.dataset.from)), 0.1 + order, 0.24 + order),
        )
        const hit = Math.max(
          0,
          ...(matches.get(row.dataset.piece ?? "") ?? []).map((index) =>
            snap(ramp(at(index), 0.04, 0.12) * (1 - ramp(at(index), 0.4, 0.5))),
          ),
        )
        set(row, "--fill", fill)
        set(row, "--hit", hit)
      }
      let known = 0
      let identified = false
      for (const row of fileRows) {
        if (Number.parseFloat(row.style.getPropertyValue("--fill")) < 0.5)
          continue
        known += 1
        if (row.dataset.piece === "document") identified = true
      }
      for (const label of knowns) write(label, String(known))
      set(file, "--blur", identified ? 0 : Math.max(2, 12 - known * 1.6))
      const stamp = snap(ramp(at(matchChapter), 0.42, 0.55))
      set(file, "--stamp", stamp)
      set(strip, "--stamp", stamp)
      set(file, "--lift", snap(ramp(at(matchChapter), 0.38, 0.5)))
      const scene = Math.min(Math.max(Math.floor(p), 0), chapters.length - 1)
      for (const label of yearLabels)
        write(label, chapters[scene].dataset.year ?? "")

      // The file tilts upright as it comes into view.
      set(
        dossier,
        "--enter",
        motion.matches
          ? 1
          : ease(
              ramp(
                height - dossier.getBoundingClientRect().top,
                0,
                height * 0.6,
              ),
            ),
      )

      // The search types itself, then shows its one match.
      const typing = motion.matches ? 1 : ramp(at(matchChapter), 0.02, 0.32)
      write(typed, text.slice(0, Math.round(text.length * typing)))
      prompt.toggleAttribute("data-typing", typing > 0 && typing < 1)
      set(prompt, "--res", snap(ramp(at(matchChapter), 0.34, 0.42)))

      // The reports: while the stage stands, one a year lands on the
      // provider's row, and its copy on the tax authority's.
      const trackBox = track.getBoundingClientRect()
      const stuck = Number.parseFloat(getComputedStyle(stage).top) || 0
      const run = Math.max(1, trackBox.height - stage.offsetHeight)
      const stack =
        ramp((stuck - trackBox.top) / run, 0.05, 0.9) * providerTiles.length
      let filed = 0
      let sent = 0
      providerTiles.forEach((tile, index) => {
        const into = motion.matches
          ? Number(stack >= index + 1)
          : clamp((stack - index) * 2)
        set(tile, "--in", into)
        if (into >= 0.5) filed += 1
      })
      authorityTiles.forEach((tile, index) => {
        const into = motion.matches
          ? Number(stack >= index + 1)
          : clamp((stack - index) * 2 - 1)
        set(tile, "--in", into)
        if (into >= 0.5) sent += 1
      })
      write(filedLabels[0], String(filed))
      write(filedLabels[1], String(sent))
      const reported = Math.max(1, filed)
      write(year, String(firstReport + reported))
      write(caption, reportLabel.replace("{n}", String(reported)))

      // The closing line lights up word by word.
      const closingTop = closing.getBoundingClientRect().top
      set(
        closing,
        "--seen",
        motion.matches
          ? words
          : ramp(height * 0.9 - closingTop, 0, height * 0.4) * (words + 1),
      )

      // The timeline marks the chapter on the reading line and keeps it in
      // view inside the pill.
      let active = -1
      targets.forEach((target, index) => {
        if (target && target.getBoundingClientRect().top <= height * 0.5)
          active = index
      })
      if (active !== current) {
        current = active
        links.forEach((link, index) => {
          if (index === active) link.setAttribute("aria-current", "step")
          else link.removeAttribute("aria-current")
        })
        const link = links[active]
        if (link)
          railList.scrollTo({
            left:
              link.offsetLeft - (railList.clientWidth - link.offsetWidth) / 2,
            behavior: motion.matches ? "auto" : "smooth",
          })
      }
    }

    const queue = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(render)
    }

    window.addEventListener("scroll", queue, { passive: true })
    window.addEventListener("resize", queue)
    motion.addEventListener("change", render)
    render()
  }
</script>
