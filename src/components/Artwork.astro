---
import { Picture } from "astro:assets"
import { type Artwork, artwork, type ArtworkId, imageFor } from "@/data/artwork"
import type { Language } from "@/lib/i18n"

interface Props {
  id: ArtworkId
  language: Language
  // "hero" sits beside the headline, "scene" carries a story step, "side"
  // stands beside text, "wide" spans the content with its caption alongside.
  size?: "hero" | "scene" | "side" | "wide"
  // Link the full-resolution file from the caption, for detailed specimens.
  zoom?: boolean
  priority?: boolean
  // Replace the caption from the artwork data, or hide it where the
  // surrounding text already says what the picture shows.
  caption?: string | false
}

const {
  id,
  language,
  size = "side",
  zoom = false,
  priority = false,
  caption,
} = Astro.props
const entry: Artwork = artwork[id]
const image = imageFor(entry, language)
const text = entry[language]
const title = caption === undefined ? text.title : undefined
const note = caption === false ? undefined : (caption ?? text.caption)
// The box keeps the image's proportions before it has loaded, so figures and
// captions do not collapse while lazy images arrive.
const ratio = (image.width / image.height).toFixed(4)
const sizes = {
  hero: "(min-width: 64rem) 36rem, 92vw",
  scene: "(min-width: 64rem) 44rem, 92vw",
  side: "(min-width: 64rem) 36rem, 92vw",
  wide: "(min-width: 64rem) 58rem, 100vw",
}[size]
const widths = [360, 540, 720, 960, 1280, 1600].filter(
  (width) => width < image.width,
)
---

<figure class:list={["artwork", `artwork-${size}`]} style={`--ratio: ${ratio}`}>
  <Picture
    src={image}
    alt={text.alt}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={[...widths, image.width]}
    sizes={sizes}
    priority={priority}
  />
  {note && (
    <figcaption>
      {title && <strong>{title}</strong>}
      {note}
      {zoom && (
        <a class="artwork-zoom-link" href={image.src}>
          {language === "en" ? "Full size" : "In voller Größe"}
        </a>
      )}
    </figcaption>
  )}
</figure>
