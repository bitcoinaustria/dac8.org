---
import { Picture } from "astro:assets"
import { type Artwork, artwork, type ArtworkId } from "@/data/artwork"
import type { Language } from "@/lib/i18n"

interface Props {
  id: ArtworkId
  language: Language
  // "hero" sits beside the headline, "side" beside text, "wide" spans the
  // content column with its caption alongside.
  size?: "hero" | "side" | "wide"
  priority?: boolean
}

const { id, language, size = "side", priority = false } = Astro.props
const { image, [language]: text }: Artwork = artwork[id]
const sizes = {
  hero: "(min-width: 64rem) 21rem, (min-width: 40rem) 24rem, 90vw",
  side: "(min-width: 64rem) 27rem, (min-width: 40rem) 32rem, 90vw",
  wide: "(min-width: 64rem) 40rem, 100vw",
}[size]
const widths = [360, 540, 720, 960, 1280, 1600].filter(
  (width) => width < image.width,
)
---

<figure class:list={["artwork", `artwork-${size}`]}>
  <Picture
    src={image}
    alt={text.alt}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={[...widths, image.width]}
    sizes={sizes}
    priority={priority}
  />
  {text.caption && (
    <figcaption>
      {text.title && <strong>{text.title}</strong>}
      {text.caption}
    </figcaption>
  )}
</figure>
