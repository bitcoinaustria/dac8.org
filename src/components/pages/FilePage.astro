---
import CheckIcon from "@/assets/icons/check.svg"
import ShareIcon from "@/assets/icons/share.svg"
import Artwork from "@/components/Artwork.astro"
import DacFile from "@/components/DacFile.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { donateFor, languageFor, pathFor } from "@/lib/i18n"

const language = languageFor(Astro.url.pathname)
const en = language === "en"
---

<Layout>
  <MetaPage slot="head" />
  <article class="campaign">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "Your DAC8 file." : "Deine DAC8-Akte."}
          <span>{en ? "Year after year." : "Jahr für Jahr."}</span>
        </h1>
        <p class="lead">
          {en ? "See in a minute what your crypto provider reports about you every year from 2026, and what it keeps." : "Sieh in einer Minute, was dein Krypto-Anbieter ab 2026 jedes Jahr über dich meldet und was er aufbewahrt."}
        </p>
      </div>
      <Artwork
        id="yearsOnFile"
        language={language}
        size="hero"
        priority
        caption={false}
      />
    </header>

    <DacFile language={language} />

    <section id="weiter" class="next" aria-labelledby="next-heading">
      <h2 id="next-heading">
        {en ? "What you can do now" : "Was du jetzt tun kannst"}
      </h2>
      <div class="next-grid">
        <div class="next-lead">
          <h3>
            {en ? "Help fund the case against the blanket collection." : "Trag den Prozess gegen die anlasslose Erfassung mit."}
          </h3>
          <p>
            {en ? "Your donation pays for the proceedings." : "Mit deiner Spende bezahlen wir das Verfahren."}
          </p>
          <a class="button primary" href={donateFor(language)}
            >{en ? "Donate" : "Spenden"}</a
          >
        </div>
        <div class="next-item">
          <h3>{en ? "Write to your MPs" : "Schreib deinen Abgeordneten"}</h3>
          <p>
            {en ? "A letter to the National Council, drafted in your browser and sent by you." : "Ein Brief an den Nationalrat, vorbereitet in deinem Browser, von dir abgeschickt."}
          </p>
          <a
            class="button"
            href={`${pathFor("participate", language)}#abgeordnete`}
            >{en ? "Write a letter" : "Brief schreiben"}</a
          >
        </div>
        <div class="next-item" data-share-scope>
          <h3>{en ? "Show others their file" : "Anderen ihre Akte zeigen"}</h3>
          <p>
            {en ? "Share this page. The link contains none of your answers." : "Teile diese Seite. Der Link enthält keine deiner Angaben."}
          </p>
          <button class="button" type="button" data-share>
            <ShareIcon class="share-icon" /><CheckIcon class="share-done" />
            {en ? "Share the page" : "Seite teilen"}
          </button>
          <p class="share-status" data-share-status aria-live="polite"></p>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  /* Der Schluss der Akte: Spenden als nächster Schritt auf einer Fläche,
     Brief und Teilen daneben. */
  .next-grid {
    display: grid;
    gap: var(--space-l) var(--space-xl);
    margin-block-start: var(--space-l);
  }

  .next-lead {
    padding: var(--space-m-l);
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  .next-item {
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--line);
  }

  .next h3 {
    max-inline-size: 26ch;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    font-stretch: 94%;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .next-item h3 {
    font-size: var(--step-1);
    font-weight: 560;
    font-stretch: 100%;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .next p {
    max-inline-size: 40ch;
    margin-block-start: var(--space-xs);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .next .button {
    margin-block-start: var(--space-m);
  }

  .next .share-status:empty {
    display: none;
  }

  @container campaign (width >= 52rem) {
    .next-grid {
      grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
