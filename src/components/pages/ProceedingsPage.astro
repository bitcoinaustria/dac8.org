---
import Artwork from "@/components/Artwork.astro"
import LegalRoute from "@/components/LegalRoute.astro"
import MediaCoverage from "@/components/MediaCoverage.astro"
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import { publishedUpdates } from "@/data/updates"
import { donateFor, feedFor, languageFor, pathFor } from "@/lib/i18n"

// What we do: the complaint, the route it can take, why it can work, and
// what journalists need. Every procedural statement here must match the
// actual status; the courts, not the campaign, decide on referrals and
// timing.
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const entries = publishedUpdates()
const donate = donateFor(language)
const feed = feedFor(language)

const questions = en
  ? [
      {
        title: "May the state demand this?",
        text: "Providers must collect every customer’s data for the tax office, without suspicion. Every report stays on file with them for ten years. Is that compatible with the fundamental right to data protection?",
      },
      {
        title: "Does the tax office need this data?",
        text: "The report usually includes how much you transfer to your own wallet each year, as a total without wallet addresses. On its own, that is no more taxable than withdrawing cash.",
      },
      {
        title: "Could it be done with less?",
        text: "Any interference with fundamental rights must be necessary and proportionate. We want it examined whether milder means would work with less data.",
      },
    ]
  : [
      {
        title: "Darf der Staat das verlangen?",
        text: "Anbieter müssen die Daten aller Kunden für das Finanzamt erfassen, ohne Verdacht. Jede Meldung bleibt zehn Jahre bei ihnen gespeichert. Ist das mit dem Grundrecht auf Datenschutz vereinbar?",
      },
      {
        title: "Braucht das Finanzamt diese Daten?",
        text: "In der Regel wird auch gemeldet, wie viel du im Jahr auf deine eigene Wallet überträgst, als Summe ohne Wallet-Adressen. Steuerpflichtig ist das für sich genommen so wenig wie eine Bargeldbehebung.",
      },
      {
        title: "Ginge es mit weniger?",
        text: "Ein Eingriff in Grundrechte muss erforderlich und verhältnismäßig sein, also nötig und angemessen. Wir lassen prüfen, ob mildere Mittel mit weniger Daten auskommen.",
      },
    ]

// The Constitutional Court's April 2026 decision on the electronic
// vaccination record: a direct application is inadmissible while the route
// through the Data Protection Authority is open, whatever its prospects there.
const routeRuling =
  "https://www.ris.bka.gv.at/Dokumente/Vfgh/JFT_20260428_24G00178_00/JFT_20260428_24G00178_00.pdf"
const lawyerProfile = en
  ? "https://www.cerhahempel.com/lawyers/oliver-voelkel"
  : "https://www.cerhahempel.com/de/juristen/oliver-voelkel"
---

<Layout
  sections={[
    { id: "beschwerde", label: en ? "Complaint" : "Beschwerde" },
    { id: "rechtsweg", label: en ? "Legal route" : "Rechtsweg" },
    { id: "praezedenzfall", label: en ? "Precedent" : "Präzedenzfall" },
    { id: "europa", label: en ? "Europe" : "Europa" },
    { id: "neuigkeiten", label: en ? "Updates" : "Neuigkeiten" },
    { id: "presse", label: en ? "Press" : "Presse" },
  ]}
>
  <MetaPage slot="head" />
  <article class="campaign proceedings">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "We are challenging DAC8." : "Wir lassen DAC8 prüfen."}
          <span
            >{en ? "Our complaint has been filed." : "Unsere Beschwerde ist eingebracht."}</span
          >
        </h1>
        <p class="lead">
          {en ? "We want the courts to settle whether DAC8 is compatible with the fundamental right to data protection. The route starts at the Data Protection Authority and can lead to the Court of Justice of the European Union." : "Wir wollen klären lassen, ob DAC8 mit dem Grundrecht auf Datenschutz vereinbar ist. Der Weg beginnt bei der Datenschutzbehörde und kann bis zum Europäischen Gerichtshof führen."}
        </p>
        <nav
          class="hero-actions"
          aria-label={en ? "Support and follow the case" : "Verfahren unterstützen und verfolgen"}
        >
          <a class="button primary" href={donate}
            >{en ? "Support the case" : "Verfahren unterstützen"}</a
          >
          <a class="button" href={feed}
            >{en ? "Updates via RSS" : "Neuigkeiten per RSS"}</a
          >
        </nav>
        <dl
          class="glance"
          aria-label={en ? "The complaint at a glance" : "Die Beschwerde auf einen Blick"}
        >
          <dt>{en ? "Filed" : "Eingebracht"}</dt>
          <dd>
            {en ? "in October 2026 with the Austrian Data Protection Authority" : "im Oktober 2026 bei der österreichischen Datenschutzbehörde"}
          </dd>
          <dt>{en ? "By" : "Von"}</dt>
          <dd>
            {en ? "Dr. Oliver Völkel, LL.M., attorney in Vienna, as a customer of a crypto provider" : "Dr. Oliver Völkel, LL.M., Rechtsanwalt in Wien, als Kunde eines Krypto-Anbieters"}
          </dd>
          <dt>{en ? "Initiated by" : "Initiative"}</dt>
          <dd>
            {en ? "Bitcoin Austria, the non-profit bitcoin association from Vienna" : "Bitcoin Austria, gemeinnütziger Bitcoin-Verein aus Wien"}
          </dd>
        </dl>
      </div>
      <Artwork
        id="collectionReview"
        language={language}
        size="hero"
        priority
        caption={false}
      />
    </header>

    <section id="beschwerde" aria-labelledby="beschwerde-heading">
      <h2 id="beschwerde-heading">
        {en ? "How much data may the state demand, just in case?" : "Wie viel darf der Staat vorsorglich sammeln lassen?"}
      </h2>
      <p class="section-intro">
        {en ? "The complaint takes one concrete case: the data a provider prepares about one of its customers for DAC8. On that case, we want three questions answered." : "Die Beschwerde nimmt einen konkreten Fall: die Daten, die ein Anbieter für DAC8 über einen seiner Kunden aufbereitet. An ihm lassen wir drei Fragen klären."}
      </p>
      <ol class="facts questions">
        {questions.map((question) => (
          <li>
            <strong>{question.title}</strong>
            <p>{question.text}</p>
          </li>
        ))}
      </ol>
      <a
        class="text-link"
        href={`${pathFor("arguments", language)}#forderungen`}
        >{en ? "What we demand instead" : "Was wir stattdessen fordern"}</a
      >
    </section>

    <section id="rechtsweg" class="band" aria-labelledby="rechtsweg-heading">
      <h2 id="rechtsweg-heading">
        {en ? "What happens next" : "Wie es weitergeht"}
      </h2>
      <p class="section-intro">
        {en ? "In Austria only the Constitutional Court can strike down a law, and only the Court of Justice of the EU can declare an EU directive invalid. That is why the route is long." : "Ein Gesetz aufheben kann in Österreich nur der Verfassungsgerichtshof, eine EU-Richtlinie für ungültig erklären nur der Europäische Gerichtshof. Deshalb ist der Weg so lang."}
      </p>
      <LegalRoute language={language} detailed />
    </section>

    <section id="praezedenzfall" aria-labelledby="praezedenzfall-heading">
      <h2 id="praezedenzfall-heading">
        {en ? "Will it make a difference?" : "Bringt das etwas?"}
        <span
          >{en ? "A surveillance law has fallen before." : "Schon einmal fiel ein Überwachungsgesetz."}</span
        >
      </h2>
      <p class="section-intro">
        {en ? "Whether we win is for the courts to decide. But they have already answered once whether the state may have data on everyone stored just in case." : "Ob wir recht bekommen, entscheiden die Gerichte. Die Frage, ob der Staat Daten über alle auf Vorrat speichern lassen darf, haben sie aber schon einmal beantwortet."}
      </p>
      <div class="precedent">
        <p class="precedent-year" aria-hidden="true">2014</p>
        <p class="prose">
          <strong
            >{en ? "Data retention." : "Die Vorratsdatenspeicherung."}</strong
          >
          {en ? "Phone and internet providers had to store for six months who was in contact with whom and when, for all customers and without suspicion. A challenge organised by AKVorrat, now epicenter.works, took this to the Constitutional Court, which referred the questions to the Court of Justice of the EU (CJEU). In April 2014 the CJEU declared the EU directive invalid, and in June the Constitutional Court struck down the Austrian rules." : "Telefon- und Internetanbieter mussten sechs Monate lang speichern, wer wann mit wem in Verbindung war, von allen Kunden und ohne Verdacht. Ein von AKVorrat, heute epicenter.works, organisierter Antrag brachte das vor den Verfassungsgerichtshof. Der legte die Fragen dem Europäischen Gerichtshof (EuGH) vor. Im April 2014 erklärte der EuGH die EU-Richtlinie für ungültig, im Juni hob der Verfassungsgerichtshof die österreichischen Regeln auf."}
        </p>
      </div>
      <a class="text-link" href={donate}
        >{en ? "Support the case" : "Verfahren unterstützen"}</a
      >
    </section>

    <section id="europa" class="band" aria-labelledby="europa-heading">
      <h2 id="europa-heading">
        {en ? "Elsewhere in Europe" : "Anderswo in Europa"}
      </h2>
      <p class="section-intro">
        {en ? "DAC8 applies across the EU, but each country has its own legal route. The question stays the same: is collecting every customer’s data compatible with fundamental rights?" : "DAC8 gilt in der ganzen EU, aber jedes Land hat seinen eigenen Rechtsweg. Die Frage bleibt dieselbe: Ist die Erfassung aller Kunden mit den Grundrechten vereinbar?"}
      </p>
      <div class="cards">
        <article>
          <h3>{en ? "France: Bull Bitcoin" : "Frankreich: Bull Bitcoin"}</h3>
          <p>
            {en ? "In February 2026 Bull Bitcoin asked the Conseil d’État to annul the decree that implements DAC8 in France. On 14 September 2026 the court " : "Im Februar 2026 hat Bull Bitcoin beim Conseil d’État beantragt, das Dekret aufzuheben, mit dem Frankreich DAC8 umsetzt. Am 14. September 2026 hat das Gericht "}<a
              href="https://www.conseil-etat.fr/fr/arianeweb/CE/decision/2026-09-14/519158"
              hreflang="fr"
              >{en ? "refused to suspend it as an emergency measure" : "abgelehnt, es im Eilverfahren auszusetzen"}</a
            >{en ? ". The action for annulment is still pending." : ". Über die Aufhebung ist noch nicht entschieden."}
          </p>
          <p>
            {en ? "Bull Bitcoin’s campaign at dac8.com inspired ours." : "Bull Bitcoins Kampagne auf dac8.com hat unsere angestoßen."}
          </p>
          <a
            class="text-link"
            href={en ? "https://dac8.com/en/resources/legal-action-conseil-etat/" : "https://dac8.com/de/resources/legal-action-conseil-etat/"}
            >{en ? "The French challenge on dac8.com" : "Die französische Klage auf dac8.com"}</a
          >
        </article>
        <article>
          <h3>{en ? "And in your country?" : "Und in deinem Land?"}</h3>
          <p>
            {en ? "The campaign concerns everyone covered by DAC8, whatever crypto-assets they use. It starts in Austria. If you want to challenge the law in your country, get in touch." : "Die Kampagne gilt allen, die DAC8 erfasst, egal welche Kryptowerte sie nutzen. Sie beginnt in Österreich. Wer das Gesetz im eigenen Land angehen will, meldet sich bei uns."}
          </p>
          <a
            class="button primary"
            href={en ? "mailto:kontakt@dac8.org?subject=Working%20together%20on%20DAC8" : "mailto:kontakt@dac8.org?subject=Zusammenarbeit%20zu%20DAC8"}
            >kontakt@dac8.org</a
          >
        </article>
      </div>
    </section>

    <section id="neuigkeiten" aria-labelledby="neuigkeiten-heading">
      <h2 id="neuigkeiten-heading">{en ? "Updates" : "Neuigkeiten"}</h2>
      <p class="section-intro">
        {en ? "We post every new step in the case here and in the RSS feed as soon as it is public." : "Jeden neuen Schritt im Verfahren melden wir hier und im RSS-Feed, sobald er öffentlich ist."}
      </p>
      {entries.length === 0 && <p class="empty-state">
        <strong>{en ? "No updates published yet." : "Noch keine Meldungen veröffentlicht."}</strong>
      </p>}
      {entries.map(entry => <article id={entry.id} class="campaign-update">
        <time datetime={entry.publishedAt}>{new Intl.DateTimeFormat(en ? "en-GB" : "de-AT", { dateStyle: "long", timeZone: "Europe/Vienna" }).format(new Date(entry.publishedAt))}</time>
        <h3>{entry.translations[language].title}</h3>
        <p class="prose">{entry.translations[language].text}</p>
        {entry.source && <a class="text-link" href={entry.source}>{en ? "Read the document" : "Zum Dokument"}</a>}
      </article>)}
      <a class="text-link" href={feed}
        >{en ? "Subscribe via RSS" : "RSS-Feed abonnieren"}</a
      >
    </section>

    <section id="presse" class="band press" aria-labelledby="presse-heading">
      <div class="press-contact">
        <h2 id="presse-heading">{en ? "For the media" : "Für Medien"}</h2>
        <p class="section-intro">
          {en ? "Available for questions and interviews:" : "Für Rückfragen und Interviews stehen bereit:"}
        </p>
        <ul class="contacts">
          <li>
            <strong>Tobias Girstmair</strong>
            {en ? "Secretary General, Bitcoin Austria" : "Generalsekretär, Bitcoin Austria"}
          </li>
          <li>
            <strong
              ><a href={lawyerProfile}>Dr. Oliver Völkel, LL.M.</a></strong
            >
            {en ? "Attorney and partner, CERHA HEMPEL, Vienna. Filed the complaint." : "Rechtsanwalt und Partner, CERHA HEMPEL, Wien. Hat die Beschwerde eingebracht."}
          </li>
        </ul>
        <a
          class="button"
          href={en ? "mailto:kontakt@dac8.org?subject=Press%20enquiry%20DAC8" : "mailto:kontakt@dac8.org?subject=Presseanfrage%20DAC8"}
          >kontakt@dac8.org</a
        >
      </div>
      <div class="faq-list">
        <details name="press-faq">
          <summary>
            {en ? "Who is the complaint against?" : "Gegen wen richtet sich die Beschwerde?"}
          </summary>
          <p>
            {en ? "Formally, against the way Oliver Völkel’s provider processes his data for DAC8. In substance it is about the law: the obligations that DAC8 and Austria’s Crypto-Asset Reporting Obligations Act place on every reporting provider." : "Formal gegen die Art, wie der Anbieter von Oliver Völkel dessen Daten für DAC8 verarbeitet. In der Sache geht es um das Gesetz: um die Pflichten, die DAC8 und das österreichische Krypto-Meldepflichtgesetz jedem meldepflichtigen Anbieter auferlegen."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Why go through the Data Protection Authority?" : "Warum führt der Weg über die Datenschutzbehörde?"}
          </summary>
          <p>
            {en ? "A law can only be challenged directly before the Constitutional Court if no other reasonable route is available. Anyone objecting to the processing of their data has such a route: a complaint to the Data Protection Authority, then the Federal Administrative Court, then the Constitutional Court. How the complaint fares at the authority does not matter for this, as the Constitutional Court held " : "Direkt beim Verfassungsgerichtshof kann man ein Gesetz nur anfechten, wenn kein anderer zumutbarer Weg offensteht. Wer sich gegen die Verarbeitung seiner Daten wehrt, hat einen solchen Weg: die Beschwerde bei der Datenschutzbehörde, danach das Bundesverwaltungsgericht und dann der Verfassungsgerichtshof. Wie die Beschwerde bei der Behörde ausgeht, spielt dafür keine Rolle. Das hat der Verfassungsgerichtshof "}<a
              href={routeRuling}
              hreflang="de"
              >{en ? "in April 2026" : "im April 2026"}</a
            >{en ? " in a case about the electronic vaccination record." : " in einem Fall zum elektronischen Impfpass festgehalten."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Does DAC8 apply while the case is pending?" : "Gilt DAC8 während des Verfahrens?"}
          </summary>
          <p>
            {en ? "Yes. Providers have been collecting the data since 1 January 2026 and report the year 2026 to the tax office by 31 July 2027. The complaint does not stop that." : "Ja. Anbieter erfassen die Daten seit 1. Jänner 2026 und melden das Jahr 2026 bis 31. Juli 2027 ans Finanzamt. Die Beschwerde hält das nicht auf."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "How long will the case take?" : "Wie lange dauert das Verfahren?"}
          </summary>
          <p>
            {en ? "We do not know. The Data Protection Authority and the courts set the pace. We publish every new step on this page and in the RSS feed." : "Das wissen wir nicht. Den Zeitplan bestimmen die Datenschutzbehörde und die Gerichte. Jeden neuen Schritt veröffentlichen wir auf dieser Seite und im RSS-Feed."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Who pays for the case?" : "Wer bezahlt das Verfahren?"}
          </summary>
          <p>
            {en ? "Bitcoin Austria, with " : "Bitcoin Austria, mit "}
            <a href={donate}>{en ? "donations" : "Spenden"}</a>
            {en ? " in bitcoin or by bank transfer." : " in Bitcoin oder per Überweisung."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Can others join the case?" : "Können sich andere anschließen?"}
          </summary>
          <p>
            {en ? "We are still working out how individuals can take part. Once that is settled, we will publish it here." : "Die Möglichkeiten für Privatpersonen klären wir noch. Sobald sie feststehen, veröffentlichen wir sie hier."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Who is behind dac8.org?" : "Wer steht hinter dac8.org?"}
          </summary>
          <p>
            {en ? "Bitcoin Austria, a non-profit, volunteer-run association based in Vienna and founded in 2011. dac8.org is its campaign against the blanket collection of financial data." : "Bitcoin Austria, ein gemeinnütziger, ehrenamtlich getragener Verein mit Sitz in Wien, gegründet 2011. dac8.org ist seine Kampagne gegen die anlasslose Erfassung von Finanzdaten."}
          </p>
        </details>
      </div>
    </section>

    <MediaCoverage language={language} />
  </article>
</Layout>

<style>
  /* Drei Prüffragen nebeneinander, jede unter einer Haarlinie. Wer nur die
     fetten Fragen liest, weiß, worum es geht. */
  .questions > li {
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--line);
  }

  @container campaign (width >= 56rem) {
    .campaign .questions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Die Präzedenzfall-Aussage beginnt mit einem fetten Einstieg. */
  .precedent .prose strong {
    display: block;
    margin-block-end: var(--space-3xs);
    font-size: var(--type-lead);
    font-weight: var(--weight-heading);
    line-height: 1.3;
  }

  .cards .text-link {
    margin-block-start: var(--space-m);
  }

  /* Für Medien: links die Ansprechpartner, rechts die häufigen Fragen. */
  .press {
    display: grid;
    align-items: start;
    gap: var(--space-xl) var(--space-2xl);
  }

  .press .faq-list {
    max-inline-size: none;
    margin-block-start: 0;
  }

  .contacts {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  .contacts strong {
    display: block;
    color: var(--ink);
    font-weight: var(--weight-strong);
  }

  .contacts a {
    color: inherit;
  }

  .press-contact .button {
    margin-block-start: var(--space-l);
  }

  @container campaign (width >= 60rem) {
    .press {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  h2 + .campaign-update,
  .section-intro + .campaign-update {
    margin-block-start: var(--space-l);
  }

  .campaign-update + .campaign-update {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }

  time {
    display: block;
    margin-block-end: var(--space-xs);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }
</style>
