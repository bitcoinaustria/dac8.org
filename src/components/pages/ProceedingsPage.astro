---
import EuropeanFront from "@/components/EuropeanFront.astro"
import LegalRoute from "@/components/LegalRoute.astro"
import MediaCoverage from "@/components/MediaCoverage.astro"
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import { publishedUpdates } from "@/data/updates"
import { donateFor, feedFor, languageFor, pathFor } from "@/lib/i18n"

// What we do: the conviction and one way to help first, then where the case
// stands, the questions it asks, why it can work, the cases elsewhere in
// Europe and what journalists need. Each section says its point in a line
// or two; the press questions keep the detail behind a click. The updates
// get a section only once there are any; until then the status line
// points to the feed.
// Every procedural statement here must match the actual status; the courts,
// not the campaign, decide on referrals and timing.
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const entries = publishedUpdates()
const latest = entries[0]
const donate = donateFor(language)
const feed = feedFor(language)
const formatDate = new Intl.DateTimeFormat(en ? "en-GB" : "de-AT", {
  dateStyle: "long",
  timeZone: "Europe/Vienna",
})

const questions = en
  ? [
      {
        title: "May the state demand this?",
        text: "Every customer recorded for the tax office, without suspicion, each report kept for ten years: is that compatible with the right to data protection?",
      },
      {
        title: "Does the tax office need this data?",
        text: "It even includes what you move to your own wallet each year, as a total without wallet addresses. That is no more taxable than withdrawing cash.",
      },
      {
        title: "Could it be done with less?",
        text: "Yes: Germany and the Netherlands compile data only for customers who are actually reported, and Ireland keeps it six years instead of ten.",
      },
    ]
  : [
      {
        title: "Darf der Staat das verlangen?",
        text: "Alle Kunden für das Finanzamt erfasst, ohne Verdacht, jede Meldung zehn Jahre aufbewahrt: Ist das mit dem Grundrecht auf Datenschutz vereinbar?",
      },
      {
        title: "Braucht das Finanzamt diese Daten?",
        text: "Gemeldet wird sogar, wie viel du im Jahr auf deine eigene Wallet überträgst, als Summe ohne Wallet-Adressen. Steuerpflichtig ist das so wenig wie eine Bargeldbehebung.",
      },
      {
        title: "Ginge es mit weniger?",
        text: "Ja: Deutschland und die Niederlande lassen Daten nur für Kunden zusammenstellen, die wirklich gemeldet werden, und Irland bewahrt sie sechs statt zehn Jahre auf.",
      },
    ]

// The two 2014 rulings on data retention, as listed under courts in
// src/data/sources.ts: the CJEU judgment of 8 April and the Constitutional
// Court's decision of 27 June.
const retentionCjeu = en
  ? "https://eur-lex.europa.eu/legal-content/EN/ALL/?uri=CELEX:62012CJ0293"
  : "https://eur-lex.europa.eu/legal-content/DE/ALL/?uri=CELEX:62012CJ0293"
const retentionVfgh =
  "https://www.ris.bka.gv.at/Dokumente/Vfgh/JFT_20140627_12G00047_00/JFT_20140627_12G00047_00.pdf"
// The Constitutional Court's April 2026 decision on the electronic
// vaccination record: a direct application is inadmissible while the route
// through the Data Protection Authority is open, whatever its prospects there.
const routeRuling =
  "https://www.ris.bka.gv.at/Dokumente/Vfgh/JFT_20260428_24G00178_00/JFT_20260428_24G00178_00.pdf"
const lawyerProfile = en
  ? "https://www.cerhahempel.com/lawyers/oliver-voelkel"
  : "https://www.cerhahempel.com/de/juristen/oliver-voelkel"
---

<Layout
  sections={[
    { id: "rechtsweg", label: en ? "Status" : "Stand" },
    { id: "beschwerde", label: en ? "Complaint" : "Beschwerde" },
    { id: "europa", label: en ? "Europe" : "Europa" },
    ...(entries.length
      ? [{ id: "neuigkeiten", label: en ? "Updates" : "Neuigkeiten" }]
      : []),
    { id: "presse", label: en ? "Press" : "Presse" },
    { id: "medien", label: en ? "In the media" : "Medien" },
  ]}
>
  <MetaPage slot="head" />
  <article class="campaign proceedings">
    <header class="hero proceedings-hero">
      <div class="hero-text">
        <h1>
          {en ? "We are taking DAC8 to court." : "Wir bringen DAC8 vor Gericht."}
          <span
            >{en ? "Our complaint has been filed." : "Unsere Beschwerde ist eingebracht."}</span
          >
        </h1>
        <p class="lead">
          {en ? "We are convinced that collecting data on every crypto customer without suspicion violates the fundamental right to data protection." : "Wir sind überzeugt, dass die Erfassung aller Krypto-Kunden ohne Verdacht gegen das Grundrecht auf Datenschutz verstößt."}
        </p>
        <div class="hero-actions">
          <a class="button primary" href={donate}
            >{en ? "Support the case" : "Verfahren unterstützen"}</a
          >
        </div>
      </div>
      <div id="rechtsweg" class="case-status">
        <p class="case-status-filed">
          {en ? "Filed in October 2026 by attorney Dr Oliver Völkel (CERHA HEMPEL), at Bitcoin Austria’s initiative." : "Eingebracht im Oktober 2026 von Rechtsanwalt Dr. Oliver Völkel (CERHA HEMPEL), auf Initiative von Bitcoin Austria."}
        </p>
        <LegalRoute language={language} />
        {latest ? (
          <p class="case-status-latest">
            <span>
              {en ? "Latest, " : "Zuletzt, "}
              <time datetime={latest.publishedAt}
                >{formatDate.format(new Date(latest.publishedAt))}</time
              >
            </span>
            <a class="text-link" href={`#${latest.id}`}
              >{latest.translations[language].title}</a
            >
          </p>
        ) : (
          <p class="case-status-latest">
            <span>
              {en ? "We post every new step in the feed." : "Jeden neuen Schritt melden wir im Feed."}
            </span>
            <a class="text-link" href={feed}
              >{en ? "Subscribe via RSS" : "RSS-Feed abonnieren"}</a
            >
          </p>
        )}
      </div>
    </header>

    <section
      id="beschwerde"
      class="band complaint"
      aria-labelledby="beschwerde-heading"
    >
      <h2 id="beschwerde-heading">
        {en ? "How much data may the state demand, just in case?" : "Wie viel darf der Staat vorsorglich sammeln lassen?"}
      </h2>
      <div class="complaint-questions">
        <ol>
          {questions.map((question) => (
            <li>
              <strong>{question.title}</strong>
              <p>{question.text}</p>
            </li>
          ))}
        </ol>
        <a
          class="text-link"
          href={`${pathFor("arguments", language)}#forderungen`}
          >{en ? "What we demand instead" : "Was wir stattdessen fordern"}</a
        >
      </div>
      <aside
        id="praezedenzfall"
        class="precedent-card"
        aria-labelledby="praezedenzfall-heading"
      >
        <p class="precedent-kicker">
          {en ? "Will it make a difference?" : "Bringt das etwas?"}
        </p>
        <h3 id="praezedenzfall-heading">
          {en ? "A surveillance law has fallen before." : "Schon einmal fiel ein Überwachungsgesetz."}
        </h3>
        <p>
          {en ? "Data retention: who was in contact with whom and when, stored for six months, for every phone and internet customer, without suspicion." : "Die Vorratsdatenspeicherung: wer wann mit wem in Verbindung war, sechs Monate gespeichert, von allen Telefon- und Internetkunden, ohne Verdacht."}
        </p>
        <ol class="precedent-rulings">
          <li>
            <a href={retentionCjeu} hreflang={language}>April 2014</a>
            <span
              >{en ? "The CJEU declares the EU directive invalid." : "Der EuGH erklärt die EU-Richtlinie für ungültig."}</span
            >
          </li>
          <li>
            <a href={retentionVfgh} hreflang="de"
              >{en ? "June 2014" : "Juni 2014"}</a
            >
            <span
              >{en ? "The Constitutional Court strikes down the Austrian rules." : "Der Verfassungsgerichtshof hebt die österreichischen Regeln auf."}</span
            >
          </li>
        </ol>
        <p class="precedent-credit">
          {en ? "Brought by AKVorrat, now epicenter.works." : "Angestoßen von AKVorrat, heute epicenter.works."}
        </p>
      </aside>
    </section>

    <EuropeanFront language={language} />

    {entries.length > 0 && (
    <section
      id="neuigkeiten"
      class="band news"
      aria-labelledby="neuigkeiten-heading"
    >
      <div class="news-text">
        <h2 id="neuigkeiten-heading">{en ? "Updates" : "Neuigkeiten"}</h2>
        <p class="section-intro">
          {en ? "We post every new step in the case here and in the RSS feed as soon as it is public." : "Jeden neuen Schritt im Verfahren melden wir hier und im RSS-Feed, sobald er öffentlich ist."}
        </p>
        <a class="text-link" href={feed}
          >{en ? "Subscribe via RSS" : "RSS-Feed abonnieren"}</a
        >
      </div>
      <div class="news-list">
        {entries.map(entry => <article id={entry.id} class="campaign-update">
          <time datetime={entry.publishedAt}>{formatDate.format(new Date(entry.publishedAt))}</time>
          <h3>{entry.translations[language].title}</h3>
          <p class="prose">{entry.translations[language].text}</p>
          {entry.source && <a class="text-link" href={entry.source}>{en ? "Read the document" : "Zum Dokument"}</a>}
        </article>)}
      </div>
    </section>
    )}

    <section id="presse" class="press" aria-labelledby="presse-heading">
      <div class="press-contact">
        <h2 id="presse-heading">{en ? "For the media" : "Für Medien"}</h2>
        <p class="section-intro">
          {en ? "The association and the attorney are available for questions and interviews." : "Für Rückfragen und Interviews stehen der Verein und der Anwalt zur Verfügung."}
        </p>
        <ul class="contacts">
          <li>
            <p class="contact-role">
              {en ? "Campaign and case" : "Kampagne und Verfahren"}
            </p>
            <strong>Bitcoin Austria</strong>
            <p>
              {en ? "The non-profit association behind dac8.org." : "Der gemeinnützige Verein hinter dac8.org."}
            </p>
            <a
              class="button"
              href={en ? "mailto:kontakt@dac8.org?subject=Press%20enquiry%20DAC8" : "mailto:kontakt@dac8.org?subject=Presseanfrage%20DAC8"}
              >kontakt@dac8.org</a
            >
          </li>
          <li>
            <p class="contact-role">
              {en ? "Legal questions" : "Rechtliche Fragen"}
            </p>
            <strong
              >{en ? "Dr Oliver Völkel, LL.M." : "Dr. Oliver Völkel, LL.M."}</strong
            >
            <p>
              {en ? "Attorney and partner at CERHA HEMPEL in Vienna. He filed the complaint." : "Rechtsanwalt und Partner bei CERHA HEMPEL in Wien. Er hat die Beschwerde eingebracht."}
            </p>
            <a class="text-link" href={lawyerProfile}
              >{en ? "Profile at CERHA HEMPEL" : "Profil bei CERHA HEMPEL"}</a
            >
          </li>
        </ul>
      </div>
      <div class="faq-list">
        <details name="press-faq">
          <summary>
            {en ? "Who is the complaint against?" : "Gegen wen richtet sich die Beschwerde?"}
          </summary>
          <p>
            {en ? "Formally, against the way Oliver Völkel’s provider processes his data for DAC8. In substance it is about the law: the obligations that DAC8 and Austria’s Crypto-Asset Reporting Obligations Act place on every reporting provider." : "Formal gegen die Art, wie der Anbieter von Oliver Völkel dessen Daten für DAC8 verarbeitet. In der Sache geht es um das Gesetz: um die Pflichten, die DAC8 und das österreichische Krypto-Meldepflichtgesetz jedem meldepflichtigen Anbieter auferlegen."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Why go through the Data Protection Authority?" : "Warum führt der Weg über die Datenschutzbehörde?"}
          </summary>
          <p>
            {en ? "A law can only be challenged directly before the Constitutional Court if no other reasonable route is available. Anyone objecting to the processing of their data has such a route: a complaint to the Data Protection Authority, then the Federal Administrative Court, then the Constitutional Court. How the complaint fares at the authority does not matter for this, as the Constitutional Court held " : "Direkt beim Verfassungsgerichtshof kann man ein Gesetz nur anfechten, wenn kein anderer zumutbarer Weg offensteht. Wer sich gegen die Verarbeitung seiner Daten wehrt, hat einen solchen Weg: die Beschwerde bei der Datenschutzbehörde, danach das Bundesverwaltungsgericht und dann der Verfassungsgerichtshof. Wie die Beschwerde bei der Behörde ausgeht, spielt dafür keine Rolle. Das hat der Verfassungsgerichtshof "}<a
              href={routeRuling}
              hreflang="de"
              >{en ? "in April 2026" : "im April 2026"}</a
            >{en ? " in a case about the electronic vaccination record." : " in einem Fall zum elektronischen Impfpass festgehalten."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Does DAC8 apply while the case is pending?" : "Gilt DAC8 während des Verfahrens?"}
          </summary>
          <p>
            {en ? "Yes. Providers have been collecting the data since 1 January 2026 and report the year 2026 to the tax office by 31 July 2027. The complaint does not stop that." : "Ja. Anbieter erfassen die Daten seit 1. Jänner 2026 und melden das Jahr 2026 bis 31. Juli 2027 ans Finanzamt. Die Beschwerde hält das nicht auf."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "How long will the case take?" : "Wie lange dauert das Verfahren?"}
          </summary>
          <p>
            {en ? "We do not know. The Data Protection Authority and the courts set the pace." : "Das wissen wir nicht. Den Zeitplan bestimmen die Datenschutzbehörde und die Gerichte."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Who pays for the case?" : "Wer bezahlt das Verfahren?"}
          </summary>
          <p>
            {en ? "Bitcoin Austria, with " : "Bitcoin Austria, mit "}
            <a href={donate}>{en ? "donations" : "Spenden"}</a>
            {en ? " in bitcoin or by bank transfer." : " in Bitcoin oder per Überweisung."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Can others join the case?" : "Können sich andere anschließen?"}
          </summary>
          <p>
            {en ? "We are still working out how individuals can take part. Once that is settled, we will publish it here." : "Die Möglichkeiten für Privatpersonen klären wir noch. Sobald sie feststehen, veröffentlichen wir sie hier."}
          </p>
        </details>
        <details name="press-faq">
          <summary>
            {en ? "Who is behind dac8.org?" : "Wer steht hinter dac8.org?"}
          </summary>
          <p>
            {en ? "Bitcoin Austria, a non-profit, independent Bitcoin association based in Vienna, active since 2011. dac8.org is its campaign against the blanket collection of financial data." : "Bitcoin Austria, ein gemeinnütziger, unabhängiger Bitcoin-Verein aus Wien, seit 2011. dac8.org ist seine Kampagne gegen die anlasslose Erfassung von Finanzdaten."}
          </p>
        </details>
      </div>
    </section>

    <MediaCoverage language={language} band />
  </article>
</Layout>

<style>
  /* Kopf: Überzeugung und Spendenknopf, darunter statt eines Bildes der
     Stand selbst: wer wann eingebracht hat, der Rechtsweg mit dem Punkt,
     an dem wir stehen, und wo es Neues gibt. */
  .proceedings-hero {
    align-items: start;
  }

  .case-status {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l) var(--space-l-xl);
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  .case-status-filed {
    color: var(--ink-2);
  }

  .case-status :global(.route) {
    margin-block-start: 0;
    padding-block-start: var(--space-s);
  }

  /* Die jüngste Meldung oder der Feed als leise Zeile unter dem Weg. */
  .case-status-latest {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .case-status-latest .text-link {
    margin-block-start: 0;
    font-size: var(--type-body);
  }

  /* Beschwerde: links die drei Fragen untereinander, groß gesetzt, jede mit
     einer Zeile Antwort; rechts als Karte, dass so etwas schon einmal
     gefallen ist. */
  :global(.campaign) > section.complaint {
    display: grid;
    grid-template-areas: "heading" "questions" "precedent";
    gap: var(--space-xl) var(--space-2xl);
  }

  .complaint > h2 {
    grid-area: heading;
    max-inline-size: 22ch;
  }

  .complaint-questions {
    grid-area: questions;
  }

  .complaint-questions ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .complaint-questions li {
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--line);
  }

  .complaint-questions li:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .complaint-questions strong {
    display: block;
    margin-block-end: var(--space-2xs);
    font-size: var(--type-h3);
    font-weight: var(--weight-heading);
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  .complaint-questions p {
    max-inline-size: var(--measure-text);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .precedent-card {
    grid-area: precedent;
    align-self: start;
    padding: var(--space-l) var(--space-l-xl);
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  .precedent-kicker {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .precedent-card h3 {
    margin-block-end: var(--space-xs);
  }

  .precedent-card p:not(.precedent-kicker) {
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .precedent-rulings {
    display: grid;
    gap: var(--space-2xs);
    margin-block: var(--space-s);
    padding: 0;
    list-style: none;
  }

  /* Datum neben dem Urteil, schmal darüber, damit lange Wörter wie
     Verfassungsgerichtshof nicht zerbrechen. */
  .precedent-rulings li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-s);
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--line);
  }

  .precedent-rulings a {
    flex: 0 0 6.5rem;
    font-weight: 600;
  }

  .precedent-rulings span {
    flex: 1 1 15rem;
  }

  .precedent-card .precedent-credit {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  @container campaign (width >= 56rem) {
    :global(.campaign) > section.complaint {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: "heading heading" "questions precedent";
    }
  }

  /* Neuigkeiten: links was hier erscheint und wie man folgt, rechts die
     Meldungen selbst. */
  .news {
    display: grid;
    align-items: start;
    gap: var(--space-l) var(--space-2xl);
  }

  .news-list > :first-child {
    margin-block-start: 0;
  }

  @container campaign (width >= 56rem) {
    .news {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .news-list {
      padding-block-start: var(--space-2xs);
    }
  }

  /* Für Medien: links die Ansprechpartner, rechts die häufigen Fragen. */
  .press {
    display: grid;
    align-items: start;
    gap: var(--space-xl) var(--space-2xl);
  }

  .press .faq-list {
    max-inline-size: none;
    margin-block-start: 0;
  }

  /* Zwei Ansprechpartner als Karten: wofür, wer, wie erreichbar. */
  .contacts {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .contacts li {
    display: grid;
    justify-items: start;
    gap: var(--space-3xs);
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .contact-role {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .contacts strong {
    font-size: var(--type-lead);
    font-weight: var(--weight-heading);
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .contacts p:not(.contact-role) {
    color: var(--ink-2);
  }

  .contacts :is(.button, .text-link) {
    margin-block-start: var(--space-s);
  }

  @container campaign (width >= 60rem) {
    .press {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .campaign-update + .campaign-update {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }

  time {
    display: block;
    margin-block-end: var(--space-xs);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .case-status-latest time {
    display: inline;
    margin: 0;
  }
</style>
