---
import Artwork from "@/components/Artwork.astro"
import LegalRoute from "@/components/LegalRoute.astro"
import MediaCoverage from "@/components/MediaCoverage.astro"
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import { campaignStatus } from "@/data/campaign"
import { publishedUpdates } from "@/data/updates"
import { campaign, feedFor, languageFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const status = campaignStatus[language]
const entries = publishedUpdates()
---

<Layout>
  <MetaPage slot="head" />
  <article class="campaign">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "Follow " : "Verfolge "}
          <span>{en ? "the case." : "das Verfahren."}</span>
        </h1>
        <p class="lead">
          {en ? "Filings, decisions and next steps. Via RSS, no registration required." : "Einreichungen, Entscheidungen und nächste Schritte. Per RSS, ohne Anmeldung."}
        </p>
        <nav
          class="hero-actions"
          aria-label={en ? "Stay informed" : "Auf dem Laufenden bleiben"}
        >
          <a class="button primary" href={feedFor(language)}
            >{en ? "Open RSS feed" : "RSS-Feed öffnen"}</a
          >
        </nav>
        <p class="hero-note">
          {en ? "Association news: " : "Vereinsneuigkeiten: "}
          <a href={campaign.newsletter}
            >{en ? "Bitcoin Austria newsletter" : "Bitcoin-Austria-Newsletter"}</a
          >{en ? " (in German)." : "."}
        </p>
      </div>
      <Artwork id="collectionReview" language={language} size="hero" />
    </header>
    <section aria-labelledby="status-heading">
      <h2 id="status-heading">{status.label}</h2>
      <p class="section-intro">{status.text}</p>
      <LegalRoute language={language} />
      <p class="prose">
        {en ? "The Data Protection Authority is bound by the law, so we expect it to dismiss the complaint. It can, however, investigate whether our concerns are justified. Against its decision we go to the Federal Administrative Court and then to the Constitutional Court, which can refer the EU directive to the CJEU. Whether the case reaches the CJEU is for the court to decide. We do not yet know how long it will take." : "Die Datenschutzbehörde ist an die Gesetze gebunden. Wir rechnen deshalb damit, dass sie die Beschwerde abweist. Sie kann aber ermitteln, ob unsere Befürchtungen begründet sind. Gegen ihre Entscheidung gehen wir zum Bundesverwaltungsgericht und dann zum Verfassungsgerichtshof, der die EU-Richtlinie dem EuGH vorlegen kann. Ob der Fall zum EuGH kommt, entscheidet das Gericht. Wie lange das dauert, wissen wir noch nicht."}
      </p>
    </section>
    <section aria-labelledby="europe-heading">
      <h2 id="europe-heading">
        {en ? "Elsewhere in Europe" : "Anderswo in Europa"}
      </h2>
      <div class="columns">
        <p class="section-intro">
          <strong
            >{en ? "In France, Bull Bitcoin led the way." : "In Frankreich ist Bull Bitcoin vorangegangen."}</strong
          >
          {en ? "In February 2026 it asked the Conseil d’État to annul the decree that implements DAC8 in France." : "Im Februar 2026 hat das Unternehmen beim Conseil d’État beantragt, das Dekret aufzuheben, mit dem Frankreich DAC8 umsetzt."}
        </p>
        <p class="prose">
          {en ? "On 14 September 2026 the court refused to suspend the decree as an emergency measure. The action for annulment is still pending. Each country has its own procedure: Bull Bitcoin challenges the French decree directly, we go through the Austrian Data Protection Authority. Both cases ask whether collecting every customer’s data is compatible with fundamental rights." : "Am 14. September 2026 hat das Gericht abgelehnt, das Dekret im Eilverfahren auszusetzen. Über die Aufhebung ist noch nicht entschieden. Jedes Land hat sein eigenes Verfahren: Bull Bitcoin greift das französische Dekret direkt an, wir gehen über die österreichische Datenschutzbehörde. Beide Verfahren fragen, ob die Erfassung aller Kunden mit den Grundrechten vereinbar ist."}
        </p>
      </div>
      <div class="link-row">
        <a
          class="text-link"
          href={en ? "https://dac8.com/en/resources/legal-action-conseil-etat/" : "https://dac8.com/de/resources/legal-action-conseil-etat/"}
          >{en ? "The French challenge on dac8.com" : "Die französische Klage auf dac8.com"}</a
        >
        <a
          class="text-link"
          href="https://www.conseil-etat.fr/fr/arianeweb/CE/decision/2026-09-14/519158"
          hreflang="fr"
          >{en ? "Conseil d’État ruling of 14 September 2026 (French)" : "Beschluss des Conseil d’État vom 14. September 2026 (französisch)"}</a
        >
      </div>
    </section>
    <section aria-labelledby="updates-heading">
      <h2 id="updates-heading">{en ? "Updates" : "Neuigkeiten"}</h2>
      {entries.length === 0 && <p class="empty-state">
        <strong>{en ? "No updates published yet." : "Noch keine Meldungen veröffentlicht."}</strong>
        {en ? "Filings, decisions and next steps will appear here and in the RSS feed as soon as they are public." : "Einreichungen, Entscheidungen und nächste Schritte erscheinen hier und im RSS-Feed, sobald sie öffentlich sind."}
      </p>}
      {entries.map(entry => <article id={entry.id} class="campaign-update">
        <time datetime={entry.publishedAt}>{new Intl.DateTimeFormat(en ? "en-GB" : "de-AT", { dateStyle: "long", timeZone: "Europe/Vienna" }).format(new Date(entry.publishedAt))}</time>
        <h3>{entry.translations[language].title}</h3>
        <p class="prose">{entry.translations[language].text}</p>
        {entry.source && <a class="text-link" href={entry.source}>{en ? "Read the document" : "Zum Dokument"}</a>}
      </article>)}
    </section>
    <MediaCoverage language={language} />
  </article>
</Layout>
<style>
  h2 + .campaign-update {
    margin-block-start: var(--space-l);
  }
  .campaign-update + .campaign-update {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }
  time {
    display: block;
    margin-block-end: var(--space-xs);
    color: var(--muted-foreground);
  }
</style>
