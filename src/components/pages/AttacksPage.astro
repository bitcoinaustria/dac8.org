---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import {
  attacks,
  countIn,
  formatDate,
  headlineOf,
  hostOf,
  latestDate,
  latestYear,
  placeOf,
} from "@/lib/attacks"
import { languageFor, pathFor } from "@/lib/i18n"

const language = languageFor(Astro.url.pathname)
const en = language === "en"

const firstYear = Math.min(...attacks.map((attack) => attack.year))
const years = Array.from(
  { length: latestYear - firstYear + 1 },
  (_, index) => firstYear + index,
)
const peak = Math.max(...years.map((year) => countIn(year)))
const through = latestDate ? formatDate(latestDate, language) : ""
const newestFirst = [...attacks].sort((a, b) =>
  (b.date ?? `${b.year}`).localeCompare(a.date ?? `${a.year}`),
)

// The archive follows Jameson Lopp's list as written and keeps every case,
// whatever made the victim known; the cases where a leak made the attack
// possible are in the dossier (#angriffe). The intro explains the risk through
// bitcoin as a bearer asset and argues for keeping holdings private. It must
// not read as a warning against owning bitcoin.

// Texts the map script needs; everything else is rendered here.
const strings = en
  ? {
      newest: "newest first",
      more: "More cases in this view: zoom in or choose a shorter period.",
      none: "No known cases in this view. The archive is incomplete.",
      report: "Report",
      archive: "Archive copy",
    }
  : {
      newest: "die neuesten zuerst",
      more: "Weitere Fälle in diesem Ausschnitt: Zoome hinein oder wähle einen kürzeren Zeitraum.",
      none: "Keine bekannten Fälle in diesem Ausschnitt. Das Archiv ist unvollständig.",
      report: "Bericht",
      archive: "Archivkopie",
    }
---

<Layout fullBleed>
  <MetaPage slot="head" />
  <div
    class="atlas"
    data-atlas
    data-language={language}
    data-strings={JSON.stringify(strings)}
  >
    <header class="atlas-intro">
      <h1>
        {en
            ? "Attacks on crypto holders, documented worldwide."
            : "Angriffe auf Krypto-Besitzer, weltweit dokumentiert."}
      </h1>
      <p class="atlas-lead">
        {en
            ? "An archive of known physical attacks on people who hold crypto-assets, or are believed to. Bitcoin works like cash: whoever holds the keys can move it. That draws criminals, hackers far away as well as attackers in person. So nobody should know who holds how much."
            : "Ein Archiv bekannter körperlicher Angriffe auf Menschen, die Kryptowerte besitzen oder besitzen sollen. Bitcoin funktioniert wie Bargeld: Wer die Schlüssel hat, kann ihn übertragen. Das zieht Kriminelle an, Hacker aus der Ferne ebenso wie Täter vor Ort. Darum sollte niemand wissen, wer wie viel besitzt."}
      </p>
      <p class="atlas-caveat">
        <strong
          >{en ? "Far from complete." : "Bei Weitem nicht vollständig."}</strong
        >
        {en
            ? " Most victims stay silent, and many cases never become public. How the attackers knew about their victims is rarely reported."
            : " Die meisten Opfer schweigen, viele Fälle werden nie öffentlich. Woher die Täter von ihren Opfern wussten, steht selten im Bericht."}
      </p>
      <a class="atlas-why" href={`${pathFor("dossier", language)}#angriffe`}
        >{en ? "Attacks after data leaks" : "Angriffe nach Datenlecks"}</a
      >
    </header>

    <div class="atlas-stage">
      <div
        class="atlas-bar"
        role="group"
        aria-label={en ? "Map filters" : "Kartenfilter"}
      >
        <div
          class="atlas-views"
          role="group"
          aria-label={en ? "Region" : "Ausschnitt"}
        >
          <button type="button" data-view="world" aria-pressed="true">
            {en ? "World" : "Welt"}
          </button>
          <button type="button" data-view="europe" aria-pressed="false">
            {en ? "Europe" : "Europa"}
          </button>
          <button type="button" data-view="austria" aria-pressed="false">
            {en ? "Austria" : "Österreich"}
          </button>
        </div>

        <div
          class="atlas-years"
          role="group"
          aria-labelledby="atlas-years-label"
        >
          <p class="atlas-years-label" id="atlas-years-label">
            <span class="atlas-label">{en ? "Period" : "Zeitraum"}</span>
            <span class="atlas-range" data-range-label
              >{firstYear}–{latestYear}</span
            >
          </p>
          <div class="atlas-histogram" style={`--years: ${years.length}`}>
            <div class="atlas-bars" aria-hidden="true">
              {years.map((year) => (
                  <span
                    data-year={year}
                    class:list={{ recent: year >= latestYear - 1 }}
                    style={`--share: ${countIn(year) / peak}`}
                  />
                ))}
            </div>
            <span class="atlas-fill" data-fill aria-hidden="true"></span>
            <div class="atlas-sliders">
              <input
                type="range"
                min={firstYear}
                max={latestYear}
                value={firstYear}
                step="1"
                data-from
                aria-label={en ? "From year" : "Ab Jahr"}
              >
              <input
                type="range"
                min={firstYear}
                max={latestYear}
                value={latestYear}
                step="1"
                data-to
                aria-label={en ? "Up to year" : "Bis Jahr"}
              >
            </div>
          </div>
        </div>

        <p class="atlas-legend">
          <span class="recent">{`${latestYear - 1}–${latestYear}`}</span>
          <span>{en ? "earlier" : "früher"}</span>
        </p>
      </div>

      <div class="atlas-viewport">
        <div
          class="atlas-map"
          data-map
          role="region"
          aria-label={en
              ? "Map of known attacks. The list shows the same cases."
              : "Karte der bekannten Angriffe. Die Liste zeigt dieselben Fälle."}
        ></div>
        <div class="atlas-zoom" role="group" aria-label="Zoom">
          <button
            type="button"
            data-zoom="in"
            aria-label={en ? "Zoom in" : "Hineinzoomen"}
          >
            +
          </button>
          <button
            type="button"
            data-zoom="out"
            aria-label={en ? "Zoom out" : "Herauszoomen"}
          >
            −
          </button>
        </div>
      </div>
    </div>

    <section class="atlas-cases" aria-labelledby="atlas-list-title">
      <h2 class="atlas-list-title" id="atlas-list-title" data-list-title>
        {`${firstYear}–${latestYear}, ${strings.newest}`}
      </h2>
      <ol class="atlas-list" data-list>
        {newestFirst.map((attack) => (
            <li class:list={{ recent: attack.year >= latestYear - 1 }}>
              <p class="atlas-meta">
                <span class="atlas-date">
                  {attack.date ? formatDate(attack.date, language) : attack.year}
                </span>
                <span class="atlas-place">{placeOf(attack, language)}</span>
              </p>
              <p class="atlas-headline" lang={headlineOf(attack, language).lang}>
                {headlineOf(attack, language).text}
              </p>
              <p class="atlas-links">
                {attack.reports.map((report) => [
                  report.url && (
                    <a href={report.url} rel="noopener">
                      {`${strings.report}: ${hostOf(report.url)}`}
                    </a>
                  ),
                  report.archive && (
                    <a href={report.archive} rel="noopener">
                      {strings.archive}
                    </a>
                  ),
                ])}
              </p>
            </li>
          ))}
      </ol>
      <p class="atlas-more" data-more hidden></p>

      <p class="atlas-source">
        {en ? "Source: " : "Quelle: "}
        <a href="https://github.com/jlopp/physical-bitcoin-attacks"
          >Jameson Lopp, Known Physical Bitcoin Attacks</a
        >{en
            ? `, as of ${through}. Descriptions as given in the collection; the linked reports are authoritative. Victims’ names are left out.`
            : `, Stand ${through}. Beschreibungen aus der Sammlung übersetzt, neue Fälle zunächst auf Englisch; maßgeblich sind die verlinkten Berichte. Namen der Opfer lassen wir weg.`}
      </p>
    </section>
  </div>
</Layout>

<script>
  import attacks from "@/data/attacks.json"
  import { headlineOf } from "@/lib/attacks"
  import L from "leaflet"
  import "leaflet/dist/leaflet.css"
  import "leaflet.markercluster/dist/MarkerCluster.css"
  import { feature } from "topojson-client"
  import type { GeometryCollection, Topology } from "topojson-specification"
  import countriesUrl from "world-atlas/countries-50m.json?url"

  type Attack = (typeof attacks)[number]

  const start = async (root: HTMLElement, mapElement: HTMLElement) => {
    const stage = root.querySelector<HTMLElement>(".atlas-stage") ?? mapElement
    // Show the map area first: Leaflet measures its container on start.
    root.classList.add("atlas-ready")
    // The cluster plugin extends the global Leaflet object.
    Object.assign(globalThis, { L })
    await import("leaflet.markercluster")

    const language = root.dataset.language === "en" ? "en" : "de"
    const strings = JSON.parse(root.dataset.strings ?? "{}")
    const locale = language === "en" ? "en-GB" : "de-AT"
    const regions = new Intl.DisplayNames([language], { type: "region" })
    const latestYear = Math.max(...attacks.map((attack) => attack.year))
    const recentFrom = latestYear - 1

    const place = (attack: Attack) => {
      const country =
        (attack.countryCode && regions.of(attack.countryCode)) ??
        attack.country ??
        ""
      return attack.city && attack.city !== country
        ? `${attack.city}, ${country}`
        : country
    }
    const dateOf = (attack: Attack) =>
      attack.date
        ? new Date(`${attack.date}T12:00:00Z`).toLocaleDateString(locale, {
            day: "numeric",
            month: "long",
            year: "numeric",
            timeZone: "UTC",
          })
        : String(attack.year)
    const hostOf = (url: string) => {
      try {
        return new URL(url).hostname.replace(/^www\./, "")
      } catch {
        return url
      }
    }
    const element = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className: string,
      text?: string,
    ) => {
      const node = document.createElement(tag)
      node.className = className
      if (text !== undefined) node.textContent = text
      return node
    }
    const link = (href: string, text: string) =>
      Object.assign(element("a", "", text), { href, rel: "noopener" })

    // Descriptions come from a third-party file, so they are set as text,
    // never as HTML. Each case links to the original report and an archive
    // copy, so readers can check it for themselves.
    const caseBody = (attack: Attack, placeElement: HTMLElement) => {
      const meta = element("p", "atlas-meta")
      meta.append(element("span", "atlas-date", dateOf(attack)), placeElement)
      const { text, lang } = headlineOf(attack, language)
      const headline = element("p", "atlas-headline", text)
      headline.lang = lang
      const links = element("p", "atlas-links")
      for (const report of attack.reports) {
        if (report.url)
          links.append(
            link(report.url, `${strings.report}: ${hostOf(report.url)}`),
          )
        if (report.archive) links.append(link(report.archive, strings.archive))
      }
      return [meta, headline, links]
    }

    const map = L.map(mapElement, {
      preferCanvas: true,
      zoomControl: false,
      minZoom: 2,
      maxZoom: 13,
      zoomSnap: 0.5,
      worldCopyJump: false,
      maxBounds: [
        [-72, -230],
        [86, 230],
      ],
      maxBoundsViscosity: 0.8,
    })
    map.attributionControl
      .setPrefix(false)
      .addAttribution(
        language === "en"
          ? 'Map: <a href="https://www.naturalearthdata.com/">Natural Earth</a> · Data: <a href="https://github.com/jlopp/physical-bitcoin-attacks">Jameson Lopp</a>'
          : 'Karte: <a href="https://www.naturalearthdata.com/">Natural Earth</a> · Daten: <a href="https://github.com/jlopp/physical-bitcoin-attacks">Jameson Lopp</a>',
      )

    const views = {
      world: L.latLngBounds([-45, -130], [68, 150]),
      europe: L.latLngBounds([35, -11], [62, 32]),
      austria: L.latLngBounds([46.3, 9.4], [49.1, 17.2]),
    }
    const fitOptions = { padding: L.point(16, 16) }
    map.fitBounds(views.world, fitOptions)
    new ResizeObserver(() => map.invalidateSize()).observe(mapElement)
    // Phones get smaller circles and merge nearby cases earlier.
    const compact = matchMedia("(width < 40rem)").matches

    // Land and borders are drawn from Natural Earth on a canvas, in the site's
    // own colours, so no map tiles are loaded from third parties.
    const probe = element("span", "atlas-probe")
    root.append(probe)
    const colour = (name: string) => {
      probe.style.color = `var(${name})`
      return getComputedStyle(probe).color
    }
    let countries: L.GeoJSON | undefined
    const paintCountries = () =>
      countries?.setStyle({
        fillColor: colour("--gray-4"),
        fillOpacity: 1,
        color: colour("--gray-1"),
        weight: 0.8,
      })
    fetch(countriesUrl)
      .then((response) => response.json())
      .then((topology: Topology) => {
        const shapes = feature(
          topology,
          topology.objects.countries as GeometryCollection,
        )
        // Antarctica holds no cases. Rings that cross the date line are
        // shifted east so Leaflet does not draw them as bands across the map.
        shapes.features = shapes.features.filter(
          (country) => country.id !== "010",
        )
        const unwrap = (ring: number[][]) => {
          const longitudes = ring.map(([lng]) => lng)
          if (Math.max(...longitudes) - Math.min(...longitudes) <= 180) return
          for (const point of ring) if (point[0] < 0) point[0] += 360
        }
        for (const { geometry } of shapes.features) {
          if (geometry.type === "Polygon") geometry.coordinates.forEach(unwrap)
          if (geometry.type === "MultiPolygon")
            for (const polygon of geometry.coordinates) polygon.forEach(unwrap)
        }
        countries = L.geoJSON(shapes, { interactive: false }).addTo(map)
        countries.bringToBack()
        paintCountries()
      })
    new MutationObserver(paintCountries).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    })
    matchMedia("(prefers-color-scheme: dark)").addEventListener(
      "change",
      paintCountries,
    )

    const icon = (recent: boolean) =>
      L.divIcon({
        className: recent ? "atlas-dot recent" : "atlas-dot",
        iconSize: [14, 14],
      })
    const entries = attacks.map((attack) => {
      const recent = attack.year >= recentFrom
      const marker = L.marker([attack.lat, attack.lng], {
        icon: icon(recent),
        alt: `${place(attack)}, ${dateOf(attack)}`,
        title: `${place(attack)}, ${attack.year}`,
      })
      marker.bindPopup(
        () => {
          const box = element("div", "atlas-case")
          box.append(
            ...caseBody(
              attack,
              element("strong", "atlas-place", place(attack)),
            ),
          )
          return box
        },
        {
          className: "atlas-popup",
          minWidth: 240,
          maxWidth: 320,
          autoPanPadding: [24, 72],
        },
      )
      return { attack, marker, recent }
    })
    const recentMarkers = new Set(
      entries.filter((entry) => entry.recent).map((entry) => entry.marker),
    )

    // Hotspots: nearby cases merge into a numbered circle that splits up as
    // you zoom in. Red marks clusters where most cases are recent.
    const cluster = L.markerClusterGroup({
      showCoverageOnHover: false,
      spiderfyOnMaxZoom: true,
      // Circles stay smaller than the merge radius, so hotspots do not pile
      // up on top of each other on small screens.
      maxClusterRadius: (zoom: number) =>
        (zoom < 5 ? 56 : 44) + (compact ? 12 : 0),
      iconCreateFunction: (group) => {
        const children = group.getAllChildMarkers()
        const count = children.length
        const recent = children.filter((marker) =>
          recentMarkers.has(marker),
        ).length
        const size = Math.round(
          compact ? 24 + Math.log2(count) * 3.5 : 26 + Math.log2(count) * 4.5,
        )
        return L.divIcon({
          html: `<span>${count}</span>`,
          className:
            recent * 2 >= count ? "atlas-cluster recent" : "atlas-cluster",
          iconSize: [size, size],
        })
      },
    }).addTo(map)

    const from = root.querySelector<HTMLInputElement>("[data-from]")!
    const to = root.querySelector<HTMLInputElement>("[data-to]")!
    const fill = root.querySelector<HTMLElement>("[data-fill]")!
    const bars = [...root.querySelectorAll<HTMLElement>("[data-year]")]
    const rangeLabel = root.querySelector<HTMLElement>("[data-range-label]")!
    const listTitle = root.querySelector<HTMLElement>("[data-list-title]")!
    const list = root.querySelector<HTMLOListElement>("[data-list]")!
    const more = root.querySelector<HTMLElement>("[data-more]")!
    const presets = [...root.querySelectorAll<HTMLButtonElement>("[data-view]")]
    const firstYear = Number(from.min)
    let low = firstYear
    let high = latestYear

    // A ring marks the place of the case under the pointer or in focus, even
    // while it sits inside a hotspot.
    const spot = L.marker([0, 0], {
      icon: L.divIcon({
        className: "atlas-spot",
        html: "<span></span>",
        iconSize: [36, 36],
      }),
      interactive: false,
      keyboard: false,
      zIndexOffset: 1000,
    })
    const showSpot = (marker: L.Marker) => {
      spot.setLatLng(marker.getLatLng()).addTo(map)
    }
    const hideSpot = () => spot.remove()

    const listLimit = 60
    const render = () => {
      const bounds = map.getBounds()
      const inView = entries.filter((entry) =>
        bounds.contains(entry.marker.getLatLng()),
      )
      // The bars show how the cases in this view spread over the years.
      const perYear = bars.map(
        (bar) =>
          inView.filter(
            ({ attack }) => attack.year === Number(bar.dataset.year),
          ).length,
      )
      const peak = Math.max(1, ...perYear)
      bars.forEach((bar, index) =>
        bar.style.setProperty("--share", String(perYear[index] / peak)),
      )

      const visible = inView
        .filter(({ attack }) => attack.year >= low && attack.year <= high)
        .sort((a, b) =>
          (b.attack.date ?? `${b.attack.year}`).localeCompare(
            a.attack.date ?? `${a.attack.year}`,
          ),
        )
      hideSpot()
      list.replaceChildren(
        ...visible.slice(0, listLimit).map(({ attack, marker, recent }) => {
          const button = element("button", "atlas-place", place(attack))
          button.type = "button"
          button.addEventListener("click", () => {
            cluster.zoomToShowLayer(marker, () => marker.openPopup())
            // On phones the map sits above the list; bring it into view.
            if (matchMedia("(width < 64rem)").matches)
              stage.scrollIntoView({ behavior: "smooth", block: "start" })
          })
          const item = element("li", recent ? "recent" : "")
          item.append(...caseBody(attack, button))
          item.addEventListener("pointerenter", () => showSpot(marker))
          item.addEventListener("pointerleave", hideSpot)
          item.addEventListener("focusin", () => showSpot(marker))
          item.addEventListener("focusout", hideSpot)
          return item
        }),
      )
      more.hidden = visible.length > 0 && visible.length <= listLimit
      more.textContent = visible.length === 0 ? strings.none : strings.more
    }

    const applyYears = () => {
      low = Number(from.value)
      high = Number(to.value)
      if (low > high) [low, high] = [high, low]
      cluster.clearLayers()
      cluster.addLayers(
        entries
          .filter(({ attack }) => attack.year >= low && attack.year <= high)
          .map((entry) => entry.marker),
      )
      for (const bar of bars) {
        const year = Number(bar.dataset.year)
        bar.classList.toggle("off", year < low || year > high)
      }
      // The red line joins the two handles; each handle sits on its bar.
      const years = latestYear - firstYear + 1
      fill.style.insetInlineStart = `${((low - firstYear + 0.5) / years) * 100}%`
      fill.style.insetInlineEnd = `${((latestYear - high + 0.5) / years) * 100}%`
      rangeLabel.textContent = low === high ? `${low}` : `${low}–${high}`
      listTitle.textContent = `${rangeLabel.textContent}, ${strings.newest}`
      render()
    }

    // A preset stays marked until the reader moves the map themselves.
    let flying = false
    const mark = (view?: string) => {
      for (const button of presets)
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.view === view),
        )
    }
    map.on("movestart", () => {
      if (!flying) mark()
    })
    map.on("moveend", () => {
      flying = false
      render()
    })
    for (const button of presets)
      button.addEventListener("click", () => {
        flying = true
        mark(button.dataset.view)
        map.flyToBounds(views[button.dataset.view as keyof typeof views], {
          ...fitOptions,
          duration: 0.8,
        })
      })

    from.addEventListener("input", applyYears)
    to.addEventListener("input", applyYears)
    root
      .querySelector("[data-zoom='in']")
      ?.addEventListener("click", () => map.zoomIn())
    root
      .querySelector("[data-zoom='out']")
      ?.addEventListener("click", () => map.zoomOut())

    applyYears()
  }

  const root = document.querySelector<HTMLElement>("[data-atlas]")
  const mapElement = root?.querySelector<HTMLElement>("[data-map]")
  if (root && mapElement) void start(root, mapElement)
</script>

<style>
  /* Vollbild-Archiv: links Einordnung, die Zahl der Fälle und die Liste,
     rechts die Karte. Ausschnitt und Zeitraum sitzen in einer Leiste über
     der Karte, der Zoom unten rechts. Auf schmalen Bildschirmen folgen
     Einordnung, Leiste, Karte und Liste aufeinander. */
  .atlas {
    --ink: var(--foreground);
    --ink-2: color-mix(in oklab, var(--foreground) 82%, transparent);
    --ink-3: var(--muted-foreground);
    --line: color-mix(in oklab, var(--foreground) 12%, transparent);
    --gutter: var(--space-s);
    display: grid;
    grid-template-areas:
      "intro stage"
      "cases stage";
    grid-template-columns: clamp(19rem, 28vw, 24rem) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    block-size: calc(100dvh - var(--bar-height));
    min-block-size: 34rem;
  }

  .atlas-intro {
    grid-area: intro;
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m) var(--gutter) var(--space-s);
    border-inline-end: 1px solid var(--border);
  }

  h1 {
    margin-block-end: var(--space-3xs);
    font-size: clamp(1.375rem, 1.1rem + 0.6vw, 1.75rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .atlas-lead {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .atlas-caveat {
    padding-inline-start: 0.625rem;
    border-inline-start: 2px solid var(--primary);
    color: var(--ink-3);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .atlas-caveat strong {
    color: var(--ink);
    font-weight: 600;
  }

  .atlas-why {
    justify-self: start;
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 560;
  }

  .atlas-why::after {
    content: " →";
  }

  /* Die Liste zeigt die Fälle im Ausschnitt; ihr Kopf nennt Zeitraum und
     Reihenfolge und bleibt stehen, während die Fälle darunter scrollen. */
  .atlas-cases {
    grid-area: cases;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--gutter) var(--space-l);
    border-block-start: 1px solid var(--border);
    border-inline-end: 1px solid var(--border);
  }

  .atlas-list-title {
    position: sticky;
    z-index: 1;
    inset-block-start: 0;
    margin-inline: calc(-1 * var(--gutter));
    padding: 0.625rem var(--gutter);
    border-block-end: 1px solid var(--line);
    color: var(--ink-3);
    background: var(--background);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: normal;
    font-variant-numeric: tabular-nums;
  }

  .atlas-list {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .atlas-more,
  .atlas-source {
    margin-block-start: var(--space-s);
    color: var(--ink-3);
    font-size: 0.75rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .atlas-source a {
    color: inherit;
  }

  .atlas-stage {
    grid-area: stage;
    display: flex;
    flex-direction: column;
    min-block-size: 0;
    scroll-margin-block-start: var(--bar-height);
  }

  /* Die Filterleiste: Ausschnitt, Zeitraum mit Verlauf und Legende in einer
     festen Leiste über der Karte statt einer schwebenden Pille. */
  .atlas-bar {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    padding: 0.625rem var(--gutter);
    border-block-end: 1px solid var(--border);
    background: var(--background);
  }

  .atlas-views {
    display: flex;
    flex: none;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-lg);
    background: var(--gray-3);
  }

  .atlas-views button {
    min-block-size: 2.25rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: var(--radius-md);
    color: var(--ink-3);
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 560;
    cursor: pointer;
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  .atlas-views button:hover {
    color: var(--ink);
  }

  .atlas-views button[aria-pressed="true"] {
    color: var(--ink);
    background: light-dark(var(--gray-1), var(--gray-6));
    box-shadow: 0 1px 2px
      color-mix(in oklab, var(--foreground) 14%, transparent);
  }

  .atlas-views button:focus-visible,
  .atlas-zoom button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }

  .atlas-years {
    display: flex;
    flex: 1 1 15rem;
    align-items: center;
    gap: var(--space-s);
    min-inline-size: 0;
    max-inline-size: 40rem;
  }

  .atlas-years-label {
    display: grid;
    flex: none;
    min-inline-size: 5.25rem;
    line-height: 1.2;
  }

  .atlas-label {
    color: var(--ink-3);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .atlas-range {
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Ein Balken je Jahr für die Fälle im aktuellen Ausschnitt, in den Farben
     der Karte: rot die letzten zwei Jahre, grau die früheren. Die Griffe der
     beiden Regler sitzen genau unter ihren Balken. */
  .atlas-histogram {
    --thumb: 1.125rem;
    --base: 1.75rem;
    position: relative;
    flex: 1;
    min-inline-size: 9rem;
    block-size: calc(var(--base) + var(--thumb) / 2 + 2px);
  }

  .atlas-bars {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    display: flex;
    align-items: end;
    block-size: var(--base);
  }

  .atlas-bars span {
    flex: 1;
    block-size: calc(var(--share) * 100%);
    min-block-size: 2px;
    margin-inline: 1.5px;
    border-radius: 2px 2px 0 0;
    background: var(--gray-9);
    transition:
      block-size 240ms ease,
      background-color 140ms ease;
  }

  .atlas-bars span.recent {
    background: var(--primary);
  }

  .atlas-bars span.off {
    background: var(--gray-5);
  }

  .atlas-fill {
    position: absolute;
    inset-block-start: calc(var(--base) - 1px);
    block-size: 2px;
    background: var(--ink);
  }

  .atlas-sliders {
    position: absolute;
    inset-block-start: calc(var(--base) - var(--thumb) / 2);
    inset-inline: calc(50% / var(--years) - var(--thumb) / 2);
    block-size: var(--thumb);
  }

  .atlas-sliders input {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    margin: 0;
    background: transparent;
    pointer-events: none;
    appearance: none;
  }

  .atlas-sliders input::-webkit-slider-runnable-track {
    block-size: 2px;
    background: transparent;
  }

  .atlas-sliders input::-moz-range-track {
    block-size: 2px;
    background: transparent;
  }

  .atlas-sliders input::-webkit-slider-thumb {
    box-sizing: border-box;
    inline-size: var(--thumb);
    block-size: var(--thumb);
    margin-block-start: calc(1px - var(--thumb) / 2);
    border: 2px solid var(--background);
    border-radius: var(--radius-full);
    background: var(--ink);
    box-shadow: 0 1px 3px
      color-mix(in oklab, var(--foreground) 35%, transparent);
    cursor: grab;
    pointer-events: auto;
    appearance: none;
  }

  .atlas-sliders input::-moz-range-thumb {
    box-sizing: border-box;
    inline-size: var(--thumb);
    block-size: var(--thumb);
    border: 2px solid var(--background);
    border-radius: var(--radius-full);
    background: var(--ink);
    cursor: grab;
    pointer-events: auto;
  }

  /* Beide Regler liegen übereinander; der Fokus zeigt sich am Griff, nicht
     als Rahmen um die ganze Leiste. */
  .atlas-sliders input:focus-visible {
    outline: none;
  }

  .atlas-sliders input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }

  .atlas-sliders input:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }

  .atlas-legend {
    display: flex;
    flex: none;
    gap: var(--space-s);
    margin-inline-start: auto;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .atlas-legend span::before {
    content: "";
    display: inline-block;
    inline-size: 0.625rem;
    block-size: 0.625rem;
    margin-inline-end: 0.4em;
    border-radius: var(--radius-full);
    background: var(--gray-9);
  }

  .atlas-legend .recent::before {
    background: var(--primary);
  }

  .atlas-viewport {
    position: relative;
    flex: 1;
    min-block-size: 0;
  }

  .atlas-map {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: var(--gray-2);
  }

  /* Zoom wie auf Karten üblich unten rechts, über der Quellenangabe. */
  .atlas-zoom {
    position: absolute;
    z-index: 1;
    inset-inline-end: var(--gutter);
    inset-block-end: 2rem;
    display: grid;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
    box-shadow: 0 2px 8px
      color-mix(in oklab, var(--foreground) 12%, transparent);
    overflow: hidden;
  }

  .atlas-zoom button {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    padding: 0;
    border: 0;
    color: var(--ink);
    background: transparent;
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .atlas-zoom button + button {
    border-block-start: 1px solid var(--border);
  }

  .atlas-zoom button:hover {
    background: var(--gray-3);
  }

  /* Ohne JavaScript gibt es keine Karte; dann bleibt das Archiv als Liste. */
  .atlas:not(.atlas-ready) {
    grid-template-areas:
      "intro"
      "cases";
    grid-template-columns: minmax(0, 48rem);
    block-size: auto;
  }

  .atlas:not(.atlas-ready) .atlas-stage {
    display: none;
  }

  .atlas:not(.atlas-ready) .atlas-cases {
    overflow: visible;
  }

  @media (width < 64rem) {
    .atlas {
      --gutter: var(--grid-gutter);
      grid-template-areas:
        "intro"
        "stage"
        "cases";
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      block-size: auto;
    }

    .atlas-intro,
    .atlas-cases {
      border-inline-end: 0;
    }

    .atlas-cases {
      overflow: visible;
      border-block-start: 0;
    }

    .atlas-list-title {
      inset-block-start: var(--bar-height);
    }

    .atlas-bar {
      border-block-start: 1px solid var(--border);
    }

    .atlas-viewport {
      flex: none;
      block-size: 58svh;
      min-block-size: 20rem;
    }
  }

  @media (width < 40rem) {
    .atlas-views {
      flex: 1 1 100%;
    }

    .atlas-views button {
      flex: 1;
      padding-inline: 0.5rem;
    }

    .atlas-years {
      flex-basis: 100%;
    }

    .atlas-legend {
      margin-inline-start: 0;
    }
  }
</style>

<style is:global>
