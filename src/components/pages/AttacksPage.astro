---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import {
  attacks,
  countIn,
  formatDate,
  hostOf,
  latestDate,
  latestYear,
  placeOf,
} from "@/lib/attacks"
import { languageFor, pathFor } from "@/lib/i18n"

const language = languageFor(Astro.url.pathname)
const en = language === "en"

const firstYear = Math.min(...attacks.map((attack) => attack.year))
const years = Array.from(
  { length: latestYear - firstYear + 1 },
  (_, index) => firstYear + index,
)
const peak = Math.max(...years.map((year) => countIn(year)))
const through = latestDate ? formatDate(latestDate, language) : ""
const newestFirst = [...attacks].sort((a, b) =>
  (b.date ?? `${b.year}`).localeCompare(a.date ?? `${a.year}`),
)

// Texts the map script needs; everything else is rendered here.
const strings = en
  ? {
      listTitle: "The latest cases in this view",
      more: "More cases in this view: zoom in or choose a shorter period.",
      none: "No known cases in this view. The archive is incomplete.",
      report: "Report",
      archive: "Archive copy",
    }
  : {
      listTitle: "Die neuesten Fälle in diesem Ausschnitt",
      more: "Weitere Fälle in diesem Ausschnitt: Zoome hinein oder wähle einen kürzeren Zeitraum.",
      none: "Keine bekannten Fälle in diesem Ausschnitt. Das Archiv ist unvollständig.",
      report: "Bericht",
      archive: "Archivkopie",
    }
---

<Layout fullBleed>
  <MetaPage slot="head" />
  <div
    class="atlas"
    data-atlas
    data-language={language}
    data-strings={JSON.stringify(strings)}
  >
    <aside class="atlas-panel">
      <h1>
        {en
            ? "Robbed, kidnapped, held captive."
            : "Überfallen, entführt, gefangen gehalten."}
      </h1>
      <p class="atlas-lead">
        {en
            ? "An archive of physical attacks on people who hold crypto-assets, or are believed to, all over the world. Attackers force their way into homes, tie up families, abduct and torture people to get at their wallets."
            : "Ein Archiv körperlicher Angriffe auf Menschen, die Kryptowerte besitzen oder besitzen sollen, auf der ganzen Welt. Täter dringen in Wohnungen ein, fesseln Familien, entführen und foltern, um an Wallets zu kommen."}
      </p>
      <p class="atlas-caveat">
        <strong
          >{en ? "Far from complete." : "Bei Weitem nicht vollständig."}</strong
        >
        {en
            ? " Most victims stay silent, and many cases never become public. Every entry links to the original report."
            : " Die meisten Opfer schweigen, viele Fälle werden nie öffentlich. Jeder Eintrag verweist auf den ursprünglichen Bericht."}
      </p>

      <fieldset class="atlas-years">
        <legend>
          {en ? "Period" : "Zeitraum"}
          <span data-range-label>{firstYear}–{latestYear}</span>
        </legend>
        <div class="atlas-bars" aria-hidden="true">
          {years.map((year) => (
              <span
                data-year={year}
                style={`--share: ${countIn(year) / peak}`}
              />
            ))}
        </div>
        <div class="atlas-sliders">
          <input
            type="range"
            min={firstYear}
            max={latestYear}
            value={firstYear}
            step="1"
            data-from
            aria-label={en ? "From year" : "Ab Jahr"}
          >
          <input
            type="range"
            min={firstYear}
            max={latestYear}
            value={latestYear}
            step="1"
            data-to
            aria-label={en ? "Up to year" : "Bis Jahr"}
          >
        </div>
        <div class="atlas-scale" aria-hidden="true">
          <span>{firstYear}</span>
          <span>{latestYear}</span>
        </div>
        <p class="atlas-legend">
          <span class="recent">{`${latestYear - 1}–${latestYear}`}</span>
          <span>{en ? "earlier" : "früher"}</span>
        </p>
      </fieldset>

      <h2 class="atlas-list-title" data-list-title>
        {en ? "All cases, newest first" : "Alle Fälle, die neuesten zuerst"}
      </h2>
      <ol class="atlas-list" data-list>
        {newestFirst.map((attack) => (
            <li>
              <p class="atlas-meta">
                <span class="atlas-date">
                  {attack.date ? formatDate(attack.date, language) : attack.year}
                </span>
                <span class="atlas-place">{placeOf(attack, language)}</span>
              </p>
              <p class="atlas-headline" lang="en">
                {attack.headline}
              </p>
              <p class="atlas-links">
                {attack.reports.map((report) => [
                  report.url && (
                    <a href={report.url} rel="noopener">
                      {`${strings.report}: ${hostOf(report.url)}`}
                    </a>
                  ),
                  report.archive && (
                    <a href={report.archive} rel="noopener">
                      {strings.archive}
                    </a>
                  ),
                ])}
              </p>
            </li>
          ))}
      </ol>
      <p class="atlas-more" data-more hidden></p>

      <p class="atlas-source">
        {en ? "Source: " : "Quelle: "}
        <a href="https://github.com/jlopp/physical-bitcoin-attacks"
          >Jameson Lopp, Known Physical Bitcoin Attacks</a
        >{en
            ? `, as of ${through}. Descriptions in English as given in the collection. Victims’ names are left out.`
            : `, Stand ${through}. Beschreibungen auf Englisch aus der Sammlung. Namen der Opfer lassen wir weg.`}
        <a href={`${pathFor("dossier", language)}#faelle`}
          >{en ? "What this has to do with DAC8" : "Was das mit DAC8 zu tun hat"}</a
        >
      </p>
    </aside>
    <div class="atlas-stage">
      <div
        class="atlas-toolbar"
        role="toolbar"
        aria-label={en ? "Map controls" : "Kartensteuerung"}
      >
        <button type="button" data-view="world">{en ? "World" : "Welt"}</button>
        <button type="button" data-view="europe">
          {en ? "Europe" : "Europa"}
        </button>
        <button type="button" data-view="austria">
          {en ? "Austria" : "Österreich"}
        </button>
        <span class="atlas-zoom">
          <button
            type="button"
            data-zoom="out"
            aria-label={en ? "Zoom out" : "Herauszoomen"}
          >
            −
          </button>
          <button
            type="button"
            data-zoom="in"
            aria-label={en ? "Zoom in" : "Hineinzoomen"}
          >
            +
          </button>
        </span>
      </div>
      <div
        class="atlas-map"
        data-map
        role="region"
        aria-label={en
            ? "Map of known attacks. The list shows the same cases."
            : "Karte der bekannten Angriffe. Die Liste zeigt dieselben Fälle."}
      ></div>
    </div>
  </div>
</Layout>

<script>
  import attacks from "@/data/attacks.json"
  import L from "leaflet"
  import "leaflet/dist/leaflet.css"
  import "leaflet.markercluster/dist/MarkerCluster.css"
  import { feature } from "topojson-client"
  import type { GeometryCollection, Topology } from "topojson-specification"
  import countriesUrl from "world-atlas/countries-50m.json?url"

  type Attack = (typeof attacks)[number]

  const start = async (root: HTMLElement, mapElement: HTMLElement) => {
    // Show the map area first: Leaflet measures its container on start.
    root.classList.add("atlas-ready")
    // The cluster plugin extends the global Leaflet object.
    Object.assign(globalThis, { L })
    await import("leaflet.markercluster")

    const language = root.dataset.language === "en" ? "en" : "de"
    const strings = JSON.parse(root.dataset.strings ?? "{}")
    const locale = language === "en" ? "en-GB" : "de-AT"
    const regions = new Intl.DisplayNames([language], { type: "region" })
    const latestYear = Math.max(...attacks.map((attack) => attack.year))
    const recentFrom = latestYear - 1

    const place = (attack: Attack) => {
      const country =
        (attack.countryCode && regions.of(attack.countryCode)) ??
        attack.country ??
        ""
      return attack.city && attack.city !== country
        ? `${attack.city}, ${country}`
        : country
    }
    const dateOf = (attack: Attack) =>
      attack.date
        ? new Date(`${attack.date}T12:00:00Z`).toLocaleDateString(locale, {
            day: "numeric",
            month: "long",
            year: "numeric",
            timeZone: "UTC",
          })
        : String(attack.year)
    const hostOf = (url: string) => {
      try {
        return new URL(url).hostname.replace(/^www\./, "")
      } catch {
        return url
      }
    }
    const element = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className: string,
      text?: string,
    ) => {
      const node = document.createElement(tag)
      node.className = className
      if (text !== undefined) node.textContent = text
      return node
    }
    const link = (href: string, text: string) =>
      Object.assign(element("a", "", text), { href, rel: "noopener" })

    // Descriptions come from a third-party file, so they are set as text,
    // never as HTML. Each case links to the original report and an archive
    // copy, so readers can check it for themselves.
    const caseBody = (attack: Attack, placeElement: HTMLElement) => {
      const meta = element("p", "atlas-meta")
      meta.append(element("span", "atlas-date", dateOf(attack)), placeElement)
      const headline = element("p", "atlas-headline", attack.headline ?? "")
      headline.lang = "en"
      const links = element("p", "atlas-links")
      for (const report of attack.reports) {
        if (report.url)
          links.append(
            link(report.url, `${strings.report}: ${hostOf(report.url)}`),
          )
        if (report.archive) links.append(link(report.archive, strings.archive))
      }
      return [meta, headline, links]
    }

    const map = L.map(mapElement, {
      preferCanvas: true,
      zoomControl: false,
      minZoom: 2,
      maxZoom: 13,
      zoomSnap: 0.5,
      worldCopyJump: false,
      maxBounds: [
        [-72, -230],
        [86, 230],
      ],
      maxBoundsViscosity: 0.8,
    })
    map.attributionControl
      .setPrefix(false)
      .addAttribution(
        language === "en"
          ? "Map: Natural Earth · Data: Jameson Lopp"
          : "Karte: Natural Earth · Daten: Jameson Lopp",
      )

    const views = {
      world: L.latLngBounds([-45, -130], [68, 150]),
      europe: L.latLngBounds([35, -11], [62, 32]),
      austria: L.latLngBounds([46.3, 9.4], [49.1, 17.2]),
    }
    // Keep the toolbar from covering cases when a view is fitted.
    const toolbar = root.querySelector<HTMLElement>(".atlas-toolbar")
    const fitOptions = () => ({
      paddingTopLeft: L.point(0, (toolbar?.offsetHeight ?? 0) + 16),
      paddingBottomRight: L.point(0, 16),
    })
    map.fitBounds(views.world, fitOptions())
    new ResizeObserver(() => map.invalidateSize()).observe(mapElement)
    // Phones get smaller circles and merge nearby cases earlier.
    const compact = matchMedia("(width < 40rem)").matches

    // Land and borders are drawn from Natural Earth on a canvas, in the site's
    // own colours, so no map tiles are loaded from third parties.
    const probe = element("span", "atlas-probe")
    root.append(probe)
    const colour = (name: string) => {
      probe.style.color = `var(${name})`
      return getComputedStyle(probe).color
    }
    let countries: L.GeoJSON | undefined
    const paintCountries = () =>
      countries?.setStyle({
        fillColor: colour("--gray-4"),
        fillOpacity: 1,
        color: colour("--gray-1"),
        weight: 0.8,
      })
    fetch(countriesUrl)
      .then((response) => response.json())
      .then((topology: Topology) => {
        const shapes = feature(
          topology,
          topology.objects.countries as GeometryCollection,
        )
        // Antarctica holds no cases. Rings that cross the date line are
        // shifted east so Leaflet does not draw them as bands across the map.
        shapes.features = shapes.features.filter(
          (country) => country.id !== "010",
        )
        const unwrap = (ring: number[][]) => {
          const longitudes = ring.map(([lng]) => lng)
          if (Math.max(...longitudes) - Math.min(...longitudes) <= 180) return
          for (const point of ring) if (point[0] < 0) point[0] += 360
        }
        for (const { geometry } of shapes.features) {
          if (geometry.type === "Polygon") geometry.coordinates.forEach(unwrap)
          if (geometry.type === "MultiPolygon")
            for (const polygon of geometry.coordinates) polygon.forEach(unwrap)
        }
        countries = L.geoJSON(shapes, { interactive: false }).addTo(map)
        countries.bringToBack()
        paintCountries()
      })
    new MutationObserver(paintCountries).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    })
    matchMedia("(prefers-color-scheme: dark)").addEventListener(
      "change",
      paintCountries,
    )

    const icon = (recent: boolean) =>
      L.divIcon({
        className: recent ? "atlas-dot recent" : "atlas-dot",
        iconSize: [14, 14],
      })
    const entries = attacks.map((attack) => {
      const recent = attack.year >= recentFrom
      const marker = L.marker([attack.lat, attack.lng], {
        icon: icon(recent),
        alt: `${place(attack)}, ${dateOf(attack)}`,
        title: `${place(attack)}, ${attack.year}`,
      })
      marker.bindPopup(
        () => {
          const box = element("div", "atlas-case")
          box.append(
            ...caseBody(
              attack,
              element("strong", "atlas-place", place(attack)),
            ),
          )
          return box
        },
        {
          className: "atlas-popup",
          minWidth: 240,
          maxWidth: 320,
          autoPanPadding: [24, 72],
        },
      )
      return { attack, marker, recent }
    })
    const recentMarkers = new Set(
      entries.filter((entry) => entry.recent).map((entry) => entry.marker),
    )

    // Hotspots: nearby cases merge into a numbered circle that splits up as
    // you zoom in. Red marks clusters where most cases are recent.
    const cluster = L.markerClusterGroup({
      showCoverageOnHover: false,
      spiderfyOnMaxZoom: true,
      // Circles stay smaller than the merge radius, so hotspots do not pile
      // up on top of each other on small screens.
      maxClusterRadius: (zoom: number) =>
        (zoom < 5 ? 56 : 44) + (compact ? 12 : 0),
      iconCreateFunction: (group) => {
        const children = group.getAllChildMarkers()
        const count = children.length
        const recent = children.filter((marker) =>
          recentMarkers.has(marker),
        ).length
        const size = Math.round(
          compact ? 24 + Math.log2(count) * 3.5 : 26 + Math.log2(count) * 4.5,
        )
        return L.divIcon({
          html: `<span>${count}</span>`,
          className:
            recent * 2 >= count ? "atlas-cluster recent" : "atlas-cluster",
          iconSize: [size, size],
        })
      },
    }).addTo(map)

    const from = root.querySelector<HTMLInputElement>("[data-from]")!
    const to = root.querySelector<HTMLInputElement>("[data-to]")!
    const bars = root.querySelectorAll<HTMLElement>("[data-year]")
    const rangeLabel = root.querySelector<HTMLElement>("[data-range-label]")!
    const listTitle = root.querySelector<HTMLElement>("[data-list-title]")!
    const list = root.querySelector<HTMLOListElement>("[data-list]")!
    const more = root.querySelector<HTMLElement>("[data-more]")!
    listTitle.textContent = strings.listTitle
    let active = entries

    const listLimit = 60
    const renderList = () => {
      const bounds = map.getBounds()
      const visible = active
        .filter((entry) => bounds.contains(entry.marker.getLatLng()))
        .sort((a, b) =>
          (b.attack.date ?? `${b.attack.year}`).localeCompare(
            a.attack.date ?? `${a.attack.year}`,
          ),
        )
      list.replaceChildren(
        ...visible.slice(0, listLimit).map(({ attack, marker }) => {
          const button = element("button", "atlas-place", place(attack))
          button.type = "button"
          button.addEventListener("click", () => {
            cluster.zoomToShowLayer(marker, () => marker.openPopup())
            // On phones the map sits above the list; bring it into view.
            if (matchMedia("(width < 64rem)").matches)
              mapElement.scrollIntoView({ behavior: "smooth", block: "start" })
          })
          const item = element("li", "")
          item.append(...caseBody(attack, button))
          return item
        }),
      )
      more.hidden = visible.length > 0 && visible.length <= listLimit
      more.textContent = visible.length === 0 ? strings.none : strings.more
    }

    const applyYears = () => {
      let low = Number(from.value)
      let high = Number(to.value)
      if (low > high) [low, high] = [high, low]
      active = entries.filter(
        ({ attack }) => attack.year >= low && attack.year <= high,
      )
      cluster.clearLayers()
      cluster.addLayers(active.map((entry) => entry.marker))
      for (const bar of bars) {
        const year = Number(bar.dataset.year)
        bar.classList.toggle("off", year < low || year > high)
      }
      rangeLabel.textContent = low === high ? `${low}` : `${low}–${high}`
      renderList()
    }

    from.addEventListener("input", applyYears)
    to.addEventListener("input", applyYears)
    map.on("moveend", renderList)
    for (const button of root.querySelectorAll<HTMLButtonElement>(
      "[data-view]",
    ))
      button.addEventListener("click", () =>
        map.flyToBounds(views[button.dataset.view as keyof typeof views], {
          ...fitOptions(),
          duration: 0.8,
        }),
      )
    root
      .querySelector("[data-zoom='in']")
      ?.addEventListener("click", () => map.zoomIn())
    root
      .querySelector("[data-zoom='out']")
      ?.addEventListener("click", () => map.zoomOut())

    applyYears()
  }

  const root = document.querySelector<HTMLElement>("[data-atlas]")
  const mapElement = root?.querySelector<HTMLElement>("[data-map]")
  if (root && mapElement) void start(root, mapElement)
</script>

<style>
  /* Vollbild-Archiv: links Einordnung, Zeitraum und die Fälle, rechts die
     Karte mit einer Leiste für Ansichten und Zoom. Auf schmalen
     Bildschirmen steht die Karte oben, die Liste darunter. */
  .atlas {
    --ink: var(--foreground);
    --ink-2: color-mix(in oklab, var(--foreground) 86%, transparent);
    --ink-3: var(--muted-foreground);
    --line: color-mix(in oklab, var(--foreground) 14%, transparent);
    display: grid;
    grid-template-columns: minmax(20rem, 28rem) minmax(0, 1fr);
    block-size: calc(100dvh - var(--bar-height));
    min-block-size: 34rem;
  }

  .atlas-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    overflow-y: auto;
    padding: var(--space-l) var(--grid-gutter) var(--space-xl);
    border-inline-end: 1px solid var(--border);
    background: var(--background);
  }

  .atlas-stage {
    position: relative;
    min-block-size: 20rem;
  }

  .atlas-map {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: var(--gray-2);
  }

  h1 {
    font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.6rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .atlas-lead {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .atlas-caveat {
    padding: var(--space-s) var(--space-m);
    border-inline-start: 3px solid var(--primary);
    border-radius: 0 0.5rem 0.5rem 0;
    color: var(--ink-2);
    background: var(--gray-3);
    text-wrap: pretty;
  }

  .atlas-caveat strong {
    color: var(--ink);
  }

  .atlas-years {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .atlas-years legend {
    display: flex;
    gap: var(--space-xs);
    margin-block-end: var(--space-2xs);
    padding: 0;
    font-weight: 600;
  }

  .atlas-years legend span {
    color: var(--ink-3);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* Die Balken zeigen den Verlauf über die Jahre, ohne Zahlen in den
     Vordergrund zu stellen; der gewählte Zeitraum bleibt rot. */
  .atlas-bars {
    display: flex;
    align-items: end;
    gap: 3px;
    block-size: 3.5rem;
  }

  .atlas-bars span {
    flex: 1;
    block-size: calc(var(--share) * 100%);
    min-block-size: 3px;
    border-radius: 2px 2px 0 0;
    background: var(--primary);
    transition: background-color 140ms ease;
  }

  .atlas-bars span.off {
    background: var(--gray-6);
  }

  /* Zwei überlagerte Regler ergeben einen Bereich; nur die Griffe reagieren. */
  .atlas-sliders {
    position: relative;
    block-size: 1.75rem;
  }

  .atlas-sliders input {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    margin: 0;
    background: transparent;
    pointer-events: none;
    appearance: none;
  }

  .atlas-sliders input::-webkit-slider-runnable-track {
    block-size: 2px;
    background: var(--gray-6);
  }

  .atlas-sliders input::-moz-range-track {
    block-size: 2px;
    background: var(--gray-6);
  }

  .atlas-sliders input::-webkit-slider-thumb {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin-block-start: -0.69rem;
    border: 2px solid var(--background);
    border-radius: var(--radius-full);
    background: var(--foreground);
    box-shadow: 0 1px 3px
      color-mix(in oklab, var(--foreground) 35%, transparent);
    cursor: grab;
    pointer-events: auto;
    appearance: none;
  }

  .atlas-sliders input::-moz-range-thumb {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border: 2px solid var(--background);
    border-radius: var(--radius-full);
    background: var(--foreground);
    cursor: grab;
    pointer-events: auto;
  }

  .atlas-sliders input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .atlas-scale,
  .atlas-legend {
    display: flex;
    justify-content: space-between;
    color: var(--ink-3);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .atlas-legend {
    justify-content: start;
    gap: var(--space-m);
    margin-block-start: var(--space-2xs);
  }

  .atlas-legend span::before {
    content: "";
    display: inline-block;
    inline-size: 0.75em;
    block-size: 0.75em;
    margin-inline-end: 0.4em;
    border-radius: var(--radius-full);
    background: var(--gray-9);
    vertical-align: -0.05em;
  }

  .atlas-legend .recent::before {
    background: var(--primary);
  }

  .atlas-list-title {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .atlas-list {
    display: grid;
    margin-block-start: calc(-1 * var(--space-xs));
    padding: 0;
    list-style: none;
  }

  .atlas-more,
  .atlas-source {
    color: var(--ink-3);
    font-size: var(--step--1);
    text-wrap: pretty;
  }

  .atlas-source a {
    color: inherit;
  }

  /* Ansichten und Zoom in einer Leiste über der Karte. */
  .atlas-toolbar {
    position: absolute;
    z-index: 2;
    inset-block-start: var(--space-s);
    inset-inline-start: var(--space-s);
    display: flex;
    align-items: center;
    gap: 2px;
