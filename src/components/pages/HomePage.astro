---
import AffectedCheck from "@/components/AffectedCheck.astro"
import AttackMapPreview from "@/components/AttackMapPreview.astro"
import CampaignStatus from "@/components/CampaignStatus.astro"
import DataWeb from "@/components/DataWeb.astro"
import HistoryStack from "@/components/HistoryStack.astro"
import LegalRoute from "@/components/LegalRoute.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { peopleAffected, roundPeople } from "@/data/leaks"
import { countIn, euCountries, latestYear } from "@/lib/attacks"
import { languageFor, pathFor } from "@/lib/i18n"

// The home page tells one story in six bands: the claim and "Am I
// affected?" on the first screen, the data story, the proof that such data
// gets lost and that holders get attacked, three of our reasons, how each
// step of EU tax reporting has added more, and who filed the complaint. The
// footer's sign-off carries the one ask, as on every page. Every fact appears
// here once and in full on its own page: the dossier (what is reported),
// /angriffe/ and /datenlecks/ (cases), /argumente/ (reasons), /geschichte/
// (the steps), /verfahren/ (the case).
// The German headline keeps "Krypto-Kunde" on one line: a word joiner
// (U+2060) after the hyphen stops the break that balancing would pick.
const language = languageFor(Astro.url.pathname)
const en = language === "en"

// The proof band counts from the same data as the leak page and the map.
const people = roundPeople(peopleAffected, language)
const euNow = countIn(latestYear, euCountries)
const euBefore = countIn(latestYear - 1, euCountries)

// Three of the reasons on /argumente/, the ones the story around them does
// not already tell: the growing file and the target list are the data
// story, presumed wealth is the proof band, and the band after the reasons
// shows how surveillance grows. The cash comparison opens /argumente/. Icons
// follow src/assets/icons: 24 px grid, 1.7 stroke, round ends.
const reasons = [
  {
    icon: "key",
    anchor: "selbstverwahrung",
    title: en ? "We defend self-custody." : "Wir verteidigen Selbstverwahrung.",
    text: en
      ? "Holding bitcoin with your own keys is as legitimate as cash at home."
      : "Bitcoin mit eigenen Schlüsseln zu halten ist so legitim wie Bargeld daheim.",
  },
  {
    icon: "link",
    anchor: "pseudonym",
    title: en
      ? "Pseudonymous is not anonymous."
      : "Pseudonym ist nicht anonym.",
    text: en
      ? "A data leak can tie your name to your wallet addresses, and with them to your past payments."
      : "Ein Datenleck kann deinen Namen mit deinen Wallet-Adressen verbinden und damit mit früheren Zahlungen.",
  },
  {
    icon: "people",
    anchor: "alle",
    title: en ? "Privacy concerns everyone." : "Privatsphäre betrifft alle.",
    text: en
      ? "Even small payments show whom you donate to and whom you support."
      : "Auch kleine Zahlungen zeigen, wem du spendest und wen du unterstützt.",
  },
]
---

<Layout>
  <MetaPage slot="head" />

  <article class="campaign landing">
    <header class="hero">
      <div class="hero-text">
        <CampaignStatus language={language} />
        <h1>
          {en ? "Every crypto customer is now reported." : "Jeder Krypto-\u2060Kunde wird jetzt gemeldet."}
          <span>{en ? "We are fighting back." : "Wir gehen dagegen vor."}</span>
        </h1>
        <p class="lead">
          {en ? "The EU directive DAC8 requires exchanges, brokers and apps to tell the tax office every year who you are and how much you traded, without any suspicion." : "Die EU-Richtlinie DAC8 verpflichtet Börsen, Broker und Apps, dem Finanzamt jedes Jahr zu melden, wer du bist und wie viel du gehandelt hast, ganz ohne Verdacht."}
        </p>
      </div>
      <AffectedCheck language={language} />
    </header>

    <section id="problem" aria-labelledby="problem-heading">
      <h2 id="problem-heading">
        {en ? "What happens to your data" : "Was mit deinen Daten passiert"}
      </h2>
      <DataWeb language={language} />
    </section>

    <section id="gefahr" class="proof" aria-labelledby="gefahr-heading">
      <h2 id="gefahr-heading">
        {en ? "The danger begins when people know who holds how much." : "Gefährlich wird es, wenn bekannt ist, wer wie viel hat."}
      </h2>
      <p class="section-intro">
        {en ? (
          <>
            Exchanges, tax tools and authorities have already lost such data,
            on about <strong>{people}</strong> people across the documented
            cases. In the EU, <strong>{euNow}</strong> attacks on crypto
            holders have become known so far in {latestYear}, against{" "}
            <strong>{euBefore}</strong> in all of {latestYear - 1}.
          </>
        ) : (
          <>
            Anbieter, Steuertools und Behörden haben solche Daten schon
            verloren, zusammengezählt über rund <strong>{people}</strong>{" "}
            Menschen. In der EU wurden {latestYear} bisher{" "}
            <strong>{euNow}</strong> Angriffe auf Krypto-Besitzer bekannt, im
            ganzen Jahr {latestYear - 1} waren es <strong>{euBefore}</strong>.
          </>
        )}
      </p>
      <div class="proof-map">
        <AttackMapPreview language={language} />
      </div>
    </section>

    <section id="gruende" aria-labelledby="gruende-heading">
      <h2 id="gruende-heading">
        {en ? "This is about more than tax." : "Es geht um mehr als Steuern."}
      </h2>
      <ul class="reasons">
        {reasons.map((reason) => (
          <li>
            <a
              class="reason"
              href={`${pathFor("arguments", language)}#${reason.anchor}`}
            >
              <span class="reason-icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  {reason.icon === "key" && (
                    <>
                      <circle cx="7.5" cy="16.5" r="3.5" />
                      <path d="m10 14 9.5-9.5M16.5 7.5 19 10M14 10l1.5 1.5" />
                    </>
                  )}
                  {reason.icon === "link" && (
                    <path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" />
                  )}
                  {reason.icon === "people" && (
                    <>
                      <circle cx="9" cy="8.5" r="3.5" />
                      <path d="M3 20a6 6 0 0 1 12 0M15.5 5a3.5 3.5 0 0 1 0 7M21 20a6 6 0 0 0-3.5-5.5" />
                    </>
                  )}
                </svg>
              </span>
              <h3>{reason.title}</h3>
              <p>{reason.text}</p>
            </a>
          </li>
        ))}
      </ul>
      <a class="text-link" href={pathFor("arguments", language)}
        >{en ? "All our reasons" : "Alle Gründe"}</a
      >
    </section>

    <section id="stufen" aria-labelledby="stufen-heading">
      <h2 id="stufen-heading">
        {en ? "First interest, then accounts." : "Erst Zinsen, dann Konten."}
        <span>{en ? "Now crypto." : "Jetzt Krypto."}</span>
      </h2>
      <p class="section-intro">
        {en
          ? "What the tax office learns automatically about private individuals has grown since 2005. Crypto-asset providers now report their domestic customers too, and the next expansion is already proposed."
          : "Was das Finanzamt automatisch über Privatpersonen erfährt, wird seit 2005 immer mehr. Krypto-Anbieter melden jetzt auch Kunden im Inland, und die nächste Erweiterung ist schon vorgeschlagen."}
      </p>
      <HistoryStack language={language} compact />
      <a class="text-link" href={pathFor("history", language)}
        >{en ? "How it grew since 1977" : "Wie es seit 1977 gewachsen ist"}</a
      >
    </section>

    <section
      id="beschwerde"
      class="band complaint"
      aria-labelledby="beschwerde-heading"
    >
      <div class="complaint-text">
        <h2 id="beschwerde-heading">
          {en ? "The complaint is with the Data Protection Authority." : "Die Beschwerde liegt bei der Datenschutzbehörde."}
        </h2>
        <p class="section-intro">
          {en ? "We believe that collecting data on every customer without suspicion violates fundamental rights. Our aim is to have that settled, all the way to the Court of Justice of the European Union." : "Wir halten die Erfassung aller Kunden ohne Verdacht für grundrechtswidrig. Unser Ziel ist eine Klärung bis vor den Europäischen Gerichtshof."}
        </p>
      </div>
      <dl
        class="complaint-facts"
        aria-label={en ? "The complaint" : "Die Beschwerde"}
      >
        <div>
          <dt>{en ? "Filed" : "Eingebracht"}</dt>
          <dd>{en ? "October 2026" : "im Oktober 2026"}</dd>
        </div>
        <div>
          <dt>{en ? "By" : "Von"}</dt>
          <dd>
            {en ? "Dr Oliver Völkel, LL.M., attorney at CERHA HEMPEL, as a customer of a provider" : "Rechtsanwalt Dr. Oliver Völkel, LL.M. (CERHA HEMPEL), als Kunde eines Anbieters"}
          </dd>
        </div>
        <div>
          <dt>Initiative</dt>
          <dd>
            {en ? "Bitcoin Austria, nonprofit association from Vienna, founded 2011" : "Bitcoin Austria, gemeinnütziger Verein aus Wien, gegründet 2011"}
          </dd>
        </div>
      </dl>
      <div class="complaint-route">
        <LegalRoute language={language} />
      </div>
      <a class="text-link" href={pathFor("proceedings", language)}
        >{en ? "Where the case stands" : "Stand des Verfahrens"}</a
      >
    </section>
  </article>
</Layout>

<style>
  /* Erster Schirm: links die Aussage, rechts gleich die Frage, ob sie dich
     betrifft. Schmal folgt die Frage dem Vorspann. */
  @container campaign (width >= 60rem) {
    .landing .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }
  }

  .landing .hero-text {
    padding-block-start: var(--space-xs);
  }

  /* Beleg: Aussage und Zahlen links, die Karte als einziges Bild rechts.
     Die Karte selbst führt zur Karte. Schmal folgt sie dem Vorspann. */
  .proof-map {
    margin-block-start: var(--space-l);
  }

  @container campaign (width >= 52rem) {
    .proof {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: 1fr auto auto 1fr;
      column-gap: var(--space-2xl);
    }

    .proof > h2 {
      grid-area: 2 / 1;
    }

    .proof > .section-intro {
      grid-area: 3 / 1;
    }

    .proof-map {
      grid-area: 1 / 2 / 5 / 3;
      margin-block-start: 0;
    }
  }

  /* Drei Gründe als Karten: Zeichen, Titel, ein Satz. Breit stehen sie in
     einer Reihe, das Zeichen über dem Titel; schmal untereinander. Jede
     Karte führt zu ihrem Grund auf /argumente/. */
  .reasons {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .reasons li {
    display: grid;
  }

  .reason {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    gap: var(--space-2xs) var(--space-m);
    padding: var(--space-m-l);
    padding-inline-end: calc(var(--space-m-l) + 1.5rem);
    border-radius: var(--radius-xl);
    color: inherit;
    background: var(--panel);
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .reason:hover {
    color: inherit;
    background: var(--panel-strong);
  }

  .reason:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  /* Der Pfeil zeigt, dass die Karte weiterführt. */
  .reason::after {
    content: "→";
    position: absolute;
    inset-block-start: var(--space-m-l);
    inset-inline-end: var(--space-m-l);
    color: var(--accent);
    font-weight: var(--weight-strong);
    transition: translate 160ms ease;
  }

  .reason:hover::after {
    translate: 0.2em 0;
  }

  .reason-icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: var(--radius-lg);
    color: var(--ink);
    background: var(--paper);
  }

  .reason-icon svg {
    inline-size: 2rem;
    block-size: 2rem;
  }

  .reason h3 {
    align-self: end;
    max-inline-size: none;
  }

  .reason p {
    max-inline-size: 46ch;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @container campaign (width >= 56rem) {
    .reasons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .reason {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }

    .reason-icon {
      grid-row: auto;
      margin-block-end: var(--space-xs);
    }

    .reason h3 {
      align-self: start;
    }
  }

  @container campaign (width < 30rem) {
    .reason {
      grid-template-columns: minmax(0, 1fr);
    }

    .reason-icon {
      grid-row: auto;
      inline-size: 3.25rem;
      block-size: 3.25rem;
      margin-block-end: var(--space-3xs);
    }

    .reason-icon svg {
      inline-size: 1.625rem;
      block-size: 1.625rem;
    }
  }

  /* Die Beschwerde schließt die Seite ab und bekommt deshalb mehr Luft als
     die anderen Bänder. Von oben nach unten: Aussage und Ziel, die
     Eckdaten in einer Zeile, der Rechtsweg über die ganze Breite und der
     Weg zum Stand des Verfahrens. */
  :global(.campaign) > section.complaint {
    display: grid;
    gap: var(--space-xl);
    padding-block: calc(var(--band-gap) * 0.95);
  }

  .complaint-text {
    max-inline-size: 48rem;
  }

  .complaint-facts {
    display: grid;
    gap: var(--space-m) var(--space-xl);
    padding: var(--space-m-l) var(--space-l);
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  .complaint-facts dt {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .complaint-facts dd {
    margin-block-start: var(--space-3xs);
    font-weight: 560;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .complaint-route {
    padding-block-start: var(--space-s);
  }

  .complaint-route :global(.route) {
    margin-block-start: 0;
  }

  .complaint .text-link {
    justify-self: start;
  }

  /* Waagrecht hat der Rechtsweg unten eigenen Weißraum; der Link rückt
     näher heran. */
  @container campaign (width >= 46rem) {
    .complaint .text-link {
      margin-block-start: calc(var(--space-s) - var(--space-xl));
    }
  }

  @container campaign (width >= 52rem) {
    .complaint-facts {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr) minmax(0, 1.2fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reason,
    .reason::after {
      transition: none;
    }
  }
</style>
