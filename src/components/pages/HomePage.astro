---
import AffectedCheck from "@/components/AffectedCheck.astro"
import AttackMapPreview from "@/components/AttackMapPreview.astro"
import CampaignStatus from "@/components/CampaignStatus.astro"
import DataWeb from "@/components/DataWeb.astro"
import LegalRoute from "@/components/LegalRoute.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { peopleAffected, roundPeople } from "@/data/leaks"
import { countIn, euCountries, latestYear } from "@/lib/attacks"
import { donateFor, languageFor, pathFor, shareKitFor } from "@/lib/i18n"

// The home page tells one story in six bands: the claim and "Am I
// affected?" on the first screen, the data story, the proof that such data
// gets lost and that holders get attacked, four of the seven reasons, who
// filed the complaint, and one ask. Every fact appears here once and in full
// on its own page: the dossier (what is reported), /angriffe/ and
// /datenlecks/ (cases), /argumente/ (reasons), /verfahren/ (the case).
// The German headline keeps "Krypto-Kunden" on one line: a word joiner
// (U+2060) after the hyphen stops the break that balancing would pick.
const language = languageFor(Astro.url.pathname)
const en = language === "en"

// The proof band counts from the same data as the leak page and the map.
const people = roundPeople(peopleAffected, language)
const euNow = countIn(latestYear, euCountries)
const euBefore = countIn(latestYear - 1, euCountries)

// Four of the seven reasons on /argumente/, the ones the story above does
// not already tell: the cash comparison opens the page, the growing file
// and the target list are the data story, presumed wealth is the proof
// band. Icons follow src/assets/icons: 24 px grid, 1.7 stroke, round ends.
const reasons = [
  {
    icon: "key",
    title: en ? "We defend self-custody." : "Wir verteidigen Selbstverwahrung.",
    text: en
      ? "Holding bitcoin with your own keys is as legitimate as cash at home."
      : "Bitcoin mit eigenen Schlüsseln zu halten ist so legitim wie Bargeld daheim.",
  },
  {
    icon: "link",
    title: en
      ? "Pseudonymous is not anonymous."
      : "Pseudonym ist nicht anonym.",
    text: en
      ? "A data leak can tie your name to your wallet addresses, and with them to your past payments."
      : "Ein Datenleck kann deinen Namen mit deinen Wallet-Adressen verbinden und damit mit früheren Zahlungen.",
  },
  {
    icon: "people",
    title: en ? "Privacy concerns everyone." : "Privatsphäre betrifft alle.",
    text: en
      ? "Even small payments show whom you donate to and whom you support."
      : "Auch kleine Zahlungen zeigen, wem du spendest und wen du unterstützt.",
  },
  {
    icon: "eye",
    title: en ? "Surveillance needs limits." : "Überwachung braucht Grenzen.",
    text: en
      ? "Under the directive, the data may also be used for customs, against money laundering and for sanctions."
      : "Laut Richtlinie dürfen die Daten auch für Zoll, gegen Geldwäsche und für Sanktionen genutzt werden.",
  },
]

const actions = [
  {
    title: en ? "Help fund the case" : "Das Verfahren mittragen",
    text: en
      ? "Your donation helps pay for it."
      : "Deine Spende hilft, es zu finanzieren.",
    href: donateFor(language),
    label: en ? "Donate" : "Spenden",
    primary: true,
  },
  {
    title: en ? "Write to MPs" : "Abgeordnete anschreiben",
    text: en
      ? "A letter to Austria’s National Council, drafted in your browser."
      : "Ein Brief an den österreichischen Nationalrat, vorbereitet in deinem Browser.",
    href: `${pathFor("participate", language)}#abgeordnete`,
    label: en ? "Write a letter" : "Brief schreiben",
  },
  {
    title: en ? "Share the campaign" : "Die Kampagne teilen",
    text: en
      ? "Graphics for posts and stories."
      : "Grafiken für Beiträge und Stories.",
    href: shareKitFor(language),
    label: en ? "See the graphics" : "Grafiken ansehen",
  },
]
---

<Layout>
  <MetaPage slot="head" />

  <article class="campaign landing">
    <header class="hero">
      <div class="hero-text">
        <CampaignStatus language={language} />
        <h1>
          {en ? "DAC8 opens a file on every crypto customer." : "DAC8 legt über jeden Krypto-\u2060Kunden eine Akte an."}
          <span>{en ? "We are fighting back." : "Wir gehen dagegen vor."}</span>
        </h1>
        <p class="lead">
          {en ? "Imagine your bank telling the tax office every year how much cash you withdrew. For bitcoin and other crypto-assets, that has been the rule since 2026, without suspicion. DAC8 is an EU directive and applies in Austria, Germany and across the EU." : "Stell dir vor, deine Bank meldet dem Finanzamt jedes Jahr, wie viel Bargeld du abgehoben hast. Bei Bitcoin und anderen Kryptowerten ist das seit 2026 Pflicht, ohne Verdacht. DAC8 ist eine EU-Richtlinie und gilt in Österreich, Deutschland und der ganzen EU."}
        </p>
      </div>
      <AffectedCheck language={language} />
    </header>

    <section id="problem" aria-labelledby="problem-heading">
      <h2 id="problem-heading">
        {en ? "What happens to your data" : "Was mit deinen Daten passiert"}
      </h2>
      <DataWeb language={language} />
    </section>

    <section id="gefahr" class="proof" aria-labelledby="gefahr-heading">
      <h2 id="gefahr-heading">
        {en ? "The danger begins when people know who holds how much." : "Gefährlich wird es, wenn bekannt ist, wer wie viel hat."}
      </h2>
      <p class="section-intro">
        {en ? (
          <>
            Exchanges, tax tools and authorities have already lost such data,
            on about <strong>{people}</strong> people across the documented
            cases. In the EU, <strong>{euNow}</strong> attacks on crypto
            holders have become known so far in {latestYear}, against{" "}
            <strong>{euBefore}</strong> in all of {latestYear - 1}.
          </>
        ) : (
          <>
            Anbieter, Steuertools und Behörden haben solche Daten schon
            verloren, zusammengezählt über rund <strong>{people}</strong>{" "}
            Menschen. In der EU wurden {latestYear} bisher{" "}
            <strong>{euNow}</strong> Angriffe auf Krypto-Besitzer bekannt, im
            ganzen Jahr {latestYear - 1} waren es <strong>{euBefore}</strong>.
          </>
        )}
      </p>
      <div class="proof-map">
        <AttackMapPreview language={language} />
      </div>
      <a class="text-link" href={pathFor("attacks", language)}
        >{en ? "Open the map" : "Zur Karte"}</a
      >
    </section>

    <section id="gruende" class="band" aria-labelledby="gruende-heading">
      <h2 id="gruende-heading">
        {en ? "This is about more than tax." : "Es geht um mehr als Steuern."}
      </h2>
      <ul class="reasons">
        {reasons.map((reason) => (
          <li>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              {reason.icon === "key" && (
                <>
                  <circle cx="7.5" cy="16.5" r="3.5" />
                  <path d="m10 14 9.5-9.5M16.5 7.5 19 10M14 10l1.5 1.5" />
                </>
              )}
              {reason.icon === "link" && (
                <path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" />
              )}
              {reason.icon === "people" && (
                <>
                  <circle cx="9" cy="8.5" r="3.5" />
                  <path d="M3 20a6 6 0 0 1 12 0M15.5 5a3.5 3.5 0 0 1 0 7M21 20a6 6 0 0 0-3.5-5.5" />
                </>
              )}
              {reason.icon === "eye" && (
                <>
                  <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
                  <circle cx="12" cy="12" r="3" />
                </>
              )}
            </svg>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </li>
        ))}
      </ul>
      <a class="text-link" href={pathFor("arguments", language)}
        >{en ? "All seven reasons" : "Alle sieben Gründe"}</a
      >
    </section>

    <section id="beschwerde" aria-labelledby="beschwerde-heading">
      <h2 id="beschwerde-heading">
        {en ? "The complaint is with the Data Protection Authority." : "Die Beschwerde liegt bei der Datenschutzbehörde."}
      </h2>
      <p class="section-intro">
        {en ? "Lawyer Dr Oliver Völkel, LL.M. (CERHA HEMPEL) filed it as a customer of a provider, at the initiative of Bitcoin Austria, the nonprofit Bitcoin association founded in Vienna in 2011. We believe that collecting data on every customer without suspicion violates fundamental rights, and we want that settled, all the way to the Court of Justice of the European Union." : "Rechtsanwalt Dr. Oliver Völkel, LL.M. (CERHA HEMPEL) hat sie als Kunde eines Anbieters eingebracht, auf Initiative von Bitcoin Austria, dem gemeinnützigen Wiener Bitcoin-Verein, gegründet 2011. Wir halten die Erfassung aller Kunden ohne Verdacht für grundrechtswidrig und wollen das bis vor den Europäischen Gerichtshof klären lassen."}
      </p>
      <LegalRoute language={language} />
      <a class="text-link" href={pathFor("proceedings", language)}
        >{en ? "Where the case stands" : "Stand des Verfahrens"}</a
      >
    </section>

    <section
      id="mitmachen"
      class="peak"
      aria-labelledby="mitmachen-heading"
      data-action-end
    >
      <h2 id="mitmachen-heading">
        {en ? "Financial privacy is a fundamental right." : "Finanzielle Privatsphäre ist ein Grundrecht."}
        <span>{en ? "Bitcoin included." : "Auch bei Bitcoin."}</span>
      </h2>
      <ul class="peak-actions">
        {actions.map((action) => (
          <li>
            <h3>{action.title}</h3>
            <p>{action.text}</p>
            <a
              class:list={["button", { primary: action.primary }]}
              href={action.href}>{action.label}</a
            >
          </li>
        ))}
      </ul>
    </section>
  </article>
</Layout>

<style>
  /* Erster Schirm: links die Aussage, rechts gleich die Frage, ob sie dich
     betrifft. Schmal folgt die Frage dem Vorspann. */
  @container campaign (width >= 60rem) {
    .landing .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }
  }

  .landing .hero-text {
    padding-block-start: var(--space-xs);
  }

  /* Beleg: Aussage und Zahlen links, die Karte als einziges Bild rechts.
     Schmal folgt die Karte dem Vorspann, der Link steht am Schluss. */
  .proof-map {
    margin-block-start: var(--space-l);
  }

  @container campaign (width >= 52rem) {
    .proof {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: 1fr auto auto auto 1fr;
      column-gap: var(--space-2xl);
    }

    .proof > h2 {
      grid-area: 2 / 1;
    }

    .proof > .section-intro {
      grid-area: 3 / 1;
    }

    .proof > .text-link {
      grid-area: 4 / 1;
    }

    .proof-map {
      grid-area: 1 / 2 / 6 / 3;
      margin-block-start: 0;
    }
  }

  /* Vier Gründe zum Überfliegen: Zeichen, Titel, ein Satz. Schmal steht
     das Zeichen links neben Titel und Satz, breit darüber. */
  .reasons {
    display: grid;
    gap: var(--space-l) var(--space-xl);
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .reasons li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    gap: var(--space-3xs) var(--space-s);
  }

  .reasons svg {
    grid-row: span 2;
    inline-size: 3rem;
    block-size: 3rem;
    padding: 0.7rem;
    border-radius: var(--radius-lg);
    color: var(--ink);
    background: var(--paper);
  }

  .reasons h3 {
    align-self: center;
    font-size: var(--type-lead);
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .reasons p {
    max-inline-size: 40ch;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @container campaign (width >= 40rem) {
    .reasons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container campaign (width >= 64rem) {
    .reasons {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .reasons li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xs);
    }

    .reasons svg {
      grid-row: auto;
      margin-block-end: var(--space-3xs);
    }

    .reasons h3 {
      align-self: start;
    }
  }
</style>
