---
import CaseList from "@/components/CaseList.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import {
  asCase,
  fields,
  holders,
  newestLeaksFirst,
  peopleAffected,
  roundPeople,
} from "@/data/leaks"
import { languageFor, pathFor } from "@/lib/i18n"

// Every documented leak, newest first. The dossier shows a few of them; this
// page grows with the collection. A search and two filters narrow it by who
// lost the data and what was lost, the two questions that matter for DAC8:
// the data sits at the provider and, as reports, with the tax authority.
// Without JavaScript the full list shows and the filters stay hidden.
const language = languageFor(Astro.url.pathname)
const en = language === "en"

const total = newestLeaksFirst.length
const countBy = (key: "holders" | "lost", id: string) =>
  newestLeaksFirst.filter((leak) => (leak[key] as string[]).includes(id)).length
const labelFor = (id: string) =>
  fields.find((field) => field.id === id)?.label[language] ?? id
const items = newestLeaksFirst.map((leak) => ({
  ...asCase(leak, language),
  // The data story on the home page links its cases here.
  id: `fall-${leak.id}`,
  dateline: [leak.name[language], leak.kind[language], leak.year]
    .filter(Boolean)
    .join(" · "),
  tags: leak.lost.map(labelFor),
  data: { holder: leak.holders.join(" "), lost: leak.lost.join(" ") },
}))

const strings = en
  ? {
      all: `${total} cases`,
      some: "{shown} of {total} cases",
      none: "No case matches these filters.",
    }
  : {
      all: `${total} Fälle`,
      some: "{shown} von {total} Fällen",
      none: "Kein Fall passt zu diesen Filtern.",
    }
---

<Layout>
  <MetaPage slot="head" />

  <article class="campaign leaks">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "When data on holdings gets lost." : "Wenn Daten über Vermögen verloren gehen."}
          <span>{en ? "Documented cases." : "Belegte Fälle."}</span>
        </h1>
        <p class="lead">
          {en
              ? "What companies, authorities and their service providers store about people gets lost again and again: through hackers, bribed staff, careless contractors or officials looking where they should not. Bitcoin works like cash, so nobody should know who holds how much. DAC8 adds tax data to what every provider already keeps, and its reports go to the tax authority."
              : "Was Unternehmen, Behörden und ihre Dienstleister über Menschen speichern, geht immer wieder verloren: durch Hacker, bestochene Mitarbeiter, nachlässige Auftragnehmer oder Beamte, die nachsehen, wo sie nicht sollen. Bitcoin funktioniert wie Bargeld, darum sollte niemand wissen, wer wie viel besitzt. DAC8 legt zu dem, was jeder Anbieter ohnehin aufbewahrt, Steuerdaten dazu, und die Meldungen gehen an das Finanzamt."}
        </p>
        <p class="figure-line">
          {en ? (
            <>
              Together, <strong>
                about {roundPeople(peopleAffected, "en")} people affected
              </strong>{" "}
              in {total} documented cases, {countBy("holders", "authority")} of
              them at authorities and {countBy("holders", "vendor")} through
              service providers.
            </>
          ) : (
            <>
              Zusammengezählt{" "}
              <strong>
                rund {roundPeople(peopleAffected, "de")} Betroffene
              </strong>{" "}
              in {total} belegten Fällen, davon {countBy("holders", "authority")}{" "}
              bei Behörden und {countBy("holders", "vendor")} über Dienstleister.
            </>
          )}
        </p>
        <p class="hero-note">
          {en
              ? "Only cases with a primary source: the company’s or authority’s own notice, a court, a prosecutor, a regulator or a parliament. Where no court has ruled, we say so. The list is incomplete, and the cases do not show that DAC8 caused them. The number of people affected adds up the cases that name one, so someone in two cases counts twice."
              : "Nur Fälle mit Primärquelle: die Mitteilung des Unternehmens oder der Behörde selbst, ein Gericht, eine Staatsanwaltschaft, eine Aufsichtsbehörde oder ein Parlament. Wo noch kein Urteil vorliegt, steht das dabei. Die Liste ist unvollständig, und die Fälle belegen nicht, dass DAC8 sie verursacht hat. Die Zahl der Betroffenen zählt die Fälle zusammen, die eine nennen; wer in zwei Fällen steckt, zählt doppelt."}
        </p>
      </div>
    </header>

    <section id="faelle" aria-labelledby="faelle-heading" data-leaks>
      <h2 id="faelle-heading">
        {en ? "All cases, newest first" : "Alle Fälle, die neuesten zuerst"}
      </h2>

      <div
        class="leak-filters"
        role="search"
        aria-label={en ? "Filter cases" : "Fälle filtern"}
        data-filters
        data-strings={JSON.stringify(strings)}
        hidden
      >
        <label class="field leak-search">
          <span>{en ? "Search" : "Suchen"}</span>
          <input
            type="search"
            name="q"
            placeholder={en ? "e.g. Coinbase, tax office" : "z. B. Coinbase, Steuerbehörde"}
            autocomplete="off"
            data-query
          >
        </label>
        <label class="field">
          <span>{en ? "Lost by" : "Verloren bei"}</span>
          <select name="holder" data-holder>
            <option value="">{en ? "All" : "Alle"}</option>
            {holders.map((holder) => (
                <option value={holder.id}>
                  {holder.label[language]} ({countBy("holders", holder.id)})
                </option>
              ))}
          </select>
        </label>
        <label class="field">
          <span>{en ? "Data lost" : "Verlorene Daten"}</span>
          <select name="lost" data-lost>
            <option value="">{en ? "Any" : "Alle"}</option>
            {fields.map((field) => (
                <option value={field.id}>
                  {field.label[language]} ({countBy("lost", field.id)})
                </option>
              ))}
          </select>
        </label>
      </div>
      <p class="leak-status" data-status hidden>
        <span aria-live="polite" data-count>{strings.all}</span>
        <button type="button" class="leak-reset" data-reset hidden>
          {en ? "Clear filters" : "Filter zurücksetzen"}
        </button>
      </p>

      <CaseList items={items} language={language} />

      <a class="text-link" href={`${pathFor("dossier", language)}#angriffe`}
        >{en ? "From data leak to front door" : "Vom Datenleck zur Wohnungstür"}</a
      >
    </section>
  </article>
</Layout>

<script>
  // Search and two filters that combine: who lost the data and what was
  // lost. Search matches anywhere in a case, ignoring case and accents.
  const fold = (text: string) =>
    text.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase()

  for (const root of document.querySelectorAll<HTMLElement>("[data-leaks]")) {
    const bar = root.querySelector<HTMLElement>("[data-filters]")
    const status = root.querySelector<HTMLElement>("[data-status]")
    const count = root.querySelector<HTMLElement>("[data-count]")
    const reset = root.querySelector<HTMLButtonElement>("[data-reset]")
    const query = root.querySelector<HTMLInputElement>("[data-query]")
    const holder = root.querySelector<HTMLSelectElement>("[data-holder]")
    const lost = root.querySelector<HTMLSelectElement>("[data-lost]")
    if (!bar || !status || !count || !reset || !query || !holder || !lost)
      continue
    const strings = JSON.parse(bar.dataset.strings ?? "{}")
    const cases = [
      ...root.querySelectorAll<HTMLElement>(".cases > li[data-holder]"),
    ].map((item) => ({ item, text: fold(item.textContent ?? "") }))

    const has = (list: string | undefined, value: string) =>
      !value || (list ?? "").split(" ").includes(value)

    const render = () => {
      const words = fold(query.value).split(/\s+/).filter(Boolean)
      let shown = 0
      for (const { item, text } of cases) {
        const visible =
          has(item.dataset.holder, holder.value) &&
          has(item.dataset.lost, lost.value) &&
          words.every((word) => text.includes(word))
        item.hidden = !visible
        if (visible) shown++
      }
      const filtered = Boolean(words.length || holder.value || lost.value)
      count.textContent = !filtered
        ? strings.all
        : shown === 0
          ? strings.none
          : strings.some
              .replace("{shown}", String(shown))
              .replace("{total}", String(cases.length))
      reset.hidden = !filtered
    }

    query.addEventListener("input", render)
    holder.addEventListener("change", render)
    lost.addEventListener("change", render)
    reset.addEventListener("click", () => {
      query.value = ""
      holder.value = ""
      lost.value = ""
      render()
      query.focus()
    })
    // Browsers may restore form values on back navigation.
    render()
    bar.hidden = false
    status.hidden = false
  }
</script>

<style>
  /* Die übliche Filterleiste über einer Liste: Suche, zwei Auswahlen, darunter
     die Trefferzahl. Schmal steht die Suche über den beiden Auswahlen. */
  .leak-filters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }

  .leak-search {
    grid-column: 1 / -1;
  }

  .leak-filters[hidden],
  .leak-status[hidden],
  .leak-reset[hidden] {
    display: none;
  }

  .leak-filters :is(input, select) {
    block-size: 3rem;
  }

  @container campaign (width >= 46rem) {
    .leak-filters {
      grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    }

    .leak-search {
      grid-column: auto;
    }
  }

  .leak-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
    margin-block-start: var(--space-s);
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .leak-reset {
    padding: 0;
    border: 0;
    color: var(--ink-2);
    background: none;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .leak-reset:hover {
    color: var(--ink);
  }

  .leak-reset:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .leaks .cases {
    margin-block-start: var(--space-l);
  }

  /* A case opened from the home page's data story lands below the bars
     and is marked for a moment. */
  .leaks .cases > :global(li) {
    scroll-margin-block-start: calc(var(--header-height) + var(--space-m));
  }

  .leaks .cases > :global(li:target) {
    animation: case-target 2.4s ease-out 1;
  }

  @keyframes case-target {
    from {
      box-shadow: -0.75rem 0 0 -0.5rem var(--accent);
    }

    to {
      box-shadow: -0.75rem 0 0 -0.5rem transparent;
    }
  }

  .leaks .text-link {
    margin-block-start: var(--space-2xl);
  }
</style>
