---
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import { campaignStatus } from "@/data/campaign"
import { publishedUpdates } from "@/data/updates"
import { campaign, feedFor, languageFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const status = campaignStatus[language]
const entries = publishedUpdates()
---

<Layout>
  <MetaPage
    slot="head"
    title={en ? "Campaign updates" : "Aktuelles zum Verfahren"}
    description={en ? "The status of Bitcoin Austria’s DAC8 case and updates via RSS." : "Der Stand unseres Verfahrens gegen DAC8 und Neuigkeiten per RSS."}
  />
  <article class="campaign">
    <header class="hero">
      <h1>
        {en ? "Follow " : "Verfolge "}
        <span>{en ? "the case." : "das Verfahren."}</span>
      </h1>
      <p class="lead">
        {en ? "Here we report on filings, decisions and the next steps in our Austrian campaign." : "Hier berichten wir über Einreichungen, Entscheidungen und die nächsten Schritte unserer österreichischen Kampagne."}
      </p>
    </header>
    <section aria-labelledby="status-heading">
      <h2 id="status-heading">{status.label}</h2>
      <p class="section-intro">{status.text}</p>
      <p class="prose">
        {en ? "We will explain how individuals can take part as the proceedings develop." : "Wie sich Privatpersonen beteiligen können, konkretisieren wir im weiteren Verlauf."}
      </p>
    </section>
    {entries.length > 0 && <section aria-labelledby="updates-heading">
      <h2 id="updates-heading">{en ? "Updates" : "Neuigkeiten"}</h2>
      {entries.map(entry => <article id={entry.id} class="campaign-update">
        <time datetime={entry.publishedAt}>{new Intl.DateTimeFormat(en ? "en-GB" : "de-AT", { dateStyle: "long", timeZone: "Europe/Vienna" }).format(new Date(entry.publishedAt))}</time>
        <h3>{entry.translations[language].title}</h3>
        <p class="prose">{entry.translations[language].text}</p>
        {entry.source && <a class="text-link" href={entry.source}>{en ? "Read the document" : "Zum Dokument"}</a>}
      </article>)}
    </section>}
    <section aria-labelledby="subscribe-heading">
      <h2 id="subscribe-heading">
        {en ? "Stay informed" : "Auf dem Laufenden bleiben"}
      </h2>
      <p class="section-intro">
        {en ? "Subscribe to our RSS feed for updates on the case. Add the feed address to your feed reader — no registration needed." : "Abonniere unseren RSS-Feed für Neuigkeiten zum Verfahren. Dafür fügst du die Feed-Adresse in deinen Feedreader ein – ohne Anmeldung."}
      </p>
      <div class="hero-actions">
        <a class="button primary" href={feedFor(language)}
          >{en ? "Open RSS feed" : "RSS-Feed öffnen"}</a
        >
      </div>
      {entries.length === 0 && <p class="prose">{en ? "The feed is ready to subscribe to. The first update will appear when there is news about the case." : "Du kannst den Feed bereits abonnieren. Der erste Beitrag erscheint, sobald es Neuigkeiten zum Verfahren gibt."}</p>}
      <p class="prose">
        {en ? "For broader news from the association, subscribe to the " : "Weitere Neuigkeiten aus dem Verein gibt es im "}<a
          href={campaign.newsletter}
          >{en ? "Bitcoin Austria newsletter" : "Bitcoin-Austria-Newsletter"}</a
        >{en ? " (in German)." : "."}
      </p>
    </section>
  </article>
</Layout>
<style>
  .campaign-update + .campaign-update {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }
  time {
    display: block;
    margin-block-end: var(--space-xs);
    color: var(--muted-foreground);
  }
</style>
