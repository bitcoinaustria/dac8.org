---
import AccessRequestGenerator from "@/components/AccessRequestGenerator.astro"
import Artwork from "@/components/Artwork.astro"
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import { reminderDays } from "@/data/access-request"
import { donateFor, languageFor, pathFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
// Controls marked data-needs-script stay hidden without JavaScript (see the
// noscript style below); the template itself still renders and opens in an
// email. The reminder links to the published page, also from preview builds.
const nextSteps = new URL(
  `${pathFor("access", language)}#danach`,
  Astro.site ?? Astro.url.origin,
)
const share = en
  ? "mailto:kontakt@dac8.org?subject=Reply%20to%20an%20access%20request%20(DAC8)"
  : "mailto:kontakt@dac8.org?subject=Antwort%20auf%20ein%20Auskunftsersuchen%20(DAC8)"
---

<Layout>
  <MetaPage slot="head" />
  <noscript slot="head">
    <style is:inline>
      [data-needs-script] {
        display: none !important;
      }
    </style>
  </noscript>
  <article class="campaign">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "Ask your provider " : "Frag deinen Anbieter, "}
          <span>{en ? "what it holds on you." : "was er über dich weiß."}</span>
        </h1>
        <p class="lead">
          {en ? "It must tell you what data it prepares about you for DAC8, who it passes it to and how long it keeps it." : "Er muss dir sagen, welche Daten er für DAC8 über dich aufbereitet, an wen er sie weitergibt und wie lange er sie speichert."}
        </p>
        <nav
          class="hero-actions"
          aria-label={en ? "Access request" : "Auskunftsanfrage"}
        >
          <a class="button primary" href="#anfrage"
            >{en ? "Create your request" : "Anfrage erstellen"}</a
          >
        </nav>
      </div>
      <Artwork id="linkedIdentity" language={language} size="hero" />
    </header>

    <section id="warum" aria-labelledby="why-heading">
      <h2 id="why-heading">{en ? "Why ask?" : "Warum fragen?"}</h2>
      <ul class="reasons">
        <li>
          <strong>{en ? "It’s your right." : "Das ist dein Recht."}</strong>
          <span
            >{en ? "Article 15 GDPR entitles you to access your data and to receive a copy, free of charge." : "Art. 15 DSGVO gibt dir Anspruch auf Auskunft und eine Kopie deiner Daten, kostenlos."}</span
          >
        </li>
        <li>
          <strong
            >{en ? "The reply shows the practice." : "Die Antwort zeigt die Praxis."}</strong
          >
          <span
            >{en ? "You see how your provider actually processes data for DAC8." : "Du siehst, wie dein Anbieter Daten für DAC8 tatsächlich verarbeitet."}</span
          >
        </li>
        <li>
          <strong
            >{en ? "Five minutes is enough." : "Fünf Minuten genügen."}</strong
          >
          <span
            >{en ? "The request is ready. You add your details and send it yourself." : "Die Anfrage ist vorbereitet. Du ergänzt deine Angaben und schickst sie selbst ab."}</span
          >
        </li>
      </ul>
    </section>

    <section id="anfrage" aria-labelledby="request-heading">
      <h2 id="request-heading">{en ? "Your request" : "Deine Anfrage"}</h2>
      <p class="section-intro" data-needs-script>
        {en ? "Fill in your details; they stay in your browser and only go into the request." : "Trag deine Angaben ein; sie bleiben in deinem Browser und landen nur in der Anfrage."}
      </p>
      <AccessRequestGenerator language={language} />
    </section>

    <section id="danach" aria-labelledby="next-heading">
      <h2 id="next-heading">
        {en ? "What happens next" : "Was danach passiert"}
      </h2>
      <ol class="flow next-steps">
        <li>
          <strong
            >{en ? "A reply within one month" : "Antwort binnen eines Monats"}</strong
          >
          <span
            >{en ? "Your provider must reply within one month. For complex requests it can extend this by two further months, but must tell you within the first month and give reasons (Article 12(3) GDPR)." : "Dein Anbieter muss innerhalb eines Monats antworten. Bei komplexen Anfragen darf er die Frist um zwei weitere Monate verlängern, muss dir das aber im ersten Monat mitteilen und begründen (Art. 12 Abs. 3 DSGVO)."}</span
          >
        </li>
        <li>
          <strong
            >{en ? "No reply, or an incomplete one" : "Keine oder eine unvollständige Antwort"}</strong
          >
          <span>
            {en ? "You can then lodge a complaint with the " : "Dann kannst du dich bei der "}
            <a href="https://www.dsb.gv.at/"
              >{en ? "Austrian Data Protection Authority" : "Datenschutzbehörde"}</a
            >
            {en ? " (Article 77 GDPR)." : " beschweren (Art. 77 DSGVO)."}
          </span>
        </li>
        <li>
          <strong
            >{en ? "Share the reply with us" : "Die Antwort mit uns teilen"}</strong
          >
          <span>
            {en ? "If you like, forward it to " : "Wenn du magst, leite sie mit geschwärzten persönlichen Angaben an "}
            <a href={share}>kontakt@dac8.org</a>
            {en ? " with your personal details blacked out. Replies help us document how providers process data for DAC8." : " weiter. Antworten helfen uns zu dokumentieren, wie Anbieter Daten für DAC8 verarbeiten."}
          </span>
        </li>
      </ol>
      <div class="reminder" data-reminder-scope data-needs-script>
        <button
          class="button"
          type="button"
          data-request-reminder
          data-url={nextSteps.href}
        >
          {en ? "Remind me in a month" : "In einem Monat erinnern"}
        </button>
        <p data-reminder-note>
          {en ? `A calendar entry in ${reminderDays} days. The file is created in your browser.` : `Ein Kalendertermin in ${reminderDays} Tagen. Die Datei entsteht in deinem Browser.`}
        </p>
        <p class="reminder-status" data-reminder-status aria-live="polite"></p>
      </div>
      <div class="link-row">
        <a class="text-link" href={pathFor("file", language)}
          >{en ? "See your DAC8 file" : "Deine DAC8-Akte ansehen"}</a
        >
        <a class="text-link" href={donateFor(language)}
          >{en ? "Donate to the case" : "Für das Verfahren spenden"}</a
        >
      </div>
    </section>
  </article>
</Layout>

<style>
  /* Drei kurze Gründe nebeneinander, oben die gefräste Metallkante wie bei
     den Kennzahlen. */
  .reasons {
    display: grid;
    gap: var(--space-m) var(--space-l);
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .reasons li {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding-block-start: var(--space-s);
    background: var(--metal-rule) top / 100% 2px no-repeat;
  }

  .reasons strong {
    font-size: var(--step-1);
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .reasons span {
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @container campaign (width >= 46rem) {
    .reasons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .next-steps {
    margin-block-start: var(--space-l);
  }

  /* Nummeriert, aber ohne Schiene: Die Schritte sind Möglichkeiten nach der
     Antwort, kein Weg, der von einem zum nächsten führt. */
  .next-steps li:not(:last-child)::after {
    content: none;
  }

  /* Die Erinnerung gehört zur Monatsfrist im ersten Schritt. */
  .reminder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    margin-block-start: var(--space-xl);
  }

  .reminder p {
    max-inline-size: 46ch;
    color: var(--ink-3);
    font-size: var(--step--1);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .reminder .reminder-status {
    flex-basis: 100%;
    min-block-size: 1.5em;
    color: var(--accent);
  }

  @media (width < 36rem) {
    .reminder .button {
      inline-size: 100%;
    }
  }
</style>

<script>
  import { reminderDate, reminderFile } from "@/data/access-request"

  // The reminder is a calendar file built here and downloaded through a
  // Blob URL; nothing is sent. Its title names the provider from the request
  // form on this page.
  const en = document.documentElement.lang.startsWith("en")
  const day = new Intl.DateTimeFormat(en ? "en-GB" : "de-AT", {
    day: "numeric",
    month: "long",
    year: "numeric",
  })
  const time = new Intl.DateTimeFormat(en ? "en-GB" : "de-AT", {
    hour: "numeric",
    minute: "2-digit",
  })
  const uid = () =>
    `${crypto.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`}@dac8.org`

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-request-reminder]",
  )) {
    const scope = button.closest("[data-reminder-scope]")
    const note = scope?.querySelector<HTMLElement>("[data-reminder-note]")
    const status = scope?.querySelector<HTMLElement>("[data-reminder-status]")
    const describe = () => {
      const date = reminderDate(new Date())
      if (note)
        note.textContent = en
          ? `A calendar entry for ${time.format(date)} on ${day.format(date)}. The file is created in your browser.`
          : `Ein Kalendertermin am ${day.format(date)} um ${time.format(date)} Uhr. Die Datei entsteht in deinem Browser.`
    }

    button.addEventListener("click", () => {
      const provider =
        document
          .querySelector<HTMLInputElement>(
            "[data-access-request] [name='provider']",
          )
          ?.value.trim() ?? ""
      const { filename, file } = reminderFile({
        language: en ? "en" : "de",
        provider,
        url: button.dataset.url ?? window.location.href,
        now: new Date(),
        uid: uid(),
      })
      const url = URL.createObjectURL(
        new Blob([file], { type: "text/calendar;charset=utf-8" }),
      )
      const link = document.createElement("a")
      link.href = url
      link.download = filename
      document.body.append(link)
      link.click()
      link.remove()
      setTimeout(() => URL.revokeObjectURL(url), 60_000)
      describe()
      if (status)
        status.textContent = en
          ? "Entry downloaded. Open the file to add it to your calendar."
          : "Termin heruntergeladen. Öffne die Datei, um ihn in deinen Kalender zu übernehmen."
    })
    describe()
  }
</script>
