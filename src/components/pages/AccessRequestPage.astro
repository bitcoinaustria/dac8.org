---
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import { languageFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
---

<Layout>
  <MetaPage slot="head" />
  <article class="campaign">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "Ask your provider" : "Frag deinen Anbieter,"}
          <span>{en ? "what it holds on you." : "was er über dich weiß."}</span>
        </h1>
        <p class="lead">
          {en ? "A GDPR access request about the data it processes for DAC8." : "Eine Auskunftsanfrage nach der DSGVO zu den Daten, die er für DAC8 verarbeitet."}
        </p>
      </div>
    </header>
  </article>
</Layout>
