---
import ShareIcon from "@/assets/icons/share.svg"
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import { languageFor, pathFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
---

<Layout>
  <MetaPage slot="head" />
  <article class="campaign">
    <header class="hero">
      <h1>
        {en ? "Help defend " : "Hilf mit, "}
        <span
          >{en ? "financial privacy." : "Privatsphäre zu verteidigen."}</span
        >
      </h1>
      <p class="lead">
        {en ? "Help us challenge mass surveillance of our finances: fund the case and share the campaign." : "Hilf uns, der Massenüberwachung unserer Finanzen Grenzen zu setzen: Trage den Prozess mit und teile die Kampagne."}
      </p>
      <nav
        class="hero-actions"
        aria-label={en ? "Support the campaign" : "Kampagne unterstützen"}
      >
        <a class="button primary" href={pathFor("donate", language)}
          >{en ? "Support the case" : "Prozess unterstützen"}</a
        >
        <button class="button" type="button" data-share>
          <ShareIcon />
          {en ? "Share" : "Teilen"}
        </button>
      </nav>
      <p class="share-status" data-share-status aria-live="polite"></p>
      <p class="note participation-note">
        <strong
          >{en ? "Taking part in the proceedings: " : "Beteiligung am Verfahren: "}</strong
        >
        {en ? "How individuals can take part has not yet been determined. We will publish the options and requirements as the case develops." : "Wie sich Privatpersonen am Verfahren beteiligen können, steht noch nicht fest. Wir veröffentlichen Möglichkeiten und Voraussetzungen, sobald sie konkret sind."}
        <a href={pathFor("updates", language)}
          >{en ? "Follow the case" : "Verfahren verfolgen"}</a
        >
      </p>
    </header>
    <section aria-labelledby="organisations-heading">
      <h2 id="organisations-heading">
        {en ? "For organisations and experts" : "Für Organisationen und Fachleute"}
      </h2>
      <div class="cards">
        <article id="organisationen">
          <h3>
            {en ? "Support as an organisation" : "Als Organisation unterstützen"}
          </h3>
          <p>
            {en ? "Businesses, associations and other organisations can help fund the proceedings or contribute expertise. Crypto-asset service providers are welcome to support the case too." : "Unternehmen, Verbände und andere Organisationen können das Verfahren finanziell unterstützen oder fachliche Expertise beitragen. Das gilt auch für Krypto-Dienstleister."}
          </p>
          <p>
            {en ? "Supporting the case does not require public recognition. We will agree with you in advance whether and how your support is made public." : "Eine Unterstützung setzt keine öffentliche Nennung voraus. Ob und wie wir eure Beteiligung sichtbar machen, stimmen wir vorab mit euch ab."}
          </p>
          <a class="button primary" href="mailto:kontakt@dac8.org"
            >{en ? "Discuss supporting the case" : "Unterstützung besprechen"}</a
          >
        </article>
        <article>
          <h3>{en ? "Work with us" : "Mit uns zusammenarbeiten"}</h3>
          <p>
            {en ? "This campaign currently focuses on Austria. Organisations and experts who want to challenge DAC8 in other countries are welcome to get in touch." : "Diese Kampagne richtet sich derzeit auf Österreich. Organisationen und Fachleute, die DAC8 in anderen Ländern angehen wollen, können sich bei uns melden."}
          </p>
          <a
            class="button"
            href="mailto:kontakt@dac8.org?subject=Zusammenarbeit%20zu%20DAC8"
            >kontakt@dac8.org</a
          >
        </article>
      </div>
    </section>
  </article>
  <script>
    import { initializeShareButtons } from "@/lib/share"
    initializeShareButtons()
  </script>
</Layout>
