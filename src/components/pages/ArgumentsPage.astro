---
import ArgumentPoints from "@/components/ArgumentPoints.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { demands, objections, reasons } from "@/data/arguments"
import { languageFor, pathFor } from "@/lib/i18n"

// Why we oppose DAC8, in three groups: seven reasons, four objections, five
// demands. Each reason shows a headline and one sentence; the evidence opens
// on demand. The heading of the current group sticks under the site header
// instead of a chapter bar. The dossier holds the facts, the attack map and
// the leak list the proof; this page links to the map once, from the reason
// it supports, and to the letter once, from the demands.
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const list = reasons.map((reason) => ({ ...reason, ...reason[language] }))
---

<Layout>
  <MetaPage slot="head" />

  <article class="campaign arguments">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "Seven reasons against DAC8." : "Sieben Gründe gegen DAC8."}
          <span>{en ? "And what we demand." : "Und was wir fordern."}</span>
        </h1>
        <p class="lead">
          {en
            ? "DAC8 opens a file on every crypto customer, without suspicion and for ten years. Such files get stolen, and they show criminals where there is something to take. At our initiative, a complaint has been filed with the Data Protection Authority."
            : "DAC8 legt über jeden Krypto-Kunden eine Akte an, ohne Verdacht und für zehn Jahre. Solche Akten werden gestohlen und zeigen Kriminellen, bei wem etwas zu holen ist. Auf unsere Initiative ist eine Beschwerde bei der Datenschutzbehörde eingebracht."}
        </p>
        <nav
          class="hero-actions"
          aria-label={en ? "Get started" : "Direkteinstieg"}
        >
          <a class="button primary" href="#forderungen"
            >{en ? "What we demand" : "Was wir fordern"}</a
          >
        </nav>
      </div>
      <nav
        class="reason-index"
        aria-label={en ? "The seven reasons" : "Die sieben Gründe"}
      >
        <ol>
          {list.map((reason, index) => (
            <li>
              <a href={`#${reason.id}`}>
                <span class="numeral" aria-hidden="true">{index + 1}</span>
                {reason.short}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </header>

    <section id="gruende" aria-labelledby="gruende-heading">
      <h2 id="gruende-heading" class="group-head">
        {en ? "Seven reasons" : "Sieben Gründe"}
      </h2>
      <ol class="reasons">
        {list.map((reason, index) => (
          <li id={reason.id}>
            <details>
              <summary>
                <span class="numeral" aria-hidden="true">{index + 1}</span>
                <span class="eyebrow">{reason.short}</span>
                <h3 id={reason.alias}>{reason.title}</h3>
                <span class="reason-text">{reason.text}</span>
                <span class="toggle" aria-hidden="true"></span>
              </summary>
              <div class="proof" id={reason.proofId}>
                {reason.proof.map((paragraph) => <p>{paragraph}</p>)}
                {reason.sources.length > 0 && (
                  <p class="proof-sources">
                    {en ? "Sources: " : "Quellen: "}
                    {reason.sources.map((source, position) => (
                      <>
                        {position > 0 && " · "}
                        <a href={source.href}>{source.label}</a>
                      </>
                    ))}
                  </p>
                )}
              </div>
            </details>
            {reason.attacks && (
              <a class="text-link" href={pathFor("attacks", language)}
                >{en ? "Documented attacks on the map" : "Dokumentierte Angriffe auf der Karte"}</a
              >
            )}
          </li>
        ))}
      </ol>
    </section>

    <section id="einwaende" aria-labelledby="einwaende-heading">
      <h2 id="einwaende-heading" class="group-head">
        {en ? "Four objections" : "Vier Einwände"}
      </h2>
      <ArgumentPoints points={objections[language]} variant="objections" />
    </section>

    <section
      id="forderungen"
      class="band"
      aria-labelledby="forderungen-heading"
    >
      <h2 id="forderungen-heading" class="group-head">
        {en ? "Five demands" : "Fünf Forderungen"}
      </h2>
      <p class="section-intro">
        {en
          ? "The state must justify why it intrudes on your private life, and choose milder means where they suffice: targeted investigations based on specific suspicion instead of stockpiling data on everyone."
          : "Der Staat muss begründen, warum er in dein Privatleben eingreift, und mildere Mittel wählen, wo sie genügen: gezielte Ermittlungen bei konkretem Verdacht statt Daten über alle auf Vorrat."}
      </p>
      <ol class="demands">
        {demands[language].map((demand) => (
          <li>
            <h3>{demand.title}</h3>
            <p>{demand.text}</p>
          </li>
        ))}
      </ol>
      <a
        class="text-link"
        href={`${pathFor("participate", language)}#abgeordnete`}
        >{en ? "Write to your MPs" : "Brief an Abgeordnete schreiben"}</a
      >
    </section>
  </article>
</Layout>

<script>
  // Links to a reason, or to an anchor inside its evidence, open the
  // evidence: press links such as #zielliste and the anchors of the page
  // before October 2026 (#verknuepfung, #zahlungsprofile) land on what they
  // promise.
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1))
    const target = id ? document.getElementById(id) : null
    const details =
      target?.closest("details") ?? target?.querySelector("details")
    if (!target || !details || details.open) return
    details.open = true
    target.scrollIntoView({ block: "start" })
  }
  addEventListener("hashchange", openTarget)
  openTarget()
</script>

<style>
  .arguments {
    --num: 3rem;
    /* Höhe der mitlaufenden Gruppenüberschrift, damit Sprungziele unter
       ihr statt hinter ihr landen. */
    --group-head-height: calc(var(--type-h2) * 1.1 + 2 * var(--space-xs) + 1px);
  }

  /* Ziffern in gefrästem Metall, wie das Jahr des Präzedenzfalls: Sie
     ordnen, die Schlagzeile daneben bleibt der stärkste Text. */
  .numeral {
    inline-size: fit-content;
    background: linear-gradient(
      170deg,
      light-dark(#8e969d, #e3e6e8),
      light-dark(#3c4248, #7d858c)
    );
    background-clip: text;
    color: transparent;
    font-weight: var(--weight-heading);
    font-stretch: 94%;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Hero: Schlagzeile links, die sieben Gründe rechts -------- */

  .reason-index ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reason-index li + li {
    border-block-start: 1px solid var(--line);
  }

  .reason-index a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
    padding-block: var(--space-2xs);
    color: var(--ink);
    font-size: var(--type-body);
    font-weight: var(--weight-strong);
    line-height: 1.35;
    text-decoration: none;
  }

  .reason-index a:hover {
    color: var(--accent);
  }

  .reason-index .numeral {
    font-size: var(--type-lead);
  }

  /* Schmal folgen die Gründe direkt unter dem Vorspann; die Übersicht
     wiederholte sie nur. */
  @container campaign (width < 56rem) {
    .reason-index {
      display: none;
    }
  }

  @container campaign (width >= 56rem) {
    .arguments .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  /* ---------- Mitlaufende Gruppenüberschrift ---------------------------- */

  /* Die Überschrift der Gruppe, in der man gerade liest, bleibt unter der
     Kopfleiste stehen und ersetzt die Kapitelleiste. Ihre Fläche reicht wie
     die Bänder bis an den Rand. */
  .arguments .group-head {
    position: sticky;
    z-index: 2;
    inset-block-start: calc(var(--header-height) + 1px);
    max-inline-size: none;
    padding-block: var(--space-xs);
    background:
      linear-gradient(var(--line) 0 0) bottom / 100% 1px no-repeat,
      var(--band-fill, var(--background));
    box-shadow: 0 0 0 100vmax var(--band-fill, var(--background));
    clip-path: inset(0 -100vmax);
  }

  /* ---------- Gründe: Schlagzeile und ein Satz, Belege aufklappbar ------- */

  /* Jeder Grund trägt seinen Namen als Zeile über der Schlagzeile, wortgleich
     mit der Übersicht im Hero. Schmal stehen Ziffer und Name in einer Zeile
     über der Schlagzeile, damit Schlagzeile und Satz die ganze Breite
     haben. */
  .reasons {
    --cols: auto minmax(0, 1fr) 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reasons > li {
    display: grid;
    grid-template-columns: var(--cols);
    column-gap: var(--space-s);
    border-block-end: 1px solid var(--line);
    scroll-margin-block-start: var(--group-head-height);
  }

  .reasons details {
    grid-column: 1 / -1;
  }

  .reasons summary {
    display: grid;
    grid-template-columns: var(--cols);
    grid-template-areas:
      "num eyebrow toggle"
      "title title title"
      "text text text";
    gap: var(--space-2xs) var(--space-s);
    padding-block: var(--space-m);
    cursor: pointer;
    list-style: none;
  }

  .reasons summary::-webkit-details-marker {
    display: none;
  }

  .reasons summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  .reasons summary .numeral {
    grid-area: num;
    align-self: center;
    font-size: var(--type-h2);
  }

  .eyebrow {
    grid-area: eyebrow;
    align-self: center;
    color: var(--ink-2);
    font-size: var(--type-meta);
    font-weight: var(--weight-strong);
    line-height: 1.35;
  }

  .reasons h3 {
    grid-area: title;
    scroll-margin-block-start: calc(var(--group-head-height) + var(--space-m));
  }

  .reason-text {
    grid-area: text;
    max-inline-size: var(--measure-lead);
    color: var(--ink-2);
    font-size: var(--type-lead);
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* Ein runder Knopf mit Winkel, der beim Öffnen kippt. */
  .toggle {
    grid-area: toggle;
    display: grid;
    place-items: center;
    justify-self: end;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    color: var(--ink-3);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .toggle::before {
    content: "";
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    translate: 0 -0.12rem;
    rotate: 45deg;
    transition:
      rotate 0.15s ease,
      translate 0.15s ease;
  }

  details[open] > summary .toggle::before {
    translate: 0 0.12rem;
    rotate: -135deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle,
    .toggle::before {
      transition: none;
    }
  }

  summary:hover .toggle,
  details[open] > summary .toggle {
    color: var(--ink);
    background: var(--panel);
  }

  .proof {
    display: grid;
    grid-template-columns: var(--cols);
    column-gap: var(--space-s);
    row-gap: var(--space-xs);
    padding-block-end: var(--space-m);
    scroll-margin-block-start: var(--group-head-height);
  }

  .proof > p {
    grid-column: 1 / -1;
    max-inline-size: var(--measure-text);
    color: var(--ink-2);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .proof > .proof-sources {
    color: var(--ink-3);
    font-size: var(--type-meta);
    line-height: 1.5;
  }

  .proof-sources a {
    color: inherit;
  }

  .reasons > li > .text-link {
    grid-column: 1 / -1;
    margin-block: calc(-1 * var(--space-xs)) var(--space-m);
  }

  /* Breit stehen Schlagzeile und Satz nebeneinander: Wer nur die linke
     Spalte liest, hat die sieben Gründe. Die Belege öffnen unter dem Satz. */
  @container campaign (width >= 52rem) {
    .reasons {
      --cols: var(--num) minmax(0, 5fr) minmax(0, 6fr) 2.5rem;
    }

    .arguments .reasons > li,
    .arguments .proof,
    .reasons summary {
      column-gap: var(--space-l);
    }

    .reasons summary {
      grid-template-areas:
        "num eyebrow . ."
        "num title text toggle";
      grid-template-rows: auto 1fr;
    }

    .eyebrow {
      align-self: end;
    }

    .reasons summary .numeral {
      align-self: start;
      margin-block-start: -0.06em;
    }

    .proof > p,
    .reasons > li > .text-link {
      grid-column: 3;
    }
  }

  /* ---------- Einwände -------------------------------------------------- */

  #einwaende :global(.objections) {
    margin-block-start: var(--space-l);
  }

  /* ---------- Forderungen ----------------------------------------------- */

  /* Nummern als Token wie die Stationen des Rechtswegs, damit sie sich von
     den Ziffern der Gründe abheben. */
  .demands {
    display: grid;
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
    counter-reset: demand;
  }

  .demands li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-s);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--line);
    counter-increment: demand;
  }

  .demands li::before {
    content: counter(demand);
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: 1px solid var(--material-edge);
    border-radius: var(--radius-full);
    color: #f7f8f9;
    background: linear-gradient(155deg, #4b5056, #25282d);
    box-shadow:
      inset 0 1px 0 #ffffff38,
      inset 0 -1px 0 #00000035,
      0 1px 2px var(--material-shade);
    font-size: var(--type-meta);
    font-weight: var(--weight-heading);
    line-height: 1;
  }

  .demands h3 {
    grid-column: 2;
  }

  .demands p {
    grid-column: 2;
    max-inline-size: var(--measure-text);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @container campaign (width >= 52rem) {
    /* Dieselben Spalten wie die Gründe, damit Titel und Text an denselben
       Kanten stehen. */
    .demands li {
      grid-template-columns: var(--num) minmax(0, 5fr) minmax(0, 6fr) 2.5rem;
      column-gap: var(--space-l);
      align-items: start;
    }

    .demands li::before {
      grid-row: 1;
    }

    .demands p {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
