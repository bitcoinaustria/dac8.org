---
import ArgumentPoints from "@/components/ArgumentPoints.astro"
import Artwork from "@/components/Artwork.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { demands, points, topics, type PointId } from "@/data/arguments"
import { donateFor, languageFor, pathFor } from "@/lib/i18n"

// Our position by topic. The dossier states what the law requires; this page
// says what we object to and what we demand, and links to the facts.
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const dossier = pathFor("dossier", language)
const listFor = (ids: readonly PointId[]) =>
  ids.map((id) => points[language][id])
const sections = {
  verdacht: listFor(topics.verdacht),
  speicherdauer: listFor(topics.speicherdauer),
  sicherheit: listFor(topics.sicherheit),
  ausbau: listFor(topics.ausbau),
}
---

<Layout
  sections={[
    { id: "verdacht", label: en ? "No suspicion" : "Ohne Verdacht" },
    { id: "speicherdauer", label: en ? "Retention" : "Speicherdauer" },
    { id: "sicherheit", label: en ? "Security" : "Sicherheit" },
    { id: "ausbau", label: en ? "Expansion" : "Ausbau" },
    { id: "forderungen", label: en ? "Demands" : "Forderungen" },
  ]}
>
  <MetaPage slot="head" />

  <article class="campaign arguments">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "What we oppose in DAC8." : "Was wir an DAC8 ablehnen."}
          <span>{en ? "And what we demand." : "Und was wir fordern."}</span>
        </h1>
        <p class="lead">
          {en ? "Here is why we oppose collecting data on every crypto customer without suspicion, and which limits we demand. What the law requires in detail, and which data leaks have already happened, is set out in the " : "Hier steht, warum wir die Erfassung aller Krypto-Kunden ohne Verdacht ablehnen und welche Grenzen wir fordern. Was das Gesetz genau verlangt und welche Datenlecks es schon gab, steht im "}<a
            href={dossier}
            >{en ? "dossier" : "Dossier"}</a
          >.
        </p>
        <nav
          class="hero-actions"
          aria-label={en ? "Get started" : "Direkteinstieg"}
        >
          <a class="button primary" href="#forderungen"
            >{en ? "Our demands" : "Was wir fordern"}</a
          >
          <a class="button" href={dossier}
            >{en ? "What DAC8 requires" : "Was DAC8 verlangt"}</a
          >
        </nav>
      </div>
      <Artwork
        id="withoutSuspicion"
        language={language}
        size="hero"
        priority
        caption={false}
      />
    </header>

    <section id="verdacht" aria-labelledby="verdacht-heading">
      <h2 id="verdacht-heading" class="statement">
        {en ? "Privacy needs no justification." : "Privatsphäre braucht keine Rechtfertigung."}
        <span
          >{en ? "State interference does." : "Staatliche Eingriffe schon."}</span
        >
      </h2>
      <ArgumentPoints points={sections.verdacht} />
    </section>

    <section id="speicherdauer" aria-labelledby="speicherdauer-heading">
      <h2 id="speicherdauer-heading">
        {en ? "Data is kept for years, and more is added every year" : "Gespeichert wird lange, und jedes Jahr kommt mehr dazu"}
      </h2>
      <ArgumentPoints points={sections.speicherdauer} />
    </section>

    <section id="sicherheit" aria-labelledby="sicherheit-heading">
      <h2 id="sicherheit-heading">
        {en ? "Every data store is a target" : "Jeder Datenbestand ist ein Angriffsziel"}
      </h2>
      <p class="section-intro">
        {en ? "The danger is not the single report. It is the store that grows over the years without any suspicion, and everything that can be linked to it." : "Die Gefahr ist nicht die einzelne Meldung. Es ist der Bestand, der über Jahre wächst, ohne dass je ein Verdacht bestand, und alles, was sich damit verknüpfen lässt."}
      </p>
      <ArgumentPoints points={sections.sicherheit} />
      <ul class="facts">
        <li id="verknuepfung">
          <strong
            >{en ? "When datasets come together" : "Wenn Datensätze zusammenkommen"}</strong
          >
          <p>
            {en ? "Each source shows only part of the picture. A public profile shows a face and family, a provider breach the wallet address, a hacked tax service the holdings. The annual totals show how much someone moves. Put together, they form a profile with a face, an address and presumed wealth, and every further leak makes it more precise. A single breach can already hold several of these pieces: at Fractal ID, ID documents, home addresses and wallet addresses sat in one dataset." : "Jede Quelle zeigt nur einen Ausschnitt. Ein öffentliches Profil zeigt Gesicht und Familie, ein Leck beim Anbieter die Wallet-Adresse, ein gehackter Steuerdienst die Bestände. Die Jahreswerte zeigen, wie viel jemand bewegt. Zusammengeführt ergibt das ein Profil mit Gesicht, Anschrift und mutmaßlichem Vermögen, und jedes weitere Leck macht es genauer. Schon ein einzelnes Leck kann mehrere dieser Teile enthalten: Bei Fractal ID lagen Ausweis, Wohnadresse und Wallet-Adresse in einem Datensatz."}
          </p>
        </li>
        <li id="zahlungsprofile">
          <strong
            >{en ? "When payments reveal everyday life" : "Wenn Zahlungen deinen Alltag offenlegen"}</strong
          >
          <p>
            {en ? "Paying with bitcoin leaves traces of your everyday life, because on-chain transactions remain public. Once someone knows which address belongs to which name, for instance from a provider breach, they can attribute further payments to you. Combined with information about the recipients, your purchases, donations and recurring payments can " : "Zahlst du mit Bitcoin, hinterlässt du Spuren deines Alltags, denn On-Chain-Transaktionen bleiben öffentlich. Kennt jemand die Zuordnung von Name und Adresse, etwa aus einem Leck beim Anbieter, kann er dir weitere Zahlungen zuordnen. Mit Informationen über die Empfänger lassen Einkäufe, Spenden und regelmäßige Zahlungen "}<a
              href="https://petsymposium.org/popets/2018/popets-2018-0038.php"
              >{en ? "reveal habits and relationships" : "Rückschlüsse auf Gewohnheiten und Beziehungen"}</a
            >{en ? "." : " zu."}
          </p>
        </li>
      </ul>
    </section>

    <section id="ausbau" aria-labelledby="ausbau-heading">
      <h2 id="ausbau-heading">
        {en ? "DAC8 is one building block of financial surveillance" : "DAC8 ist ein Baustein finanzieller Überwachung"}
      </h2>
      <div class="columns">
        <p class="section-intro">
          {en ? "Step by step, the EU and Austria are building an infrastructure that collects financial data without suspicion, stores it for years and links it ever more closely." : "Schritt für Schritt bauen die EU und Österreich eine Infrastruktur, die Finanzdaten ohne Verdacht erfasst, lange speichert und immer enger verknüpft."}
        </p>
        <p class="prose">
          {en ? "Wallet addresses, individual transactions and activity before 2026 currently appear in no DAC8 report, and the proposal to recast the directive does not provide for that either. Providers hold them all the same, next to the data prepared for DAC8: anti-money-laundering rules have required it since 2020. Lawmakers can expand existing infrastructure. That is why we want to limit it now. The " : "Wallet-Adressen, einzelne Transaktionen und Vorgänge vor 2026 stehen derzeit in keiner DAC8-Meldung, und auch der Vorschlag zur Neufassung der Richtlinie sieht das nicht vor. Beim Anbieter liegen sie trotzdem, neben den Daten für DAC8: Seit 2020 verlangen das die Geldwäschevorschriften. Eine bestehende Infrastruktur kann der Gesetzgeber erweitern. Wir wollen ihr deshalb jetzt Grenzen setzen. Welche Stufen schon beschlossen sind und was die Neufassung ändern würde, zeigt die "}<a
            href={`${pathFor("history", language)}#ausblick`}
            >{en ? "history of the DAC" : "Geschichte der DAC"}</a
          >{en ? " shows which steps have been adopted and what the recast would change." : "."}
        </p>
      </div>
      <ol
        class="flow"
        aria-label={en ? "The building blocks" : "Die Bausteine"}
      >
        <li>
          <strong
            >{en ? "When you open an account" : "Bei der Kontoeröffnung"}</strong
          >
          <span
            >{en ? "the provider identifies you with your ID, as anti-money-laundering rules require." : "identifiziert dich der Anbieter nach den Geldwäschevorschriften mit Ausweis."}</span
          >
        </li>
        <li>
          <strong
            >{en ? "With every transfer" : "Bei jeder Übertragung"}</strong
          >
          <span
            >{en ? "it records the sender and recipient under the EU transfer of funds regulation, including when you transfer to your own wallet." : "erfasst er nach der EU-Geldtransferverordnung Absender und Empfänger, auch wenn du auf deine eigene Wallet überträgst."}</span
          >
        </li>
        <li class="accent">
          <strong>{en ? "Every year" : "Jedes Jahr"}</strong>
          <span
            >{en ? "it prepares the tax identification numbers and annual totals of all customers for the DAC8 report." : "bereitet er Steuernummer und Jahreswerte aller Kunden für die DAC8-Meldung auf."}</span
          >
        </li>
        <li>
          <strong>{en ? "By 2029" : "Bis 2029"}</strong>
          <span
            >{en ? "account registries will be connected across the EU and will then also cover crypto-asset accounts." : "werden die Kontenregister EU-weit vernetzt. Sie erfassen dann auch Krypto-Konten."}</span
          >
        </li>
      </ol>
      <ArgumentPoints points={sections.ausbau} />
    </section>

    <section id="forderungen" aria-labelledby="forderungen-heading">
      <h2 id="forderungen-heading">
        {en ? "Our demands" : "Was wir fordern"}
      </h2>
      <p class="section-intro">
        {en ? "The state must justify why an intrusion into your private life is necessary. Invoking money laundering or tax evasion does not replace that justification. We call for targeted investigations based on specific suspicion and effective protection for uninvolved people." : "Der Staat muss begründen, warum ein Eingriff in dein Privatleben notwendig ist. Der Verweis auf Geldwäsche oder Steuerhinterziehung ersetzt diese Begründung nicht. Wir fordern gezielte Ermittlungen bei konkretem Verdacht und wirksamen Schutz für Unbeteiligte."}
      </p>
      <ul class="checklist">
        {demands[language].map((demand) => (
          <li>
            <strong>{demand.title}</strong>
            {demand.text}
          </li>
        ))}
      </ul>
      <div class="precedent">
        <p class="precedent-year" aria-hidden="true">2014</p>
        <p class="prose">
          <strong
            >{en ? "A surveillance law has fallen before." : "Schon einmal fiel ein Überwachungsgesetz."}</strong
          >
          {en ? "The challenge to data retention organised by AKVorrat, now epicenter.works, reached the Court of Justice through Austria’s Constitutional Court. In 2014, both the EU directive and Austrian rules fell." : "Die von AKVorrat, heute epicenter.works, organisierte Beschwerde gegen die Vorratsdatenspeicherung führte über den Verfassungsgerichtshof zum Europäischen Gerichtshof. 2014 hob der EuGH die EU-Richtlinie auf, der VfGH die österreichischen Regeln."}
        </p>
      </div>
      <a class="text-link" href={donateFor(language)}
        >{en ? "Help fund the case" : "Den Prozess mittragen"}</a
      >
    </section>
  </article>
</Layout>
