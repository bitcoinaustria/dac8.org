---
import Artwork from "@/components/Artwork.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { demands, points, topics, type PointId } from "@/data/arguments"
import { donateFor, languageFor, pathFor } from "@/lib/i18n"

// Our position by topic. The dossier states what the law requires; this page
// says what we object to and what we demand, and links to the facts.
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const dossier = pathFor("dossier", language)
const listFor = (ids: readonly PointId[]) =>
  ids.map((id) => points[language][id])
---

<Layout
  sections={[
    { id: "verdacht", label: en ? "No suspicion" : "Ohne Verdacht" },
    { id: "sicherheit", label: en ? "Security" : "Sicherheit" },
    { id: "speicherdauer", label: en ? "Retention" : "Speicherdauer" },
    { id: "ausbau", label: en ? "Expansion" : "Ausbau" },
    { id: "forderungen", label: en ? "Demands" : "Forderungen" },
  ]}
>
  <MetaPage slot="head" />

  <article class="campaign arguments">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "What we oppose in DAC8." : "Was wir an DAC8 ablehnen."}
          <span>{en ? "And what we demand." : "Und was wir fordern."}</span>
        </h1>
        <p class="lead">
          {en ? "Our arguments, sorted by topic. What the law requires in detail, and the cases that have already happened, are in the " : "Unsere Argumente, nach Themen geordnet. Was das Gesetz genau verlangt und welche Fälle es schon gibt, steht im "}<a
            href={dossier}
            >{en ? "dossier" : "Dossier"}</a
          >.
        </p>
        <nav
          class="hero-actions"
          aria-label={en ? "Jump to" : "Direkteinstieg"}
        >
          <a class="button primary" href="#forderungen"
            >{en ? "Our demands" : "Was wir fordern"}</a
          >
          <a class="button" href={dossier}
            >{en ? "What DAC8 requires" : "Was DAC8 verlangt"}</a
          >
        </nav>
      </div>
      <Artwork
        id="paragraphWatch"
        language={language}
        size="hero"
        priority
        caption={false}
      />
    </header>

    <section id="verdacht" aria-labelledby="verdacht-heading">
      <h2 id="verdacht-heading" class="statement">
        {en ? "Privacy needs no justification." : "Privatsphäre braucht keine Rechtfertigung."}
        <span
          >{en ? "State interference does." : "Staatliche Eingriffe schon."}</span
        >
      </h2>
      <ul class="facts concerns">
        {listFor(topics.verdacht).map((point) => (
          <li>
            <strong>{point.title}</strong>
            <p>{point.text}</p>
            {point.source && <small><a href={point.source.href}>{point.source.label}</a></small>}
            {point.link && <a class="text-link" href={point.link.href}>{point.link.label}</a>}
          </li>
        ))}
      </ul>
    </section>

    <section id="sicherheit" aria-labelledby="sicherheit-heading">
      <h2 id="sicherheit-heading">
        {en ? "Every data store is a target" : "Jeder Datenbestand ist ein Angriffsziel"}
      </h2>
      <p class="section-intro">
        {en ? "The danger is not the single report. It is the store that grows over the years without any suspicion, and everything that can be linked to it." : "Die Gefahr ist nicht die einzelne Meldung. Es ist der Bestand, der über Jahre wächst, ohne dass je ein Verdacht bestand, und alles, was sich damit verknüpfen lässt."}
      </p>
      <ul class="facts concerns">
        {listFor(topics.sicherheit).map((point) => (
          <li>
            <strong>{point.title}</strong>
            <p>{point.text}</p>
          </li>
        ))}
      </ul>
      <h3 id="verknuepfung">
        {en ? "When datasets come together" : "Wenn Datensätze zusammenkommen"}
      </h3>
      <p class="prose">
        {en ? "Each source shows only part of the picture. A public profile shows a face and family, a provider breach the wallet address, a hacked tax service the holdings. The annual totals show how much someone moves. Put together, they form a profile with a face, an address and presumed wealth, and every further leak makes it more precise. A single breach can already hold several of these pieces: at Fractal ID, ID documents, home addresses and wallet addresses sat in one dataset." : "Jede Quelle zeigt nur einen Ausschnitt. Ein öffentliches Profil zeigt Gesicht und Familie, ein Leck beim Anbieter die Wallet-Adresse, ein gehackter Steuerdienst die Bestände. Die Jahreswerte zeigen, wie viel jemand bewegt. Zusammengeführt ergibt das ein Profil mit Gesicht, Anschrift und mutmaßlichem Vermögen, und jedes weitere Leck macht es genauer. Schon ein einzelnes Leck kann mehrere Bausteine enthalten: Bei Fractal ID lagen Ausweis, Wohnadresse und Wallet-Adresse in einem Datensatz."}
      </p>
      <Artwork id="profileFourSources" language={language} size="wide" zoom />
      <h3 id="zahlungsprofile">
        {en ? "When payments reveal everyday life" : "Wenn Zahlungen deinen Alltag offenlegen"}
      </h3>
      <p class="prose">
        {en ? "Paying with bitcoin leaves traces of your everyday life, because on-chain transactions remain public. When a provider links your name to an address, further payments may become attributable to you. With information about recipients, purchases, donations and recurring payments can " : "Zahlst du mit Bitcoin, hinterlässt du Spuren deines Alltags, denn On-Chain-Transaktionen bleiben öffentlich. Verbindet ein Anbieter deinen Namen mit einer Adresse, kann jemand weitere Zahlungen dir zuordnen. Mit Informationen über die Empfänger lassen Einkäufe, Spenden und regelmäßige Zahlungen "}<a
          href="https://petsymposium.org/popets/2018/popets-2018-0038.php"
          >{en ? "reveal habits and relationships" : "Rückschlüsse auf Gewohnheiten und Beziehungen"}</a
        >{en ? "." : " zu."}
      </p>
      <Artwork
        id="walletHistoryRevealed"
        language={language}
        size="wide"
        zoom
      />
      <div class="link-row">
        <a class="text-link" href={`${dossier}#faelle`}
          >{en ? "What has already happened" : "Was schon passiert ist"}</a
        >
        <a class="text-link" href={pathFor("attacks", language)}
          >{en ? "Attacks on crypto holders worldwide" : "Angriffe auf Krypto-Besitzer weltweit"}</a
        >
      </div>
    </section>

    <section id="speicherdauer" aria-labelledby="speicherdauer-heading">
      <h2 id="speicherdauer-heading">
        {en ? "Kept for years, and more every year" : "Lange gespeichert, und jedes Jahr mehr"}
      </h2>
      <ul class="facts concerns">
        {listFor(topics.speicherdauer).map((point) => (
          <li>
            <strong>{point.title}</strong>
            <p>{point.text}</p>
            {point.link && <a class="text-link" href={point.link.href}>{point.link.label}</a>}
          </li>
        ))}
      </ul>
    </section>

    <section id="ausbau" aria-labelledby="ausbau-heading">
      <h2 id="ausbau-heading">
        {en ? "One building block of financial surveillance" : "Ein Baustein finanzieller Überwachung"}
      </h2>
      <div class="columns">
        <p class="section-intro">
          {en ? "Step by step, the EU and Austria are building an infrastructure that collects financial data without suspicion, stores it for years and links it ever more closely. DAC8 is one part of it." : "Schritt für Schritt bauen die EU und Österreich eine Infrastruktur, die Finanzdaten ohne Verdacht erfasst, lange speichert und immer enger verknüpft. DAC8 ist ein Teil davon."}
        </p>
        <p class="prose">
          {en ? "No one currently has to report wallet addresses, individual transactions or activities before 2026, and the proposal to recast the directive does not provide for it either. They are stored all the same: providers keep them under anti-money-laundering rules, next to the data prepared for DAC8. Lawmakers can expand existing infrastructure at any time. We want to limit it now. The " : "Wallet-Adressen, einzelne Transaktionen und Vorgänge vor 2026 muss derzeit niemand melden, und auch der Vorschlag zur Neufassung der Richtlinie sieht das nicht vor. Gespeichert sind sie trotzdem: Anbieter bewahren sie nach den Geldwäschevorschriften auf, neben den Daten für DAC8. Eine bestehende Infrastruktur kann der Gesetzgeber jederzeit erweitern. Wir wollen ihr deshalb jetzt Grenzen setzen. Welche Stufen schon beschlossen sind und was die Neufassung ändern würde, zeigt die "}<a
            href={`${pathFor("history", language)}#ausblick`}
            >{en ? "history of the DAC" : "Geschichte der DAC"}</a
          >{en ? " shows which steps have been adopted and what the recast would change." : "."}
        </p>
      </div>
      <ol
        class="flow"
        aria-label={en ? "The building blocks" : "Die Bausteine"}
      >
        <li>
          <strong
            >{en ? "When you open an account" : "Bei der Kontoeröffnung"}</strong
          >
          <span
            >{en ? "the provider identifies you with your ID. Under anti-money-laundering rules, the records are currently kept for up to ten years after the customer relationship ends." : "identifiziert dich der Anbieter mit Ausweis. Nach den Geldwäschevorschriften bleiben die Unterlagen derzeit bis zehn Jahre nach Ende der Kundenbeziehung."}</span
          >
        </li>
        <li>
          <strong
            >{en ? "With every transfer" : "Bei jeder Übertragung"}</strong
          >
          <span
            >{en ? "it records the sender and recipient, including for transfers to your own wallet." : "erfasst er Absender und Empfänger, auch bei Übertragungen auf deine eigene Wallet."}</span
          >
        </li>
        <li class="accent">
          <strong>{en ? "Every year" : "Jedes Jahr"}</strong>
          <span
            >{en ? "it prepares the tax identification numbers and annual totals of all customers for the DAC8 report." : "bereitet er Steuernummer und Jahreswerte aller Kunden für die DAC8-Meldung auf."}</span
          >
        </li>
        <li>
          <strong>{en ? "By 2029" : "Bis 2029"}</strong>
          <span
            >{en ? "account registries will be connected across the EU, then including crypto-asset accounts." : "werden die Kontenregister EU-weit vernetzt, dann auch mit Krypto-Konten."}</span
          >
        </li>
      </ol>
      <ul class="facts concerns">
        {listFor(topics.ausbau).map((point) => (
          <li>
            <strong>{point.title}</strong>
            <p>{point.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="forderungen" aria-labelledby="forderungen-heading">
      <h2 id="forderungen-heading">
        {en ? "Our demands" : "Was wir fordern"}
      </h2>
      <p class="section-intro">
        {en ? "The state must justify why an intrusion into your private life is necessary. Invoking money laundering or tax evasion does not replace that justification. We call for targeted investigations based on specific suspicion and effective protection for uninvolved people." : "Der Staat muss begründen, warum ein Eingriff in dein Privatleben notwendig ist. Der Verweis auf Geldwäsche oder Steuerhinterziehung ersetzt diesen Nachweis nicht. Wir fordern gezielte Ermittlungen bei konkretem Verdacht und wirksamen Schutz für Unbeteiligte."}
      </p>
      <ul class="checklist">
        {demands[language].map((demand) => (
          <li>
            <strong>{demand.title}</strong>
            {demand.text}
          </li>
        ))}
      </ul>
      <div class="precedent">
        <p class="precedent-year" aria-hidden="true">2014</p>
        <p class="prose">
          <strong
            >{en ? "A surveillance law has fallen before." : "Schon einmal fiel ein Überwachungsgesetz."}</strong
          >
          {en ? "The challenge to data retention organised by AKVorrat, now epicenter.works, reached the Court of Justice through Austria’s Constitutional Court. In 2014, both the EU directive and Austrian rules fell." : "Die von AKVorrat, heute epicenter.works, organisierte Beschwerde gegen die Vorratsdatenspeicherung führte über den Verfassungsgerichtshof zum Europäischen Gerichtshof. 2014 hob der EuGH die EU-Richtlinie auf, der VfGH die österreichischen Regeln."}
        </p>
      </div>
      <div class="link-row">
        <a class="text-link" href={donateFor(language)}
          >{en ? "Help fund the case" : "Den Prozess mittragen"}</a
        >
        <a
          class="text-link"
          href={`${pathFor("participate", language)}#abgeordnete`}
          >{en ? "Write to your MP" : "Deinen Abgeordneten schreiben"}</a
        >
        <a class="text-link" href={`${dossier}#rechtsweg`}
          >{en ? "Our legal strategy" : "Wie wir vorgehen"}</a
        >
      </div>
    </section>
  </article>
</Layout>
