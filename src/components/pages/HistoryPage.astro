---
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import HistoryStack from "@/components/HistoryStack.astro"
import { historyEras, historyFor, historyResearchDate } from "@/data/history"
import { languageFor, pathFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const entries = historyFor(language)
const eras = historyEras[language]
const statusLabel = {
  context: en ? "Context" : "Umfeld",
  past: en ? "In force" : "In Kraft",
  repealed: en ? "Repealed" : "Aufgehoben",
  current: en ? "Applies since 2026" : "Gilt seit 2026",
  proposed: en ? "Proposal" : "Vorschlag",
} as const

// A long pause between two stations shows as a dashed stretch of the spine.
const pauseYears = 5
const chapters = eras.map((era) => {
  const stations = entries.filter((entry) => entry.era === era.id)
  return {
    ...era,
    stations: stations.map((entry, i) => {
      const previous = stations[i - 1]
      const pause = previous ? Number(entry.year) - Number(previous.year) : 0
      return {
        ...entry,
        showYear: previous?.year !== entry.year,
        pause:
          pause >= pauseYears
            ? en
              ? `${pause} years later`
              : `${pause} Jahre später`
            : undefined,
      }
    }),
  }
})
---

<Layout
  sections={[
    ...eras.map((era) => ({ id: era.id, label: era.label })),
    { id: "gemeinsam", label: en ? "Common rules" : "Gemeinsame Regeln" },
  ]}
>
  <MetaPage slot="head" />
  <article class="campaign history">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "How we got to DAC8. " : "Wie es zu DAC8 kam. "}
          <span>{en ? "And what comes next." : "Und was noch kommt."}</span>
        </h1>
        <p class="lead">
          {en
            ? "EU tax authorities started out asking each other about specific cases. Today, banks, platforms and crypto-asset providers report on their customers every year."
            : "Am Anfang fragten Steuerbehörden einander zu einzelnen Fällen. Heute melden Banken, Plattformen und Krypto-Anbieter jedes Jahr Daten über ihre Kunden."}
        </p>
      </div>
      <HistoryStack language={language} />
    </header>

    <div class="chronicle">
      {chapters.map((era) => (
        <section
          id={era.id}
          class:list={["era", era.id]}
          aria-labelledby={`${era.id}-heading`}
        >
          <header class="era-head">
            <p class="era-span">{era.label}</p>
            <h2 id={`${era.id}-heading`}>{era.title}</h2>
            <p class="era-intro">{era.intro}</p>
          </header>
          <ol class="spine">
            {era.stations.map((entry) => (
              <li
                id={entry.id}
                class:list={["station", entry.status, { paused: entry.pause }]}
              >
                {entry.pause && (
                  <span class="station-pause" aria-hidden="true">
                    {entry.pause}
                  </span>
                )}
                <span class="station-year" aria-hidden="true">
                  {entry.showYear && entry.year}
                </span>
                <span class="station-node" aria-hidden="true" />
                <article class="station-body">
                  <p class="station-meta">
                    <time datetime={entry.date}>{entry.when}</time>
                    <span class="tag">{statusLabel[entry.status]}</span>
                  </p>
                  <h3>{entry.title}</h3>
                  <p class="station-text">{entry.text}</p>
                  {entry.reporters && (
                    <p class="station-who">
                      <span>{en ? "Who reports" : "Wer meldet"}</span>
                      {entry.reporters}
                    </p>
                  )}
                  {entry.status === "current" && (
                    <a
                      class="text-link"
                      href={`${pathFor("dossier", language)}#gemeldet`}
                      >{en ? "What DAC8 reports" : "Was DAC8 meldet"}</a
                    >
                  )}
                  <details class="station-more">
                    <summary>
                      {entry.more || entry.details.length > 0
                        ? en
                          ? "More and sources"
                          : "Mehr und Quellen"
                        : en
                          ? "Sources"
                          : "Quellen"}
                    </summary>
                    {entry.more && <p class="station-more-text">{entry.more}</p>}
                    {entry.details.length > 0 && (
                      <dl class="station-facts">
                        {entry.details.map((detail) => (
                          <>
                            <dt>{detail.label}</dt>
                            <dd>{detail.text}</dd>
                          </>
                        ))}
                      </dl>
                    )}
                    <ul class="station-sources">
                      {entry.sources.map((source) => (
                        <li>
                          <a href={source.href}>{source.label}</a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <section id="gemeinsam" class="common" aria-labelledby="gemeinsam-heading">
      <header class="era-head">
        <p class="era-span">{en ? "DAC1 to DAC9" : "DAC1 bis DAC9"}</p>
        <h2 id="gemeinsam-heading">
          {en ? "What applies to every step" : "Was für alle Stufen gilt"}
        </h2>
        <p class="era-intro">
          {en
            ? "Every step amends the same 2011 directive. The exchange channels, official secrecy and the rules on what the data may be used for apply to all categories alike."
            : "Jede Stufe ändert dieselbe Richtlinie von 2011. Übermittlungswege, Amtsgeheimnis und die Regeln, wofür die Daten verwendet werden dürfen, gelten für alle Kategorien gemeinsam."}
        </p>
      </header>
      <div class="common-body">
        <p class="prose">
          {en
            ? "Originally, exchanged information could be used for taxes, tax recovery, social security contributions and tax penalty proceedings; any other use needed the sending country’s consent. DAC8 added the fight against money laundering and terrorist financing, and for the purposes of EU sanctions acts under Article 215 TFEU, the sending country’s consent is no longer required. Purpose limits, official secrecy and data protection still apply. This covers all DAC data, including bank-account, salary, pension and platform data."
            : "Ursprünglich durften ausgetauschte Informationen für Steuern, deren Beitreibung, Sozialversicherungsbeiträge und Steuerstrafverfahren verwendet werden; für alles andere brauchte es die Zustimmung des Herkunftsstaats. DAC8 hat die Bekämpfung von Geldwäsche und Terrorismusfinanzierung hinzugefügt, und für EU-Sanktionsrechtsakte nach Art. 215 AEUV braucht es keine Zustimmung des Herkunftsstaats mehr. Zweckbindung, Geheimhaltung und Datenschutz gelten weiter. Das betrifft alle DAC-Daten, auch Konto-, Lohn-, Pensions- und Plattformdaten."}
        </p>
        <p class="chronicle-sources">
          {en
            ? "Article 16 of Directive 2011/16/EU, as amended by Article 1(7) of "
            : "Art. 16 der Richtlinie 2011/16/EU, geändert durch Art. 1 Nr. 7 der "}
          <a
            href={en
              ? "https://eur-lex.europa.eu/eli/dir/2023/2226/oj/eng"
              : "https://eur-lex.europa.eu/eli/dir/2023/2226/oj/deu"}
            >{en ? "Directive (EU) 2023/2226" : "Richtlinie (EU) 2023/2226"}</a
          >.
        </p>
        <nav
          class="hero-actions"
          aria-label={en ? "Continue reading" : "Weiterlesen"}
        >
          <a
            class="button primary"
            href={`${pathFor("dossier", language)}#gemeldet`}
            >{en ? "What DAC8 reports" : "Was DAC8 meldet"}</a
          >
          <a class="button" href={`${pathFor("dossier", language)}#quellen`}
            >{en ? "All sources" : "Alle Quellen"}</a
          >
        </nav>
        <p class="research-note">
          {en
            ? `Research by Bitcoin Austria, as of ${historyResearchDate.en}. Every entry links to its primary sources. Not legal advice.`
            : `Recherche von Bitcoin Austria, Stand: ${historyResearchDate.de}. Jeder Eintrag verweist auf seine Primärquellen. Keine Rechtsberatung.`}
        </p>
      </div>
    </section>
  </article>
</Layout>

<style>
  /* Die Geschichte ist eine Chronik, kein Plakat: ruhigere Schlagzeilen,
     kleinere Schrift und engere Bänder als auf den übrigen Seiten. */
  .history {
    --band-gap: clamp(4rem, 2.5rem + 4vw, 6.5rem);
    font-size: 1rem;
  }

  .history .hero {
    row-gap: var(--space-xl);
  }

  .history h1 {
    max-inline-size: 22ch;
    font-size: clamp(2rem, 1.45rem + 2.2vw, 3.25rem);
    line-height: 1.04;
  }

  .history .lead {
    max-inline-size: 48ch;
    margin-block-start: var(--space-s);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
  }

  /* ---------- Kapitel ---------------------------------------------------- */

  .chronicle {
    display: grid;
    gap: var(--space-2xl);
  }

  .era,
  .common {
    display: grid;
    gap: var(--space-m) var(--space-2xl);
    scroll-margin-block-start: var(--space-l);
  }

  .era-span {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .history .era-head h2 {
    max-inline-size: 18ch;
    margin-block-start: var(--space-3xs);
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .era-intro {
    max-inline-size: 46ch;
    margin-block-start: var(--space-xs);
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* Breit: das Kapitel steht links und bleibt stehen, während seine
     Stationen rechts an der Zeitachse vorbeiziehen. */
  @container campaign (width >= 56rem) {
    .era,
    .common {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      align-items: start;
    }

    .era-head {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-l));
      padding-block-start: var(--space-s);
      background: var(--metal-rule) top / 100% 2px no-repeat;
    }
  }

  /* ---------- Zeitachse ---------------------------------------------------- */

  .spine {
    --year-col: 4.25rem;
    --node-col: 2rem;
    --node: 0.875rem;
    --spine: light-dark(#c6cbcf, #3d4248);
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .station {
    display: grid;
    grid-template-columns: var(--year-col) var(--node-col) minmax(0, 42rem);
    column-gap: var(--space-s);
    scroll-margin-block-start: calc(var(--header-height) + var(--space-l));
  }

  /* Die Nut läuft durch jede Station; die erste beginnt am Knoten. */
  .station::before {
    content: "";
    grid-column: 2;
    grid-row: 2;
    justify-self: center;
    inline-size: 2px;
    background: var(--spine);
  }

  .era .station:first-child::before {
    margin-block-start: 0.6rem;
  }

  .era .station:last-child::before {
    background: linear-gradient(var(--spine), transparent);
  }

  .station-pause {
    grid-column: 1 / 3;
    grid-row: 1;
    display: grid;
    grid-template-columns: var(--year-col) var(--node-col);
    column-gap: var(--space-s);
    align-items: center;
    min-block-size: 3.5rem;
    color: var(--ink-3);
    font-size: 0.75rem;
    font-style: italic;
    text-align: end;
  }

  /* Eine lange Pause: die Nut gestrichelt. */
  .station-pause::after {
    content: "";
    justify-self: center;
    align-self: stretch;
    inline-size: 0;
    border-inline-start: 2px dashed var(--spine);
  }

  .station-year {
    grid-column: 1;
    grid-row: 2;
    justify-self: end;
    padding-block-start: 0.1rem;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 600;
    font-stretch: 94%;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* Token wie auf der Startseite: Graphitkern, Titankante, Lichtkante. */
  .station-node {
    grid-column: 2;
    grid-row: 2;
    z-index: 1;
    justify-self: center;
    inline-size: var(--node);
    block-size: var(--node);
    margin-block-start: 0.3rem;
    border: 1px solid var(--material-edge);
    border-radius: var(--radius-full);
    background: linear-gradient(155deg, #4b5056, #25282d);
    box-shadow:
      inset 0 1px 0 #ffffff38,
      0 0 0 4px var(--background);
  }

  .station-body {
    grid-column: 3;
    grid-row: 2;
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
    padding-block-end: var(--space-l);
  }

  .station-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs) var(--space-2xs);
    color: var(--ink-3);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .station-meta .tag {
    margin: 0;
    padding: 0.05em 0.55em;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-3);
    font-size: 0.75rem;
  }

  .history .station h3 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .station-text {
    max-inline-size: 62ch;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .station:target h3 {
    color: var(--accent);
  }

  /* Wer meldet: die Achse der Geschichte, von Behörden über Banken zu
     Plattformen und Krypto-Anbietern. Breit als Randnotiz neben der Station. */
  .station-who {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin-block-start: var(--space-3xs);
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 560;
    line-height: 1.4;
  }

  .station-who span {
    color: var(--ink-3);
    font-weight: 450;
  }

  @container campaign (width >= 68rem) {
    .station {
      grid-template-columns: var(--year-col) var(--node-col) minmax(0, 1fr);
    }

    .station-body {
      grid-template-columns: minmax(0, 36rem) minmax(0, 13rem);
      column-gap: var(--space-xl);
    }

    .station-body > * {
      grid-column: 1;
    }

    .station-body > .station-who {
      grid-column: 2;
      grid-row: 1 / span 3;
      flex-direction: column;
      align-self: start;
      margin-block-start: 0;
      padding-block: 0.1rem 0.2rem;
      padding-inline-start: var(--space-s);
      border-inline-start: 1px solid var(--line);
    }

    .current .station-body > .station-who {
      padding-block-start: 0;
    }
  }

  /* Umfeld: Standards außerhalb der Richtlinie, leiser gesetzt als die
     Stufen selbst. Hohler Ring statt Token. */
  .context {
    --node: 0.625rem;
  }

  .context .station-node {
    margin-block-start: 0.35rem;
    border-color: var(--ink-3);
    background: var(--background);
    box-shadow: 0 0 0 4px var(--background);
  }

  .context .station-year {
    color: var(--ink-3);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .history .context h3 {
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 560;
  }

  .context .station-text {
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  /* Aufgehoben: der Token verblasst. */
  .repealed .station-node {
    opacity: 0.45;
  }

  .repealed .station-year {
    color: var(--ink-3);
  }

  /* DAC8: der Gipfel der Zeitachse, als einzige Station auf einer Fläche. */
  .current {
    --node: 1.25rem;
  }

  .current .station-node {
    margin-block-start: var(--space-m);
    border-color: light-dark(#b6000c, #fa5963);
    background: linear-gradient(155deg, #e3000f, #be000c);
    box-shadow:
      inset 0 1px 0 #ffffff50,
      0 0 0 5px color-mix(in oklab, var(--primary) 22%, var(--background)),
      0 0 0 9px var(--background);
  }

  .current .station-year {
    padding-block-start: var(--space-s);
    color: var(--accent);
    font-size: 1.75rem;
  }

  .current .station-body {
    gap: var(--space-2xs);
    margin-block-end: var(--space-l);
    padding: var(--space-m) var(--space-m-l);
    border: 1px solid color-mix(in oklab, var(--primary) 40%, transparent);
    border-radius: var(--radius);
    background: light-dark(
      color-mix(in oklab, var(--primary) 3.5%, var(--paper)),
      color-mix(in oklab, var(--primary) 8%, var(--paper))
    );
    box-shadow: 0 1px 2px var(--material-shade);
  }

  .history .current h3 {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    line-height: 1.15;
  }

  .current .station-text {
    color: var(--ink);
    font-size: 1rem;
  }

  .current .station-meta .tag {
    border-color: transparent;
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .current .text-link {
    margin-block-start: var(--space-3xs);
    font-size: 0.9375rem;
  }

  /* Ausblick: noch kein Recht. Glas statt Graphit, die Nut gestrichelt. */
  .ausblick .station::before {
    inline-size: 0;
    border-inline-start: 2px dashed var(--spine);
    background: none;
  }

  .proposed .station-node {
    border-style: dashed;
    border-color: var(--ink-3);
    background: var(--background);
    box-shadow: 0 0 0 4px var(--background);
  }

  .proposed .station-meta .tag {
    border-style: dashed;
    border-color: var(--ink-3);
  }

  /* ---------- Aufklappbare Einzelheiten ---------------------------------- */

  .station-more {
    margin-block-start: var(--space-3xs);
    font-size: 0.875rem;
  }

  .station-more summary {
    inline-size: fit-content;
    color: var(--ink-3);
    font-weight: 560;
    cursor: pointer;
  }

  .station-more summary:hover {
    color: var(--ink);
  }

  .station-more[open] summary {
    color: var(--ink);
  }

  .station-more-text {
    max-inline-size: 62ch;
    margin-block-start: var(--space-xs);
    color: var(--ink-2);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .station-facts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-3xs) var(--space-s);
    max-inline-size: 62ch;
    margin-block-start: var(--space-xs);
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--line);
  }

  .station-facts dt {
    color: var(--ink-3);
  }

  .station-facts dd {
    color: var(--ink-2);
  }

  .station-sources {
    display: grid;
    gap: var(--space-3xs);
    margin-block-start: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .station-sources a,
  .chronicle-sources {
    color: var(--ink-3);
  }

  .station-sources a::before {
    content: "↗ ";
  }

  /* ---------- Gemeinsame Regeln ----------------------------------------- */

  .common-body > :first-child {
    margin-block-start: 0;
  }

  .common .prose {
    font-size: 0.9375rem;
  }

  .chronicle-sources {
    margin-block-start: var(--space-s);
    font-size: 0.8125rem;
  }

  .common .hero-actions {
    margin-block-start: var(--space-l);
  }

  /* ---------- Schmal ---------------------------------------------------- */

  @container campaign (width < 40rem) {
    .spine {
      --node-col: 1.25rem;
    }

    .station {
      grid-template-columns: var(--node-col) minmax(0, 1fr);
      column-gap: var(--space-xs);
    }

    .station::before {
      grid-column: 1;
      grid-row: 2 / 4;
    }

    .station-pause {
      grid-column: 1 / -1;
      grid-template-columns: var(--node-col) auto;
      column-gap: var(--space-xs);
      min-block-size: 2.5rem;
      text-align: start;
    }

    .station-pause::after {
      grid-column: 1;
      grid-row: 1;
    }

    .station-node {
      grid-column: 1;
    }

    .station-year {
      grid-column: 2;
      justify-self: start;
      padding-block-start: 0;
      font-size: 1rem;
    }

    .station-year:empty {
      display: none;
    }

    .station-body {
      grid-column: 2;
      grid-row: 3;
    }

    .current .station-year {
      padding-block-start: 0;
      font-size: 1.375rem;
    }

    .current .station-node {
      margin-block-start: 0.15rem;
    }

    .current .station-body {
      margin-block-start: var(--space-2xs);
    }

    .station-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .station-facts dd + dt {
      margin-block-start: var(--space-2xs);
    }
  }
</style>
