---
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import HistoryStack from "@/components/HistoryStack.astro"
import LawGrowth from "@/components/LawGrowth.astro"
import StatTiles from "@/components/StatTiles.astro"
import UnitGrid from "@/components/UnitGrid.astro"
import YearColumns from "@/components/YearColumns.astro"
import { amlChronicle } from "@/data/aml-history"
import { historyResearchDate } from "@/data/history"
import {
  accountsExchanged,
  accountsSources,
  admissions,
  assetRecovery,
  auditSample,
  cryptoIllicit,
  effectTiles,
  formatNumber,
  reportsByYear,
  reportsByYearSources,
  reportsLatest,
} from "@/data/history-evidence"
import { languageFor, pathFor } from "@/lib/i18n"

// Two lines of rules and what they bring. The hero shows how long the
// texts have grown; then the tax reports and the anti-money-laundering
// duties, each as a chart of what applies year by year; then what audits
// and the authorities themselves found about the effect. The page never
// argues that a rule would be justified if it worked: it closes on that.
// In every chart red marks what came of the rules: the records followed
// up, the reports passed on, the convictions, the money confiscated.
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const n = (value: number) => formatNumber(value, language)
const label = (source: { label: Record<string, string>; href: string }) => ({
  label: source.label[language],
  href: source.href,
})
const first = reportsByYear[0]
---

<Layout>
  <MetaPage slot="head" />
  <article class="campaign history">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "More and more rules, more and more data. " : "Immer mehr Regeln, immer mehr Daten. "}
          <span
            >{en ? "Hardly anyone measures what they achieve." : "Wie viel sie bringen, misst kaum jemand."}</span
          >
        </h1>
        <p class="lead">
          {en
            ? "At first it was about single cases. Today rules on tax and money laundering collect data about everyone who uses a bank or a provider. What that achieves, hardly anyone has counted."
            : "Erst ging es um einzelne Fälle. Heute sammeln Regeln zu Steuern und Geldwäsche Daten über alle, die eine Bank oder einen Anbieter nutzen. Was das bringt, hat kaum jemand nachgezählt."}
        </p>
      </div>
      <LawGrowth language={language} />
    </header>

    <section id="steuern" aria-labelledby="steuern-heading">
      <h2 id="steuern-heading">
        {en ? "Tax: first on request, " : "Steuern: erst auf Anfrage, "}
        <span>{en ? "now every year." : "jetzt jedes Jahr."}</span>
      </h2>
      <p class="section-intro">
        {en
          ? "First tax authorities asked about single cases. Today data on accounts, pay, platform income and crypto-assets flows every year, without any cause."
          : "Erst fragten Steuerbehörden zu einzelnen Fällen nach. Heute fließen Daten über Konten, Löhne, Plattform-Einnahmen und Kryptowerte jedes Jahr, ohne Anlass."}
      </p>
      <div class="history-chart">
        <HistoryStack language={language} research={false} />
      </div>
      <div class="history-figure">
        <YearColumns
          language={language}
          id="konten"
          title={en
            ? "Accounts on which tax authorities worldwide exchange data"
            : "Konten, zu denen Steuerbehörden weltweit Daten austauschen"}
          note={en
            ? "In millions, by year of exchange. Reported by the tax administrations themselves; accounts with several holders may count more than once."
            : "In Millionen, nach Jahr des Austauschs. Von den Steuerverwaltungen selbst gemeldet; Konten mit mehreren Inhabern zählen womöglich mehrfach."}
          unit={{ de: "Mio. Konten", en: "million accounts" }}
          rows={accountsExchanged.map((row) => ({
            year: row.year,
            value: row.millions,
          }))}
          sources={accountsSources.map(label)}
        />
      </div>
    </section>

    <section
      id="geldwaesche"
      class="band"
      aria-labelledby="geldwaesche-heading"
    >
      <h2 id="geldwaesche-heading">
        {en ? "Money laundering: first drug money, " : "Geldwäsche: erst Drogengeld, "}
        <span>{en ? "now every transfer." : "jetzt jede Übertragung."}</span>
      </h2>
      <p class="section-intro">
        {en
          ? "In 1988 it was about drug money. Today the rules against money laundering, AML for short, apply to every customer: whoever wants an account shows ID, called KYC for “know your customer”, and every crypto transfer carries names."
          : "1988 ging es um Drogengeld. Heute gelten die Regeln gegen Geldwäsche, kurz AML, für jeden Kunden: Wer ein Konto will, weist sich aus, kurz KYC für „Know Your Customer“, und jede Krypto-Übertragung trägt Namen."}
      </p>
      <div class="history-chart">
        <HistoryStack
          language={language}
          chronicle={amlChronicle}
          research={false}
        />
      </div>
    </section>

    <section id="wirkung" aria-labelledby="wirkung-heading">
      <h2 id="wirkung-heading">
        {en ? "The reports grow. " : "Die Meldungen wachsen. "}
        <span
          >{en ? "The results stay small." : "Die Ergebnisse bleiben klein."}</span
        >
      </h2>
      <p class="section-intro">
        {en
          ? "What the rules achieve is hardly measured. The figures there are all show the same picture: a lot of grey, a small red remainder."
          : "Was die Regeln bringen, wird kaum gemessen. Die Zahlen, die es gibt, zeigen alle dasselbe Bild: viel Grau, ein kleiner roter Rest."}
      </p>

      <div class="history-figures">
        <YearColumns
          language={language}
          id="meldungen"
          title={en
            ? `${n(reportsLatest.received)} suspicion reports, ${n(reportsLatest.convictions)} convictions`
            : `${n(reportsLatest.received)} Verdachtsmeldungen, ${n(reportsLatest.convictions)} Verurteilungen`}
          note={en
            ? `Austria, ${first.year} to ${reportsLatest.year}, both on one scale. Convictions for money laundering are not linked to particular reports; the way reports are counted changed several times.`
            : `Österreich, ${first.year} bis ${reportsLatest.year}, beides auf einer Skala. Verurteilungen wegen Geldwäsche lassen sich einzelnen Meldungen nicht zuordnen; die Zählweise der Meldungen änderte sich mehrmals.`}
          unit={{ de: "Meldungen", en: "reports" }}
          second={{
            de: "Verurteilungen wegen Geldwäsche",
            en: "convictions for money laundering",
          }}
          rows={reportsByYear.map((row) => ({
            year: row.year,
            value: row.reports,
            second: row.convictions,
          }))}
          breaks={[2009, 2012, 2024, 2025]}
          sources={reportsByYearSources.map(label)}
        />
        <UnitGrid
          language={language}
          id="einziehung"
          title={en
            ? "Of 100 euros from crime, about 1 is confiscated"
            : "Von 100 Euro aus Straftaten wird rund 1 Euro eingezogen"}
          note={en
            ? "EU, 2010 to 2014, as Europol estimates it. How much crime brings in is itself an estimate."
            : "EU, 2010 bis 2014, nach Schätzung von Europol. Wie viel Straftaten einbringen, ist selbst geschätzt."}
          columns={10}
          parts={[
            {
              count: 100 - assetRecovery.seized,
              figure: `${n(100 - assetRecovery.seized)} €`,
              kind: "faint",
              label: en ? "not frozen or seized" : "nicht gesichert",
            },
            {
              count: assetRecovery.seized - assetRecovery.confiscated,
              figure: `${n(assetRecovery.seized - assetRecovery.confiscated)} €`,
              kind: "mid",
              label: en
                ? "frozen or seized for now, but not confiscated"
                : "vorläufig gesichert, aber nicht eingezogen",
            },
            {
              count: assetRecovery.confiscated,
              figure: `${n(assetRecovery.confiscated)} €`,
              kind: "accent",
              label: en ? "finally confiscated" : "endgültig eingezogen",
            },
          ]}
          sources={[label(assetRecovery.source)]}
        />
        <UnitGrid
          language={language}
          id="krypto"
          title={en
            ? "Of 100 crypto euros, about 1 goes to criminals or sanctioned entities"
            : "Von 100 Krypto-Euro geht rund 1 an Kriminelle oder Sanktionierte"}
          note={en
            ? "2025, as two analysis firms estimate it; a lower bound. According to the US Treasury, laundering with crypto-assets “remains well below” laundering with ordinary money, and many criminals prefer dollar-pegged stablecoins."
            : "2025, nach Schätzung zweier Analysefirmen; eine Untergrenze. Laut US-Finanzministerium wird mit Kryptowerten weit weniger Geld gewaschen als mit herkömmlichem Geld, und viele Kriminelle bevorzugen an den Dollar gebundene Stablecoins."}
          columns={10}
          parts={[
            {
              count: 100 - cryptoIllicit.percent,
              figure: en ? "about 99 €" : "rund 99 €",
              kind: "faint",
              label: en ? "everything else" : "alles andere",
            },
            {
              count: cryptoIllicit.percent,
              figure: en ? "about 1 €" : "rund 1 €",
              kind: "accent",
              label: en
                ? "to addresses attributed to criminals or sanctioned entities"
                : "an Adressen, die Kriminellen oder sanktionierten Stellen zugeordnet sind",
            },
          ]}
          sources={cryptoIllicit.sources.map(label)}
        />
        <UnitGrid
          language={language}
          id="stichprobe"
          title={en
            ? "Of 150 tax records, 45 led to any action"
            : "Von 150 Steuerdatensätzen führten 45 zu einer Maßnahme"}
          note={en
            ? "Data on accounts and income received in 2016 by five EU countries, sampled by the European Court of Auditors. Austria was not among them."
            : "Daten über Konten und Einkommen, die fünf EU-Staaten 2016 erhielten, Stichprobe des Europäischen Rechnungshofs. Österreich war nicht dabei."}
          columns={15}
          parts={[
            {
              count: auditSample.notMatched,
              kind: "faint",
              label: en
                ? "not matched to a taxpayer"
                : "keinem Steuerpflichtigen zugeordnet",
            },
            {
              count: auditSample.disregarded,
              kind: "mid",
              label: en
                ? "matched, then left without risk analysis or reason"
                : "zugeordnet, dann ohne Risikoanalyse oder Begründung liegen gelassen",
            },
            {
              count: auditSample.followedUp,
              kind: "accent",
              label: en
                ? "led to further tax-related action"
                : "führten zu weiteren steuerlichen Maßnahmen",
            },
          ]}
          sources={[label(auditSample.source)]}
        />
      </div>

      <div class="history-tiles">
        <StatTiles
          tiles={effectTiles.map((tile) => ({
            figure: tile.figure[language],
            text: tile.text[language],
            source: label(tile.source),
          }))}
        />
      </div>

      <h3>
        {en ? "What the Commission and auditors say themselves" : "Was Kommission und Rechnungshöfe selbst sagen"}
      </h3>
      <ul class="history-admissions">
        {admissions.map((item) => (
          <li>
            <blockquote>
              <p>{item.quote[language]}</p>
            </blockquote>
            <p class="admission-who">
              {item.who[language]},{" "}
              <a href={item.source.href}>{item.source.label[language]}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="grenzen" class="band" aria-labelledby="grenzen-heading">
      <h2 id="grenzen-heading">
        {en ? "Even a rule that works needs limits." : "Auch eine Regel, die wirkt, braucht Grenzen."}
      </h2>
      <p class="section-intro">
        {en
          ? "Almost every one of these rules captures everyone who uses a bank or a provider, not those suspected of a crime. That needs a justification, whether the rule works or not. Investigations should start from a concrete suspicion."
          : "Fast jede dieser Regeln erfasst alle, die eine Bank oder einen Anbieter nutzen, nicht die, die einer Straftat verdächtig sind. Das braucht eine Begründung, ob die Regel wirkt oder nicht. Ermittelt werden soll bei konkretem Verdacht."}
      </p>
      <p class="history-next">
        <a class="text-link" href={pathFor("arguments", language)}>
          {en ? "Why financial privacy matters" : "Warum finanzielle Privatsphäre zählt"}
        </a>
      </p>
      <p class="history-research">
        {en
          ? `Research by Bitcoin Austria, as of ${historyResearchDate.en}. Every row and chart links to its primary sources.`
          : `Recherche von Bitcoin Austria, Stand: ${historyResearchDate.de}. Jede Zeile und jede Grafik verweist auf ihre Primärquellen.`}
      </p>
    </section>
  </article>
</Layout>

<style>
  /* Text links, die Längen der Regeln rechts daneben. */
  @container campaign (width >= 56rem) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 6fr);
      align-items: start;
    }
  }

  .history-chart {
    margin-block-start: var(--space-xl);
  }

  .history-tiles {
    margin-block-start: var(--space-2xl);
  }

  .history-figure {
    max-inline-size: 44rem;
    margin-block-start: var(--space-2xl);
  }

  .campaign > section > h3 {
    margin-block-start: var(--space-2xl);
  }

  /* Die Grafiken eines Abschnitts in zwei Spalten, schmal untereinander. */
  .history-figures {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--space-2xl);
    margin-block-start: var(--space-l);
  }

  @container campaign (width >= 56rem) {
    .history-figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .admission-who a {
    color: var(--ink-3);
  }

  .admission-who a:hover {
    color: var(--ink);
  }

  .history-admissions {
    display: grid;
    gap: var(--space-l) var(--space-2xl);
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
  }

  @container campaign (width >= 56rem) {
    .history-admissions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .history-admissions li {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding-block-start: var(--space-s);
    border-block-start: 2px solid var(--ink);
  }

  .history-admissions blockquote {
    margin: 0;
    color: var(--ink);
    font-size: var(--type-lead);
    font-weight: 560;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .admission-who {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .history-next {
    margin-block-start: var(--space-l);
  }

  .history-research {
    margin-block-start: var(--space-xl);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }
</style>
