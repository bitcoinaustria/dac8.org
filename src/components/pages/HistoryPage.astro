---
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import HistoryStack from "@/components/HistoryStack.astro"
import { languageFor } from "@/lib/i18n"

// One message and its evidence: every step of EU tax cooperation has added
// data, and the next is proposed. The chart is the page; each row opens with
// its facts and primary sources, so there is no separate chronicle.
const language = languageFor(Astro.url.pathname)
const en = language === "en"
---

<Layout>
  <MetaPage slot="head" />
  <article class="campaign history">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "Each new rule adds more data. " : "Jede neue Regel bringt mehr Daten. "}
          <span
            >{en ? "Until someone sets limits." : "Bis jemand Grenzen setzt."}</span
          >
        </h1>
        <p class="lead">
          {en
            ? "In 1977, tax authorities asked each other about individual cases. Today, banks, platforms and crypto-asset providers report on their customers every year. The next extension has already been proposed."
            : "1977 fragten Steuerbehörden einander zu einzelnen Fällen. Heute melden Banken, Plattformen und Krypto-Anbieter jedes Jahr Daten über ihre Kunden. Die nächste Erweiterung ist schon vorgeschlagen."}
        </p>
      </div>
      <HistoryStack language={language} />
    </header>
  </article>
</Layout>
