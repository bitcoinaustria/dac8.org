---
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import HistoryStack from "@/components/HistoryStack.astro"
import LawGrowth from "@/components/LawGrowth.astro"
import RuleFilm from "@/components/RuleFilm.astro"
import StatTiles from "@/components/StatTiles.astro"
import YearColumns from "@/components/YearColumns.astro"
import { ruleChronicle } from "@/data/aml-history"
import { historyResearchDate } from "@/data/history"
import {
  accountsExchanged,
  accountsSources,
  admissions,
  effectTiles,
  formatNumber,
  reportsByYear,
  reportsByYearSources,
  reportsLatest,
} from "@/data/history-evidence"
import { languageFor, pathFor } from "@/lib/i18n"

// The story of over-regulation and its evidence. A short hero, then the
// scroll film (src/components/RuleFilm.astro): pages of law piling up, the
// amount from which you must show ID falling to zero, ever more authorities
// looking at your account, reports multiplying against few convictions, and
// the euro or so that comes of it. Below it everything to check: both
// chronicles row by row with sources, the full series, the length of the
// texts, single figures and the institutions' own words. The page never
// argues that a rule would be justified if it worked: it closes on that.
// In every chart red marks what comes of the rules or what is new.
const language = languageFor(Astro.url.pathname)
const en = language === "en"
const n = (value: number) => formatNumber(value, language)
const label = (source: { label: Record<string, string>; href: string }) => ({
  label: source.label[language],
  href: source.href,
})
const first = reportsByYear[0]
---

<Layout>
  <MetaPage slot="head" />
  <article class="campaign history">
    <header class="hero">
      <div class="hero-text">
        <h1>
          {en ? "More and more rules, more and more data. " : "Immer mehr Regeln, immer mehr Daten. "}
          <span
            >{en ? "Hardly anyone measures what they achieve." : "Wie viel sie bringen, misst kaum jemand."}</span
          >
        </h1>
        <p class="lead">
          {en
            ? "At first it was about single cases. Today rules on tax and money laundering collect data about everyone who uses a bank or a provider. Scroll through how it got here, and what comes of it."
            : "Erst ging es um einzelne Fälle. Heute sammeln Regeln zu Steuern und Geldwäsche Daten über alle, die eine Bank oder einen Anbieter nutzen. Scroll durch, wie es dazu kam und was dabei herauskommt."}
        </p>
      </div>
    </header>

    <RuleFilm language={language} />

    <section id="nachpruefen" aria-labelledby="nachpruefen-heading">
      <h2 id="nachpruefen-heading">
        {en ? "Every figure, to check." : "Alle Zahlen zum Nachprüfen."}
      </h2>
      <p class="section-intro">
        {en
          ? "Tax and money-laundering rules in one chart, each with its date, content and primary sources, then the full series behind the film."
          : "Steuer- und Geldwäsche-Regeln in einem Diagramm, jede mit Datum, Inhalt und Primärquellen, danach die ganzen Reihen hinter dem Film."}
      </p>

      <div class="history-chart">
        <HistoryStack
          language={language}
          chronicle={ruleChronicle}
          research={false}
        />
      </div>

      <div id="wirkung" class="history-figures">
        <YearColumns
          language={language}
          id="meldungen"
          title={en
            ? `${n(reportsLatest.received)} suspicion reports, ${n(reportsLatest.convictions)} convictions`
            : `${n(reportsLatest.received)} Verdachtsmeldungen, ${n(reportsLatest.convictions)} Verurteilungen`}
          note={en
            ? `Austria, ${first.year} to ${reportsLatest.year}, both on one scale. Convictions for money laundering are not linked to particular reports; the way reports are counted changed several times.`
            : `Österreich, ${first.year} bis ${reportsLatest.year}, beides auf einer Skala. Verurteilungen wegen Geldwäsche lassen sich einzelnen Meldungen nicht zuordnen; die Zählweise der Meldungen änderte sich mehrmals.`}
          unit={{ de: "Meldungen", en: "reports" }}
          second={{
            de: "Verurteilungen wegen Geldwäsche",
            en: "convictions for money laundering",
          }}
          rows={reportsByYear.map((row) => ({
            year: row.year,
            value: row.reports,
            second: row.convictions,
          }))}
          breaks={[2009, 2012, 2024, 2025]}
          sources={reportsByYearSources.map(label)}
        />
        <YearColumns
          language={language}
          id="konten"
          title={en
            ? "171 million accounts exchanged worldwide"
            : "171 Millionen Konten weltweit ausgetauscht"}
          note={en
            ? "Accounts on which tax authorities exchange data, in millions, by year of exchange. Reported by the tax administrations; accounts with several holders may count more than once."
            : "Konten, zu denen Steuerbehörden Daten austauschen, in Millionen, nach Jahr des Austauschs. Von den Steuerverwaltungen gemeldet; Konten mit mehreren Inhabern zählen womöglich mehrfach."}
          unit={{ de: "Mio. Konten", en: "million accounts" }}
          rows={accountsExchanged.map((row) => ({
            year: row.year,
            value: row.millions,
          }))}
          sources={accountsSources.map(label)}
        />
      </div>

      <div class="history-law">
        <LawGrowth language={language} />
      </div>

      <div class="history-tiles">
        <StatTiles
          tiles={effectTiles.map((tile) => ({
            figure: tile.figure[language],
            text: tile.text[language],
            source: label(tile.source),
          }))}
        />
      </div>

      <h3>
        {en ? "What the Commission and auditors say themselves" : "Was Kommission und Rechnungshöfe selbst sagen"}
      </h3>
      <ul class="history-admissions">
        {admissions.map((item) => (
          <li>
            <blockquote>
              <p>{item.quote[language]}</p>
            </blockquote>
            <p class="admission-who">
              {item.who[language]},{" "}
              <a href={item.source.href}>{item.source.label[language]}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="grenzen" class="band" aria-labelledby="grenzen-heading">
      <h2 id="grenzen-heading">
        {en ? "Even a rule that works needs limits." : "Auch eine Regel, die wirkt, braucht Grenzen."}
      </h2>
      <p class="section-intro">
        {en
          ? "Almost every one of these rules captures everyone who uses a bank or a provider, not those suspected of a crime. That needs a justification, whether the rule works or not. Investigations should start from a concrete suspicion."
          : "Fast jede dieser Regeln erfasst alle, die eine Bank oder einen Anbieter nutzen, nicht die, die einer Straftat verdächtig sind. Das braucht eine Begründung, ob die Regel wirkt oder nicht. Ermittelt werden soll bei konkretem Verdacht."}
      </p>
      <p class="history-next">
        <a class="text-link" href={pathFor("arguments", language)}>
          {en ? "Why financial privacy matters" : "Warum finanzielle Privatsphäre zählt"}
        </a>
      </p>
      <p class="history-research">
        {en
          ? `Research by Bitcoin Austria, as of ${historyResearchDate.en}. Every step, row and chart links to its primary sources.`
          : `Recherche von Bitcoin Austria, Stand: ${historyResearchDate.de}. Jeder Schritt, jede Zeile und jede Grafik verweist auf ihre Primärquellen.`}
      </p>
    </section>
  </article>
</Layout>

<style>
  .history-chart {
    margin-block-start: var(--space-xl);
  }

  .history-tiles,
  .history-law {
    margin-block-start: var(--space-2xl);
  }

  .history-law {
    max-inline-size: 52rem;
  }

  .campaign > section > h3 {
    margin-block-start: var(--space-2xl);
  }

  /* Die Grafiken eines Abschnitts in zwei Spalten, schmal untereinander. */
  .history-figures {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--space-2xl);
    margin-block-start: var(--space-2xl);
  }

  @container campaign (width >= 56rem) {
    .history-figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .admission-who a {
    color: var(--ink-3);
  }

  .admission-who a:hover {
    color: var(--ink);
  }

  .history-admissions {
    display: grid;
    gap: var(--space-l) var(--space-2xl);
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
  }

  @container campaign (width >= 56rem) {
    .history-admissions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .history-admissions li {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding-block-start: var(--space-s);
    border-block-start: 2px solid var(--ink);
  }

  .history-admissions blockquote {
    margin: 0;
    color: var(--ink);
    font-size: var(--type-lead);
    font-weight: 560;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .admission-who {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .history-next {
    margin-block-start: var(--space-l);
  }

  .history-research {
    margin-block-start: var(--space-xl);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }
</style>
