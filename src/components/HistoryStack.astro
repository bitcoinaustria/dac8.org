---
import {
  type Chronicle,
  entriesFor,
  historyAsOf,
  historyResearchDate,
  isAhead,
  stepsInForce,
  taxChronicle,
} from "@/data/history"
import type { Language } from "@/lib/i18n"

// The reporting duties as stacked bars: one row per step, from the year it
// applies until today, proposals beyond it. Read top to bottom, the stack
// grows towards DAC8, and the count below adds the rows up year by year.
// Every row opens in place with its text, facts and primary sources, and
// entries without a row of their own open inside the row they led to.
// "compact" is the version on the home page: only the steps about
// individuals and the proposal, plain bars without rows to open. The
// history page draws the same chart for each chronicle it tells.
interface Props {
  language: Language
  chronicle?: Chronicle
  compact?: boolean
  // The research line closes the last chart on a page.
  research?: boolean
}

const {
  language,
  chronicle = taxChronicle,
  compact = false,
  research = !compact,
} = Astro.props
const en = language === "en"
const entries = new Map(
  entriesFor(chronicle.entries, language, chronicle.who).map((entry) => [
    entry.id,
    entry,
  ]),
)
const entryFor = (id: string) => {
  const entry = entries.get(id)
  if (!entry) throw new Error(`History chart: no entry "${id}"`)
  return entry
}

const { axisStart, ticks, commons = [] } = chronicle
const axisEnd = 2031
const asOf = new Date(historyAsOf)
const thisYear = asOf.getUTCFullYear()
const today =
  thisYear + (asOf.getTime() - Date.UTC(thisYear, 0, 1)) / (365 * 86_400_000)
const at = (year: number) => ((year - axisStart) / (axisEnd - axisStart)) * 100
const x = (year: number) => `${at(year).toFixed(2)}%`

const shown = chronicle.stack.filter((group) => !compact || group.compact)
const rows = shown.flatMap((group) => group.rows)

// Links to the former timeline's chapters land on the first row of each.
const eraOf = new Map<string, string>()
for (const entry of entries.values()) {
  const isRow = rows.some((row) => row.id === entry.id)
  if (isRow && entry.era && ![...eraOf.values()].includes(entry.era))
    eraOf.set(entry.id, entry.era)
}

const groups = shown.map((group, g) => ({
  label: group.label[language],
  // The line's head, above its first group.
  domain:
    !compact && group.domain && group.domain.id !== shown[g - 1]?.domain?.id
      ? { id: group.domain.id, label: group.domain.label[language] }
      : undefined,
  rows: group.rows.map((row) => {
    const entry = entryFor(row.id)
    const kind = entry.status
    const end =
      row.until !== undefined ? row.until + 1 : isAhead(kind) ? axisEnd : today
    const span =
      kind === "proposed"
        ? en
          ? `planned from ${row.from}`
          : `geplant ab ${row.from}`
        : kind === "planned"
          ? en
            ? `applies from ${row.from}`
            : `gilt ab ${row.from}`
          : row.until !== undefined
            ? `${row.from}–${row.until}`
            : en
              ? `since ${row.from}`
              : `seit ${row.from}`
    const context = (row.context ?? []).map((id) => {
      const nested = entryFor(id)
      const before = nested.status !== "context"
      return {
        ...nested,
        kicker: `${before ? (en ? "Before" : "Davor") : en ? "Context" : "Umfeld"}, ${nested.year}`,
      }
    })
    return {
      ...row,
      entry,
      kind,
      era: eraOf.get(row.id),
      context,
      step: typeof row.step === "object" ? row.step[language] : row.step,
      what: row.what[language],
      plain: (row.plain ?? row.what)[language],
      span,
      style: `--from: ${x(row.from)}; --to: ${x(end)}`,
    }
  }),
}))

// The escalation in one sentence and one row of columns, both counted from
// the rows above: how many steps applied in each year.
const counted = rows.filter((row) => !isAhead(entryFor(row.id).status))
const legend = [
  { kind: "past", label: en ? "Applies" : "Gilt" },
  rows.some((row) => entryFor(row.id).status === "repealed") && {
    kind: "repealed",
    label: en ? "Repealed" : "Aufgehoben",
  },
  rows.some((row) => entryFor(row.id).status === "planned") && {
    kind: "planned",
    label: en ? "Adopted, applies later" : "Beschlossen, gilt später",
  },
  rows.some((row) => entryFor(row.id).status === "proposed") && {
    kind: "proposed",
    label: en ? "Proposal" : "Vorschlag",
  },
].filter((item): item is { kind: string; label: string } => Boolean(item))
const firstYear = Math.min(...counted.map((row) => row.from))
const columns = Array.from(
  { length: thisYear - axisStart + 1 },
  (_, i) => axisStart + i,
).map((year) => {
  const count = stepsInForce(counted, year)
  return {
    year,
    count,
    changed: count > 0 && count !== stepsInForce(counted, year - 1),
    style: `--at: ${x(year)}; --w: ${(at(Math.min(year + 1, today)) - at(year)).toFixed(2)}%; --n: ${count}; --i: ${year - axisStart}`,
  }
})
const peak = Math.max(...columns.map((column) => column.count))

const words = {
  de: "keine eine zwei drei vier fünf sechs sieben acht neun zehn elf zwölf dreizehn vierzehn fünfzehn sechzehn siebzehn achtzehn neunzehn zwanzig",
  en: "no one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty",
}
const say = (count: number) =>
  words[language].split(" ")[count] ?? String(count)
const milestones = [
  ...Array.from(
    { length: Math.ceil((thisYear - firstYear) / 10) },
    (_, i) => (Math.floor(firstYear / 10) + 1 + i) * 10,
  )
    .filter((year) => year < thisYear)
    .map((year) => ({ year, count: stepsInForce(counted, year) })),
  { year: thisYear, count: stepsInForce(counted, thisYear) },
]
const [first, ...rest] = milestones
const middle = rest.slice(0, -1)
const last = rest.at(-1) ?? first
const one = (count: number) => count === 1
const noun = chronicle.noun[language]
const titleId = `${chronicle.id}-title`
const were = (count: number) => (one(count) ? "war es" : "waren es")
type Part = string | { strong: string }
const sentence: Part[] = en
  ? [
      {
        strong: `${say(first.count).replace(/^./, (c) => c.toUpperCase())} ${noun}`,
      },
      ` applied in ${first.year}`,
      ...middle.flatMap((m) => [
        ", ",
        { strong: say(m.count) },
        ` in ${m.year}`,
      ]),
      " and ",
      { strong: say(last.count) },
      " today.",
    ]
  : [
      `${first.year} ${one(first.count) ? "galt" : "galten"} `,
      { strong: `${say(first.count)} ${noun}` },
      ...middle.flatMap((m) => [
        `, ${m.year} ${were(m.count)} `,
        { strong: say(m.count) },
      ]),
      `, heute ${one(last.count) ? "ist es" : "sind es"} `,
      { strong: say(last.count) },
      ".",
    ]
const counter = sentence
  .map((part) =>
    typeof part === "string" ? part : `<strong>${part.strong}</strong>`,
  )
  .join("")

let index = 0
---

<figure
  class:list={["stack", { compact }]}
  aria-labelledby={compact ? undefined : titleId}
  style={`--today: ${x(today)}; --peak: ${peak}`}
>
  {!compact && (
    <figcaption>
      <h3 id={titleId}>{chronicle.title[language]}</h3>
      <p class="figure-line" set:html={counter} />
      <p class="stack-note">{chronicle.note[language]}</p>
      <ul class="stack-legend" aria-hidden="true">
        {legend.map((item) => <li class={item.kind}>{item.label}</li>)}
      </ul>
    </figcaption>
  )}

  <div class="stack-axis" aria-hidden="true">
    <span class="stack-today">{en ? "Today" : "Heute"}</span>
  </div>

  {groups.map((group) => (
    <section class="stack-group" aria-label={group.label}>
      {group.domain && (
        <p class="stack-domain" id={group.domain.id}>
          {group.domain.label}
        </p>
      )}
      {!compact && <h4><span>{group.label}</span></h4>}
      <ul>
        {group.rows.map((row) => {
          const line = (
            <span class="stack-line">
              <strong
                >{row.what}<span class="visually-hidden">, {row.span}</span></strong
              >
              {row.step && <span class="stack-code">{row.step}</span>}
              <span class="stack-track" aria-hidden="true">
                <span class="stack-bar">
                  <span class="stack-year">{row.from}</span>
                </span>
              </span>
            </span>
          )
          return compact ? (
            <li class:list={["stack-row", row.kind]} style={`${row.style}; --i: ${index++}`}>
              <span class="stack-line">
                <span class="stack-plain"
                  >{row.plain}{row.kind === "proposed" && (
                    <span class="stack-span">, {row.span}</span>
                  )}</span
                >
                <span class="stack-track" aria-hidden="true">
                  <span class="stack-bar">
                    <span class="stack-year">{row.from}</span>
                  </span>
                </span>
              </span>
            </li>
          ) : (
            <li
              id={row.id}
              class:list={["stack-row", row.kind]}
              style={`${row.style}; --i: ${index++}`}
            >
              {row.era && <span id={row.era} class="stack-anchor" />}
              <details>
                <summary>{line}</summary>
                <div class="stack-detail">
                  {[row.entry, ...row.context].map((entry) => {
                    const nested = entry !== row.entry
                    return (
                      <div class="stack-entry" id={nested ? entry.id : undefined}>
                        {nested && (
                          <>
                            <p class="stack-kicker">{"kicker" in entry && entry.kicker}</p>
                            <h5>{entry.title}</h5>
                          </>
                        )}
                        <div class="stack-text">
                          <p>{entry.text}</p>
                          {entry.more && <p>{entry.more}</p>}
                        </div>
                        <div class="stack-facts">
                          <dl>
                            {entry.facts.map((fact) => (
                              <>
                                <dt>{fact.label}</dt>
                                <dd>{fact.text}</dd>
                              </>
                            ))}
                          </dl>
                          <ul class="stack-sources">
                            {entry.sources.map((source) => (
                              <li>
                                <a href={source.href}>{source.label}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    )
                  })}
                </div>
              </details>
            </li>
          )
        })}
      </ul>
    </section>
  ))}

  {!compact && (
    <div class="stack-sum" aria-hidden="true">
      <span class="stack-sum-label">
        {chronicle.sum[language]}
      </span>
      <span class="stack-track">
        {columns.map((column) => (
          <span
            class:list={["stack-col", { last: column.year === thisYear }]}
            style={column.style}
            title={`${column.year}: ${column.count}`}
          >
            {(column.changed || column.year === thisYear) && (
              <span class="stack-count">{column.count}</span>
            )}
          </span>
        ))}
      </span>
    </div>
  )}

  <div class="stack-axis bottom" aria-hidden="true">
    {ticks.map((tick) => <span style={`--at: ${x(tick)}`}>{tick}</span>)}
  </div>

  {!compact && commons.map((common, c) => (
    <details
      id={common.id}
      class:list={["stack-row", "stack-common", { follow: c > 0 }]}
    >
      <summary>
        <span class="stack-line">
          <strong>{common.translations[language].label}</strong>
          <span class="stack-what">
            {common.translations[language].summary}
          </span>
        </span>
      </summary>
      <div class="stack-detail">
        <div class="stack-entry">
          <div class="stack-text">
            {common.translations[language].text.map((text) => <p>{text}</p>)}
          </div>
          <div class="stack-facts">
            <ul class="stack-sources">
              {common.sources.map((source) => (
                <li>
                  <a href={source.href[language]}>{source.label[language]}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </details>
  ))}

  {research && (
    <>
      <p class="stack-research">
        {en
          ? `Research by Bitcoin Austria, as of ${historyResearchDate.en}. Every row links to its primary sources.`
          : `Recherche von Bitcoin Austria, Stand: ${historyResearchDate.de}. Jede Zeile verweist auf ihre Primärquellen.`}
      </p>
    </>
  )}
</figure>

<script>
  // Links into the page may point at an entry that now sits inside a closed
  // row, or at a chapter of the former timeline: open the row that holds it
  // and anything folded around the chart.
  const reveal = () => {
    const id = decodeURIComponent(location.hash.slice(1))
    const target = id ? document.getElementById(id) : null
    if (!target?.closest(".stack")) return
    const closed: HTMLDetailsElement[] = []
    let details: HTMLDetailsElement | null =
      target.closest("details") ??
      target.closest(".stack-row")?.querySelector("details") ??
      target.closest(".stack")?.closest("details") ??
      null
    while (details) {
      if (!details.open) closed.push(details)
      details = details.parentElement?.closest("details") ?? null
    }
    if (closed.length === 0) return
    for (const each of closed) each.open = true
    target.scrollIntoView({ block: "start" })
  }
  reveal()
  addEventListener("hashchange", reveal)
</script>

<style>
  .stack {
    /* Aufklapper, Bezeichnung, Kürzel, Spur. */
    --stack-cols: 1.75rem minmax(0, 14rem) 4.25rem minmax(0, 1fr);
    --bar: light-dark(#3b4147, #a7afb6);
    --today-line: color-mix(in oklab, var(--foreground) 50%, transparent);
    --row: 2rem;
    --brick: 0.4375rem;
    display: grid;
    margin: 0;
    font-size: var(--type-meta);
    line-height: 1.3;
  }

  /* ---------- Bildunterschrift ------------------------------------------ */

  figcaption:not(.section-intro) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-3xs) var(--space-m);
    margin-block-end: var(--space-m);
  }

  figcaption :is(h3, p) {
    grid-column: 1;
  }

  figcaption h3 {
    max-inline-size: none;
    font-size: var(--type-h3);
    font-stretch: 100%;
    line-height: 1.2;
    letter-spacing: -0.018em;
  }

  /* Überschrift und Satz laufen über die ganze Breite; die Legende steht
     rechts neben dem Hinweis darunter. */
  figcaption :is(h3, .figure-line) {
    grid-column: 1 / -1;
  }

  figcaption .figure-line {
    max-inline-size: none;
    margin-block-start: var(--space-2xs);
  }

  .stack-note {
    margin-block-start: var(--space-2xs);
    color: var(--ink-3);
  }

  .stack-legend {
    grid-column: 2;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    padding: 0;
    color: var(--ink-3);
    list-style: none;
  }

  .stack-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .stack-legend li::before {
    content: "";
    inline-size: 1.5rem;
    block-size: 0.5rem;
    border-radius: 3px;
    background: var(--swatch);
  }

  /* Gemeinsame Füllungen für Balken und Legende. */
  .past,
  .current {
    --swatch: var(--bar);
  }

  .repealed {
    --swatch: repeating-linear-gradient(
      135deg,
      color-mix(in oklab, var(--bar) 55%, transparent) 0 2px,
      transparent 2px 5px
    );
  }

  .stack-legend .repealed::before {
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--bar) 45%, transparent);
  }

  .proposed,
  .planned {
    --swatch: transparent;
  }

  .stack-legend .proposed::before {
    border: 1.5px dashed var(--ink-3);
  }

  .stack-legend .planned::before {
    border: 1.5px solid var(--bar);
  }

  /* ---------- Achse ------------------------------------------------------ */

  /* Jahre unten, „Heute“ oben, beide über der Spur. */
  .stack-axis {
    display: grid;
    grid-template-columns: var(--stack-cols);
    block-size: 1.5rem;
    color: var(--ink-3);
  }

  .stack-axis > * {
    grid-column: 4;
    grid-row: 1;
    align-self: end;
    justify-self: start;
    margin-inline-start: var(--at);
    translate: -50% 0;
    white-space: nowrap;
  }

  .stack-axis .stack-today {
    --at: var(--today);
    padding-block-end: 0.2rem;
    color: var(--ink);
    font-weight: var(--weight-heading);
  }

  /* Unten eine Grundlinie mit kurzen Strichen statt Hilfslinien. */
  .stack-axis.bottom::before {
    content: "";
    grid-column: 4;
    grid-row: 1;
    align-self: start;
    border-block-start: 1px solid var(--line);
  }

  .stack-axis.bottom > * {
    align-self: start;
    padding-block-start: 0.45rem;
    background:
      linear-gradient(var(--line), var(--line)) top center / 1px 0.3rem
      no-repeat;
  }

  /* Nur die Heute-Linie und die Zukunft rechts davon. Jede Spur trägt sie
     selbst, damit sie schmal mit der Spur umbrechen. */
  .stack {
    --track-bg:
      linear-gradient(var(--today-line), var(--today-line)) var(--today) 0 / 1px
      100% no-repeat,
      linear-gradient(
        to right,
        transparent var(--today),
        color-mix(in oklab, var(--foreground) 4%, transparent) var(--today)
      )
      0 0 / 100% 100% no-repeat;
  }

  /* ---------- Gruppen und Zeilen ---------------------------------------- */

  .stack-group h4 {
    display: grid;
    grid-template-columns: var(--stack-cols);
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-stretch: 100%;
    font-weight: var(--weight-heading);
    letter-spacing: 0.06em;
    line-height: var(--row);
    text-transform: uppercase;
  }

  /* Die Gruppe darf in die Spur ragen; die Heute-Linie läuft darunter. */
  .stack-group h4 span {
    z-index: 1;
    grid-column: 2 / -1;
    grid-row: 1;
    white-space: nowrap;
  }

  .stack-group h4::after {
    content: "";
    grid-column: 4;
    grid-row: 1;
    background: var(--track-bg);
  }

  .stack-group ul,
  .stack-sources {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-line {
    display: grid;
    grid-template-columns: var(--stack-cols);
    align-items: center;
    min-block-size: var(--row);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
  }

  .stack-line > strong {
    grid-column: 2;
    padding-inline-end: var(--space-s);
    color: var(--ink);
    font-weight: var(--weight-heading);
    text-wrap: pretty;
  }

  /* Was gemeldet wird, steht vorn. Das Kürzel des Rechtsakts folgt nur als
     leiser Verweis: DAC1 bis DAC9 kennt kaum jemand. */
  .stack-code {
    grid-column: 3;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .stack-track {
    position: relative;
    grid-column: 4;
    align-self: stretch;
    background: var(--track-bg);
  }

  .stack-bar {
    position: absolute;
    inset-block: 50% auto;
    inset-inline-start: var(--from);
    inline-size: calc(var(--to) - var(--from));
    block-size: 0.625rem;
    translate: 0 -50%;
    border-radius: 3px;
    background: var(--swatch);
    transform-origin: left center;
  }

  .repealed .stack-bar {
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--bar) 45%, transparent);
  }

  .proposed .stack-bar {
    border: 1.5px dashed var(--ink-3);
  }

  /* Beschlossen, aber erst ab einem späteren Jahr: durchgezogen umrandet. */
  .planned .stack-bar {
    border: 1.5px solid var(--bar);
  }

  /* Der Vorschlag beginnt knapp nach heute: seine Jahreszahl deckt die
     Heute-Linie ab, statt von ihr durchgestrichen zu werden. */
  :is(.proposed, .planned) .stack-year {
    padding-inline: 0.15rem;
    border-radius: 2px;
    background: var(--band-fill, var(--background));
  }

  .stack-year {
    position: absolute;
    inset-inline-end: calc(100% + 0.4rem);
    inset-block-start: 50%;
    translate: 0 -50%;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* Kompakt fehlen Gruppen und Legende: der Vorschlag nennt sein Jahr. */
  .stack-span {
    color: var(--ink-3);
  }

  .repealed .stack-line > strong {
    color: var(--ink-3);
  }

  /* Die jüngste Pflicht über Privatpersonen, in Markenrot: DAC8 bei den
     Steuern, die Namen bei jeder Übertragung bei der Geldwäsche. */
  .current {
    --swatch: var(--primary);
    --row-fill: color-mix(in oklab, var(--primary) 9%, transparent);
  }

  .current .stack-line {
    background: var(--row-fill);
  }

  .current .stack-line > strong,
  .current .stack-year {
    color: var(--accent);
  }

  .current .stack-bar {
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 28%, transparent);
  }

  /* ---------- Aufklappen ------------------------------------------------ */

  .stack-row {
    --open-fill: var(--panel);
  }

  .stack-row.current {
    --open-fill: color-mix(in oklab, var(--primary) 7%, var(--panel));
  }

  summary {
    display: block;
    border-radius: var(--radius-sm);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Ein kleiner Winkel vor der Kennung, der beim Öffnen nach unten kippt. */
  summary .stack-line::before {
    content: "";
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    justify-self: center;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-inline-end: 1.5px solid var(--ink-3);
    border-block-end: 1.5px solid var(--ink-3);
    rotate: -45deg;
    transition: rotate 0.15s ease;
  }

  details[open] > summary .stack-line::before {
    rotate: 45deg;
  }

  summary:hover .stack-line {
    background: var(--panel);
  }

  summary:hover .stack-code {
    color: var(--ink-2);
  }

  .current summary:hover .stack-line {
    background: color-mix(in oklab, var(--primary) 15%, transparent);
  }

  details[open] > summary .stack-line {
    border-end-start-radius: 0;
    border-end-end-radius: 0;
    background: var(--open-fill);
  }

  .stack-row,
  .stack-anchor {
    scroll-margin-block-start: var(--space-s);
  }

  .stack-row:target > details > summary .stack-line {
    box-shadow: inset 2px 0 0 var(--ink);
  }

