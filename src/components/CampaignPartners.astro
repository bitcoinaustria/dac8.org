---
import { languageFor, pathFor } from "@/lib/i18n"
import { supporters } from "@/data/supporters"
const language = languageFor(Astro.url.pathname)
const en = language === "en"
---

<div class="partners">
  <section aria-labelledby="legal-representation-heading">
    <h3 id="legal-representation-heading">
      {en ? "Legal representation" : "Rechtliche Vertretung"}
    </h3>
    <p class="prose">
      {en ? "Bitcoin Austria is represented in the proceedings by " : "Die rechtliche Vertretung im Verfahren übernimmt "}
      <a
        href={en ? "https://www.cerhahempel.com/lawyers/oliver-voelkel" : "https://www.cerhahempel.com/de/juristen/oliver-voelkel"}
        >Dr. Oliver Völkel, LL.M.</a
      >,
      {en ? "attorney at law and partner at CERHA HEMPEL in Vienna." : "Rechtsanwalt und Partner bei CERHA HEMPEL in Wien."}
    </p>
  </section>
  {supporters.length > 0 && (
    <section aria-labelledby="supporters-heading">
      <h3 id="supporters-heading">{en ? "Supporting organisations" : "Unterstützende Organisationen"}</h3>
      <ul>
        {supporters.map(({ name, url }) => <li><a href={url}>{name}</a></li>)}
      </ul>
    </section>
  )}
  <a class="text-link" href={`${pathFor("support", language)}#organisationen`}>
    {en ? "Support as an organisation" : "Als Organisation unterstützen"}
  </a>
</div>

<style>
  /* Satinierte Karte wie die Handlungskarten: die Vertretung ist ein
     Beleg, kein Fließtext. */
  .partners {
    display: grid;
    align-content: start;
    gap: var(--space-m);
    margin-block-start: var(--space-l);
    padding: var(--space-m) var(--space-m-l);
    border: 1px solid var(--material-edge-soft);
    border-radius: var(--radius-lg);
    background: var(--material-face);
    box-shadow: inset 0 1px 0 var(--material-shine);
  }

  .partners :global(.prose) {
    margin-block-start: var(--space-xs);
  }

  .partners :global(.text-link) {
    margin-block-start: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }
</style>
