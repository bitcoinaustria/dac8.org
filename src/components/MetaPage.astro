---
import { SITE } from "@/consts"
import { pageTitle } from "@/lib/content"

import { languageFor, pageFor, pathFor, feedFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const page = pageFor(Astro.url.pathname)

type Props = {
  title?: string
  description?: string
  noindex?: boolean
}

const {
  title,
  description = language === "en"
    ? "Against indiscriminate crypto-asset financial data collection. An initiative by Bitcoin Austria."
    : SITE.description,
  noindex = false,
} = Astro.props

const base = Astro.site ?? new URL(Astro.url.origin)
const ogTitle = title ?? SITE.title
const fullTitle = title ? pageTitle(title) : SITE.title
const canonical = new URL(Astro.url.pathname, base)
const ogImage = new URL(SITE.defaultPageImage, base)
---

<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{page && <>
  <link rel="alternate" hreflang="de" href={new URL(pathFor(page, "de"), base)} />
  <link rel="alternate" hreflang="en" href={new URL(pathFor(page, "en"), base)} />
  <link rel="alternate" hreflang="x-default" href={new URL(pathFor(page, "de"), base)} />
</>}
<link
  rel="alternate"
  type="application/rss+xml"
  title={language === "en" ? "Campaign updates" : "Neuigkeiten zum Verfahren"}
  href={feedFor(language)}
>
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE.title}>
<meta property="og:locale" content={language === "en" ? "en_GB" : "de_AT"}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogTitle}>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogTitle}>
