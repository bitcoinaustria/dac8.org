---
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

// "Your DAC8 file": one question and a plain answer. Earlier versions asked
// for residence, years and activities and answered with a mock report, a
// chart and key figures; readers found that too hard to follow (October 2026
// feedback). The answer restates the vetted wording of the dossier
// (#gemeldet, FAQ) and of AffectedCheck.astro in everyday words, so change
// them together. Two rules from the campaign lawyer's notes still hold: the
// report never says which wallet is yours, and what goes to the tax office
// stays apart from what the provider keeps. CSS :has() shows the answer to
// the chosen option, so the page needs no script.
const { language } = Astro.props
const en = language === "en"
const section20 =
  "https://www.ris.bka.gv.at/Dokumente/Bundesnormen/NOR40273819/NOR40273819.pdf"
const fmgwg =
  "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=20009769"

const options = en
  ? [
      {
        value: "provider",
        label: "Yes",
        title: "Then you are affected.",
        text: [
          "From 2026, your provider tells the tax authority every year who you are and how much crypto you bought, sold, swapped and sent. Wallet addresses are not in the report. If you live in Germany or another EU country, it goes on to the tax authority there.",
          "It keeps every report for ten years. If you stay a customer, from 2036 it will always hold ten reports on you.",
          "It already holds your ID, your wallet addresses and every single transaction. Anti-money-laundering rules currently require that until ten years after you leave.",
        ],
      },
      {
        value: "self",
        label: "No, never through a provider",
        title: "Then DAC8 does not report you.",
        text: [
          "That holds as long as you never buy, sell or hold crypto through an exchange, broker or app.",
          "If you have done so since 2020, that provider still holds your ID, your wallet addresses and your transactions, currently until ten years after you leave.",
          "Data risks remain even without a provider: anyone who orders a hardware wallet online leaves their name and home address with the shop. In 2020 the addresses of 272,000 buyers ended up online this way. The less is collected about you, the less can be lost.",
        ],
      },
      {
        value: "unsure",
        label: "Not sure",
        title: "It depends on where you buy crypto.",
        text: [
          "Exchanges, brokers and apps where you buy crypto or leave it count as providers, including banks that offer crypto.",
          "Your provider has to tell you before it reports for the first time. If in doubt, ask it.",
        ],
      },
    ]
  : [
      {
        value: "provider",
        label: "Ja",
        title: "Dann bist du betroffen.",
        text: [
          "Dein Anbieter meldet ab 2026 jedes Jahr ans Finanzamt, wer du bist und wie viel Krypto du gekauft, verkauft, getauscht und verschickt hast. Wallet-Adressen stehen nicht darin. Lebst du in Deutschland oder einem anderen EU-Land, geht die Meldung an die Steuerbehörde dort weiter.",
          "Jede Meldung hebt er zehn Jahre auf. Bleibst du Kunde, liegen bei ihm ab 2036 immer zehn Meldungen über dich.",
          "Deinen Ausweis, deine Wallet-Adressen und jede einzelne Transaktion hat er schon jetzt. Das verlangen die Regeln gegen Geldwäsche, derzeit bis zehn Jahre nach deiner Kündigung.",
        ],
      },
      {
        value: "self",
        label: "Nein, nie über einen Anbieter",
        title: "Dann meldet DAC8 dich nicht.",
        text: [
          "Das gilt, solange du nie über eine Börse, einen Broker oder eine App Krypto kaufst, verkaufst oder verwahrst.",
          "Hast du das seit 2020 getan, hat dieser Anbieter deinen Ausweis, deine Wallet-Adressen und deine Transaktionen noch, derzeit bis zehn Jahre nach deiner Kündigung.",
          "Datenrisiken gibt es auch ohne Anbieter: Wer eine Hardware-Wallet online bestellt, hinterlässt Name und Wohnadresse beim Shop. 2020 gelangten so die Anschriften von 272.000 Käufern ins Netz. Je weniger über dich gesammelt wird, desto weniger kann verloren gehen.",
        ],
      },
      {
        value: "unsure",
        label: "Weiß ich nicht",
        title: "Das hängt davon ab, wo du Krypto kaufst.",
        text: [
          "Als Anbieter zählen Börsen, Broker und Apps, bei denen du Krypto kaufst oder liegen lässt, auch Banken mit Krypto-Angebot.",
          "Dein Anbieter muss dich informieren, bevor er zum ersten Mal meldet. Frag im Zweifel nach.",
        ],
      },
    ]
---

<section
  id="akte"
  class="dac-file"
  aria-label={en ? "Your DAC8 file" : "Deine DAC8-Akte"}
>
  <fieldset class="file-question">
    <legend>
      {en ? "Do you buy, sell or hold crypto through an exchange, broker or app?" : "Kaufst, verkaufst oder verwahrst du Krypto über eine Börse, einen Broker oder eine App?"}
    </legend>
    <div class="file-options">
      {options.map((option, index) => (
        <label>
          <input
            type="radio"
            name="provider"
            value={option.value}
            checked={index === 0}
          />
          <span>{option.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  {options.map((option) => (
    <div class="file-answer" data-answer={option.value}>
      <p class="file-answer-title">{option.title}</p>
      {option.text.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  ))}

  <p class="file-sources">
    <a href={section20}
      >{en ? "Section 20 Krypto-MPfG" : "§ 20 Krypto-MPfG"}</a
    >, <a href={fmgwg}>{en ? "Section 21 FM-GwG" : "§ 21 FM-GwG"}</a>
  </p>
</section>

<style>
  /* Eine Frage auf einer ruhigen Fläche, die Antwort in ein paar Sätzen.
     Breit steht die Antwort neben der Frage, schmal darunter. */
  .dac-file {
    display: grid;
    gap: var(--space-l) var(--space-2xl);
    padding: var(--space-l) var(--space-m-l);
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  @container campaign (width >= 60rem) {
    .dac-file {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      align-items: start;
    }

    .file-question {
      grid-row: 1 / span 2;
    }

    .file-answer,
    .file-sources {
      grid-column: 2;
    }
  }

  .file-question {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .file-question legend {
    padding: 0;
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .file-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-m);
  }

  .file-options label {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  .file-options input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .file-options span {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.4em 1.1em;
    border: 1px solid color-mix(in oklab, var(--ink) 28%, transparent);
    border-radius: var(--radius-full);
    background: var(--paper);
    font-weight: 560;
    line-height: 1.25;
    transition:
      background-color 140ms ease,
      color 140ms ease,
      border-color 140ms ease;
  }

  .file-options label:hover span {
    border-color: var(--ink);
  }

  .file-options input:checked + span {
    border-color: var(--ink);
    color: var(--background);
    background: var(--ink);
  }

  .file-options input:focus-visible + span {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  /* Nur die Antwort zur gewählten Option ist zu sehen. */
  .file-answer {
    display: none;
    gap: var(--space-s);
  }

  .dac-file:has(input[value="provider"]:checked) [data-answer="provider"],
  .dac-file:has(input[value="self"]:checked) [data-answer="self"],
  .dac-file:has(input[value="unsure"]:checked) [data-answer="unsure"] {
    display: grid;
  }

  .file-answer-title {
    font-size: clamp(1.625rem, 1.25rem + 1.5vw, 2.25rem);
    font-weight: 600;
    font-stretch: 94%;
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .file-answer p:not(.file-answer-title) {
    max-inline-size: var(--measure-text);
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .file-sources {
    color: var(--ink-3);
    font-size: var(--step--1);
  }
</style>
