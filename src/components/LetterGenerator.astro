---
import {
  buildLetter,
  type LetterFacts,
  letterDefaults,
  letterParts,
  letterPresets,
  letterSubject,
} from "@/data/letter"
import { attacks, countIn, euCountries, latestYear } from "@/lib/attacks"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
// Counted here because the attack archive is too large for the script.
const facts: LetterFacts = {
  attacks: attacks.length,
  year: latestYear,
  inYear: countIn(latestYear),
  inYearEu: countIn(latestYear, euCountries),
}
const initial = buildLetter(
  language,
  {
    recipient: "",
    sender: "",
    location: "",
    personal: "",
    chosen: letterDefaults,
  },
  facts,
)
const directory =
  "https://www.parlament.gv.at/recherchieren/personen/nationalrat"
const steps = en
  ? ["Content", "About you", "Read and send"]
  : ["Inhalt", "Von dir", "Lesen und senden"]
const presets = [
  { id: "short", label: en ? "Short" : "Kurz" },
  { id: "standard", label: "Standard" },
  { id: "long", label: en ? "Detailed" : "Ausführlich" },
]
const groups = [
  {
    legend: en ? "Arguments" : "Argumente",
    parts: letterParts.reasons,
  },
  {
    legend: en ? "Demands" : "Forderungen",
    parts: letterParts.demands,
  },
]
---

<div
  class="letter"
  data-letter
  data-letter-facts={JSON.stringify(facts)}
  data-letter-presets={JSON.stringify(letterPresets)}
  data-letter-language={language}
  data-copy-scope
>
  <ol class="letter-steps">
    {steps.map((step, index) => (
        <li>
          <button
            type="button"
            data-letter-go={index}
            aria-current={index === 0 ? "step" : undefined}
          >
            <span>{index + 1}</span>
            {step}
          </button>
        </li>
      ))}
  </ol>

  <form class="letter-form" data-letter-form>
    <section data-letter-step>
      <h3 tabindex="-1">
        {en ? "What should the letter say?" : "Was soll im Brief stehen?"}
      </h3>
      <fieldset class="letter-pills">
        <legend>{en ? "Quick choice" : "Schnellauswahl"}</legend>
        {presets.map((preset) => (
            <label>
              <input
                type="radio"
                name="preset"
                value={preset.id}
                checked={preset.id === "standard"}
              />
              <span>{preset.label}</span>
            </label>
          ))}
      </fieldset>
      {groups.map((group) => (
          <fieldset class="letter-parts" data-letter-custom>
            <legend>{group.legend}</legend>
            {group.parts.map((part) => (
              <label>
                <input
                  type="checkbox"
                  name="chosen"
                  value={part.id}
                  checked={part.on}
                />
                <strong>{part.label[language]}</strong>
                <span>{part.hint[language]}</span>
              </label>
            ))}
          </fieldset>
        ))}
      <div class="letter-nav">
        <button class="button primary" type="button" data-letter-go="1">
          {en ? "Next" : "Weiter"}
        </button>
        <p class="letter-length" data-letter-length aria-live="polite"></p>
      </div>
    </section>

    <section data-letter-step>
      <h3 tabindex="-1">
        {en ? "About you, if you like" : "Von dir, wenn du magst"}
      </h3>
      <p class="letter-note">
        {en ? "You can leave this empty and add it in your email program. Everything stays in your browser." : "Du kannst es leer lassen und im Mailprogramm ergänzen. Alles bleibt in deinem Browser."}
      </p>
      <div class="form-grid">
        <label class="field">
          <span>{en ? "Your name" : "Dein Name"}</span>
          <input name="sender" autocomplete="name">
        </label>
        <label class="field">
          <span
            >{en ? "Your town or federal state" : "Dein Ort oder Bundesland"}</span
          >
          <input name="location" autocomplete="address-level2">
        </label>
        <label class="field wide">
          <span
            >{en ? "Why does this matter to you?" : "Warum ist dir das wichtig?"}</span
          >
          <textarea
            name="personal"
            rows="3"
            placeholder={en ? "One or two sentences in your own words carry more weight than any template." : "Ein, zwei Sätze in deinen eigenen Worten wiegen mehr als jede Vorlage."}
          ></textarea>
        </label>
      </div>
      <fieldset class="letter-parts">
        <legend>
          {en ? "Sentences you can add" : "Sätze, die du dazunehmen kannst"}
        </legend>
        {letterParts.about.map((part) => (
            <label>
              <input type="checkbox" name="chosen" value={part.id} />
              <strong>{part.label[language]}</strong>
              <span>{part.hint[language]}</span>
            </label>
          ))}
      </fieldset>
      <div class="letter-nav">
        <button class="button" type="button" data-letter-go="0">
          {en ? "Back" : "Zurück"}
        </button>
        <button class="button primary" type="button" data-letter-go="2">
          {en ? "Next" : "Weiter"}
        </button>
      </div>
    </section>

    <section data-letter-step>
      <h3 tabindex="-1">{en ? "Read and send" : "Lesen und senden"}</h3>
      <div class="form-grid">
        <label class="field">
          <span
            >{en ? "Name of the MP" : "Name der oder des Abgeordneten"}</span
          >
          <input name="recipient" autocomplete="off">
        </label>
        <label class="field">
          <span
            >{en ? "Email of the MP" : "E-Mail der oder des Abgeordneten"}</span
          >
          <input name="recipientEmail" type="email" autocomplete="off">
        </label>
      </div>
      <p class="letter-note">
        {en ? "You can also enter both in your email program. " : "Beides kannst du auch erst im Mailprogramm eintragen. "}
        <a href={directory}>{en ? "Find your MPs" : "Abgeordnete finden"}</a>
      </p>
      <label class="field">
        <span>{en ? "Subject" : "Betreff"}</span>
        <input data-letter-subject readonly value={letterSubject[language]}>
      </label>
      <label class="field">
        <span>{en ? "Letter, editable" : "Brief, bearbeitbar"}</span>
        <textarea data-letter-text rows="22">{initial}</textarea>
      </label>
      <p class="letter-edited" data-letter-edited hidden>
        <span
          >{en ? "You have edited the letter, so your choices in the steps before no longer reach it." : "Du hast den Brief bearbeitet, darum fließt deine Auswahl aus den Schritten davor nicht mehr ein."}</span
        >
        <button class="text-link" type="button" data-letter-reset>
          {en ? "Rebuild letter" : "Brief neu erstellen"}
        </button>
      </p>
      <div class="letter-nav">
        <a
          class="button primary"
          data-letter-mail
          href={`mailto:?subject=${encodeURIComponent(letterSubject[language])}`}
        >
          {en ? "Open in email" : "In E-Mail öffnen"}
        </a>
        <button class="button" type="button" data-letter-copy>
          {en ? "Copy text" : "Text kopieren"}
        </button>
        <button class="button" type="button" data-letter-go="1">
          {en ? "Back" : "Zurück"}
        </button>
      </div>
      <p class="copy-status" data-copy-status aria-live="polite"></p>
      <p class="letter-note">
        {en ? "You send the letter yourself; dac8.org receives and stores nothing. If the email opens empty, copy the text instead. " : "Du sendest den Brief selbst; dac8.org bekommt und speichert nichts. Öffnet sich die E-Mail leer, kopiere stattdessen den Text. "}
        <button class="text-link" type="button" data-letter-switch></button>
      </p>
    </section>
  </form>
</div>

<style>
  /* Three steps, one at a time, without a box: the fields carry their own
     edges. */
  .letter {
    display: grid;
    gap: var(--space-m);
    max-inline-size: 48rem;
    margin-block-start: var(--space-l);
    scroll-margin-block-start: calc(var(--header-height) + var(--space-s));
  }

  .letter-steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .letter-steps button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: 2.75rem;
    padding: 0;
    border: 0;
    color: var(--ink-3);
    background: none;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 560;
    cursor: pointer;
  }

  .letter-steps span {
    display: inline-grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-full);
  }

  .letter-steps [aria-current] {
    color: var(--ink);
  }

  .letter-steps [aria-current] span {
    border-color: var(--ink);
    color: var(--background);
    background: var(--ink);
  }

  .letter-steps button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  .letter-form section {
    display: grid;
    gap: var(--space-s);
    min-inline-size: 0;
  }

  .letter-form section[hidden] {
    display: none;
  }

  .letter-form h3 {
    margin: 0;
  }

  .letter-form h3:focus {
    outline: none;
  }

  .letter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .letter-pills label {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  .letter-pills input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .letter-pills span {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.45em 1em;
    border: 1px solid color-mix(in oklab, var(--ink) 30%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 560;
  }

  .letter-pills input:checked + span {
    border-color: var(--ink);
    color: var(--background);
    background: var(--ink);
  }

  .letter-pills input:focus-visible + span {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  .letter-pills legend,
  .letter-parts legend {
    float: left;
    inline-size: 100%;
    margin-block-end: var(--space-2xs);
    padding: 0;
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 560;
  }

  .letter-length {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  /* Each part is a card to tap: the title, and one line on what it adds. */
  .letter-parts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .letter-parts legend {
    grid-column: 1 / -1;
  }

  .letter-parts label {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
    padding: var(--space-xs) var(--space-s);
    padding-inline-end: var(--space-l);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font-size: var(--step--1);
    cursor: pointer;
  }

  .letter-parts label:hover {
    border-color: var(--gray-8);
  }

  .letter-parts input {
    position: absolute;
    inset-block-start: var(--space-xs);
    inset-inline-end: var(--space-xs);
    inline-size: 1.1rem;
    block-size: 1.1rem;
    margin: 0;
    accent-color: var(--ink);
  }

  .letter-parts label > span {
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .letter-parts label:has(input:checked) {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .letter-parts label:has(input:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  [data-letter-text] {
    min-block-size: 28rem;
    line-height: 1.55;
    resize: vertical;
  }

  [data-letter-subject] {
    color: var(--ink);
    font-weight: 560;
  }

  .letter-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }

  .letter-edited {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-xs);
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .letter-edited[hidden] {
    display: none;
  }

  .letter .text-link {
    margin-block-start: 0;
  }

  .copy-status {
    min-block-size: 1.5em;
    color: var(--accent);
    font-size: var(--step--1);
  }

  .letter-note {
    max-inline-size: 60ch;
    color: var(--ink-3);
    font-size: var(--step--1);
    text-wrap: pretty;
  }
</style>

<script>
  import { buildLetter, type LetterFacts, letterSubject } from "@/data/letter"
  import type { Language } from "@/lib/i18n"
  import { copyText } from "@/lib/share"

  for (const root of document.querySelectorAll<HTMLElement>("[data-letter]")) {
    const form = root.querySelector<HTMLFormElement>("[data-letter-form]")
    const output = root.querySelector<HTMLTextAreaElement>("[data-letter-text]")
    const subject = root.querySelector<HTMLInputElement>(
      "[data-letter-subject]",
    )
    const mail = root.querySelector<HTMLAnchorElement>("[data-letter-mail]")
    const copy = root.querySelector<HTMLButtonElement>("[data-letter-copy]")
    const status = root.querySelector<HTMLElement>("[data-copy-status]")
    const notice = root.querySelector<HTMLElement>("[data-letter-edited]")
    const reset = root.querySelector<HTMLButtonElement>("[data-letter-reset]")
    const length = root.querySelector<HTMLElement>("[data-letter-length]")
    const switcher = root.querySelector<HTMLButtonElement>(
      "[data-letter-switch]",
    )
    if (
      !form ||
      !output ||
      !subject ||
      !mail ||
      !copy ||
      !notice ||
      !reset ||
      !length ||
      !switcher
    )
      continue

    const facts = JSON.parse(root.dataset.letterFacts ?? "{}") as LetterFacts
    const presets = JSON.parse(root.dataset.letterPresets ?? "{}") as Record<
      string,
      string[]
    >
    const en = document.documentElement.lang.startsWith("en")
    // The letter starts in the language of the page; the last step can
    // switch it.
    let language = (
      root.dataset.letterLanguage === "en" ? "en" : "de"
    ) as Language
    let edited = false
    const setEdited = (value: boolean) => {
      edited = value
      notice.hidden = !value
    }
    const value = (name: string) =>
      String(new FormData(form).get(name) ?? "").trim()

    const updateMail = () => {
      const to = value("recipientEmail")
      const query = `subject=${encodeURIComponent(subject.value)}&body=${encodeURIComponent(output.value)}`
      mail.href = `mailto:${encodeURIComponent(to).replace("%40", "@")}?${query}`
    }

    const render = () => {
      subject.value = letterSubject[language]
      const letter = buildLetter(
        language,
        {
          recipient: value("recipient"),
          sender: value("sender"),
          location: value("location"),
          personal: value("personal"),
          chosen: new FormData(form).getAll("chosen").map(String),
        },
        facts,
      )
      if (!edited) output.value = letter
      const words = Math.round(letter.split(/\s+/).length / 10) * 10
      // English runs longer than German for the same parts.
      const [medium, long] = language === "en" ? [400, 520] : [350, 450]
      const size = words < medium ? 0 : words < long ? 1 : 2
      length.textContent = en
        ? `About ${words} words, ${["short", "medium", "long"][size]}.`
        : `Rund ${words} Wörter, ${["kurz", "mittel", "lang"][size]}.`
      switcher.textContent =
        language === "de"
          ? en
            ? "Switch the letter to English"
            : "Brief auf Englisch umstellen"
          : en
            ? "Switch the letter to German"
            : "Brief auf Deutsch umstellen"
      updateMail()
    }

    const sections = [
      ...root.querySelectorAll<HTMLElement>("[data-letter-step]"),
    ]
    const show = (step: number, focus: boolean) => {
      sections.forEach((section, index) => {
        section.hidden = index !== step
      })
      for (const button of root.querySelectorAll<HTMLElement>(
        ".letter-steps [data-letter-go]",
      )) {
        if (Number(button.dataset.letterGo) === step)
          button.setAttribute("aria-current", "step")
        else button.removeAttribute("aria-current")
      }
      if (!focus) return
      if (root.getBoundingClientRect().top < 0)
        root.scrollIntoView({ block: "start" })
      sections[step]?.querySelector("h3")?.focus({ preventScroll: true })
    }
    root.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>(
        "[data-letter-go]",
      )
      if (button) show(Number(button.dataset.letterGo), true)
    })

    form.addEventListener("input", (event) => {
      const target = event.target as HTMLInputElement
      if (target.name === "preset") {
        // A preset sets arguments and demands, never the sentences about
        // the reader.
        for (const box of form.querySelectorAll<HTMLInputElement>(
          '[data-letter-custom] input[name="chosen"]',
        ))
          box.checked = presets[target.value]?.includes(box.value) ?? false
      } else if (
        target.name === "chosen" &&
        target.closest("[data-letter-custom]")
      ) {
        for (const preset of form.querySelectorAll<HTMLInputElement>(
          'input[name="preset"]',
        ))
          preset.checked = false
      }
      render()
    })
    form.addEventListener("submit", (event) => event.preventDefault())
    output.addEventListener("input", () => {
      setEdited(true)
      updateMail()
    })
    reset.addEventListener("click", () => {
      setEdited(false)
      render()
    })
    switcher.addEventListener("click", () => {
      // Switching the language rebuilds the letter, so ask before manual
      // edits are lost.
      if (
        edited &&
        !confirm(
          en
            ? "Switching the language replaces your edits. Continue?"
            : "Der Sprachwechsel ersetzt deine Änderungen. Fortfahren?",
        )
      )
        return
      language = language === "de" ? "en" : "de"
      setEdited(false)
      render()
    })
    copy.addEventListener("click", async () => {
      const copied = await copyText(`${subject.value}\n\n${output.value}`)
      if (status)
        status.textContent = copied
          ? en
            ? "Subject and letter copied."
            : "Betreff und Brief kopiert."
          : en
            ? "Could not copy. Please select the text."
            : "Kopieren nicht möglich. Bitte den Text markieren."
    })
    show(0, false)
    render()
  }
</script>
