---
import { buildLetter, letterSubject } from "@/data/letter"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const initial = buildLetter("de", {
  salutation: "neutral",
  recipient: "",
  sender: "",
  location: "",
  personal: "",
})
const directory =
  "https://www.parlament.gv.at/recherchieren/personen/nationalrat"
---

<div class="letter" data-letter data-copy-scope>
  <form class="letter-form" data-letter-form>
    <fieldset class="letter-language">
      <legend>{en ? "Letter language" : "Sprache des Briefs"}</legend>
      <label>
        <input type="radio" name="letterLanguage" value="de" checked>
        <span>Deutsch</span>
      </label>
      <label>
        <input type="radio" name="letterLanguage" value="en">
        <span>English</span>
      </label>
    </fieldset>
    <div class="form-grid">
      <label class="field">
        <span>{en ? "Salutation" : "Anrede"}</span>
        <select name="salutation">
          <option value="female">{en ? "Ms" : "Frau"}</option>
          <option value="male">{en ? "Mr" : "Herr"}</option>
          <option value="neutral" selected>
            {en ? "Name only" : "Nur Name"}
          </option>
        </select>
      </label>
      <label class="field">
        <span>{en ? "Name of the MP" : "Name des Abgeordneten"}</span>
        <input name="recipient" autocomplete="off">
      </label>
      <label class="field wide">
        <span>{en ? "Email of the MP" : "E-Mail des Abgeordneten"}</span>
        <input name="recipientEmail" type="email" autocomplete="off">
      </label>
      <label class="field">
        <span>{en ? "Your name" : "Dein Name"}</span>
        <input name="sender" autocomplete="name">
      </label>
      <label class="field">
        <span
          >{en ? "Your town or federal state" : "Dein Ort oder Bundesland"}</span
        >
        <input name="location" autocomplete="address-level1">
      </label>
      <label class="field wide">
        <span
          >{en ? "Why does this matter to you? (optional)" : "Warum ist dir das wichtig? (optional)"}</span
        >
        <textarea
          name="personal"
          rows="3"
          placeholder={en ? "One or two sentences in your own words carry more weight than any template." : "Ein, zwei Sätze in deinen eigenen Worten wiegen mehr als jede Vorlage."}
        ></textarea>
      </label>
    </div>
  </form>

  <div class="letter-output">
    <label class="field">
      <span>{en ? "Subject" : "Betreff"}</span>
      <input data-letter-subject readonly value={letterSubject.de}>
    </label>
    <label class="field">
      <span>{en ? "Letter, editable" : "Brief, bearbeitbar"}</span>
      <textarea data-letter-text rows="22">{initial}</textarea>
    </label>
    <div class="output-actions">
      <a
        class="button primary"
        data-letter-mail
        href={`mailto:?subject=${encodeURIComponent(letterSubject.de)}`}
      >
        {en ? "Open in email" : "In E-Mail öffnen"}
      </a>
      <button class="button" type="button" data-letter-copy>
        {en ? "Copy text" : "Text kopieren"}
      </button>
      <a class="text-link" href={directory}>
        {en ? "Find your MPs" : "Abgeordnete finden"}
      </a>
    </div>
    <p class="copy-status" data-copy-status aria-live="polite"></p>
    <p class="letter-note">
      {en ? "Everything stays in your browser. Nothing is sent to or stored by dac8.org. Read the letter before you send it; you send it yourself." : "Alles bleibt in deinem Browser. Nichts wird an dac8.org gesendet oder gespeichert. Lies den Brief, bevor du ihn abschickst; du sendest ihn selbst."}
    </p>
  </div>
</div>

<style>
  /* Formular und Brief nebeneinander, ohne Kasten: Die Felder tragen ihre
     eigenen Kanten. */
  .letter {
    display: grid;
    align-items: start;
    gap: var(--space-l) var(--space-xl);
    margin-block-start: var(--space-l);
  }

  .letter-form,
  .letter-output {
    display: grid;
    gap: var(--space-s);
    min-inline-size: 0;
  }

  .letter-form .form-grid {
    align-items: end;
  }

  .letter-language {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .letter-language legend {
    float: left;
    margin-inline-end: var(--space-xs);
    padding: 0;
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 560;
  }

  .letter-language label {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  .letter-language input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .letter-language span {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.45em 1em;
    border: 1px solid color-mix(in oklab, var(--ink) 30%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 560;
  }

  .letter-language input:checked + span {
    border-color: var(--ink);
    color: var(--background);
    background: var(--ink);
  }

  .letter-language input:focus-visible + span {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  [data-letter-text] {
    min-block-size: 28rem;
    line-height: 1.55;
    resize: vertical;
  }

  [data-letter-subject] {
    color: var(--ink);
    font-weight: 560;
  }

  .output-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }

  .output-actions .text-link {
    margin-block-start: 0;
  }

  .copy-status {
    min-block-size: 1.5em;
    color: var(--accent);
    font-size: var(--step--1);
  }

  .letter-note {
    max-inline-size: 60ch;
    color: var(--ink-3);
    font-size: var(--step--1);
    text-wrap: pretty;
  }

  @container campaign (width >= 56rem) {
    .letter {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .letter-output {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-s));
    }
  }
</style>

<script>
  import { buildLetter, type LetterFields, letterSubject } from "@/data/letter"
  import type { Language } from "@/lib/i18n"
  import { copyText } from "@/lib/share"

  for (const root of document.querySelectorAll<HTMLElement>("[data-letter]")) {
    const form = root.querySelector<HTMLFormElement>("[data-letter-form]")
    const output = root.querySelector<HTMLTextAreaElement>("[data-letter-text]")
    const subject = root.querySelector<HTMLInputElement>(
      "[data-letter-subject]",
    )
    const mail = root.querySelector<HTMLAnchorElement>("[data-letter-mail]")
    const copy = root.querySelector<HTMLButtonElement>("[data-letter-copy]")
    const status = root.querySelector<HTMLElement>("[data-copy-status]")
    if (!form || !output || !subject || !mail || !copy) continue

    const en = document.documentElement.lang.startsWith("en")
    let edited = false
    const value = (name: string) =>
      String(new FormData(form).get(name) ?? "").trim()
    const language = () =>
      (value("letterLanguage") === "en" ? "en" : "de") as Language

    const updateMail = () => {
      const to = value("recipientEmail")
      const query = `subject=${encodeURIComponent(subject.value)}&body=${encodeURIComponent(output.value)}`
      mail.href = `mailto:${encodeURIComponent(to).replace("%40", "@")}?${query}`
    }

    const render = () => {
      subject.value = letterSubject[language()]
      if (!edited) {
        output.value = buildLetter(language(), {
          salutation: value("salutation") as LetterFields["salutation"],
          recipient: value("recipient"),
          sender: value("sender"),
          location: value("location"),
          personal: value("personal"),
        })
      }
      updateMail()
    }

    form.addEventListener("input", (event) => {
      // Switching the language rebuilds the letter even after manual edits.
      if ((event.target as HTMLInputElement).name === "letterLanguage")
        edited = false
      render()
    })
    form.addEventListener("submit", (event) => event.preventDefault())
    output.addEventListener("input", () => {
      edited = true
      updateMail()
    })
    copy.addEventListener("click", async () => {
      const copied = await copyText(`${subject.value}\n\n${output.value}`)
      if (status)
        status.textContent = copied
          ? en
            ? "Subject and letter copied."
            : "Betreff und Brief kopiert."
          : en
            ? "Could not copy. Please select the text."
            : "Kopieren nicht möglich. Bitte den Text markieren."
    })
    render()
  }
</script>
