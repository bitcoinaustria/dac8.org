---
import { languageFor, pageFor, pathFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)
const page = pageFor(Astro.url.pathname) ?? "home"
---

<div
  class="languages"
  role="group"
  aria-label={language === "en" ? "Language" : "Sprache"}
>
  <a
    href={pathFor(page, "de")}
    lang="de"
    hreflang="de"
    aria-label="Deutsch"
    aria-current={language === "de" ? "true" : undefined}
    >DE</a
  >
  <span aria-hidden="true">/</span>
  <a
    href={pathFor(page, "en")}
    lang="en"
    hreflang="en"
    aria-label="English"
    aria-current={language === "en" ? "true" : undefined}
    >EN</a
  >
</div>
<style>
  .languages {
    display: inline-flex;
    align-items: center;
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }
  .languages > span {
    color: var(--border);
  }
  a {
    display: grid;
    place-items: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    text-decoration: none;
    color: inherit;
  }
  a[aria-current] {
    color: var(--foreground);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  a:hover {
    color: var(--accent);
  }
</style>
