---
import { currentStage, legalRoute } from "@/data/campaign"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
  // The proceedings page also says at each station what we expect there.
  detailed?: boolean
}

const { language, detailed = false } = Astro.props
const en = language === "en"
const stations = legalRoute[language]
const stateOf = (index: number) =>
  index < currentStage ? "done" : index === currentStage ? "current" : "next"

// Scrolling the route into view retraces the path walked so far: a reached
// station lights up, the line runs on to the next one, and so on until the
// current station turns red. Where the route lies on one line, each of these
// steps gets an equal share of the first 45 % of the route's "contain" range,
// so the walk is complete by the time it sits in the upper half of the
// screen. Stacked on phones, every station keeps its own pace instead.
const steps = currentStage * 2 + 1
const share = 45 / steps
const range = (step: number) =>
  `contain ${(step * share).toFixed(1)}% contain ${((step + 1) * share).toFixed(1)}%`
const timing = (index: number) =>
  index <= currentStage
    ? `--station-range: ${range(index * 2)}; --line-range: ${range(index * 2 + 1)}`
    : undefined
---

<ol class="flow route" aria-label={en ? "The legal route" : "Der Rechtsweg"}>
  {stations.map((station, index) => (
      <li
        class={stateOf(index)}
        style={timing(index)}
        data-possible={index === stations.length - 1 ? "" : undefined}
        aria-current={index === currentStage ? "step" : undefined}
      >
        <strong>
          {station.title}
          {index === currentStage && (
            <span class="tag live">{en ? "Now" : "Jetzt"}</span>
          )}
        </strong>
        <span>{detailed ? station.detail : station.text}</span>
      </li>
    ))}
</ol>

<style>
  /* Der Rechtsweg als Zeitleiste. Der gegangene Weg ist eine Graphitlinie in
     der Nut, der offene bleibt leere Nut. Ohne Scroll-Animation oder bei
     reduzierter Bewegung steht der Stand fertig gezeichnet da. */
  :global(.campaign) .route {
    --groove: light-dark(#c6cbcf, #454b51);
    --walked: light-dark(#3a3f45, #a3aab0);
    --glass: light-dark(#f1f3f4, #23272b);
    view-timeline: --legal-route block;
  }

  :global(.campaign) .route li.done:not(:last-child)::after {
    inline-size: 2px;
    border: 0;
    background:
      linear-gradient(var(--walked), var(--walked)) 0 0 / 100% 100% no-repeat,
      var(--groove);
  }

  /* Über die Vorlage an den EuGH entscheiden die Gerichte: Die letzte
     Station ist nur gestrichelt umrissen. */
  :global(.campaign) .route li[data-possible]::before {
    border-style: dashed;
    border-color: var(--ink-3);
  }

  @container campaign (width >= 46rem) {
    :global(.campaign) .route li.done:not(:last-child)::after {
      inline-size: auto;
      block-size: 2px;
    }
  }

  /* Schmal läuft der Weg senkrecht: Jede erreichte Station leuchtet auf,
     sobald sie das untere Drittel des Bildschirms erreicht, und die Linie
     folgt dem Scrollen bis zur nächsten. Breit liegt der Weg auf einer
     Zeile; dann gibt die Reihenfolge den Takt vor (siehe --station-range). */
  :global(.campaign) .route > li {
    view-timeline: --legal-station block;
  }

  /* Nur Einzelangaben statt der Kurzform animation: Der Minifier zieht
     animation-timeline sonst in die Kurzform, und dort verwerfen Browser die
     ganze Angabe. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(.campaign) .route li:is(.done, .current)::before,
      :global(.campaign) .route li:is(.done, .current) > strong,
      :global(.campaign) .route .tag.live,
      :global(.campaign) .route li.done:not(:last-child)::after {
        animation-name: legal-route-reach;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --legal-station;
        animation-range: entry 30vh entry calc(30vh + var(--dot));
      }

      :global(.campaign) .route li:is(.done, .current) > strong {
        animation-name: legal-route-title;
      }

      :global(.campaign) .route .tag.live {
        animation-name: legal-route-now;
      }

      :global(.campaign) .route li.done:not(:last-child)::after {
        animation-name: legal-route-down;
        animation-range: entry calc(30vh + var(--dot)) entry
          calc(100% + 30vh + var(--space-m));
      }

      @container campaign (width >= 46rem) {
        :global(.campaign) .route li:is(.done, .current)::before,
        :global(.campaign) .route li:is(.done, .current) > strong,
        :global(.campaign) .route .tag.live {
          animation-timeline: --legal-route;
          animation-range: var(--station-range);
        }

        :global(.campaign) .route li.done:not(:last-child)::after {
          animation-name: legal-route-across;
          animation-timeline: --legal-route;
          animation-range: var(--line-range);
        }
      }
    }
  }

  /* Eine Station leuchtet von der Mitte her auf: Ein innerer Schatten in
     Glasfarbe deckt das Token zuerst ganz ab und zieht sich an den Rand
     zurück. */
  @keyframes legal-route-reach {
    from {
      border-color: var(--material-edge);
      color: light-dark(#202428, #eef0f2);
      box-shadow:
        inset 0 1px 0 #ffffff38,
        inset 0 -1px 0 #00000035,
        0 1px 2px var(--material-shade),
        inset 0 0 0 calc(var(--dot) / 2) var(--glass);
    }
  }

  @keyframes legal-route-title {
    from {
      color: var(--ink-3);
    }
  }

  @keyframes legal-route-now {
    from {
      opacity: 0;
      translate: -0.25rem 0;
    }
  }

  @keyframes legal-route-down {
    from {
      background-size:
        100% 0%,
        auto;
    }
  }

  @keyframes legal-route-across {
    from {
      background-size:
        0% 100%,
        auto;
    }
  }
</style>
