---
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) => pathname === href || pathname.startsWith(`${href}/`),
)
---

<aside data-bar>
  <sidebar-inner>
    <a class="site-brand" href="/" aria-label={SITE.title}>
      <span class="site-name">dac8<span>.org</span></span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      <span class="menu-label">Menü öffnen</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
    <nav id="site-navigation">
      <ul>
        {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
              {item === section && crumbs.length > 0 && pathname !== item.href && (
                <ul>
                  {crumbs.map((crumb, i) => (
                    <li data-depth={i ? 1 : undefined}>
                      <a
                        href={crumb.href}
                        aria-current={
                          i === crumbs.length - 1 ? "page" : undefined
                        }
                      >
                        {crumb.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        {!section &&
            crumbs.map((crumb, i) => (
              <li data-depth={i ? 1 : undefined}>
                <a
                  href={crumb.href}
                  aria-current={i === crumbs.length - 1 ? "page" : undefined}
                >
                  {crumb.label}
                </a>
              </li>
            ))}
        <li class="locale-item">
          <label for="site-locale">Sprache / Land</label>
          <select id="site-locale" name="locale">
            <option value="de-AT" selected>Deutsch · AT</option>
            <option value="en" disabled>English · INT (bald)</option>
          </select>
        </li>
        <li class="theme-item">
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </sidebar-inner>
  <sidebar-toggle>
    <slot name="actions" />
  </sidebar-toggle>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 72rem) {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block-start: calc(var(--space-xl) - 0.25rem);

    > a {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      color: var(--foreground);
      text-decoration-line: none;
    }

    .site-brand {
      font-weight: var(--font-weight-medium);
      font-size: var(--step-2);

      .site-name span {
        color: var(--primary);
      }
    }

    @media (width < 72rem) {
      position: relative;
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-block-start: 0;
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      display: block;
      color: var(--muted-foreground);

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }

    li[data-depth="1"] a {
      margin-inline-start: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        margin-inline-start: var(--space-xs);
      }

      li[data-depth="1"] a {
        margin-inline-start: calc(2 * var(--space-xs));
      }
    }

    @media (width < 72rem) {
      ul {
        display: none;
      }
    }
  }

  nav {
    @media (width < 72rem) {
      display: none;
      position: fixed;
      z-index: 1;
      inset: 0;
      overflow-y: auto;
      padding: calc(4rem + var(--space-xl)) var(--bar-gutter) var(--space-xl);
      background: var(--background);

      > ul {
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-s);

        > li > a {
          font-size: var(--step-2);
        }
      }
    }
  }

  sidebar-inner:has(.menu-toggle[aria-expanded="true"]) nav {
    @media (width < 72rem) {
      display: block;
    }
  }

  .menu-toggle {
    display: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    align-items: center;
    justify-content: center;
    cursor: pointer;

    @media (width < 72rem) {
      display: inline-flex;
      position: relative;
      z-index: 2;
    }
  }

  .menu-label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    inline-size: 1.4rem;
    block-size: 2px;
  }

  .menu-icon {
    position: relative;

    &::before,
    &::after {
      position: absolute;
      inset: 0;
      background: currentColor;
      content: "";
      transition: transform 180ms cubic-bezier(0.77, 0, 0.175, 1);
    }

    &::before {
      transform: translateY(-0.28rem);
    }

    &::after {
      transform: translateY(0.28rem);
    }
  }

  .menu-toggle[aria-expanded="true"] {
    .menu-icon::before {
      transform: rotate(45deg);
    }

    .menu-icon::after {
      transform: rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-icon::before,
    .menu-icon::after {
      transition-duration: 0.01ms;
    }
  }

  .site-brand {
    position: relative;
    z-index: 2;
  }

  nav li:has(> ul) > a {
    @media (width < 72rem) {
      color: var(--foreground);
    }
  }

  .theme-item {
    margin-block-start: var(--space-2xs);

    button {
      margin-inline-start: -0.5rem;
    }
  }

  .locale-item {
    display: grid;
    gap: var(--space-3xs);
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--border);

    label {
      color: var(--muted-foreground);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    select {
      inline-size: 8rem;
      min-inline-size: 0;
      max-inline-size: 100%;
      padding: var(--space-3xs) var(--space-2xs);
      border: 1px solid var(--border);
      background: var(--background);
      color: var(--foreground);
      font: inherit;
      font-size: var(--step--1);
    }

    @media (width < 72rem) {
      margin-block-start: var(--space-m);
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    margin-inline-start: -0.5rem;

    @media (width < 72rem) {
      margin-inline-start: 0;
      margin-inline-end: -0.5rem;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle")
  const menuLabel = menuToggle?.querySelector(".menu-label")
  const navigation = document.getElementById("site-navigation")
  const background = document.querySelectorAll(
    "page-content, page-footer, page-toc, sidebar-toggle",
  )

  const setMenuState = (open: boolean) => {
    if (!menuToggle) return
    const label = open ? "Menü schließen" : "Menü öffnen"
    menuToggle.setAttribute("aria-expanded", String(open))
    menuToggle.setAttribute("aria-label", label)
    if (menuLabel) menuLabel.textContent = label
    document.documentElement.toggleAttribute("data-menu-open", open)
    background.forEach((element) => element.toggleAttribute("inert", open))
  }

  const closeMenu = () => setMenuState(false)

  menuToggle?.addEventListener("click", () => {
    setMenuState(menuToggle.getAttribute("aria-expanded") !== "true")
  })

  navigation?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) closeMenu()
  })

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu()
  })

  matchMedia("(width < 72rem)").addEventListener("change", closeMenu)
</script>
