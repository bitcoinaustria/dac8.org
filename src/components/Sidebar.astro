---
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) => pathname === href || pathname.startsWith(`${href}/`),
)
---

<aside data-bar>
  <sidebar-inner>
    <a class="site-brand" href="/" aria-label={SITE.title}>
      <span class="site-name">dac8<span>.org</span></span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      Menü
    </button>
    <nav id="site-navigation">
      <ul>
        {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
              {item === section && crumbs.length > 0 && pathname !== item.href && (
                <ul>
                  {crumbs.map((crumb, i) => (
                    <li data-depth={i ? 1 : undefined}>
                      <a
                        href={crumb.href}
                        aria-current={
                          i === crumbs.length - 1 ? "page" : undefined
                        }
                      >
                        {crumb.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        {!section &&
            crumbs.map((crumb, i) => (
              <li data-depth={i ? 1 : undefined}>
                <a
                  href={crumb.href}
                  aria-current={i === crumbs.length - 1 ? "page" : undefined}
                >
                  {crumb.label}
                </a>
              </li>
            ))}
        <li class="locale-item">
          <label for="site-locale">Sprache / Land</label>
          <select id="site-locale" name="locale">
            <option value="de-AT" selected>Österreich · Deutsch</option>
            <option value="en" disabled>International · English (bald)</option>
          </select>
        </li>
        <li class="theme-item">
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </sidebar-inner>
  <sidebar-toggle>
    <slot name="actions" />
  </sidebar-toggle>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block-start: var(--space-xl);

    > a {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      color: var(--foreground);
      text-decoration-line: none;
    }

    .site-brand {
      font-weight: var(--font-weight-medium);
      font-size: var(--step-0);

      .site-name span {
        color: var(--primary);
      }
    }

    @media (width < 64rem) {
      position: relative;
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-block-start: 0;
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      display: block;
      color: var(--muted-foreground);

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }

    li[data-depth="1"] a {
      margin-inline-start: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        margin-inline-start: var(--space-xs);
      }

      li[data-depth="1"] a {
        margin-inline-start: calc(2 * var(--space-xs));
      }
    }

    @media (width < 64rem) {
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);

      ul {
        display: none;
      }
    }
  }

  nav {
    @media (width < 48rem) {
      display: none;
      position: absolute;
      z-index: 1;
      inset-block-start: calc(100% + var(--space-2xs));
      inset-inline: calc(-1 * var(--bar-gutter));
      padding: var(--space-s) var(--bar-gutter);
      border-block-end: 2px solid var(--border);
      background: var(--background);

      > ul {
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-xs);
      }
    }
  }

  sidebar-inner:has(.menu-toggle[aria-expanded="true"]) nav {
    @media (width < 48rem) {
      display: block;
    }
  }

  .menu-toggle {
    display: none;
    padding: var(--space-3xs) var(--space-2xs);
    border: 1px solid var(--border);
    cursor: pointer;

    @media (width < 48rem) {
      display: inline-flex;
    }
  }

  nav li:has(> ul) > a {
    @media (width < 64rem) {
      color: var(--foreground);
    }
  }

  .theme-item {
    margin-block-start: var(--space-2xs);

    button {
      margin-inline-start: -0.5rem;
    }
  }

  .locale-item {
    display: grid;
    gap: var(--space-3xs);
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--border);

    label {
      color: var(--muted-foreground);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    select {
      max-inline-size: 100%;
      padding: var(--space-3xs) var(--space-2xs);
      border: 1px solid var(--border);
      background: var(--background);
      color: var(--foreground);
      font: inherit;
      font-size: var(--step--1);
    }

    @media (48rem <= width < 64rem) {
      margin-block-start: 0;
      padding-block-start: 0;
      border-block-start: 0;

      label {
        display: none;
      }
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    margin-inline-start: -0.5rem;

    @media (width < 64rem) {
      margin-inline-start: 0;
      margin-inline-end: -0.5rem;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle")
  const navigation = document.getElementById("site-navigation")

  const closeMenu = () => {
    if (!menuToggle) return
    menuToggle.setAttribute("aria-expanded", "false")
    menuToggle.textContent = "Menü"
  }

  menuToggle?.addEventListener("click", () => {
    const open = menuToggle.getAttribute("aria-expanded") !== "true"
    menuToggle.setAttribute("aria-expanded", String(open))
    menuToggle.textContent = open ? "Schließen" : "Menü"
  })

  navigation?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) closeMenu()
  })

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu()
  })
</script>
