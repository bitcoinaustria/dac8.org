---
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE, type PageSection } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = { sections?: PageSection[] }

const { sections = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const current = NAVIGATION.find(
  ({ href }) =>
    (normalizePath(new URL(href, Astro.url).pathname) || "/") === pathname,
)
---

<aside data-bar>
  <sidebar-inner>
    <a class="site-brand" href="/" aria-label={SITE.title}>
      dac8<span>.org</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      Menü
    </button>
    <nav id="site-navigation" aria-label="Hauptnavigation">
      <div class="navigation-links">
        <ul class="pages">
          {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item === current ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        {sections.length > 0 && (
          <div class="section-navigation">
            <p id="section-navigation-label">Auf dieser Seite</p>
            <ol class="sections" data-section-nav aria-labelledby="section-navigation-label">
              {sections.map((section) => (
                <li>
                  <a href={`#${section.id}`} data-target={section.id}>
                    {section.label}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
      <div class="sidebar-foot">
        <ThemeToggle />
        <p>
          Eine Initiative von
          <a href="https://bitcoin-austria.at">Bitcoin Austria</a>
        </p>
      </div>
    </nav>
  </sidebar-inner>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      position: static;
      height: auto;
    }
  }

  sidebar-inner {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-l);
    min-height: 0;

    @media (width < 64rem) {
      position: relative;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-s);
    }
  }

  .site-brand {
    inline-size: fit-content;
    color: var(--foreground);
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.03em;
    text-decoration: none;

    span {
      color: var(--accent);
    }
  }

  nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-l);
    min-height: 0;
    overflow-y: auto;
    padding: 0.25rem;
    margin: -0.25rem;
    scrollbar-width: thin;
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pages {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);

    > li > a {
      display: flex;
      align-items: center;
      min-block-size: 2.75rem;
      padding-block: 0.25em;
      color: var(--muted-foreground);
      font-size: var(--step--1);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.08em;
      text-decoration: none;
      text-transform: uppercase;

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }
  }

  .section-navigation {
    margin-block-start: var(--space-m);

    > p {
      color: var(--muted-foreground);
      font-size: var(--step--1);
    }
  }

  .sections {
    display: flex;
    flex-direction: column;
    margin-block: var(--space-2xs) var(--space-xs);
    border-inline-start: 1px solid var(--border);

    a {
      position: relative;
      display: flex;
      align-items: center;
      min-block-size: 2.75rem;
      padding: 0.35em 0 0.35em var(--space-s);
      line-height: 1.4;
      color: var(--muted-foreground);
      font-size: var(--step--1);
      text-decoration: none;
      transition: color 120ms ease;

      &::before {
        content: "";
        position: absolute;
        inset-block: 0.25em;
        inset-inline-start: -2px;
        inline-size: 3px;
        background: var(--primary);
        opacity: 0;
        transition: opacity 120ms ease;
      }

      &:hover {
        color: var(--foreground);
      }

      &[aria-current="location"] {
        color: var(--foreground);
        font-weight: var(--font-weight-medium);

        &::before {
          opacity: 1;
        }
      }
    }
  }

  .sidebar-foot {
    display: grid;
    gap: var(--space-2xs);

    button {
      margin-inline-start: -0.5rem;
    }

    p {
      margin: 0;
      color: var(--muted-foreground);
      font-size: var(--step--1);
      line-height: 1.4;

      a {
        color: inherit;
        text-decoration-color: var(--border);

        &:hover {
          color: var(--foreground);
        }
      }
    }
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    inline-size: 8rem;
    flex-shrink: 0;
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--foreground);
    color: var(--foreground);
    background: transparent;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (width < 64rem) {
    aside {
      border-block-end: 1px solid var(--border);
    }

    .site-brand {
      display: flex;
      align-items: center;
      min-block-size: 2.75rem;
    }

    aside[data-menu-ready] .menu-toggle {
      display: inline-flex;
    }

    nav {
      flex: none;
      gap: var(--space-m);
      margin: 0;
      padding: var(--space-s) 0;
    }

    aside[data-menu-ready] nav {
      display: none;
      position: absolute;
      z-index: 1;
      inset-block-start: calc(100% + var(--space-2xs));
      inset-inline: calc(-1 * var(--bar-gutter));
      max-block-size: calc(100svh - var(--bar-nav-height) - var(--space-s));
      padding: var(--space-s) var(--bar-gutter) var(--space-m);
      border-block-end: 2px solid var(--foreground);
      background: var(--background);
      overscroll-behavior-y: contain;
    }

    aside:not([data-menu-ready]) sidebar-inner {
      flex-direction: column;
      align-items: stretch;
    }

    .pages {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xs) var(--space-s);
    }

    .sidebar-foot {
      padding-block-start: var(--space-s);
      border-block-start: 1px solid var(--border);
    }

    sidebar-inner:has(.menu-toggle[aria-expanded="true"]) nav {
      display: flex;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle")
  const navigation = document.getElementById("site-navigation")

  menuToggle?.closest("aside")?.setAttribute("data-menu-ready", "")

  const closeMenu = () => {
    if (!menuToggle) return
    menuToggle.setAttribute("aria-expanded", "false")
    menuToggle.textContent = "Menü"
  }

  menuToggle?.addEventListener("click", () => {
    const open = menuToggle.getAttribute("aria-expanded") !== "true"
    menuToggle.setAttribute("aria-expanded", String(open))
    menuToggle.textContent = open ? "Schließen" : "Menü"
  })

  navigation?.addEventListener("click", (event) => {
    const link = (event.target as Element).closest("a")
    if (!link || menuToggle?.getAttribute("aria-expanded") !== "true") return
    closeMenu()
    if (link.hash && link.pathname === window.location.pathname) {
      const target = document.getElementById(link.hash.slice(1))
      target?.setAttribute("tabindex", "-1")
      target?.focus({ preventScroll: true })
    }
  })

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      menuToggle?.getAttribute("aria-expanded") === "true"
    ) {
      closeMenu()
      menuToggle.focus()
    }
  })

  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest("sidebar-inner")) closeMenu()
  })

  menuToggle
    ?.closest("sidebar-inner")
    ?.addEventListener("focusout", (event) => {
      if (
        !(event.currentTarget as Element).contains(
          (event as FocusEvent).relatedTarget as Node | null,
        )
      )
        closeMenu()
    })

  matchMedia("(width < 64rem)").addEventListener("change", () => closeMenu())

  // Abschnittsanzeige: aktuell ist der letzte Abschnitt, dessen Oberkante die
  // Lesezone (oberes Drittel) erreicht hat. Am Seitenende zählt der letzte,
  // nach einem Klick sofort der angeklickte – ohne auf das Scrollen zu warten.
  const sectionLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-section-nav] a"),
  )
  const targets = sectionLinks
    .map((link) => document.getElementById(link.dataset.target ?? ""))
    .filter((el): el is HTMLElement => el !== null)

  if (targets.length > 0) {
    let frame = 0
    let pinned: string | null = null

    const mark = (id: string | null) => {
      for (const link of sectionLinks) {
        if (id && link.dataset.target === id) {
          link.setAttribute("aria-current", "location")
        } else {
          link.removeAttribute("aria-current")
        }
      }
    }

    const update = () => {
      frame = 0
      if (pinned) {
        const target = document.getElementById(pinned)
        const top = target?.getBoundingClientRect().top ?? 0
        // Der Sprung ist angekommen, sobald das Ziel oben steht.
        if (Math.abs(top) < window.innerHeight * 0.35) pinned = null
        else return
      }
      const threshold = window.innerHeight * 0.35
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2
      let active: HTMLElement | null = null
      if (atBottom) {
        active = targets[targets.length - 1]
      } else {
        for (const target of targets) {
          if (target.getBoundingClientRect().top <= threshold) active = target
        }
      }
      mark(active?.id ?? null)
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }

    for (const link of sectionLinks) {
      link.addEventListener("click", () => {
        pinned = link.dataset.target ?? null
        mark(pinned)
      })
    }
    window.addEventListener("scroll", schedule, { passive: true })
    window.addEventListener("resize", schedule)
    window.addEventListener("hashchange", schedule)
    update()
  }
</script>
