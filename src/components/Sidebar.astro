---
import ThemeToggle from "@/components/ThemeToggle.astro"
import LanguageSelector from "@/components/LanguageSelector.astro"
import { languageFor, navigationFor, pathFor } from "@/lib/i18n"
import { SITE, type PageSection } from "@/consts"
import { normalizePath } from "@/lib/utils"

const language = languageFor(Astro.url.pathname)
const en = language === "en"
const NAVIGATION = navigationFor(language)

type Props = { sections?: PageSection[] }

const { sections = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const current = NAVIGATION.find(
  ({ href }) =>
    (normalizePath(new URL(href, Astro.url).pathname) || "/") === pathname,
)
---

<aside data-bar>
  <sidebar-inner>
    <a
      class="site-brand"
      href={pathFor("home", language)}
      aria-label={SITE.title}
    >
      dac8<span>.org</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-haspopup="dialog"
      aria-label={en ? "Open menu" : "Menü öffnen"}
    >
      <span>{en ? "Menu" : "Menü"}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 8h16M4 16h16" />
      </svg>
    </button>
    <nav
      id="site-navigation"
      aria-label={en ? "Main navigation" : "Hauptnavigation"}
    >
      <div class="navigation-links">
        <ul class="pages">
          {NAVIGATION.map((item) => (
            <li>
              {item === current && sections.length > 0 ? (
                <details class="section-navigation" open>
                  <summary class="page-link" aria-current="page">
                    <span>{item.label}</span>
                  </summary>
                  <ol class="sections" data-section-nav aria-label={`${en ? "Sections" : "Abschnitte"}: ${item.label}`}>
                    {sections.map((section) => (
                      <li>
                        <a href={`#${section.id}`} data-target={section.id}>
                          {section.label}
                        </a>
                      </li>
                    ))}
                  </ol>
                </details>
              ) : (
                <a class="page-link" href={item.href} aria-current={item === current ? "page" : undefined}>
                  <span>{item.label}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
      <div class="sidebar-bottom">
        <div class="sidebar-controls">
          <LanguageSelector />
          <ThemeToggle />
        </div>
        <div class="sidebar-foot">
          <p>
            {en ? "An initiative by" : "Eine Initiative von"}
            <a href="https://bitcoin-austria.at">Bitcoin Austria</a>
          </p>
        </div>
      </div>
    </nav>
  </sidebar-inner>
  <dialog id="mobile-menu" aria-label={en ? "Menu" : "Menü"}>
    <div class="mobile-menu-header">
      <a
        class="site-brand"
        href={pathFor("home", language)}
        aria-label={SITE.title}
      >
        dac8<span>.org</span>
      </a>
      <button
        class="menu-close"
        type="button"
        aria-label={en ? "Close menu" : "Menü schließen"}
        autofocus
      >
        <span>{en ? "Close" : "Schließen"}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </dialog>
</aside>

<style>
  .sidebar-bottom {
    display: grid;
    gap: 0.75rem;
  }
  .sidebar-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      position: static;
      height: auto;
    }
  }

  sidebar-inner {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-l);
    min-height: 0;

    @media (width < 64rem) {
      position: relative;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-s);
    }
  }

  .site-brand {
    inline-size: fit-content;
    color: var(--foreground);
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.03em;
    text-decoration: none;

    span {
      color: var(--accent);
    }
  }

  nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--space-l);
    min-height: 0;
    overflow-y: auto;
    padding: 0.25rem;
    margin: -0.25rem;
    scrollbar-width: thin;
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pages {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);

    .page-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-xs);
      min-block-size: 2.75rem;
      padding-block: 0.25em;
      color: var(--muted-foreground);
      font-size: var(--step--1);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.08em;
      text-decoration: none;
      text-transform: uppercase;

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }

      &[aria-current="page"] {
        font-weight: 600;
        box-shadow: inset 3px 0 var(--accent);
        padding-inline-start: var(--space-xs);
      }
    }
  }

  .section-navigation > summary {
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }
  }

  .pages .section-navigation > summary::after {
    flex: none;
    content: "+";
    font-size: 1.25rem;
    font-weight: 400;
  }

  .pages .section-navigation[open] > summary::after {
    content: "−";
  }

  @media (width >= 64rem) {
    .pages .section-navigation > summary::after {
      display: none;
    }
  }

  .sections {
    display: flex;
    flex-direction: column;
    margin-block: var(--space-2xs) var(--space-xs);
    border-inline-start: 1px solid var(--border);

    a {
      position: relative;
      display: flex;
      align-items: center;
      min-block-size: 2.75rem;
      padding: 0.35em 0 0.35em var(--space-s);
      line-height: 1.4;
      color: var(--muted-foreground);
      font-size: var(--step--1);
      text-decoration: none;
      transition: color 120ms ease;

      &::before {
        content: "";
        position: absolute;
        inset-block: 0.25em;
        inset-inline-start: -2px;
        inline-size: 3px;
        background: var(--primary);
        opacity: 0;
        transition: opacity 120ms ease;
      }

      &:hover {
        color: var(--foreground);
      }

      &[aria-current="location"] {
        color: var(--foreground);
        font-weight: var(--font-weight-medium);

        &::before {
          opacity: 1;
        }
      }
    }
  }

  .sidebar-foot {
    display: grid;
    gap: var(--space-2xs);

    p {
      margin: 0;
      color: var(--muted-foreground);
      font-size: var(--step--1);
      line-height: 1.4;

      a {
        color: inherit;
        text-decoration-color: var(--border);

        &:hover {
          color: var(--foreground);
        }
      }
    }
  }

  .menu-toggle,
  .menu-close {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-block-size: 2.75rem;
    min-inline-size: 2.75rem;
    flex-shrink: 0;
    padding-inline: var(--space-xs);
    border-radius: var(--radius-sm);
    color: var(--foreground);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;

    svg {
      inline-size: 1.25rem;
      block-size: 1.25rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
    }

    &:hover {
      background: var(--muted);
    }
  }

  dialog {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--foreground);
    background: var(--background);

    &::backdrop {
      background: rgb(0 0 0 / 40%);
    }
  }

  @media (width < 64rem) {
    aside {
      border-block-end: 1px solid var(--border);
    }

    .site-brand {
      display: flex;
      align-items: center;
      min-block-size: 2.75rem;
    }

    aside[data-menu-ready] .menu-toggle,
    .menu-close {
      display: inline-flex;
    }

    aside[data-menu-ready] sidebar-inner > nav {
      display: none;
    }

    aside:not([data-menu-ready]) sidebar-inner {
      flex-direction: column;
      align-items: stretch;
    }

    dialog[open] {
      display: flex;
      flex-direction: column;
      inset-block: 0;
      inset-inline-start: auto;
      inset-inline-end: 0;
      inline-size: min(100%, 30rem);
      max-inline-size: none;
      block-size: 100dvh;
      max-block-size: none;
      overflow: hidden;
    }

    .mobile-menu-header {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: space-between;
      padding: max(var(--space-2xs), env(safe-area-inset-top)) var(--bar-gutter)
        var(--space-2xs);
      border-block-end: 1px solid var(--border);
    }

    nav {
      gap: var(--space-l);
      margin: 0;
      padding: var(--space-s) var(--bar-gutter)
        max(var(--space-s), env(safe-area-inset-bottom));
      overscroll-behavior-y: contain;
    }

    .pages {
      gap: 0;

      .page-link {
        justify-content: space-between;
        min-block-size: 3.5rem;
        padding: var(--space-xs) 0;
        border-block-end: 1px solid var(--border);
        color: var(--foreground);
        font-size: 1.75rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        text-transform: none;

        gap: var(--space-xs);

        span {
          min-inline-size: 0;
          overflow-wrap: anywhere;
          hyphens: auto;
        }

        &[aria-current="page"] {
          padding-inline-start: 0;
          box-shadow: none;
          color: var(--accent);
          font-weight: 600;
        }
      }
    }

    .sections a {
      font-size: 1rem;
    }

    .sidebar-bottom {
      padding-block-start: var(--space-xs);
      border-block-start: 1px solid var(--border);
    }

    .sidebar-foot p {
      max-inline-size: 24ch;
    }
  }
  @media (width < 30rem) {
    .menu-toggle span,
    .menu-close span {
      display: none;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle")
  const navigation = document.getElementById("site-navigation")
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu")
  const menuClose = menu?.querySelector<HTMLButtonElement>(".menu-close")
  const navigationHome = navigation?.parentElement
  const sectionNavigation = navigation?.querySelector<HTMLDetailsElement>(
    ".section-navigation",
  )
  const mobile = matchMedia("(width < 64rem)")

  const closeMenu = () => {
    if (!menu?.open) return
    menu.close()
    if (navigation) navigationHome?.append(navigation)
    menuToggle?.setAttribute("aria-expanded", "false")
    document.documentElement.removeAttribute("data-menu-open")
    if (mobile.matches) menuToggle?.focus({ preventScroll: true })
  }

  menuToggle?.addEventListener("click", () => {
    if (!menu || !navigation || !mobile.matches) return
    if (sectionNavigation) sectionNavigation.open = false
    menu.append(navigation)
    menu.showModal()
    navigation.scrollTop = 0
    menuToggle.setAttribute("aria-expanded", "true")
    document.documentElement.setAttribute("data-menu-open", "")
  })

  menuClose?.addEventListener("click", closeMenu)
  menu?.addEventListener("cancel", (event) => {
    event.preventDefault()
    closeMenu()
  })
  menu?.addEventListener("click", (event) => {
    if (event.target !== menu) return
    const rect = menu.getBoundingClientRect()
    if (
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom
    )
      closeMenu()
  })

  navigation?.addEventListener("click", (event) => {
    const link = (event.target as Element).closest("a")
    if (!link || !menu?.open) return
    closeMenu()
    if (link.hash && link.pathname === window.location.pathname) {
      const target = document.getElementById(link.hash.slice(1))
      target?.setAttribute("tabindex", "-1")
      target?.focus({ preventScroll: true })
    }
  })

  const syncNavigation = () => {
    closeMenu()
    if (sectionNavigation) sectionNavigation.open = !mobile.matches
  }
  mobile.addEventListener("change", syncNavigation)
  syncNavigation()
  menuToggle?.closest("aside")?.setAttribute("data-menu-ready", "")

  // Abschnittsanzeige: aktuell ist der letzte Abschnitt, dessen Oberkante die
  // Lesezone (oberes Drittel) erreicht hat. Am Seitenende zählt der letzte,
  // nach einem Klick sofort der angeklickte – ohne auf das Scrollen zu warten.
  const sectionLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-section-nav] a"),
  )
  const targets = sectionLinks
    .map((link) => document.getElementById(link.dataset.target ?? ""))
    .filter((el): el is HTMLElement => el !== null)

  if (targets.length > 0) {
    let frame = 0
    let pinned: string | null = null

    const mark = (id: string | null) => {
      for (const link of sectionLinks) {
        if (id && link.dataset.target === id) {
          link.setAttribute("aria-current", "location")
        } else {
          link.removeAttribute("aria-current")
        }
      }
    }

    const update = () => {
      frame = 0
      if (pinned) {
        const target = document.getElementById(pinned)
        const top = target?.getBoundingClientRect().top ?? 0
        // Der Sprung ist angekommen, sobald das Ziel oben steht.
        if (Math.abs(top) < window.innerHeight * 0.35) pinned = null
        else return
      }
      const threshold = window.innerHeight * 0.35
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2
      let active: HTMLElement | null = null
      if (atBottom) {
        active = targets[targets.length - 1]
      } else {
        for (const target of targets) {
          if (target.getBoundingClientRect().top <= threshold) active = target
        }
      }
      mark(active?.id ?? null)
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }

    for (const link of sectionLinks) {
      link.addEventListener("click", () => {
        pinned = link.dataset.target ?? null
        mark(pinned)
      })
    }
    window.addEventListener("scroll", schedule, { passive: true })
    window.addEventListener("resize", schedule)
    window.addEventListener("hashchange", schedule)
    update()
  }
</script>
