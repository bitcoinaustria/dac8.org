---
import { buildRequest, requestSubject } from "@/data/access-request"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
// Without JavaScript the template keeps its placeholders, and the email link
// still opens it with subject and text. Line breaks in a mailto body are CRLF
// (RFC 6068). The form uses method="dialog" so that, should the script fail,
// pressing Enter never puts the reader's details into the address bar.
const initial = buildRequest(language, {
  provider: "",
  name: "",
  email: "",
  customer: "",
})
const subject = requestSubject[language]
const mailto = `mailto:?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(initial.replace(/\n/g, "\r\n"))}`
---

<div class="request" data-access-request>
  <div class="request-input">
    <form
      class="request-form"
      method="dialog"
      data-request-form
      data-needs-script
    >
      <fieldset class="request-language">
        <legend>
          {en ? "Request language" : "Sprache der Anfrage"}
        </legend>
        <label>
          <input type="radio" name="requestLanguage" value="de" checked={!en}>
          <span>Deutsch</span>
        </label>
        <label>
          <input type="radio" name="requestLanguage" value="en" checked={en}>
          <span>English</span>
        </label>
      </fieldset>
      <div class="form-grid">
        <div class="field">
          <label for="request-provider">{en ? "Provider" : "Anbieter"}</label>
          <input id="request-provider" name="provider" autocomplete="off">
        </div>
        <div class="field">
          <label for="request-provider-email"
            >{en ? "Provider’s privacy email (optional)" : "Datenschutz-E-Mail des Anbieters (optional)"}</label
          >
          <input
            id="request-provider-email"
            name="providerEmail"
            type="email"
            autocomplete="off"
            aria-describedby="request-provider-email-hint"
          >
          <small id="request-provider-email-hint"
            >{en ? "You’ll find it in its privacy policy, often an address like privacy@ or datenschutz@." : "Steht in seiner Datenschutzerklärung, oft eine Adresse wie datenschutz@ oder privacy@."}</small
          >
        </div>
        <div class="field">
          <label for="request-name"
            >{en ? "Your full name" : "Dein vollständiger Name"}</label
          >
          <input id="request-name" name="name" autocomplete="name">
        </div>
        <div class="field">
          <label for="request-email"
            >{en ? "Email address of your account" : "E-Mail-Adresse deines Kontos"}</label
          >
          <input
            id="request-email"
            name="email"
            type="email"
            autocomplete="email"
            aria-describedby="request-email-hint"
          >
          <small id="request-email-hint"
            >{en ? "Send the request from this address so your provider can match it to your account." : "Schick die Anfrage von dieser Adresse, dann kann dein Anbieter sie deinem Konto zuordnen."}</small
          >
        </div>
        <div class="field">
          <label for="request-customer"
            >{en ? "Customer or account number (optional)" : "Kunden- oder Kontonummer (optional)"}</label
          >
          <input id="request-customer" name="customer" autocomplete="off">
        </div>
      </div>
    </form>
    <noscript>
      <p class="request-noscript">
        {en ? "Without JavaScript, the template does not fill itself in. Open it in your email program or copy it, then replace the details in square brackets. Your provider’s privacy email is in its privacy policy." : "Ohne JavaScript füllt sich die Vorlage nicht aus. Öffne sie in deinem E-Mail-Programm oder kopiere sie und ersetze die Angaben in eckigen Klammern. Die Datenschutz-E-Mail deines Anbieters steht in seiner Datenschutzerklärung."}
      </p>
    </noscript>
    <p class="request-scope">
      {en ? "The template assumes a provider that reports in Austria." : "Die Vorlage geht von einem Anbieter aus, der in Österreich meldet."}
    </p>
    <div class="request-tips">
      <h3>{en ? "When you send it" : "Beim Absenden"}</h3>
      <ul>
        <li>
          {en ? "Send it from your account’s email address." : "Schick die Anfrage von der E-Mail-Adresse deines Kontos."}
        </li>
        <li>
          {en ? "Don’t attach a copy of your ID. If your provider asks for one, use its secure channel." : "Leg keine Ausweiskopie bei. Verlangt dein Anbieter eine, nutze seinen sicheren Kanal."}
        </li>
        <li>
          {en ? "Keep a copy with the date you sent it." : "Bewahre eine Kopie mit dem Sendedatum auf."}
        </li>
      </ul>
    </div>
  </div>

  <div class="request-output">
    <div class="field">
      <label for="request-subject">{en ? "Subject" : "Betreff"}</label>
      <textarea
        id="request-subject"
        data-request-subject
        readonly
        rows="2"
        lang={language}
        set:text={subject}
      />
    </div>
    <div class="field">
      <label for="request-text"
        >{en ? "Request, editable" : "Anfrage, bearbeitbar"}</label
      >
      <textarea
        id="request-text"
        data-request-text
        rows="24"
        lang={language}
        set:text={initial}
      />
    </div>
    <div class="output-actions">
      <a class="button primary" data-request-mail href={mailto}>
        {en ? "Open in email" : "In E-Mail öffnen"}
      </a>
      <button class="button" type="button" data-request-copy data-needs-script>
        {en ? "Copy text" : "Text kopieren"}
      </button>
    </div>
    <p class="copy-status" data-copy-status aria-live="polite"></p>
    <p class="request-note">
      {en ? "Everything stays in your browser. Nothing is sent to or stored by dac8.org. Read the request before you send it; you send it yourself." : "Alles bleibt in deinem Browser. Nichts wird an dac8.org gesendet oder gespeichert. Lies die Anfrage, bevor du sie abschickst; du sendest sie selbst."}
    </p>
  </div>
</div>

<style>
  /* Formular und Anfrage nebeneinander wie beim Brief an Abgeordnete, ohne
     Kasten: Die Felder tragen ihre eigenen Kanten. */
  .request {
    display: grid;
    align-items: start;
    gap: var(--space-l) var(--space-xl);
    margin-block-start: var(--space-l);
  }

  .request-input {
    container: request-input / inline-size;
    display: grid;
    gap: var(--space-m);
    min-inline-size: 0;
  }

  .request-form,
  .request-output {
    display: grid;
    gap: var(--space-s);
    min-inline-size: 0;
  }

  /* Eine Spalte, solange das Formular schmal ist; erst bei genug Breite
     stehen je zwei Felder nebeneinander, damit lange Beschriftungen nicht
     umbrechen. */
  .request-input .form-grid {
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @container request-input (width >= 40rem) {
    .request-input .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .field > label {
    color: var(--ink-2);
    font-weight: 560;
  }

  .field small {
    color: var(--ink-3);
    font-size: inherit;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .request-language {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .request-language legend {
    float: left;
    margin-inline-end: var(--space-xs);
    padding: 0;
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 560;
  }

  .request-language label {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  .request-language input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .request-language span {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.45em 1em;
    border: 1px solid color-mix(in oklab, var(--ink) 30%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 560;
  }

  .request-language input:checked + span {
    border-color: var(--ink);
    color: var(--background);
    background: var(--ink);
  }

  .request-language input:focus-visible + span {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  .request-scope,
  .request-noscript,
  .request-note {
    max-inline-size: 60ch;
    color: var(--ink-3);
    font-size: var(--step--1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .request-noscript {
    color: var(--ink-2);
  }

  /* Hinweise zum Absenden: je Punkt eine Zeile zwischen Haarlinien, wie in
     der Gegenüberstellung der Meldung. */
  .request-tips h3 {
    font-size: var(--step-0);
    font-weight: 560;
  }

  .request-tips ul {
    display: grid;
    margin-block-start: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .request-tips li {
    position: relative;
    padding-block: var(--space-2xs);
    padding-inline-start: 1.25rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .request-tips li + li {
    border-block-start: 1px solid var(--line);
  }

  .request-tips li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: calc(var(--space-2xs) + 0.6em);
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--ink-3);
  }

  /* Der Betreff bricht um, statt auf schmalen Bildschirmen abgeschnitten zu
     werden; wo field-sizing fehlt, reichen zwei Zeilen. */
  .field [data-request-subject] {
    min-block-size: 0;
    color: var(--ink);
    font-weight: 560;
    resize: none;
    field-sizing: content;
  }

  .field [data-request-text] {
    min-block-size: 24rem;
    line-height: 1.55;
    resize: vertical;
  }

  .output-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }

  /* Die Statuszeile bleibt als Live-Region stehen, nimmt aber erst Platz
     ein, wenn sie etwas meldet; das geschieht nur nach einem Klick. */
  .request-output .copy-status {
    min-block-size: 0;
    margin-block-start: 0;
  }

  @container campaign (width >= 56rem) {
    .request {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .request-output {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-s));
    }

    /* Die Anfrage bleibt mit ihren Knöpfen im Bild, auch auf niedrigen
       Bildschirmen. */
    .field [data-request-text] {
      block-size: clamp(22rem, 100svh - 21rem, 40rem);
      min-block-size: 22rem;
    }
  }
</style>

<script>
  import { buildRequest, requestSubject } from "@/data/access-request"
  import type { Language } from "@/lib/i18n"
  import { copyText } from "@/lib/share"

  // Line breaks in a mailto body are CRLF (RFC 6068).
  const mailBody = (text: string) =>
    encodeURIComponent(text.replace(/\r?\n/g, "\r\n"))

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-access-request]",
  )) {
    const form = root.querySelector<HTMLFormElement>("[data-request-form]")
    const output = root.querySelector<HTMLTextAreaElement>(
      "[data-request-text]",
    )
    const subject = root.querySelector<HTMLTextAreaElement>(
      "[data-request-subject]",
    )
    const mail = root.querySelector<HTMLAnchorElement>("[data-request-mail]")
    const copy = root.querySelector<HTMLButtonElement>("[data-request-copy]")
    const status = root.querySelector<HTMLElement>("[data-copy-status]")
    if (!form || !output || !subject || !mail || !copy) continue

    const en = document.documentElement.lang.startsWith("en")
    let edited = false
    const value = (name: string) =>
      String(new FormData(form).get(name) ?? "").trim()
    const language = (): Language =>
      value("requestLanguage") === "en" ? "en" : "de"

    const updateMail = () => {
      const to = encodeURIComponent(value("providerEmail")).replace("%40", "@")
      mail.href = `mailto:${to}?subject=${encodeURIComponent(subject.value)}&body=${mailBody(output.value)}`
    }

    const render = () => {
      const current = language()
      subject.value = requestSubject[current]
      subject.lang = current
      output.lang = current
      if (!edited) {
        output.value = buildRequest(current, {
          provider: value("provider"),
          name: value("name"),
          email: value("email"),
          customer: value("customer"),
        })
      }
      updateMail()
    }

    form.addEventListener("input", (event) => {
      // Switching the language rebuilds the request even after manual edits.
      if ((event.target as HTMLInputElement).name === "requestLanguage")
        edited = false
      render()
    })
    form.addEventListener("submit", (event) => event.preventDefault())
    output.addEventListener("input", () => {
      edited = true
      updateMail()
    })
    copy.addEventListener("click", async () => {
      const copied = await copyText(`${subject.value}\n\n${output.value}`)
      if (status)
        status.textContent = copied
          ? en
            ? "Subject and request copied."
            : "Betreff und Anfrage kopiert."
          : en
            ? "Could not copy. Please select the text."
            : "Kopieren nicht möglich. Bitte den Text markieren."
    })
    render()
  }
</script>
