---
import type { Point } from "@/data/arguments"

// One list of argument points, each with its legal source when it has one. The arguments page shows them as facts, the home page as
// objections under the guiding statement. A title in quotation marks is an
// objection we answer and is set lighter than our own claims.
interface Props {
  points: Point[]
  variant?: "facts" | "objections"
}

const { points, variant = "facts" } = Astro.props
const isObjection = (title: string) => /^[„“"]/.test(title)
---

<ul class:list={variant === "facts" ? ["facts", "concerns"] : ["objections"]}>
  {points.map((point) => (
    <li class:list={{ objection: isObjection(point.title) }}>
      <strong>{point.title}</strong>
      <p>{point.text}</p>
      {point.source && <small><a href={point.source.href}>{point.source.label}</a></small>}
    </li>
  ))}
</ul>
