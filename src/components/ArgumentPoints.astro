---
import type { Point } from "@/data/arguments"

// Objections and our answers on the arguments page. A title in quotation
// marks is an objection we answer and is set lighter than our own claims.
interface Props {
  points: Point[]
  variant?: "objections"
}

const { points } = Astro.props
const isObjection = (title: string) => /^[„“"]/.test(title)
---

<ul class="objections">
  {points.map((point) => (
    <li class:list={{ objection: isObjection(point.title) }}>
      <strong>{point.title}</strong>
      <p>{point.text}</p>
      {point.sources && (
        <small>
          {point.sources.map((source, position) => (
            <>
              {position > 0 && " · "}
              <a href={source.href}>{source.label}</a>
            </>
          ))}
        </small>
      )}
    </li>
  ))}
</ul>
