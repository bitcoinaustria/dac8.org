---
import { challenges, memberStates } from "@/data/front"
import type { Language } from "@/lib/i18n"
import { svgMapEqualArea } from "@/lib/svg-map"

// The European front: where in the EU a case against DAC8 is pending, as a
// wide map over a grid of cases, oldest first, ending in an open tile that
// invites the next country. Built to grow: the map is drawn at build time
// like the attack map, other land pale and fading out towards the edges,
// member states grey, countries with a case red and lifted off the map,
// each with a pin and its name. Pointing at a country or a tile lights up both and shows
// the month the case began; a click on the map jumps to the tile. The subtitle names
// the countries while there are few and counts them after.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"

// The member states in Europe, from Ireland and Portugal to Cyprus, from
// Malta to Lapland, in the projection of the EU's own maps around its usual
// centre, widened to a wide frame that spans the section.
const map = svgMapEqualArea({
  center: [10, 52],
  fit: memberStates,
  within: { west: -11, east: 35, south: 34, north: 71 },
  width: 1200,
  aspect: 16 / 9,
})

const landPath = map.land()
const memberPath = map.countries(memberStates)
const borderPath = map.borders()

const cases = [...challenges]
  .sort((a, b) => a.filed.localeCompare(b.filed))
  .map((item) => {
    const [x, y] = map.project(item.label)
    return {
      ...item[language],
      code: item.code,
      side: item.side ?? "right",
      anchor: `fall-${item.code.toLowerCase()}`,
      path: map.countries([item.id]),
      x: Math.round(x),
      y: Math.round(y),
    }
  })

const list = (countries: string[]) =>
  new Intl.ListFormat(language, { type: "conjunction" }).format(countries)
const names = list(cases.map((item) => item.country))
const [first, ...others] = cases.map((item) => item.country)
const subtitle =
  others.length === 0
    ? en
      ? `It began in ${first}.`
      : `Begonnen in ${first}.`
    : others.length <= 2
      ? en
        ? `It began in ${first}. ${list(others)} followed.`
        : `Begonnen in ${first}, weiter in ${list(others)}.`
      : en
        ? `It began in ${first}. Now in ${cases.length} countries.`
        : `Begonnen in ${first}, jetzt in ${cases.length} Ländern.`
const mapLabel = en
  ? `Map of the EU: a case against DAC8 is pending in ${names}.`
  : `Karte der EU: In ${names} läuft ein Verfahren gegen DAC8.`
const contact = en
  ? "mailto:kontakt@dac8.org?subject=Working%20together%20on%20DAC8"
  : "mailto:kontakt@dac8.org?subject=Zusammenarbeit%20zu%20DAC8"
---

<section id="europa" class="front" aria-labelledby="europa-heading">
  <div class="front-text">
    <h2 id="europa-heading">
      {en ? "The European front" : "Die europäische Front"}
      <span>{subtitle}</span>
    </h2>
    <p class="section-intro">
      {en ? "DAC8 applies across the EU, but each country has its own legal route." : "DAC8 gilt in der ganzen EU, aber jedes Land hat seinen eigenen Rechtsweg."}
    </p>
  </div>

  <figure class="front-map">
    <svg
      viewBox={`0 0 ${map.width} ${map.height}`}
      preserveAspectRatio="xMidYMid slice"
      aria-labelledby="europa-map"
    >
      <title id="europa-map">{mapLabel}</title>
      <defs>
        <radialGradient id="europa-fade" cx="0.47" cy="0.55" r="0.62">
          <stop offset="0.35" stop-color="#fff"></stop>
          <stop offset="0.9" stop-color="#000"></stop>
        </radialGradient>
        <mask id="europa-vignette">
          <rect
            width={map.width}
            height={map.height}
            fill="url(#europa-fade)"
          ></rect>
        </mask>
      </defs>
      <path class="land" d={landPath} mask="url(#europa-vignette)"></path>
      <path class="member" d={memberPath}></path>
      <path class="borders" d={borderPath}></path>
      {cases.map((item) => (
        <a
          href={`#${item.anchor}`}
          data-code={item.code}
          aria-label={`${item.country}: ${item.date}, ${item.forum}`}
        >
          <path class="challenged" d={item.path} />
        </a>
      ))}
      {cases.map((item, index) => (
        <g
          class:list={["pin", item.side]}
          data-code={item.code}
          transform={`translate(${item.x} ${item.y})`}
          style={`--delay: ${index * -0.8}s`}
          aria-hidden="true"
        >
          <g class="pin-body">
            <circle class="pulse" r="8"></circle>
            <circle class="dot" r="7"></circle>
            <text class="name" x={item.side === "left" ? -16 : 16} y="-3"
              >{item.country}</text
            >
            <text class="when" x={item.side === "left" ? -16 : 16} y="17"
              >{item.date}</text
            >
          </g>
        </g>
      ))}
    </svg>
    <figcaption>
      <span class="key challenged-key"
        >{en ? "Case against DAC8 pending" : "Verfahren gegen DAC8 läuft"}</span
      >
      <span class="key member-key">{en ? "EU member state" : "EU-Staat"}</span>
    </figcaption>
  </figure>

  <ol class="front-cases">
    {cases.map((item) => (
      <li id={item.anchor} class="front-case" data-code={item.code}>
        <h3>
          <span class="front-code" aria-hidden="true">{item.code}</span>
          {item.country}
        </h3>
        <p class="front-meta">{item.date}, {item.forum}</p>
        <p>
          {item.text.map((segment) =>
            typeof segment === "string" ? (
              segment
            ) : (
              <a href={segment.href} hreflang={segment.hreflang}
                >{segment.text}</a
              >
            ),
          )}
        </p>
        {item.link && (
          <a class="text-link" href={item.link.href} hreflang={language}
            >{item.link.text}</a
          >
        )}
      </li>
    ))}
    <li class="front-join">
      <h3>{en ? "And in your country?" : "Und in deinem Land?"}</h3>
      <p>
        {en ? "Every country can be next, Germany too. Lawyers and associations who want to challenge DAC8 where they live: get in touch." : "Jedes Land kann das nächste sein, auch Deutschland. Anwältinnen, Anwälte und Vereine, die DAC8 bei sich anfechten wollen: Meldet euch."}
      </p>
      <a class="button primary" href={contact}>kontakt@dac8.org</a>
    </li>
  </ol>
</section>

<script>
  // Pointing at a country on the map or at its tile lights up both, so the
  // two read together however many countries there are.
  for (const front of document.querySelectorAll<HTMLElement>(".front")) {
    const parts = Array.from(
      front.querySelectorAll<HTMLElement | SVGElement>("[data-code]"),
    )
    const light = (code: string | null) => {
      for (const part of parts)
        part.classList.toggle("is-active", part.dataset.code === code)
    }
    for (const part of parts) {
      if (part.classList.contains("pin")) continue
      const code = part.dataset.code ?? null
      part.addEventListener("pointerenter", () => light(code))
      part.addEventListener("pointerleave", () => light(null))
      part.addEventListener("focusin", () => light(code))
      part.addEventListener("focusout", () => light(null))
    }
  }
</script>

<style>
  /* Text, darunter die Karte über die ganze Breite, darunter die Fälle als
     Kacheln, die mit jedem Land einfach eine mehr werden. Die letzte Kachel
     ist der freie Platz für das nächste Land. */
  .front {
    display: grid;
    gap: var(--space-xl);
  }

  .front-map {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
  }

  /* Wie die Karte der Angriffe: graues Land, helle Grenzen, rote Nadeln.
     Übriges Land blass und zum Rand hin ausgeblendet. */
  svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  .land {
    fill: var(--gray-5);
  }

  .member {
    fill: var(--gray-7);
  }

  .borders {
    fill: none;
    stroke: var(--panel);
    stroke-width: 1.2;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* Länder mit Verfahren liegen rot und leicht erhaben auf der Karte, mit
     eigener Kante und Schatten; beim Zeigen heben sie sich weiter ab. */
  .challenged {
    fill: var(--primary);
    stroke: color-mix(in oklab, var(--primary) 70%, #000);
    stroke-width: 1.2;
    stroke-linejoin: round;
    filter: drop-shadow(0 3px 4px rgb(0 0 0 / 0.28));
    transition:
      fill 160ms ease,
      translate 160ms ease,
      filter 160ms ease;
  }

  a.is-active .challenged {
    translate: 0 -4px;
    filter: drop-shadow(0 9px 10px rgb(0 0 0 / 0.3));
  }

  /* Ist ein Land markiert, treten die anderen roten Länder zurück. */
  svg:has(a.is-active) a:not(.is-active) .challenged {
    fill: color-mix(in oklab, var(--primary) 60%, var(--gray-7));
    filter: none;
  }

  a:focus-visible {
    outline: none;
  }

  a:focus-visible .challenged {
    stroke: var(--ink);
    stroke-width: 3;
  }

  /* Je Land eine Nadel, die leise pulsiert, daneben Name und Monat. */
  .pin {
    pointer-events: none;
  }

  .pin .dot {
    fill: var(--primary);
    stroke: #ffffff;
    stroke-width: 3px;
  }

  .pulse {
    fill: none;
    stroke: #ffffff;
    stroke-width: 2px;
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 2.4s var(--delay, 0s) ease-out infinite;
  }

  @keyframes pulse {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.4);
    }
  }

  .pin text {
    stroke: var(--panel);
    stroke-width: 6px;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .pin.left text {
    text-anchor: end;
  }

  .name {
    fill: var(--ink);
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  /* Der Monat erscheint beim Zeigen, damit auch viele Länder ruhig
     nebeneinander stehen. */
  .when {
    fill: var(--ink-3);
    font-size: 15px;
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .pin.is-active .when {
    opacity: 1;
  }

  .pin .dot {
    transition: transform 160ms ease;
  }

  .pin.is-active .dot {
    transform: scale(1.35);
  }

  /* Die Legende liegt unten links im Atlantik, schmal darunter. */
  .front-map {
    position: relative;
  }

  figcaption {
    position: absolute;
    inset-block-end: var(--space-m);
    inset-inline-start: var(--space-m-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    color: var(--ink-3);
    font-size: var(--type-meta);
    line-height: 1.4;
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .key::before {
    content: "";
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: 0.2rem;
  }

  .member-key::before {
    background: var(--gray-7);
  }

  .challenged-key::before {
    background: var(--primary);
  }

  /* Je Fall eine Kachel: Code und Land, wann und wo, der Stand in einem
     Satz. Die Kacheln sind breit genug, dass Sätze nicht zerfallen. */
  .front-cases {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .front-case,
  .front-join {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-m) var(--space-m-l);
    border-radius: var(--radius-xl);
    background: var(--panel);
    scroll-margin-block-start: calc(var(--header-height) + var(--space-m));
    transition: background-color 160ms ease;
  }

  .front-case.is-active,
  .front-case:target {
    background: var(--panel-strong);
  }

  .front-case h3,
  .front-join h3 {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .front-code {
    padding: 0.1rem 0.4rem;
    border-radius: 0.3rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: var(--type-meta);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .front-cases p {
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .front-meta {
    margin-block: var(--space-3xs) var(--space-xs);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .front-case p:last-of-type {
    flex: 1;
  }

  .front-case .text-link {
    margin-block-start: var(--space-s);
  }

  /* Der freie Platz: gestrichelt statt gefüllt, bis ein Land ihn nimmt. */
  .front-join {
    border: 2px dashed var(--line);
    background: transparent;
  }

  .front-join h3 {
    margin-block-end: var(--space-xs);
  }

  .front-join p {
    flex: 1;
  }

  .front-join .button {
    margin-block-start: var(--space-m);
  }

  /* Schmal fällt der Rand weg, Atlantik und Russland, und Nadeln und
     Namen wachsen mit, damit sie lesbar bleiben. */
  @container campaign (width < 40rem) {
    svg {
      aspect-ratio: 5 / 4;
    }

    figcaption {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: var(--space-m);
    }

    .pin-body {
      scale: 1.8;
    }

    .when {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .challenged,
    .pin .dot,
    .when,
    .front-case {
      transition: none;
    }

    .pulse {
      animation: none;
      opacity: 0;
    }
  }
</style>
