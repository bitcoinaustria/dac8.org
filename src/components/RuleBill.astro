---
import SourceRefs from "@/components/SourceRefs.astro"
import { ruleChronicle } from "@/data/aml-history"
import { historyAsOf, isAhead } from "@/data/history"
import {
  formatNumber,
  reportingBenefit,
  reportingCosts,
  reportsByYear,
  reportsByYearSources,
} from "@/data/history-evidence"
import {
  admissions,
  apparatus,
  corrected,
  estimates,
  germanReportsByYear,
  germanReportsSources,
  recovery,
} from "@/data/history-gap"
import { balanceSources, historySources } from "@/data/history-sources"
import { steps } from "@/data/overregulation"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

// The bill: first the scissors, what rises (the rules in force, suspicion
// reports in Austria and Germany) against what stays flat (the share of
// criminal proceeds confiscated in the EU); then what the reporting costs,
// what it is said to bring, and how the apparatus grows. The rising rows each run on their own
// scale, start and end written beside them; the flat row runs on a scale
// of 100 euros, so its flatness is real. Europol's own sentence follows.
const { language } = Astro.props
const en = language === "en"
const n = (value: number) => formatNumber(value, language)
const { cite } = historySources(language)
const cited = balanceSources(language)
const millions = (value: number) =>
  en ? `€${n(Math.round(value))}m` : `${n(Math.round(value))} Mio. €`
const percent = (value: number) => (en ? `${n(value)}%` : `${n(value)} %`)

const first = 2005
const last = new Date(historyAsOf).getUTCFullYear()
const span = last + 1 - first
const X = (year: number) => ((year + 0.5 - first) / span) * 1000

// Kosten: each duty adds its yearly cost to those before it.
let running = 0
const costRows = reportingCosts.map((cost) => {
  const before = running
  running += cost.millions
  return { ...cost, before }
})
const costTotal = running
const costStyle = (before: number, add: number) =>
  `--before: ${((before / costTotal) * 100).toFixed(2)}%; --add: ${((add / costTotal) * 100).toFixed(2)}%`
// "über 1,2 Milliarden": rounded down to a tenth of a billion.
const costFloor = n(Math.floor(costTotal / 100) / 10)

// Nutzen: the share of direct taxes, then that share opened up.
const benefit = reportingBenefit
const fromDataShare = ((benefit.fromData / benefit.billions) * 100).toFixed(2)

// The apparatus: each row on its own scale, the plan at full width.
const growth = apparatus.map((row) => {
  const top = row.planned?.value ?? row.now.value
  return {
    ...row,
    times: n(Math.round((row.now.value / row.start.value) * 10) / 10),
    style: [
      `--start: ${((row.start.value / top) * 100).toFixed(2)}%`,
      `--now: ${((row.now.value / top) * 100).toFixed(2)}%`,
    ].join("; "),
    show: (value: number) =>
      n(Math.round(value * 10 ** row.digits) / 10 ** row.digits),
  }
})

// Laws without a cost figure, and Germany's DAC8 estimate raised.
const unknownLaws = estimates.filter(
  (tile) => tile.none && tile.none !== "not-material",
).length
const dac8Fix = corrected.find((fix) => fix.id === "dac8") ?? corrected[0]

// Rules in force each year, as on the film's curve.
const statusOf = new Map(ruleChronicle.entries.map((e) => [e.id, e.status]))
const rows = ruleChronicle.stack.flatMap((group) => group.rows)
const inForce = (year: number) =>
  rows.filter(
    (row) =>
      !isAhead(statusOf.get(row.id) ?? "past") &&
      row.from <= year &&
      year <= (row.until ?? Number.POSITIVE_INFINITY),
  ).length

type Point = { year: number; value: number }
const series = (points: Point[]) => {
  const top = Math.max(...points.map((p) => p.value))
  const Y = (value: number) => 96 - (value / top) * 88
  const line = points
    .map(
      (p, k) =>
        `${k ? "L" : "M"}${X(p.year).toFixed(1)} ${Y(p.value).toFixed(1)}`,
    )
    .join(" ")
  const area = `${line} L${X(points[points.length - 1].year).toFixed(1)} 100 L${X(points[0].year).toFixed(1)} 100 Z`
  return { line, area, start: points[0], end: points[points.length - 1] }
}

const yearsTo = (to: number) =>
  Array.from({ length: to - first + 1 }, (_, k) => first + k)
const rising = [
  {
    id: "rules",
    label: en ? "Rules in force" : "Geltende Regeln",
    note: en ? "tax and anti-money-laundering" : "Steuer und Geldwäsche",
    ...series(yearsTo(last).map((year) => ({ year, value: inForce(year) }))),
    sources: steps.find((step) => step.id === "regeln-heute")?.sources ?? [],
  },
  {
    id: "reports-at",
    label: en
      ? "Suspicion reports, Austria"
      : "Verdachtsmeldungen in Österreich",
    note: en
      ? "counted differently from 2012, 2024 and 2025"
      : "Zählweise geändert 2012, 2024 und 2025",
    ...series(
      reportsByYear.map((row) => ({ year: row.year, value: row.reports })),
    ),
    sources: reportsByYearSources,
  },
  {
    id: "reports-de",
    label: en
      ? "Suspicion reports, Germany"
      : "Verdachtsmeldungen in Deutschland",
    note: en ? "counted differently from 2017" : "Zählweise geändert 2017",
    ...series(
      germanReportsByYear.map((row) => ({
        year: row.year,
        value: row.reports,
      })),
    ),
    sources: germanReportsSources,
  },
]

// Confiscated, on a scale of 100 euros: measured for 2010 to 2014, and
// "around 2 %" in 2025 with nothing measured between.
const R = (percent: number) => 100 - percent
const measured = recovery.measured
const flat = {
  measured: `M${X(measured.from).toFixed(1)} ${R(measured.percent)} L${X(measured.to).toFixed(1)} ${R(measured.percent)}`,
  unknown: `M${X(measured.to).toFixed(1)} ${R(measured.percent)} L${X(recovery.latest.year).toFixed(1)} ${R(recovery.latest.percent)}`,
  dot: { x: X(recovery.latest.year) / 10, y: R(recovery.latest.percent) },
  gone: `M${X(measured.from).toFixed(1)} 0 L${X(recovery.latest.year).toFixed(1)} 0 L${X(recovery.latest.year).toFixed(1)} ${R(recovery.latest.percent)} L${X(measured.to).toFixed(1)} ${R(measured.percent)} L${X(measured.from).toFixed(1)} ${R(measured.percent)} Z`,
}
const ticks = [2005, 2010, 2015, 2020, 2025].map((year) => ({
  year,
  style: `--at: ${(X(year) / 10).toFixed(2)}%`,
}))
const euros = (value: number) => (en ? `€${n(value)}` : `${n(value)} €`)
---

<section id="rechnung" class="scissors" aria-labelledby="rechnung-heading">
  <h2 id="rechnung-heading">
    {en ? "The bill." : "Die Rechnung."}
    <span
      >{en ? "The effort grows. As little is confiscated." : "Der Aufwand wächst. Eingezogen wird gleich wenig."}</span
    >
  </h2>

  <div class="sc" data-reveal>
    {rising.map((row) => (
      <div class="sc-row">
        <p class="sc-label">
          {row.label}
          <span>{row.note}</span>
        </p>
        <svg class="sc-plot" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="sc-area" d={row.area} />
          <path class="sc-line" d={row.line} pathLength="1" />
        </svg>
        <p class="sc-values">
          <span><b>{n(row.start.value)}</b> {row.start.year}</span>
          <span class="end"><b>{n(row.end.value)}</b> {row.end.year}</span>
        </p>
      </div>
    ))}

    <div class="sc-row flat">
      <p class="sc-label">
        {en ? "Of 100 euros from crime, confiscated" : "Von 100 € aus Straftaten eingezogen"}
        <span
          >{en ? "EU, as Europol estimates it; on a scale of €100" : "EU, nach Schätzung von Europol; Maßstab 0 bis 100 €"}</span
        >
      </p>
      <div class="sc-flat">
        <svg
          class="sc-plot"
          viewBox="0 0 1000 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <line class="sc-top" x1="0" y1="0" x2="1000" y2="0" />
          <path class="sc-gone" d={flat.gone} />
          <path class="sc-red" d={flat.measured} pathLength="1" />
          <path class="sc-red unknown" d={flat.unknown} />
        </svg>
        <span class="sc-top-label">100 €</span>
        <span class="sc-gone-label"
          >{en ? "not confiscated" : "nicht eingezogen"}</span
        >
        <span class="sc-dot" style={`left: ${flat.dot.x}%`} />
      </div>
      <p class="sc-values">
        <span class="red"
          ><b>{euros(measured.percent)}</b> {measured.from}–{measured.to}</span
        >
        <span class="end red"
          ><b
            >{en ? `about ${euros(recovery.latest.percent)}` : `rund ${euros(recovery.latest.percent)}`}</b
          > {recovery.latest.year}</span
        >
      </p>
    </div>

    <div class="sc-axis" aria-hidden="true">
      {ticks.map((tick) => <span style={tick.style}>{tick.year}</span>)}
    </div>
  </div>

  <p class="sc-note">
    {en
      ? "The three rising rows each on their own scale, from their first to their last value; the red row on a scale of 100 euros. Dashed: no measurement in between."
      : "Die drei steigenden Zeilen je auf eigenem Maßstab, vom ersten zum letzten Wert; die rote Zeile auf einem Maßstab von 100 €. Gestrichelt: dazwischen nicht gemessen."}
    <SourceRefs
      sources={cite([...rising.flatMap((row) => row.sources), ...recovery.sources])}
      language={language}
    />
  </p>

  <blockquote class="sc-quote" data-reveal>
    <p>{recovery.quote[language]}</p>
    <footer>
      {en ? "Europol, 2025" : "Europol, 2025"}
      <SourceRefs sources={cite([recovery.sources[1]])} language={language} />
    </footer>
  </blockquote>

  <ol class="balance-grid">
    <!-- Kosten: the yearly cost grows with every duty -->
    <li class="balance-card">
      <p class="balance-kicker">{en ? "Cost" : "Kosten"}</p>
      <h3>
        {en
          ? `Over ${costFloor} billion euros a year.`
          : `Über ${costFloor} Milliarden Euro im Jahr.`}
      </h3>
      <ol class="costs">
        {costRows.map((cost) => (
          <li style={costStyle(cost.before, cost.millions)}>
            <span class="cost-what">
              <b>{en ? `From ${cost.since}` : `Ab ${cost.since}`}</b>
              {cost.what[language]}
            </span>
            <span class="cost-bar" aria-hidden="true">
              <span class="cost-old" />
              <span class="cost-new" />
            </span>
            <span class="cost-value">+{millions(cost.millions)}</span>
            {cost.note && <span class="cost-note">{cost.note[language]}</span>}
          </li>
        ))}
      </ol>
      <p class="balance-line">
        {en
          ? "The running cost of three duties to report to the tax office, every year, as the Commission estimates it."
          : "Laufende Kosten von drei Meldepflichten an die Steuer, jedes Jahr, nach Schätzung der Kommission."}
        <SourceRefs sources={cite(cited.costs)} language={language} />
      </p>
      <p class="balance-line">
        {en
          ? `What the rules cost business is often not even estimated: for ${unknownLaws} of ${estimates.length} Austrian laws on money laundering and tax reporting since 2015 there is no figure. Germany first put the one-off cost of DAC8 at €${n(dac8Fix.before)}m, then at €${n(dac8Fix.after)}m.`
          : `Was die Regeln die Wirtschaft kosten, wird oft nicht einmal geschätzt: Für ${unknownLaws} von ${estimates.length} österreichischen Gesetzen zu Geldwäsche und Steuermeldungen seit 2015 gibt es keine Zahl. Deutschland schätzte die einmaligen Kosten von DAC8 erst auf ${n(dac8Fix.before)}, dann auf ${n(dac8Fix.after)} Mio. €.`}
        <SourceRefs
          sources={cite([...estimates.map((tile) => tile.source), ...dac8Fix.sources])}
          language={language}
        />
      </p>
    </li>

    <!-- Nutzen: a sliver of the taxes, and most of it a model -->
    <li class="balance-card">
      <p class="balance-kicker">{en ? "Benefit" : "Nutzen"}</p>
      <h3>
        {en
          ? `${percent(benefit.shareOfDirectTaxes)} of direct taxes, mostly estimated.`
          : `${percent(benefit.shareOfDirectTaxes)} der direkten Steuern, großteils geschätzt.`}
      </h3>
      <div class="benefit" aria-hidden="true">
        <div class="benefit-all">
          <span
            >{en ? "All direct taxes in the EU" : "Alle direkten Steuern in der EU"}</span
          >
          <span class="benefit-sliver" />
        </div>
        <div class="benefit-zoom" />
        <div class="benefit-part" style={`--data: ${fromDataShare}%`}>
          <span class="benefit-data" />
          <span class="benefit-model" />
        </div>
        <div class="benefit-labels">
          <span>
            <b
              >{en ? `€${n(benefit.fromData)}bn` : `${n(benefit.fromData)} Mrd. €`}</b
            >
            {en ? "from data" : "aus Daten"}
          </span>
          <span class="model">
            <b
              >{en ? `€${n(benefit.modelled)}bn` : `${n(benefit.modelled)} Mrd. €`}</b
            >
            {en ? "modelled without data" : "Modell ohne Daten"}
          </span>
        </div>
      </div>
      <p class="balance-line">
        {en
          ? `What all exchanged tax data bring a year, as the Commission estimates it: €${n(benefit.billions)} billion.`
          : `So viel bringen alle ausgetauschten Steuerdaten im Jahr, schätzt die Kommission: ${n(benefit.billions)} Milliarden Euro.`}
        <SourceRefs sources={cite(cited.benefit)} language={language} />
      </p>
    </li>
  </ol>

  <!-- 1. The apparatus -->
  <div class="gap-block" data-reveal>
    <h3>{en ? "More staff, more budget." : "Mehr Personal, mehr Budget."}</h3>
    <ol class="growth">
      {growth.map((row) => (
        <li style={row.style}>
          <p class="growth-who">
            {row.who[language]}
            <span>{row.unit[language]}</span>
          </p>
          <p class="growth-times">×{row.times}</p>
          <div class="growth-track" aria-hidden="true">
            <span class="growth-now" />
            <span class="growth-plan" />
            <span class="growth-start" />
          </div>
          <p class="growth-values">
            <span><b>{row.show(row.start.value)}</b> {row.start.year}</span>
            <span><b>{row.show(row.now.value)}</b> {row.now.year}</span>
            {row.planned && (
              <span class="planned">
                {en ? "planned" : "geplant"} <b>{row.show(row.planned.value)}</b>
                {row.planned.year && ` ${row.planned.year}`}
              </span>
            )}
          </p>
        </li>
      ))}
    </ol>
    <p class="gap-line">
      {en
        ? "Each row on its own scale; the dashed part is planned."
        : "Jede Zeile auf ihrem eigenen Maßstab; gestrichelt, was geplant ist."}
      <SourceRefs
        sources={cite(apparatus.flatMap((row) => row.sources))}
        language={language}
      />
    </p>
  </div>
  <blockquote class="gap-quote" data-reveal>
    <p>{admissions.staff.quote[language]}</p>
    <footer>
      {admissions.staff.who[language]}
      <SourceRefs
        sources={cite([admissions.staff.source])}
        language={language}
      />
    </footer>
  </blockquote>
</section>

<script>
  // Lines draw themselves once the chart comes into view.
  const parts = document.querySelectorAll<HTMLElement>(
    ".scissors [data-reveal]",
  )
  const watch = new IntersectionObserver(
    (entries) => {
      for (const entry of entries)
        if (entry.isIntersecting) {
          entry.target.classList.add("seen")
          watch.unobserve(entry.target)
        }
    },
    { rootMargin: "0px 0px -20% 0px" },
  )
  for (const part of parts) watch.observe(part)
  document.documentElement.classList.add("scissors-ready")
</script>

<style>
  .scissors {
    --bar: light-dark(#3b4147, #a7afb6);
    --red: var(--primary);
    --hatch: repeating-linear-gradient(
      135deg,
      color-mix(in oklab, var(--red) 70%, transparent) 0 2px,
      transparent 2px 6px
    );
    display: grid;
    gap: var(--space-l);
  }

  .sc {
    display: grid;
    gap: var(--space-m);
    max-inline-size: 60rem;
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .sc-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
  }

  .sc-label {
    color: var(--ink);
    font-weight: 560;
    line-height: 1.3;
  }

  .sc-label span {
    display: block;
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-weight: 400;
  }

  .sc-plot {
    display: block;
    inline-size: 100%;
    block-size: clamp(3.5rem, 8vw, 5rem);
    overflow: visible;
  }

  .sc-area {
    fill: color-mix(in oklab, var(--bar) 16%, transparent);
  }

  .sc-line {
    fill: none;
    stroke: var(--bar);
    stroke-width: 2.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .sc-values {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .sc-values b {
    color: var(--ink);
    font-weight: 650;
  }

  .sc-values .red,
  .sc-values .red b {
    color: var(--accent);
  }

  /* Die rote Zeile: Maßstab 100 €, die Linie liegt am Boden, darüber das
     nicht Eingezogene. */
  .sc-flat {
    position: relative;
    margin-block-start: 0.7rem;
  }

  .sc-top {
    stroke: var(--ink-3);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }

  .sc-gone {
    fill: color-mix(in oklab, var(--bar) 7%, transparent);
  }

  .sc-red {
    fill: none;
    stroke: var(--red);
    stroke-width: 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
  }

  .sc-red.unknown {
    stroke-width: 2.5;
    stroke-dasharray: 5 5;
  }

  .sc-top-label,
  .sc-gone-label {
    position: absolute;
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .sc-top-label {
    inset-block-start: -0.6rem;
    inset-inline-start: 0;
    padding-inline-end: 0.3rem;
    background: var(--panel);
    line-height: 1.2;
  }

  .sc-gone-label {
    inset-block-start: 38%;
    inset-inline-start: 50%;
    translate: -50% 0;
    letter-spacing: 0.04em;
  }

  .sc-dot {
    position: absolute;
    inset-block-end: calc(2% - 0.35rem);
    inline-size: 0.7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
    translate: -50% 0;
  }

  .sc-axis {
    position: relative;
    block-size: 1.2rem;
    border-block-start: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .sc-axis span {
    position: absolute;
    inset-block-start: 0.2rem;
    inset-inline-start: var(--at);
    translate: -50% 0;
    white-space: nowrap;
  }

  .sc-note {
    max-inline-size: 62ch;
    color: var(--ink-2);
    font-size: var(--type-meta);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .sc-quote {
    display: grid;
    gap: var(--space-2xs);
    max-inline-size: 52rem;
    margin: 0;
    padding-inline-start: var(--space-l);
    border-inline-start: 6px solid var(--red);
  }

  .sc-quote p {
    color: var(--ink);
    font-size: var(--type-h3);
    font-weight: var(--weight-heading);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .sc-quote footer {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  /* ---------- Kosten und Nutzen, Personal ------------------------------ */

  .balance-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  @container campaign (width >= 56rem) {
    .balance-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .balance-card {
    display: grid;
    grid-template-rows: auto auto 1fr;
    align-content: start;
    gap: var(--space-s);
    min-inline-size: 0;
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .balance-kicker {
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-weight: 560;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .balance-card h3 {
    max-inline-size: 22ch;
  }

  .balance-line {
    max-inline-size: 52ch;
    color: var(--ink-2);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .balance-admission {
    max-inline-size: 52ch;
    padding-inline-start: var(--space-s);
    border-inline-start: 3px solid var(--red);
    color: var(--ink);
    font-weight: 560;
    line-height: 1.4;
    text-wrap: pretty;
  }

  /* ---------- Kosten ---------------------------------------------------- */

  /* Jede Zeile trägt die Kosten davor grau und die neue Pflicht rot. */
  .costs {
    display: grid;
    gap: var(--space-s);
    align-self: center;
    margin: var(--space-2xs) 0;
    padding: 0;
    list-style: none;
  }

  .costs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.3rem var(--space-s);
    align-items: baseline;
  }

  .cost-what {
    color: var(--ink-2);
    font-size: var(--type-meta);
  }

  .cost-what b {
    margin-inline-end: 0.4em;
    color: var(--ink);
  }

  .cost-bar {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 2;
    block-size: 1.6rem;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--bar) 8%, transparent);
  }

  .cost-old,
  .cost-new {
    position: absolute;
    inset-block: 0;
  }

  .cost-old {
    inset-inline-start: 0;
    inline-size: var(--before);
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    background: var(--bar);
  }

  .cost-new {
    inset-inline-start: var(--before);
    inline-size: max(3px, var(--add));
    border-radius: var(--radius-sm);
    background: var(--red);
