---
import SourceRefs from "@/components/SourceRefs.astro"
import { formatNumber } from "@/data/history-evidence"
import {
  admissions,
  apparatus,
  bankPackage,
  corrected,
  estimates,
  germanReports,
  reportSources,
} from "@/data/history-gap"
import { historySources } from "@/data/history-sources"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

// The gap between the film and the balance: three pictures of what grows
// and how little is known about it, each followed by an authority saying
// so in its own words, and DAC8's own bill at the end. Data and sources in
// src/data/history-gap.ts.
const { language } = Astro.props
const en = language === "en"
const n = (value: number) => formatNumber(value, language)
const { cite } = historySources(language)

// The apparatus: each row on its own scale, the plan at full width.
const growth = apparatus.map((row) => {
  const top = row.planned?.value ?? row.now.value
  return {
    ...row,
    times: n(Math.round((row.now.value / row.start.value) * 10) / 10),
    style: [
      `--start: ${((row.start.value / top) * 100).toFixed(2)}%`,
      `--now: ${((row.now.value / top) * 100).toFixed(2)}%`,
    ].join("; "),
    show: (value: number) =>
      n(Math.round(value * 10 ** row.digits) / 10 ** row.digits),
  }
})

// The laws: a figure, or why there is none.
const noneLabel = {
  "no-assessment": en ? "no impact assessment" : "ohne Folgen\u00adabschätzung",
  "no-figure": en ? "no figure" : "keine Zahl",
  "not-estimable": en ? "cannot be estimated" : "nicht abschätzbar",
  "not-material": en
    ? "not material, says the government"
    : "laut Regierung unwesentlich",
} as const
const tiles = estimates.map((item) => ({
  ...item,
  figure: item.millions
    ? en
      ? `€${item.millions.replace(",", ".")}m`
      : `${item.millions} Mio. €`
    : undefined,
}))
const unknown = tiles.filter(
  (tile) => tile.none && tile.none !== "not-material",
)

const fixes = corrected.map((item) => ({
  ...item,
  style: `--before: ${((item.before / item.after) * 100).toFixed(2)}%`,
  times: n(Math.round((item.after / item.before) * 10) / 10),
}))

// Reports, prosecutors' replies and those that reached a court, all on
// one scale: the latest year's reports at full width.
const pkg = bankPackage
const reports = germanReports
const share = (value: number) =>
  `${Math.max(0.3, (value / reports.latest.value) * 100).toFixed(2)}%`
const courtShare = Math.round((reports.atCourt / reports.replies) * 100)
const reportRows = [
  {
    label: en
      ? `Reports ${reports.first.year}`
      : `Meldungen ${reports.first.year}`,
    value: reports.first.value,
    red: false,
  },
  {
    label: en
      ? `Reports ${reports.latest.year}`
      : `Meldungen ${reports.latest.year}`,
    value: reports.latest.value,
    red: false,
  },
  {
    label: en
      ? `Replies from prosecutors ${reports.latest.year}`
      : `Rückmeldungen der Staatsanwaltschaften ${reports.latest.year}`,
    value: reports.replies,
    red: false,
  },
  {
    label: en
      ? "of which a judgment, indictment or penalty order"
      : "davon Urteil, Anklage oder Strafbefehl",
    value: reports.atCourt,
    red: true,
  },
]
---

<section id="kluft" class="gap" aria-labelledby="kluft-heading">
  <h2 id="kluft-heading">
    {en ? "The gap." : "Die Kluft."}
    <span
      >{en ? "The apparatus grows, little is measured." : "Der Apparat wächst, gemessen wird kaum."}</span
    >
  </h2>

  <!-- 1. The apparatus -->
  <div class="gap-block" data-reveal>
    <h3>{en ? "More staff, more budget." : "Mehr Personal, mehr Budget."}</h3>
    <ol class="growth">
      {growth.map((row) => (
        <li style={row.style}>
          <p class="growth-who">
            {row.who[language]}
            <span>{row.unit[language]}</span>
          </p>
          <p class="growth-times">×{row.times}</p>
          <div class="growth-track" aria-hidden="true">
            <span class="growth-now" />
            <span class="growth-plan" />
            <span class="growth-start" />
          </div>
          <p class="growth-values">
            <span><b>{row.show(row.start.value)}</b> {row.start.year}</span>
            <span><b>{row.show(row.now.value)}</b> {row.now.year}</span>
            {row.planned && (
              <span class="planned">
                {en ? "planned" : "geplant"} <b>{row.show(row.planned.value)}</b>
                {row.planned.year && ` ${row.planned.year}`}
              </span>
            )}
          </p>
        </li>
      ))}
    </ol>
    <p class="gap-line">
      {en
        ? "Each row on its own scale; the dashed part is planned."
        : "Jede Zeile auf ihrem eigenen Maßstab; gestrichelt, was geplant ist."}
      <SourceRefs
        sources={cite(apparatus.flatMap((row) => row.sources))}
        language={language}
      />
    </p>
  </div>
  <blockquote class="gap-quote" data-reveal>
    <p>{admissions.staff.quote[language]}</p>
    <footer>
      {admissions.staff.who[language]}
      <SourceRefs
        sources={cite([admissions.staff.source])}
        language={language}
      />
    </footer>
  </blockquote>

  <!-- 2. What it costs -->
  <div class="gap-block" data-reveal>
    <h3>
      {en ? "What it costs business is rarely estimated." : "Was es die Wirtschaft kostet, schätzt kaum jemand."}
    </h3>
    <ol class="tiles">
      {tiles.map((tile, k) => (
        <li
          class:list={{ none: tile.none && tile.none !== "not-material" }}
          style={`--k: ${k}`}
        >
          <span class="tile-year">{tile.year}</span>
          <span class="tile-law">{tile.law[language]}</span>
          <span class="tile-figure">
            {tile.figure ? (
              <>
                <b>{tile.figure}</b> {en ? "a year" : "im Jahr"}
              </>
            ) : (
              tile.none && noneLabel[tile.none]
            )}
          </span>
          {tile.note && <span class="tile-note">{tile.note[language]}</span>}
        </li>
      ))}
    </ol>
    <p class="gap-line">
      {en
        ? `Austrian laws on money laundering and tax reporting since 2015, a selection: what each was expected to cost business a year, as the bill put it to parliament. For ${unknown.length} of ${tiles.length} there is no figure; members’ motions come without an impact assessment, the reckoning of what a law costs and brings.`
        : `Österreichische Gesetze zu Geldwäsche und Steuermeldungen seit 2015, eine Auswahl: was jedes die Wirtschaft im Jahr kosten sollte, wie es dem Parlament vorgelegt wurde. Bei ${unknown.length} von ${tiles.length} gibt es keine Zahl; Anträge aus dem Parlament kommen ohne Folgenabschätzung, also ohne Rechnung, was ein Gesetz kostet und bringt.`}
      <SourceRefs
        sources={cite(estimates.map((tile) => tile.source))}
        language={language}
      />
    </p>
    <div class="fixes">
      <p class="fixes-title">
        {en ? "Where someone did the sums again, in Germany:" : "Wo nachgerechnet wurde, in Deutschland:"}
      </p>
      {fixes.map((fix) => (
        <div class="fix" style={fix.style}>
          <p class="fix-law">
            {fix.law[language]}
            <span>{fix.what[language]}</span>
          </p>
          <div class="fix-bars" aria-hidden="true">
            <span class="fix-before" />
            <span class="fix-after" />
          </div>
          <p class="fix-values">
            {en ? "first" : "erst"} <b>{n(fix.before)}</b>, {en ? "then" : "dann"}{" "}
            <b>{n(fix.after)}</b>
            <span class="fix-times">×{fix.times}</span>
          </p>
        </div>
      ))}
      <p class="gap-line">
        <SourceRefs
          sources={cite(corrected.flatMap((fix) => fix.sources))}
          language={language}
        />
      </p>
    </div>
  </div>
  <blockquote class="gap-quote" data-reveal>
    <p>{admissions.costs.quote[language]}</p>
    <footer>
      {admissions.costs.who[language]}
      <SourceRefs
        sources={cite([admissions.costs.source])}
        language={language}
      />
    </footer>
  </blockquote>

  <!-- 3. What it brings -->
  <div class="gap-block" data-reveal>
    <h3>
      {en ? "What it brings, hardly anyone measures." : "Was es bringt, misst kaum jemand."}
    </h3>
    <div class="reports">
      {reportRows.map((row) => (
        <p class:list={["reports-row", { red: row.red }]} style={`--w: ${share(row.value)}`}>
          <span class="reports-label">{row.label}</span>
          <span class="reports-bar" aria-hidden="true" />
          <span class="reports-value">{n(row.value)}</span>
        </p>
      ))}
    </div>
    <p class="gap-line">
      {en
        ? `Suspicion reports to Germany’s financial intelligence unit, and in ${reports.latest.year} the prosecutors’ replies on them, all on one scale: ${courtShare} percent of the replies concerned a judgment, an indictment or a penalty order.`
        : `Verdachtsmeldungen an die deutsche Geldwäschemeldestelle und ${reports.latest.year} die Rückmeldungen der Staatsanwaltschaften dazu, alle auf einem Maßstab: ${courtShare} Prozent der Rückmeldungen betrafen ein Urteil, eine Anklage oder einen Strafbefehl.`}
      <SourceRefs sources={cite(reportSources)} language={language} />
    </p>
  </div>
  <blockquote class="gap-quote" data-reveal>
    <p>{admissions.outcomes.quote[language]}</p>
    <footer>
      {admissions.outcomes.who[language]}
      <SourceRefs
        sources={cite([admissions.outcomes.source])}
        language={language}
      />
    </footer>
  </blockquote>

  <!-- 4. Austria's bank package: promised, counted, ticked off -->
  <div class="gap-block" data-reveal>
    <h3>
      {en ? "Promised, not measured, ticked off." : "Versprochen, nicht gemessen, abgehakt."}
    </h3>
    <p class="gap-intro">
      {en
        ? "Austria’s bank package of 2015 relaxed banking secrecy and brought the central account register, reports on money leaving the country and the automatic exchange of account data."
        : "Österreichs Bankenpaket 2015 lockerte das Bankgeheimnis und brachte das zentrale Kontenregister, Meldungen über Geldabflüsse und den automatischen Austausch von Kontodaten."}
    </p>
    <ol class="steps-row">
      <li>
        <span class="step-when"
          >{en ? "2015, promised" : "2015, versprochen"}</span
        >
        <b class="step-big"
          >{en ? `€${pkg.promised.millions}m` : `${pkg.promised.millions} Mio. €`}</b
        >
        <span class="step-what">
          {en
            ? `extra revenue in ${pkg.promised.year} alone. For the account exchange there was, the bill says, no serious basis for an estimate.`
            : `Mehreinnahmen allein ${pkg.promised.year}. Für den Kontenaustausch gab es laut Vorlage keine seriöse Grundlage für eine Schätzung.`}
          <SourceRefs
            sources={cite([pkg.sources.bill, admissions.revenue.source])}
            language={language}
          />
        </span>
      </li>
      <li>
        <span class="step-when">{en ? "2019, counted" : "2019, gezählt"}</span>
        <b class="step-big">{n(pkg.queries)}</b>
        <span class="step-what">
          {en
            ? `account-register queries by the tax authorities. Whether they brought in extra tax cannot be evaluated electronically, says the ministry; measured: €${n(pkg.inspections.euros)} from ${pkg.inspections.count} account inspections.`
            : `Abfragen der Finanzbehörden im Kontenregister. Ob sie Steuern brachten, ist laut Ministerium „elektronisch nicht auswertbar“; gemessen: ${n(pkg.inspections.euros)} € aus ${pkg.inspections.count} Konteneinschauen.`}
          <SourceRefs
            sources={cite([pkg.sources.answer])}
            language={language}
          />
        </span>
      </li>
      <li>
        <span class="step-when"
          >{en ? "2020, ticked off" : "2020, abgehakt"}</span
        >
        <b class="step-big red"
          >{en ? "Fully achieved" : "„zur Gänze erreicht“"}</b
        >
        <span class="step-what">
          {en
            ? "was the rating of its goals in the government’s own evaluation, because the laws had been passed. The actual extra revenue cannot be determined directly, it writes; its table shows the planned millions again. Room for improvement? No."
            : "laut eigener Evaluierung, weil die Gesetze beschlossen waren. Die tatsächlichen Mehreinnahmen direkt zu ermitteln, sei nicht möglich; die Tabelle zeigt wieder die geplanten Millionen. „Haben sich Verbesserungspotenziale ergeben? Nein“."}
          <SourceRefs
            sources={cite([pkg.sources.evaluation])}
            language={language}
          />
        </span>
      </li>
    </ol>
  </div>

  <!-- And DAC8 itself -->
  <div class="gap-last" data-reveal>
    <p class="gap-last-title">{en ? "And DAC8?" : "Und DAC8?"}</p>
    <blockquote class="gap-quote last">
      <p>{admissions.austria.quote[language]}</p>
      <footer>
        {admissions.austria.who[language]}
        <SourceRefs
          sources={cite([admissions.austria.source])}
          language={language}
        />
      </footer>
    </blockquote>
    <blockquote class="gap-quote last">
      <p>{admissions.last.quote[language]}</p>
      <footer>
        {admissions.last.who[language]}
        <SourceRefs
          sources={cite([admissions.last.source])}
          language={language}
        />
      </footer>
    </blockquote>
  </div>
</section>

<script>
  // Each block draws itself once it comes into view.
  const blocks = document.querySelectorAll<HTMLElement>(".gap [data-reveal]")
  const watch = new IntersectionObserver(
    (entries) => {
      for (const entry of entries)
        if (entry.isIntersecting) {
          entry.target.classList.add("seen")
          watch.unobserve(entry.target)
        }
    },
    { rootMargin: "0px 0px -15% 0px" },
  )
  for (const block of blocks) watch.observe(block)
  document.documentElement.classList.add("gap-ready")
</script>

<style>
  .gap {
    --bar: light-dark(#3b4147, #a7afb6);
    --red: var(--primary);
    display: grid;
    gap: var(--space-xl);
  }

  .gap > h2 {
    margin-block-end: calc(var(--space-m) * -1);
  }

  .gap-block {
    display: grid;
    gap: var(--space-m);
    max-inline-size: 60rem;
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .gap-line {
    max-inline-size: 62ch;
    color: var(--ink-2);
    font-size: var(--type-meta);
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* ---------- Personal ------------------------------------------------- */

  .growth {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .growth li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem var(--space-s);
    align-items: end;
  }

  .growth-who {
    color: var(--ink);
    font-weight: 560;
    line-height: 1.3;
  }

  .growth-who span {
    display: block;
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-weight: 400;
  }

  .growth-times {
    color: var(--accent);
    font-size: var(--step-3);
    font-weight: var(--weight-heading);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .growth-track {
    position: relative;
    grid-column: 1 / -1;
    block-size: 1.1rem;
  }

  .growth-now,
  .growth-plan,
  .growth-start {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    border-radius: var(--radius-sm);
  }

  .growth-plan {
    inline-size: 100%;
    border: 1.5px dashed var(--ink-3);
  }

  .growth-now {
    z-index: 1;
    inline-size: var(--now);
    background: var(--bar);
    transform-origin: left;
  }

  .growth-start {
    z-index: 2;
    inline-size: max(3px, var(--start));
    background: var(--red);
  }

  .growth-values {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .growth-values b {
    color: var(--ink);
    font-weight: 600;
  }

  .growth-values span:first-child b {
    color: var(--accent);
  }

  /* ---------- Kosten --------------------------------------------------- */

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 8rem), 1fr));
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tiles li {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 0.25rem;
    min-block-size: 6.5rem;
    padding: 0.6rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line);
  }

  .tiles li.none {
    background: transparent;
    box-shadow: none;
    outline: 1.5px dashed color-mix(in oklab, var(--red) 70%, transparent);
    outline-offset: -1.5px;
  }

  .tile-year {
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-weight: 600;
  }

  .tile-law {
    color: var(--ink);
    font-size: var(--type-meta);
    line-height: 1.3;
    hyphens: auto;
    overflow-wrap: normal;
  }

  .tile-figure {
    color: var(--ink-3);
    font-size: var(--type-meta);
    line-height: 1.25;
    overflow-wrap: normal;
    hyphens: manual;
  }

  .tile-figure b {
    display: block;
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: var(--weight-heading);
  }

  .tile-note {
    color: var(--ink-3);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .tiles li.none .tile-figure {
    color: var(--accent);
    font-weight: 600;
  }

  .fixes {
    display: grid;
    gap: var(--space-s);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--line);
  }

  .fixes-title {
    color: var(--ink);
    font-weight: 560;
  }

  .fix {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
  }

  .fix-law {
    color: var(--ink-2);
    font-size: var(--type-meta);
  }

  .fix-law span {
    margin-inline-start: 0.5em;
    color: var(--ink-3);
  }

  .fix-bars {
    display: grid;
    gap: 3px;
  }

  .fix-before,
  .fix-after {
    display: block;
    block-size: 0.8rem;
    border-radius: var(--radius-sm);
    transform-origin: left;
  }

  .fix-before {
    inline-size: var(--before);
    background: var(--bar);
  }

  .fix-after {
    inline-size: 100%;
    background: var(--red);
  }

  .fix-values {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .fix-values b {
    color: var(--ink);
  }

  .fix-times {
    margin-inline-start: 0.6em;
    color: var(--accent);
    font-weight: 700;
  }

  /* ---------- Ertrag --------------------------------------------------- */

  .reports {
    display: grid;
    gap: var(--space-2xs);
  }

  .reports-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.2rem var(--space-s);
    align-items: center;
  }

  .reports-label {
    color: var(--ink-2);
    font-size: var(--type-meta);
  }

  .reports-bar {
    grid-column: 1 / -1;
    grid-row: 2;
    display: block;
    inline-size: max(3px, var(--w));
    block-size: 1.4rem;
    border-radius: var(--radius-sm);
    background: var(--bar);
    transform-origin: left;
  }

  .reports-row.red .reports-bar {
    background: var(--red);
  }

  .reports-value {
    color: var(--ink);
    font-weight: 600;
  }

  .reports-row.red :is(.reports-label, .reports-value) {
    color: var(--accent);
  }

  /* ---------- Bankenpaket -------------------------------------------- */

  .gap-intro {
    max-inline-size: 62ch;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .steps-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  @container campaign (width >= 52rem) {
    .steps-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .steps-row li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: var(--space-s);
    border-radius: var(--radius-sm);
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line);
  }

  .step-when {
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .step-big {
    color: var(--ink);
    font-size: var(--step-3);
    font-weight: var(--weight-heading);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .step-big.red {
    color: var(--accent);
    font-size: var(--step-2);
  }

  .step-what {
    color: var(--ink-2);
    font-size: var(--type-meta);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .gap-last {
    display: grid;
    gap: var(--space-l);
  }

  .gap-last-title {
    color: var(--ink-3);
    font-size: var(--type-meta);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---------- Zitate --------------------------------------------------- */

  .gap-quote {
    display: grid;
    gap: var(--space-2xs);
    max-inline-size: 46rem;
    margin: 0;
    margin-inline-start: clamp(0rem, 8vw, 6rem);
    padding-inline-start: var(--space-m);
    border-inline-start: 3px solid var(--red);
  }

  .gap-quote p {
    color: var(--ink);
    font-size: var(--type-lead);
    font-weight: 560;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .gap-quote footer {
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .gap-quote.last {
    margin-inline-start: 0;
    max-inline-size: 52rem;
    padding-inline-start: var(--space-l);
    border-inline-start-width: 6px;
  }

  .gap-quote.last p {
    font-size: var(--type-h2);
    font-weight: var(--weight-heading);
