---
import {
  attacks,
  countIn,
  euCountries,
  formatDate,
  latestDate,
  latestYear,
} from "@/lib/attacks"
import { type Language, pathFor } from "@/lib/i18n"

interface Props {
  language: Language
}

// Under the leak page's cases that reached someone's door: the archive's
// key figures in one sentence, the caveat in one more, then the way to the
// archive. France's own count is one of the cases above it.
const { language } = Astro.props
const en = language === "en"

const through = latestDate ? formatDate(latestDate, language, false) : ""
const now = countIn(latestYear)
const before = countIn(latestYear - 1)
const euNow = countIn(latestYear, euCountries)
---

<div class="attack-summary">
  <p class="figure-line">
    {en ? (
      <>
        Worldwide, <strong>{attacks.length} physical attacks</strong> on
        holders of bitcoin and other crypto-assets are publicly known. There
        were {before} in {latestYear - 1} and <strong>{now}</strong> in{" "}
        {latestYear} up to {through}, {euNow} of them in the EU.
      </>
    ) : (
      <>
        Weltweit sind <strong>{attacks.length} körperliche Angriffe</strong> auf
        Besitzer von Bitcoin und anderen Kryptowerten öffentlich bekannt.{" "}
        {latestYear - 1} waren es {before}, {latestYear} bis {through} schon{" "}
        <strong>{now}</strong>, {euNow} davon in der EU.
      </>
    )}
  </p>
  <p class="attack-caveat">
    {en
        ? "Most victims stay silent, and many cases never become public."
        : "Die meisten Opfer schweigen, viele Fälle werden nie öffentlich."}
  </p>
  <a class="button primary" href={pathFor("attacks", language)}
    >{en ? "Open the attack archive" : "Zum Angriffsarchiv"}</a
  >
</div>

<style>
  .attack-summary {
    margin-block-start: var(--space-xl);
  }

  .attack-caveat {
    margin-block-start: var(--space-2xs);
    color: var(--ink-3);
    font-size: var(--type-meta);
  }

  .attack-summary .button {
    margin-block-start: var(--space-l);
  }
</style>
