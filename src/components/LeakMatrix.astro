---
import { featuredLeaks, fields, type Leak } from "@/data/leaks"
import type { Language } from "@/lib/i18n"

// Belegte Lecks, gezeigt nach dem, was verloren ging: Name und Anschrift,
// Ausweis, Wallet, Bestände oder Steuerdaten. Die Spalten sind die Teile,
// die bei einem Anbieter für DAC8 zusammenliegen. Keine Fallzahlen, weil
// die Größe eines Lecks nichts darüber sagt, wie gefährlich es ist.
// Die Fälle stehen in src/data/leaks.ts; ohne items zeigt die Tabelle die
// hervorgehobenen.
interface Props {
  language: Language
  items?: Leak[]
}

const { language, items = featuredLeaks } = Astro.props
const en = language === "en"
---

<table class="leak-matrix">
  <caption class="visually-hidden">
    {en ? "Known leaks by the kind of data lost" : "Bekannte Lecks nach Art der verlorenen Daten"}
  </caption>
  <colgroup>
    <col class="col-leak">
    {fields.map(() => <col class="col-field" />)}
    <col>
  </colgroup>
  <thead>
    <tr>
      <th scope="col">{en ? "Leak" : "Leck"}</th>
      {fields.map((field) => (
        <th scope="col" class="leak-field">{field.label[language]}</th>
      ))}
      <th scope="col" class="then">{en ? "What happened" : "Was geschah"}</th>
    </tr>
  </thead>
  <tbody>
    {items.map((leak) => (
      <tr>
        <th scope="row">
          <strong>{leak.name[language]}</strong>
          <span>
            {[leak.kind[language], leak.year].filter(Boolean).join(", ")}
          </span>
        </th>
        {fields.map((field) => {
          const lost = leak.lost.includes(field.id)
          return (
            <td class:list={["leak-field", { lost }]} data-label={field.label[language]}>
              <span aria-hidden="true" class="mark"></span>
              <span class="visually-hidden">
                {lost ? (en ? "leaked" : "verloren") : en ? "not affected" : "nicht betroffen"}
              </span>
            </td>
          )
        })}
        <td class="then">{leak.then?.[language]}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  /* Eine ruhige Tabelle: Zeilen mit feiner Linie, die Spalten der Daten als
     Punkte. Ein voller roter Punkt heißt verloren, ein Strich nicht
     betroffen. So liest man quer, dass jedes Stück schon einmal verloren
     ging. */
  .leak-matrix {
    table-layout: fixed;
    inline-size: 100%;
    margin-block-start: var(--space-l);
    border-collapse: collapse;
    font-size: var(--step--1);
    line-height: 1.4;
  }

  thead th {
    padding: 0 var(--space-s) var(--space-s) 0;
    color: var(--ink-3);
    font-weight: 500;
    text-align: start;
    vertical-align: bottom;
  }

  .col-leak {
    inline-size: 15rem;
  }

  .col-field {
    inline-size: 8.5rem;
  }

  .leak-matrix :is(th, td).leak-field {
    padding-inline: var(--space-2xs);
    text-align: center;
  }

  tbody tr {
    border-block-start: 1px solid var(--line);
  }

  tbody tr:last-child {
    border-block-end: 1px solid var(--line);
  }

  tbody th,
  tbody td {
    padding-block: var(--space-s);
    vertical-align: middle;
  }

  tbody th {
    padding-inline-end: var(--space-m);
    font-weight: 400;
    text-align: start;
  }

  tbody th strong {
    display: block;
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: 560;
  }

  tbody th span {
    color: var(--ink-3);
  }

  .mark {
    display: inline-block;
    inline-size: 0.75rem;
    block-size: 2px;
    border-radius: 1px;
    vertical-align: middle;
    background: var(--line);
  }

  .lost .mark {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: var(--radius-full);
    background: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 22%, transparent);
  }

  .leak-matrix .then {
    padding-inline-start: var(--space-l);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Schmal: jede Zeile wird ein Block. Statt der Punktspalten stehen nur
     die verlorenen Daten als kleine Marken unter dem Namen. */
  @container campaign (width < 46rem) {
    .leak-matrix,
    .leak-matrix :is(tbody, tr, th, td) {
      display: block;
    }

    .leak-matrix thead,
    .leak-matrix colgroup {
      display: none;
    }

    .leak-matrix tbody tr {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs);
      padding-block: var(--space-s);
    }

    .leak-matrix tbody th,
    .leak-matrix .then {
      flex-basis: 100%;
      padding: 0;
    }

    .leak-matrix td.leak-field {
      display: none;
      padding: 0;
    }

    .leak-matrix td.leak-field.lost {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      padding: 0.15em 0.6em;
      border-radius: var(--radius-full);
      color: var(--ink);
      background: color-mix(in oklab, var(--primary) 14%, transparent);
    }

    .leak-matrix td.leak-field.lost::after {
      content: attr(data-label);
    }

    .leak-matrix .lost .mark {
      inline-size: 0.5rem;
      block-size: 0.5rem;
      box-shadow: none;
    }

    .leak-matrix .lost .visually-hidden {
      display: none;
    }
  }
</style>
