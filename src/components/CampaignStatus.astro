---
import { campaignStatus } from "@/data/campaign"
import { type Language, pathFor } from "@/lib/i18n"

interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
---

<a class="status-line" href={pathFor("proceedings", language)}>
  {en ? "Austria" : "Österreich"}
  · <span>{campaignStatus[language].label}</span>
</a>
