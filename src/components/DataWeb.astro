---
import {
  edges,
  nodes,
  type Place,
  profile,
  scenes,
  search,
} from "@/data/data-web"
import { leaks } from "@/data/leaks"
import type { Language } from "@/lib/i18n"

// "Where your data goes", as a full-screen scroll film: a network that
// grows from Max to every place that keeps a copy of his data, lights up
// each place with a real leak at a place of its kind, sends the copies to
// fraudsters and extortionists, joins them into a file and ends at his
// front door. The scene texts are the readable version; the network, the
// file and the map stay hidden from screen readers. The script sets the
// node positions for wide and tall screens and plays everything along
// with the scroll.
interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"

const leakFor = (id: string) => {
  const leak = leaks.find((candidate) => candidate.id === id)
  if (!leak) throw new Error(`Unknown leak: ${id}`)
  return leak
}
const caseName = (id: string) => {
  const leak = leakFor(id)
  return [leak.name[language], leak.year].filter(Boolean).join(" ")
}
// Plain text with one **key phrase**: odd parts are set in bold.
const rich = (text: string) => text.split(/\*\*(.+?)\*\*/)

// Where each place stands, on wide screens (1200 × 600), on squarer ones
// (900 × 700) and on tall ones (400 × 840). The script switches between
// them.
const layout: Record<
  "wide" | "mid" | "tall",
  Record<Place, [number, number]>
> = {
  wide: {
    you: [110, 300],
    taxApp: [260, 90],
    shop: [260, 510],
    provider: [440, 300],
    vendor: [470, 90],
    residents: [600, 510],
    accounts: [790, 90],
    taxOffice: [790, 300],
    foreign: [810, 510],
    crooks: [1090, 300],
  },
  mid: {
    you: [90, 350],
    taxApp: [240, 120],
    shop: [240, 580],
    provider: [380, 350],
    vendor: [440, 120],
    residents: [500, 580],
    accounts: [640, 120],
    taxOffice: [620, 350],
    foreign: [710, 580],
    crooks: [830, 350],
  },
  tall: {
    you: [200, 60],
    taxApp: [70, 235],
    provider: [200, 235],
    shop: [330, 235],
    vendor: [110, 420],
    residents: [290, 420],
    accounts: [70, 605],
    taxOffice: [200, 605],
    foreign: [330, 605],
    crooks: [200, 780],
  },
}
// Where the camera looks in each scene: centre and width.
const cameras = {
  wide: [
    [150, 300, 760],
    [280, 300, 820],
    [300, 300, 860],
    [440, 300, 1000],
    [460, 300, 1080],
    [600, 300, 1260],
    [880, 300, 1000],
    [880, 300, 1000],
    [600, 300, 1260],
  ],
  mid: [
    [140, 350, 620],
    [240, 350, 680],
    [300, 350, 780],
    [400, 350, 880],
    [420, 350, 920],
    [460, 350, 1000],
    [640, 350, 820],
    [640, 350, 820],
    [460, 350, 1000],
  ],
  tall: [
    [200, 130, 330],
    [200, 170, 380],
    [200, 240, 400],
    [200, 330, 400],
    [200, 410, 400],
    [200, 430, 400],
    [200, 560, 400],
    [200, 560, 400],
    [200, 430, 400],
  ],
}
const at = (id: Place) => layout.wide[id]
// A gentle curve from one place to another.
const curve = (from: Place, to: Place, bend = 0.12) => {
  const [x1, y1] = at(from)
  const [x2, y2] = at(to)
  const mx = (x1 + x2) / 2 - (y2 - y1) * bend
  const my = (y1 + y2) / 2 + (x2 - x1) * bend
  return `M${x1} ${y1} Q${mx} ${my} ${x2} ${y2}`
}

const leaked = nodes.filter((node) => node.leak)
const peopleIn = leaked.reduce(
  (sum, node) => sum + (leakFor(node.leak ?? "").people ?? 0),
  0,
)

// A city block for the last scene: a slightly turned grid of streets with
// a few through roads, the same on every visit.
const noise = (seed: number) => {
  const value = Math.sin(seed * 127.1 + 311.7) * 43758.5453
  return value - Math.floor(value)
}
const streets = [
  ...Array.from({ length: 9 }, (_, index) => {
    const x = 20 + index * 46 + (noise(index) - 0.5) * 14
    return `M${x} -10 L${x + 30} 330`
  }),
  ...Array.from({ length: 7 }, (_, index) => {
    const y = 18 + index * 46 + (noise(index + 20) - 0.5) * 14
    return `M-10 ${y} L430 ${y - 24}`
  }),
]
const roads = [
  "M-10 250 C 120 200, 260 180, 430 60",
  "M60 -10 C 120 120, 200 220, 260 330",
]
---

<section
  id="zeitreise"
  class="web"
  aria-labelledby="web-heading"
  data-web
  data-locale={en ? "en" : "de-DE"}
  data-layout={JSON.stringify(layout)}
  data-cameras={JSON.stringify(cameras)}
>
  <div class="track" aria-hidden="true">
    {scenes.map((scene, index) => (
        <div
          class="spacer"
          id={`netz-${scene.id}`}
          style={`--len: ${[110, 150, 150, 200, 160, 230, 210, 180, 150][index] ?? 150}`}
        >
        </div>
      ))}
  </div>

  <div class="stage">
    <nav class="rail" aria-label={en ? "Scenes" : "Szenen"}>
      <ol>
        {scenes.slice(1).map((scene) => (
            <li>
              <a href={`#netz-${scene.id}`} data-goto>{scene.short[language]}</a>
            </li>
          ))}
      </ol>
    </nav>

    <div class="says">
      {scenes.map((scene, index) => (
          <div class="say" data-say>
            <p class="eyebrow">{scene.eyebrow[language]}</p>
            {index === 0 ? (
              <h2 id="web-heading">{scene.heading[language]}</h2>
            ) : (
              <h3>{scene.heading[language]}</h3>
            )}
            <p class="text">
              {rich(scene.text[language]).map((part, partIndex) =>
                partIndex % 2 ? <strong>{part}</strong> : part,
              )}
            </p>
            {index === scenes.length - 1 && (
              <a class="next button primary" href="#weiter">
                {en ? "What you can do" : "Was du tun kannst"}
              </a>
            )}
          </div>
        ))}
    </div>

    <div class="view" aria-hidden="true">
      <svg
        class="net"
        viewBox="0 0 1200 600"
        preserveAspectRatio="xMidYMid meet"
        data-net
      >
        <defs>
          <linearGradient id="web-graphite" x1="0.2" y1="0" x2="0.8" y2="1">
            <stop offset="0" stop-color="#4b5056" />
            <stop offset="1" stop-color="#25282d" />
          </linearGradient>
          <linearGradient id="web-signal" x1="0.2" y1="0" x2="0.8" y2="1">
            <stop offset="0" stop-color="#e3000f" />
            <stop offset="1" stop-color="#be000c" />
          </linearGradient>
        </defs>

        <g class="edges">
          {edges.map((edge) => (
              <path
                id={`edge-${edge.from}-${edge.to}`}
                class="edge"
                d={curve(edge.from, edge.to)}
                pathLength="1"
                data-edge
                data-from={edge.from}
                data-to={edge.to}
                data-scene={edge.scene}
                data-maybe={nodes.find((node) => node.id === edge.to)?.maybe
                  ? ""
                  : undefined}
              />
            ))}
          {leaked.map((node) => (
              <path
                id={`edge-${node.id}-crooks`}
                class="edge leak"
                d={curve(node.id, "crooks", 0.18)}
                pathLength="1"
                data-edge
                data-from={node.id}
                data-to="crooks"
              />
            ))}
        </g>

        <g class="packets">
          {edges.map((edge) =>
              [0, 1].map((packet) => (
                <circle
                  class="packet"
                  r="3.2"
                  data-packet={`${edge.from}-${edge.to}`}
                >
                  <animateMotion
                    dur={edge.to === "taxOffice" ? "1.6s" : "2.8s"}
                    begin={`${-packet * 1.4}s`}
                    repeatCount="indefinite"
                  >
                    <mpath href={`#edge-${edge.from}-${edge.to}`} />
                  </animateMotion>
                </circle>
              )),
            )}
          {leaked.map((node, index) => (
              <circle
                class="packet red"
                r="3.6"
                data-packet={`${node.id}-crooks`}
              >
                <animateMotion
                  dur="2.2s"
                  begin={`${-(index % 3) * 0.7}s`}
                  repeatCount="indefinite"
                >
                  <mpath href={`#edge-${node.id}-crooks`} />
                </animateMotion>
              </circle>
            ))}
        </g>

        <g class="nodes">
          {nodes.map((node) => (
              <g
                class="node"
                data-node={node.id}
                data-scene={node.scene}
                data-people={node.leak ? (leakFor(node.leak).people ?? 0) : 0}
                data-maybe={node.maybe ? "" : undefined}
                transform={`translate(${at(node.id)[0]} ${at(node.id)[1]})`}
              >
                <g class="body">
                  <circle class="breach" r="38" />
                  <circle class="disc" r="31" />
                  <g class="icon" transform="scale(1.15)">
                    {node.id === "you" && (
                      <path d="M0-11a5 5 0 1 1 0 10a5 5 0 1 1 0-10M-10 12c0-7 4.5-10 10-10s10 3 10 10" />
                    )}
                    {node.id === "provider" && (
                      <>
                        <circle r="10.5" />
                        <path d="M-3-6v12M1-8v2M1 6v2M-5-5h6.5a2.6 2.6 0 0 1 0 5.2H-5M-5 0.2h7.2a2.9 2.9 0 0 1 0 5.8H-5" />
                      </>
                    )}
                    {node.id === "vendor" && (
                      <>
                        <circle r="4" />
                        <path d="M0-11v4M0 7v4M-11 0h4M7 0h4M-7.8-7.8l2.8 2.8M5 5l2.8 2.8M7.8-7.8L5-5M-5 5l-2.8 2.8" />
                      </>
                    )}
                    {node.id === "shop" && (
                      <path d="M-10-5L0-10l10 5v11L0 11l-10-5zM-10-5L0 0l10-5M0 0v11" />
                    )}
                    {node.id === "taxApp" && (
                      <>
                        <rect x="-7" y="-11" width="14" height="22" rx="2.5" />
                        <path d="M-3.5 5l2.5-4 2.5 2 2.5-5" />
                      </>
                    )}
                    {(node.id === "taxOffice" || node.id === "foreign") && (
                      <path d="M-11-3L0-10l11 7zM-8-1v9M-3-1v9M3-1v9M8-1v9M-11 10h22" />
                    )}
                    {node.id === "accounts" && (
                      <path d="M-9-7a9 3.2 0 1 0 18 0a9 3.2 0 1 0-18 0M-9-7v14a9 3.2 0 0 0 18 0v-14M-9 0a9 3.2 0 0 0 18 0" />
                    )}
                    {node.id === "residents" && (
                      <path d="M-11 0L0-9l11 9M-7.5-3v13h15v-13M-2 10v-6h4v6" />
                    )}
                    {node.id === "crooks" && (
                      <>
                        <circle r="9" />
                        <circle r="3" />
                        <path d="M0-14v6M0 8v6M-14 0h6M8 0h6" />
                      </>
                    )}
                  </g>
                  <text class="name" y="56">{node.name[language]}</text>
                  <text class="name brief" y="56">
                    {(node.brief ?? node.name)[language]}
                  </text>
                  <text class="holds" y="74">
                    {node.holds[language].map((line, index) => (
                      <tspan x="0" dy={index === 0 ? 0 : 15}>{line}</tspan>
                    ))}
                  </text>
                </g>
                {node.leak && (
                  <g class="tag">
                    <text class="tag-case" y="-60">{caseName(node.leak)}</text>
                    <text class="tag-what" y="-44">{node.tag?.[language]}</text>
                  </g>
                )}
              </g>
            ))}
        </g>
      </svg>

      <article class="file">
        <header>
          <b>{en ? "File" : "Akte"}</b>
          <span>{en ? "joined from leaks" : "aus Lecks zusammengeführt"}</span>
        </header>
        <dl>
          {profile.map((row, index) => (
              <div class="row" style={`--r: ${index}`}>
                <dt>{row.label[language]}</dt>
                <dd>{row.value[language]}</dd>
                <span class="from">{caseName(row.from)}</span>
              </div>
            ))}
        </dl>
      </article>

      <div class="prompt">
        <p class="prompt-head"><span>✦</span> {search.label[language]}</p>
        <p class="prompt-text">
          <span data-typed data-text={search.query[language]}
            >{search.query[language]}</span
          ><i class="caret"></i>
        </p>
        <p class="prompt-result">{search.result[language]}</p>
      </div>

      <div class="map">
        <svg viewBox="0 0 420 320" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="web-pin" x1="0.2" y1="0" x2="0.8" y2="1">
              <stop offset="0" stop-color="#e3000f" />
              <stop offset="1" stop-color="#be000c" />
            </linearGradient>
          </defs>
          <g class="streets">
            {streets.map((d) => <path d={d} pathLength="1" />)}
          </g>
          <g class="roads">
            {roads.map((d) => <path d={d} pathLength="1" />)}
          </g>
          <g class="pin" transform="translate(210 160)">
            <circle class="pulse" r="10" />
            <circle class="pulse late" r="10" />
            <path d="M0 0c-9-11-14-17-14-24a14 14 0 1 1 28 0c0 7-5 13-14 24z" />
            <circle cy="-24" r="5" />
          </g>
        </svg>
        <div class="address">
          <b>Musterstraße 7</b>
          <span>{en ? "1010 Vienna" : "1010 Wien"}</span>
          <span class="chips">
            <i>{en ? "Hardware wallet" : "Hardware-Wallet"}</i>
            <i>{en ? "Holdings" : "Bestände"}</i>
            <i>{en ? "ID" : "Ausweis"}</i>
          </span>
        </div>
      </div>
    </div>

    <dl class="counters" aria-hidden="true">
      <div data-counter="places">
        <dt>{en ? "places with his data" : "Stellen mit seinen Daten"}</dt>
        <dd data-value>{leaked.length}</dd>
      </div>
      <div data-counter="reports">
        <dt>
          {en ? "DAC8 reports by" : "DAC8-Meldungen bis"}
          <span data-year>2036</span>
        </dt>
        <dd data-value>10</dd>
      </div>
      <div data-counter="people" data-total={peopleIn}>
        <dt>{en ? "people in these cases" : "Menschen in diesen Fällen"}</dt>
        <dd data-value>
          {new Intl.NumberFormat(en ? "en" : "de-DE").format(peopleIn)}
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  /* Das Datennetz als Scroll-Geschichte in der Formensprache der Seite:
     helle Fläche, Stationen als Graphit-Token mit Titankante wie im
     Datenweg des Dossiers, Linien als schmale Nut. Rot heißt wie überall
     „hier stehst du“ (Max) oder markiert ein Leck. Die Kopfleiste bleibt
     stehen; oben links der Satz der Szene, rechts das Netz, unten drei
     Zahlen. Das Skript setzt die Variablen; ohne Skript stehen die Texte
     untereinander und das Netz im Endstand. */
  .web {
    --groove: light-dark(#c6cbcf, #454b51);
    --groove-light: light-dark(#ffffff, #ffffff08);
    --signal: var(--accent);
    --mono:
      ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .track,
  .stage {
    grid-area: 1 / 1;
  }

  .spacer {
    block-size: calc(var(--len) * 1svh);
  }

  /* ---------- Bühne ----------------------------------------------------- */

  .stage {
    position: sticky;
    inset-block-start: var(--header-height);
    align-self: start;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    gap: var(--space-xs);
    block-size: calc(100svh - var(--header-height));
    padding-block: var(--space-xs) var(--space-s);
  }

  /* Ohne Skript stehen die Szenen als Text untereinander. */
  .web:not([data-ready]) .track {
    display: none;
  }

  .web:not([data-ready]) .stage {
    position: static;
    block-size: auto;
  }

  .web:not([data-ready]) .says {
    display: grid;
    gap: var(--space-xl);
  }

  .web:not([data-ready]) .say {
    grid-area: auto;
  }

  .web:not([data-ready]) .view {
    min-block-size: 70svh;
  }

  /* ---------- Szenen-Leiste --------------------------------------------- */

  /* Wie die Unterleiste des Dossiers: Text, die aktuelle Szene mit roter
     Kante darunter. Jede ist ein Link, ziehen muss man nichts. */
  .rail {
    border-block-end: 1px solid var(--line);
    user-select: none;
    -webkit-user-select: none;
  }

  .rail ol {
    position: relative;
    display: flex;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .rail a {
    display: block;
    padding: 0.55rem 0.5rem 0.6rem;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    white-space: nowrap;
    text-decoration: none;
    box-shadow: inset 0 -2px transparent;
    transition:
      color 0.2s,
      box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .rail a:hover {
    color: var(--foreground);
  }

  .rail a[aria-current] {
    color: var(--foreground);
    box-shadow: inset 0 -2px var(--signal);
  }

  /* ---------- Sätze ----------------------------------------------------- */

  .says {
    display: grid;
  }

  .say {
    --o: 1;
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    opacity: var(--o);
    translate: 0 calc((1 - var(--o)) * 0.75rem);
  }

  .web[data-ready] .say:not([data-current]) {
    visibility: hidden;
  }

  .web[data-ready] .say[data-fading] {
    visibility: visible;
  }

  /* Die Marke wie im Kopf der Startseite: roter Punkt, Versalien. */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foreground);
    font-size: var(--step--1);
    font-weight: 560;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    content: "";
  }

  .say h2,
  .say h3 {
    max-inline-size: 20ch;
    color: var(--foreground);
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .say .text {
    max-inline-size: 46ch;
    color: var(--ink-2);
    font-size: var(--step-0);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .say strong {
    color: var(--foreground);
    font-weight: 560;
  }

  .next {
    justify-self: start;
    margin-block-start: var(--space-2xs);
  }

  /* ---------- Netz ------------------------------------------------------ */

  /* Das Netz liegt auf einer hellen Fläche wie die anderen Bänder. */
  .view {
    position: relative;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    min-block-size: 0;
    border-radius: var(--radius-xl);
    background: var(--panel);
    overflow: hidden;
  }

  .view > * {
    grid-area: 1 / 1;
    min-block-size: 0;
  }

  .net {
    --net: 1;
    inline-size: 100%;
    block-size: 100%;
    opacity: var(--net);
  }

  /* Linien als schmale Nut, die sich beim Auftauchen zeichnet. */
  .edge {
    --draw: 1;
    fill: none;
    stroke: var(--groove);
    stroke-width: calc(var(--unit, 1) * 2);
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--draw));
    opacity: var(--fade, 1);
  }

  .edge[data-maybe] {
    stroke-dasharray: 0.018 0.016;
    stroke-dashoffset: 0;
    opacity: calc(var(--draw) * var(--fade, 1));
  }

  .edge.leak {
    stroke: var(--signal);
    stroke-width: calc(var(--unit, 1) * 1.5);
  }

  /* Was über die Linien wandert: kleine Graphitpunkte, rote auf dem Weg
     zu den Tätern. */
  .packet {
    fill: var(--foreground);
    opacity: 0;
  }

  .packet.red {
    fill: var(--signal);
  }

  .node {
    --show: 1;
    --leak: 0;
    --fade: 1;
  }

  .node .body,
  .node .tag {
    transform-box: fill-box;
    transform-origin: center;
  }

  .node .body {
    opacity: calc(var(--show) * var(--fade));
    scale: calc(0.7 + var(--show) * 0.3);
  }

  /* Stationen als Token: Graphitkern, schmale Titankante. */
  .disc {
    fill: url(#web-graphite);
    stroke: light-dark(#a4abb1, #596168);
    stroke-width: 1.5;
  }

  .icon {
    fill: none;
    stroke: #f7f8f9;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Max ist der rote Punkt: hier stehst du. */
  .node[data-node="you"] .disc {
    fill: url(#web-signal);
    stroke: light-dark(#b6000c, #fa5963);
  }

  .node[data-node="crooks"] .disc {
    fill: #1a1c1f;
    stroke: var(--signal);
    stroke-width: 2;
  }

  .node[data-node="crooks"] .icon {
    stroke: var(--signal);
  }

  .node[data-maybe] .disc {
    stroke-dasharray: 4 3;
  }

  /* Ein Leck: ein roter Ring um das Token und das Etikett darüber. */
  .breach {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.5;
    opacity: var(--leak);
    scale: calc(0.8 + var(--leak) * 0.2);
    transform-box: fill-box;
    transform-origin: center;
  }

  .name,
  .holds,
  .tag text {
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--panel);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .name {
    fill: var(--foreground);
    font-size: 16px;
    font-weight: 600;
  }

  .holds {
    fill: var(--muted-foreground);
    font-size: 12.5px;
  }

  .brief,
  .net[data-shape="tall"] .name:not(.brief),
  .net[data-shape="tall"] .holds {
    display: none;
  }

  .net[data-shape="tall"] .brief {
    display: inline;
    font-size: 14px;
  }

  .tag {
    opacity: calc(var(--leak) * var(--fade));
    translate: 0 calc((1 - var(--leak)) * 6px);
  }

  .tag-case {
    fill: var(--signal);
    font-size: 14px;
    font-weight: 650;
  }

  .tag-what {
    fill: var(--foreground);
    font-size: 12.5px;
  }

  .net[data-shape="tall"] .tag-case {
    font-size: 13px;
  }

  .net[data-shape="tall"] .tag-what {
    font-size: 11px;
  }

  /* ---------- Akte, Suche, Karte ---------------------------------------- */

  /* Die Akte als weiße Karte wie die Karten der Startseite. */
  .file {
    --file: 1;
    align-self: center;
    justify-self: center;
    display: grid;
    gap: 0.5rem;
    inline-size: min(calc(100% - 2rem), 30rem);
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px -18px var(--material-shade);
    opacity: var(--file);
    translate: 0 calc((1 - var(--file)) * 1rem + var(--q-up, 0) * -3.5rem);
  }

  .file header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block-end: 0.4rem;
    border-block-end: 2px solid var(--foreground);
    font-size: var(--step--1);
  }

  .file header b {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .file header span {
    color: var(--muted-foreground);
  }

  .file dl {
    display: grid;
    margin: 0;
  }

  .row {
    --in: 1;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.3rem;
    border-block-end: 1px solid var(--line);
    font-size: 0.875rem;
    opacity: var(--in);
    translate: calc((1 - var(--in)) * 1rem) 0;
  }

  .row dt {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .row dd {
    overflow: hidden;
    margin: 0;
    font-weight: 560;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .from {
    color: var(--signal);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .prompt {
    --q: 1;
    --res: 1;
    align-self: end;
    justify-self: center;
    display: grid;
    gap: 0.4rem;
    inline-size: min(calc(100% - 2rem), 30rem);
    margin-block-end: var(--space-s);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px -18px var(--material-shade);
    opacity: var(--q);
    translate: 0 calc((1 - var(--q)) * 0.75rem);
  }

  .prompt-head {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .prompt-head span {
    color: var(--signal);
  }

  .prompt-text {
    min-block-size: 2.7em;
    color: var(--foreground);
    font-size: var(--step-0);
    line-height: 1.35;
  }

  .caret {
    display: inline-block;
    inline-size: 2px;
    block-size: 1.05em;
    margin-inline-start: 2px;
    background: var(--signal);
    vertical-align: -0.15em;
    animation: blink 1.1s steps(1) infinite;
  }

  .prompt[data-typing] .caret {
    animation: none;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .prompt-result {
    padding-block-start: 0.4rem;
    border-block-start: 1px solid var(--line);
    color: var(--signal);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    opacity: var(--res);
  }

  /* Die Karte: Straßen als Nut, die sich zeichnen, dann fällt der rote
     Punkt auf die Wohnadresse. */
  .map {
    --map: 1;
    --draw: 1;
    --pin: 1;
    position: relative;
    display: grid;
    opacity: var(--map);
  }

  .map svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .streets path,
  .roads path {
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--draw));
  }

  .streets path {
    stroke: var(--groove);
    stroke-width: 1.5;
  }

  .roads path {
    stroke: var(--groove);
    stroke-width: 5;
  }

  .pin {
    opacity: min(1, calc(var(--pin) * 3));
  }

  .pin > path,
  .pin > circle:not(.pulse) {
    translate: 0 calc((1 - var(--pin)) * -30px);
  }

  .pin > path {
    fill: url(#web-pin);
    stroke: light-dark(#b6000c, #fa5963);
    stroke-width: 1;
  }

  .pin > circle:not(.pulse) {
    fill: #fff;
  }

  .pulse {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: ripple 2.4s ease-out infinite;
  }

  .pulse.late {
    animation-delay: -1.2s;
  }

  @keyframes ripple {
    from {
      opacity: 0.8;
      scale: 0.6;
    }

    to {
      opacity: 0;
      scale: 3;
    }
  }

  .address {
    position: absolute;
    inset-block-start: 57%;
    inset-inline-start: 50%;
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px -18px var(--material-shade);
    translate: -50% 0;
    opacity: var(--pin);
    text-align: center;
  }

  .address b {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .address span {
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .address .chips {
    display: flex;
    gap: 0.3rem;
    margin-block-start: 0.35rem;
  }

  .chips i {
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--signal);
    color: var(--signal);
    font-size: 0.6875rem;
    font-style: normal;
    font-weight: 600;
  }

  /* ---------- Zahlen ---------------------------------------------------- */

  .counters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xs);
    margin: 0;
  }

  .counters > div {
    --on: 1;
    display: grid;
    gap: 0.1rem;
    opacity: calc(0.35 + var(--on) * 0.65);
  }

  .counters dt {
    order: 2;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.25;
  }

  .counters dd {
    margin: 0;
    color: var(--foreground);
    font-size: clamp(1.35rem, 1rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  [data-counter="people"] dd {
    color: var(--signal);
  }

  /* Solange die Geschichte den Bildschirm füllt, weicht die mobile Leiste
     mit Spenden und Teilen. */
  :global(html[data-immersive] [data-action-bar]) {
    translate: 0 110%;
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse,
    .caret {
      animation: none;
    }

    .packet {
      display: none;
    }
  }

  /* ---------- Breitere Bildschirme ------------------------------------- */

  /* Der Satz links, das Netz rechts über die ganze Höhe. */
  @container campaign (width >= 56rem) {
    .stage {
      grid-template-columns: minmax(18rem, 0.7fr) minmax(0, 1.3fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: var(--space-s) var(--space-l);
      padding-block: var(--space-s) var(--space-m);
    }

    .rail,
    .counters {
      grid-column: 1 / -1;
    }

    .says {
      align-self: center;
      padding-block-end: 6svh;
    }

    .say h2,
    .say h3 {
      font-size: clamp(1.75rem, 0.9rem + 1.9vw, 2.75rem);
    }

    .say .text {
      font-size: var(--step-1);
    }

    .counters dt {
      font-size: 0.875rem;
    }

    .row {
      grid-template-columns: 8rem minmax(0, 1fr) auto;
      font-size: 0.9375rem;
    }
  }
</style>

<script>
  // Plays the network along with the scroll. One progress value p counts
  // the scenes passed, with the fraction of the current one; every frame
  // derives the whole stage from p, so scrolling back rewinds it. With
  // reduced motion, nothing travels or zooms and every change snaps.
  type Shape = "wide" | "mid" | "tall"
  type Layout = Record<string, [number, number]>
  // The size of each layout's drawing, as in the markup.
  const sizes: Record<Shape, [number, number]> = {
    wide: [1200, 600],
    mid: [900, 700],
    tall: [400, 840],
  }

  const root = document.querySelector<HTMLElement>("[data-web]")
  if (root) start(root)

  function start(root: HTMLElement) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)")
    const all = (selector: string) => [
      ...root.querySelectorAll<HTMLElement>(selector),
    ]
    const one = (selector: string) => root.querySelector<HTMLElement>(selector)
    const spacers = all(".spacer")
    const says = all("[data-say]")
    const nodeEls = all("[data-node]")
    const edgeEls = [...root.querySelectorAll<SVGPathElement>("[data-edge]")]
    const packets = all("[data-packet]")
    const rows = all(".row")
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-goto]")]
    const net = root.querySelector<SVGSVGElement>("[data-net]")
    const view = one(".view")
    const file = one(".file")
    const prompt = one(".prompt")
    const typed = one("[data-typed]")
    const map = one(".map")
    const railList = one(".rail ol")
    const places = one('[data-counter="places"]')
    const reports = one('[data-counter="reports"]')
    const people = one('[data-counter="people"]')
    const year = one("[data-year]")
    if (
      !net ||
      !view ||
      !file ||
      !prompt ||
      !typed ||
      !map ||
      !railList ||
      !places ||
      !reports ||
      !people ||
      !year
    )
      return

    const value = (counter: HTMLElement) =>
      counter.querySelector<HTMLElement>("[data-value]")
    const format = new Intl.NumberFormat(root.dataset.locale, {
      notation: "compact",
      maximumFractionDigits: 1,
    })
    const text = typed.dataset.text ?? ""
    const total = Number(people.dataset.total)
    const layouts = JSON.parse(root.dataset.layout ?? "{}") as Record<
      Shape,
      Layout
    >
    const cameras = JSON.parse(root.dataset.cameras ?? "{}") as Record<
      Shape,
      [number, number, number][]
    >
    const leakScene = 5
    const matchScene = 6
    const riskScene = 7
    const endScene = 8
    // The places with a case, in the order they light up.
    const leaking = nodeEls.filter((node) => node.querySelector(".tag"))

    const clamp = (value: number) => Math.min(1, Math.max(0, value))
    const ramp = (value: number, from: number, to: number) =>
      clamp((value - from) / (to - from))
    const ease = (value: number) =>
      value < 0.5 ? 4 * value ** 3 : 1 - (-2 * value + 2) ** 3 / 2
    const out = (value: number) => 1 - (1 - value) ** 3
    const snap = (value: number) =>
      motion.matches ? (value >= 0.5 ? 1 : 0) : value
    const set = (element: Element, name: string, value: number) =>
      (element as HTMLElement).style.setProperty(name, String(value))
    const write = (element: HTMLElement | null, value: string) => {
      if (element && element.textContent !== value) element.textContent = value
    }

    let shape: Shape = "wide"
    let arranged = false
    let queued = false
    let visible = false
    let current = -2

    // Places the nodes and draws the lines for the screen's shape.
    const arrange = () => {
      const box = view.getBoundingClientRect()
      const ratio = box.width / Math.max(1, box.height)
      const next = ratio >= 1.6 ? "wide" : ratio >= 0.95 ? "mid" : "tall"
      if (arranged && next === shape) return
      arranged = true
      shape = next
      net.dataset.shape = shape
      const at = layouts[shape]
      for (const node of nodeEls) {
        const [x, y] = at[node.dataset.node ?? ""] ?? [0, 0]
        node.setAttribute("transform", `translate(${x} ${y})`)
      }
      const bend = (from: string, to: string, amount: number) => {
        const [x1, y1] = at[from]
        const [x2, y2] = at[to]
        const mx = (x1 + x2) / 2 - (y2 - y1) * amount
        const my = (y1 + y2) / 2 + (x2 - x1) * amount
        return `M${x1} ${y1} Q${mx} ${my} ${x2} ${y2}`
      }
      for (const edge of edgeEls) {
        const from = edge.dataset.from ?? ""
        const to = edge.dataset.to ?? ""
        edge.setAttribute(
          "d",
          bend(
            from,
            to,
            to === "crooks" ? (shape === "tall" ? 0.3 : 0.18) : 0.12,
          ),
        )
      }
    }

    const progress = () => {
      const line = window.innerHeight * 0.5
      let p = 0
      spacers.forEach((spacer, index) => {
        const box = spacer.getBoundingClientRect()
        if (box.top <= line) p = index + clamp((line - box.top) / box.height)
      })
      return p
    }

    const render = () => {
      queued = false
      arrange()
      const p = progress()
      const scene = Math.min(Math.floor(p), says.length - 1)
      const local = p - scene

      // The scene texts cross-fade: in as their scene starts, out as it
      // ends. The first stands from the start, the last stays.
      says.forEach((say, index) => {
        const into = index === 0 ? 1 : ramp(p, index - 0.12, index + 0.04)
        const leave =
          index === says.length - 1 ? 0 : ramp(p, index + 0.86, index + 0.98)
        const shown = snap(into * (1 - leave))
        set(say, "--o", shown)
        say.toggleAttribute("data-current", shown > 0.5)
        say.toggleAttribute("data-fading", shown > 0 && shown <= 0.5)
      })

      // The camera moves to the scene's view in the first part of it.
      const keys = cameras[shape]
      const [width, height] = sizes[shape]
      const from = keys[Math.max(0, scene - 1)]
      const to = keys[scene]
      const move =
        motion.matches || scene === 0 ? 1 : ease(ramp(local, 0, 0.45))
      const cx = from[0] + (to[0] - from[0]) * move
      const cy = from[1] + (to[1] - from[1]) * move
      const w = from[2] + (to[2] - from[2]) * move
      const h = (w * height) / width
      net.setAttribute("viewBox", `${cx - w / 2} ${cy - h / 2} ${w} ${h}`)
      // Drawing units per screen pixel, so lines keep their width.
      const drawn = net.getBoundingClientRect()
      set(net, "--unit", Math.max(w / drawn.width, h / drawn.height) || 1)

      // Places appear in their scene; each with a case lights up red in
      // turn once the leaks begin. In the matching and the risk, all but
      // the offenders step back.
      const away =
        snap(ramp(p, matchScene - 0.08, matchScene + 0.15)) *
        (1 - snap(ramp(p, endScene - 0.1, endScene + 0.1)))
      let count = 0
      let lost = 0
      for (const node of nodeEls) {
        const id = node.dataset.node
        const shown =
          id === "you"
            ? 1
            : snap(
                ramp(
                  p,
                  Number(node.dataset.scene) - 0.05,
                  Number(node.dataset.scene) + 0.3,
                ),
              )
        const order = leaking.indexOf(node)
        const leak =
          order < 0
            ? 0
            : snap(
                ramp(
                  p,
                  leakScene + 0.1 + order * 0.07,
                  leakScene + 0.17 + order * 0.07,
                ),
              )
        set(node, "--show", shown)
        set(node, "--leak", leak)
        set(node, "--fade", id === "crooks" ? 1 : 1 - away * 0.9)
        if (shown >= 0.5 && id !== "you" && id !== "crooks") count += 1
        if (leak >= 0.5) lost += Number(node.dataset.people) || 0
      }

      for (const edge of edgeEls) {
        const toCrooks = edge.dataset.to === "crooks"
        const node = nodeEls.find(
          (candidate) => candidate.dataset.node === edge.dataset.from,
        )
        const draw = toCrooks
          ? Number.parseFloat(node?.style.getPropertyValue("--leak") ?? "0")
          : snap(
              ramp(
                p,
                Number(edge.dataset.scene) + 0.05,
                Number(edge.dataset.scene) + 0.4,
              ),
            )
        set(edge, "--draw", draw)
        set(edge, "--fade", toCrooks ? 1 : 1 - away * 0.85)
      }
      for (const packet of packets) {
        const edge = root.querySelector<SVGPathElement>(
          `#edge-${packet.dataset.packet}`,
        )
        const draw = edge
          ? Number.parseFloat(edge.style.getPropertyValue("--draw"))
          : 0
        const fade = edge
          ? Number.parseFloat(edge.style.getPropertyValue("--fade"))
          : 1
        packet.style.opacity = String(draw >= 1 ? fade : 0)
      }

      // The matching: the file assembles from the leaks, then the search
      // types itself and finds Max.
      set(
        net,
        "--net",
        1 -
          snap(ramp(p, riskScene - 0.08, riskScene + 0.05)) *
            (1 - snap(ramp(p, endScene - 0.1, endScene + 0.1))),
      )
      const filed =
        snap(ramp(p, matchScene + 0.06, matchScene + 0.2)) *
        (1 - snap(ramp(p, riskScene - 0.1, riskScene + 0.02)))
      set(file, "--file", filed)
      rows.forEach((row, index) =>
        set(
          row,
          "--in",
          snap(
            ramp(
              p,
              matchScene + 0.12 + index * 0.04,
              matchScene + 0.18 + index * 0.04,
            ),
          ),
        ),
      )
      const asking = snap(ramp(p, matchScene + 0.4, matchScene + 0.46))
      set(
        prompt,
        "--q",
        asking * (1 - snap(ramp(p, riskScene - 0.1, riskScene + 0.02))),
      )
      set(file, "--q-up", asking)
      const typing = motion.matches
        ? 1
        : ramp(p, matchScene + 0.44, matchScene + 0.74)
      write(typed, text.slice(0, Math.round(text.length * typing)))
      prompt.toggleAttribute("data-typing", typing > 0 && typing < 1)
      set(prompt, "--res", snap(ramp(p, matchScene + 0.76, matchScene + 0.82)))

      // The risk: a city block, the streets drawing in, the pin dropping
      // onto the home address.
      set(
        map,
        "--map",
        snap(ramp(p, riskScene - 0.04, riskScene + 0.1)) *
          (1 - snap(ramp(p, endScene - 0.1, endScene + 0.05))),
      )
      set(
        map,
        "--draw",
        motion.matches ? 1 : out(ramp(p, riskScene, riskScene + 0.35)),
      )
      set(map, "--pin", snap(out(ramp(p, riskScene + 0.3, riskScene + 0.45))))

      // The counters: places with his data, the reports by year, and the
      // people in the cases lit so far.
      const filedReports = Math.round(ramp(p, 3.1, 3.85) * 10)
      write(value(places), String(count))
      write(value(reports), String(filedReports))
      write(year, String(2026 + Math.max(1, filedReports)))
      write(value(people), format.format(Math.min(total, lost)))
      set(places, "--on", snap(ramp(p, 0.9, 1.1)))
      set(reports, "--on", snap(ramp(p, 2.95, 3.1)))
      set(people, "--on", snap(ramp(p, leakScene + 0.05, leakScene + 0.15)))

      // The timeline marks the scene and keeps it in view in the pill.
      if (scene !== current) {
        current = scene
        links.forEach((link, index) => {
          if (index === scene - 1) link.setAttribute("aria-current", "step")
          else link.removeAttribute("aria-current")
        })
        const link = links[scene - 1]
        if (link)
          railList.scrollTo({
            left:
              link.offsetLeft - (railList.clientWidth - link.offsetWidth) / 2,
            behavior: motion.matches ? "auto" : "smooth",
          })
      }

      const box = root.getBoundingClientRect()
      document.documentElement.toggleAttribute(
        "data-immersive",
        box.top <= window.innerHeight * 0.2 && box.bottom >= window.innerHeight,
      )
    }

    const queue = () => {
      if (queued || !visible) return
      queued = true
      requestAnimationFrame(render)
    }

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      if (!visible) document.documentElement.removeAttribute("data-immersive")
      queue()
    }).observe(root)
    window.addEventListener("scroll", queue, { passive: true })
    window.addEventListener("resize", () => {
      arranged = false
      queue()
    })
    motion.addEventListener("change", render)

    root.toggleAttribute("data-ready", true)
    render()
  }
</script>
