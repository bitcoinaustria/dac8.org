---
import land from "@/data/world-land.json"
import {
  attacks,
  countIn,
  euCountries,
  formatDate,
  latestDate,
  latestYear,
  placeOf,
  project,
} from "@/lib/attacks"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"

// The map spans the inhabited latitudes; Antarctica is left out.
const [left] = project(-180, 0)
const [right] = project(180, 0)
const [, top] = project(0, 84)
const [, bottom] = project(0, -57)
const viewBox = [left, top, right - left, bottom - top]
  .map((value) => value.toFixed(1))
  .join(" ")

const round = (value: number) => Math.round(value * 10) / 10
const landPath = land
  .map(
    (ring) =>
      `M${ring
        .map(([lng, lat]) => project(lng, lat).map(round).join(","))
        .join("L")}Z`,
  )
  .join("")

// Recent cases on top, so the newest dots are never hidden by older ones.
const recentFrom = latestYear - 1
const dots = [...attacks]
  .sort((a, b) => a.year - b.year)
  .map((attack) => {
    const [x, y] = project(attack.lng, attack.lat)
    return {
      x: round(x),
      y: round(y),
      recent: attack.year >= recentFrom,
      label: `${placeOf(attack, language)}, ${attack.year}`,
    }
  })

const years = [latestYear - 2, latestYear - 1, latestYear]
const through = latestDate ? formatDate(latestDate, language) : ""
const throughShort = latestDate ? formatDate(latestDate, language, false) : ""
const credit = en
  ? `, as of ${through}. Map: Natural Earth.`
  : `, Stand ${through}. Karte: Natural Earth.`
const euNow = countIn(latestYear, euCountries)
const euBefore = countIn(latestYear - 1, euCountries)
const franceNow = countIn(latestYear, ["FR"])
// France's Interior Minister counted 77 cases in the first half of 2026.
const showFrance = latestYear === 2026 && franceNow < 77

const byYear = [...new Set(attacks.map((attack) => attack.year))]
  .sort((a, b) => b - a)
  .map((year) => ({
    year,
    entries: attacks
      .filter((attack) => attack.year === year)
      .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? "")),
  }))
---

<div class="attacks" id="angriffe">
  <h3>{en ? "Known attacks worldwide" : "Bekannte Angriffe weltweit"}</h3>
  <div class="columns">
    <p class="section-intro">
      {en
          ? `${attacks.length} physical attacks on holders of bitcoin and other crypto-assets are publicly known, and the number keeps rising. In the EU there have already been ${euNow} this year, after ${euBefore} in all of ${latestYear - 1}.`
          : `${attacks.length} körperliche Angriffe auf Besitzer von Bitcoin und anderen Kryptowerten sind öffentlich bekannt, und es werden laufend mehr. In der EU sind es ${latestYear} schon ${euNow}, nach ${euBefore} im ganzen Jahr ${latestYear - 1}.`}
    </p>
    <p class="prose">
      {en
          ? "The list is incomplete: most victims stay silent, and many cases never become public."
          : "Die Liste ist unvollständig: Die meisten Opfer schweigen, und viele Fälle werden nie öffentlich."}
      {showFrance &&
          (en
            ? ` France’s Interior Minister alone counted 77 abductions, sequestrations and extortions or attempts in the first half of ${latestYear}; the collection has ${franceNow} French cases for the whole year so far.`
            : ` Allein Frankreichs Innenminister zählte im ersten Halbjahr ${latestYear} 77 Entführungen, Freiheitsberaubungen und Erpressungen oder Versuche; die Sammlung kennt für Frankreich bisher ${franceNow} im ganzen Jahr.`)}
    </p>
  </div>
  <dl class="keyfigures">
    {years.map((year) => (
        <div>
          <dt>
            <strong>{year}</strong>
            {year === latestYear
              ? en
                ? ` known attacks up to ${throughShort}`
                : ` bekannte Angriffe bis ${throughShort}`
              : en
                ? " known attacks"
                : " bekannte Angriffe"}
          </dt>
          <dd>{countIn(year)}</dd>
        </div>
      ))}
  </dl>
  <figure class="attack-map">
    <svg
      viewBox={viewBox}
      role="img"
      aria-label={en
          ? `World map with ${attacks.length} known physical attacks on crypto-asset holders`
          : `Weltkarte mit ${attacks.length} bekannten körperlichen Angriffen auf Krypto-Besitzer`}
    >
      <path class="land" d={landPath} />
      {dots.map((dot) => (
          <circle
            class:list={{ recent: dot.recent }}
            cx={dot.x}
            cy={dot.y}
            r="3.4"
          >
            <title>{dot.label}</title>
          </circle>
        ))}
    </svg>
    <figcaption>
      <span class="legend recent">
        {en ? `${recentFrom} and ${latestYear}` : `${recentFrom} und ${latestYear}`}
      </span>
      <span class="legend">{en ? "earlier" : "früher"}</span>
      <span>
        {en ? "Source: " : "Quelle: "}
        <a href="https://github.com/jlopp/physical-bitcoin-attacks"
          >Jameson Lopp, Known Physical Bitcoin Attacks</a
        >{credit}
      </span>
    </figcaption>
  </figure>
  <details class="attack-list">
    <summary>
      {en
          ? `All ${attacks.length} cases as a list`
          : `Alle ${attacks.length} Fälle als Liste`}
    </summary>
    <p class="attack-note">
      {en
          ? "Headlines as given in the collection, linking to the original report."
          : "Überschriften aus der Sammlung, auf Englisch, mit Link zum ursprünglichen Bericht."}
    </p>
    {byYear.map((group) => (
        <section aria-label={String(group.year)}>
          <h4>
            {group.year} <small>{group.entries.length}</small>
          </h4>
          <ul>
            {group.entries.map((attack) => (
              <li>
                <span class="attack-place">
                  {placeOf(attack, language)}
                  {attack.date && (
                    <small>{formatDate(attack.date, language)}</small>
                  )}
                </span>
                {attack.url ? (
                  <a href={attack.url} lang="en">
                    {attack.headline}
                  </a>
                ) : (
                  <span lang="en">{attack.headline}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
  </details>
</div>

<style>
  /* Karte ohne fremde Kacheln: Umrisse und Punkte entstehen beim Build, der
     Browser lädt nichts von Dritten. */
  .attacks {
    margin-block-start: var(--space-2xl);
  }

  .attack-map {
    margin: var(--space-xl) 0 0;
  }

  .attack-map svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .keyfigures {
    margin-block-start: var(--space-xl);
  }

  .land {
    fill: color-mix(in oklab, var(--ink) 9%, transparent);
  }

  /* Deckende Farben, damit sich überlagernde Punkte nicht wie eine dritte
     Kategorie aussehen. */
  circle {
    fill: color-mix(in oklab, var(--ink) 40%, var(--background));
    stroke: var(--background);
    stroke-width: 0.8;
  }

  circle.recent {
    fill: var(--primary);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin-block-start: var(--space-s);
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .legend::before {
    content: "";
    display: inline-block;
    inline-size: 0.7em;
    block-size: 0.7em;
    margin-inline-end: 0.4em;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--ink) 40%, var(--background));
  }

  .legend.recent::before {
    background: var(--primary);
  }

  .attack-list {
    margin-block-start: var(--space-l);
  }

  .attack-list summary {
    cursor: pointer;
    font-weight: 560;
  }

  .attack-note {
    margin-block: var(--space-s);
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .attack-list h4 {
    margin-block: var(--space-l) var(--space-2xs);
  }

  .attack-list h4 small {
    color: var(--ink-3);
    font-weight: 400;
  }

  .attack-list ul {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .attack-list li {
    display: grid;
    gap: 0.1em var(--space-m);
    padding-block: var(--space-2xs);
    border-block-start: 1px solid var(--line);
    text-wrap: pretty;
  }

  .attack-place {
    font-weight: 560;
  }

  .attack-place small {
    display: block;
    color: var(--ink-3);
    font-size: var(--step--1);
    font-weight: 400;
  }

  @media (width >= 48rem) {
    .attack-list li {
      grid-template-columns: minmax(12rem, 1fr) 2fr;
    }
  }
</style>
