---
import { type Language, pathFor } from "@/lib/i18n"

interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const reported = `${pathFor("background", language)}#gemeldet`

// The answers restate the vetted FAQ entries on who is affected and on own
// wallets. Keep them in sync with the FAQ when either changes.
const options = en
  ? [
      {
        value: "provider",
        label: "Yes",
        answer:
          "Then your provider prepares your data for DAC8, even if you are not ultimately reported. The report contains your identity and annual aggregates, not wallet addresses or individual payments.",
        link: { href: reported, label: "What is reported" },
      },
      {
        value: "self",
        label: "No, only my own wallet",
        answer:
          "DAC8 does not report people who exclusively hold bitcoin in self-custody and do not use such a provider. If you buy from a provider and transfer to your own wallet, the provider generally reports the value and units of that transfer, not the address.",
      },
      {
        value: "unsure",
        label: "Not sure",
        answer:
          "What matters is whether a crypto-asset provider subject to Austrian reporting obligations is involved, such as an exchange or broker based in Austria. If in doubt, ask your provider.",
      },
    ]
  : [
      {
        value: "provider",
        label: "Ja",
        answer:
          "Dann bereitet dein Anbieter deine Daten für DAC8 auf, auch wenn du am Ende nicht gemeldet wirst. Gemeldet werden Identität und Jahreswerte, keine Wallet-Adressen und keine einzelnen Zahlungen.",
        link: { href: reported, label: "Was gemeldet wird" },
      },
      {
        value: "self",
        label: "Nein, nur eigene Wallet",
        answer:
          "Wer Bitcoin ausschließlich selbst verwahrt und keinen solchen Anbieter nutzt, wird durch DAC8 nicht gemeldet. Kaufst du bei einem Anbieter und überträgst auf deine eigene Wallet, meldet dieser in der Regel Wert und Stückzahl der Übertragung, nicht die Adresse.",
      },
      {
        value: "unsure",
        label: "Weiß ich nicht",
        answer:
          "Entscheidend ist, ob ein Krypto-Anbieter beteiligt ist, der in Österreich meldepflichtig ist, etwa eine Börse oder ein Broker mit Sitz in Österreich. Frag im Zweifel bei deinem Anbieter nach.",
      },
    ]
---

<div class="check" data-affected-check>
  <fieldset>
    <legend>
      <span class="check-title"
        >{en ? "Am I affected?" : "Bin ich betroffen?"}</span
      >
      {en ? "Do you use an exchange or broker with reporting obligations in Austria?" : "Nutzt du eine Börse oder einen Broker mit Meldepflicht in Österreich?"}
    </legend>
    <div class="check-options">
      {options.map((option) => (
        <label>
          <input type="radio" name="affected" value={option.value} />
          <span>{option.label}</span>
        </label>
      ))}
    </div>
  </fieldset>
  <div class="check-answers" aria-live="polite">
    {options.map((option) => (
      <p data-answer={option.value}>
        {option.answer}
        {option.link && (
          <>
            {" "}
            <a href={option.link.href}>{option.link.label}</a>
          </>
        )}
      </p>
    ))}
  </div>
  <p class="check-note">
    {en ? "Orientation, not legal advice." : "Orientierung, keine Rechtsberatung."}
  </p>
</div>

<style>
  /* Keine Karte: eine Frage an der Metallkante, drei Antworten als
     Schaltflächen, darunter die passende Auskunft. */
  .check {
    display: grid;
    gap: var(--space-s);
    max-inline-size: 48rem;
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-s);
    background: var(--metal-rule) top / 100% 2px no-repeat;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    display: grid;
    gap: var(--space-3xs);
    padding: 0;
    font-size: var(--step-1);
    font-weight: 560;
    line-height: 1.35;
    text-wrap: balance;
  }

  .check-title {
    color: var(--ink-3);
    font-size: var(--step--1);
    font-weight: 560;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .check-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
  }

  label {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  label span {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.55em 1.1em;
    border: 1px solid color-mix(in oklab, var(--ink) 30%, transparent);
    border-radius: var(--radius-full);
    font-weight: 560;
    transition:
      background-color 140ms ease,
      color 140ms ease,
      border-color 140ms ease;
  }

  label:hover span {
    border-color: var(--ink);
  }

  input:checked + span {
    border-color: var(--ink);
    color: var(--background);
    background: var(--ink);
  }

  input:focus-visible + span {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  .check-answers p {
    max-inline-size: var(--measure-text);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .check-answers p[hidden] {
    display: none;
  }

  .check-answers a {
    font-weight: 560;
  }

  .check-note {
    color: var(--ink-3);
    font-size: var(--step--1);
  }
</style>

<script>
  // Ohne JavaScript bleiben alle drei Auskünfte sichtbar.
  for (const check of document.querySelectorAll<HTMLElement>(
    "[data-affected-check]",
  )) {
    const answers = check.querySelectorAll<HTMLElement>("[data-answer]")
    const show = (value: string | null) => {
      for (const answer of answers)
        answer.hidden = answer.dataset.answer !== value
    }
    show(null)
    check.addEventListener("change", (event) => {
      const input = event.target as HTMLInputElement
      if (input.name === "affected") show(input.value)
    })
  }
</script>
