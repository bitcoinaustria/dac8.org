---
import { type Language, pathFor } from "@/lib/i18n"

interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const reported = `${pathFor("dossier", language)}#gemeldet`

// The answers restate the vetted FAQ entries on who is affected and on own
// wallets. Keep them in sync with the FAQ when either changes.
const faq = `${pathFor("dossier", language)}#faq`
const options = en
  ? [
      {
        value: "provider",
        label: "Yes",
        verdict: "Then you are affected.",
        points: [
          "Every year, your provider prepares your identity, tax identification number and annual totals for the tax authority.",
          "Providers with Austrian reporting obligations do this for all customers, even those who are not ultimately reported.",
          "Anti-money-laundering rules already require them to keep your ID, wallet addresses and individual transactions, currently for up to ten years after you leave. For DAC8, your tax identification number and tax residence are added. None of these records is in the report.",
        ],
        link: { href: reported, label: "What is reported" },
      },
      {
        value: "self",
        label: "No, never through a provider",
        verdict: "Then DAC8 does not report you.",
        points: [
          "This applies as long as you only self-custody and never buy or sell through a provider.",
          "If you buy from a provider and transfer to your own wallet, the value and units of those transfers usually appear in that provider’s annual report. The wallet address is not in the report, but the provider keeps it under anti-money-laundering rules.",
          "If you used a provider in 2020 or later, anti-money-laundering rules currently require it to keep your ID, wallet addresses and transactions for up to ten years after you left.",
        ],
        link: { href: faq, label: "Questions and answers" },
      },
      {
        value: "unsure",
        label: "Not sure",
        verdict: "It depends on where you buy crypto-assets.",
        points: [
          "Exchanges, brokers and apps that buy or hold crypto-assets for you count as providers, including banks with a crypto offer.",
          "Your provider has to tell you before it reports for the first time. If in doubt, ask it whether it reports under DAC8.",
        ],
        link: { href: reported, label: "What is reported" },
      },
    ]
  : [
      {
        value: "provider",
        label: "Ja",
        verdict: "Dann bist du betroffen.",
        points: [
          "Dein Anbieter bereitet jedes Jahr deine Identität, Steuernummer und Jahreswerte für das Finanzamt auf.",
          "Anbieter mit Meldepflicht in Österreich tun das für alle Kunden, auch für jene, die am Ende nicht gemeldet werden.",
          "Ausweis, Wallet-Adressen und einzelne Transaktionen muss er schon nach den Geldwäschevorschriften aufbewahren, derzeit bis zehn Jahre nach Ende der Kundenbeziehung. Für DAC8 kommen Steuernummer und Steuerwohnsitz dazu. In der Meldung steht nichts davon.",
        ],
        link: { href: reported, label: "Was gemeldet wird" },
      },
      {
        value: "self",
        label: "Nein, nie über einen Anbieter",
        verdict: "Dann meldet DAC8 dich nicht.",
        points: [
          "Das gilt, solange du ausschließlich selbst verwahrst und nie über einen Anbieter kaufst oder verkaufst.",
          "Kaufst du bei einem Anbieter und überträgst auf deine eigene Wallet, stehen Wert und Stückzahl dieser Übertragungen in der Regel in seiner Jahresmeldung. Die Wallet-Adresse steht nicht darin, er speichert sie aber nach den Geldwäschevorschriften.",
          "Warst du 2020 oder später Kunde bei einem Anbieter, muss er Ausweis, Wallet-Adressen und Transaktionen nach den Geldwäschevorschriften derzeit bis zehn Jahre nach Ende der Kundenbeziehung aufbewahren.",
        ],
        link: { href: faq, label: "Häufige Fragen" },
      },
      {
        value: "unsure",
        label: "Weiß ich nicht",
        verdict: "Das hängt davon ab, wo du Kryptowerte kaufst.",
        points: [
          "Als Anbieter gelten Börsen, Broker und Apps, bei denen du Kryptowerte kaufst oder verwahren lässt, auch Banken mit Krypto-Angebot.",
          "Dein Anbieter muss dich informieren, bevor er erstmals meldet. Frag im Zweifel nach, ob er nach DAC8 meldet.",
        ],
        link: { href: reported, label: "Was gemeldet wird" },
      },
    ]
---

<div class="check" data-affected-check>
  <fieldset>
    <legend>
      <span class="check-title"
        >{en ? "Am I affected?" : "Bin ich betroffen?"}</span
      >
      {en ? "Do you buy, sell or hold crypto through an exchange, broker or app?" : "Kaufst, verkaufst oder verwahrst du Krypto über eine Börse, einen Broker oder eine App?"}
    </legend>
    <div class="check-options">
      {options.map((option) => (
        <label>
          <input type="radio" name="affected" value={option.value} />
          <span>{option.label}</span>
        </label>
      ))}
    </div>
  </fieldset>
  <div class="check-answers" aria-live="polite">
    {options.map((option) => (
      <div data-answer={option.value}>
        <p class="check-verdict">{option.verdict}</p>
        <ul>
          {option.points.map((point) => <li>{point}</li>)}
        </ul>
        <a class="text-link" href={option.link.href}>{option.link.label}</a>
      </div>
    ))}
  </div>
  <p class="check-note">
    {en ? "Orientation, not legal advice." : "Orientierung, keine Rechtsberatung."}
  </p>
</div>

<style>
  /* Keine Karte, keine Linie: eine Frage, drei Antworten als Schaltflächen,
     darunter die passende Auskunft. */
  .check {
    display: grid;
    gap: var(--space-s);
    max-inline-size: 48rem;
    margin-block-start: var(--space-xl);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    display: grid;
    gap: var(--space-3xs);
    padding: 0;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.35;
    text-wrap: balance;
  }

  /* Die Frage als Überschrift, keine Etikette in Versalien. */
  .check-title {
    color: var(--ink);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .check-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
  }

  label {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  label span {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.55em 1.1em;
    border: 1px solid color-mix(in oklab, var(--ink) 30%, transparent);
    border-radius: var(--radius-full);
    font-weight: 560;
    transition:
      background-color 140ms ease,
      color 140ms ease,
      border-color 140ms ease;
  }

  label:hover span {
    border-color: var(--ink);
  }

  input:checked + span {
    border-color: var(--ink);
    color: var(--background);
    background: var(--ink);
  }

  input:focus-visible + span {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  /* Die Auskunft: eine fette Aussage, darunter zwei bis drei kurze Punkte
     und ein Link zum Weiterlesen. */
  .check-answers > div {
    display: grid;
    gap: var(--space-2xs);
    max-inline-size: var(--measure-text);
  }

  /* Nur die Auskunft zur gewählten Antwort steht da, schon beim ersten
     Rendern und ohne Skript. Browser ohne :has() zeigen alle drei. */
  @supports selector(:has(*)) {
    .check-answers > div {
      display: none;
    }

    .check:has(input[value="provider"]:checked) [data-answer="provider"],
    .check:has(input[value="self"]:checked) [data-answer="self"],
    .check:has(input[value="unsure"]:checked) [data-answer="unsure"] {
      display: grid;
    }
  }

  .check-verdict {
    font-size: var(--step-1);
    font-weight: 560;
    line-height: 1.3;
  }

  .check-answers ul {
    display: grid;
    gap: var(--space-2xs);
    padding-inline-start: 1.2em;
    list-style: disc;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .check-answers ul li::marker {
    color: var(--primary);
  }

  .check-answers .text-link {
    justify-self: start;
    margin-block-start: 0;
  }

  .check-note {
    color: var(--ink-3);
    font-size: var(--step--1);
  }
</style>
