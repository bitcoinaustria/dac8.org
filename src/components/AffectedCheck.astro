---
import { type Language, pathFor } from "@/lib/i18n"

interface Props {
  language: Language
}

const { language } = Astro.props
const en = language === "en"
const reported = `${pathFor("dossier", language)}#gemeldet`
const faq = `${pathFor("dossier", language)}#faq`

// "Am I affected?" on the home page, next to the headline: one question
// about what people do, three answers, and for each a verdict in plain
// sentences. The answers restate the dossier's vetted claims: what goes to
// the tax office (identity, tax number and residence, annual totals; own
// wallets only as a sum without addresses), what stays with the provider
// under anti-money-laundering rules (ID, wallet addresses, single
// transactions), and the dates of the first report and its exchange with
// other EU states, Germany included. Keep both in sync when either changes.
// A point may open with a short label in bold, so "to the tax office" and
// "with the provider" stay visibly apart.
type Point = { label?: string; text: string }
type Option = {
  value: string
  label: string
  verdict: string
  points: Point[]
  link: { href: string; label: string }
}
const options: Option[] = en
  ? [
      {
        value: "provider",
        label: "Yes",
        verdict: "Then you are affected.",
        points: [
          {
            label: "To the tax office:",
            text: "every year your name, home address, date of birth, tax identification number and tax residence, and per crypto-asset the yearly totals of what you bought, sold, exchanged and transferred. Transfers to your own wallet, where only you hold the keys, appear as a total, without the wallet address.",
          },
          {
            label: "With the provider:",
            text: "your ID, wallet addresses and individual transactions. Anti-money-laundering rules currently require it to keep them for up to ten years after you leave.",
          },
          {
            label: "When:",
            text: "providers in Austria send the first report by 31 July 2027. If you live in Germany or another EU state, it goes on to the tax authority there by 30 September 2027.",
          },
        ],
        link: { href: reported, label: "What is reported" },
      },
      {
        value: "self",
        label: "No, never",
        verdict: "Then DAC8 does not report you.",
        points: [
          {
            text: "This holds as long as you never buy or sell through an exchange, broker or app.",
          },
          {
            text: "If you do buy there and move the bitcoin to your own wallet, the value of those transfers usually appears in the provider’s annual report as a total, without the wallet address.",
          },
          {
            text: "If you were a customer of a provider in 2020 or later, anti-money-laundering rules currently require it to keep your ID, wallet addresses and transactions for up to ten years after you left.",
          },
        ],
        link: { href: faq, label: "Questions and answers" },
      },
      {
        value: "unsure",
        label: "Not sure",
        verdict: "It depends on where you buy.",
        points: [
          {
            text: "Exchanges, brokers and apps where you buy crypto-assets or leave them in safekeeping count as providers, including banks that offer crypto.",
          },
          {
            text: "Your provider has to tell you before it reports for the first time.",
          },
        ],
        link: { href: reported, label: "What is reported" },
      },
    ]
  : [
      {
        value: "provider",
        label: "Ja",
        verdict: "Dann bist du betroffen.",
        points: [
          {
            label: "Ans Finanzamt:",
            text: "jedes Jahr Name, Anschrift, Geburtsdatum, Steuernummer und Steuerwohnsitz, dazu je Kryptowert die Jahressummen deiner Käufe, Verkäufe, Tauschgeschäfte und Übertragungen. Was du auf deine eigene Wallet überträgst, bei der nur du die Schlüssel hast, steht als Summe darin, ohne Wallet-Adresse.",
          },
          {
            label: "Beim Anbieter:",
            text: "Ausweis, Wallet-Adressen und einzelne Transaktionen. Die Geldwäschevorschriften verlangen, sie derzeit bis zehn Jahre nach Ende der Kundenbeziehung aufzubewahren.",
          },
          {
            label: "Wann:",
            text: "Anbieter in Österreich melden zum ersten Mal bis 31. Juli 2027. Wohnst du in Deutschland oder einem anderen EU-Staat, geht die Meldung bis 30. September 2027 an die Steuerbehörde dort.",
          },
        ],
        link: { href: reported, label: "Was gemeldet wird" },
      },
      {
        value: "self",
        label: "Nein, nie",
        verdict: "Dann meldet DAC8 dich nicht.",
        points: [
          {
            text: "Das gilt, solange du nie über eine Börse, einen Broker oder eine App kaufst oder verkaufst.",
          },
          {
            text: "Kaufst du doch dort und holst die Bitcoin in deine eigene Wallet, steht der Wert dieser Übertragungen in der Regel als Summe in der Jahresmeldung des Anbieters, ohne Wallet-Adresse.",
          },
          {
            text: "Warst du 2020 oder später Kunde bei einem Anbieter, muss er Ausweis, Wallet-Adressen und Transaktionen nach den Geldwäschevorschriften derzeit bis zehn Jahre nach Ende der Kundenbeziehung aufbewahren.",
          },
        ],
        link: { href: faq, label: "Häufige Fragen" },
      },
      {
        value: "unsure",
        label: "Weiß ich nicht",
        verdict: "Das hängt davon ab, wo du kaufst.",
        points: [
          {
            text: "Als Anbieter gelten Börsen, Broker und Apps, bei denen du Kryptowerte kaufst oder verwahren lässt, auch Banken mit Krypto-Angebot.",
          },
          {
            text: "Dein Anbieter muss dich informieren, bevor er zum ersten Mal meldet.",
          },
        ],
        link: { href: reported, label: "Was gemeldet wird" },
      },
    ]
---

<section
  id="betroffen"
  class="check"
  aria-labelledby="betroffen-heading"
  data-affected-check
>
  <fieldset>
    <legend>
      <h2 id="betroffen-heading">
        {en ? "Am I affected?" : "Bin ich betroffen?"}
      </h2>
      <span class="check-question">
        {en ? "Do you buy or sell bitcoin or other crypto-assets through an exchange, broker or app?" : "Kaufst oder verkaufst du Bitcoin oder andere Kryptowerte über eine Börse, einen Broker oder eine App?"}
      </span>
    </legend>
    <div class="check-options">
      {options.map((option) => (
        <label>
          <input type="radio" name="affected" value={option.value} />
          <span>{option.label}</span>
        </label>
      ))}
    </div>
  </fieldset>
  <div class="check-answers" aria-live="polite">
    {options.map((option) => (
      <div data-answer={option.value}>
        <p class="check-verdict">{option.verdict}</p>
        <ul>
          {option.points.map((point) => (
            <li>
              {point.label && <strong>{point.label}</strong>} {point.text}
            </li>
          ))}
        </ul>
        <a class="text-link" href={option.link.href}>{option.link.label}</a>
      </div>
    ))}
  </div>
</section>

<style>
  /* Eine Fläche neben der Schlagzeile: die Frage als Überschrift, drei
     Antworten als Schaltflächen, darunter die passende Auskunft. */
  .check {
    display: grid;
    gap: var(--space-m);
    align-self: start;
    padding: var(--space-m-l);
    border-radius: var(--radius-xl);
    background: var(--panel);
    scroll-margin-block-start: var(--space-xl);
  }

  fieldset {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    display: grid;
    gap: var(--space-2xs);
    padding: 0;
  }

  /* Spezifischer als die globalen Bandüberschriften: Die Frage steht im
     Hero und ist deshalb eine Stufe kleiner als die Schlagzeile. */
  .check h2 {
    max-inline-size: none;
    color: var(--ink);
    font-size: var(--type-h3);
    font-weight: var(--weight-heading);
    font-stretch: normal;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .check-question {
    color: var(--ink-2);
    font-size: var(--type-body);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .check-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
  }

  label {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  label span {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.875rem;
    padding: 0.55em 1.2em;
    border: 1px solid color-mix(in oklab, var(--ink) 30%, transparent);
    border-radius: var(--radius-full);
    background: var(--background);
    font-weight: var(--weight-strong);
    transition:
      background-color 140ms ease,
      color 140ms ease,
      border-color 140ms ease;
  }

  label:hover span {
    border-color: var(--ink);
  }

  input:checked + span {
    border-color: var(--ink);
    color: var(--background);
    background: var(--ink);
  }

  input:focus-visible + span {
    outline: 2px solid var(--primary);
    outline-offset: 0.2rem;
  }

  /* Die Auskunft: eine fette Aussage, darunter kurze Punkte und ein Link. */
  .check-answers > div {
    display: grid;
    gap: var(--space-xs);
    max-inline-size: var(--measure-text);
  }

  /* Nur die Auskunft zur gewählten Antwort steht da, schon beim ersten
     Rendern und ohne Skript. Browser ohne :has() zeigen alle drei. */
  @supports selector(:has(*)) {
    .check-answers > div {
      display: none;
    }

    .check:has(input[value="provider"]:checked) [data-answer="provider"],
    .check:has(input[value="self"]:checked) [data-answer="self"],
    .check:has(input[value="unsure"]:checked) [data-answer="unsure"] {
      display: grid;
    }

    .check:not(:has(input:checked)) .check-answers {
      display: none;
    }
  }

  .check-verdict {
    color: var(--ink);
    font-size: var(--type-lead);
    font-weight: var(--weight-heading);
    line-height: 1.3;
  }

  .check-answers ul {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding-inline-start: 1.1em;
    list-style: disc;
    color: var(--ink-2);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .check-answers li strong {
    color: var(--ink);
    font-weight: var(--weight-strong);
  }

  .check-answers ul li::marker {
    color: var(--ink-3);
  }

  .check-answers .text-link {
    justify-self: start;
    margin-block-start: var(--space-3xs);
  }
</style>
