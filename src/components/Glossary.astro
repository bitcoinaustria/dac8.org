---
import Disclosure from "@/components/Disclosure.astro"
import { glossary, termAnchor } from "@/data/glossary"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

// The dossier's glossary: only the terms, A to Z, each opening its
// definition like the questions above it. Pages link to one term with
// #begriff-<id> (see src/data/glossary.ts), to the whole list with #begriffe.
const { language } = Astro.props
const en = language === "en"
const collator = new Intl.Collator(language)
const terms = glossary[language].toSorted((a, b) =>
  collator.compare(a.term, b.term),
)
// Two columns, A to Z down the first, then the second, each its own stack so
// an open definition only pushes down the terms below it.
const half = Math.ceil(terms.length / 2)
const columns = [terms.slice(0, half), terms.slice(half)]
---

<section id="begriffe" aria-labelledby="glossary-heading">
  <h2 id="glossary-heading">{en ? "Terms" : "Begriffe"}</h2>
  <div class="terms">
    {columns.map((column) => (
      <div class="disclosure-list">
        {column.map((entry) => (
          <Disclosure id={termAnchor(entry.id)} name="begriffe">
            <Fragment slot="summary">{entry.term}</Fragment>
            <p>{entry.text}</p>
          </Disclosure>
        ))}
      </div>
    ))}
  </div>
</section>
