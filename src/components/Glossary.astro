---
import { glossary, termAnchor } from "@/data/glossary"
import type { Language } from "@/lib/i18n"

interface Props {
  language: Language
}

// The dossier's glossary works like a dictionary, not like the questions
// above it: all terms A to Z as a register, and one card with the chosen
// term's explanation. Pages link to one term with #begriff-<id> (see
// src/data/glossary.ts), which selects it; #begriffe is the whole section.
// Without JavaScript every card stays visible as a plain list.
const { language } = Astro.props
const en = language === "en"
const collator = new Intl.Collator(language)
const terms = glossary[language].toSorted((a, b) =>
  collator.compare(a.term, b.term),
)
---

<section id="begriffe" aria-labelledby="glossary-heading">
  <h2 id="glossary-heading">{en ? "Terms" : "Begriffe"}</h2>
  <div class="glossary" data-glossary>
    <ul
      class="term-index"
      role="tablist"
      aria-label={en ? "Terms A to Z" : "Begriffe von A bis Z"}
    >
      {terms.map((entry, index) => (
        <li role="presentation">
          <a
            role="tab"
            href={`#${termAnchor(entry.id)}`}
            aria-controls={termAnchor(entry.id)}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? undefined : "-1"}
            data-term={termAnchor(entry.id)}>{entry.term}</a
          >
        </li>
      ))}
    </ul>
    <div class="term-cards">
      {terms.map((entry, index) => (
        <article
          class="term-card"
          id={termAnchor(entry.id)}
          role="tabpanel"
          aria-label={entry.term}
          data-current={index === 0 ? "" : undefined}
        >
          <h3>{entry.term}</h3>
          <p>{entry.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Choosing a term shows its card and puts it in the address, without
  // jumping; a link to #begriff-<id> selects it and brings the glossary
  // into view. Arrow keys move along the register.
  const root = document.querySelector<HTMLElement>("[data-glossary]")
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>("[role=tab]")]
    const select = (id: string) => {
      const card = root.querySelector<HTMLElement>(`#${CSS.escape(id)}`)
      if (!card) return false
      for (const other of root.querySelectorAll(".term-card"))
        other.toggleAttribute("data-current", other === card)
      for (const tab of tabs) {
        const current = tab.dataset.term === id
        tab.setAttribute("aria-selected", String(current))
        if (current) tab.removeAttribute("tabindex")
        else tab.setAttribute("tabindex", "-1")
      }
      return true
    }
    for (const tab of tabs) {
      tab.addEventListener("click", (event) => {
        event.preventDefault()
        const id = tab.dataset.term ?? ""
        if (select(id)) history.replaceState(null, "", `#${id}`)
      })
      tab.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" || event.key === "ArrowDown"
            ? 1
            : event.key === "ArrowLeft" || event.key === "ArrowUp"
              ? -1
              : 0
        if (!step) return
        event.preventDefault()
        const next =
          tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length]
        next.focus()
        next.click()
      })
    }
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1))
      if (id.startsWith("begriff-") && select(id))
        root.scrollIntoView({ block: "start" })
    }
    fromHash()
    addEventListener("hashchange", fromHash)
  }
</script>

<style>
  /* Unter Kopfleiste und Kapitelleiste, wenn ein Link hierher springt. */
  .glossary {
    scroll-margin-block-start: calc(
      var(--bar-height) +
      var(--chapter-height) +
      var(--space-m)
    );
  }

  .term-index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Das Register: jeder Begriff ein Chip, der gewählte dunkel gefüllt. Rot
     bleibt dem „Jetzt“ des Rechtswegs vorbehalten. */
  .term-index a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding: 0 var(--space-s);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    color: var(--ink);
    font-weight: 560;
    text-decoration: none;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }

  .term-index a:hover {
    border-color: var(--ink-3);
  }

  .term-index a[aria-selected="true"] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--background);
  }

  .term-cards {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
  }

  /* Die Karte des gewählten Begriffs, groß genug zum Lesen. Mit JavaScript
     steht nur sie da; die Mindesthöhe hält das Register ruhig, wenn die
     Erklärungen verschieden lang sind. */
  .term-card {
    padding: var(--space-m) var(--space-l);
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  :global(html[data-js]) .term-card:not([data-current]) {
    display: none;
  }

  :global(html[data-js]) .term-card {
    min-block-size: 10rem;
  }

  .term-card h3 {
    font-size: var(--type-h3);
  }

  .term-card p {
    max-inline-size: var(--measure-text);
    margin-block-start: var(--space-2xs);
    color: var(--ink-2);
    font-size: var(--type-lead);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .term-index a {
      transition: none;
    }
  }
</style>
