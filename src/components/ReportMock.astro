---
/**
 * Die Jahresmeldung nach § 18 Krypto-MPfG, nachgebaut mit erfundenen Zahlen.
 * Zeigt, was der Anbieter einmal im Jahr ans Finanzamt schickt – und was nicht.
 * `compact` lässt den zweiten Kryptowert weg (für die Startseite).
 */
type Props = { compact?: boolean; class?: string }
const { compact = false, class: className } = Astro.props

type Row = { label: string; flag?: boolean; values: [string, string, string?] }

const bitcoin: Row[] = [
  { label: "Kauf gegen Euro", values: ["4.800 €", "0,061 BTC", "12"] },
  { label: "Verkauf gegen Euro", values: ["1.200 €", "0,014 BTC", "1"] },
  {
    label: "Tausch gegen andere Kryptowerte",
    flag: true,
    values: ["650 €", "0,008 BTC", "2"],
  },
  {
    label: "Übertragung an unbekannte Adressen",
    flag: true,
    values: ["3.900 €", "0,047 BTC"],
  },
]

const ether: Row[] = [
  {
    label: "Tausch gegen andere Kryptowerte",
    flag: true,
    values: ["650 €", "0,29 ETH", "2"],
  },
  {
    label: "Übertragung von anderen Anbietern",
    values: ["300 €", "0,13 ETH", "1"],
  },
]

const assets = compact
  ? [{ name: "Bitcoin", hint: "je Kryptowert, je Vorgangsart", rows: bitcoin }]
  : [
      { name: "Bitcoin", hint: "je Kryptowert, je Vorgangsart", rows: bitcoin },
      {
        name: "Ether",
        hint: "gleiche Felder für jeden weiteren Kryptowert",
        rows: ether,
      },
    ]
---

<figure
  class:list={["report", className]}
  aria-label="Nachgebaute DAC8-Meldung"
>
  <div class="report-head">
    <strong>Meldung für das Kalenderjahr 2026</strong>
    <span>Beispiel mit erfundenen Zahlen</span>
  </div>

  <dl class="report-id">
    <div>
      <dt>Name</dt>
      <dd>Maria Musterfrau</dd>
    </div>
    <div>
      <dt>Anschrift</dt>
      <dd>Musterstraße 4, 1020 Wien</dd>
    </div>
    <div>
      <dt>Steuerlicher Wohnsitz</dt>
      <dd>Österreich</dd>
    </div>
    <div>
      <dt>Steuernummer</dt>
      <dd>12-345/6789</dd>
    </div>
    <div>
      <dt>Geburtsdatum</dt>
      <dd>14. 03. 1988</dd>
    </div>
  </dl>

  {assets.map((asset) => (
      <table class="report-table">
        <caption>
          {asset.name} <span>{asset.hint}</span>
        </caption>
        <thead>
          <tr>
            <th scope="col">
              <span class="visually-hidden">Vorgangsart</span>
            </th>
            <th scope="col">Wert</th>
            <th scope="col">Stück</th>
            <th scope="col">Anzahl</th>
          </tr>
        </thead>
        <tbody>
          {asset.rows.map((row) => (
            <tr>
              <th scope="row">
                {row.label}
                {row.flag && <span class="mark">*</span>}
              </th>
              <td>{row.values[0]}</td>
              <td>{row.values[1]}</td>
              <td>{row.values[2] ?? <span class="none">–</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ))}

  <div class="report-missing">
    <h4>Nicht in der Meldung</h4>
    <ul>
      <li>Wallet-Adressen</li>
      <li>einzelne Transaktionen</li>
      <li>Zeitpunkte</li>
      <li>Gegenparteien</li>
      <li>aktueller Bestand</li>
    </ul>
  </div>

  <figcaption class="report-foot">
    <span>
      <span class="mark">*</span>
      steuerlich meist ohne Bedeutung, wird trotzdem gemeldet
    </span>
    <span>Löschung beim Anbieter: <strong>Ende 2036</strong></span>
  </figcaption>
</figure>
