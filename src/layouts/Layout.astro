---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/shape.css"
import "@/styles/campaign.css"

import ActionBar from "@/components/ActionBar.astro"
import EmbargoBanner from "@/components/EmbargoBanner.astro"
import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import { type PageSection } from "@/consts"

import { languageFor } from "@/lib/i18n"
const language = languageFor(Astro.url.pathname)

// Sections render as the chapter bar under the header; pass them only on
// long pages. Full-bleed pages such as the attack map use the whole width.
type Props = { sections?: PageSection[]; fullBleed?: boolean }

const { sections = [], fullBleed = false } = Astro.props
---

<html lang={language === "en" ? "en" : "de-AT"} dir="ltr">
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <a class="skip-link" href="#main-content"
      >{language === "en" ? "Skip to content" : "Zum Inhalt springen"}</a
    >
    <EmbargoBanner />
    <SiteHeader sections={sections} />
    <main
      id="main-content"
      class:list={{ "full-bleed": fullBleed }}
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer />
    <ActionBar />
    <script>
      import { initializeShareButtons } from "@/lib/share"

      initializeShareButtons()
    </script>
  </body>
</html>

<style>
  main {
    display: block;
    max-inline-size: var(--page-max);
    min-block-size: 60svh;
    margin-inline: auto;
    padding: var(--space-xl) var(--grid-gutter) var(--space-2xl);
  }

  main.full-bleed {
    max-inline-size: none;
    padding: 0;
  }

  /* Platz für die mobile Aktionsleiste am unteren Rand. */
  @media (width < 64rem) {
    body {
      padding-block-end: calc(3.75rem + env(safe-area-inset-bottom));
    }

    main {
      padding-block-start: var(--space-l);
    }
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    inset-block-start: var(--space-xs);
    inset-inline-start: var(--grid-gutter);
    padding: var(--space-xs) var(--space-s);
    color: var(--background);
    background: var(--foreground);
    transform: translateY(calc(-100% - var(--space-l)));

    &:focus {
      transform: none;
    }
  }
</style>
