---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/bar.css"
import "@/styles/shape.css"
import "@/styles/campaign.css"

import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import Sidebar from "@/components/Sidebar.astro"
import { SITE, type PageSection } from "@/consts"

type Props = { sections?: PageSection[] }

const { sections = [] } = Astro.props
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <page-grid>
      <page-header>
        <page-nav>
          <Sidebar sections={sections} />
        </page-nav>
      </page-header>
      <page-content>
        <main id="main-content" tabindex="-1"><slot /></main>
      </page-content>
      <page-footer><Footer /></page-footer>
    </page-grid>
  </body>
</html>

<style>
  page-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--grid-gutter);
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: var(--page-offset-top);

    @media (width < 64rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      padding-block-start: 0;
    }
  }

  page-header {
    display: block;
    grid-column: 1;
    grid-row: 1;
    min-width: 0;

    @media (width < 64rem) {
      display: block;
      grid-column: 1 / -1;
      position: sticky;
      top: 0;
      z-index: 10;
      min-width: 0;
      margin-inline: calc(-1 * var(--grid-gutter));

      &:has(aside:not([data-menu-ready])) {
        position: static;
      }
    }
  }

  page-nav {
    display: block;
    min-width: 0;
    block-size: 100%;
  }

  page-content {
    display: flex;
    flex-direction: column;
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    margin-block-start: -0.1em;

    main {
      flex: 1;
    }

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: auto;
      inline-size: 100%;
      max-inline-size: var(--measure);
      margin-inline: auto;
      padding-block-start: var(--space-l);
    }
  }

  page-footer {
    display: block;
    grid-column: 1 / -1;
    grid-row: 2;
    margin-block-start: var(--space-2xl);

    @media (width < 64rem) {
      grid-row: auto;
    }
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    inset-block-start: var(--space-xs);
    inset-inline-start: var(--grid-gutter);
    padding: var(--space-xs) var(--space-s);
    color: var(--background);
    background: var(--foreground);
    transform: translateY(calc(-100% - var(--space-l)));

    &:focus {
      transform: none;
    }
  }
</style>
